project BenchMemset
target console
runtime AgentRuntime 0.1

entry console main

error MainError
errorCase MainError AllocationFailed Int32
errorCase MainError ConsoleWriteFailed Int32

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main read clock.cpu
effect main write console.stdout
effect main allocate heap
effect main free heap
effect main write memory.buffer
effect main read memory.buffer
memory main heap yes
memory main stack max 8KiB
async main no

purpose operation main "Benchmark c.memset by writing a 64 KiB buffer 200000 times and printing the elapsed CPU-clock ticks"
invariant operation main "The loop counter is monotonically increasing and bounded by iterationLimit"
invariant operation main "The buffer is allocated via c.malloc before the loop and freed via c.free after timing stops"

label startMain

storage module immutable iterationLimit Int64 200000
storage module immutable iterationStep Int64 1
storage module immutable bufferSize ByteCount 65536
storage module immutable observationModulus Int64 65536
memory main mutable currentIteration Int64 0
memory main mutable observationAccumulator Int64 0

# Allocate the 64 KiB benchmark buffer.
call mallocCall c.malloc
argument mallocCall size ByteCount bufferSize
run mallocCall
bind ok benchmarkBuffer OpaquePointer mallocCall
# c.malloc returns NULL on failure; treat a zero result as the error path.
# (The compiler's branchIfError uses the signed-less-than-zero convention,
# but malloc semantically returns NULL == 0. We branch directly on the bind.)

# Start the CPU-clock counter.
call startClockCall c.clock
run startClockCall
bind value startClockTicks CpuClockTicks startClockCall

label benchmarkLoopHead

call shouldContinueCmpCall math.lessThanInt64
argument shouldContinueCmpCall left Int64 currentIteration
argument shouldContinueCmpCall right Int64 iterationLimit
run shouldContinueCmpCall
bind value benchmarkShouldContinue Bool shouldContinueCmpCall

branch if condition benchmarkShouldContinue target benchmarkLoopBody
branch else target benchmarkFinished

label benchmarkLoopBody

call memsetCall c.memset
argument memsetCall buffer OpaquePointer benchmarkBuffer
argument memsetCall fillByte Int64 currentIteration
argument memsetCall byteCount ByteCount bufferSize
run memsetCall
bind value memsetReturn OpaquePointer memsetCall

# Read a varying byte after each memset so the optimizer cannot elide the
# memset calls. The observation accumulator depends on every memset's
# completion and is reported alongside the timing data.
call moduloOffsetCall math.moduloInt64
argument moduloOffsetCall left Int64 currentIteration
argument moduloOffsetCall right Int64 observationModulus
run moduloOffsetCall
bind value observationOffset Int64 moduloOffsetCall

call observationLoadCall pointer.loadByte
argument observationLoadCall buffer OpaquePointer benchmarkBuffer
argument observationLoadCall offset Int64 observationOffset
run observationLoadCall
bind value observationByte Int8 observationLoadCall

call observationAccumulateCall math.addInt64
argument observationAccumulateCall left Int64 observationAccumulator
argument observationAccumulateCall right Int64 observationByte
run observationAccumulateCall
bind value nextObservation Int64 observationAccumulateCall
set memory observationAccumulator nextObservation

call incrementCall math.addInt64
argument incrementCall left Int64 currentIteration
argument incrementCall right Int64 iterationStep
run incrementCall
bind value nextIteration Int64 incrementCall
set memory currentIteration nextIteration
jump target benchmarkLoopHead

label benchmarkFinished

call endClockCall c.clock
run endClockCall
bind value endClockTicks CpuClockTicks endClockCall

call elapsedTicksCall math.subtractInt64
argument elapsedTicksCall left CpuClockTicks endClockTicks
argument elapsedTicksCall right CpuClockTicks startClockTicks
run elapsedTicksCall
bind value elapsedClockTicks Int64 elapsedTicksCall

storage module immutable reportFormatText String "iterations=%lld bufferSize=%lld accumulator=%lld clockTicks=%lld\n"
call reportCall c.printf
argument reportCall format String reportFormatText
argument reportCall iterations Int64 iterationLimit
argument reportCall buffer ByteCount bufferSize
argument reportCall accumulator Int64 observationAccumulator
argument reportCall ticks Int64 elapsedClockTicks
run reportCall
ignore void source reportCall
bind error reportError Int32 reportCall
branch error source reportCall target consoleWriteFailed

call freeCall c.free
argument freeCall pointer OpaquePointer benchmarkBuffer
run freeCall

storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode

label consoleWriteFailed
makeError consoleWriteFailure MainError.ConsoleWriteFailed reportError
return error consoleWriteFailure
