project BenchMemset
target console
runtime AgentRuntime 0.1

entry console main

error MainError
errorCase MainError AllocationFailed CSignedInt32
errorCase MainError ConsoleWriteFailed CSignedInt32

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main read clock.cpu
effect main write console.stdout
effect main allocate heap
effect main free heap
effect main write memory.buffer
effect main read memory.buffer
memory main heap yes
memory main stack max 8KiB
async main no

purpose operation main "Benchmark c.memset by writing a 64 KiB buffer 200000 times and printing the elapsed CPU-clock ticks"
invariant operation main "The loop counter is monotonically increasing and bounded by iterationLimit"
invariant operation main "The buffer is allocated via c.malloc before the loop and freed via c.free after timing stops"

label startMain

storage module immutable iterationLimit I64 200000
storage module immutable iterationStep I64 1
storage module immutable bufferSize CByteCount 65536
storage module immutable observationModulus I64 65536
memory main mutable currentIteration I64 0
memory main mutable observationAccumulator I64 0

# Allocate the 64 KiB benchmark buffer.
call mallocCall c.malloc
argument mallocCall size CByteCount bufferSize
run mallocCall
bind ok benchmarkBuffer COpaqueMemoryAddress mallocCall
# c.malloc returns NULL on failure; treat a zero result as the error path.
# (The compiler's branchIfError uses the signed-less-than-zero convention,
# but malloc semantically returns NULL == 0. We branch directly on the bind.)

# Start the CPU-clock counter.
call startClockCall c.clock
run startClockCall
bind value startClockTicks CCpuClockTicks startClockCall

label benchmarkLoopHead

call shouldContinueCmpCall math.lessThanI64
argument shouldContinueCmpCall left I64 currentIteration
argument shouldContinueCmpCall right I64 iterationLimit
run shouldContinueCmpCall
bind value benchmarkShouldContinue Bool shouldContinueCmpCall

branch if condition benchmarkShouldContinue target benchmarkLoopBody
branch else target benchmarkFinished

label benchmarkLoopBody

call memsetCall c.memset
argument memsetCall buffer COpaqueMemoryAddress benchmarkBuffer
argument memsetCall fillByte I64 currentIteration
argument memsetCall byteCount CByteCount bufferSize
run memsetCall
bind value memsetReturn COpaqueMemoryAddress memsetCall

# Read a varying byte after each memset so the optimizer cannot elide the
# memset calls. The observation accumulator depends on every memset's
# completion and is reported alongside the timing data.
call moduloOffsetCall math.moduloI64
argument moduloOffsetCall left I64 currentIteration
argument moduloOffsetCall right I64 observationModulus
run moduloOffsetCall
bind value observationOffset I64 moduloOffsetCall

call observationLoadCall pointer.loadByte
argument observationLoadCall buffer COpaqueMemoryAddress benchmarkBuffer
argument observationLoadCall offset I64 observationOffset
run observationLoadCall
bind value observationByte I8 observationLoadCall

call observationAccumulateCall math.addI64
argument observationAccumulateCall left I64 observationAccumulator
argument observationAccumulateCall right I64 observationByte
run observationAccumulateCall
bind value nextObservation I64 observationAccumulateCall
set memory observationAccumulator nextObservation

call incrementCall math.addI64
argument incrementCall left I64 currentIteration
argument incrementCall right I64 iterationStep
run incrementCall
bind value nextIteration I64 incrementCall
set memory currentIteration nextIteration
jump target benchmarkLoopHead

label benchmarkFinished

call endClockCall c.clock
run endClockCall
bind value endClockTicks CCpuClockTicks endClockCall

call elapsedTicksCall math.subtractI64
argument elapsedTicksCall left CCpuClockTicks endClockTicks
argument elapsedTicksCall right CCpuClockTicks startClockTicks
run elapsedTicksCall
bind value elapsedClockTicks I64 elapsedTicksCall

storage module immutable reportFormatText CNullTerminatedByteString "iterations=%lld bufferSize=%lld accumulator=%lld clockTicks=%lld\n"
call reportCall c.printf
argument reportCall format CNullTerminatedByteString reportFormatText
argument reportCall iterations I64 iterationLimit
argument reportCall buffer CByteCount bufferSize
argument reportCall accumulator I64 observationAccumulator
argument reportCall ticks I64 elapsedClockTicks
run reportCall
ignore void source reportCall
bind error reportError CSignedInt32 reportCall
branch error source reportCall target consoleWriteFailed

call freeCall c.free
argument freeCall pointer COpaqueMemoryAddress benchmarkBuffer
run freeCall

storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode

label consoleWriteFailed
makeError consoleWriteFailure MainError.ConsoleWriteFailed reportError
return error consoleWriteFailure
