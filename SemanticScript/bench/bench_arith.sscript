project BenchArith
target console
runtime AgentRuntime 0.1

entry console main

error MainError
errorCase MainError ConsoleWriteFailed Int32

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main read clock.cpu
effect main write console.stdout
memory main heap no
memory main stack max 4KiB
async main no

purpose operation main "Pure-codegen benchmark with a Fibonacci-style data-dependency chain; each iteration depends on the previous two values so the loop cannot be folded"
invariant operation main "Each iteration performs exactly one addition and two register-to-register moves"

label startMain

storage module immutable iterationLimit Int64 200000000
storage module immutable iterationStep Int64 1
storage module immutable fibonacciInitialPreviousValue Int64 1
storage module immutable fibonacciInitialCurrentValue Int64 1

memory main mutable currentIteration Int64 0
memory main mutable fibonacciPreviousValue Int64 fibonacciInitialPreviousValue
memory main mutable fibonacciCurrentValue Int64 fibonacciInitialCurrentValue

call startClockCall c.clock
run startClockCall
bind value startClockTicks CpuClockTicks startClockCall

label arithLoopHead

call shouldContinueCmpCall math.lessThanInt64
argument shouldContinueCmpCall left Int64 currentIteration
argument shouldContinueCmpCall right Int64 iterationLimit
run shouldContinueCmpCall
bind value arithShouldContinue Bool shouldContinueCmpCall
branch if condition arithShouldContinue target arithLoopBody
branch else target arithFinished

label arithLoopBody

# next = a + b
call fibonacciAdvanceCall math.addInt64
argument fibonacciAdvanceCall left Int64 fibonacciPreviousValue
argument fibonacciAdvanceCall right Int64 fibonacciCurrentValue
run fibonacciAdvanceCall
bind value fibonacciNextValue Int64 fibonacciAdvanceCall

# a = b
set memory fibonacciPreviousValue fibonacciCurrentValue
# b = next
set memory fibonacciCurrentValue fibonacciNextValue

# i = i + 1
call incrementCall math.addInt64
argument incrementCall left Int64 currentIteration
argument incrementCall right Int64 iterationStep
run incrementCall
bind value nextIteration Int64 incrementCall
set memory currentIteration nextIteration
jump target arithLoopHead

label arithFinished

call endClockCall c.clock
run endClockCall
bind value endClockTicks CpuClockTicks endClockCall

call elapsedTicksCall math.subtractInt64
argument elapsedTicksCall left CpuClockTicks endClockTicks
argument elapsedTicksCall right CpuClockTicks startClockTicks
run elapsedTicksCall
bind value elapsedClockTicks Int64 elapsedTicksCall

storage module immutable reportFormatText String "iterations=%lld accumulator=%lld clockTicks=%lld\n"
call reportCall c.printf
argument reportCall format String reportFormatText
argument reportCall iterations Int64 iterationLimit
argument reportCall accumulator Int64 fibonacciCurrentValue
argument reportCall ticks Int64 elapsedClockTicks
run reportCall
ignore void source reportCall
bind error reportError Int32 reportCall
branch error source reportCall target reportWriteFailed

storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode

label reportWriteFailed
makeError reportWriteFailure MainError.ConsoleWriteFailed reportError
return error reportWriteFailure
