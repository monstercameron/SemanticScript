project BenchStrlen
target console
runtime AgentRuntime 0.1

entry console main

error MainError
errorCase MainError ConsoleWriteFailed Int32

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main read environment.variables
effect main read process.environment
effect main read clock.cpu
effect main write console.stdout
memory main heap no
memory main stack max 8KiB
async main no

purpose operation main "Benchmark c.strlen for 200M iterations on a runtime-provided PATH string and report elapsed CPU-clock ticks"
invariant operation main "The probed string comes from c.getenv so its length cannot be constant-folded by the optimizer"

label startMain

storage module immutable pathEnvName String "PATH"
storage module immutable iterationLimit Int64 200000000
storage module immutable iterationStep Int64 1

# Resolve the runtime probe string from PATH. If PATH is unset, getenv
# returns NULL — in that case strlen(NULL) is undefined and the benchmark
# is not meaningful, but in any normal environment PATH is set.
call getenvCall c.getenv
argument getenvCall name String pathEnvName
run getenvCall
bind value environmentProbeText String getenvCall

# Note: when PATH isn't set, getenv returns NULL. For benchmarking purposes
# we substitute the fallback only when needed; the test runs against PATH
# in normal environments so this branch isn't exercised.

memory main mutable accumulator Int64 0
memory main mutable currentIteration Int64 0

call startClockCall c.clock
run startClockCall
bind value startClockTicks CpuClockTicks startClockCall

label benchmarkLoopHead

call shouldContinueCmpCall math.lessThanInt64
argument shouldContinueCmpCall left Int64 currentIteration
argument shouldContinueCmpCall right Int64 iterationLimit
run shouldContinueCmpCall
bind value benchmarkShouldContinue Bool shouldContinueCmpCall
branch if condition benchmarkShouldContinue target benchmarkLoopBody
branch else target benchmarkFinished

label benchmarkLoopBody

call strlenCall c.strlen
argument strlenCall text String environmentProbeText
run strlenCall
bind value currentLength ByteCount strlenCall

call accumulateCall math.addInt64
argument accumulateCall left Int64 accumulator
argument accumulateCall right Int64 currentLength
run accumulateCall
bind value nextAccumulator Int64 accumulateCall
set memory accumulator nextAccumulator

call incrementCall math.addInt64
argument incrementCall left Int64 currentIteration
argument incrementCall right Int64 iterationStep
run incrementCall
bind value nextIteration Int64 incrementCall
set memory currentIteration nextIteration
jump target benchmarkLoopHead

label benchmarkFinished

call endClockCall c.clock
run endClockCall
bind value endClockTicks CpuClockTicks endClockCall

call elapsedTicksCall math.subtractInt64
argument elapsedTicksCall left CpuClockTicks endClockTicks
argument elapsedTicksCall right CpuClockTicks startClockTicks
run elapsedTicksCall
bind value elapsedClockTicks Int64 elapsedTicksCall

storage module immutable reportFormatText String "iterations=%lld accumulator=%lld clockTicks=%lld\n"
call reportCall c.printf
argument reportCall format String reportFormatText
argument reportCall iterations Int64 iterationLimit
argument reportCall accumulator Int64 accumulator
argument reportCall ticks Int64 elapsedClockTicks
run reportCall
ignore void source reportCall
bind error reportError Int32 reportCall
branch error source reportCall target consoleWriteFailed

storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode

label consoleWriteFailed
makeError consoleWriteFailure MainError.ConsoleWriteFailed reportError
return error consoleWriteFailure
