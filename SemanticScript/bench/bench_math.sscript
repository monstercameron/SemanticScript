project BenchMath
target console
runtime AgentRuntime 0.1

entry console main

error MainError
errorCase MainError ConsoleWriteFailed CSignedInt32

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main read clock.cpu
effect main write console.stdout
memory main heap no
memory main stack max 8KiB
async main no

purpose operation main "Benchmark c.sqrt + c.log + c.sin for 5M iterations and print elapsed CPU-clock ticks"
invariant operation main "Each loop iteration calls all three transcendental libc routines exactly once"

label startMain

storage module immutable iterationLimit I64 5000000
storage module immutable iterationStep I64 1
storage module immutable accumulatorInitial CFloat64 0.0
memory main mutable currentIteration I64 1
memory main mutable accumulator CFloat64 accumulatorInitial

call startClockCall c.clock
run startClockCall
bind value startClockTicks CCpuClockTicks startClockCall

label benchmarkLoopHead

call shouldContinueCmpCall math.lessThanOrEqualI64
argument shouldContinueCmpCall left I64 currentIteration
argument shouldContinueCmpCall right I64 iterationLimit
run shouldContinueCmpCall
bind value benchmarkShouldContinue Bool shouldContinueCmpCall

branch if condition benchmarkShouldContinue target benchmarkLoopBody
branch else target benchmarkFinished

label benchmarkLoopBody

# Compute sqrt(iteration) + log(iteration) + sin(iteration).
call sqrtCall c.sqrt
argument sqrtCall x I64 currentIteration
run sqrtCall
bind value sqrtResult CFloat64 sqrtCall

call logCall c.log
argument logCall x I64 currentIteration
run logCall
bind value logResult CFloat64 logCall

call sinCall c.sin
argument sinCall x I64 currentIteration
run sinCall
bind value sinResult CFloat64 sinCall

call partialSumCall math.addF64
argument partialSumCall left CFloat64 sqrtResult
argument partialSumCall right CFloat64 logResult
run partialSumCall
bind value sqrtLogSum CFloat64 partialSumCall

call iterationValueCall math.addF64
argument iterationValueCall left CFloat64 sqrtLogSum
argument iterationValueCall right CFloat64 sinResult
run iterationValueCall
bind value iterationValue CFloat64 iterationValueCall

call accumulateCall math.addF64
argument accumulateCall left CFloat64 accumulator
argument accumulateCall right CFloat64 iterationValue
run accumulateCall
bind value nextAccumulator CFloat64 accumulateCall
set memory accumulator nextAccumulator

# i = i + 1
call incrementCall math.addI64
argument incrementCall left I64 currentIteration
argument incrementCall right I64 iterationStep
run incrementCall
bind value nextIteration I64 incrementCall
set memory currentIteration nextIteration
jump target benchmarkLoopHead

label benchmarkFinished

call endClockCall c.clock
run endClockCall
bind value endClockTicks CCpuClockTicks endClockCall

call elapsedTicksCall math.subtractI64
argument elapsedTicksCall left CCpuClockTicks endClockTicks
argument elapsedTicksCall right CCpuClockTicks startClockTicks
run elapsedTicksCall
bind value elapsedClockTicks I64 elapsedTicksCall

storage module immutable reportFormatText CNullTerminatedByteString "iterations=%lld accumulator=%.6f clockTicks=%lld\n"
call reportCall c.printf
argument reportCall format CNullTerminatedByteString reportFormatText
argument reportCall iterations I64 iterationLimit
argument reportCall accumulator CFloat64 accumulator
argument reportCall ticks I64 elapsedClockTicks
run reportCall
ignore void source reportCall
bind error reportError CSignedInt32 reportCall
branch error source reportCall target consoleWriteFailed

storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode

label consoleWriteFailed
makeError consoleWriteFailure MainError.ConsoleWriteFailed reportError
return error consoleWriteFailure
