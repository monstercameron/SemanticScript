project Bootstrap5
target console
runtime AgentRuntime 0.1

entry console main

error MainError
errorCase MainError ConsoleWriteFailed CSignedInt32
errorCase MainError InputOpenFailed CSignedInt32
errorCase MainError AllocationFailed CSignedInt32
errorCase MainError CountdownMarkerNotFound CSignedInt32
errorCase MainError ExitCodeMarkerNotFound CSignedInt32

operation main
input main console Console
output main Result ExitCode MainError
effect main read filesystem
effect main write console.stdout
effect main allocate heap
effect main read memory.buffer
effect main write memory.buffer
memory main heap yes
memory main stack max 8KiB
async main no

purpose main "Self-host stage 5: read an SemanticScript countdown program, extract its CountdownValue and ExitCode integer literals, and emit a complete LLVM module whose main() prints each value from <CountdownValue> down to 1 on its own line via printf, then returns <ExitCode>. The emitted IR contains real basic-block control flow (loopHead/loopBody/loopExit) tied together by a conditional branch and an alloca-backed counter."
invariant main "Two integer literals are parsed: one tagged CountdownValue, one tagged ExitCode"
invariant main "The emitted module declares printf and defines main with at least four basic blocks"

label startMain

const inputPath CNullTerminatedByteString "SemanticScript/bootstrap/input5.sscript"
const readMode CNullTerminatedByteString "r"
const bufferCapacity CByteCount 8192
const readChunkCapacity CByteCount 8191
const oneByte CByteCount 1
const zeroByteOffset CByteCount 0
const zeroByteValue CSignedInt32 0

const countdownMarker CNullTerminatedByteString "CountdownValue "
const countdownMarkerLength CByteCount 15

const exitCodeMarker CNullTerminatedByteString "ExitCode "
const exitCodeMarkerLength CByteCount 9

const oneOffset I64 1
const tenValue I64 10
const asciiDigitZero I64 48
const asciiDigitNine I64 57

# ---- 1. open the input file ----
call inputOpenCall c.fopen
arg inputOpenCall path inputPath
arg inputOpenCall mode readMode
run inputOpenCall
bind inputFileHandle CFileHandle inputOpenCall

call inputOpenNullCheckCall pointer.isNull
arg inputOpenNullCheckCall pointer inputFileHandle
run inputOpenNullCheckCall
bind inputFileIsNull Bool inputOpenNullCheckCall
branchIf inputFileIsNull inputOpenFailed
branch inputOpened

label inputOpened

# ---- 2. allocate a read buffer ----
call readBufferAllocCall c.malloc
arg readBufferAllocCall size bufferCapacity
run readBufferAllocCall
bind readBuffer COpaqueMemoryAddress readBufferAllocCall

call readBufferNullCheckCall pointer.isNull
arg readBufferNullCheckCall pointer readBuffer
run readBufferNullCheckCall
bind readBufferIsNull Bool readBufferNullCheckCall
branchIf readBufferIsNull readBufferAllocationFailed
branch readBufferAllocated

label readBufferAllocated

# ---- 3. read up to (capacity - 1) bytes and null-terminate ----
call inputReadCall c.fread
arg inputReadCall buffer readBuffer
arg inputReadCall size oneByte
arg inputReadCall count readChunkCapacity
arg inputReadCall stream inputFileHandle
run inputReadCall
bind inputBytesRead CByteCount inputReadCall

call inputNullTerminatePointerCall pointer.offset
arg inputNullTerminatePointerCall base readBuffer
arg inputNullTerminatePointerCall offset inputBytesRead
run inputNullTerminatePointerCall
bind inputNullTerminatePointer COpaqueMemoryAddress inputNullTerminatePointerCall

call inputNullTerminateStoreCall pointer.storeByte
arg inputNullTerminateStoreCall buffer inputNullTerminatePointer
arg inputNullTerminateStoreCall offset zeroByteOffset
arg inputNullTerminateStoreCall value zeroByteValue
run inputNullTerminateStoreCall

# ---- 4. find first "CountdownValue " followed by a digit ----
var countdownSearchCursor I64 0
var countdownFirstDigitOffset I64 0

label countdownSearchLoopHead

call countdownSearchPointerCall pointer.offset
arg countdownSearchPointerCall base readBuffer
arg countdownSearchPointerCall offset countdownSearchCursor
run countdownSearchPointerCall
bind countdownSearchStart COpaqueMemoryAddress countdownSearchPointerCall

call countdownStrstrCall c.strstr
arg countdownStrstrCall haystack countdownSearchStart
arg countdownStrstrCall needle countdownMarker
run countdownStrstrCall
bind countdownHitPointer COpaqueMemoryAddress countdownStrstrCall

call countdownHitNullCheckCall pointer.isNull
arg countdownHitNullCheckCall pointer countdownHitPointer
run countdownHitNullCheckCall
bind countdownHitMissing Bool countdownHitNullCheckCall
branchIf countdownHitMissing countdownMarkerNotFound

call countdownDigitPointerCall pointer.offset
arg countdownDigitPointerCall base countdownHitPointer
arg countdownDigitPointerCall offset countdownMarkerLength
run countdownDigitPointerCall
bind countdownDigitPointer COpaqueMemoryAddress countdownDigitPointerCall

call countdownDigitOffsetCall pointer.difference
arg countdownDigitOffsetCall left countdownDigitPointer
arg countdownDigitOffsetCall right readBuffer
run countdownDigitOffsetCall
bind countdownDigitOffset CSignedInt64 countdownDigitOffsetCall

call countdownByteLoadCall pointer.loadByte
arg countdownByteLoadCall buffer readBuffer
arg countdownByteLoadCall offset countdownDigitOffset
run countdownByteLoadCall
bind countdownByte I8 countdownByteLoadCall

call countdownByteBelowZeroCall math.lessThanI64
arg countdownByteBelowZeroCall left countdownByte
arg countdownByteBelowZeroCall right asciiDigitZero
run countdownByteBelowZeroCall
bind countdownByteBelowZero Bool countdownByteBelowZeroCall
branchIf countdownByteBelowZero countdownByteNotADigit

call countdownByteAboveNineCall math.greaterThanI64
arg countdownByteAboveNineCall left countdownByte
arg countdownByteAboveNineCall right asciiDigitNine
run countdownByteAboveNineCall
bind countdownByteAboveNine Bool countdownByteAboveNineCall
branchIf countdownByteAboveNine countdownByteNotADigit

set countdownFirstDigitOffset countdownDigitOffset
branch countdownDigitFound

label countdownByteNotADigit
set countdownSearchCursor countdownDigitOffset
branch countdownSearchLoopHead

label countdownDigitFound

# ---- 5. parse the CountdownValue integer ----
var countdownDigitCursor I64 0
set countdownDigitCursor countdownFirstDigitOffset
var countdownAccumulator I64 0

label countdownDigitLoopHead

call countdownDigitLoadCall pointer.loadByte
arg countdownDigitLoadCall buffer readBuffer
arg countdownDigitLoadCall offset countdownDigitCursor
run countdownDigitLoadCall
bind countdownDigitByte I8 countdownDigitLoadCall

call countdownDigitBelowZeroCall math.lessThanI64
arg countdownDigitBelowZeroCall left countdownDigitByte
arg countdownDigitBelowZeroCall right asciiDigitZero
run countdownDigitBelowZeroCall
bind countdownDigitBelowZero Bool countdownDigitBelowZeroCall
branchIf countdownDigitBelowZero countdownDigitLoopExit

call countdownDigitAboveNineCall math.greaterThanI64
arg countdownDigitAboveNineCall left countdownDigitByte
arg countdownDigitAboveNineCall right asciiDigitNine
run countdownDigitAboveNineCall
bind countdownDigitAboveNine Bool countdownDigitAboveNineCall
branchIf countdownDigitAboveNine countdownDigitLoopExit

call countdownDigitValueCall math.subtractI64
arg countdownDigitValueCall left countdownDigitByte
arg countdownDigitValueCall right asciiDigitZero
run countdownDigitValueCall
bind countdownDigitValue I64 countdownDigitValueCall

call countdownAccumulatorScaledCall math.multiplyI64
arg countdownAccumulatorScaledCall left countdownAccumulator
arg countdownAccumulatorScaledCall right tenValue
run countdownAccumulatorScaledCall
bind countdownAccumulatorScaled I64 countdownAccumulatorScaledCall

call countdownAccumulatorNextCall math.addI64
arg countdownAccumulatorNextCall left countdownAccumulatorScaled
arg countdownAccumulatorNextCall right countdownDigitValue
run countdownAccumulatorNextCall
bind countdownAccumulatorNext I64 countdownAccumulatorNextCall
set countdownAccumulator countdownAccumulatorNext

call countdownNextDigitCursorCall math.addI64
arg countdownNextDigitCursorCall left countdownDigitCursor
arg countdownNextDigitCursorCall right oneOffset
run countdownNextDigitCursorCall
bind countdownNextDigitCursor I64 countdownNextDigitCursorCall
set countdownDigitCursor countdownNextDigitCursor

branch countdownDigitLoopHead

label countdownDigitLoopExit

# ---- 6. find first "ExitCode " followed by a digit ----
var exitSearchCursor I64 0
var exitFirstDigitOffset I64 0

label exitSearchLoopHead

call exitSearchPointerCall pointer.offset
arg exitSearchPointerCall base readBuffer
arg exitSearchPointerCall offset exitSearchCursor
run exitSearchPointerCall
bind exitSearchStart COpaqueMemoryAddress exitSearchPointerCall

call exitStrstrCall c.strstr
arg exitStrstrCall haystack exitSearchStart
arg exitStrstrCall needle exitCodeMarker
run exitStrstrCall
bind exitHitPointer COpaqueMemoryAddress exitStrstrCall

call exitHitNullCheckCall pointer.isNull
arg exitHitNullCheckCall pointer exitHitPointer
run exitHitNullCheckCall
bind exitHitMissing Bool exitHitNullCheckCall
branchIf exitHitMissing exitCodeMarkerNotFound

call exitDigitPointerCall pointer.offset
arg exitDigitPointerCall base exitHitPointer
arg exitDigitPointerCall offset exitCodeMarkerLength
run exitDigitPointerCall
bind exitDigitPointer COpaqueMemoryAddress exitDigitPointerCall

call exitDigitOffsetCall pointer.difference
arg exitDigitOffsetCall left exitDigitPointer
arg exitDigitOffsetCall right readBuffer
run exitDigitOffsetCall
bind exitDigitOffset CSignedInt64 exitDigitOffsetCall

call exitByteLoadCall pointer.loadByte
arg exitByteLoadCall buffer readBuffer
arg exitByteLoadCall offset exitDigitOffset
run exitByteLoadCall
bind exitByte I8 exitByteLoadCall

call exitByteBelowZeroCall math.lessThanI64
arg exitByteBelowZeroCall left exitByte
arg exitByteBelowZeroCall right asciiDigitZero
run exitByteBelowZeroCall
bind exitByteBelowZero Bool exitByteBelowZeroCall
branchIf exitByteBelowZero exitByteNotADigit

call exitByteAboveNineCall math.greaterThanI64
arg exitByteAboveNineCall left exitByte
arg exitByteAboveNineCall right asciiDigitNine
run exitByteAboveNineCall
bind exitByteAboveNine Bool exitByteAboveNineCall
branchIf exitByteAboveNine exitByteNotADigit

set exitFirstDigitOffset exitDigitOffset
branch exitDigitFound

label exitByteNotADigit
set exitSearchCursor exitDigitOffset
branch exitSearchLoopHead

label exitDigitFound

# ---- 7. parse the ExitCode integer ----
var exitDigitCursor I64 0
set exitDigitCursor exitFirstDigitOffset
var exitAccumulator I64 0

label exitDigitLoopHead

call exitParseLoadCall pointer.loadByte
arg exitParseLoadCall buffer readBuffer
arg exitParseLoadCall offset exitDigitCursor
run exitParseLoadCall
bind exitParseByte I8 exitParseLoadCall

call exitParseBelowZeroCall math.lessThanI64
arg exitParseBelowZeroCall left exitParseByte
arg exitParseBelowZeroCall right asciiDigitZero
run exitParseBelowZeroCall
bind exitParseBelowZero Bool exitParseBelowZeroCall
branchIf exitParseBelowZero exitDigitLoopExit

call exitParseAboveNineCall math.greaterThanI64
arg exitParseAboveNineCall left exitParseByte
arg exitParseAboveNineCall right asciiDigitNine
run exitParseAboveNineCall
bind exitParseAboveNine Bool exitParseAboveNineCall
branchIf exitParseAboveNine exitDigitLoopExit

call exitParseDigitValueCall math.subtractI64
arg exitParseDigitValueCall left exitParseByte
arg exitParseDigitValueCall right asciiDigitZero
run exitParseDigitValueCall
bind exitParseDigitValue I64 exitParseDigitValueCall

call exitParseAccumScaledCall math.multiplyI64
arg exitParseAccumScaledCall left exitAccumulator
arg exitParseAccumScaledCall right tenValue
run exitParseAccumScaledCall
bind exitParseAccumScaled I64 exitParseAccumScaledCall

call exitParseAccumNextCall math.addI64
arg exitParseAccumNextCall left exitParseAccumScaled
arg exitParseAccumNextCall right exitParseDigitValue
run exitParseAccumNextCall
bind exitParseAccumNext I64 exitParseAccumNextCall
set exitAccumulator exitParseAccumNext

call exitParseNextCursorCall math.addI64
arg exitParseNextCursorCall left exitDigitCursor
arg exitParseNextCursorCall right oneOffset
run exitParseNextCursorCall
bind exitParseNextCursor I64 exitParseNextCursorCall
set exitDigitCursor exitParseNextCursor

branch exitDigitLoopHead

label exitDigitLoopExit

# ---- 8. emit the LLVM IR module ----

const irModuleBanner CNullTerminatedByteString "; ModuleID = 'SemanticScriptStage5SelfHosted'"
call writeIrModuleBannerCall c.puts
arg writeIrModuleBannerCall text irModuleBanner
run writeIrModuleBannerCall
ignoreOk writeIrModuleBannerCall Void
bindError writeIrModuleBannerError CSignedInt32 writeIrModuleBannerCall
branchIfError writeIrModuleBannerCall consoleWriteFailed

const irTargetTriple CNullTerminatedByteString "target triple = \"x86_64-pc-windows-msvc\""
call writeIrTargetTripleCall c.puts
arg writeIrTargetTripleCall text irTargetTriple
run writeIrTargetTripleCall
ignoreOk writeIrTargetTripleCall Void
bindError writeIrTargetTripleError CSignedInt32 writeIrTargetTripleCall
branchIfError writeIrTargetTripleCall consoleWriteFailed

# Emit `@.fmt = private constant [6 x i8] c"%lld\0A\00"` — the printf
# format string. The double backslashes in the SemanticScript source produce a
# single backslash byte in the output IR, matching LLVM's IR escape
# syntax.
const irFormatLine CNullTerminatedByteString "@.fmt = private constant [6 x i8] c\"%lld\\0A\\00\""
call writeIrFormatLineCall c.puts
arg writeIrFormatLineCall text irFormatLine
run writeIrFormatLineCall
ignoreOk writeIrFormatLineCall Void
bindError writeIrFormatLineError CSignedInt32 writeIrFormatLineCall
branchIfError writeIrFormatLineCall consoleWriteFailed

const irExternPrintf CNullTerminatedByteString "declare i32 @printf(i8*, ...)"
call writeIrExternPrintfCall c.puts
arg writeIrExternPrintfCall text irExternPrintf
run writeIrExternPrintfCall
ignoreOk writeIrExternPrintfCall Void
bindError writeIrExternPrintfError CSignedInt32 writeIrExternPrintfCall
branchIfError writeIrExternPrintfCall consoleWriteFailed

const irMainHeader CNullTerminatedByteString "define i32 @main() {"
call writeIrMainHeaderCall c.puts
arg writeIrMainHeaderCall text irMainHeader
run writeIrMainHeaderCall
ignoreOk writeIrMainHeaderCall Void
bindError writeIrMainHeaderError CSignedInt32 writeIrMainHeaderCall
branchIfError writeIrMainHeaderCall consoleWriteFailed

const irEntryBlock CNullTerminatedByteString "entry:"
call writeIrEntryBlockCall c.puts
arg writeIrEntryBlockCall text irEntryBlock
run writeIrEntryBlockCall
ignoreOk writeIrEntryBlockCall Void
bindError writeIrEntryBlockError CSignedInt32 writeIrEntryBlockCall
branchIfError writeIrEntryBlockCall consoleWriteFailed

const irAlloca CNullTerminatedByteString "  %counter = alloca i64"
call writeIrAllocaCall c.puts
arg writeIrAllocaCall text irAlloca
run writeIrAllocaCall
ignoreOk writeIrAllocaCall Void
bindError writeIrAllocaError CSignedInt32 writeIrAllocaCall
branchIfError writeIrAllocaCall consoleWriteFailed

const irStoreStartFormat CNullTerminatedByteString "  store i64 %lld, i64* %%counter"
call writeIrStoreStartCall c.printf
arg writeIrStoreStartCall format irStoreStartFormat
arg writeIrStoreStartCall value countdownAccumulator
run writeIrStoreStartCall
ignoreOk writeIrStoreStartCall Void
bindError writeIrStoreStartError CSignedInt32 writeIrStoreStartCall
branchIfError writeIrStoreStartCall consoleWriteFailed

const irNewlineEmpty CNullTerminatedByteString ""
call writeNewlineAfterStoreStart c.puts
arg writeNewlineAfterStoreStart text irNewlineEmpty
run writeNewlineAfterStoreStart
ignoreOk writeNewlineAfterStoreStart Void
bindError writeNewlineAfterStoreStartError CSignedInt32 writeNewlineAfterStoreStart
branchIfError writeNewlineAfterStoreStart consoleWriteFailed

const irBrLoopHead CNullTerminatedByteString "  br label %loopHead"
call writeIrBrLoopHeadCall c.puts
arg writeIrBrLoopHeadCall text irBrLoopHead
run writeIrBrLoopHeadCall
ignoreOk writeIrBrLoopHeadCall Void
bindError writeIrBrLoopHeadError CSignedInt32 writeIrBrLoopHeadCall
branchIfError writeIrBrLoopHeadCall consoleWriteFailed

const irLoopHead CNullTerminatedByteString "loopHead:"
call writeIrLoopHeadCall c.puts
arg writeIrLoopHeadCall text irLoopHead
run writeIrLoopHeadCall
ignoreOk writeIrLoopHeadCall Void
bindError writeIrLoopHeadError CSignedInt32 writeIrLoopHeadCall
branchIfError writeIrLoopHeadCall consoleWriteFailed

const irLoadCur CNullTerminatedByteString "  %cur = load i64, i64* %counter"
call writeIrLoadCurCall c.puts
arg writeIrLoadCurCall text irLoadCur
run writeIrLoadCurCall
ignoreOk writeIrLoadCurCall Void
bindError writeIrLoadCurError CSignedInt32 writeIrLoadCurCall
branchIfError writeIrLoadCurCall consoleWriteFailed

const irIsPositive CNullTerminatedByteString "  %isPositive = icmp sgt i64 %cur, 0"
call writeIrIsPositiveCall c.puts
arg writeIrIsPositiveCall text irIsPositive
run writeIrIsPositiveCall
ignoreOk writeIrIsPositiveCall Void
bindError writeIrIsPositiveError CSignedInt32 writeIrIsPositiveCall
branchIfError writeIrIsPositiveCall consoleWriteFailed

const irBrCond CNullTerminatedByteString "  br i1 %isPositive, label %loopBody, label %loopExit"
call writeIrBrCondCall c.puts
arg writeIrBrCondCall text irBrCond
run writeIrBrCondCall
ignoreOk writeIrBrCondCall Void
bindError writeIrBrCondError CSignedInt32 writeIrBrCondCall
branchIfError writeIrBrCondCall consoleWriteFailed

const irLoopBody CNullTerminatedByteString "loopBody:"
call writeIrLoopBodyCall c.puts
arg writeIrLoopBodyCall text irLoopBody
run writeIrLoopBodyCall
ignoreOk writeIrLoopBodyCall Void
bindError writeIrLoopBodyError CSignedInt32 writeIrLoopBodyCall
branchIfError writeIrLoopBodyCall consoleWriteFailed

const irLoadVal CNullTerminatedByteString "  %val = load i64, i64* %counter"
call writeIrLoadValCall c.puts
arg writeIrLoadValCall text irLoadVal
run writeIrLoadValCall
ignoreOk writeIrLoadValCall Void
bindError writeIrLoadValError CSignedInt32 writeIrLoadValCall
branchIfError writeIrLoadValCall consoleWriteFailed

const irFmtPtr CNullTerminatedByteString "  %ptr = getelementptr inbounds [6 x i8], [6 x i8]* @.fmt, i32 0, i32 0"
call writeIrFmtPtrCall c.puts
arg writeIrFmtPtrCall text irFmtPtr
run writeIrFmtPtrCall
ignoreOk writeIrFmtPtrCall Void
bindError writeIrFmtPtrError CSignedInt32 writeIrFmtPtrCall
branchIfError writeIrFmtPtrCall consoleWriteFailed

const irPrintfCall CNullTerminatedByteString "  %printResult = call i32 (i8*, ...) @printf(i8* %ptr, i64 %val)"
call writeIrPrintfCall c.puts
arg writeIrPrintfCall text irPrintfCall
run writeIrPrintfCall
ignoreOk writeIrPrintfCall Void
bindError writeIrPrintfError CSignedInt32 writeIrPrintfCall
branchIfError writeIrPrintfCall consoleWriteFailed

const irDec CNullTerminatedByteString "  %dec = sub i64 %val, 1"
call writeIrDecCall c.puts
arg writeIrDecCall text irDec
run writeIrDecCall
ignoreOk writeIrDecCall Void
bindError writeIrDecError CSignedInt32 writeIrDecCall
branchIfError writeIrDecCall consoleWriteFailed

const irStoreNext CNullTerminatedByteString "  store i64 %dec, i64* %counter"
call writeIrStoreNextCall c.puts
arg writeIrStoreNextCall text irStoreNext
run writeIrStoreNextCall
ignoreOk writeIrStoreNextCall Void
bindError writeIrStoreNextError CSignedInt32 writeIrStoreNextCall
branchIfError writeIrStoreNextCall consoleWriteFailed

const irBrBackToHead CNullTerminatedByteString "  br label %loopHead"
call writeIrBrBackCall c.puts
arg writeIrBrBackCall text irBrBackToHead
run writeIrBrBackCall
ignoreOk writeIrBrBackCall Void
bindError writeIrBrBackError CSignedInt32 writeIrBrBackCall
branchIfError writeIrBrBackCall consoleWriteFailed

const irLoopExit CNullTerminatedByteString "loopExit:"
call writeIrLoopExitCall c.puts
arg writeIrLoopExitCall text irLoopExit
run writeIrLoopExitCall
ignoreOk writeIrLoopExitCall Void
bindError writeIrLoopExitError CSignedInt32 writeIrLoopExitCall
branchIfError writeIrLoopExitCall consoleWriteFailed

const irRetFormat CNullTerminatedByteString "  ret i32 %lld"
call writeIrRetCall c.printf
arg writeIrRetCall format irRetFormat
arg writeIrRetCall value exitAccumulator
run writeIrRetCall
ignoreOk writeIrRetCall Void
bindError writeIrRetError CSignedInt32 writeIrRetCall
branchIfError writeIrRetCall consoleWriteFailed

call writeNewlineAfterRet c.puts
arg writeNewlineAfterRet text irNewlineEmpty
run writeNewlineAfterRet
ignoreOk writeNewlineAfterRet Void
bindError writeNewlineAfterRetError CSignedInt32 writeNewlineAfterRet
branchIfError writeNewlineAfterRet consoleWriteFailed

const irMainFooter CNullTerminatedByteString "}"
call writeIrMainFooterCall c.puts
arg writeIrMainFooterCall text irMainFooter
run writeIrMainFooterCall
ignoreOk writeIrMainFooterCall Void
bindError writeIrMainFooterError CSignedInt32 writeIrMainFooterCall
branchIfError writeIrMainFooterCall consoleWriteFailed

# ---- 9. close input file ----
call inputCloseCall c.fclose
arg inputCloseCall stream inputFileHandle
run inputCloseCall
bind inputCloseResult CSignedInt32 inputCloseCall

const successfulExitCode ExitCode 0
returnOk successfulExitCode

label inputOpenFailed
const inputOpenFailedExitCode CSignedInt32 1
makeError inputOpenFailedFailure MainError.InputOpenFailed inputOpenFailedExitCode
returnError inputOpenFailedFailure

label readBufferAllocationFailed
const readBufferAllocationFailedExitCode CSignedInt32 2
makeError readBufferAllocationFailedFailure MainError.AllocationFailed readBufferAllocationFailedExitCode
returnError readBufferAllocationFailedFailure

label countdownMarkerNotFound
const countdownMarkerNotFoundExitCode CSignedInt32 3
makeError countdownMarkerNotFoundFailure MainError.CountdownMarkerNotFound countdownMarkerNotFoundExitCode
returnError countdownMarkerNotFoundFailure

label exitCodeMarkerNotFound
const exitCodeMarkerNotFoundExitCode CSignedInt32 4
makeError exitCodeMarkerNotFoundFailure MainError.ExitCodeMarkerNotFound exitCodeMarkerNotFoundExitCode
returnError exitCodeMarkerNotFoundFailure

label consoleWriteFailed
const consoleWriteFailedSentinel CSignedInt32 5
makeError consoleWriteFailedFailure MainError.ConsoleWriteFailed consoleWriteFailedSentinel
returnError consoleWriteFailedFailure
