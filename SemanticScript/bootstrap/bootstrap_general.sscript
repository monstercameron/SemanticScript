label runUnhandled
# Unknown target; emit a comment plus a dummy SSA definition so any
# subsequent `bind <name> <type> <callName>` reference (which becomes
# `%name = add i64 %callName_res, 0`) finds a defined SSA name.
call runUnhandledCallNamePtrCall pointer.offset
arg runUnhandledCallNamePtrCall base bufferBase
arg runUnhandledCallNamePtrCall offset pendingCallNameStartOffset
run runUnhandledCallNamePtrCall
bind runUnhandledCallNamePointer COpaqueMemoryAddress runUnhandledCallNamePtrCall

const runUnhandledFormat CNullTerminatedByteString "  ; UNHANDLED run target: %.*s\n  %%%.*s_res = add i64 0, 0\n"
call emitUnhandledRunCall c.printf
arg emitUnhandledRunCall format runUnhandledFormat
arg emitUnhandledRunCall lengthArg pendingCallTargetLength
arg emitUnhandledRunCall pointerArg runTargetPointer
arg emitUnhandledRunCall nlen pendingCallNameLength
arg emitUnhandledRunCall nptr runUnhandledCallNamePointer
run emitUnhandledRunCall
branch advanceVerbWalkerCursor

# ---- Emit helpers: each emit-Xxx label generates one math/printf
# instruction using pendingCallArg1/Arg2 as operands and the call
# name + "_res" as the result SSA name. Argument resolution happens
# inline: vars are loaded into temp SSA names first, consts are
# resolved to integer literals, binds are referenced as %<name>.
# ============================================================
label emitJsonStringifyI64Run
call jsI64CallNamePtrCall pointer.offset
arg jsI64CallNamePtrCall base bufferBase
arg jsI64CallNamePtrCall offset pendingCallNameStartOffset
run jsI64CallNamePtrCall
bind jsI64CallNamePointer COpaqueMemoryAddress jsI64CallNamePtrCall

call jsI64ArgPtrCall pointer.offset
arg jsI64ArgPtrCall base bufferBase
arg jsI64ArgPtrCall offset pendingCallArg1ValueStartOffset
run jsI64ArgPtrCall
bind jsI64ArgPointer COpaqueMemoryAddress jsI64ArgPtrCall

call jsI64ConstCall findConstIntegerValueByNameAfterOffset
arg jsI64ConstCall bufferBase bufferBase
arg jsI64ConstCall bufferEndOffset bufferEndOffset
arg jsI64ConstCall searchStartOffset operationBodyStartOffset
arg jsI64ConstCall targetNamePointer jsI64ArgPointer
arg jsI64ConstCall targetNameLength pendingCallArg1ValueLength
run jsI64ConstCall
bindOk jsI64ConstValue CSignedInt64 jsI64ConstCall

const jsonStringifyI64Fmt CNullTerminatedByteString "  %%%.*s_buf = alloca [32 x i8]\n  %%%.*s_res = getelementptr inbounds [32 x i8], [32 x i8]* %%%.*s_buf, i32 0, i32 0\n  %%%.*s_status = call i32 (i8*, i64, i8*, ...) @snprintf(i8* %%%.*s_res, i64 32, i8* getelementptr inbounds ([5 x i8], [5 x i8]* @.fmt_i64_json, i32 0, i32 0), i64 %lld)\n"
call emitJsonStringifyI64Call c.printf
arg emitJsonStringifyI64Call format jsonStringifyI64Fmt
arg emitJsonStringifyI64Call n1 pendingCallNameLength
arg emitJsonStringifyI64Call p1 jsI64CallNamePointer
arg emitJsonStringifyI64Call n2 pendingCallNameLength
arg emitJsonStringifyI64Call p2 jsI64CallNamePointer
arg emitJsonStringifyI64Call n3 pendingCallNameLength
arg emitJsonStringifyI64Call p3 jsI64CallNamePointer
arg emitJsonStringifyI64Call n4 pendingCallNameLength
arg emitJsonStringifyI64Call p4 jsI64CallNamePointer
arg emitJsonStringifyI64Call n5 pendingCallNameLength
arg emitJsonStringifyI64Call p5 jsI64CallNamePointer
arg emitJsonStringifyI64Call v jsI64ConstValue
run emitJsonStringifyI64Call
set blockNeedsTerminator oneFlagValue
branch emitBindRenameForCall

