call allocaTypeIsPointerCall isTypeTokenBytePointer
arg allocaTypeIsPointerCall typeNamePointer allocaTypePointer
run allocaTypeIsPointerCall
bindOk allocaVarIsPointer Bool allocaTypeIsPointerCall

