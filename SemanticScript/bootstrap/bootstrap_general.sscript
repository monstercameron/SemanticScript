call retOkPtrConstSlotValidCall math.greaterThanOrEqualI64
arg retOkPtrConstSlotValidCall left retOkPtrConstSlot
arg retOkPtrConstSlotValidCall right zeroVerbStep
run retOkPtrConstSlotValidCall
