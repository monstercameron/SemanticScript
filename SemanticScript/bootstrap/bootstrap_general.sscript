arg emitFloatVarStoreLitCall initTextPtr varInitReferencePointer
arg emitFloatVarStoreLitCall nameLen varNameLength
arg emitFloatVarStoreLitCall namePtr varNamePointer
run emitFloatVarStoreLitCall
