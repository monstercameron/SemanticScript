branchIf fgetAliasFloatLenMatch fgetAliasCheckFloatBytes
branch fgetAliasEmitInt

label fgetAliasCheckFloatBytes
call fgetAliasFloatCmpCall c.strncmp
arg fgetAliasFloatCmpCall left fgetFieldTypePointer
