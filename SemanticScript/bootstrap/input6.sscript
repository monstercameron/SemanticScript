# input6.sscript -- consumed by bootstrap6.exe.
#
# bootstrap6 is the first SemanticScript-written compiler whose output IR size
# scales with the input. It scans the source for an arbitrary number of
# greeting-string declarations and emits one LLVM string constant plus
# one dedicated print helper per declaration, then a main() that calls
# them in source order before exiting with the parsed ExitCode literal.
#
# Supported subset (bootstrap6):
#   - everything bootstrap5 supports
#   - N greeting-string constants, where N is whatever appears in the
#     source body (1, 2, 3, more)
#   - implicit one-to-one mapping: each declared greeting is printed via
#     puts() in source order
#
# This is the first stage where bootstrap can credibly be called a
# loop-driven compiler: removing any greeting line below changes the
# emitted IR, and the generated exe prints exactly N lines.

project Tiny6
target console
runtime AgentRuntime 0.1
entry console main

operation main
output main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose main "Print three greeting lines and then exit with the literal exit code."

label startMain

const lineOne CNullTerminatedByteString "Line 1: bootstrap6 found and compiled this greeting."
call print1Call console.writeLine
arg print1Call text lineOne
run print1Call

const lineTwo CNullTerminatedByteString "Line 2: each call became its own LLVM string + helper."
call print2Call console.writeLine
arg print2Call text lineTwo
run print2Call

const lineThree CNullTerminatedByteString "Line 3: the count of greetings is now part of the program."
call print3Call console.writeLine
arg print3Call text lineThree
run print3Call

const exitCodeValue ExitCode 0
returnOk exitCodeValue
