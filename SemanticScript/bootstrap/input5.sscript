# input5.sscript -- consumed by bootstrap5.exe.
#
# bootstrap5 is the fourth self-hosted compiler. It reads two integer
# literals from this file -- the loop start value tagged `CountdownValue`
# and the program exit code tagged `ExitCode` -- and emits LLVM IR for a
# countdown loop that prints each value from <start> down to 1 on its
# own line, then exits with <exitCode>.
#
# Supported subset (bootstrap5):
#   - everything bootstrap4 supports
#   - a single integer-valued constant tagged `CountdownValue`, used as
#     the loop start
#   - implicit loop body: print the counter as a decimal integer, then
#     decrement by 1; loop continues while counter > 0
#
# This stage exercises real LLVM basic-block control flow: the emitted
# IR has separate loopHead / loopBody / loopExit blocks linked by
# conditional branches, plus an alloca-backed mutable counter.

project Tiny5
target console
runtime AgentRuntime 0.1
entry console main

operation main
output main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose main "Print a countdown from CountdownValue down to 1, then exit with the literal exit code below."

label startMain

const countdownStartValue CountdownValue 5

const exitCodeValue ExitCode 0
returnOk exitCodeValue
