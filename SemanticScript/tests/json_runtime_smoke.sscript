# JSON runtime smoke - exercises the standard.json document CRUD surface
# end-to-end through semsc + the native_json adapter.
project JsonRuntimeSmoke
target console
runtime native 1
module fixture.json_runtime_smoke

import json standard.json
dependency standard.json version 0.1 source standard

entry console main

error MainError
errorCase MainError JsonAccessFailed JsonAccessError
errorCase MainError RoundTripMismatch CSignedInt32
errorCase MainError ConsoleWriteFailed ConsoleWriteError

capability jsonScratch console.stdout write
purpose operation jsonScratch "Authority to write smoke-result markers to stdout for the harness to assert against"
capability heapAllocCapability heap allocate
purpose operation heapAllocCapability "Authority to allocate JSON serialization and string scratch buffers"
capability heapFreeCapability heap free
purpose operation heapFreeCapability "Authority to free scratch buffers at deferred cleanup sites"

storage module immutable defaultJsonCapacity JsonCapacityBytes 4096
storage module immutable scratchCapacity JsonCapacityBytes 512
storage module immutable successExit ExitCode 0
storage module immutable objectRootKind CSignedInt32 0
storage module immutable expectedId CSignedInt64 42
storage module immutable missingIntDefault CSignedInt64 -1
storage module immutable missingBoolDefault CSignedInt32 -1
storage module immutable falseValue CSignedInt32 0
storage module immutable mismatchCode CSignedInt32 1

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
effect main allocate heap
effect main free heap
effect main read json.document.tree
effect main write json.document.tree
memory main heap auto
async main no
useCapability main jsonScratch
useCapability main heapAllocCapability
useCapability main heapFreeCapability
purpose operation main "Build a JSON object through json.createEmptyDocument and json.setObjectField*, read it back through cursors, serialize it, then write a success marker."
invariant operation main "Every recovered value must match the value written; any mismatch routes to RoundTripMismatch so the harness sees the failure."

label startMain

call createDocumentCall json.createEmptyDocument
argument createDocumentCall capacityBytes JsonCapacityBytes defaultJsonCapacity
argument createDocumentCall rootKind CSignedInt32 objectRootKind
run createDocumentCall
bind ok smokeDocument JsonDocument createDocumentCall
bind error createDocumentError JsonAccessError createDocumentCall
branch error source createDocumentCall target jsonAccessFailed

call rootCursorCall json.documentRoot
argument rootCursorCall document JsonDocument smokeDocument
run rootCursorCall
bind value rootCursor JsonCursor rootCursorCall

storage local immutable idFieldName CNullTerminatedByteString "id"
call setIdCall json.setObjectFieldInt64
argument setIdCall document JsonDocument smokeDocument
argument setIdCall cursor JsonCursor rootCursor
argument setIdCall fieldName CNullTerminatedByteString idFieldName
argument setIdCall value CSignedInt64 expectedId
run setIdCall
ignore ok source setIdCall type CSignedInt32
bind error setIdError JsonAccessError setIdCall
branch error source setIdCall target jsonAccessFailed

storage local immutable titleFieldName CNullTerminatedByteString "title"
storage local immutable titleValue CNullTerminatedByteString "hello \"json\"\\world\nline\t\x01"
call setTitleCall json.setObjectFieldString
argument setTitleCall document JsonDocument smokeDocument
argument setTitleCall cursor JsonCursor rootCursor
argument setTitleCall fieldName CNullTerminatedByteString titleFieldName
argument setTitleCall value CNullTerminatedByteString titleValue
run setTitleCall
ignore ok source setTitleCall type CSignedInt32
bind error setTitleError JsonAccessError setTitleCall
branch error source setTitleCall target jsonAccessFailed

storage local immutable doneFieldName CNullTerminatedByteString "done"
call setDoneCall json.setObjectFieldBool
argument setDoneCall document JsonDocument smokeDocument
argument setDoneCall cursor JsonCursor rootCursor
argument setDoneCall fieldName CNullTerminatedByteString doneFieldName
argument setDoneCall value CSignedInt32 falseValue
run setDoneCall
ignore ok source setDoneCall type CSignedInt32
bind error setDoneError JsonAccessError setDoneCall
branch error source setDoneCall target jsonAccessFailed

storage local immutable completedAtFieldName CNullTerminatedByteString "completedAt"
call setCompletedAtCall json.setObjectFieldNull
argument setCompletedAtCall document JsonDocument smokeDocument
argument setCompletedAtCall cursor JsonCursor rootCursor
argument setCompletedAtCall fieldName CNullTerminatedByteString completedAtFieldName
run setCompletedAtCall
ignore ok source setCompletedAtCall type CSignedInt32
bind error setCompletedAtError JsonAccessError setCompletedAtCall
branch error source setCompletedAtCall target jsonAccessFailed

call idCursorCall json.objectFieldAt
argument idCursorCall document JsonDocument smokeDocument
argument idCursorCall cursor JsonCursor rootCursor
argument idCursorCall fieldName CNullTerminatedByteString idFieldName
run idCursorCall
bind ok idCursor JsonCursor idCursorCall
bind error idCursorError JsonAccessError idCursorCall
branch error source idCursorCall target jsonAccessFailed

call readIdCall json.cursorInt64
argument readIdCall document JsonDocument smokeDocument
argument readIdCall cursor JsonCursor idCursor
argument readIdCall missingDefault CSignedInt64 missingIntDefault
run readIdCall
bind value recoveredId CSignedInt64 readIdCall

call idMatchCall math.equalI64
argument idMatchCall left CSignedInt64 recoveredId
argument idMatchCall right I64 expectedId
run idMatchCall
bind value idMatched Bool idMatchCall
branch if condition idMatched target idMatchOk
branch else target roundTripMismatch
label idMatchOk

call doneCursorCall json.objectFieldAt
argument doneCursorCall document JsonDocument smokeDocument
argument doneCursorCall cursor JsonCursor rootCursor
argument doneCursorCall fieldName CNullTerminatedByteString doneFieldName
run doneCursorCall
bind ok doneCursor JsonCursor doneCursorCall
bind error doneCursorError JsonAccessError doneCursorCall
branch error source doneCursorCall target jsonAccessFailed

call readDoneCall json.cursorBool
argument readDoneCall document JsonDocument smokeDocument
argument readDoneCall cursor JsonCursor doneCursor
argument readDoneCall missingDefault CSignedInt32 missingBoolDefault
run readDoneCall
bind value recoveredDone Bool readDoneCall
branch if condition recoveredDone target roundTripMismatch

call completedAtCursorCall json.objectFieldAt
argument completedAtCursorCall document JsonDocument smokeDocument
argument completedAtCursorCall cursor JsonCursor rootCursor
argument completedAtCursorCall fieldName CNullTerminatedByteString completedAtFieldName
run completedAtCursorCall
bind ok completedAtCursor JsonCursor completedAtCursorCall
bind error completedAtCursorError JsonAccessError completedAtCursorCall
branch error source completedAtCursorCall target jsonAccessFailed

call completedAtNullCall json.cursorIsNull
argument completedAtNullCall document JsonDocument smokeDocument
argument completedAtNullCall cursor JsonCursor completedAtCursor
run completedAtNullCall
bind value completedAtIsNull Bool completedAtNullCall
branch if condition completedAtIsNull target completedAtNullOk
branch else target roundTripMismatch
label completedAtNullOk

call allocateScratchCall c.malloc
argument allocateScratchCall size JsonCapacityBytes scratchCapacity
run allocateScratchCall
bind value titleScratch COpaqueMemoryAddress allocateScratchCall

call titleCursorCall json.objectFieldAt
argument titleCursorCall document JsonDocument smokeDocument
argument titleCursorCall cursor JsonCursor rootCursor
argument titleCursorCall fieldName CNullTerminatedByteString titleFieldName
run titleCursorCall
bind ok titleCursor JsonCursor titleCursorCall
bind error titleCursorError JsonAccessError titleCursorCall
branch error source titleCursorCall target jsonAccessFailed

call readTitleCall json.cursorString
argument readTitleCall document JsonDocument smokeDocument
argument readTitleCall cursor JsonCursor titleCursor
argument readTitleCall scratch COpaqueMemoryAddress titleScratch
argument readTitleCall scratchCapacity JsonCapacityBytes scratchCapacity
run readTitleCall
bind ok recoveredTitle CNullTerminatedByteString readTitleCall
bind error readTitleError JsonAccessError readTitleCall
branch error source readTitleCall target jsonAccessFailed

call titleNullCheckCall pointer.isNull
argument titleNullCheckCall pointer CNullTerminatedByteString recoveredTitle
run titleNullCheckCall
bind value titleIsNull Bool titleNullCheckCall
branch if condition titleIsNull target roundTripMismatch

call serializeDocumentCall json.serializeDocument
argument serializeDocumentCall document JsonDocument smokeDocument
argument serializeDocumentCall scratch COpaqueMemoryAddress titleScratch
argument serializeDocumentCall scratchCapacity JsonCapacityBytes scratchCapacity
run serializeDocumentCall
bind ok serializedDocument JsonText serializeDocumentCall
bind error serializeDocumentError JsonAccessError serializeDocumentCall
branch error source serializeDocumentCall target jsonAccessFailed

storage local immutable successMarker CNullTerminatedByteString "jsonRuntimeSmokeOk"
call writeMarkerCall console.writeLine
argument writeMarkerCall console Console console
argument writeMarkerCall text CNullTerminatedByteString successMarker
run writeMarkerCall
ignore void source writeMarkerCall
bind error consoleWriteError ConsoleWriteError writeMarkerCall
branch error source writeMarkerCall target consoleWriteFailed

call releaseScratchCall c.free
argument releaseScratchCall ptr COpaqueMemoryAddress titleScratch
run releaseScratchCall

call destroyDocumentCall json.destroyDocument
argument destroyDocumentCall document JsonDocument smokeDocument
run destroyDocumentCall
ignore ok source destroyDocumentCall type CSignedInt32

return ok successExit

label jsonAccessFailed
makeError jsonAccessFailure MainError.JsonAccessFailed createDocumentError
return error jsonAccessFailure

label roundTripMismatch
makeError roundTripFailure MainError.RoundTripMismatch mismatchCode
return error roundTripFailure

label consoleWriteFailed
makeError consoleWriteFailure MainError.ConsoleWriteFailed consoleWriteError
return error consoleWriteFailure
