# JSON runtime smoke - exercises the standard.json document CRUD surface
# end-to-end through semsc + the native_json adapter.
project JsonRuntimeSmoke
target console
runtime native 1
module fixture.json_runtime_smoke

importModule standard.json as json
dependency standard.json version 0.1 source standard

entry console main

error MainError
errorCase MainError JsonAccessFailed JsonAccessError
errorCase MainError RoundTripMismatch CSignedInt32
errorCase MainError ConsoleWriteFailed ConsoleWriteError

capability jsonScratch console.stdout write
purpose jsonScratch "Authority to write smoke-result markers to stdout for the harness to assert against"
capability heapAllocCapability heap allocate
purpose heapAllocCapability "Authority to allocate JSON serialization and string scratch buffers"
capability heapFreeCapability heap free
purpose heapFreeCapability "Authority to free scratch buffers at deferred cleanup sites"

storage module immutable defaultJsonCapacity JsonCapacityBytes 4096
storage module immutable scratchCapacity JsonCapacityBytes 512
storage module immutable successExit ExitCode 0
storage module immutable objectRootKind CSignedInt32 0
storage module immutable expectedId CSignedInt64 42
storage module immutable missingIntDefault CSignedInt64 -1
storage module immutable missingBoolDefault CSignedInt32 -1
storage module immutable falseValue CSignedInt32 0
storage module immutable mismatchCode CSignedInt32 1

operation main
input main console Console
output main Result ExitCode MainError
effect main write console.stdout
effect main allocate heap
effect main free heap
effect main read json.document.tree
effect main write json.document.tree
memory main heap auto
async main no
useCapability main jsonScratch
useCapability main heapAllocCapability
useCapability main heapFreeCapability
purpose main "Build a JSON object through json.createEmptyDocument and json.setObjectField*, read it back through cursors, serialize it, then write a success marker."
invariant main "Every recovered value must match the value written; any mismatch routes to RoundTripMismatch so the harness sees the failure."

label startMain

call createDocumentCall json.createEmptyDocument
arg createDocumentCall capacityBytes defaultJsonCapacity
arg createDocumentCall rootKind objectRootKind
run createDocumentCall
bindOk smokeDocument JsonDocument createDocumentCall
bindError createDocumentError JsonAccessError createDocumentCall
branchIfError createDocumentCall jsonAccessFailed

call rootCursorCall json.documentRoot
arg rootCursorCall document smokeDocument
run rootCursorCall
bind rootCursor JsonCursor rootCursorCall

storage local immutable idFieldName CNullTerminatedByteString "id"
call setIdCall json.setObjectFieldInt64
arg setIdCall document smokeDocument
arg setIdCall cursor rootCursor
arg setIdCall fieldName idFieldName
arg setIdCall value expectedId
run setIdCall
ignoreOk setIdCall CSignedInt32
bindError setIdError JsonAccessError setIdCall
branchIfError setIdCall jsonAccessFailed

storage local immutable titleFieldName CNullTerminatedByteString "title"
storage local immutable titleValue CNullTerminatedByteString "hello \"json\"\\world\nline\t\x01"
call setTitleCall json.setObjectFieldString
arg setTitleCall document smokeDocument
arg setTitleCall cursor rootCursor
arg setTitleCall fieldName titleFieldName
arg setTitleCall value titleValue
run setTitleCall
ignoreOk setTitleCall CSignedInt32
bindError setTitleError JsonAccessError setTitleCall
branchIfError setTitleCall jsonAccessFailed

storage local immutable doneFieldName CNullTerminatedByteString "done"
call setDoneCall json.setObjectFieldBool
arg setDoneCall document smokeDocument
arg setDoneCall cursor rootCursor
arg setDoneCall fieldName doneFieldName
arg setDoneCall value falseValue
run setDoneCall
ignoreOk setDoneCall CSignedInt32
bindError setDoneError JsonAccessError setDoneCall
branchIfError setDoneCall jsonAccessFailed

storage local immutable completedAtFieldName CNullTerminatedByteString "completedAt"
call setCompletedAtCall json.setObjectFieldNull
arg setCompletedAtCall document smokeDocument
arg setCompletedAtCall cursor rootCursor
arg setCompletedAtCall fieldName completedAtFieldName
run setCompletedAtCall
ignoreOk setCompletedAtCall CSignedInt32
bindError setCompletedAtError JsonAccessError setCompletedAtCall
branchIfError setCompletedAtCall jsonAccessFailed

call idCursorCall json.objectFieldAt
arg idCursorCall document smokeDocument
arg idCursorCall cursor rootCursor
arg idCursorCall fieldName idFieldName
run idCursorCall
bindOk idCursor JsonCursor idCursorCall
bindError idCursorError JsonAccessError idCursorCall
branchIfError idCursorCall jsonAccessFailed

call readIdCall json.cursorInt64
arg readIdCall document smokeDocument
arg readIdCall cursor idCursor
arg readIdCall missingDefault missingIntDefault
run readIdCall
bind recoveredId CSignedInt64 readIdCall

call idMatchCall math.equalI64
arg idMatchCall left recoveredId
arg idMatchCall right expectedId
run idMatchCall
bind idMatched Bool idMatchCall
branchIf idMatched idMatchOk
branch roundTripMismatch
label idMatchOk

call doneCursorCall json.objectFieldAt
arg doneCursorCall document smokeDocument
arg doneCursorCall cursor rootCursor
arg doneCursorCall fieldName doneFieldName
run doneCursorCall
bindOk doneCursor JsonCursor doneCursorCall
bindError doneCursorError JsonAccessError doneCursorCall
branchIfError doneCursorCall jsonAccessFailed

call readDoneCall json.cursorBool
arg readDoneCall document smokeDocument
arg readDoneCall cursor doneCursor
arg readDoneCall missingDefault missingBoolDefault
run readDoneCall
bind recoveredDone Bool readDoneCall
branchIf recoveredDone roundTripMismatch

call completedAtCursorCall json.objectFieldAt
arg completedAtCursorCall document smokeDocument
arg completedAtCursorCall cursor rootCursor
arg completedAtCursorCall fieldName completedAtFieldName
run completedAtCursorCall
bindOk completedAtCursor JsonCursor completedAtCursorCall
bindError completedAtCursorError JsonAccessError completedAtCursorCall
branchIfError completedAtCursorCall jsonAccessFailed

call completedAtNullCall json.cursorIsNull
arg completedAtNullCall document smokeDocument
arg completedAtNullCall cursor completedAtCursor
run completedAtNullCall
bind completedAtIsNull Bool completedAtNullCall
branchIf completedAtIsNull completedAtNullOk
branch roundTripMismatch
label completedAtNullOk

call allocateScratchCall c.malloc
arg allocateScratchCall size scratchCapacity
run allocateScratchCall
bind titleScratch COpaqueMemoryAddress allocateScratchCall

call titleCursorCall json.objectFieldAt
arg titleCursorCall document smokeDocument
arg titleCursorCall cursor rootCursor
arg titleCursorCall fieldName titleFieldName
run titleCursorCall
bindOk titleCursor JsonCursor titleCursorCall
bindError titleCursorError JsonAccessError titleCursorCall
branchIfError titleCursorCall jsonAccessFailed

call readTitleCall json.cursorString
arg readTitleCall document smokeDocument
arg readTitleCall cursor titleCursor
arg readTitleCall scratch titleScratch
arg readTitleCall scratchCapacity scratchCapacity
run readTitleCall
bindOk recoveredTitle CNullTerminatedByteString readTitleCall
bindError readTitleError JsonAccessError readTitleCall
branchIfError readTitleCall jsonAccessFailed

call titleNullCheckCall pointer.isNull
arg titleNullCheckCall pointer recoveredTitle
run titleNullCheckCall
bind titleIsNull Bool titleNullCheckCall
branchIf titleIsNull roundTripMismatch

call serializeDocumentCall json.serializeDocument
arg serializeDocumentCall document smokeDocument
arg serializeDocumentCall scratch titleScratch
arg serializeDocumentCall scratchCapacity scratchCapacity
run serializeDocumentCall
bindOk serializedDocument JsonText serializeDocumentCall
bindError serializeDocumentError JsonAccessError serializeDocumentCall
branchIfError serializeDocumentCall jsonAccessFailed

storage local immutable successMarker CNullTerminatedByteString "jsonRuntimeSmokeOk"
call writeMarkerCall console.writeLine
arg writeMarkerCall console console
arg writeMarkerCall text successMarker
run writeMarkerCall
ignoreOk writeMarkerCall Void
bindError consoleWriteError ConsoleWriteError writeMarkerCall
branchIfError writeMarkerCall consoleWriteFailed

call releaseScratchCall c.free
arg releaseScratchCall ptr titleScratch
run releaseScratchCall

call destroyDocumentCall json.destroyDocument
arg destroyDocumentCall document smokeDocument
run destroyDocumentCall
ignoreOk destroyDocumentCall CSignedInt32

returnOk successExit

label jsonAccessFailed
makeError jsonAccessFailure MainError.JsonAccessFailed createDocumentError
returnError jsonAccessFailure

label roundTripMismatch
makeError roundTripFailure MainError.RoundTripMismatch mismatchCode
returnError roundTripFailure

label consoleWriteFailed
makeError consoleWriteFailure MainError.ConsoleWriteFailed consoleWriteError
returnError consoleWriteFailure
