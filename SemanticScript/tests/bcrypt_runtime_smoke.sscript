# Bcrypt smoke — exercises the standard.bcrypt builder + finder
# surface end-to-end through semsc + the native_bcrypt adapter.
# Writes 'bcryptRuntimeSmokeOk' to stdout on success; non-zero exit
# (with a stage tag in stderr) on any mismatch.

project BcryptRuntimeSmoke
target console
runtime native 1
module fixture.bcrypt_runtime_smoke

importModule standard.bcrypt

entry console main

error MainError
errorCase MainError HashFailed CSignedInt32
errorCase MainError VerifyShouldMatchButDidNot CSignedInt32
errorCase MainError VerifyShouldRejectButMatched CSignedInt32
errorCase MainError RandomBytesFailed CSignedInt32
errorCase MainError Base64EncodeFailed CSignedInt32
errorCase MainError ConsoleWriteFailed ConsoleWriteError

capability bcryptSmokeStdoutWrite console.stdout write
purpose bcryptSmokeStdoutWrite "Authority to write the smoke marker to stdout"
capability bcryptSmokeHeapAlloc heap allocate
purpose bcryptSmokeHeapAlloc "Authority to allocate the hash + token + random scratch buffers"
capability bcryptSmokeHeapFree heap free
purpose bcryptSmokeHeapFree "Authority to free the same buffers at defer time"

storage module immutable successExit ExitCode 0
storage module immutable matchedSentinel CSignedInt32 1
storage module immutable mismatchedSentinel CSignedInt32 0

operation main
input main console Console
output main Result ExitCode MainError
effect main write console.stdout
effect main allocate heap
effect main free heap
memory main heap auto
async main no
useCapability main bcryptSmokeStdoutWrite
useCapability main bcryptSmokeHeapAlloc
useCapability main bcryptSmokeHeapFree
purpose main "Round-trip a password through bcrypt.hashPassword + bcrypt.verifyPassword at cost 12, then generate a 32-byte CSPRNG sample and base64url-encode it to a 43-char session token. Every step's status is asserted with a typed failure label so the harness can attribute a regression to a specific phase."
invariant main "All three c.malloc allocations are paired with defer c.free; even the failure labels propagate through the deferred cleanup before returnError fires."

label startMain

# Allocate the 61-byte hash output buffer.
storage local immutable hashBufferCapacity CSignedInt64 61
call allocateHashBufferCall c.malloc
arg allocateHashBufferCall size hashBufferCapacity
run allocateHashBufferCall
bind hashBuffer COpaqueMemoryAddress allocateHashBufferCall
defer releaseHashBufferDefer c.free hashBuffer

# Hash the password at cost 12.
storage local immutable smokePlaintext CNullTerminatedByteString "correct-horse-battery-staple"
storage local immutable hashCapacityArg CSignedInt32 61
call hashPasswordCall bcrypt.hashPassword
arg hashPasswordCall plaintext smokePlaintext
arg hashPasswordCall cost bcryptRecommendedCost
arg hashPasswordCall outBuffer hashBuffer
arg hashPasswordCall outCapacity hashCapacityArg
run hashPasswordCall
bind hashStatus CSignedInt32 hashPasswordCall

call hashStatusOkCheckCall math.equalCSignedInt32
arg hashStatusOkCheckCall left hashStatus
arg hashStatusOkCheckCall right successExit
run hashStatusOkCheckCall
bind hashStatusOk Bool hashStatusOkCheckCall
branchIf hashStatusOk hashStatusOkLabel
branch hashShouldHaveSucceededFailed
label hashStatusOkLabel

# Verify correct plaintext — must return SS_BCRYPT_MATCH (1).
call verifyCorrectCall bcrypt.verifyPassword
arg verifyCorrectCall plaintext smokePlaintext
arg verifyCorrectCall expectedHash hashBuffer
run verifyCorrectCall
bind verifyCorrectResult CSignedInt32 verifyCorrectCall

call verifyCorrectMatchCheckCall math.equalCSignedInt32
arg verifyCorrectMatchCheckCall left verifyCorrectResult
arg verifyCorrectMatchCheckCall right matchedSentinel
run verifyCorrectMatchCheckCall
bind verifyCorrectMatched Bool verifyCorrectMatchCheckCall
branchIf verifyCorrectMatched verifyCorrectMatchedLabel
branch verifyShouldHaveMatchedFailed
label verifyCorrectMatchedLabel

# Verify WRONG plaintext — must return SS_BCRYPT_MISMATCH (0).
storage local immutable wrongPlaintext CNullTerminatedByteString "definitely-not-the-password"
call verifyWrongCall bcrypt.verifyPassword
arg verifyWrongCall plaintext wrongPlaintext
arg verifyWrongCall expectedHash hashBuffer
run verifyWrongCall
bind verifyWrongResult CSignedInt32 verifyWrongCall

call verifyWrongRejectCheckCall math.equalCSignedInt32
arg verifyWrongRejectCheckCall left verifyWrongResult
arg verifyWrongRejectCheckCall right mismatchedSentinel
run verifyWrongRejectCheckCall
bind verifyWrongRejected Bool verifyWrongRejectCheckCall
branchIf verifyWrongRejected verifyWrongRejectedLabel
branch verifyShouldHaveRejectedFailed
label verifyWrongRejectedLabel

# Generate a 32-byte random sample.
storage local immutable randomBufferCapacity CSignedInt64 32
call allocateRandomBufferCall c.malloc
arg allocateRandomBufferCall size randomBufferCapacity
run allocateRandomBufferCall
bind randomBuffer COpaqueMemoryAddress allocateRandomBufferCall
defer releaseRandomBufferDefer c.free randomBuffer

storage local immutable randomByteCount CSignedInt32 32
call randomBytesCall bcrypt.randomBytes
arg randomBytesCall outBuffer randomBuffer
arg randomBytesCall byteCount randomByteCount
run randomBytesCall
bind randomStatus CSignedInt32 randomBytesCall

call randomStatusOkCheckCall math.equalCSignedInt32
arg randomStatusOkCheckCall left randomStatus
arg randomStatusOkCheckCall right successExit
run randomStatusOkCheckCall
bind randomStatusOk Bool randomStatusOkCheckCall
branchIf randomStatusOk randomStatusOkLabel
branch randomBytesShouldHaveSucceededFailed
label randomStatusOkLabel

# Base64url-encode into a 44-byte buffer; expect 43 written + NUL.
storage local immutable tokenBufferCapacity CSignedInt64 44
call allocateTokenBufferCall c.malloc
arg allocateTokenBufferCall size tokenBufferCapacity
run allocateTokenBufferCall
bind tokenBuffer COpaqueMemoryAddress allocateTokenBufferCall
defer releaseTokenBufferDefer c.free tokenBuffer

# The length-out pointer needs to be a real i32 alloca.
var encodedLength CSignedInt32 0
storage local immutable tokenCapacityArg CSignedInt32 44
call encodeTokenCall bcrypt.base64UrlEncode
arg encodeTokenCall inputBuffer randomBuffer
arg encodeTokenCall inputCount randomByteCount
arg encodeTokenCall outputBuffer tokenBuffer
arg encodeTokenCall outputCapacity tokenCapacityArg
arg encodeTokenCall outputLengthOut encodedLength
run encodeTokenCall
bind encodeStatus CSignedInt32 encodeTokenCall

call encodeStatusOkCheckCall math.equalCSignedInt32
arg encodeStatusOkCheckCall left encodeStatus
arg encodeStatusOkCheckCall right successExit
run encodeStatusOkCheckCall
bind encodeStatusOk Bool encodeStatusOkCheckCall
branchIf encodeStatusOk encodeStatusOkLabel
branch base64EncodeShouldHaveSucceededFailed
label encodeStatusOkLabel

# Success — emit the marker.
storage local immutable successMarker CNullTerminatedByteString "bcryptRuntimeSmokeOk"
call writeMarkerCall console.writeLine
arg writeMarkerCall console console
arg writeMarkerCall text successMarker
run writeMarkerCall
ignoreOk writeMarkerCall Void
bindError consoleWriteError ConsoleWriteError writeMarkerCall
branchIfError writeMarkerCall consoleSmokeWriteFailed

returnOk successExit

label hashShouldHaveSucceededFailed
makeError hashFailedFailure MainError.HashFailed hashStatus
returnError hashFailedFailure

label verifyShouldHaveMatchedFailed
makeError verifyShouldMatchFailure MainError.VerifyShouldMatchButDidNot verifyCorrectResult
returnError verifyShouldMatchFailure

label verifyShouldHaveRejectedFailed
makeError verifyShouldRejectFailure MainError.VerifyShouldRejectButMatched verifyWrongResult
returnError verifyShouldRejectFailure

label randomBytesShouldHaveSucceededFailed
makeError randomBytesFailedFailure MainError.RandomBytesFailed randomStatus
returnError randomBytesFailedFailure

label base64EncodeShouldHaveSucceededFailed
makeError base64EncodeFailedFailure MainError.Base64EncodeFailed encodeStatus
returnError base64EncodeFailedFailure

label consoleSmokeWriteFailed
makeError consoleWriteFailure MainError.ConsoleWriteFailed consoleWriteError
returnError consoleWriteFailure
