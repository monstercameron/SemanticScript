# Bcrypt smoke — exercises the standard.bcrypt builder + finder
# surface end-to-end through semsc + the native_bcrypt adapter.
# Writes 'bcryptRuntimeSmokeOk' to stdout on success; non-zero exit
# (with a stage tag in stderr) on any mismatch.

project BcryptRuntimeSmoke
target console
runtime native 1
module fixture.bcrypt_runtime_smoke

import bcrypt standard.bcrypt

entry console main

error MainError
errorCase MainError HashFailed Int32
errorCase MainError VerifyShouldMatchButDidNot Int32
errorCase MainError VerifyShouldRejectButMatched Int32
errorCase MainError RandomBytesFailed Int32
errorCase MainError Base64EncodeFailed Int32
errorCase MainError ConsoleWriteFailed ConsoleWriteError

capability bcryptSmokeStdoutWrite console.stdout write
purpose operation bcryptSmokeStdoutWrite "Authority to write the smoke marker to stdout"
capability bcryptSmokeHeapAlloc heap allocate
purpose operation bcryptSmokeHeapAlloc "Authority to allocate the hash + token + random scratch buffers"
capability bcryptSmokeHeapFree heap free
purpose operation bcryptSmokeHeapFree "Authority to free the same buffers at defer time"

storage module immutable successExit ExitCode 0
storage module immutable matchedSentinel Int32 1
storage module immutable mismatchedSentinel Int32 0

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
effect main allocate heap
effect main free heap
memory main heap auto
async main no
useCapability main bcryptSmokeStdoutWrite
useCapability main bcryptSmokeHeapAlloc
useCapability main bcryptSmokeHeapFree
purpose operation main "Round-trip a password through bcrypt.hashPassword + bcrypt.verifyPassword at cost 12, then generate a 32-byte CSPRNG sample and base64url-encode it to a 43-char session token. Every step's status is asserted with a typed failure label so the harness can attribute a regression to a specific phase."
invariant operation main "All three c.malloc allocations are paired with defer c.free; even the failure labels propagate through the deferred cleanup before returnError fires."

label startMain

# Allocate the 61-byte hash output buffer.
storage local immutable hashBufferCapacity Int64 61
call allocateHashBufferCall c.malloc
argument allocateHashBufferCall size Int64 hashBufferCapacity
run allocateHashBufferCall
bind value hashBuffer OpaquePointer allocateHashBufferCall
defer releaseHashBufferDefer c.free hashBuffer

# Hash the password at cost 12.
storage local immutable smokePlaintext String "correct-horse-battery-staple"
storage local immutable hashCapacityArg Int32 61
call hashPasswordCall bcrypt.hashPassword
argument hashPasswordCall plaintext String smokePlaintext
argument hashPasswordCall cost Int32 bcryptRecommendedCost
argument hashPasswordCall outBuffer OpaquePointer hashBuffer
argument hashPasswordCall outCapacity Int32 hashCapacityArg
run hashPasswordCall
bind value hashStatus Int32 hashPasswordCall

call hashStatusOkCheckCall math.equalInt32
argument hashStatusOkCheckCall left Int32 hashStatus
argument hashStatusOkCheckCall right Int32 successExit
run hashStatusOkCheckCall
bind value hashStatusOk Bool hashStatusOkCheckCall
branch if condition hashStatusOk target hashStatusOkLabel
branch else target hashShouldHaveSucceededFailed
label hashStatusOkLabel

# Verify correct plaintext — must return SS_BCRYPT_MATCH (1).
call verifyCorrectCall bcrypt.verifyPassword
argument verifyCorrectCall plaintext String smokePlaintext
argument verifyCorrectCall expectedHash OpaquePointer hashBuffer
run verifyCorrectCall
bind value verifyCorrectResult Int32 verifyCorrectCall

call verifyCorrectMatchCheckCall math.equalInt32
argument verifyCorrectMatchCheckCall left Int32 verifyCorrectResult
argument verifyCorrectMatchCheckCall right Int32 matchedSentinel
run verifyCorrectMatchCheckCall
bind value verifyCorrectMatched Bool verifyCorrectMatchCheckCall
branch if condition verifyCorrectMatched target verifyCorrectMatchedLabel
branch else target verifyShouldHaveMatchedFailed
label verifyCorrectMatchedLabel

# Verify WRONG plaintext — must return SS_BCRYPT_MISMATCH (0).
storage local immutable wrongPlaintext String "definitely-not-the-password"
call verifyWrongCall bcrypt.verifyPassword
argument verifyWrongCall plaintext String wrongPlaintext
argument verifyWrongCall expectedHash OpaquePointer hashBuffer
run verifyWrongCall
bind value verifyWrongResult Int32 verifyWrongCall

call verifyWrongRejectCheckCall math.equalInt32
argument verifyWrongRejectCheckCall left Int32 verifyWrongResult
argument verifyWrongRejectCheckCall right Int32 mismatchedSentinel
run verifyWrongRejectCheckCall
bind value verifyWrongRejected Bool verifyWrongRejectCheckCall
branch if condition verifyWrongRejected target verifyWrongRejectedLabel
branch else target verifyShouldHaveRejectedFailed
label verifyWrongRejectedLabel

# Generate a 32-byte random sample.
storage local immutable randomBufferCapacity Int64 32
call allocateRandomBufferCall c.malloc
argument allocateRandomBufferCall size Int64 randomBufferCapacity
run allocateRandomBufferCall
bind value randomBuffer OpaquePointer allocateRandomBufferCall
defer releaseRandomBufferDefer c.free randomBuffer

storage local immutable randomByteCount Int32 32
call randomBytesCall bcrypt.randomBytes
argument randomBytesCall outBuffer OpaquePointer randomBuffer
argument randomBytesCall byteCount Int32 randomByteCount
run randomBytesCall
bind value randomStatus Int32 randomBytesCall

call randomStatusOkCheckCall math.equalInt32
argument randomStatusOkCheckCall left Int32 randomStatus
argument randomStatusOkCheckCall right Int32 successExit
run randomStatusOkCheckCall
bind value randomStatusOk Bool randomStatusOkCheckCall
branch if condition randomStatusOk target randomStatusOkLabel
branch else target randomBytesShouldHaveSucceededFailed
label randomStatusOkLabel

# Base64url-encode into a 44-byte buffer; expect 43 written + NUL.
storage local immutable tokenBufferCapacity Int64 44
call allocateTokenBufferCall c.malloc
argument allocateTokenBufferCall size Int64 tokenBufferCapacity
run allocateTokenBufferCall
bind value tokenBuffer OpaquePointer allocateTokenBufferCall
defer releaseTokenBufferDefer c.free tokenBuffer

# The length-out pointer needs to be a real i32 alloca.
memory main mutable encodedLength Int32 0
storage local immutable tokenCapacityArg Int32 44
call encodeTokenCall bcrypt.base64UrlEncode
argument encodeTokenCall inputBuffer OpaquePointer randomBuffer
argument encodeTokenCall inputCount Int32 randomByteCount
argument encodeTokenCall outputBuffer OpaquePointer tokenBuffer
argument encodeTokenCall outputCapacity Int32 tokenCapacityArg
argument encodeTokenCall outputLengthOut Int32 encodedLength
run encodeTokenCall
bind value encodeStatus Int32 encodeTokenCall

call encodeStatusOkCheckCall math.equalInt32
argument encodeStatusOkCheckCall left Int32 encodeStatus
argument encodeStatusOkCheckCall right Int32 successExit
run encodeStatusOkCheckCall
bind value encodeStatusOk Bool encodeStatusOkCheckCall
branch if condition encodeStatusOk target encodeStatusOkLabel
branch else target base64EncodeShouldHaveSucceededFailed
label encodeStatusOkLabel

# Success — emit the marker.
storage local immutable successMarker String "bcryptRuntimeSmokeOk"
call writeMarkerCall console.writeLine
argument writeMarkerCall console Console console
argument writeMarkerCall text String successMarker
run writeMarkerCall
ignore void source writeMarkerCall
bind error consoleWriteError ConsoleWriteError writeMarkerCall
branch error source writeMarkerCall target consoleSmokeWriteFailed

return ok successExit

label hashShouldHaveSucceededFailed
makeError hashFailedFailure MainError.HashFailed hashStatus
return error hashFailedFailure

label verifyShouldHaveMatchedFailed
makeError verifyShouldMatchFailure MainError.VerifyShouldMatchButDidNot verifyCorrectResult
return error verifyShouldMatchFailure

label verifyShouldHaveRejectedFailed
makeError verifyShouldRejectFailure MainError.VerifyShouldRejectButMatched verifyWrongResult
return error verifyShouldRejectFailure

label randomBytesShouldHaveSucceededFailed
makeError randomBytesFailedFailure MainError.RandomBytesFailed randomStatus
return error randomBytesFailedFailure

label base64EncodeShouldHaveSucceededFailed
makeError base64EncodeFailedFailure MainError.Base64EncodeFailed encodeStatus
return error base64EncodeFailedFailure

label consoleSmokeWriteFailed
makeError consoleWriteFailure MainError.ConsoleWriteFailed consoleWriteError
return error consoleWriteFailure
