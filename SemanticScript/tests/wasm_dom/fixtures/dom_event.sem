project DomEvent
target console
runtime native 1
module examples.domEvent

import document standard.document
dependency standard.document version 0.1 source standard

entry console main

capability mainDomReader document.dom read
purpose operation mainDomReader "Authority to read the DOM in the event fixture."
capability mainDomWriter document.dom write
purpose operation mainDomWriter "Authority to mutate the DOM in the event fixture."
capability mainEventReader document.event read
purpose operation mainEventReader "Authority to subscribe to and receive DOM events."
capability mainEventController document.event close
purpose operation mainEventController "Authority to remove DOM event subscriptions."

operation main
output operation main ExitCode
effect main read document.dom
effect main write document.dom
effect main read document.event
effect main close document.event
memory main heap no
async main no
useCapability main mainDomReader
useCapability main mainDomWriter
useCapability main mainEventReader
useCapability main mainEventController
purpose operation main "Subscribe to a click on #btn, suspend on nextEvent via Asyncify until it fires, then mark document.body as clicked and detach the listener."
invariant operation main "The body text changes only after a real click is delivered: nextEvent suspends the wasm stack until the adapter resolves it, so a no-op await could not produce the clicked marker."

label startMain

storage local immutable buttonId DomElementId "btn"
call findButtonCall document.getElementById
argument findButtonCall elementId DomElementId buttonId
run findButtonCall
bind value buttonHandle DomHandle findButtonCall

storage local immutable clickEventName DomEventName "click"
call listenCall document.addEventListener
argument listenCall node DomHandle buttonHandle
argument listenCall eventName DomEventName clickEventName
run listenCall
bind value clickStream DomEventStreamHandle listenCall

call awaitClickCall document.nextEvent
argument awaitClickCall stream DomEventStreamHandle clickStream
run awaitClickCall
ignore value source awaitClickCall type DomStatus

call bodyCall document.bodyElement
run bodyCall
bind value bodyHandle DomHandle bodyCall

storage local immutable clickedText DomText "clicked"
call markCall document.setTextContent
argument markCall node DomHandle bodyHandle
argument markCall text DomText clickedText
run markCall
ignore value source markCall type DomStatus

call unlistenCall document.removeEventListener
argument unlistenCall stream DomEventStreamHandle clickStream
run unlistenCall
ignore value source unlistenCall type DomStatus

storage local immutable okExit ExitCode 0
return value okExit
