# Smoke fixture: prove ss_http_request_path_param round-trips a `:slug`
# segment from the route pattern out to a response body. Compiled and
# executed by SemanticScript/tests/test_compiler.py via the new
# test_path_param_smoke regression. The matched value gets echoed back
# so the harness can diff against the URL it sent.
project PathParamSmoke
target webServer
runtime native 1
module fixture.path_param_smoke

webServer pathParamSmokeServer
purpose operation pathParamSmokeServer "Smallest possible webServer that exercises a :name path segment so the compiled-route matcher is covered end-to-end"
serverHost pathParamSmokeServer "127.0.0.1"
serverPort pathParamSmokeServer 18099
route pathParamSmokeServer GET "/echo/:slug" echoSlugHandler

capability httpRequestReader http.request read
purpose operation httpRequestReader "Authority to read the matched :slug capture"
capability httpResponseWriter http.response write
purpose operation httpResponseWriter "Authority to write the echo response"

storage module immutable okStatus Int32 200
storage module immutable badRequestStatus Int32 400

operation echoSlugHandler
input operation echoSlugHandler request HttpRequest
input operation echoSlugHandler response HttpResponse
output operation echoSlugHandler Int32
effect echoSlugHandler read http.request.path
effect echoSlugHandler write http.response
memory echoSlugHandler arena request
async echoSlugHandler no
useCapability echoSlugHandler httpRequestReader
useCapability echoSlugHandler httpResponseWriter
purpose operation echoSlugHandler "Read the :slug path parameter and write it back as the response body; covers the happy path of the path-param matcher and the SS3603 null guard for the absent-param branch"
invariant operation echoSlugHandler "The dispatcher only routes /echo/<value> to this handler, so a non-null :slug capture is the success path; the null guard exists to satisfy SS3603 and to surface a runtime-routing regression rather than 500-ing under a no-op match"

label startEchoSlugHandler

storage local immutable slugParamName String "slug"
storage local immutable slugMissingBody String "missing path param: slug\n"

call slugReadCall http.requestPathParam
argument slugReadCall request HttpRequest request
argument slugReadCall name String slugParamName
run slugReadCall
bind value slugValue String slugReadCall

call slugMissingCheckCall pointer.isNull
argument slugMissingCheckCall pointer String slugValue
run slugMissingCheckCall
bind value slugMissing Bool slugMissingCheckCall
branch if condition slugMissing target slugMissingPath

call slugResponseCall http.responseText
argument slugResponseCall response HttpResponse response
argument slugResponseCall status Int32 okStatus
argument slugResponseCall body String slugValue
run slugResponseCall
bind value slugResponseStatus Int32 slugResponseCall
return value slugResponseStatus

label slugMissingPath
call slugMissingResponseCall http.responseText
argument slugMissingResponseCall response HttpResponse response
argument slugMissingResponseCall status Int32 badRequestStatus
argument slugMissingResponseCall body String slugMissingBody
run slugMissingResponseCall
bind value slugMissingResponseStatus Int32 slugMissingResponseCall
return value slugMissingResponseStatus
