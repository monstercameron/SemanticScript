# Adversarial JSON smoke for the document CRUD surface.
#
# Covers negative integers, a large positive integer, empty string values, and
# serialization through the mutable document runtime.

project JsonAdversarial
target console
runtime native 1
module fixture.json_adversarial

import json standard.json
dependency standard.json version 0.1 source standard

entry console main

error MainError
errorCase MainError JsonAccessFailed JsonAccessError
errorCase MainError RoundTripMismatch Int32
errorCase MainError ConsoleWriteFailed ConsoleWriteError

capability adversarialStdoutWrite console.stdout write
purpose operation adversarialStdoutWrite "Authority to write the adversarial smoke result marker"
capability adversarialHeapAllocate heap allocate
purpose operation adversarialHeapAllocate "Authority to allocate JSON scratch storage"
capability adversarialHeapFree heap free
purpose operation adversarialHeapFree "Authority to free JSON scratch storage"

storage module immutable documentCapacity JsonCapacityBytes 4096
storage module immutable scratchCapacity JsonCapacityBytes 512
storage module immutable objectRootKind Int32 0
storage module immutable successExit ExitCode 0
storage module immutable expectedNegative Int64 -98765
storage module immutable expectedLarge Int64 9223372036854775000
storage module immutable missingDefault Int64 0
storage module immutable mismatchCode Int32 1

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
effect main allocate heap
effect main free heap
effect main read json.document.tree
effect main write json.document.tree
memory main heap auto
async main no
useCapability main adversarialStdoutWrite
useCapability main adversarialHeapAllocate
useCapability main adversarialHeapFree
purpose operation main "Build a document with extreme integer and empty-string cases, then verify the values through cursor readers."
invariant operation main "Negative and near-INT64_MAX values must round-trip exactly via the int64 cursor path."

label startMain

call createDocumentCall json.createEmptyDocument
argument createDocumentCall capacityBytes JsonCapacityBytes documentCapacity
argument createDocumentCall rootKind Int32 objectRootKind
run createDocumentCall
bind ok adversarialDocument JsonDocument createDocumentCall
bind error createDocumentError JsonAccessError createDocumentCall
branch error source createDocumentCall target jsonAccessFailed

call rootCursorCall json.documentRoot
argument rootCursorCall document JsonDocument adversarialDocument
run rootCursorCall
bind value rootCursor JsonCursor rootCursorCall

storage local immutable negFieldName String "negative"
call writeNegCall json.setObjectFieldInt64
argument writeNegCall document JsonDocument adversarialDocument
argument writeNegCall cursor JsonCursor rootCursor
argument writeNegCall fieldName String negFieldName
argument writeNegCall value Int64 expectedNegative
run writeNegCall
ignore ok source writeNegCall type Int32
bind error negWriteError JsonAccessError writeNegCall
branch error source writeNegCall target jsonAccessFailed

storage local immutable bigFieldName String "big"
call writeBigCall json.setObjectFieldInt64
argument writeBigCall document JsonDocument adversarialDocument
argument writeBigCall cursor JsonCursor rootCursor
argument writeBigCall fieldName String bigFieldName
argument writeBigCall value Int64 expectedLarge
run writeBigCall
ignore ok source writeBigCall type Int32
bind error bigWriteError JsonAccessError writeBigCall
branch error source writeBigCall target jsonAccessFailed

storage local immutable emptyFieldName String "empty"
storage local immutable emptyValue String ""
call writeEmptyCall json.setObjectFieldString
argument writeEmptyCall document JsonDocument adversarialDocument
argument writeEmptyCall cursor JsonCursor rootCursor
argument writeEmptyCall fieldName String emptyFieldName
argument writeEmptyCall value String emptyValue
run writeEmptyCall
ignore ok source writeEmptyCall type Int32
bind error emptyWriteError JsonAccessError writeEmptyCall
branch error source writeEmptyCall target jsonAccessFailed

call negCursorCall json.objectFieldAt
argument negCursorCall document JsonDocument adversarialDocument
argument negCursorCall cursor JsonCursor rootCursor
argument negCursorCall fieldName String negFieldName
run negCursorCall
bind ok negCursor JsonCursor negCursorCall
bind error negCursorError JsonAccessError negCursorCall
branch error source negCursorCall target jsonAccessFailed

call readNegCall json.cursorInt64
argument readNegCall document JsonDocument adversarialDocument
argument readNegCall cursor JsonCursor negCursor
argument readNegCall missingDefault Int64 missingDefault
run readNegCall
bind value recoveredNegative Int64 readNegCall

call negMatchCall math.equalInt64
argument negMatchCall left Int64 recoveredNegative
argument negMatchCall right Int64 expectedNegative
run negMatchCall
bind value negMatched Bool negMatchCall
branch if condition negMatched target negMatchOk
branch else target roundTripMismatch
label negMatchOk

call bigCursorCall json.objectFieldAt
argument bigCursorCall document JsonDocument adversarialDocument
argument bigCursorCall cursor JsonCursor rootCursor
argument bigCursorCall fieldName String bigFieldName
run bigCursorCall
bind ok bigCursor JsonCursor bigCursorCall
bind error bigCursorError JsonAccessError bigCursorCall
branch error source bigCursorCall target jsonAccessFailed

call readBigCall json.cursorInt64
argument readBigCall document JsonDocument adversarialDocument
argument readBigCall cursor JsonCursor bigCursor
argument readBigCall missingDefault Int64 missingDefault
run readBigCall
bind value recoveredBig Int64 readBigCall

call bigMatchCall math.equalInt64
argument bigMatchCall left Int64 recoveredBig
argument bigMatchCall right Int64 expectedLarge
run bigMatchCall
bind value bigMatched Bool bigMatchCall
branch if condition bigMatched target bigMatchOk
branch else target roundTripMismatch
label bigMatchOk

call allocateScratchCall c.malloc
argument allocateScratchCall size JsonCapacityBytes scratchCapacity
run allocateScratchCall
bind value scratchBuffer OpaquePointer allocateScratchCall

call emptyCursorCall json.objectFieldAt
argument emptyCursorCall document JsonDocument adversarialDocument
argument emptyCursorCall cursor JsonCursor rootCursor
argument emptyCursorCall fieldName String emptyFieldName
run emptyCursorCall
bind ok emptyCursor JsonCursor emptyCursorCall
bind error emptyCursorError JsonAccessError emptyCursorCall
branch error source emptyCursorCall target jsonAccessFailed

call readEmptyCall json.cursorString
argument readEmptyCall document JsonDocument adversarialDocument
argument readEmptyCall cursor JsonCursor emptyCursor
argument readEmptyCall scratch OpaquePointer scratchBuffer
argument readEmptyCall scratchCapacity JsonCapacityBytes scratchCapacity
run readEmptyCall
bind ok recoveredEmpty String readEmptyCall
bind error readEmptyError JsonAccessError readEmptyCall
branch error source readEmptyCall target jsonAccessFailed

call emptyNullCheckCall pointer.isNull
argument emptyNullCheckCall pointer String recoveredEmpty
run emptyNullCheckCall
bind value emptyIsNull Bool emptyNullCheckCall
branch if condition emptyIsNull target roundTripMismatch

call serializeDocumentCall json.serializeDocument
argument serializeDocumentCall document JsonDocument adversarialDocument
argument serializeDocumentCall scratch OpaquePointer scratchBuffer
argument serializeDocumentCall scratchCapacity JsonCapacityBytes scratchCapacity
run serializeDocumentCall
bind ok serializedDocument JsonText serializeDocumentCall
bind error serializeDocumentError JsonAccessError serializeDocumentCall
branch error source serializeDocumentCall target jsonAccessFailed

storage local immutable successMarker String "jsonAdversarialOk"
call writeMarkerCall console.writeLine
argument writeMarkerCall console Console console
argument writeMarkerCall text String successMarker
run writeMarkerCall
ignore void source writeMarkerCall
bind error consoleWriteError ConsoleWriteError writeMarkerCall
branch error source writeMarkerCall target consoleWriteFailed

call releaseScratchCall c.free
argument releaseScratchCall ptr OpaquePointer scratchBuffer
run releaseScratchCall

call destroyDocumentCall json.destroyDocument
argument destroyDocumentCall document JsonDocument adversarialDocument
run destroyDocumentCall
ignore ok source destroyDocumentCall type Int32

return ok successExit

label jsonAccessFailed
makeError jsonAccessFailure MainError.JsonAccessFailed createDocumentError
return error jsonAccessFailure

label roundTripMismatch
makeError roundTripFailure MainError.RoundTripMismatch mismatchCode
return error roundTripFailure

label consoleWriteFailed
makeError consoleWriteFailure MainError.ConsoleWriteFailed consoleWriteError
return error consoleWriteFailure
