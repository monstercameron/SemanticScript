# Adversarial JSON smoke for the document CRUD surface.
#
# Covers negative integers, a large positive integer, empty string values, and
# serialization through the mutable document runtime.

project JsonAdversarial
target console
runtime native 1
module fixture.json_adversarial

importModule standard.json as json
dependency standard.json version 0.1 source standard

entry console main

error MainError
errorCase MainError JsonAccessFailed JsonAccessError
errorCase MainError RoundTripMismatch CSignedInt32
errorCase MainError ConsoleWriteFailed ConsoleWriteError

capability adversarialStdoutWrite console.stdout write
purpose adversarialStdoutWrite "Authority to write the adversarial smoke result marker"
capability adversarialHeapAllocate heap allocate
purpose adversarialHeapAllocate "Authority to allocate JSON scratch storage"
capability adversarialHeapFree heap free
purpose adversarialHeapFree "Authority to free JSON scratch storage"

storage module immutable documentCapacity JsonCapacityBytes 4096
storage module immutable scratchCapacity JsonCapacityBytes 512
storage module immutable objectRootKind CSignedInt32 0
storage module immutable successExit ExitCode 0
storage module immutable expectedNegative CSignedInt64 -98765
storage module immutable expectedLarge CSignedInt64 9223372036854775000
storage module immutable missingDefault CSignedInt64 0
storage module immutable mismatchCode CSignedInt32 1

operation main
input main console Console
output main Result ExitCode MainError
effect main write console.stdout
effect main allocate heap
effect main free heap
effect main read json.document.tree
effect main write json.document.tree
memory main heap auto
async main no
useCapability main adversarialStdoutWrite
useCapability main adversarialHeapAllocate
useCapability main adversarialHeapFree
purpose main "Build a document with extreme integer and empty-string cases, then verify the values through cursor readers."
invariant main "Negative and near-INT64_MAX values must round-trip exactly via the int64 cursor path."

label startMain

call createDocumentCall json.createEmptyDocument
arg createDocumentCall capacityBytes documentCapacity
arg createDocumentCall rootKind objectRootKind
run createDocumentCall
bindOk adversarialDocument JsonDocument createDocumentCall
bindError createDocumentError JsonAccessError createDocumentCall
branchIfError createDocumentCall jsonAccessFailed

call rootCursorCall json.documentRoot
arg rootCursorCall document adversarialDocument
run rootCursorCall
bind rootCursor JsonCursor rootCursorCall

storage local immutable negFieldName CNullTerminatedByteString "negative"
call writeNegCall json.setObjectFieldInt64
arg writeNegCall document adversarialDocument
arg writeNegCall cursor rootCursor
arg writeNegCall fieldName negFieldName
arg writeNegCall value expectedNegative
run writeNegCall
ignoreOk writeNegCall CSignedInt32
bindError negWriteError JsonAccessError writeNegCall
branchIfError writeNegCall jsonAccessFailed

storage local immutable bigFieldName CNullTerminatedByteString "big"
call writeBigCall json.setObjectFieldInt64
arg writeBigCall document adversarialDocument
arg writeBigCall cursor rootCursor
arg writeBigCall fieldName bigFieldName
arg writeBigCall value expectedLarge
run writeBigCall
ignoreOk writeBigCall CSignedInt32
bindError bigWriteError JsonAccessError writeBigCall
branchIfError writeBigCall jsonAccessFailed

storage local immutable emptyFieldName CNullTerminatedByteString "empty"
storage local immutable emptyValue CNullTerminatedByteString ""
call writeEmptyCall json.setObjectFieldString
arg writeEmptyCall document adversarialDocument
arg writeEmptyCall cursor rootCursor
arg writeEmptyCall fieldName emptyFieldName
arg writeEmptyCall value emptyValue
run writeEmptyCall
ignoreOk writeEmptyCall CSignedInt32
bindError emptyWriteError JsonAccessError writeEmptyCall
branchIfError writeEmptyCall jsonAccessFailed

call negCursorCall json.objectFieldAt
arg negCursorCall document adversarialDocument
arg negCursorCall cursor rootCursor
arg negCursorCall fieldName negFieldName
run negCursorCall
bindOk negCursor JsonCursor negCursorCall
bindError negCursorError JsonAccessError negCursorCall
branchIfError negCursorCall jsonAccessFailed

call readNegCall json.cursorInt64
arg readNegCall document adversarialDocument
arg readNegCall cursor negCursor
arg readNegCall missingDefault missingDefault
run readNegCall
bind recoveredNegative CSignedInt64 readNegCall

call negMatchCall math.equalI64
arg negMatchCall left recoveredNegative
arg negMatchCall right expectedNegative
run negMatchCall
bind negMatched Bool negMatchCall
branchIf negMatched negMatchOk
branch roundTripMismatch
label negMatchOk

call bigCursorCall json.objectFieldAt
arg bigCursorCall document adversarialDocument
arg bigCursorCall cursor rootCursor
arg bigCursorCall fieldName bigFieldName
run bigCursorCall
bindOk bigCursor JsonCursor bigCursorCall
bindError bigCursorError JsonAccessError bigCursorCall
branchIfError bigCursorCall jsonAccessFailed

call readBigCall json.cursorInt64
arg readBigCall document adversarialDocument
arg readBigCall cursor bigCursor
arg readBigCall missingDefault missingDefault
run readBigCall
bind recoveredBig CSignedInt64 readBigCall

call bigMatchCall math.equalI64
arg bigMatchCall left recoveredBig
arg bigMatchCall right expectedLarge
run bigMatchCall
bind bigMatched Bool bigMatchCall
branchIf bigMatched bigMatchOk
branch roundTripMismatch
label bigMatchOk

call allocateScratchCall c.malloc
arg allocateScratchCall size scratchCapacity
run allocateScratchCall
bind scratchBuffer COpaqueMemoryAddress allocateScratchCall

call emptyCursorCall json.objectFieldAt
arg emptyCursorCall document adversarialDocument
arg emptyCursorCall cursor rootCursor
arg emptyCursorCall fieldName emptyFieldName
run emptyCursorCall
bindOk emptyCursor JsonCursor emptyCursorCall
bindError emptyCursorError JsonAccessError emptyCursorCall
branchIfError emptyCursorCall jsonAccessFailed

call readEmptyCall json.cursorString
arg readEmptyCall document adversarialDocument
arg readEmptyCall cursor emptyCursor
arg readEmptyCall scratch scratchBuffer
arg readEmptyCall scratchCapacity scratchCapacity
run readEmptyCall
bindOk recoveredEmpty CNullTerminatedByteString readEmptyCall
bindError readEmptyError JsonAccessError readEmptyCall
branchIfError readEmptyCall jsonAccessFailed

call emptyNullCheckCall pointer.isNull
arg emptyNullCheckCall pointer recoveredEmpty
run emptyNullCheckCall
bind emptyIsNull Bool emptyNullCheckCall
branchIf emptyIsNull roundTripMismatch

call serializeDocumentCall json.serializeDocument
arg serializeDocumentCall document adversarialDocument
arg serializeDocumentCall scratch scratchBuffer
arg serializeDocumentCall scratchCapacity scratchCapacity
run serializeDocumentCall
bindOk serializedDocument JsonText serializeDocumentCall
bindError serializeDocumentError JsonAccessError serializeDocumentCall
branchIfError serializeDocumentCall jsonAccessFailed

storage local immutable successMarker CNullTerminatedByteString "jsonAdversarialOk"
call writeMarkerCall console.writeLine
arg writeMarkerCall console console
arg writeMarkerCall text successMarker
run writeMarkerCall
ignoreOk writeMarkerCall Void
bindError consoleWriteError ConsoleWriteError writeMarkerCall
branchIfError writeMarkerCall consoleWriteFailed

call releaseScratchCall c.free
arg releaseScratchCall ptr scratchBuffer
run releaseScratchCall

call destroyDocumentCall json.destroyDocument
arg destroyDocumentCall document adversarialDocument
run destroyDocumentCall
ignoreOk destroyDocumentCall CSignedInt32

returnOk successExit

label jsonAccessFailed
makeError jsonAccessFailure MainError.JsonAccessFailed createDocumentError
returnError jsonAccessFailure

label roundTripMismatch
makeError roundTripFailure MainError.RoundTripMismatch mismatchCode
returnError roundTripFailure

label consoleWriteFailed
makeError consoleWriteFailure MainError.ConsoleWriteFailed consoleWriteError
returnError consoleWriteFailure
