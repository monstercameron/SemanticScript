# sum_of_squares_refined.sscript
#
# Migration of sem/sum_of_squares.sscript to refined syntax. Same behavior —
# compute 1² + 2² + … + 10² = 385 and print as a single line.

section program.sumOfSquaresRefined

project SumOfSquaresRefined
target console
runtime AgentRuntime 0.1
entry console main

section program.sumOfSquaresRefined.types

type SumOfSquaresCounter Int64
type SumOfSquaresAccumulator Int64
type PositiveSumOfSquaresStep Int64

section program.sumOfSquaresRefined.errors

error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

section program.sumOfSquaresRefined.literals

domainLiteral sumOfSquaresLowerLimit SumOfSquaresCounter 1
domainLiteral sumOfSquaresUpperLimit SumOfSquaresCounter 10
storage module immutable sumOfSquaresStepValue PositiveSumOfSquaresStep 1
domainLiteral sumOfSquaresAccumulatorInitial SumOfSquaresAccumulator 0
storage module immutable successfulExitCode ExitCode 0

section program.sumOfSquaresRefined.operations

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
memoryStackLimit main 16KiB
async main no
operationBody main sourceTape

purpose operation main "Compute 1² + 2² + … + sumOfSquaresUpperLimit² and print the result as a single line"
invariant operation main "currentSumOfSquaresAccumulator equals the sum of squares from one through currentSumOfSquaresCounter minus one"
invariant operation main "sumOfSquaresStepValue is strictly greater than zero"

label startMain

memory main mutable currentSumOfSquaresCounter SumOfSquaresCounter sumOfSquaresLowerLimit
memory main mutable currentSumOfSquaresAccumulator SumOfSquaresAccumulator sumOfSquaresAccumulatorInitial

label sumOfSquaresLoopHead

# rationale: Continue while currentSumOfSquaresCounter is less than or equal to sumOfSquaresUpperLimit.
call sumOfSquaresRangeCheckCall SumOfSquaresCounter.lessThanOrEqual
argument sumOfSquaresRangeCheckCall left SumOfSquaresCounter currentSumOfSquaresCounter
argument sumOfSquaresRangeCheckCall right SumOfSquaresCounter sumOfSquaresUpperLimit
run sumOfSquaresRangeCheckCall
bind value sumOfSquaresShouldContinue Bool sumOfSquaresRangeCheckCall

branch if condition sumOfSquaresShouldContinue target sumOfSquaresLoopBody
branch else target sumOfSquaresFinished

label sumOfSquaresLoopBody

# rationale: Square the current counter.
call currentCounterSquareCall SumOfSquaresCounter.square
argument currentCounterSquareCall counter SumOfSquaresCounter currentSumOfSquaresCounter
run currentCounterSquareCall
bind value currentCounterSquareValue SumOfSquaresAccumulator currentCounterSquareCall

# rationale: Add the freshly computed square into the running accumulator.
call sumOfSquaresAccumulatorAddCall SumOfSquaresAccumulator.add
argument sumOfSquaresAccumulatorAddCall accumulator SumOfSquaresAccumulator currentSumOfSquaresAccumulator
argument sumOfSquaresAccumulatorAddCall summand SumOfSquaresAccumulator currentCounterSquareValue
run sumOfSquaresAccumulatorAddCall
bind value nextSumOfSquaresAccumulator SumOfSquaresAccumulator sumOfSquaresAccumulatorAddCall
set memory currentSumOfSquaresAccumulator nextSumOfSquaresAccumulator

# rationale: Advance the counter by exactly sumOfSquaresStepValue.
call sumOfSquaresCounterIncrementCall SumOfSquaresCounter.add
argument sumOfSquaresCounterIncrementCall counter SumOfSquaresCounter currentSumOfSquaresCounter
argument sumOfSquaresCounterIncrementCall step PositiveSumOfSquaresStep sumOfSquaresStepValue
run sumOfSquaresCounterIncrementCall
bind value nextSumOfSquaresCounter SumOfSquaresCounter sumOfSquaresCounterIncrementCall
set memory currentSumOfSquaresCounter nextSumOfSquaresCounter

jump target sumOfSquaresLoopHead

label sumOfSquaresFinished

# rationale: Emit the final accumulator as a single line of standard output.
call writeFinalSumOfSquaresAccumulatorCall console.writeIntegerLine
argument writeFinalSumOfSquaresAccumulatorCall console Console console
argument writeFinalSumOfSquaresAccumulatorCall value SumOfSquaresAccumulator currentSumOfSquaresAccumulator
run writeFinalSumOfSquaresAccumulatorCall
ignore void source writeFinalSumOfSquaresAccumulatorCall
bind error writeFinalSumOfSquaresAccumulatorError ConsoleWriteError writeFinalSumOfSquaresAccumulatorCall
branch error source writeFinalSumOfSquaresAccumulatorCall target consoleWriteFailed

return ok successfulExitCode

label consoleWriteFailed
makeError consoleWriteFailure MainError.ConsoleWriteFailed writeFinalSumOfSquaresAccumulatorError
return error consoleWriteFailure
