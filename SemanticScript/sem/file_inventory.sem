storage local immutable fileInventoryFactorialText String "factorial.js               lines=  7 bytes=103"
storage local immutable fileInventoryFileInventoryText String "file-inventory.js          lines= 43 bytes=1302"
storage local immutable fileInventoryFizzBuzzText String "fizzbuzz.js                lines= 12 bytes=263"
storage local immutable fileInventoryHelloWorldText String "hello-world.js             lines=  7 bytes=142"
storage local immutable fileInventoryHelloText String "hello.js                   lines=  2 bytes=31"
storage local immutable fileInventoryInventoryManagerText String "inventory-manager.js       lines= 85 bytes=2355"
