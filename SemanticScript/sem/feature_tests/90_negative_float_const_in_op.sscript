# expect.stdout: -3.500000\n
# expect.exit: 0
project NegativeFloatConstInOp
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder CSignedInt32

operation flipSign
input operation flipSign value CFloat64
output operation flipSign Result CFloat64 Void
memory flipSign heap no
async flipSign no
purpose operation flipSign "Multiply a CFloat64 by -1.0. Exercises a negative float const passed as an arg in a user-op body."
invariant operation flipSign "Returns -value."
label startFlipSign
storage module immutable negativeOne CFloat64 -1.0
call multCall math.multiplyF64
argument multCall left CFloat64 value
argument multCall right CFloat64 negativeOne
run multCall
bind value flipped CFloat64 multCall
return ok flipped

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "flipSign(3.5) == -3.5. Exercises negative float const + float user op + writeFloatLine."
invariant operation main "Output is -3.500000."
label startMain
storage module immutable startValue CFloat64 3.5
call flipCall flipSign
argument flipCall value CFloat64 startValue
run flipCall
bind ok flippedValue CFloat64 flipCall
call writeCall console.writeFloatLine
argument writeCall console Console console
argument writeCall value CFloat64 flippedValue
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
