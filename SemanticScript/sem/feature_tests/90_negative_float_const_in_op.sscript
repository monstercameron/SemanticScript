# expect.stdout: -3.500000\n
# expect.exit: 0
project NegativeFloatConstInOp
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32

operation flipSign
input operation flipSign value Float64
output operation flipSign Result Float64 Void
memory flipSign heap no
async flipSign no
purpose operation flipSign "Multiply a Float64 by -1.0. Exercises a negative float const passed as an arg in a user-op body."
invariant operation flipSign "Returns -value."
label startFlipSign
storage module immutable negativeOne Float64 -1.0
call multCall math.multiplyFloat64
argument multCall left Float64 value
argument multCall right Float64 negativeOne
run multCall
bind value flipped Float64 multCall
return ok flipped

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "flipSign(3.5) == -3.5. Exercises negative float const + float user op + writeFloatLine."
invariant operation main "Output is -3.500000."
label startMain
storage module immutable startValue Float64 3.5
call flipCall flipSign
argument flipCall value Float64 startValue
run flipCall
bind ok flippedValue Float64 flipCall
call writeCall console.writeFloatLine
argument writeCall console Console console
argument writeCall value Float64 flippedValue
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
