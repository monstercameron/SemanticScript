# expect.stdout: sqliteRoundTripOk\n
# expect.exit: 0
# expect.xfail: standard.sqlite is wired into semsc.py but the bootstrap_general compiler does not yet know about the sqlite.* call targets, so this test is currently driven only by the semsc end-to-end test in SemanticScript/tests/test_compiler.py (`test_sqlite_syntax_sample_runs_end_to_end`). Promote out of xfail once bootstrap_general.sscript gets the same dispatch surface.
#
# Deep-audit smoke for standard.sqlite. Exercises open -> exec(CREATE) ->
# exec(INSERT literal) -> prepare(SELECT) -> step -> columnText round trip
# and writes the selected body to stdout. If the lowering for any sqlite.*
# call became a no-op, columnText would return an empty string and the
# stdout comparison would fail — satisfying the "must fail under no-op
# lowering" requirement that feature_tests 130-160 are built around.

project SqliteRoundTrip
target console
runtime AgentRuntime 0.1
module sqliteRoundTripModule
entry console main

importModule standard.sqlite as sqlite

dependency standard.sqlite version 0.1 source standard
dependencyEffect standard.sqlite readWrite database

error MainError
errorCase MainError DatabaseOpenFailed SqliteDatabaseOpenFailure
errorCase MainError DatabaseExecFailed SqliteDatabaseExecFailure
errorCase MainError StatementPrepareFailed SqliteStatementPrepareFailure
errorCase MainError StatementStepFailed SqliteStatementStepFailure
errorCase MainError ConsoleWriteFailed ConsoleWriteError

capability sqliteRoundTripDatabase database readWrite
purpose sqliteRoundTripDatabase "Authority to open the in-memory sqlite database and exec the round-trip cycle"

capability sqliteRoundTripStdout console.stdout write
purpose sqliteRoundTripStdout "Authority to print the round-trip outcome marker to stdout"

operation main
input main console Console
output main Result ExitCode MainError
effect main readWrite database
effect main write console.stdout
memory main heap auto
async main no
useCapability main sqliteRoundTripDatabase
useCapability main sqliteRoundTripStdout
purpose main "Open an in-memory sqlite database, INSERT a fixed marker via exec, SELECT it back, and write the result to stdout"
invariant main "stdout matches the column text iff every sqlite.* call lowered to a real ss_sqlite_* call"

label startMain

const databasePath CNullTerminatedByteString ":memory:"
const createTableSql CNullTerminatedByteString "CREATE TABLE markers (body TEXT NOT NULL)"
const insertMarkerSql CNullTerminatedByteString "INSERT INTO markers (body) VALUES ('sqliteRoundTripOk')"
const selectMarkerSql CNullTerminatedByteString "SELECT body FROM markers"
const firstColumnIndex CSignedInt32 0

call openCall sqlite.openDatabase
arg openCall path databasePath
arg openCall mode inMemorySqliteOpenMode
run openCall
bindOk roundTripDatabase SqliteDatabase openCall
bindError databaseOpenError SqliteDatabaseOpenFailure openCall
branchIfError openCall openFailed

defer databaseCloseDefer sqlite.closeDatabase roundTripDatabase

call createTableCall sqlite.exec
arg createTableCall database roundTripDatabase
arg createTableCall sql createTableSql
run createTableCall
ignoreOk createTableCall Void
bindError createTableError SqliteDatabaseExecFailure createTableCall
branchIfError createTableCall createTableFailed

call insertMarkerCall sqlite.exec
arg insertMarkerCall database roundTripDatabase
arg insertMarkerCall sql insertMarkerSql
run insertMarkerCall
ignoreOk insertMarkerCall Void
bindError insertMarkerError SqliteDatabaseExecFailure insertMarkerCall
branchIfError insertMarkerCall insertMarkerFailed

call prepareSelectCall sqlite.prepareStatement
arg prepareSelectCall database roundTripDatabase
arg prepareSelectCall sql selectMarkerSql
run prepareSelectCall
bindOk selectStatement SqliteStatement prepareSelectCall
bindError prepareSelectError SqliteStatementPrepareFailure prepareSelectCall
branchIfError prepareSelectCall prepareFailed

defer selectStatementFinalizeDefer sqlite.finalizeStatement selectStatement

call stepSelectCall sqlite.stepStatement
arg stepSelectCall statement selectStatement
run stepSelectCall
bindOk stepOutcome SqliteStepResult stepSelectCall
bindError stepSelectError SqliteStatementStepFailure stepSelectCall
branchIfError stepSelectCall stepFailed

call readMarkerCall sqlite.columnText
arg readMarkerCall statement selectStatement
arg readMarkerCall columnIndex firstColumnIndex
run readMarkerCall
bind selectedMarkerText CNullTerminatedByteString readMarkerCall

call writeMarkerCall console.writeLine
arg writeMarkerCall console console
arg writeMarkerCall text selectedMarkerText
run writeMarkerCall
ignoreOk writeMarkerCall Void
bindError consoleWriteError ConsoleWriteError writeMarkerCall
branchIfError writeMarkerCall consoleWriteFailed

const successExitCode ExitCode 0
returnOk successExitCode

label openFailed
makeError openFailedFailure MainError.DatabaseOpenFailed databaseOpenError
returnError openFailedFailure

label createTableFailed
makeError createTableFailedFailure MainError.DatabaseExecFailed createTableError
returnError createTableFailedFailure

label insertMarkerFailed
makeError insertMarkerFailedFailure MainError.DatabaseExecFailed insertMarkerError
returnError insertMarkerFailedFailure

label prepareFailed
makeError prepareFailedFailure MainError.StatementPrepareFailed prepareSelectError
returnError prepareFailedFailure

label stepFailed
makeError stepFailedFailure MainError.StatementStepFailed stepSelectError
returnError stepFailedFailure

label consoleWriteFailed
makeError consoleWriteFailure MainError.ConsoleWriteFailed consoleWriteError
returnError consoleWriteFailure
