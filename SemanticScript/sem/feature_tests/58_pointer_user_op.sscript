# expect.stdout: 5\n
# expect.exit: 0
project PointerUserOp
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder CSignedInt32

operation strlenOf
input operation strlenOf s CNullTerminatedByteString
output operation strlenOf Result CByteCount Void
effect strlenOf read memory.buffer
memory strlenOf heap no
async strlenOf no
purpose operation strlenOf "Return strlen(s) via libc."
invariant operation strlenOf "Passes pointer s through to c.strlen."
label startStrlenOf
call lenCall c.strlen
argument lenCall s CNullTerminatedByteString s
run lenCall
bind value lenValue CByteCount lenCall
return ok lenValue

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Call strlenOf('hello') = 5."
invariant operation main "Pointer-typed user-op call."
label startMain
storage module immutable greetingText CNullTerminatedByteString "hello"
call myStrlenCall strlenOf
argument myStrlenCall s CNullTerminatedByteString greetingText
run myStrlenCall
bind ok lenOutcome CByteCount myStrlenCall
memory main mutable resultVar I64 0
set memory resultVar lenOutcome
call writeCall console.writeIntegerLine
argument writeCall console Console console
argument writeCall value I64 resultVar
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
