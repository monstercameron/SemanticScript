# expect.stdout: 9\n
# expect.exit: 0
project UserOpThreeParamMixed
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32

operation indexCharInPair
input operation indexCharInPair leftBuffer String
input operation indexCharInPair rightBuffer String
input operation indexCharInPair preferRight Int64
output operation indexCharInPair Result Int64 Void
memory indexCharInPair heap no
async indexCharInPair no
purpose operation indexCharInPair "Take two strings and a selector. When selector is non-zero return the length of rightBuffer; otherwise the length of leftBuffer. Exercises mixed-type param signatures (i8*, i8*, i64) and pointer-typed arg2 emission at call sites."
invariant operation indexCharInPair "Calls c.strlen on the chosen buffer."
label startIndexCharInPair
storage module immutable zeroSelectorThreshold Int64 0
call selectorPositiveCall math.greaterThanInt64
argument selectorPositiveCall left Int64 preferRight
argument selectorPositiveCall right Int64 zeroSelectorThreshold
run selectorPositiveCall
bind value selectorPositive Bool selectorPositiveCall
branch if condition selectorPositive target measureRightBuffer
call leftLenCall c.strlen
argument leftLenCall s String leftBuffer
run leftLenCall
bind value leftLength ByteCount leftLenCall
return ok leftLength
label measureRightBuffer
call rightLenCall c.strlen
argument rightLenCall s String rightBuffer
run rightLenCall
bind value rightLength ByteCount rightLenCall
return ok rightLength

operation main
