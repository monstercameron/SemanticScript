# expect.stdout: 30\n
# expect.exit: 0
project MultiParamChained
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32

operation addAndDouble
input operation addAndDouble a Int64
input operation addAndDouble b Int64
output operation addAndDouble Result Int64 Void
memory addAndDouble heap no
async addAndDouble no
purpose operation addAndDouble "(a + b) * 2."
invariant operation addAndDouble "Compose add and multiply inline."
label startAddAndDouble
storage module immutable twoLit Int64 2
call addCall math.addInt64
argument addCall left Int64 a
argument addCall right Int64 b
run addCall
bind value sumValue Int64 addCall
call mulCall math.multiplyInt64
argument mulCall left Int64 sumValue
argument mulCall right Int64 twoLit
run mulCall
bind value doubledValue Int64 mulCall
return ok doubledValue

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Compute (5 + 10) * 2 = 30."
invariant operation main "Outputs 30."
label startMain
storage module immutable fiveInitial Int64 5
storage module immutable tenInitial Int64 10
memory main mutable leftValue Int64 fiveInitial
memory main mutable rightValue Int64 tenInitial
call computeCall addAndDouble
argument computeCall a Int64 leftValue
argument computeCall b Int64 rightValue
run computeCall
bind ok computeResult Int64 computeCall
memory main mutable outputVar Int64 fiveInitial
set memory outputVar computeResult
call writeCall console.writeIntegerLine
argument writeCall console Console console
argument writeCall value Int64 outputVar
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
