# expect.stdout: completedAfterInterval\n
# expect.exit: 0
project IntervalNoOpCompletes
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder CSignedInt32
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "interval + startInterval + awaitIntervalTick must not infinite-loop or crash under single-thread no-op lowering."
invariant operation main "Code after awaitIntervalTick runs and prints the completion message."
label startMain
interval heartbeatTicker maxRate 60
startInterval heartbeatTicker
awaitIntervalTick heartbeatTicker
awaitIntervalTick heartbeatTicker
storage module immutable completionMessage CNullTerminatedByteString "completedAfterInterval"
call writeCompletionCall console.writeLine
argument writeCompletionCall console Console console
argument writeCompletionCall text CNullTerminatedByteString completionMessage
run writeCompletionCall
ignore void source writeCompletionCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
