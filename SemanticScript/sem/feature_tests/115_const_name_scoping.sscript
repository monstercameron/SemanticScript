# expect.stdout: 7\n42\n
# expect.exit: 0
project ConstScoping
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder CSignedInt32

operation getSeven
output operation getSeven Result CSignedInt64 Void
label startGetSeven
storage module immutable answer CSignedInt64 7
return ok answer

operation getFortyTwo
output operation getFortyTwo Result CSignedInt64 Void
label startGetFortyTwo
storage module immutable answer CSignedInt64 42
return ok answer

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Two user ops each declare `const answer` with different values. Print both."
invariant operation main "Output: 7 then 42."
label startMain
call sevenCall getSeven
run sevenCall
bind ok sevenResult CSignedInt64 sevenCall
memory main mutable s1 I64 0
set memory s1 sevenResult
call w1 console.writeIntegerLine
argument w1 console Console console
argument w1 value I64 s1
run w1
ignore void source w1

call fortytwoCall getFortyTwo
run fortytwoCall
bind ok fortytwoResult CSignedInt64 fortytwoCall
memory main mutable s2 I64 0
set memory s2 fortytwoResult
call w2 console.writeIntegerLine
argument w2 console Console console
argument w2 value I64 s2
run w2
ignore void source w2

storage module immutable okExit ExitCode 0
return ok okExit
