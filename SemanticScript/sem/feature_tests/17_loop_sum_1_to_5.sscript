# expect.stdout: 15\n
# expect.exit: 0
project LoopSum1to5
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Accumulate sum 1+2+3+4+5 via var+add+branchIf loop."
invariant operation main "Result is 15."
label startMain
storage module immutable oneInitial I64 1
storage module immutable fiveBound I64 5
storage module immutable oneStep I64 1
storage module immutable zeroInitial I64 0
memory main mutable counter I64 oneInitial
memory main mutable accumulator I64 zeroInitial
label loopHead
call checkCall math.lessThanOrEqualI64
argument checkCall left I64 counter
argument checkCall right I64 fiveBound
run checkCall
bind value shouldContinue Bool checkCall
branch if condition shouldContinue target loopBody
branch else target loopExit
label loopBody
call addAccCall math.addI64
argument addAccCall left I64 accumulator
argument addAccCall right I64 counter
run addAccCall
bind value nextAccumulator I64 addAccCall
set memory accumulator nextAccumulator
call incCall math.addI64
argument incCall left I64 counter
argument incCall right I64 oneStep
run incCall
bind value nextCounter I64 incCall
set memory counter nextCounter
jump target loopHead
label loopExit
call writeCall console.writeIntegerLine
argument writeCall console Console console
argument writeCall value I64 accumulator
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
