# expect.stdout: cleanupOnError\n
# expect.exit: 1
project DeferRunOnFilter
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError DeliberateFailureForTest Int32
operation printCleanupOnOk
input operation printCleanupOnOk console Console
output operation printCleanupOnOk Int32
effect printCleanupOnOk write console.stdout
storage module immutable okCleanupMessage String "cleanupOnOk"
call writeOkCleanupCall console.writeLine
argument writeOkCleanupCall console Console console
argument writeOkCleanupCall text String okCleanupMessage
run writeOkCleanupCall
ignore void source writeOkCleanupCall
storage module immutable okCleanupExit Int32 0
return value okCleanupExit
operation printCleanupOnError
input operation printCleanupOnError console Console
output operation printCleanupOnError Int32
effect printCleanupOnError write console.stdout
storage module immutable errorCleanupMessage String "cleanupOnError"
call writeErrorCleanupCall console.writeLine
argument writeErrorCleanupCall console Console console
argument writeErrorCleanupCall text String errorCleanupMessage
run writeErrorCleanupCall
ignore void source writeErrorCleanupCall
storage module immutable errorCleanupExit Int32 0
return value errorCleanupExit
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "deferRunOn returnOk and returnError filter which exit path runs which defer."
invariant operation main "On returnError path: only deferOnErrorOnly fires; deferOnOkOnly is skipped. Output is exactly 'cleanupOnError' (one line)."
label startMain
defer deferOnOkOnly printCleanupOnOk console
deferRunOn deferOnOkOnly returnOk
defer deferOnErrorOnly printCleanupOnError console
deferRunOn deferOnErrorOnly returnError
makeError deliberateFailure MainError.DeliberateFailureForTest
return error deliberateFailure
