# expect.stdout: 55\n
# expect.exit: 0
project Fibonacci
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32

operation fibOf
input operation fibOf n Int64
output operation fibOf Result Int64 Void
memory fibOf heap no
async fibOf no
purpose operation fibOf "Naive recursive Fibonacci."
invariant operation fibOf "fib(0)=0, fib(1)=1, fib(n)=fib(n-1)+fib(n-2)."
label startFibOf
storage module immutable zeroLit Int64 0
storage module immutable oneLit Int64 1
storage module immutable twoLit Int64 2
call atBaseCall math.lessThanInt64
argument atBaseCall left Int64 n
argument atBaseCall right Int64 twoLit
run atBaseCall
bind value atBase Bool atBaseCall
branch if condition atBase target fibBase
branch else target fibRecurse
label fibBase
return ok n
label fibRecurse
call decOneCall math.subtractInt64
argument decOneCall left Int64 n
argument decOneCall right Int64 oneLit
run decOneCall
bind value nMinusOne Int64 decOneCall
call recAOneCall fibOf
argument recAOneCall n Int64 nMinusOne
run recAOneCall
bind ok fibAOne Int64 recAOneCall
call decTwoCall math.subtractInt64
argument decTwoCall left Int64 n
argument decTwoCall right Int64 twoLit
run decTwoCall
bind value nMinusTwo Int64 decTwoCall
call recBTwoCall fibOf
argument recBTwoCall n Int64 nMinusTwo
run recBTwoCall
bind ok fibBTwo Int64 recBTwoCall
call sumCall math.addInt64
argument sumCall left Int64 fibAOne
argument sumCall right Int64 fibBTwo
run sumCall
bind value fibTotal Int64 sumCall
return ok fibTotal

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Compute fib(10) = 55."
invariant operation main "Two recursive calls per frame."
label startMain
storage module immutable tenInitial Int64 10
memory main mutable input Int64 tenInitial
call fibCall fibOf
argument fibCall n Int64 input
run fibCall
bind ok fibResult Int64 fibCall
memory main mutable outputVar Int64 tenInitial
set memory outputVar fibResult
call writeCall console.writeIntegerLine
argument writeCall console Console console
argument writeCall value Int64 outputVar
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
