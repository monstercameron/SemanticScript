# expect.stdout: 16\n
# expect.exit: 0
project NestedUserOp
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32

operation square
input operation square x Int64
output operation square Result Int64 Void
memory square heap no
async square no
purpose operation square "Return x squared."
invariant operation square "x * x."
label startSquare
call mulCall math.multiplyInt64
argument mulCall left Int64 x
argument mulCall right Int64 x
run mulCall
bind value productValue Int64 mulCall
return ok productValue

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "square(square(2)) = 16."
invariant operation main "Nested op application."
label startMain
storage module immutable twoInitial Int64 2
memory main mutable x Int64 twoInitial
call innerCall square
argument innerCall x Int64 x
run innerCall
bind ok innerResult Int64 innerCall
call outerCall square
argument outerCall x Int64 innerResult
run outerCall
bind ok outerResult Int64 outerCall
memory main mutable outputVar Int64 twoInitial
set memory outputVar outerResult
call writeCall console.writeIntegerLine
argument writeCall console Console console
argument writeCall value Int64 outputVar
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
