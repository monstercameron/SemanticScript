# expect.stdout: 16\n
# expect.exit: 0
project NestedUserOp
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder CSignedInt32

operation square
input operation square x CSignedInt64
output operation square Result CSignedInt64 Void
memory square heap no
async square no
purpose operation square "Return x squared."
invariant operation square "x * x."
label startSquare
call mulCall math.multiplyI64
argument mulCall left CSignedInt64 x
argument mulCall right CSignedInt64 x
run mulCall
bind value productValue I64 mulCall
return ok productValue

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "square(square(2)) = 16."
invariant operation main "Nested op application."
label startMain
storage module immutable twoInitial I64 2
memory main mutable x I64 twoInitial
call innerCall square
argument innerCall x CSignedInt64 x
run innerCall
bind ok innerResult I64 innerCall
call outerCall square
argument outerCall x CSignedInt64 innerResult
run outerCall
bind ok outerResult I64 outerCall
memory main mutable outputVar I64 twoInitial
set memory outputVar outerResult
call writeCall console.writeIntegerLine
argument writeCall console Console console
argument writeCall value I64 outputVar
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
