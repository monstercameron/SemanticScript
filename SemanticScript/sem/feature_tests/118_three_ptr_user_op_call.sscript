# expect.stdout: ok\n
# expect.exit: 0
project ThreePtrParams
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32

operation pickFirstMatching
input operation pickFirstMatching needle String
input operation pickFirstMatching choice1 String
input operation pickFirstMatching choice2 String
output operation pickFirstMatching Result String Void
purpose operation pickFirstMatching "Return choice1 if needle==choice1 else choice2."
label startPick
call eqCall c.strcmp
argument eqCall left String needle
argument eqCall right String choice1
run eqCall
bind value cmp Int64 eqCall
storage module immutable zeroEq Int64 0
call isEqCall math.equalInt64
argument isEqCall left Int64 cmp
argument isEqCall right Int64 zeroEq
run isEqCall
bind value isEq Bool isEqCall
branch if condition isEq target returnChoice1
return ok choice2
label returnChoice1
return ok choice1

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
label startMain
storage module immutable wanted String "ok"
storage module immutable a String "ok"
storage module immutable b String "no"
call pickCall pickFirstMatching
argument pickCall needle String wanted
argument pickCall choice1 String a
argument pickCall choice2 String b
run pickCall
bind ok picked String pickCall
call w console.writeLine
argument w console Console console
argument w text String picked
run w
ignore void source w
storage module immutable okExit ExitCode 0
return ok okExit
