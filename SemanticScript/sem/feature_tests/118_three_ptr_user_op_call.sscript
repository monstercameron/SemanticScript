# expect.stdout: ok\n
# expect.exit: 0
project ThreePtrParams
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder CSignedInt32

operation pickFirstMatching
input operation pickFirstMatching needle CNullTerminatedByteString
input operation pickFirstMatching choice1 CNullTerminatedByteString
input operation pickFirstMatching choice2 CNullTerminatedByteString
output operation pickFirstMatching Result CNullTerminatedByteString Void
purpose operation pickFirstMatching "Return choice1 if needle==choice1 else choice2."
label startPick
call eqCall c.strcmp
argument eqCall left CNullTerminatedByteString needle
argument eqCall right CNullTerminatedByteString choice1
run eqCall
bind value cmp CSignedInt64 eqCall
storage module immutable zeroEq CSignedInt64 0
call isEqCall math.equalI64
argument isEqCall left CSignedInt64 cmp
argument isEqCall right I64 zeroEq
run isEqCall
bind value isEq Bool isEqCall
branch if condition isEq target returnChoice1
return ok choice2
label returnChoice1
return ok choice1

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
label startMain
storage module immutable wanted CNullTerminatedByteString "ok"
storage module immutable a CNullTerminatedByteString "ok"
storage module immutable b CNullTerminatedByteString "no"
call pickCall pickFirstMatching
argument pickCall needle CNullTerminatedByteString wanted
argument pickCall choice1 CNullTerminatedByteString a
argument pickCall choice2 CNullTerminatedByteString b
run pickCall
bind ok picked CNullTerminatedByteString pickCall
call w console.writeLine
argument w console Console console
argument w text CNullTerminatedByteString picked
run w
ignore void source w
storage module immutable okExit ExitCode 0
return ok okExit
