# expect.stdout: hello from c.puts\n
# expect.exit: 0
project CPutsTest
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Emit a string-const through c.puts directly. Exercises the c.puts libc passthrough with a string-const arg."
invariant operation main "puts appends a newline automatically."
label startMain
storage module immutable greeting String "hello from c.puts"
call putsCall c.puts
argument putsCall text String greeting
run putsCall
ignore ok source putsCall type Int32
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
