# expect.stdout: len=2 word=hi\n
# expect.exit: 0
project CPrintfThreeArgPtrBindTest
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder CSignedInt32
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main read memory.buffer
effect main write memory.buffer
effect main write console.stdout
memory main heap auto
async main no
purpose operation main "Exercise 3-arg c.printf with two binds where arg2 is i64 (length) and arg3 is i8* (heap buffer). Hits the BBip emitter that emits `i64 %v, i8* %v`."
invariant operation main "Output is 'len=2 word=hi\\n'."
label startMain
storage module immutable bufferCap CByteCount 8
storage module immutable wordFormat CNullTerminatedByteString "hi"
storage module immutable finalFormat CNullTerminatedByteString "len=%lld word=%s\n"
storage module immutable twoValue CSignedInt64 2
call mallocCall c.malloc
argument mallocCall size CByteCount bufferCap
run mallocCall
bind value wordBuffer COpaqueMemoryAddress mallocCall

call snprCall c.snprintf
argument snprCall buffer COpaqueMemoryAddress wordBuffer
argument snprCall size CByteCount bufferCap
argument snprCall format CNullTerminatedByteString wordFormat
run snprCall
ignore ok source snprCall type CSignedInt32

memory main mutable lengthStorage I64 0
set memory lengthStorage twoValue
call strlenLoadCall c.strlen
argument strlenLoadCall text COpaqueMemoryAddress wordBuffer
run strlenLoadCall
bind value lengthFromBuffer CSignedInt64 strlenLoadCall

call printCall c.printf
argument printCall format CNullTerminatedByteString finalFormat
argument printCall length CSignedInt64 lengthFromBuffer
argument printCall word COpaqueMemoryAddress wordBuffer
run printCall
ignore ok source printCall type CSignedInt32

call freeCall c.free
argument freeCall ptr COpaqueMemoryAddress wordBuffer
run freeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
