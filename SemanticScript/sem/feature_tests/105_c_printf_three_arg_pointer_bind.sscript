# expect.stdout: len=2 word=hi\n
# expect.exit: 0
project CPrintfThreeArgPtrBindTest
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main read memory.buffer
effect main write memory.buffer
effect main write console.stdout
memory main heap auto
async main no
purpose operation main "Exercise 3-arg c.printf with two binds where arg2 is i64 (length) and arg3 is i8* (heap buffer). Hits the BBip emitter that emits `i64 %v, i8* %v`."
invariant operation main "Output is 'len=2 word=hi\\n'."
label startMain
storage module immutable bufferCap ByteCount 8
storage module immutable wordFormat String "hi"
storage module immutable finalFormat String "len=%lld word=%s\n"
storage module immutable twoValue Int64 2
call mallocCall c.malloc
argument mallocCall size ByteCount bufferCap
run mallocCall
bind value wordBuffer OpaquePointer mallocCall

call snprCall c.snprintf
argument snprCall buffer OpaquePointer wordBuffer
argument snprCall size ByteCount bufferCap
argument snprCall format String wordFormat
run snprCall
ignore ok source snprCall type Int32

memory main mutable lengthStorage Int64 0
set memory lengthStorage twoValue
call strlenLoadCall c.strlen
argument strlenLoadCall text OpaquePointer wordBuffer
run strlenLoadCall
bind value lengthFromBuffer Int64 strlenLoadCall

call printCall c.printf
argument printCall format String finalFormat
argument printCall length Int64 lengthFromBuffer
argument printCall word OpaquePointer wordBuffer
run printCall
ignore ok source printCall type Int32

call freeCall c.free
argument freeCall ptr OpaquePointer wordBuffer
run freeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
