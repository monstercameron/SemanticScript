# expect.stdout:
# expect.exit: 42
project ReturnErrorPayload
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError CustomCode CSignedInt32
operation main
input operation main console Console
output operation main Result ExitCode MainError
memory main heap no
async main no
purpose operation main "returnError should propagate the makeError payload value as exit code."
invariant operation main "Exit code reflects the actual payload, not a hardcoded 1."
label startMain
storage module immutable oneCount I64 1
storage module immutable oneCompare I64 1
memory main mutable x I64 oneCount
call eqCall math.equalI64
argument eqCall left I64 x
argument eqCall right I64 oneCompare
run eqCall
bind value alwaysTrue Bool eqCall
branch if condition alwaysTrue target errorLeg
branch else target successLeg
label errorLeg
storage module immutable customExitCode CSignedInt32 42
makeError customFailure MainError.CustomCode customExitCode
return error customFailure
label successLeg
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
