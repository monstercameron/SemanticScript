# expect.stdout: ok\n
# expect.exit: 0
project SignalHandlerRegister
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder CSignedInt32

# A signal handler operation. The C ABI wants `void (int)` — we model it
# as an operation whose result is ignored (CSignedInt32 placeholder).
operation myHandler
input operation myHandler signum CSignedInt32
output operation myHandler Result CSignedInt32 Void
purpose operation myHandler "Stub handler that does nothing. Just needs to exist as a function pointer."
label startHandler
storage module immutable zero CSignedInt32 0
return ok zero

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Register myHandler for SIGINT via c.signal, then print 'ok' (we never actually raise the signal)."
invariant operation main "Output: 'ok\\n'."
label startMain
storage module immutable sigint CSignedInt32 2
call regCall c.signal
argument regCall sig CSignedInt32 sigint
argument regCall handler CSignalHandler myHandler
run regCall
ignore ok source regCall type COpaqueMemoryAddress

storage module immutable okStr CNullTerminatedByteString "ok"
call w console.writeLine
argument w console Console console
argument w text CNullTerminatedByteString okStr
run w
ignore void source w

storage module immutable okExit ExitCode 0
return ok okExit
