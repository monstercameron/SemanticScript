# expect.stdout: yes\n
# expect.exit: 0
project GreaterThan
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "math.greaterThanI64: 9 > 3."
invariant operation main "Strict > selects yes."
label startMain
storage module immutable nineInitial I64 9
storage module immutable threeCompare I64 3
memory main mutable leftOp I64 nineInitial
call gtCall math.greaterThanI64
argument gtCall left I64 leftOp
argument gtCall right I64 threeCompare
run gtCall
bind value isGreater Bool gtCall
branch if condition isGreater target yesLabel
branch else target noLabel
label yesLabel
storage module immutable yesText CNullTerminatedByteString "yes"
call writeYesCall console.writeLine
argument writeYesCall console Console console
argument writeYesCall text CNullTerminatedByteString yesText
run writeYesCall
ignore void source writeYesCall
jump target endLabel
label noLabel
storage module immutable noText CNullTerminatedByteString "no"
call writeNoCall console.writeLine
argument writeNoCall console Console console
argument writeNoCall text CNullTerminatedByteString noText
run writeNoCall
ignore void source writeNoCall
jump target endLabel
label endLabel
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
