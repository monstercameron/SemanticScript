# expect.stdout: true\nfalse\n
# expect.exit: 0
languageMode permissiveExecutable
project JsonStringifyBoolPrimitive
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError EncodeFailed CSignedInt32
errorCase MainError ConsoleWriteFailed CSignedInt32
operation main
input main console Console
output main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose main "json.stringify.Bool returns true for true input and false for false."
invariant main "Output is exactly true newline false newline."
label startMain
const trueValue Bool 1
const falseValue Bool 0
call stringifyTrueCall json.stringify.Bool
arg stringifyTrueCall value trueValue
run stringifyTrueCall
bindOk trueEncodedString JsonText stringifyTrueCall
bindError trueEncodeError JsonEncodeError stringifyTrueCall
branchIfError stringifyTrueCall encodeFailed
call writeTrueCall console.writeLine
arg writeTrueCall console console
arg writeTrueCall text trueEncodedString
run writeTrueCall
ignoreOk writeTrueCall Void
bindError writeTrueError ConsoleWriteError writeTrueCall
branchIfError writeTrueCall consoleWriteFailed
call stringifyFalseCall json.stringify.Bool
arg stringifyFalseCall value falseValue
run stringifyFalseCall
bindOk falseEncodedString JsonText stringifyFalseCall
bindError falseEncodeError JsonEncodeError stringifyFalseCall
branchIfError stringifyFalseCall encodeFailed
call writeFalseCall console.writeLine
arg writeFalseCall console console
arg writeFalseCall text falseEncodedString
run writeFalseCall
ignoreOk writeFalseCall Void
bindError writeFalseError ConsoleWriteError writeFalseCall
branchIfError writeFalseCall consoleWriteFailed
const successfulExitCode ExitCode 0
returnOk successfulExitCode
label encodeFailed
makeError encodeFailure MainError.EncodeFailed trueEncodeError
returnError encodeFailure
label consoleWriteFailed
makeError writeFailure MainError.ConsoleWriteFailed writeTrueError
returnError writeFailure
