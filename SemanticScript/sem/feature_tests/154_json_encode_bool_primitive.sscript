# expect.stdout: true\nfalse\n
# expect.exit: 0
languageMode permissiveExecutable
project JsonStringifyBoolPrimitive
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError EncodeFailed CSignedInt32
errorCase MainError ConsoleWriteFailed CSignedInt32
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "json.stringify.Bool returns true for true input and false for false."
invariant operation main "Output is exactly true newline false newline."
label startMain
storage module immutable trueValue Bool 1
storage module immutable falseValue Bool 0
call stringifyTrueCall json.stringify.Bool
argument stringifyTrueCall value Bool trueValue
run stringifyTrueCall
bind ok trueEncodedString JsonText stringifyTrueCall
bind error trueEncodeError JsonEncodeError stringifyTrueCall
branch error source stringifyTrueCall target encodeFailed
call writeTrueCall console.writeLine
argument writeTrueCall console Console console
argument writeTrueCall text JsonText trueEncodedString
run writeTrueCall
ignore void source writeTrueCall
bind error writeTrueError ConsoleWriteError writeTrueCall
branch error source writeTrueCall target consoleWriteFailed
call stringifyFalseCall json.stringify.Bool
argument stringifyFalseCall value Bool falseValue
run stringifyFalseCall
bind ok falseEncodedString JsonText stringifyFalseCall
bind error falseEncodeError JsonEncodeError stringifyFalseCall
branch error source stringifyFalseCall target encodeFailed
call writeFalseCall console.writeLine
argument writeFalseCall console Console console
argument writeFalseCall text JsonText falseEncodedString
run writeFalseCall
ignore void source writeFalseCall
bind error writeFalseError ConsoleWriteError writeFalseCall
branch error source writeFalseCall target consoleWriteFailed
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
label encodeFailed
makeError encodeFailure MainError.EncodeFailed trueEncodeError
return error encodeFailure
label consoleWriteFailed
makeError writeFailure MainError.ConsoleWriteFailed writeTrueError
return error writeFailure
