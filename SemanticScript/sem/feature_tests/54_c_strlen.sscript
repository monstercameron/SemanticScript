# expect.stdout: 13\n
# expect.exit: 0
project CStrlen
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main read memory.buffer
effect main write console.stdout
memory main heap no
async main no
purpose operation main "c.strlen of 'Hello, World!' should be 13."
invariant operation main "Tests c.strlen passthrough."
label startMain
storage module immutable greetingText String "Hello, World!"
call lenCall c.strlen
argument lenCall s String greetingText
run lenCall
bind value lenValue ByteCount lenCall
memory main mutable lenVar Int64 0
set memory lenVar lenValue
call writeCall console.writeIntegerLine
argument writeCall console Console console
argument writeCall value Int64 lenVar
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
