# expect.stdout: 42\n
# expect.exit: 0
project IntFloatRoundTrip
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder CSignedInt32
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Round-trip an int through math.intToFloat and math.floatToInt: 42 -> 42.0 -> 42."
invariant operation main "Exercises both conversion primitives."
label startMain
storage module immutable fortyTwo I64 42
call toFloatCall math.intToFloat
argument toFloatCall value I64 fortyTwo
run toFloatCall
bind value asFloat CFloat64 toFloatCall
call backToIntCall math.floatToInt
argument backToIntCall value CFloat64 asFloat
run backToIntCall
bind value asIntAgain I64 backToIntCall
call writeCall console.writeIntegerLine
argument writeCall console Console console
argument writeCall value I64 asIntAgain
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
