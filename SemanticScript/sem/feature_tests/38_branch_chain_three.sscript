# expect.stdout: medium\n
# expect.exit: 0
project BranchChainThree
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Three-way branch on a value's range."
invariant operation main "Picks medium for 50."
label startMain
storage module immutable valueInitial I64 50
storage module immutable lowThreshold I64 10
storage module immutable highThreshold I64 100
memory main mutable value I64 valueInitial
call lowCheckCall math.lessThanI64
argument lowCheckCall left I64 value
argument lowCheckCall right I64 lowThreshold
run lowCheckCall
bind value isLow Bool lowCheckCall
branch if condition isLow target lowBranch
call highCheckCall math.greaterThanI64
argument highCheckCall left I64 value
argument highCheckCall right I64 highThreshold
run highCheckCall
bind value isHigh Bool highCheckCall
branch if condition isHigh target highBranch
branch else target mediumBranch
label lowBranch
storage module immutable lowText CNullTerminatedByteString "low"
call lowWriteCall console.writeLine
argument lowWriteCall console Console console
argument lowWriteCall text CNullTerminatedByteString lowText
run lowWriteCall
ignore void source lowWriteCall
jump target endLabel
label mediumBranch
storage module immutable mediumText CNullTerminatedByteString "medium"
call mediumWriteCall console.writeLine
argument mediumWriteCall console Console console
argument mediumWriteCall text CNullTerminatedByteString mediumText
run mediumWriteCall
ignore void source mediumWriteCall
jump target endLabel
label highBranch
storage module immutable highText CNullTerminatedByteString "high"
call highWriteCall console.writeLine
argument highWriteCall console Console console
argument highWriteCall text CNullTerminatedByteString highText
run highWriteCall
ignore void source highWriteCall
jump target endLabel
label endLabel
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
