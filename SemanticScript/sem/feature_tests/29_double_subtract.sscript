# expect.stdout: 0\n
# expect.exit: 0
project DoubleSubtract
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "10 - 5 - 5 = 0 via two chained subtracts."
invariant operation main "Two sequential subtract calls."
label startMain
storage module immutable tenInitial I64 10
storage module immutable fiveLit I64 5
memory main mutable leftOp I64 tenInitial
call firstSubCall math.subtractI64
argument firstSubCall left I64 leftOp
argument firstSubCall right I64 fiveLit
run firstSubCall
bind value midResult I64 firstSubCall
call secondSubCall math.subtractI64
argument secondSubCall left I64 midResult
argument secondSubCall right I64 fiveLit
run secondSubCall
bind value finalResult I64 secondSubCall
memory main mutable resultVar I64 tenInitial
set memory resultVar finalResult
call writeCall console.writeIntegerLine
argument writeCall console Console console
argument writeCall value I64 resultVar
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
