# expect.stdout: a=1 b=2 c=3 d=4 e=5\n
# expect.exit: 0
project CPrintfSixArgsWithVar
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder CSignedInt32

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap auto
async main no
purpose operation main "Exercise c.printf with 6 args (format + 5 trailing) where some args are vars (not binds). Probes whether PlusFive emits pre-call loads for var args."
invariant operation main "Output is 'a=1 b=2 c=3 d=4 e=5\\n'."
label startMain
storage module immutable triggerSize CByteCount 1
call walkerTriggerCall c.malloc
argument walkerTriggerCall size CByteCount triggerSize
run walkerTriggerCall
bind value triggerBuffer COpaqueMemoryAddress walkerTriggerCall

storage module immutable sixFormat CNullTerminatedByteString "a=%lld b=%lld c=%lld d=%lld e=%lld\n"
storage module immutable oneVal CSignedInt64 1
storage module immutable twoVal CSignedInt64 2
storage module immutable threeVal CSignedInt64 3
storage module immutable fourVal CSignedInt64 4
storage module immutable fiveVal CSignedInt64 5

# Use vars (mutable) instead of binds.
memory main mutable aVar CSignedInt64 oneVal
memory main mutable bVar CSignedInt64 twoVal
memory main mutable cVar CSignedInt64 threeVal
memory main mutable dVar CSignedInt64 fourVal
memory main mutable eVar CSignedInt64 fiveVal

call sixPrintfCall c.printf
argument sixPrintfCall format CNullTerminatedByteString sixFormat
argument sixPrintfCall a CSignedInt64 aVar
argument sixPrintfCall b CSignedInt64 bVar
argument sixPrintfCall c CSignedInt64 cVar
argument sixPrintfCall d CSignedInt64 dVar
argument sixPrintfCall e CSignedInt64 eVar
run sixPrintfCall
ignore ok source sixPrintfCall type CSignedInt32

call freeCall c.free
argument freeCall ptr COpaqueMemoryAddress triggerBuffer
run freeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
