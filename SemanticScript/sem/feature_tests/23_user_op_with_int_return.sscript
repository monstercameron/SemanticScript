# expect.stdout: 8\n
# expect.exit: 0
project UserOpIntReturn
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32

operation doubleIt
input operation doubleIt n Int64
output operation doubleIt Result Int64 Void
memory doubleIt heap no
async doubleIt no
purpose operation doubleIt "Return n * 2."
invariant operation doubleIt "Result is twice the input."
label startDoubleIt
storage module immutable twoLit Int64 2
call mulCall math.multiplyInt64
argument mulCall left Int64 n
argument mulCall right Int64 twoLit
run mulCall
bind value productResult Int64 mulCall
return ok productResult

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Call user op doubleIt(4) and print result."
invariant operation main "Outputs 8."
label startMain
storage module immutable fourInitial Int64 4
memory main mutable nValue Int64 fourInitial
call dblCall doubleIt
argument dblCall n Int64 nValue
run dblCall
bind ok dblResult Int64 dblCall
memory main mutable resultVar Int64 fourInitial
set memory resultVar dblResult
call writeCall console.writeIntegerLine
argument writeCall console Console console
argument writeCall value Int64 resultVar
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
