# expect.stdout: counting:\n1\n2\n3\ndone\n
# expect.exit: 0
project LoopWithUserOpAndString
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

operation identity
input operation identity x Int64
output operation identity Result Int64 Void
memory identity heap no
async identity no
purpose operation identity "Return input unchanged."
invariant operation identity "Identity function."
label startIdentity
return ok x

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Print 'counting:', 1,2,3, then 'done'."
invariant operation main "Mixes writeLine, writeIntegerLine, user op call, loop."
label startMain
storage module immutable oneInitial Int64 1
storage module immutable threeBound Int64 3
storage module immutable oneStep Int64 1
storage module immutable countingText String "counting:"
storage module immutable doneText String "done"
memory main mutable counter Int64 oneInitial
call writeCountingCall console.writeLine
argument writeCountingCall console Console console
argument writeCountingCall text String countingText
run writeCountingCall
ignore void source writeCountingCall
label loopHead
call checkCall math.lessThanOrEqualInt64
argument checkCall left Int64 counter
argument checkCall right Int64 threeBound
run checkCall
bind value shouldContinue Bool checkCall
branch if condition shouldContinue target loopBody
branch else target loopExit
label loopBody
call idCall identity
argument idCall x Int64 counter
run idCall
bind ok idResult Int64 idCall
memory main mutable idVar Int64 oneInitial
set memory idVar idResult
call printCall console.writeIntegerLine
argument printCall console Console console
argument printCall value Int64 idVar
run printCall
ignore void source printCall
call incCall math.addInt64
argument incCall left Int64 counter
argument incCall right Int64 oneStep
run incCall
bind value nextCounter Int64 incCall
set memory counter nextCounter
jump target loopHead
label loopExit
call writeDoneCall console.writeLine
argument writeDoneCall console Console console
argument writeDoneCall text String doneText
run writeDoneCall
ignore void source writeDoneCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
