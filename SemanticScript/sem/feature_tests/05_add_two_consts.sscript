# expect.stdout: 15\n
# expect.exit: 0
project AddTwoConsts
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Add 8+7 via math.addI64, print result."
invariant operation main "Computes 15 and emits it."
label startMain
storage module immutable eightInitial I64 8
memory main mutable leftOperand I64 eightInitial
storage module immutable sevenAdd I64 7
call addCall math.addI64
argument addCall left I64 leftOperand
argument addCall right I64 sevenAdd
run addCall
bind value sumResult I64 addCall
memory main mutable sumVar I64 eightInitial
set memory sumVar sumResult
call writeSumCall console.writeIntegerLine
argument writeSumCall console Console console
argument writeSumCall value I64 sumVar
run writeSumCall
ignore void source writeSumCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
