# expect.stdout: 15\n
# expect.exit: 0
project AddTwoConsts
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Add 8+7 via math.addInt64, print result."
invariant operation main "Computes 15 and emits it."
label startMain
storage module immutable eightInitial Int64 8
memory main mutable leftOperand Int64 eightInitial
storage module immutable sevenAdd Int64 7
call addCall math.addInt64
argument addCall left Int64 leftOperand
argument addCall right Int64 sevenAdd
run addCall
bind value sumResult Int64 addCall
memory main mutable sumVar Int64 eightInitial
set memory sumVar sumResult
call writeSumCall console.writeIntegerLine
argument writeSumCall console Console console
argument writeSumCall value Int64 sumVar
run writeSumCall
ignore void source writeSumCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
