# expect.stdout: 1\n3\n5\n7\n
# expect.exit: 0
project TwoVarLoop
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Two simultaneous loop vars: counter and value (odd numbers 1,3,5,7)."
invariant operation main "Counter bounded; value increments by 2 each step."
label startMain
storage module immutable oneInitial Int64 1
storage module immutable oneStep Int64 1
storage module immutable twoStep Int64 2
storage module immutable fourBound Int64 4
storage module immutable zeroInitial Int64 0
memory main mutable counter Int64 zeroInitial
memory main mutable oddValue Int64 oneInitial
label loopHead
call checkCall math.lessThanInt64
argument checkCall left Int64 counter
argument checkCall right Int64 fourBound
run checkCall
bind value shouldContinue Bool checkCall
branch if condition shouldContinue target loopBody
branch else target loopExit
label loopBody
call printCall console.writeIntegerLine
argument printCall console Console console
argument printCall value Int64 oddValue
run printCall
ignore void source printCall
call incCounterCall math.addInt64
argument incCounterCall left Int64 counter
argument incCounterCall right Int64 oneStep
run incCounterCall
bind value nextCounter Int64 incCounterCall
set memory counter nextCounter
call incOddCall math.addInt64
argument incOddCall left Int64 oddValue
argument incOddCall right Int64 twoStep
run incOddCall
bind value nextOdd Int64 incOddCall
set memory oddValue nextOdd
jump target loopHead
label loopExit
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
