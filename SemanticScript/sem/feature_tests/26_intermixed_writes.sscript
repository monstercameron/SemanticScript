# expect.stdout: label\n42\nend\n
# expect.exit: 0
project IntermixedWrites
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Interleaved writeLine and writeIntegerLine."
invariant operation main "Mixed string and integer output."
label startMain
storage module immutable labelText String "label"
storage module immutable fortyTwoInitial Int64 42
storage module immutable endText String "end"
memory main mutable counter Int64 fortyTwoInitial
call writeLabelCall console.writeLine
argument writeLabelCall console Console console
argument writeLabelCall text String labelText
run writeLabelCall
ignore void source writeLabelCall
call writeNumCall console.writeIntegerLine
argument writeNumCall console Console console
argument writeNumCall value Int64 counter
run writeNumCall
ignore void source writeNumCall
call writeEndCall console.writeLine
argument writeEndCall console Console console
argument writeEndCall text String endText
run writeEndCall
ignore void source writeEndCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
