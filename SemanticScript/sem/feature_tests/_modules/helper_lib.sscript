# Imported helper module. Not run directly; consumed by 121_cross_file_import.sscript
# via `importModule sem.feature_tests._modules.helper_lib`. The header (project/target/runtime/entry) is
# stripped by the import resolver, leaving only the operation definitions for
# the importer to consume.
project HelperLib
target console
runtime AgentRuntime 0.1
entry console addSeven

operation addSeven
input operation addSeven base I64
input operation addSeven addend I64
output operation addSeven Result I64 Void
memory addSeven heap no
async addSeven no
purpose operation addSeven "Return base + addend. Demonstrates a callable defined in an imported module."
invariant operation addSeven "Returns the sum of its two inputs."
label startAddSeven
call sumCall math.addI64
argument sumCall left I64 base
argument sumCall right I64 addend
run sumCall
bind value sumResult I64 sumCall
return ok sumResult
