# Imported helper module. Not run directly; consumed by 121_cross_file_import.sscript
# via `importModule sem.feature_tests._modules.helper_lib`. The header (project/target/runtime/entry) is
# stripped by the import resolver, leaving only the operation definitions for
# the importer to consume.
project HelperLib
target console
runtime AgentRuntime 0.1
entry console addSeven

operation addSeven
input addSeven base I64
input addSeven addend I64
output addSeven Result I64 Void
memory addSeven heap no
async addSeven no
purpose addSeven "Return base + addend. Demonstrates a callable defined in an imported module."
invariant addSeven "Returns the sum of its two inputs."
label startAddSeven
call sumCall math.addI64
arg sumCall left base
arg sumCall right addend
run sumCall
bind sumResult I64 sumCall
returnOk sumResult
