# expect.stdout: 1\n
# expect.exit: 0
project MutualRecursion
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32

operation isEven
input operation isEven n Int64
output operation isEven Result Int64 Void
memory isEven heap no
async isEven no
purpose operation isEven "Mutually-recursive even test: 0 is even; n even iff isOdd(n-1)."
invariant operation isEven "Calls isOdd on decrement."
label startIsEven
storage module immutable zeroLit Int64 0
storage module immutable oneLit Int64 1
call atZeroCall math.equalInt64
argument atZeroCall left Int64 n
argument atZeroCall right Int64 zeroLit
run atZeroCall
bind value atZero Bool atZeroCall
branch if condition atZero target evenBase
branch else target evenRecurse
label evenBase
return ok oneLit
label evenRecurse
call decCall math.subtractInt64
argument decCall left Int64 n
argument decCall right Int64 oneLit
run decCall
bind value decremented Int64 decCall
call recCall isOdd
argument recCall n Int64 decremented
run recCall
bind ok recResult Int64 recCall
return ok recResult

operation isOdd
input operation isOdd n Int64
output operation isOdd Result Int64 Void
memory isOdd heap no
async isOdd no
purpose operation isOdd "Mutually-recursive odd test."
invariant operation isOdd "Calls isEven on decrement."
label startIsOdd
storage module immutable zeroLit Int64 0
storage module immutable oneLit Int64 1
call atZeroOddCall math.equalInt64
argument atZeroOddCall left Int64 n
argument atZeroOddCall right Int64 zeroLit
run atZeroOddCall
bind value atZeroOdd Bool atZeroOddCall
branch if condition atZeroOdd target oddBase
branch else target oddRecurse
label oddBase
return ok zeroLit
label oddRecurse
call decCall math.subtractInt64
argument decCall left Int64 n
argument decCall right Int64 oneLit
run decCall
bind value decremented Int64 decCall
call recCall isEven
argument recCall n Int64 decremented
run recCall
bind ok recResult Int64 recCall
return ok recResult

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "isEven(8) should be 1."
invariant operation main "8 is even."
label startMain
storage module immutable eightInitial Int64 8
memory main mutable input Int64 eightInitial
call evenCall isEven
argument evenCall n Int64 input
run evenCall
bind ok evenResult Int64 evenCall
memory main mutable outputVar Int64 eightInitial
set memory outputVar evenResult
call writeCall console.writeIntegerLine
argument writeCall console Console console
argument writeCall value Int64 outputVar
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
