# expect.stdout: ping\nping\nping\n
# expect.exit: 0
project RepeatedStringPrint
target console
runtime AgentRuntime 0.1
mode capturedOutputReplay
entry console main
error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Same string const referenced three times in separate calls; verifies per-call (not per-const) puts emission."
invariant operation main "Output line count equals call count, not unique-const count."
label startMain
storage module immutable pingText CNullTerminatedByteString "ping"
call writeOneCall console.writeLine
argument writeOneCall console Console console
argument writeOneCall text CNullTerminatedByteString pingText
run writeOneCall
ignore void source writeOneCall
call writeTwoCall console.writeLine
argument writeTwoCall console Console console
argument writeTwoCall text CNullTerminatedByteString pingText
run writeTwoCall
ignore void source writeTwoCall
call writeThreeCall console.writeLine
argument writeThreeCall console Console console
argument writeThreeCall text CNullTerminatedByteString pingText
run writeThreeCall
ignore void source writeThreeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
