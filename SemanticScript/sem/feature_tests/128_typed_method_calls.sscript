# expect.stdout: ok\n
# expect.exit: 0
# Dotted typed-method call targets (TaskList.append, TaskMap.get,
# json.parse.X, json.stringify.X) compile cleanly but are not runtime-complete.
# semsc.py routes non-primitive generated codecs and typed collection calls through the
# external-module fallback in _emit_run, producing well-typed IR with zero-shaped
# stub results. semlint flags this as an explicit runtime gap.
project TypedMethodCallsCompile
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Smoke-test that dotted typed-method calls (TaskList.append, TaskMap.get, json.parse.X, json.stringify.X) compile to valid IR via the external-module fallback, not that they have real runtime behavior."
invariant operation main "Output is 'ok\\n'."
label startMain

# These calls have no real implementation — they hit the external-module
# fallback in _emit_run that emits zero results. We bind each so the emit path
# exercises both call+arg+run+bind while the linter carries the runtime warning.
storage module immutable triggerSize ByteCount 1
call walkerTriggerCall c.malloc
argument walkerTriggerCall size ByteCount triggerSize
run walkerTriggerCall
bind value triggerBuffer OpaquePointer walkerTriggerCall

storage module immutable fakeList Int64 0
storage module immutable fakeItem Int64 0
call listAppendCall TaskList.append
argument listAppendCall list Int64 fakeList
argument listAppendCall item Int64 fakeItem
run listAppendCall
bind ok newList Int64 listAppendCall

storage module immutable fakeMap Int64 0
storage module immutable fakeKey Int64 0
call mapGetCall TaskMap.get
argument mapGetCall map Int64 fakeMap
argument mapGetCall key Int64 fakeKey
run mapGetCall
bind ok taskValue Int64 mapGetCall

storage module immutable fakeJson Int64 0
call jsonDecodeCall json.parse.Task
argument jsonDecodeCall bytes Int64 fakeJson
run jsonDecodeCall
bind ok decodedTask Int64 jsonDecodeCall

call jsonEncodeCall json.stringify.Task
argument jsonEncodeCall value Int64 decodedTask
run jsonEncodeCall
bind ok encodedBytes Int64 jsonEncodeCall

call freeCall c.free
argument freeCall ptr OpaquePointer triggerBuffer
run freeCall

storage module immutable okText String "ok"
call writeCall console.writeLine
argument writeCall console Console console
argument writeCall text String okText
run writeCall
ignore void source writeCall

storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
