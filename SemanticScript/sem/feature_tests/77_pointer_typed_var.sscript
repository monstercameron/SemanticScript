# expect.stdout: hi\nbye\n
# expect.exit: 0
project PointerTypedVar
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder CSignedInt32

operation putString
input operation putString s CNullTerminatedByteString
output operation putString Result CByteCount Void
effect putString read memory.buffer
effect putString write console.stdout
memory putString heap no
async putString no
purpose operation putString "Write every byte of s to stdout via c.putchar until a NUL terminator."
invariant operation putString "Stops at the first zero byte."
label startPutString
storage module immutable zeroIndex CSignedInt64 0
storage module immutable oneStep CSignedInt64 1
storage module immutable nullByte CSignedInt64 0
memory putString mutable positionIndex CSignedInt64 zeroIndex
label loopTop
call byteLoadCall pointer.loadByte
argument byteLoadCall buffer CNullTerminatedByteString s
argument byteLoadCall offset CSignedInt64 positionIndex
run byteLoadCall
bind value currentByte I8 byteLoadCall
call isTerminatorCall math.equalI64
argument isTerminatorCall left I8 currentByte
argument isTerminatorCall right I64 nullByte
run isTerminatorCall
bind value isTerminator Bool isTerminatorCall
branch if condition isTerminator target finishWriting
call writeByteCall c.putchar
argument writeByteCall c I8 currentByte
run writeByteCall
call advanceCall math.addI64
argument advanceCall left I64 positionIndex
argument advanceCall right I64 oneStep
run advanceCall
bind value nextPosition CSignedInt64 advanceCall
set memory positionIndex nextPosition
jump target loopTop
label finishWriting
return ok positionIndex

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main read memory.buffer
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Initialize a CNullTerminatedByteString var to 'hi', print it via putString + newline, then SET it to 'bye' and print again. Exercises pointer-typed var alloca + init + set + load + arg passing."
invariant operation main "Output is 'hi\nbye\n'."
label startMain
storage module immutable helloMsg CNullTerminatedByteString "hi"
storage module immutable byeMsg CNullTerminatedByteString "bye"
storage module immutable newlineByte CSignedInt32 10
memory main mutable greeting CNullTerminatedByteString helloMsg
call putGreetingCall putString
argument putGreetingCall s CNullTerminatedByteString greeting
run putGreetingCall
ignore ok source putGreetingCall type CByteCount
call newlineCall1 c.putchar
argument newlineCall1 c CSignedInt32 newlineByte
run newlineCall1
set memory greeting byeMsg
call putByeCall putString
argument putByeCall s CNullTerminatedByteString greeting
run putByeCall
ignore ok source putByeCall type CByteCount
call newlineCall2 c.putchar
argument newlineCall2 c CSignedInt32 newlineByte
run newlineCall2
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
