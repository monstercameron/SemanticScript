# expect.stdout: hi\nbye\n
# expect.exit: 0
project PointerTypedVar
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32

operation putString
input operation putString s String
output operation putString Result ByteCount Void
effect putString read memory.buffer
effect putString write console.stdout
memory putString heap no
async putString no
purpose operation putString "Write every byte of s to stdout via c.putchar until a NUL terminator."
invariant operation putString "Stops at the first zero byte."
label startPutString
storage module immutable zeroIndex Int64 0
storage module immutable oneStep Int64 1
storage module immutable nullByte Int64 0
memory putString mutable positionIndex Int64 zeroIndex
label loopTop
call byteLoadCall pointer.loadByte
argument byteLoadCall buffer String s
argument byteLoadCall offset Int64 positionIndex
run byteLoadCall
bind value currentByte Int8 byteLoadCall
call isTerminatorCall math.equalInt64
argument isTerminatorCall left Int8 currentByte
argument isTerminatorCall right Int64 nullByte
run isTerminatorCall
bind value isTerminator Bool isTerminatorCall
branch if condition isTerminator target finishWriting
call writeByteCall c.putchar
argument writeByteCall c Int8 currentByte
run writeByteCall
call advanceCall math.addInt64
argument advanceCall left Int64 positionIndex
argument advanceCall right Int64 oneStep
run advanceCall
bind value nextPosition Int64 advanceCall
set memory positionIndex nextPosition
jump target loopTop
label finishWriting
return ok positionIndex

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main read memory.buffer
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Initialize a String var to 'hi', print it via putString + newline, then SET it to 'bye' and print again. Exercises pointer-typed var alloca + init + set + load + arg passing."
invariant operation main "Output is 'hi\nbye\n'."
label startMain
storage module immutable helloMsg String "hi"
storage module immutable byeMsg String "bye"
storage module immutable newlineByte Int32 10
memory main mutable greeting String helloMsg
call putGreetingCall putString
argument putGreetingCall s String greeting
run putGreetingCall
ignore ok source putGreetingCall type ByteCount
call newlineCall1 c.putchar
argument newlineCall1 c Int32 newlineByte
run newlineCall1
set memory greeting byeMsg
call putByeCall putString
argument putByeCall s String greeting
run putByeCall
ignore ok source putByeCall type ByteCount
call newlineCall2 c.putchar
argument newlineCall2 c Int32 newlineByte
run newlineCall2
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
