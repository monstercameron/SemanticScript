# expect.stdout: 15\n
# expect.exit: 0
project TwoParamUserOp
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32

operation addTwo
input operation addTwo a Int64
input operation addTwo b Int64
output operation addTwo Result Int64 Void
memory addTwo heap no
async addTwo no
purpose operation addTwo "Return a + b."
invariant operation addTwo "Two-parameter user op."
label startAddTwo
call addCall math.addInt64
argument addCall left Int64 a
argument addCall right Int64 b
run addCall
bind value sumResult Int64 addCall
return ok sumResult

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Call addTwo(7, 8) = 15."
invariant operation main "Two-arg call into user op."
label startMain
storage module immutable sevenInitial Int64 7
storage module immutable eightInitial Int64 8
memory main mutable leftValue Int64 sevenInitial
memory main mutable rightValue Int64 eightInitial
call sumCall addTwo
argument sumCall a Int64 leftValue
argument sumCall b Int64 rightValue
run sumCall
bind ok sumOutcome Int64 sumCall
memory main mutable resultVar Int64 sevenInitial
set memory resultVar sumOutcome
call writeCall console.writeIntegerLine
argument writeCall console Console console
argument writeCall value Int64 resultVar
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
