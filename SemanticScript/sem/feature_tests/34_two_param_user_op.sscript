# expect.stdout: 15\n
# expect.exit: 0
project TwoParamUserOp
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder CSignedInt32

operation addTwo
input operation addTwo a CSignedInt64
input operation addTwo b CSignedInt64
output operation addTwo Result CSignedInt64 Void
memory addTwo heap no
async addTwo no
purpose operation addTwo "Return a + b."
invariant operation addTwo "Two-parameter user op."
label startAddTwo
call addCall math.addI64
argument addCall left I64 a
argument addCall right I64 b
run addCall
bind value sumResult I64 addCall
return ok sumResult

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Call addTwo(7, 8) = 15."
invariant operation main "Two-arg call into user op."
label startMain
storage module immutable sevenInitial I64 7
storage module immutable eightInitial I64 8
memory main mutable leftValue I64 sevenInitial
memory main mutable rightValue I64 eightInitial
call sumCall addTwo
argument sumCall a CSignedInt64 leftValue
argument sumCall b CSignedInt64 rightValue
run sumCall
bind ok sumOutcome I64 sumCall
memory main mutable resultVar I64 sevenInitial
set memory resultVar sumOutcome
call writeCall console.writeIntegerLine
argument writeCall console Console console
argument writeCall value I64 resultVar
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
