# expect.stdout:
# expect.exit: 1
project ReturnErrorOne
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError IntentionalFailure CSignedInt32
operation main
input operation main console Console
output operation main Result ExitCode MainError
memory main heap no
async main no
purpose operation main "branchIf to a returnError leg; verifies exit code 1."
invariant operation main "Always takes the error path."
label startMain
storage module immutable oneCount I64 1
storage module immutable oneCompare I64 1
memory main mutable leftOp I64 oneCount
call eqCall math.equalI64
argument eqCall left I64 leftOp
argument eqCall right I64 oneCompare
run eqCall
bind value alwaysTrue Bool eqCall
branch if condition alwaysTrue target errorLeg
branch else target successLeg
label errorLeg
storage module immutable intentionalFailureCode CSignedInt32 1
makeError intentionalFailure MainError.IntentionalFailure intentionalFailureCode
return error intentionalFailure
label successLeg
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
