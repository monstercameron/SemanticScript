# expect.stdout: 10 20 30 40\n
# expect.exit: 0
project CPrintfFourArgsBindsTest
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main read memory.buffer
effect main write memory.buffer
effect main write console.stdout
memory main heap auto
async main no
purpose operation main "Exercise 4-arg c.printf (format + 4 trailing args) where every trailing arg is an i64 SSA bind. Hits the new emitCprintfFmtPlusThree decomposition path."
invariant operation main "Output is '10 20 30 40\\n'."
label startMain
storage module immutable triggerSize ByteCount 1
call walkerTriggerCall c.malloc
argument walkerTriggerCall size ByteCount triggerSize
run walkerTriggerCall
bind value walkerTriggerBuffer OpaquePointer walkerTriggerCall

storage module immutable tenValue Int64 10
storage module immutable twentyValue Int64 20
storage module immutable thirtyValue Int64 30
storage module immutable fortyValue Int64 40

call idTenCall identityInt64
argument idTenCall input Int64 tenValue
run idTenCall
bind value tenBind Int64 idTenCall

call idTwentyCall identityInt64
argument idTwentyCall input Int64 twentyValue
run idTwentyCall
bind value twentyBind Int64 idTwentyCall

call idThirtyCall identityInt64
argument idThirtyCall input Int64 thirtyValue
run idThirtyCall
bind value thirtyBind Int64 idThirtyCall

call idFortyCall identityInt64
argument idFortyCall input Int64 fortyValue
run idFortyCall
bind value fortyBind Int64 idFortyCall

storage module immutable fourArgFormat String "%lld %lld %lld %lld\n"

call printCall c.printf
argument printCall format String fourArgFormat
argument printCall a Int64 tenBind
argument printCall b Int64 twentyBind
argument printCall c Int64 thirtyBind
argument printCall d Int64 fortyBind
run printCall
ignore ok source printCall type Int32

call freeCall c.free
argument freeCall ptr OpaquePointer walkerTriggerBuffer
run freeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode

operation identityInt64
input operation identityInt64 input Int64
output operation identityInt64 Result Int64 Void
purpose operation identityInt64 "Wrap a const integer in a bind so the test exercises the bind-arg path."
label startIdentityInt64
return ok input
