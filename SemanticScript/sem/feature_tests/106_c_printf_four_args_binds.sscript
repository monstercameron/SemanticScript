# expect.stdout: 10 20 30 40\n
# expect.exit: 0
project CPrintfFourArgsBindsTest
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder CSignedInt32
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main read memory.buffer
effect main write memory.buffer
effect main write console.stdout
memory main heap auto
async main no
purpose operation main "Exercise 4-arg c.printf (format + 4 trailing args) where every trailing arg is an i64 SSA bind. Hits the new emitCprintfFmtPlusThree decomposition path."
invariant operation main "Output is '10 20 30 40\\n'."
label startMain
storage module immutable triggerSize CByteCount 1
call walkerTriggerCall c.malloc
argument walkerTriggerCall size CByteCount triggerSize
run walkerTriggerCall
bind value walkerTriggerBuffer COpaqueMemoryAddress walkerTriggerCall

storage module immutable tenValue CSignedInt64 10
storage module immutable twentyValue CSignedInt64 20
storage module immutable thirtyValue CSignedInt64 30
storage module immutable fortyValue CSignedInt64 40

call idTenCall identityI64
argument idTenCall input CSignedInt64 tenValue
run idTenCall
bind value tenBind CSignedInt64 idTenCall

call idTwentyCall identityI64
argument idTwentyCall input CSignedInt64 twentyValue
run idTwentyCall
bind value twentyBind CSignedInt64 idTwentyCall

call idThirtyCall identityI64
argument idThirtyCall input CSignedInt64 thirtyValue
run idThirtyCall
bind value thirtyBind CSignedInt64 idThirtyCall

call idFortyCall identityI64
argument idFortyCall input CSignedInt64 fortyValue
run idFortyCall
bind value fortyBind CSignedInt64 idFortyCall

storage module immutable fourArgFormat CNullTerminatedByteString "%lld %lld %lld %lld\n"

call printCall c.printf
argument printCall format CNullTerminatedByteString fourArgFormat
argument printCall a CSignedInt64 tenBind
argument printCall b CSignedInt64 twentyBind
argument printCall c CSignedInt64 thirtyBind
argument printCall d CSignedInt64 fortyBind
run printCall
ignore ok source printCall type CSignedInt32

call freeCall c.free
argument freeCall ptr COpaqueMemoryAddress walkerTriggerBuffer
run freeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode

operation identityI64
input operation identityI64 input CSignedInt64
output operation identityI64 Result CSignedInt64 Void
purpose operation identityI64 "Wrap a const integer in a bind so the test exercises the bind-arg path."
label startIdentityI64
return ok input
