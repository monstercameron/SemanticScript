# expect.stdout: selectCompleted\n
# expect.exit: 0
project SelectNoOpFallsThrough
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder CSignedInt32
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "select + selectCase + runSelect + branchSelected must fall through to success continuation."
invariant operation main "Execution reaches the success label; no select branch is taken; output is `selectCompleted`."
label startMain
select raceController
selectCase raceController firstChannelToken firstBranchLabel
selectCase raceController secondChannelToken secondBranchLabel
runSelect raceController
branchSelected raceController firstChannelToken firstBranchLabel
branchSelected raceController secondChannelToken secondBranchLabel
jump target successContinuation
label firstBranchLabel
storage module immutable firstBranchErrorMessage CNullTerminatedByteString "firstBranchTaken"
call writeFirstCall console.writeLine
argument writeFirstCall console Console console
argument writeFirstCall text CNullTerminatedByteString firstBranchErrorMessage
run writeFirstCall
ignore void source writeFirstCall
jump target successContinuation
label secondBranchLabel
storage module immutable secondBranchErrorMessage CNullTerminatedByteString "secondBranchTaken"
call writeSecondCall console.writeLine
argument writeSecondCall console Console console
argument writeSecondCall text CNullTerminatedByteString secondBranchErrorMessage
run writeSecondCall
ignore void source writeSecondCall
jump target successContinuation
label successContinuation
storage module immutable selectCompletedMessage CNullTerminatedByteString "selectCompleted"
call writeCompletedCall console.writeLine
argument writeCompletedCall console Console console
argument writeCompletedCall text CNullTerminatedByteString selectCompletedMessage
run writeCompletedCall
ignore void source writeCompletedCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
