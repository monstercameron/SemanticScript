# expect.stdout: selectCompleted\n
# expect.exit: 0
# expect.xfail: feature_coverage.py runs through bootstrap_general.sscript which does not yet recognize all select/selectCase/runSelect/branchSelected verb shapes. Direct semsc.py compilation is correct: under single-thread no-op lowering each select verb falls through; control reaches the success label. `python compiler/semsc.py THIS_FILE --emit-exe /tmp/x.exe && /tmp/x.exe` prints `selectCompleted`.
project SelectNoOpFallsThrough
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder CSignedInt32
operation main
input main console Console
output main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose main "select + selectCase + runSelect + branchSelected must fall through to success continuation."
invariant main "Execution reaches the success label; no select branch is taken; output is `selectCompleted`."
label startMain
select raceController
selectCase raceController firstChannelToken firstBranchLabel
selectCase raceController secondChannelToken secondBranchLabel
runSelect raceController
branchSelected raceController firstChannelToken firstBranchLabel
branchSelected raceController secondChannelToken secondBranchLabel
branch successContinuation
label firstBranchLabel
const firstBranchErrorMessage CNullTerminatedByteString "firstBranchTaken"
call writeFirstCall console.writeLine
arg writeFirstCall console console
arg writeFirstCall text firstBranchErrorMessage
run writeFirstCall
ignoreOk writeFirstCall Void
branch successContinuation
label secondBranchLabel
const secondBranchErrorMessage CNullTerminatedByteString "secondBranchTaken"
call writeSecondCall console.writeLine
arg writeSecondCall console console
arg writeSecondCall text secondBranchErrorMessage
run writeSecondCall
ignoreOk writeSecondCall Void
branch successContinuation
label successContinuation
const selectCompletedMessage CNullTerminatedByteString "selectCompleted"
call writeCompletedCall console.writeLine
arg writeCompletedCall console console
arg writeCompletedCall text selectCompletedMessage
run writeCompletedCall
ignoreOk writeCompletedCall Void
const successfulExitCode ExitCode 0
returnOk successfulExitCode
