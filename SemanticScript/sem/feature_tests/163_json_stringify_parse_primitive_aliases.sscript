# expect.stdout: 42\n42\ntrue\nparsedTrue\nfalse\nparsedFalse\n
# expect.exit: 0
languageMode permissiveExecutable
project JsonStringifyParsePrimitiveAliases
target console
runtime AgentRuntime 0.1
module jsonStringifyParsePrimitiveAliases

import json standard.json
dependency standard.json version 0.1 source standard

entry console main

error MainError
errorCase MainError EncodeFailed Int32
errorCase MainError DecodeFailed Int32
errorCase MainError RoundTripMismatch Int32
errorCase MainError ConsoleWriteFailed Int32

capability jsonAliasStdout console.stdout write
purpose operation jsonAliasStdout "Authority to write the primitive JSON alias smoke output."

storage module immutable successExit ExitCode 0
storage module immutable encodeFailedCode Int32 1
storage module immutable decodeFailedCode Int32 2
storage module immutable mismatchCode Int32 3
storage module immutable consoleFailedCode Int32 4

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
useCapability main jsonAliasStdout
purpose operation main "Round-trip Int64 and Bool values through json.stringify/json.parse primitive aliases and print byte-observable markers."
invariant operation main "A no-op alias lowering cannot satisfy this test: stdout depends on real JSON text and parsed primitive control flow."

label startMain

storage module immutable fortyTwoValue Int64 42
call stringifyIntegerCall json.stringify.Int64
argument stringifyIntegerCall value Int64 fortyTwoValue
run stringifyIntegerCall
bind ok encodedInteger JsonText stringifyIntegerCall
bind error stringifyIntegerError JsonEncodeError stringifyIntegerCall
branch error source stringifyIntegerCall target encodeFailed

call writeEncodedIntegerCall console.writeLine
argument writeEncodedIntegerCall console Console console
argument writeEncodedIntegerCall text JsonText encodedInteger
run writeEncodedIntegerCall
ignore void source writeEncodedIntegerCall
bind error writeEncodedIntegerError ConsoleWriteError writeEncodedIntegerCall
branch error source writeEncodedIntegerCall target consoleWriteFailed

call parseIntegerCall json.parse.Int64
argument parseIntegerCall jsonText JsonText encodedInteger
run parseIntegerCall
bind ok decodedInteger Int64 parseIntegerCall
bind error parseIntegerError JsonDecodeError parseIntegerCall
branch error source parseIntegerCall target decodeFailed

call writeDecodedIntegerCall console.writeIntegerLine
argument writeDecodedIntegerCall console Console console
argument writeDecodedIntegerCall value Int64 decodedInteger
run writeDecodedIntegerCall
ignore void source writeDecodedIntegerCall
bind error writeDecodedIntegerError ConsoleWriteError writeDecodedIntegerCall
branch error source writeDecodedIntegerCall target consoleWriteFailed

storage module immutable trueValue Bool 1
call stringifyTrueCall json.stringify.Bool
argument stringifyTrueCall value Bool trueValue
run stringifyTrueCall
bind ok encodedTrue JsonText stringifyTrueCall
bind error stringifyTrueError JsonEncodeError stringifyTrueCall
branch error source stringifyTrueCall target encodeFailed

call writeEncodedTrueCall console.writeLine
argument writeEncodedTrueCall console Console console
argument writeEncodedTrueCall text JsonText encodedTrue
run writeEncodedTrueCall
ignore void source writeEncodedTrueCall
bind error writeEncodedTrueError ConsoleWriteError writeEncodedTrueCall
branch error source writeEncodedTrueCall target consoleWriteFailed

call parseTrueCall json.parse.Bool
argument parseTrueCall jsonText JsonText encodedTrue
run parseTrueCall
bind ok decodedTrue Bool parseTrueCall
bind error parseTrueError JsonDecodeError parseTrueCall
branch error source parseTrueCall target decodeFailed

branch if condition decodedTrue target parsedTrueOk
branch else target roundTripMismatch

label parsedTrueOk
storage module immutable parsedTrueMarker String "parsedTrue"
call writeParsedTrueCall console.writeLine
argument writeParsedTrueCall console Console console
argument writeParsedTrueCall text String parsedTrueMarker
run writeParsedTrueCall
ignore void source writeParsedTrueCall
bind error writeParsedTrueError ConsoleWriteError writeParsedTrueCall
branch error source writeParsedTrueCall target consoleWriteFailed

storage module immutable falseValue Bool 0
call stringifyFalseCall json.stringify.Bool
argument stringifyFalseCall value Bool falseValue
run stringifyFalseCall
bind ok encodedFalse JsonText stringifyFalseCall
bind error stringifyFalseError JsonEncodeError stringifyFalseCall
branch error source stringifyFalseCall target encodeFailed

call writeEncodedFalseCall console.writeLine
argument writeEncodedFalseCall console Console console
argument writeEncodedFalseCall text JsonText encodedFalse
run writeEncodedFalseCall
ignore void source writeEncodedFalseCall
bind error writeEncodedFalseError ConsoleWriteError writeEncodedFalseCall
branch error source writeEncodedFalseCall target consoleWriteFailed

call parseFalseCall json.parse.Bool
argument parseFalseCall jsonText JsonText encodedFalse
run parseFalseCall
bind ok decodedFalse Bool parseFalseCall
bind error parseFalseError JsonDecodeError parseFalseCall
branch error source parseFalseCall target decodeFailed

branch if condition decodedFalse target roundTripMismatch

storage module immutable parsedFalseMarker String "parsedFalse"
call writeParsedFalseCall console.writeLine
argument writeParsedFalseCall console Console console
argument writeParsedFalseCall text String parsedFalseMarker
run writeParsedFalseCall
ignore void source writeParsedFalseCall
bind error writeParsedFalseError ConsoleWriteError writeParsedFalseCall
branch error source writeParsedFalseCall target consoleWriteFailed

return ok successExit

label encodeFailed
makeError encodeFailure MainError.EncodeFailed encodeFailedCode
return error encodeFailure

label decodeFailed
makeError decodeFailure MainError.DecodeFailed decodeFailedCode
return error decodeFailure

label roundTripMismatch
makeError mismatchFailure MainError.RoundTripMismatch mismatchCode
return error mismatchFailure

label consoleWriteFailed
makeError consoleFailure MainError.ConsoleWriteFailed consoleFailedCode
return error consoleFailure
