# expect.stdout: AB
# expect.exit: 0
project CPutchar
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Emit two bytes via c.putchar (A=65, B=66)."
invariant operation main "Direct libc passthrough to putchar."
label startMain
storage module immutable charA Int32 65
storage module immutable charB Int32 66
call writeACall c.putchar
argument writeACall c Int32 charA
run writeACall
call writeBCall c.putchar
argument writeBCall c Int32 charB
run writeBCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
