# expect.stdout: 19\n
# expect.exit: 0
# Record-typed user-op parameter: pass a Point by value to sumPoint, which
# reads .x and .y via fieldGet on the param and returns their sum.
project RecordTypedParam
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

record Point layout row align 8
field Point x I64
field Point y I64

operation sumPoint
input operation sumPoint p Point
output operation sumPoint Result I64 Void
memory sumPoint heap no
async sumPoint no
purpose operation sumPoint "Return p.x + p.y. Exercises a record-typed input parameter: callee reads each field via fieldGet directly on the param name."
invariant operation sumPoint "Returns x + y."
label startSumPoint
fieldGet xVal I64 p x
fieldGet yVal I64 p y
call addCall math.addI64
argument addCall left I64 xVal
argument addCall right I64 yVal
run addCall
bind value sumRes I64 addCall
return ok sumRes

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap auto
async main no
purpose operation main "Construct a Point {x:7,y:12} and call sumPoint(p). Expect 19."
invariant operation main "Output is '19\\n'."
label startMain
new myPoint Point
storage module immutable xInit I64 7
storage module immutable yInit I64 12
fieldSet myPoint x xInit
fieldSet myPoint y yInit
call sumPointCall sumPoint
argument sumPointCall p Point myPoint
run sumPointCall
bind value sumResult I64 sumPointCall
memory main mutable sumVar I64 xInit
set memory sumVar sumResult
call writeCall console.writeIntegerLine
argument writeCall console Console console
argument writeCall value I64 sumVar
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
