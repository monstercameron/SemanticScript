# expect.stdout: 19\n
# expect.exit: 0
# Record-typed user-op parameter: pass a Point by value to sumPoint, which
# reads .x and .y via fieldGet on the param and returns their sum.
project RecordTypedParam
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

record Point layout row align 8
field Point x Int64
field Point y Int64

operation sumPoint
input operation sumPoint p Point
output operation sumPoint Result Int64 Void
memory sumPoint heap no
async sumPoint no
purpose operation sumPoint "Return p.x + p.y. Exercises a record-typed input parameter: callee reads each field via fieldGet directly on the param name."
invariant operation sumPoint "Returns x + y."
label startSumPoint
fieldGet xVal Int64 p x
fieldGet yVal Int64 p y
call addCall math.addInt64
argument addCall left Int64 xVal
argument addCall right Int64 yVal
run addCall
bind value sumRes Int64 addCall
return ok sumRes

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap auto
async main no
purpose operation main "Construct a Point {x:7,y:12} and call sumPoint(p). Expect 19."
invariant operation main "Output is '19\\n'."
label startMain
new myPoint Point
storage module immutable xInit Int64 7
storage module immutable yInit Int64 12
fieldSet myPoint x xInit
fieldSet myPoint y yInit
call sumPointCall sumPoint
argument sumPointCall p Point myPoint
run sumPointCall
bind value sumResult Int64 sumPointCall
memory main mutable sumVar Int64 xInit
set memory sumVar sumResult
call writeCall console.writeIntegerLine
argument writeCall console Console console
argument writeCall value Int64 sumVar
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
