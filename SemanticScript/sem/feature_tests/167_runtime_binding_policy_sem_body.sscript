# expect.stdout: 150\n15\n
# expect.exit: 0
project RuntimeBindingPolicySemanticBody
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError
error RetryPolicyError
errorCase RetryPolicyError DelayComputeFailed
error MetricsWriteError
errorCase MetricsWriteError IncrementFailed

operation delayForAttempt
input operation delayForAttempt policy RetryPolicy
input operation delayForAttempt attemptIndex I64
output operation delayForAttempt Result DurationMilliseconds RetryPolicyError
memory delayForAttempt heap no
async delayForAttempt no
label startDelayForAttempt
storage module immutable oneAttempt I64 1
storage module immutable fiftyMilliseconds I64 50
call ordinalCall math.addI64
argument ordinalCall left I64 attemptIndex
argument ordinalCall right I64 oneAttempt
run ordinalCall
bind value attemptOrdinal I64 ordinalCall
call delayCall math.multiplyI64
argument delayCall left I64 attemptOrdinal
argument delayCall right I64 fiftyMilliseconds
run delayCall
bind value computedDelay DurationMilliseconds delayCall
return ok computedDelay

operation computeIncrementI64
input operation computeIncrementI64 runtime MetricsRuntime
input operation computeIncrementI64 current I64
input operation computeIncrementI64 step I64
output operation computeIncrementI64 Result I64 MetricsWriteError
memory computeIncrementI64 heap no
async computeIncrementI64 no
label startComputeIncrement
call incrementCall math.addI64
argument incrementCall left I64 current
argument incrementCall right I64 step
run incrementCall
bind value computedIncrement I64 incrementCall
return ok computedIncrement

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
label startMain
storage module immutable policyHandle RetryPolicy 0
storage module immutable attemptTwo I64 2
call demoDelayCall delayForAttempt
argument demoDelayCall policy RetryPolicy policyHandle
argument demoDelayCall attemptIndex I64 attemptTwo
run demoDelayCall
bind ok delayResult DurationMilliseconds demoDelayCall
call printDelayCall console.writeIntegerLine
argument printDelayCall console Console console
argument printDelayCall value I64 delayResult
run printDelayCall
ignore void source printDelayCall
storage module immutable runtimeHandle MetricsRuntime 0
storage module immutable tenValue I64 10
storage module immutable fiveValue I64 5
call demoIncrementCall computeIncrementI64
argument demoIncrementCall runtime MetricsRuntime runtimeHandle
argument demoIncrementCall current I64 tenValue
argument demoIncrementCall step I64 fiveValue
run demoIncrementCall
bind ok incrementResult I64 demoIncrementCall
call printIncrementCall console.writeIntegerLine
argument printIncrementCall console Console console
argument printIncrementCall value I64 incrementResult
run printIncrementCall
ignore void source printIncrementCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
