# expect.stdout: a=1 b=2 c=3 d=4 e=5\n
# expect.exit: 0
project CPrintfSixArgs
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap auto
async main no
purpose operation main "Exercise c.printf with 6 args (format + 5 trailing i64 binds). Probes whether backend dispatches 6-arg c.printf through the PlusFive emitter rather than falling to UNHANDLED."
invariant operation main "Output is 'a=1 b=2 c=3 d=4 e=5\\n'."
label startMain
storage module immutable triggerSize ByteCount 1
call walkerTriggerCall c.malloc
argument walkerTriggerCall size ByteCount triggerSize
run walkerTriggerCall
bind value triggerBuffer OpaquePointer walkerTriggerCall

storage module immutable sixFormat String "a=%lld b=%lld c=%lld d=%lld e=%lld\n"
storage module immutable oneVal Int64 1
storage module immutable twoVal Int64 2
storage module immutable threeVal Int64 3
storage module immutable fourVal Int64 4
storage module immutable fiveVal Int64 5

# Promote each constant to a bind via a no-op user op, so each arg is a bind
# (matches the PlusFive emitter's bind-only operand expectation).
call promoteOneCall identityInt64
argument promoteOneCall n Int64 oneVal
run promoteOneCall
bind ok oneBind Int64 promoteOneCall

call promoteTwoCall identityInt64
argument promoteTwoCall n Int64 twoVal
run promoteTwoCall
bind ok twoBind Int64 promoteTwoCall

call promoteThreeCall identityInt64
argument promoteThreeCall n Int64 threeVal
run promoteThreeCall
bind ok threeBind Int64 promoteThreeCall

call promoteFourCall identityInt64
argument promoteFourCall n Int64 fourVal
run promoteFourCall
bind ok fourBind Int64 promoteFourCall

call promoteFiveCall identityInt64
argument promoteFiveCall n Int64 fiveVal
run promoteFiveCall
bind ok fiveBind Int64 promoteFiveCall

call sixPrintfCall c.printf
argument sixPrintfCall format String sixFormat
argument sixPrintfCall a Int64 oneBind
argument sixPrintfCall b Int64 twoBind
argument sixPrintfCall c Int64 threeBind
argument sixPrintfCall d Int64 fourBind
argument sixPrintfCall e Int64 fiveBind
run sixPrintfCall
ignore ok source sixPrintfCall type Int32

call freeCall c.free
argument freeCall ptr OpaquePointer triggerBuffer
run freeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode

operation identityInt64
input operation identityInt64 n Int64
output operation identityInt64 Result Int64 Void
memory identityInt64 heap no
async identityInt64 no
purpose operation identityInt64 "Return the input unchanged. Used to promote a const to a bind so subsequent operand dispatches treat it as a bind."
invariant operation identityInt64 "Returns n."
label startIdentityInt64
return ok n
