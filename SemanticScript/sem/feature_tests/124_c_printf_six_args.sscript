# expect.stdout: a=1 b=2 c=3 d=4 e=5\n
# expect.exit: 0
project CPrintfSixArgs
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder CSignedInt32

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap auto
async main no
purpose operation main "Exercise c.printf with 6 args (format + 5 trailing i64 binds). Probes whether backend dispatches 6-arg c.printf through the PlusFive emitter rather than falling to UNHANDLED."
invariant operation main "Output is 'a=1 b=2 c=3 d=4 e=5\\n'."
label startMain
storage module immutable triggerSize CByteCount 1
call walkerTriggerCall c.malloc
argument walkerTriggerCall size CByteCount triggerSize
run walkerTriggerCall
bind value triggerBuffer COpaqueMemoryAddress walkerTriggerCall

storage module immutable sixFormat CNullTerminatedByteString "a=%lld b=%lld c=%lld d=%lld e=%lld\n"
storage module immutable oneVal CSignedInt64 1
storage module immutable twoVal CSignedInt64 2
storage module immutable threeVal CSignedInt64 3
storage module immutable fourVal CSignedInt64 4
storage module immutable fiveVal CSignedInt64 5

# Promote each constant to a bind via a no-op user op, so each arg is a bind
# (matches the PlusFive emitter's bind-only operand expectation).
call promoteOneCall identityI64
argument promoteOneCall n CSignedInt64 oneVal
run promoteOneCall
bind ok oneBind CSignedInt64 promoteOneCall

call promoteTwoCall identityI64
argument promoteTwoCall n CSignedInt64 twoVal
run promoteTwoCall
bind ok twoBind CSignedInt64 promoteTwoCall

call promoteThreeCall identityI64
argument promoteThreeCall n CSignedInt64 threeVal
run promoteThreeCall
bind ok threeBind CSignedInt64 promoteThreeCall

call promoteFourCall identityI64
argument promoteFourCall n CSignedInt64 fourVal
run promoteFourCall
bind ok fourBind CSignedInt64 promoteFourCall

call promoteFiveCall identityI64
argument promoteFiveCall n CSignedInt64 fiveVal
run promoteFiveCall
bind ok fiveBind CSignedInt64 promoteFiveCall

call sixPrintfCall c.printf
argument sixPrintfCall format CNullTerminatedByteString sixFormat
argument sixPrintfCall a CSignedInt64 oneBind
argument sixPrintfCall b CSignedInt64 twoBind
argument sixPrintfCall c CSignedInt64 threeBind
argument sixPrintfCall d CSignedInt64 fourBind
argument sixPrintfCall e CSignedInt64 fiveBind
run sixPrintfCall
ignore ok source sixPrintfCall type CSignedInt32

call freeCall c.free
argument freeCall ptr COpaqueMemoryAddress triggerBuffer
run freeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode

operation identityI64
input operation identityI64 n CSignedInt64
output operation identityI64 Result CSignedInt64 Void
memory identityI64 heap no
async identityI64 no
purpose operation identityI64 "Return the input unchanged. Used to promote a const to a bind so subsequent operand dispatches treat it as a bind."
invariant operation identityI64 "Returns n."
label startIdentityI64
return ok n
