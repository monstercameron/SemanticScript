# expect.stdout: 42\n
# expect.exit: 0
languageMode permissiveExecutable
project JsonStringifyI64Primitive
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError EncodeFailed CSignedInt32
errorCase MainError ConsoleWriteFailed CSignedInt32
operation main
input main console Console
output main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose main "json.stringify.I64 formats an integer to its JSON decimal string."
invariant main "Output is the JSON representation of 42, exactly the string 42."
label startMain
const fortyTwoValue I64 42
call stringifyIntCall json.stringify.I64
arg stringifyIntCall value fortyTwoValue
run stringifyIntCall
bindOk encodedString JsonText stringifyIntCall
bindError encodeError JsonEncodeError stringifyIntCall
branchIfError stringifyIntCall encodeFailed
call writeResultCall console.writeLine
arg writeResultCall console console
arg writeResultCall text encodedString
run writeResultCall
ignoreOk writeResultCall Void
bindError writeError ConsoleWriteError writeResultCall
branchIfError writeResultCall consoleWriteFailed
const successfulExitCode ExitCode 0
returnOk successfulExitCode
label encodeFailed
makeError encodeFailure MainError.EncodeFailed encodeError
returnError encodeFailure
label consoleWriteFailed
makeError writeFailure MainError.ConsoleWriteFailed writeError
returnError writeFailure
