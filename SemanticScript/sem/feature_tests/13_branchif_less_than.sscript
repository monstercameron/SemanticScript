# expect.stdout: less\n
# expect.exit: 0
project BranchIfLessThan
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "math.lessThanI64 + branchIf picks the less branch."
invariant operation main "3 < 7 evaluates true."
label startMain
storage module immutable threeInitial I64 3
storage module immutable sevenCompare I64 7
memory main mutable leftOp I64 threeInitial
call ltCall math.lessThanI64
argument ltCall left I64 leftOp
argument ltCall right I64 sevenCompare
run ltCall
bind value isLessThan Bool ltCall
branch if condition isLessThan target lessLabel
branch else target greaterEqualLabel
label lessLabel
storage module immutable lessText CNullTerminatedByteString "less"
call writeLessCall console.writeLine
argument writeLessCall console Console console
argument writeLessCall text CNullTerminatedByteString lessText
run writeLessCall
ignore void source writeLessCall
jump target endLabel
label greaterEqualLabel
storage module immutable geText CNullTerminatedByteString "ge"
call writeGeCall console.writeLine
argument writeGeCall console Console console
argument writeGeCall text CNullTerminatedByteString geText
run writeGeCall
ignore void source writeGeCall
jump target endLabel
label endLabel
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
