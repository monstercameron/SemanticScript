# expect.stdout: less\n
# expect.exit: 0
project BranchIfLessThan
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "math.lessThanInt64 + branchIf picks the less branch."
invariant operation main "3 < 7 evaluates true."
label startMain
storage module immutable threeInitial Int64 3
storage module immutable sevenCompare Int64 7
memory main mutable leftOp Int64 threeInitial
call ltCall math.lessThanInt64
argument ltCall left Int64 leftOp
argument ltCall right Int64 sevenCompare
run ltCall
bind value isLessThan Bool ltCall
branch if condition isLessThan target lessLabel
branch else target greaterEqualLabel
label lessLabel
storage module immutable lessText String "less"
call writeLessCall console.writeLine
argument writeLessCall console Console console
argument writeLessCall text String lessText
run writeLessCall
ignore void source writeLessCall
jump target endLabel
label greaterEqualLabel
storage module immutable geText String "ge"
call writeGeCall console.writeLine
argument writeGeCall console Console console
argument writeGeCall text String geText
run writeGeCall
ignore void source writeGeCall
jump target endLabel
label endLabel
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
