# expect.stdout: val=42\n
# expect.exit: 0
project CSnprintfTest
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder CSignedInt32
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main read memory.buffer
effect main write memory.buffer
effect main write console.stdout
memory main heap auto
async main no
purpose operation main "Format an integer into a heap buffer via c.snprintf, then print the buffer via c.puts. Exercises 4-arg snprintf with all const args."
invariant operation main "Output is 'val=42\\n'."
label startMain
storage module immutable bufferCap CByteCount 32
storage module immutable fmtString CNullTerminatedByteString "val=%lld"
storage module immutable fortyTwo CSignedInt64 42
call mallocCall c.malloc
argument mallocCall size CByteCount bufferCap
run mallocCall
bind value targetBuffer COpaqueMemoryAddress mallocCall

call snprCall c.snprintf
argument snprCall buffer COpaqueMemoryAddress targetBuffer
argument snprCall size CByteCount bufferCap
argument snprCall format CNullTerminatedByteString fmtString
argument snprCall value CSignedInt64 fortyTwo
run snprCall
ignore ok source snprCall type CSignedInt32

call putsCall c.puts
argument putsCall text COpaqueMemoryAddress targetBuffer
run putsCall
ignore ok source putsCall type CSignedInt32

call freeCall c.free
argument freeCall ptr COpaqueMemoryAddress targetBuffer
run freeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
