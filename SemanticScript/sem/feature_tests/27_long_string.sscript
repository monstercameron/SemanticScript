# expect.stdout: The quick brown fox jumps over the lazy dog.\n
# expect.exit: 0
project LongString
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Long string literal with spaces and punctuation."
invariant operation main "Output is the literal verbatim plus newline."
label startMain
storage module immutable pangramText String "The quick brown fox jumps over the lazy dog."
call writeCall console.writeLine
argument writeCall console Console console
argument writeCall text String pangramText
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
