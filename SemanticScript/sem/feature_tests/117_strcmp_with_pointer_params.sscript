# expect.stdout: 0\n
# expect.exit: 0
project TwoPtrParams
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32

operation cmpStrs
input operation cmpStrs left String
input operation cmpStrs right String
output operation cmpStrs Result Int64 Void
purpose operation cmpStrs "Compare two strings via c.strcmp; return the result as i64."
label startCmp
call cmpCall c.strcmp
argument cmpCall left String left
argument cmpCall right String right
run cmpCall
bind value cmpResult Int64 cmpCall
return ok cmpResult

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
label startMain
storage module immutable a String "hello"
storage module immutable b String "hello"
call doCmp cmpStrs
argument doCmp left String a
argument doCmp right String b
run doCmp
bind ok cmpVal Int64 doCmp
memory main mutable displayStore Int64 0
set memory displayStore cmpVal
call w console.writeIntegerLine
argument w console Console console
argument w value Int64 displayStore
run w
ignore void source w
storage module immutable okExit ExitCode 0
return ok okExit
