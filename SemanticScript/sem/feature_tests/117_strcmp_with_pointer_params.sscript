# expect.stdout: 0\n
# expect.exit: 0
project TwoPtrParams
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder CSignedInt32

operation cmpStrs
input operation cmpStrs left CNullTerminatedByteString
input operation cmpStrs right CNullTerminatedByteString
output operation cmpStrs Result CSignedInt64 Void
purpose operation cmpStrs "Compare two strings via c.strcmp; return the result as i64."
label startCmp
call cmpCall c.strcmp
argument cmpCall left CNullTerminatedByteString left
argument cmpCall right CNullTerminatedByteString right
run cmpCall
bind value cmpResult CSignedInt64 cmpCall
return ok cmpResult

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
label startMain
storage module immutable a CNullTerminatedByteString "hello"
storage module immutable b CNullTerminatedByteString "hello"
call doCmp cmpStrs
argument doCmp left CNullTerminatedByteString a
argument doCmp right CNullTerminatedByteString b
run doCmp
bind ok cmpVal CSignedInt64 doCmp
memory main mutable displayStore I64 0
set memory displayStore cmpVal
call w console.writeIntegerLine
argument w console Console console
argument w value I64 displayStore
run w
ignore void source w
storage module immutable okExit ExitCode 0
return ok okExit
