# expect.stdout: ok\n
# expect.exit: 0
project ConstStringPointerReturn
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32

operation getOkLabel
output operation getOkLabel Result String Void
memory getOkLabel heap no
async getOkLabel no
purpose operation getOkLabel "Return a fixed string-const. Exercises pointer-returning user-op signature plus returnOk-of-string-const path that emits `ret i8* getelementptr inbounds`."
invariant operation getOkLabel "Used by main to print the returned message."
label startGetOkLabel
storage module immutable okMessage String "ok"
return ok okMessage

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Print the first byte of the message returned by the pointer-returning user op getOkLabel via c.putchar, plus a 'k' and newline."
invariant operation main "Uses c.putchar so the walker fires (the legacy string-replay path skips user-op definitions)."
label startMain
call getMessageCall getOkLabel
run getMessageCall
bind ok theMessage String getMessageCall
storage module immutable zeroByteIndex Int64 0
call firstByteCall pointer.loadByte
argument firstByteCall buffer String theMessage
argument firstByteCall offset Int64 zeroByteIndex
run firstByteCall
bind value firstByteValue Int8 firstByteCall
call writeFirstCall c.putchar
argument writeFirstCall c Int8 firstByteValue
run writeFirstCall
storage module immutable oneByteIndex Int64 1
call secondByteCall pointer.loadByte
argument secondByteCall buffer String theMessage
argument secondByteCall offset Int64 oneByteIndex
run secondByteCall
bind value secondByteValue Int8 secondByteCall
call writeSecondCall c.putchar
argument writeSecondCall c Int8 secondByteValue
run writeSecondCall
storage module immutable newlineByte Int32 10
call writeNewlineCall c.putchar
argument writeNewlineCall c Int32 newlineByte
run writeNewlineCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
