# expect.stdout: 1\n
# expect.exit: 0
project ModuloPrint
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "math.moduloInt64: 10 % 3 = 1."
invariant operation main "Modulo emits correct srem-based remainder."
label startMain
storage module immutable tenInitial Int64 10
storage module immutable threeDivisor Int64 3
memory main mutable counter Int64 tenInitial
call modCall math.moduloInt64
argument modCall left Int64 counter
argument modCall right Int64 threeDivisor
run modCall
bind value remainderResult Int64 modCall
memory main mutable remainderVar Int64 tenInitial
set memory remainderVar remainderResult
call writeCall console.writeIntegerLine
argument writeCall console Console console
argument writeCall value Int64 remainderVar
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
