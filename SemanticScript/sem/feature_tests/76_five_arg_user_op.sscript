# expect.stdout: 12\n
# expect.exit: 0
project FiveArgUserOp
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder CSignedInt32

operation sumFive
input operation sumFive a CSignedInt64
input operation sumFive b CSignedInt64
input operation sumFive c CSignedInt64
input operation sumFive d CSignedInt64
input operation sumFive e CSignedInt64
output operation sumFive Result CSignedInt64 Void
memory sumFive heap no
async sumFive no
