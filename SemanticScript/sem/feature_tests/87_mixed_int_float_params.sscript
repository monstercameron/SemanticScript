# expect.stdout: 6.500000\n
# expect.exit: 0
project MixedIntFloatParams
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder CSignedInt32

operation scaleByInt
input operation scaleByInt baseValue CFloat64
input operation scaleByInt multiplier CSignedInt64
output operation scaleByInt Result CFloat64 Void
memory scaleByInt heap no
async scaleByInt no
purpose operation scaleByInt "Convert the i64 multiplier to a CFloat64 and multiply baseValue by it. Exercises a user op whose first param is float, second is int, and which mixes math.intToFloat with math.multiplyF64."
invariant operation scaleByInt "Returns baseValue * (CFloat64) multiplier."
label startScaleByInt
call multiplierAsFloatCall math.intToFloat
argument multiplierAsFloatCall value CSignedInt64 multiplier
run multiplierAsFloatCall
bind value multiplierAsFloat CFloat64 multiplierAsFloatCall
call productCall math.multiplyF64
argument productCall left CFloat64 baseValue
argument productCall right CFloat64 multiplierAsFloat
run productCall
bind value scaledResult CFloat64 productCall
return ok scaledResult

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "scaleByInt(3.25, 2) == 6.5. Mixed-typed user-op signature."
invariant operation main "Output is 6.500000."
label startMain
storage module immutable baseValue CFloat64 3.25
storage module immutable multiplierValue CSignedInt64 2
call scaleCall scaleByInt
argument scaleCall baseValue CFloat64 baseValue
argument scaleCall multiplier CSignedInt64 multiplierValue
run scaleCall
bind ok scaledOutcome CFloat64 scaleCall
call writeCall console.writeFloatLine
argument writeCall console Console console
argument writeCall value CFloat64 scaledOutcome
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
