# expect.stdout: l\n
# expect.exit: 0
project ChainedPointerOffset
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder CSignedInt32
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main read memory.buffer
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Apply pointer.offset twice (1 byte then 1 more byte) to reach index 2 ('l') of 'hello' and print it."
invariant operation main "Exercises pointer.offset where the BASE is itself a bind from a prior pointer.offset."
label startMain
storage module immutable greeting CNullTerminatedByteString "hello"
storage module immutable oneStep I64 1
call shiftOnceCall pointer.offset
argument shiftOnceCall base CNullTerminatedByteString greeting
argument shiftOnceCall offset I64 oneStep
run shiftOnceCall
bind value oneShifted COpaqueMemoryAddress shiftOnceCall
call shiftTwiceCall pointer.offset
argument shiftTwiceCall base COpaqueMemoryAddress oneShifted
argument shiftTwiceCall offset I64 oneStep
run shiftTwiceCall
bind value twoShifted COpaqueMemoryAddress shiftTwiceCall
storage module immutable zeroOffset I64 0
call loadCall pointer.loadByte
argument loadCall buffer COpaqueMemoryAddress twoShifted
argument loadCall offset I64 zeroOffset
run loadCall
bind value byteValue I8 loadCall
call writeByteCall c.putchar
argument writeByteCall c I8 byteValue
run writeByteCall
storage module immutable newlineByte CSignedInt32 10
call writeNewlineCall c.putchar
argument writeNewlineCall c CSignedInt32 newlineByte
run writeNewlineCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
