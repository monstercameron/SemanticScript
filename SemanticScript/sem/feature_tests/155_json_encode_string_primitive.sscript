# expect.stdout: "hello"\n
# expect.exit: 0
languageMode permissiveExecutable
project JsonStringifyStringPrimitive
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError EncodeFailed CSignedInt32
errorCase MainError ConsoleWriteFailed CSignedInt32
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "json.stringify.String wraps an ASCII string in JSON double-quotes."
invariant operation main "Output is exactly the source string surrounded by quotes."
label startMain
storage module immutable helloPayload CNullTerminatedByteString "hello"
call stringifyStringCall json.stringify.String
argument stringifyStringCall value CNullTerminatedByteString helloPayload
run stringifyStringCall
bind ok encodedJsonString JsonText stringifyStringCall
bind error encodeError JsonEncodeError stringifyStringCall
branch error source stringifyStringCall target encodeFailed
call writeEncodedCall console.writeLine
argument writeEncodedCall console Console console
argument writeEncodedCall text JsonText encodedJsonString
run writeEncodedCall
ignore void source writeEncodedCall
bind error writeError ConsoleWriteError writeEncodedCall
branch error source writeEncodedCall target consoleWriteFailed
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
label encodeFailed
makeError encodeFailure MainError.EncodeFailed encodeError
return error encodeFailure
label consoleWriteFailed
makeError writeFailure MainError.ConsoleWriteFailed writeError
return error writeFailure
