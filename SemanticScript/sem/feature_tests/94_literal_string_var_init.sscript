# expect.stdout: hi\n
# expect.exit: 0
project LiteralStringVarInit
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main read memory.buffer
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Declare a var with a literal-string init `var greeting String \"hi\"` and print it via c.puts. Exercises pass1 string-const slot allocation for var literal inits."
invariant operation main "Output is 'hi\\n'. No supporting const declaration is needed."
label startMain
memory main mutable greeting String "hi"
call putsCall c.puts
argument putsCall text String greeting
run putsCall
ignore ok source putsCall type Int32
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
