# expect.stdout: 0\n
# expect.exit: 0
project RefinedStrcmpRuntime
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

# Inline a minimal refined-syntax operation definition: compareCString is
# declared as a runtimeBinding to runtime.cstring.compare, which semsc.py
# now lowers to a real `call i32 @strcmp(...)` body. This test verifies
# that the wired binding actually executes strcmp at runtime, not just
# the compile-time stub.

error CStringCompareError
errorCase CStringCompareError InvalidCStringInput
errorCase CStringCompareError RuntimeCompareFailed

operation compareCString
input operation compareCString left String
input operation compareCString right String
output operation compareCString Result Int32 CStringCompareError
effect compareCString read left
effect compareCString read right
memory compareCString heap no
async compareCString no
operationBody compareCString runtimeBinding
purpose operation compareCString "Compare two null-terminated byte strings (strcmp wrapper via refined-syntax runtimeBinding)."
runtimeBinding compareCString runtime.cstring.compare

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Call compareCString with two identical strings and print the strcmp result (expected 0)."
invariant operation main "Output is '0\\n'."
label startMain
storage module immutable leftText String "agent"
storage module immutable rightText String "agent"
call cmpCall compareCString
argument cmpCall left String leftText
argument cmpCall right String rightText
run cmpCall
bind ok cmpResult Int32 cmpCall
memory main mutable cmpVar Int64 0
set memory cmpVar cmpResult
call writeCall console.writeIntegerLine
argument writeCall console Console console
argument writeCall value Int64 cmpVar
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
