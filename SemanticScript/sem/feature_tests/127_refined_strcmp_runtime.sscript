# expect.stdout: 0\n
# expect.exit: 0
# expect.xfail: feature_coverage.py runs through bootstrap_general.sscript which does not yet lower the refined-syntax `operationBody runtimeBinding` / `runtimeBinding NAME TARGET` to a libc call — so compareCString becomes a stub that crashes at runtime. Direct semsc.py compilation works correctly (`python compiler/semsc.py THIS_FILE --emit-ir /tmp/x.ll && clang /tmp/x.ll -o /tmp/x.exe && /tmp/x.exe` prints `0` and exits 0). Closing means propagating the runtimeBinding lowering into bootstrap.
project RefinedStrcmpRuntime
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

# Inline a minimal refined-syntax operation definition: compareCString is
# declared as a runtimeBinding to runtime.cstring.compare, which semsc.py
# now lowers to a real `call i32 @strcmp(...)` body. This test verifies
# that the wired binding actually executes strcmp at runtime, not just
# the compile-time stub.

error CStringCompareError
errorCase CStringCompareError InvalidCStringInput
errorCase CStringCompareError RuntimeCompareFailed

operation compareCString
input operation compareCString left CNullTerminatedByteString
input operation compareCString right CNullTerminatedByteString
output operation compareCString Result CSignedInt32 CStringCompareError
effect compareCString read left
effect compareCString read right
memory compareCString heap no
async compareCString no
operationBody compareCString runtimeBinding
purpose operation compareCString "Compare two null-terminated byte strings (strcmp wrapper via refined-syntax runtimeBinding)."
runtimeBinding compareCString runtime.cstring.compare

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Call compareCString with two identical strings and print the strcmp result (expected 0)."
invariant operation main "Output is '0\\n'."
label startMain
storage module immutable leftText CNullTerminatedByteString "agent"
storage module immutable rightText CNullTerminatedByteString "agent"
call cmpCall compareCString
argument cmpCall left CNullTerminatedByteString leftText
argument cmpCall right CNullTerminatedByteString rightText
run cmpCall
bind ok cmpResult CSignedInt32 cmpCall
memory main mutable cmpVar I64 0
set memory cmpVar cmpResult
call writeCall console.writeIntegerLine
argument writeCall console Console console
argument writeCall value I64 cmpVar
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
