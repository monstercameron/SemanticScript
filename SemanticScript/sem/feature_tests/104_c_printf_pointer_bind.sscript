# expect.stdout: msg=val=99\n
# expect.exit: 0
project CPrintfPointerBindTest
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder CSignedInt32
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main read memory.buffer
effect main write memory.buffer
effect main write console.stdout
memory main heap auto
async main no
purpose operation main "Pass a pointer-typed bind (i8*) as the %s arg to c.printf. Exercises the new pointer-bind path in emitCprintfPlusBind: the emitter must classify the bind as pointer and emit `i8* %arg` instead of `i64 %arg`."
invariant operation main "Output is 'msg=val=99\\n'."
label startMain
storage module immutable bufferCap CByteCount 32
storage module immutable formatString CNullTerminatedByteString "val=%lld"
storage module immutable finalFormat CNullTerminatedByteString "msg=%s\n"
storage module immutable ninetyNine CSignedInt64 99
call mallocCall c.malloc
argument mallocCall size CByteCount bufferCap
run mallocCall
bind value heapBuffer COpaqueMemoryAddress mallocCall

call snprCall c.snprintf
argument snprCall buffer COpaqueMemoryAddress heapBuffer
argument snprCall size CByteCount bufferCap
argument snprCall format CNullTerminatedByteString formatString
argument snprCall value CSignedInt64 ninetyNine
run snprCall
ignore ok source snprCall type CSignedInt32

call printCall c.printf
argument printCall format CNullTerminatedByteString finalFormat
argument printCall value COpaqueMemoryAddress heapBuffer
run printCall
ignore ok source printCall type CSignedInt32

call freeCall c.free
argument freeCall ptr COpaqueMemoryAddress heapBuffer
run freeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
