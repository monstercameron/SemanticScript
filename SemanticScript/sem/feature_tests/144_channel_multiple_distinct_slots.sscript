# expect.stdout: 11\n22\n
# expect.exit: 0
project ChannelMultipleDistinctSlots
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder CSignedInt32
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Two distinct channels do not share storage."
invariant operation main "channelAlpha carries 11, channelBeta carries 22; reads of each see their own value."
label startMain
storage module immutable elevenValue I64 11
storage module immutable twentyTwoValue I64 22
send channelAlpha elevenValue
send channelBeta twentyTwoValue
receive receivedFromAlpha I64 channelAlpha
receive receivedFromBeta I64 channelBeta
call writeFirstCall console.writeIntegerLine
argument writeFirstCall console Console console
argument writeFirstCall value I64 receivedFromAlpha
run writeFirstCall
ignore void source writeFirstCall
call writeSecondCall console.writeIntegerLine
argument writeSecondCall console Console console
argument writeSecondCall value I64 receivedFromBeta
run writeSecondCall
ignore void source writeSecondCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
