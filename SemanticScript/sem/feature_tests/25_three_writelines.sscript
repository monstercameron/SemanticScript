# expect.stdout: first\nsecond\nthird\n
# expect.exit: 0
project ThreeWriteLines
target console
runtime AgentRuntime 0.1
mode capturedOutputReplay
entry console main
error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Three writeLine calls with three distinct string consts."
invariant operation main "Order matches source."
label startMain
storage module immutable firstText String "first"
storage module immutable secondText String "second"
storage module immutable thirdText String "third"
call writeFirstCall console.writeLine
argument writeFirstCall console Console console
argument writeFirstCall text String firstText
run writeFirstCall
ignore void source writeFirstCall
call writeSecondCall console.writeLine
argument writeSecondCall console Console console
argument writeSecondCall text String secondText
run writeSecondCall
ignore void source writeSecondCall
call writeThirdCall console.writeLine
argument writeThirdCall console Console console
argument writeThirdCall text String thirdText
run writeThirdCall
ignore void source writeThirdCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
