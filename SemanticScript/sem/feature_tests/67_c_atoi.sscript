# expect.stdout: 12345\n
# expect.exit: 0
project CAtoiTest
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main read memory.buffer
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Parse a numeric string literal via c.atoi and echo it back through console.writeIntegerLine."
invariant operation main "Exercises the c.atoi libc passthrough with a string-const buffer."
label startMain
storage module immutable numericText String "12345"
call parseCall c.atoi
argument parseCall s String numericText
run parseCall
bind value parsedValue Int32 parseCall
memory main mutable parsedStorage Int64 0
set memory parsedStorage parsedValue
call writeCall console.writeIntegerLine
argument writeCall console Console console
argument writeCall value Int64 parsedStorage
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
