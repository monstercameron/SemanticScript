# expect.stdout: counter=42\n
# expect.exit: 0
project CPrintfTwoArgVarTest
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main read memory.buffer
effect main write console.stdout
memory main heap auto
async main no
purpose operation main "Exercise 2-arg c.printf where the trailing arg is a *var* (alloca). The emitter must emit a `load` before the call and reference the loaded SSA name."
invariant operation main "Output is 'counter=42\\n'."
label startMain
storage module immutable triggerSize ByteCount 1
call walkerTriggerCall c.malloc
argument walkerTriggerCall size ByteCount triggerSize
run walkerTriggerCall
bind value walkerTriggerBuffer OpaquePointer walkerTriggerCall

storage module immutable fortyTwo Int64 42
memory main mutable counterStorage Int64 0
set memory counterStorage fortyTwo

storage module immutable formatStr String "counter=%lld\n"
call printCall c.printf
argument printCall format String formatStr
argument printCall value Int64 counterStorage
run printCall
ignore ok source printCall type Int32

call freeCall c.free
argument freeCall ptr OpaquePointer walkerTriggerBuffer
run freeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
