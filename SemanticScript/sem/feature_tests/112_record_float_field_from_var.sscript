# expect.stdout: 7.500000\n
# expect.exit: 0
project RecordFloatFromVar
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32

record Sample layout row align 8
purpose operation Sample "A single Float64 measurement."
field Sample value Float64

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Build value via float var + math.addFloat64, then fieldSet from the float var."
invariant operation main "5.0 + 2.5 = 7.5, stored in Sample.value, read back, printed."
label startMain
storage module immutable fiveF Float64 5.0
storage module immutable twoAndHalfF Float64 2.5
memory main mutable liveF Float64 fiveF
call addCall math.addFloat64
argument addCall left Float64 liveF
argument addCall right Float64 twoAndHalfF
run addCall
bind value sumF Float64 addCall
set memory liveF sumF
new mySample Sample
fieldSet mySample value liveF
fieldGet finalF Float64 mySample value
call writeCall console.writeFloatLine
argument writeCall console Console console
argument writeCall value Float64 finalF
run writeCall
ignore void source writeCall
storage module immutable okExit ExitCode 0
return ok okExit
