# expect.stdout: 0\n
# expect.exit: 0
project CStrcmpEqual
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main read memory.buffer
effect main write console.stdout
memory main heap no
async main no
purpose operation main "c.strcmp of two identical strings returns 0."
invariant operation main "Tests c.strcmp passthrough."
label startMain
storage module immutable leftText String "hello"
storage module immutable rightText String "hello"
call cmpCall c.strcmp
argument cmpCall left String leftText
argument cmpCall right String rightText
run cmpCall
bind value cmpResult Int32 cmpCall
memory main mutable cmpVar Int64 0
set memory cmpVar cmpResult
call writeCall console.writeIntegerLine
argument writeCall console Console console
argument writeCall value Int64 cmpVar
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
