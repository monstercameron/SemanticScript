# expect.stdout: 6\n
# expect.exit: 0
project TwoParamGcd
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder CSignedInt32

operation gcdOf
input operation gcdOf a CSignedInt64
input operation gcdOf b CSignedInt64
output operation gcdOf Result CSignedInt64 Void
memory gcdOf heap no
async gcdOf no
purpose operation gcdOf "Euclidean GCD: if b == 0, a; else gcdOf(b, a mod b)."
invariant operation gcdOf "Terminates when b reaches zero."
label startGcdOf
storage module immutable zeroLit I64 0
call atBaseCall math.equalI64
argument atBaseCall left CSignedInt64 b
argument atBaseCall right I64 zeroLit
run atBaseCall
bind value atBase Bool atBaseCall
branch if condition atBase target gcdBase
branch else target gcdRecurse
label gcdBase
return ok a
label gcdRecurse
call modCall math.moduloI64
argument modCall left CSignedInt64 a
argument modCall right CSignedInt64 b
run modCall
bind value remainder I64 modCall
call recCall gcdOf
argument recCall a CSignedInt64 b
argument recCall b CSignedInt64 remainder
run recCall
bind ok recResult I64 recCall
return ok recResult

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "gcdOf(48, 18) = 6."
invariant operation main "Two-param recursion."
label startMain
storage module immutable fortyEightInitial I64 48
storage module immutable eighteenInitial I64 18
memory main mutable aValue I64 fortyEightInitial
memory main mutable bValue I64 eighteenInitial
call gcdCall gcdOf
argument gcdCall a CSignedInt64 aValue
argument gcdCall b CSignedInt64 bValue
run gcdCall
bind ok gcdResult I64 gcdCall
memory main mutable outputVar I64 fortyEightInitial
set memory outputVar gcdResult
call writeCall console.writeIntegerLine
argument writeCall console Console console
argument writeCall value I64 outputVar
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
