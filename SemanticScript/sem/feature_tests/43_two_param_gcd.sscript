# expect.stdout: 6\n
# expect.exit: 0
project TwoParamGcd
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32

operation gcdOf
input operation gcdOf a Int64
input operation gcdOf b Int64
output operation gcdOf Result Int64 Void
memory gcdOf heap no
async gcdOf no
purpose operation gcdOf "Euclidean GCD: if b == 0, a; else gcdOf(b, a mod b)."
invariant operation gcdOf "Terminates when b reaches zero."
label startGcdOf
storage module immutable zeroLit Int64 0
call atBaseCall math.equalInt64
argument atBaseCall left Int64 b
argument atBaseCall right Int64 zeroLit
run atBaseCall
bind value atBase Bool atBaseCall
branch if condition atBase target gcdBase
branch else target gcdRecurse
label gcdBase
return ok a
label gcdRecurse
call modCall math.moduloInt64
argument modCall left Int64 a
argument modCall right Int64 b
run modCall
bind value remainder Int64 modCall
call recCall gcdOf
argument recCall a Int64 b
argument recCall b Int64 remainder
run recCall
bind ok recResult Int64 recCall
return ok recResult

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "gcdOf(48, 18) = 6."
invariant operation main "Two-param recursion."
label startMain
storage module immutable fortyEightInitial Int64 48
storage module immutable eighteenInitial Int64 18
memory main mutable aValue Int64 fortyEightInitial
memory main mutable bValue Int64 eighteenInitial
call gcdCall gcdOf
argument gcdCall a Int64 aValue
argument gcdCall b Int64 bValue
run gcdCall
bind ok gcdResult Int64 gcdCall
memory main mutable outputVar Int64 fortyEightInitial
set memory outputVar gcdResult
call writeCall console.writeIntegerLine
argument writeCall console Console console
argument writeCall value Int64 outputVar
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
