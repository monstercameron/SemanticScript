# expect.stdout: x=10, y=20\n
# expect.exit: 0
project CPrintfThreeArgs
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder CSignedInt32

operation makeTen
output operation makeTen Result CSignedInt64 Void
memory makeTen heap no
async makeTen no
purpose operation makeTen "Return 10 as a bind. Used to make the printf arg a bind rather than const."
invariant operation makeTen "Returns 10."
label startMakeTen
storage module immutable tenValue CSignedInt64 10
return ok tenValue

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main read memory.buffer
effect main write console.stdout
memory main heap auto
async main no
purpose operation main "Exercise c.printf with 3 args: format + 2 i64 args. One arg is a bind, the other is a const."
invariant operation main "Output is 'x=10, y=20\\n'."
label startMain
storage module immutable triggerSize CByteCount 1
call walkerTriggerCall c.malloc
argument walkerTriggerCall size CByteCount triggerSize
run walkerTriggerCall
bind value triggerBuffer COpaqueMemoryAddress walkerTriggerCall

storage module immutable xyFormat CNullTerminatedByteString "x=%lld, y=%lld\n"
storage module immutable twentyValue CSignedInt64 20

call makeTenCall makeTen
run makeTenCall
bind ok xValue CSignedInt64 makeTenCall

call printfCall c.printf
argument printfCall format CNullTerminatedByteString xyFormat
argument printfCall first CSignedInt64 xValue
argument printfCall second CSignedInt64 twentyValue
run printfCall
ignore ok source printfCall type CSignedInt32

call freeCall c.free
argument freeCall ptr COpaqueMemoryAddress triggerBuffer
run freeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
