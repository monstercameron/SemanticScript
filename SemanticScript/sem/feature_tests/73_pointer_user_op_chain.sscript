# expect.stdout: 5\n
# expect.exit: 0
project PointerUserOpChain
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32

operation skipFirstCharacter
input operation skipFirstCharacter buffer String
output operation skipFirstCharacter Result String Void
memory skipFirstCharacter heap no
async skipFirstCharacter no
purpose operation skipFirstCharacter "Return a pointer to the second byte of `buffer` (skip one byte forward)."
invariant operation skipFirstCharacter "Used to demonstrate that pointer-returning user ops chain — `c.strlen(skipFirstCharacter(s))` should compute strlen(s) - 1 for non-empty input."
label startSkipFirstCharacter
storage module immutable oneByte Int64 1
call advanceCall pointer.offset
argument advanceCall base String buffer
argument advanceCall offset Int64 oneByte
run advanceCall
bind value advancedPointer OpaquePointer advanceCall
return ok advancedPointer

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main read memory.buffer
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Take 'shello' (6 chars), skip the first, c.strlen the result == 5. Verifies pointer-returning user op + pointer arg to libc."
invariant operation main "Output is 5."
label startMain
storage module immutable fullText String "shello"
call shortenCall skipFirstCharacter
argument shortenCall buffer String fullText
run shortenCall
bind ok shortenedPointer String shortenCall
call lengthCall c.strlen
argument lengthCall s String shortenedPointer
run lengthCall
bind value measuredLength ByteCount lengthCall
memory main mutable measurementStorage Int64 0
set memory measurementStorage measuredLength
call writeCall console.writeIntegerLine
argument writeCall console Console console
argument writeCall value Int64 measurementStorage
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
