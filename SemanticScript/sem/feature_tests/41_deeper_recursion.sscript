# expect.stdout: 3628800\n
# expect.exit: 0
project DeeperRecursion
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder CSignedInt32

operation factorialOf
input operation factorialOf n CSignedInt64
output operation factorialOf Result CSignedInt64 Void
memory factorialOf heap no
async factorialOf no
purpose operation factorialOf "Recursive factorial — deep call stack at n=10."
invariant operation factorialOf "Tail-style recursion through up to 10 frames."
label startFactorialOf
storage module immutable oneLit I64 1
call atBaseCall math.lessThanOrEqualI64
argument atBaseCall left CSignedInt64 n
argument atBaseCall right I64 oneLit
run atBaseCall
bind value atBase Bool atBaseCall
branch if condition atBase target baseCase
branch else target recursiveCase
label baseCase
return ok oneLit
label recursiveCase
call decCall math.subtractI64
argument decCall left CSignedInt64 n
argument decCall right I64 oneLit
run decCall
bind value decremented I64 decCall
call recCall factorialOf
argument recCall n CSignedInt64 decremented
run recCall
bind ok recResult I64 recCall
call mulCall math.multiplyI64
argument mulCall left CSignedInt64 n
argument mulCall right I64 recResult
run mulCall
bind value multiplied I64 mulCall
return ok multiplied

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Compute factorialOf(10) = 3628800."
invariant operation main "Deeper recursion than test 39."
label startMain
storage module immutable tenInitial I64 10
memory main mutable input I64 tenInitial
call factCall factorialOf
argument factCall n CSignedInt64 input
run factCall
bind ok factResult I64 factCall
memory main mutable outputVar I64 tenInitial
set memory outputVar factResult
call writeCall console.writeIntegerLine
argument writeCall console Console console
argument writeCall value I64 outputVar
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
