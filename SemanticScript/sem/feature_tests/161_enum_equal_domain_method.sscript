# expect.stdout: equal\nnotEqual\n
# expect.exit: 0
# Tests: enum.equal domain-method dispatch.
# `SaveTodosStatus.equal` (repr CSignedInt32) and `ScreenMode.equal`
# (repr CSignedInt64) compile to the matching math.equal* primitive based
# on the enum's declared repr. The compare must produce a real Bool that
# branches at runtime â€” a no-op lowering would fail the equality test
# and print the wrong branch.
project EnumEqualDomainMethod
target console
runtime AgentRuntime 0.1
entry console main

enum SaveTodosStatus repr CSignedInt32
enumCase SaveTodosStatus SaveSucceeded 0
enumCase SaveTodosStatus SaveOpenFailed 1
enumCase SaveTodosStatus SaveWriteFailed 2

enum ScreenMode repr CSignedInt64
enumCase ScreenMode ListMode 0
enumCase ScreenMode EditMode 1

error MainError
errorCase MainError Placeholder CSignedInt32

operation main
input operation main console Console
output operation main Result ExitCode MainError
memory main heap no
async main no
purpose operation main "Verify enum.equal dispatch for both CSignedInt32 and CSignedInt64 reprs."

label startMain
storage local immutable equalText CNullTerminatedByteString "equal"
storage local immutable notEqualText CNullTerminatedByteString "notEqual"
storage local immutable successfulExitCode ExitCode 0

# Both arguments are SaveSucceeded â€” must compare equal via repr-CSignedInt32 path.
call sameStatusCall SaveTodosStatus.equal
argument sameStatusCall left SaveTodosStatus SaveSucceeded
argument sameStatusCall right SaveTodosStatus SaveSucceeded
run sameStatusCall
bind value sameStatusEqual Bool sameStatusCall
branch if condition sameStatusEqual target sameStatusPath
branch else target failSameStatus

label sameStatusPath
call writeEqualCall console.writeLine
argument writeEqualCall console Console console
argument writeEqualCall text CNullTerminatedByteString equalText
run writeEqualCall
ignore value source writeEqualCall type CSignedInt32
jump target checkDifferentMode

label failSameStatus
call writeFailSameCall console.writeLine
argument writeFailSameCall console Console console
argument writeFailSameCall text CNullTerminatedByteString notEqualText
run writeFailSameCall
ignore value source writeFailSameCall type CSignedInt32
return ok successfulExitCode

label checkDifferentMode
# ListMode != EditMode â€” must compare not-equal via repr-CSignedInt64 path.
call differentModeCall ScreenMode.equal
argument differentModeCall left ScreenMode ListMode
argument differentModeCall right ScreenMode EditMode
run differentModeCall
bind value differentModeEqual Bool differentModeCall
branch if condition differentModeEqual target failDifferentMode
call writeNotEqualCall console.writeLine
argument writeNotEqualCall console Console console
argument writeNotEqualCall text CNullTerminatedByteString notEqualText
run writeNotEqualCall
ignore value source writeNotEqualCall type CSignedInt32
return ok successfulExitCode

label failDifferentMode
call writeFailDiffCall console.writeLine
argument writeFailDiffCall console Console console
argument writeFailDiffCall text CNullTerminatedByteString equalText
run writeFailDiffCall
ignore value source writeFailDiffCall type CSignedInt32
return ok successfulExitCode
