# expect.stdout: 3\n2\n1\n
# expect.exit: 0
project LoopCount3to1
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Simple decrement loop 3..1 via var/set/icmp sge/sub."
invariant operation main "Loop terminates when counter falls below 1."
label startMain
storage module immutable startValue Int64 3
storage module immutable lowerBound Int64 1
storage module immutable oneStep Int64 1
memory main mutable counter Int64 startValue
label loopHead
call checkCall math.greaterThanOrEqualInt64
argument checkCall left Int64 counter
argument checkCall right Int64 lowerBound
run checkCall
bind value shouldContinue Bool checkCall
branch if condition shouldContinue target loopBody
branch else target loopExit
label loopBody
call printCall console.writeIntegerLine
argument printCall console Console console
argument printCall value Int64 counter
run printCall
ignore void source printCall
call decCall math.subtractInt64
argument decCall left Int64 counter
argument decCall right Int64 oneStep
run decCall
bind value nextCounter Int64 decCall
set memory counter nextCounter
jump target loopHead
label loopExit
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
