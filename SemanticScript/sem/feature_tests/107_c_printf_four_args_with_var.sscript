# expect.stdout: 7 11 13 17\n
# expect.exit: 0
project CPrintfFourArgsWithVarTest
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main read memory.buffer
effect main write memory.buffer
effect main write console.stdout
memory main heap auto
async main no
purpose operation main "Exercise 4-arg c.printf where the first trailing arg is a *var* (alloca) and the remaining three are binds. The emitter must emit a `load` before the call and reference the loaded SSA name in the operand list."
invariant operation main "Output is '7 11 13 17\\n'."
label startMain
storage module immutable triggerSize ByteCount 1
call walkerTriggerCall c.malloc
argument walkerTriggerCall size ByteCount triggerSize
run walkerTriggerCall
bind value walkerTriggerBuffer OpaquePointer walkerTriggerCall

storage module immutable sevenValue Int64 7
storage module immutable elevenValue Int64 11
storage module immutable thirteenValue Int64 13
storage module immutable seventeenValue Int64 17

# Var for first trailing arg
memory main mutable sevenStorage Int64 0
set memory sevenStorage sevenValue

# Binds for remaining three
call idElevenCall identityInt64
argument idElevenCall input Int64 elevenValue
run idElevenCall
bind value elevenBind Int64 idElevenCall

call idThirteenCall identityInt64
argument idThirteenCall input Int64 thirteenValue
run idThirteenCall
bind value thirteenBind Int64 idThirteenCall

call idSeventeenCall identityInt64
argument idSeventeenCall input Int64 seventeenValue
run idSeventeenCall
bind value seventeenBind Int64 idSeventeenCall

storage module immutable fourArgFormat String "%lld %lld %lld %lld\n"

call printCall c.printf
argument printCall format String fourArgFormat
argument printCall a Int64 sevenStorage
argument printCall b Int64 elevenBind
argument printCall c Int64 thirteenBind
argument printCall d Int64 seventeenBind
run printCall
ignore ok source printCall type Int32

call freeCall c.free
argument freeCall ptr OpaquePointer walkerTriggerBuffer
run freeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode

operation identityInt64
input operation identityInt64 input Int64
output operation identityInt64 Result Int64 Void
purpose operation identityInt64 "Wrap a const integer in a bind."
label startIdentityInt64
return ok input
