# expect.stdout: 7 11 13 17\n
# expect.exit: 0
project CPrintfFourArgsWithVarTest
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder CSignedInt32
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main read memory.buffer
effect main write memory.buffer
effect main write console.stdout
memory main heap auto
async main no
purpose operation main "Exercise 4-arg c.printf where the first trailing arg is a *var* (alloca) and the remaining three are binds. The emitter must emit a `load` before the call and reference the loaded SSA name in the operand list."
invariant operation main "Output is '7 11 13 17\\n'."
label startMain
storage module immutable triggerSize CByteCount 1
call walkerTriggerCall c.malloc
argument walkerTriggerCall size CByteCount triggerSize
run walkerTriggerCall
bind value walkerTriggerBuffer COpaqueMemoryAddress walkerTriggerCall

storage module immutable sevenValue CSignedInt64 7
storage module immutable elevenValue CSignedInt64 11
storage module immutable thirteenValue CSignedInt64 13
storage module immutable seventeenValue CSignedInt64 17

# Var for first trailing arg
memory main mutable sevenStorage I64 0
set memory sevenStorage sevenValue

# Binds for remaining three
call idElevenCall identityI64
argument idElevenCall input CSignedInt64 elevenValue
run idElevenCall
bind value elevenBind CSignedInt64 idElevenCall

call idThirteenCall identityI64
argument idThirteenCall input CSignedInt64 thirteenValue
run idThirteenCall
bind value thirteenBind CSignedInt64 idThirteenCall

call idSeventeenCall identityI64
argument idSeventeenCall input CSignedInt64 seventeenValue
run idSeventeenCall
bind value seventeenBind CSignedInt64 idSeventeenCall

storage module immutable fourArgFormat CNullTerminatedByteString "%lld %lld %lld %lld\n"

call printCall c.printf
argument printCall format CNullTerminatedByteString fourArgFormat
argument printCall a I64 sevenStorage
argument printCall b CSignedInt64 elevenBind
argument printCall c CSignedInt64 thirteenBind
argument printCall d CSignedInt64 seventeenBind
run printCall
ignore ok source printCall type CSignedInt32

call freeCall c.free
argument freeCall ptr COpaqueMemoryAddress walkerTriggerBuffer
run freeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode

operation identityI64
input operation identityI64 input CSignedInt64
output operation identityI64 Result CSignedInt64 Void
purpose operation identityI64 "Wrap a const integer in a bind."
label startIdentityI64
return ok input
