# expect.stdout: not-taken\n
# expect.exit: 0
project BranchIfSkipped
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "branchIf with FALSE condition falls through to the unconditional branch."
invariant operation main "Prints 'not-taken' when condition fails."
label startMain
storage module immutable fiveInitial I64 5
storage module immutable sevenCompare I64 7
memory main mutable leftOp I64 fiveInitial
call eqCall math.equalI64
argument eqCall left I64 leftOp
argument eqCall right I64 sevenCompare
run eqCall
bind value isEqual Bool eqCall
branch if condition isEqual target takenLabel
branch else target notTakenLabel
label takenLabel
storage module immutable takenText CNullTerminatedByteString "taken"
call writeTakenCall console.writeLine
argument writeTakenCall console Console console
argument writeTakenCall text CNullTerminatedByteString takenText
run writeTakenCall
ignore void source writeTakenCall
jump target endLabel
label notTakenLabel
storage module immutable notTakenText CNullTerminatedByteString "not-taken"
call writeNotTakenCall console.writeLine
argument writeNotTakenCall console Console console
argument writeNotTakenCall text CNullTerminatedByteString notTakenText
run writeNotTakenCall
ignore void source writeNotTakenCall
jump target endLabel
label endLabel
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
