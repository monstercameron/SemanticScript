# expect.stdout: 99\n
# expect.exit: 0
project ChannelSendOverwrite
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Single-slot channel: when two sends happen before a receive, the receive sees the latest value."
invariant operation main "Output is 99 (the second send) not 50 (the first send)."
label startMain
storage module immutable firstSendValue Int64 50
storage module immutable secondSendValue Int64 99
send overwriteChannel firstSendValue
send overwriteChannel secondSendValue
receive latestValue Int64 overwriteChannel
call writeLatestCall console.writeIntegerLine
argument writeLatestCall console Console console
argument writeLatestCall value Int64 latestValue
run writeLatestCall
ignore void source writeLatestCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
