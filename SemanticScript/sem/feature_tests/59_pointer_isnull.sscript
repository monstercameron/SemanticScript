# expect.stdout: 0\n1\n
# expect.exit: 0
project PointerIsNull
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder CSignedInt32
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main read memory.buffer
effect main write console.stdout
memory main heap auto
async main no
purpose operation main "Test pointer.isNull primitive against a malloc'd pointer (not null) and a fresh c.malloc(0) followed by reset to null-like usage."
invariant operation main "Exercises icmp eq i8* X, null path."
label startMain
storage module immutable fourBytes I64 4
storage module immutable oneVal I64 1
storage module immutable zeroVal I64 0
call mallocCall c.malloc
argument mallocCall size I64 fourBytes
run mallocCall
bind value allocatedBuffer COpaqueMemoryAddress mallocCall
call notNullCheckCall pointer.isNull
argument notNullCheckCall p COpaqueMemoryAddress allocatedBuffer
run notNullCheckCall
bind value allocatedIsNull Bool notNullCheckCall
memory main mutable firstNumeric I64 0
branch if condition allocatedIsNull target markFirstOne
branch else target printFirst
label markFirstOne
set memory firstNumeric oneVal
jump target printFirst
label printFirst
call writeFirstCall console.writeIntegerLine
argument writeFirstCall console Console console
argument writeFirstCall value I64 firstNumeric
run writeFirstCall
ignore void source writeFirstCall
call freeCall c.free
argument freeCall ptr COpaqueMemoryAddress allocatedBuffer
run freeCall
# Now build a "null" by calling getenv on a name we know is unset.
storage module immutable definitelyUnsetName CNullTerminatedByteString "SEMANTICSCRIPT_DEFINITELY_NOT_SET_X"
call envCall c.getenv
argument envCall name CNullTerminatedByteString definitelyUnsetName
run envCall
bind value envPointer COpaqueMemoryAddress envCall
call envIsNullCall pointer.isNull
argument envIsNullCall p COpaqueMemoryAddress envPointer
run envIsNullCall
bind value envIsNull Bool envIsNullCall
memory main mutable secondNumeric I64 0
branch if condition envIsNull target markSecondOne
branch else target printSecond
label markSecondOne
set memory secondNumeric oneVal
jump target printSecond
label printSecond
call writeSecondCall console.writeIntegerLine
argument writeSecondCall console Console console
argument writeSecondCall value I64 secondNumeric
run writeSecondCall
ignore void source writeSecondCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
