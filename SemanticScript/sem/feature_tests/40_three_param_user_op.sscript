# expect.stdout: 24\n
# expect.exit: 0
project ThreeParamUserOp
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32

operation tripleProduct
input operation tripleProduct a Int64
input operation tripleProduct b Int64
input operation tripleProduct c Int64
output operation tripleProduct Result Int64 Void
memory tripleProduct heap no
async tripleProduct no
purpose operation tripleProduct "Return a * b * c."
invariant operation tripleProduct "Three-param multiply."
label startTripleProduct
call firstMulCall math.multiplyInt64
argument firstMulCall left Int64 a
argument firstMulCall right Int64 b
run firstMulCall
bind value firstProduct Int64 firstMulCall
call secondMulCall math.multiplyInt64
argument secondMulCall left Int64 firstProduct
argument secondMulCall right Int64 c
run secondMulCall
bind value secondProduct Int64 secondMulCall
return ok secondProduct

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "tripleProduct(2,3,4) = 24."
invariant operation main "Outputs 24."
label startMain
storage module immutable twoInitial Int64 2
storage module immutable threeInitial Int64 3
storage module immutable fourInitial Int64 4
memory main mutable aValue Int64 twoInitial
memory main mutable bValue Int64 threeInitial
memory main mutable cValue Int64 fourInitial
call computeCall tripleProduct
argument computeCall a Int64 aValue
argument computeCall b Int64 bValue
argument computeCall c Int64 cValue
run computeCall
bind ok computeResult Int64 computeCall
memory main mutable outputVar Int64 twoInitial
set memory outputVar computeResult
call writeCall console.writeIntegerLine
argument writeCall console Console console
argument writeCall value Int64 outputVar
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
