# expect.stdout: hello\nworld\n
# expect.exit: 0
project WriteLineWithBindString
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32

operation pickGreeting
input operation pickGreeting useFirst Int64
output operation pickGreeting Result String Void
memory pickGreeting heap no
async pickGreeting no
purpose operation pickGreeting "Return one of two compile-time string constants based on the flag. Used to verify that console.writeLine can consume an i8* bind (rather than a direct const reference) when written via c.putchar bytes for now (string-replay path doesn't survive walker mode)."
invariant operation pickGreeting "Returns 'hello' or 'world' as a pointer."
label startPickGreeting
storage module immutable helloMessage String "hello"
storage module immutable worldMessage String "world"
storage module immutable zeroPivot Int64 0
call useFirstBoolCall math.greaterThanInt64
argument useFirstBoolCall left Int64 useFirst
argument useFirstBoolCall right Int64 zeroPivot
run useFirstBoolCall
bind value chooseFirst Bool useFirstBoolCall
branch if condition chooseFirst target pickHello
return ok worldMessage
label pickHello
return ok helloMessage

operation putString
input operation putString message String
output operation putString Result ByteCount Void
effect putString read memory.buffer
effect putString write console.stdout
memory putString heap no
async putString no
purpose operation putString "Walk the message byte by byte writing each via c.putchar until the NUL terminator. Returns the byte count."
invariant operation putString "Stops at the first zero byte."
label startPutString
storage module immutable zeroIndex Int64 0
storage module immutable oneIncrement Int64 1
storage module immutable nullByte Int64 0
memory putString mutable positionIndex Int64 zeroIndex
label loopTop
call byteLoadCall pointer.loadByte
argument byteLoadCall buffer String message
argument byteLoadCall offset Int64 positionIndex
run byteLoadCall
bind value currentByte Int8 byteLoadCall
call isTerminatorCall math.equalInt64
argument isTerminatorCall left Int8 currentByte
argument isTerminatorCall right Int64 nullByte
run isTerminatorCall
bind value isTerminator Bool isTerminatorCall
branch if condition isTerminator target finishWriting
call writeByteCall c.putchar
argument writeByteCall c Int8 currentByte
run writeByteCall
call advanceCall math.addInt64
argument advanceCall left Int64 positionIndex
argument advanceCall right Int64 oneIncrement
run advanceCall
bind value nextPosition Int64 advanceCall
set memory positionIndex nextPosition
jump target loopTop
label finishWriting
return ok positionIndex

operation putLine
input operation putLine message String
output operation putLine Result ByteCount Void
effect putLine read memory.buffer
effect putLine write console.stdout
memory putLine heap no
async putLine no
purpose operation putLine "Write message via putString then emit a trailing newline."
invariant operation putLine "Returns the byte count of message (not including the newline)."
label startPutLine
call bodyCall putString
argument bodyCall message String message
run bodyCall
bind ok byteCount ByteCount bodyCall
storage module immutable newlineByte Int32 10
call newlineCall c.putchar
argument newlineCall c Int32 newlineByte
run newlineCall
return ok byteCount

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main read memory.buffer
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Pick and emit two greetings: pickGreeting(1) -> 'hello\n', pickGreeting(0) -> 'world\n'. Exercises pointer-returning user op, pointer-typed arg to a sibling user op, and putString loop using pointer.loadByte/c.putchar."
invariant operation main "Output is 'hello\nworld\n'."
label startMain
storage module immutable oneSelector Int64 1
storage module immutable zeroSelector Int64 0
call pickHelloCall pickGreeting
argument pickHelloCall useFirst Int64 oneSelector
run pickHelloCall
bind ok helloPointer String pickHelloCall
call writeHelloCall putLine
argument writeHelloCall message String helloPointer
run writeHelloCall
ignore ok source writeHelloCall type ByteCount
call pickWorldCall pickGreeting
argument pickWorldCall useFirst Int64 zeroSelector
run pickWorldCall
bind ok worldPointer String pickWorldCall
call writeWorldCall putLine
argument writeWorldCall message String worldPointer
run writeWorldCall
ignore ok source writeWorldCall type ByteCount
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
