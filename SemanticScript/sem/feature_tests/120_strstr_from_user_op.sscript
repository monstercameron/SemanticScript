# expect.stdout: found here\n
# expect.exit: 0
project StrstrPtr
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder CSignedInt32

operation findIn
input operation findIn haystack CNullTerminatedByteString
input operation findIn needle CNullTerminatedByteString
output operation findIn Result CNullTerminatedByteString Void
label startFind
call ssCall c.strstr
argument ssCall haystack CNullTerminatedByteString haystack
argument ssCall needle CNullTerminatedByteString needle
run ssCall
bind value found CNullTerminatedByteString ssCall
return ok found

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
label startMain
storage module immutable text CNullTerminatedByteString "this is found here"
storage module immutable what CNullTerminatedByteString "found"
call fc findIn
argument fc haystack CNullTerminatedByteString text
argument fc needle CNullTerminatedByteString what
run fc
bind ok res CNullTerminatedByteString fc
call w console.writeLine
argument w console Console console
argument w text CNullTerminatedByteString res
run w
ignore void source w
storage module immutable okExit ExitCode 0
return ok okExit
