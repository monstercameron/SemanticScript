# expect.stdout: found here\n
# expect.exit: 0
project StrstrPtr
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32

operation findIn
input operation findIn haystack String
input operation findIn needle String
output operation findIn Result String Void
label startFind
call ssCall c.strstr
argument ssCall haystack String haystack
argument ssCall needle String needle
run ssCall
bind value found String ssCall
return ok found

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
label startMain
storage module immutable text String "this is found here"
storage module immutable what String "found"
call fc findIn
argument fc haystack String text
argument fc needle String what
run fc
bind ok res String fc
call w console.writeLine
argument w console Console console
argument w text String res
run w
ignore void source w
storage module immutable okExit ExitCode 0
return ok okExit
