# expect.stdout: 9.000000\n
# expect.exit: 0
project MultiLevelFloatAlias
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32

# Multi-level type alias chain. Distance is an alias of Metric, which
# is an alias of Float64. The compiler must resolve through both
# levels to detect that Distance values should be emitted as `double`.
type Metric Float64
type Distance Metric
type Velocity Distance

operation tripleVelocity
input operation tripleVelocity speed Velocity
output operation tripleVelocity Result Velocity Void
memory tripleVelocity heap no
async tripleVelocity no
purpose operation tripleVelocity "Multiply a Velocity (== Distance == Metric == Float64) by 3.0."
invariant operation tripleVelocity "Verifies the alias chain resolves to double for both the param and the result."
label startTripleVelocity
storage module immutable threeFactor Velocity 3.0
call multCall math.multiplyFloat64
argument multCall left Velocity speed
argument multCall right Velocity threeFactor
run multCall
bind value tripled Velocity multCall
return ok tripled

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "tripleVelocity(3.0) == 9.0. Exercises 3-level type-alias resolution to Float64."
invariant operation main "Output is 9.000000."
label startMain
storage module immutable startSpeed Velocity 3.0
call computeCall tripleVelocity
argument computeCall speed Velocity startSpeed
run computeCall
bind ok finalSpeed Velocity computeCall
call writeCall console.writeFloatLine
argument writeCall console Console console
argument writeCall value Velocity finalSpeed
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
