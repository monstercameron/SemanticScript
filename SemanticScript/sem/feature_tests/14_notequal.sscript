# expect.stdout: different\n
# expect.exit: 0
project NotEqualBranch
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "math.notEqualI64 returns true when args differ."
invariant operation main "Picks 'different' branch."
label startMain
storage module immutable aInitial I64 1
storage module immutable bCompare I64 2
memory main mutable leftOp I64 aInitial
call neCall math.notEqualI64
argument neCall left I64 leftOp
argument neCall right I64 bCompare
run neCall
bind value isDifferent Bool neCall
branch if condition isDifferent target diffLabel
branch else target sameLabel
label diffLabel
storage module immutable diffText CNullTerminatedByteString "different"
call writeDiffCall console.writeLine
argument writeDiffCall console Console console
argument writeDiffCall text CNullTerminatedByteString diffText
run writeDiffCall
ignore void source writeDiffCall
jump target endLabel
label sameLabel
storage module immutable sameText CNullTerminatedByteString "same"
call writeSameCall console.writeLine
argument writeSameCall console Console console
argument writeSameCall text CNullTerminatedByteString sameText
run writeSameCall
ignore void source writeSameCall
jump target endLabel
label endLabel
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
