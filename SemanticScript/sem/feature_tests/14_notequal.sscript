# expect.stdout: different\n
# expect.exit: 0
project NotEqualBranch
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "math.notEqualInt64 returns true when args differ."
invariant operation main "Picks 'different' branch."
label startMain
storage module immutable aInitial Int64 1
storage module immutable bCompare Int64 2
memory main mutable leftOp Int64 aInitial
call neCall math.notEqualInt64
argument neCall left Int64 leftOp
argument neCall right Int64 bCompare
run neCall
bind value isDifferent Bool neCall
branch if condition isDifferent target diffLabel
branch else target sameLabel
label diffLabel
storage module immutable diffText String "different"
call writeDiffCall console.writeLine
argument writeDiffCall console Console console
argument writeDiffCall text String diffText
run writeDiffCall
ignore void source writeDiffCall
jump target endLabel
label sameLabel
storage module immutable sameText String "same"
call writeSameCall console.writeLine
argument writeSameCall console Console console
argument writeSameCall text String sameText
run writeSameCall
ignore void source writeSameCall
jump target endLabel
label endLabel
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
