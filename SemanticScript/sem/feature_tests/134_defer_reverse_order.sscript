# expect.stdout: hello\nfirstCleanup\nsecondCleanup\n
# expect.exit: 0
project DeferReverseOrder
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError
operation printSecondCleanup
input operation printSecondCleanup console Console
output operation printSecondCleanup Int32
storage module immutable secondCleanupMessage String "secondCleanup"
call writeSecondCall console.writeLine
argument writeSecondCall console Console console
argument writeSecondCall text String secondCleanupMessage
run writeSecondCall
ignore void source writeSecondCall
storage module immutable successfulInnerExit Int32 0
return value successfulInnerExit
operation printFirstCleanup
input operation printFirstCleanup console Console
output operation printFirstCleanup Int32
storage module immutable firstCleanupMessage String "firstCleanup"
call writeFirstCall console.writeLine
argument writeFirstCall console Console console
argument writeFirstCall text String firstCleanupMessage
run writeFirstCall
ignore void source writeFirstCall
storage module immutable innerExitSuccess Int32 0
return value innerExitSuccess
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Defers run in reverse registration order on every exit path."
invariant operation main "After 'hello', firstCleanup prints (because secondCleanup registered first, runs second)."
label startMain
defer secondCleanupDefer printSecondCleanup console
defer firstCleanupDefer printFirstCleanup console
storage module immutable helloMessage String "hello"
call writeHelloCall console.writeLine
argument writeHelloCall console Console console
argument writeHelloCall text String helloMessage
run writeHelloCall
ignore void source writeHelloCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
