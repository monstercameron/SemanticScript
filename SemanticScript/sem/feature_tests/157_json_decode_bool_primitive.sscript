# expect.stdout: parsedTrue\nparsedFalse\n
# expect.exit: 0
languageMode permissiveExecutable
project JsonParseBoolPrimitive
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError DecodeFailed CSignedInt32
errorCase MainError RoundTripMismatch CSignedInt32
errorCase MainError ConsoleWriteFailed CSignedInt32
operation main
input main console Console
output main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose main "json.parse.Bool returns true for true input and false for false."
invariant main "Output markers depend on parsed bool control flow."
label startMain
const trueJsonToken CNullTerminatedByteString "true"
const falseJsonToken CNullTerminatedByteString "false"
call parseTrueCall json.parse.Bool
arg parseTrueCall jsonText trueJsonToken
run parseTrueCall
bindOk decodedTrueValue Bool parseTrueCall
bindError trueDecodeError JsonDecodeError parseTrueCall
branchIfError parseTrueCall decodeFailed
branchIf decodedTrueValue trueOk
branch roundTripMismatch
label trueOk
const trueMarker CNullTerminatedByteString "parsedTrue"
call writeTrueDecodedCall console.writeLine
arg writeTrueDecodedCall console console
arg writeTrueDecodedCall text trueMarker
run writeTrueDecodedCall
ignoreOk writeTrueDecodedCall Void
bindError writeTrueError ConsoleWriteError writeTrueDecodedCall
branchIfError writeTrueDecodedCall consoleWriteFailed
call parseFalseCall json.parse.Bool
arg parseFalseCall jsonText falseJsonToken
run parseFalseCall
bindOk decodedFalseValue Bool parseFalseCall
bindError falseDecodeError JsonDecodeError parseFalseCall
branchIfError parseFalseCall decodeFailed
branchIf decodedFalseValue roundTripMismatch
const falseMarker CNullTerminatedByteString "parsedFalse"
call writeFalseDecodedCall console.writeLine
arg writeFalseDecodedCall console console
arg writeFalseDecodedCall text falseMarker
run writeFalseDecodedCall
ignoreOk writeFalseDecodedCall Void
bindError writeFalseError ConsoleWriteError writeFalseDecodedCall
branchIfError writeFalseDecodedCall consoleWriteFailed
const successfulExitCode ExitCode 0
returnOk successfulExitCode
label decodeFailed
makeError decodeFailure MainError.DecodeFailed trueDecodeError
returnError decodeFailure
label roundTripMismatch
makeError mismatchFailure MainError.RoundTripMismatch trueDecodeError
returnError mismatchFailure
label consoleWriteFailed
makeError writeFailure MainError.ConsoleWriteFailed writeTrueError
returnError writeFailure
