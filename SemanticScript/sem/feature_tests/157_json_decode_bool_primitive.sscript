# expect.stdout: parsedTrue\nparsedFalse\n
# expect.exit: 0
languageMode permissiveExecutable
project JsonParseBoolPrimitive
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError DecodeFailed Int32
errorCase MainError RoundTripMismatch Int32
errorCase MainError ConsoleWriteFailed Int32
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "json.parse.Bool returns true for true input and false for false."
invariant operation main "Output markers depend on parsed bool control flow."
label startMain
storage module immutable trueJsonToken String "true"
storage module immutable falseJsonToken String "false"
call parseTrueCall json.parse.Bool
argument parseTrueCall jsonText String trueJsonToken
run parseTrueCall
bind ok decodedTrueValue Bool parseTrueCall
bind error trueDecodeError JsonDecodeError parseTrueCall
branch error source parseTrueCall target decodeFailed
branch if condition decodedTrueValue target trueOk
branch else target roundTripMismatch
label trueOk
storage module immutable trueMarker String "parsedTrue"
call writeTrueDecodedCall console.writeLine
argument writeTrueDecodedCall console Console console
argument writeTrueDecodedCall text String trueMarker
run writeTrueDecodedCall
ignore void source writeTrueDecodedCall
bind error writeTrueError ConsoleWriteError writeTrueDecodedCall
branch error source writeTrueDecodedCall target consoleWriteFailed
call parseFalseCall json.parse.Bool
argument parseFalseCall jsonText String falseJsonToken
run parseFalseCall
bind ok decodedFalseValue Bool parseFalseCall
bind error falseDecodeError JsonDecodeError parseFalseCall
branch error source parseFalseCall target decodeFailed
branch if condition decodedFalseValue target roundTripMismatch
storage module immutable falseMarker String "parsedFalse"
call writeFalseDecodedCall console.writeLine
argument writeFalseDecodedCall console Console console
argument writeFalseDecodedCall text String falseMarker
run writeFalseDecodedCall
ignore void source writeFalseDecodedCall
bind error writeFalseError ConsoleWriteError writeFalseDecodedCall
branch error source writeFalseDecodedCall target consoleWriteFailed
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
label decodeFailed
makeError decodeFailure MainError.DecodeFailed trueDecodeError
return error decodeFailure
label roundTripMismatch
makeError mismatchFailure MainError.RoundTripMismatch trueDecodeError
return error mismatchFailure
label consoleWriteFailed
makeError writeFailure MainError.ConsoleWriteFailed writeTrueError
return error writeFailure
