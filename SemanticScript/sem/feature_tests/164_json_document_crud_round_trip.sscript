# expect.stdout: ship json\n{"count":2}\n
# expect.exit: 0
languageMode permissiveExecutable
project JsonDocumentCrudRoundTrip
target console
runtime AgentRuntime 0.1
module jsonDocumentCrudRoundTrip

import json standard.json
dependency standard.json version 0.1 source standard

entry console main

error MainError
errorCase MainError JsonAccessFailed CSignedInt32
errorCase MainError ConsoleWriteFailed CSignedInt32

capability jsonCrudStdout console.stdout write
purpose operation jsonCrudStdout "Authority to print the JSON CRUD round-trip results."

capability jsonCrudHeapAllocate heap allocate
purpose operation jsonCrudHeapAllocate "Authority to allocate JSON serialization scratch space."

capability jsonCrudHeapFree heap free
purpose operation jsonCrudHeapFree "Authority to release JSON serialization scratch space."

storage module immutable successExit ExitCode 0
storage module immutable jsonAccessFailedCode CSignedInt32 1
storage module immutable consoleFailedCode CSignedInt32 2

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
effect main allocate heap
effect main free heap
effect main read json.document.tree
effect main write json.document.tree
memory main heap auto
async main no
useCapability main jsonCrudStdout
useCapability main jsonCrudHeapAllocate
useCapability main jsonCrudHeapFree
purpose operation main "Create an object document, mutate fields, read a field through a path cursor, delete that field, serialize the final document, and print both observable results."
invariant operation main "A no-op document lowering cannot pass because stdout depends on cursorString reading title and serializeDocument reflecting update/delete mutations."

label startMain

storage module immutable documentCapacity JsonCapacityBytes 2048
storage module immutable scratchCapacity JsonCapacityBytes 512
storage module immutable objectRootKind CSignedInt32 0

call allocateScratchCall c.malloc
argument allocateScratchCall size JsonCapacityBytes scratchCapacity
run allocateScratchCall
bind value serializationScratch COpaqueMemoryAddress allocateScratchCall
defer releaseScratchDefer c.free serializationScratch

call createDocumentCall json.createEmptyDocument
argument createDocumentCall capacityBytes JsonCapacityBytes documentCapacity
argument createDocumentCall rootKind CSignedInt32 objectRootKind
run createDocumentCall
bind ok todoDocument JsonDocument createDocumentCall
bind error createDocumentError JsonAccessError createDocumentCall
branch error source createDocumentCall target jsonAccessFailed

defer releaseDocumentDefer json.destroyDocument todoDocument

call rootCursorCall json.documentRoot
argument rootCursorCall document JsonDocument todoDocument
run rootCursorCall
bind value rootCursor JsonCursor rootCursorCall

storage module immutable titleField CNullTerminatedByteString "title"
storage module immutable titleValue CNullTerminatedByteString "ship json"
call setTitleCall json.setObjectFieldString
argument setTitleCall document JsonDocument todoDocument
argument setTitleCall cursor JsonCursor rootCursor
argument setTitleCall fieldName CNullTerminatedByteString titleField
argument setTitleCall value CNullTerminatedByteString titleValue
run setTitleCall
ignore ok source setTitleCall type CSignedInt32
bind error setTitleError CSignedInt32 setTitleCall
branch error source setTitleCall target jsonAccessFailed

storage module immutable countField CNullTerminatedByteString "count"
storage module immutable initialCount I64 1
call setInitialCountCall json.setObjectFieldInt64
argument setInitialCountCall document JsonDocument todoDocument
argument setInitialCountCall cursor JsonCursor rootCursor
argument setInitialCountCall fieldName CNullTerminatedByteString countField
argument setInitialCountCall value I64 initialCount
run setInitialCountCall
ignore ok source setInitialCountCall type CSignedInt32
bind error setInitialCountError CSignedInt32 setInitialCountCall
branch error source setInitialCountCall target jsonAccessFailed

storage module immutable titlePath CNullTerminatedByteString ".title"
call findTitleCursorCall json.cursorAtPath
argument findTitleCursorCall document JsonDocument todoDocument
argument findTitleCursorCall path CNullTerminatedByteString titlePath
run findTitleCursorCall
bind ok titleCursor JsonCursor findTitleCursorCall
bind error findTitleCursorError JsonAccessError findTitleCursorCall
branch error source findTitleCursorCall target jsonAccessFailed

call readTitleCall json.cursorString
argument readTitleCall document JsonDocument todoDocument
argument readTitleCall cursor JsonCursor titleCursor
argument readTitleCall scratch COpaqueMemoryAddress serializationScratch
argument readTitleCall scratchCapacity JsonCapacityBytes scratchCapacity
run readTitleCall
bind ok recoveredTitle JsonText readTitleCall
bind error readTitleError JsonAccessError readTitleCall
branch error source readTitleCall target jsonAccessFailed

call writeTitleCall console.writeLine
argument writeTitleCall console Console console
argument writeTitleCall text JsonText recoveredTitle
run writeTitleCall
ignore void source writeTitleCall
bind error writeTitleError ConsoleWriteError writeTitleCall
branch error source writeTitleCall target consoleWriteFailed

storage module immutable updatedCount I64 2
call updateCountCall json.setObjectFieldInt64
argument updateCountCall document JsonDocument todoDocument
argument updateCountCall cursor JsonCursor rootCursor
argument updateCountCall fieldName CNullTerminatedByteString countField
argument updateCountCall value I64 updatedCount
run updateCountCall
ignore ok source updateCountCall type CSignedInt32
bind error updateCountError CSignedInt32 updateCountCall
branch error source updateCountCall target jsonAccessFailed

call removeTitleCall json.removeObjectField
argument removeTitleCall document JsonDocument todoDocument
argument removeTitleCall cursor JsonCursor rootCursor
argument removeTitleCall fieldName CNullTerminatedByteString titleField
run removeTitleCall
ignore ok source removeTitleCall type CSignedInt32
bind error removeTitleError CSignedInt32 removeTitleCall
branch error source removeTitleCall target jsonAccessFailed

call serializeDocumentCall json.serializeDocument
argument serializeDocumentCall document JsonDocument todoDocument
argument serializeDocumentCall scratch COpaqueMemoryAddress serializationScratch
argument serializeDocumentCall scratchCapacity JsonCapacityBytes scratchCapacity
run serializeDocumentCall
bind ok serializedDocument JsonText serializeDocumentCall
bind error serializeDocumentError JsonAccessError serializeDocumentCall
branch error source serializeDocumentCall target jsonAccessFailed

call writeSerializedCall console.writeLine
argument writeSerializedCall console Console console
argument writeSerializedCall text JsonText serializedDocument
run writeSerializedCall
ignore void source writeSerializedCall
bind error writeSerializedError ConsoleWriteError writeSerializedCall
branch error source writeSerializedCall target consoleWriteFailed

return ok successExit

label jsonAccessFailed
makeError jsonAccessFailure MainError.JsonAccessFailed jsonAccessFailedCode
return error jsonAccessFailure

label consoleWriteFailed
makeError consoleFailure MainError.ConsoleWriteFailed consoleFailedCode
return error consoleFailure
