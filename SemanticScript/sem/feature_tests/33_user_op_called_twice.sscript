# expect.stdout: 6\n10\n
# expect.exit: 0
project UserOpCalledTwice
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32

operation doubleIt
input operation doubleIt x Int64
output operation doubleIt Result Int64 Void
memory doubleIt heap no
async doubleIt no
