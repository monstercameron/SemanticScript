# expect.stdout: 6\n10\n
# expect.exit: 0
project UserOpCalledTwice
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder CSignedInt32

operation doubleIt
input operation doubleIt x CSignedInt64
output operation doubleIt Result CSignedInt64 Void
memory doubleIt heap no
async doubleIt no
purpose operation doubleIt "Doubles x."
invariant operation doubleIt "Returns 2x."
label startDoubleIt
storage module immutable twoLit I64 2
call mulCall math.multiplyI64
argument mulCall left CSignedInt64 x
argument mulCall right I64 twoLit
run mulCall
bind value mulResult I64 mulCall
return ok mulResult

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Call doubleIt twice; print both results."
invariant operation main "Outputs 6 then 10."
label startMain
storage module immutable threeInitial I64 3
storage module immutable fiveInitial I64 5
memory main mutable firstInput I64 threeInitial
memory main mutable secondInput I64 fiveInitial
call firstCallCall doubleIt
argument firstCallCall x CSignedInt64 firstInput
run firstCallCall
bind ok firstResult I64 firstCallCall
memory main mutable firstResultVar I64 threeInitial
set memory firstResultVar firstResult
call writeFirstCall console.writeIntegerLine
argument writeFirstCall console Console console
argument writeFirstCall value I64 firstResultVar
run writeFirstCall
ignore void source writeFirstCall
call secondCallCall doubleIt
argument secondCallCall x CSignedInt64 secondInput
run secondCallCall
bind ok secondResult I64 secondCallCall
memory main mutable secondResultVar I64 fiveInitial
set memory secondResultVar secondResult
call writeSecondCall console.writeIntegerLine
argument writeSecondCall console Console console
argument writeSecondCall value I64 secondResultVar
run writeSecondCall
ignore void source writeSecondCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
