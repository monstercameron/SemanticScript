# expect.stdout: 100\n
# expect.exit: 0
project ModuleMutableCrossOp
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError
storage module immutable zeroInitialValue Int64 0
storage module immutable newValueOneHundred Int64 100
storage module mutable counterAcrossOperations Int64 zeroInitialValue
operation setValueOperation
input operation setValueOperation valueToStore Int64
output operation setValueOperation Int64
set storage counterAcrossOperations valueToStore
return value valueToStore
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Cross-op: set via helper, then read in main, expect updated value."
invariant operation main "Helper writes 100; main reads back 100."
label startMain
call setHelperCall setValueOperation
argument setHelperCall valueToStore Int64 newValueOneHundred
run setHelperCall
ignore value source setHelperCall type Int64
call writeUpdatedCall console.writeIntegerLine
argument writeUpdatedCall console Console console
argument writeUpdatedCall value Int64 counterAcrossOperations
run writeUpdatedCall
ignore void source writeUpdatedCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
