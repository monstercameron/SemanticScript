# expect.stdout: -7\n
# expect.exit: 0
project NegativeResult
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "3 - 10 = -7 prints correctly."
invariant operation main "Negative arithmetic emits signed sub."
label startMain
storage module immutable threeInitial I64 3
storage module immutable tenLit I64 10
memory main mutable leftOp I64 threeInitial
call subCall math.subtractI64
argument subCall left I64 leftOp
argument subCall right I64 tenLit
run subCall
bind value subResult I64 subCall
memory main mutable resultVar I64 threeInitial
set memory resultVar subResult
call writeCall console.writeIntegerLine
argument writeCall console Console console
argument writeCall value I64 resultVar
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
