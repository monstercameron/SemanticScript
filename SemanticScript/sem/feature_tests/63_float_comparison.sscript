# expect.stdout: less\n
# expect.exit: 0
project FloatComparisonTest
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder CSignedInt32

operation classifyFloat
input operation classifyFloat left CFloat64
input operation classifyFloat right CFloat64
output operation classifyFloat Result CSignedInt32 Void
memory classifyFloat heap no
async classifyFloat no
purpose operation classifyFloat "Returns -1 when left < right, 0 when equal, +1 when greater. Uses math.lessThanF64 / math.greaterThanF64."
invariant operation classifyFloat "Bool result is 0 or 1; map back to a sign by branching."
label startClassifyFloat
storage module immutable ltResult CSignedInt32 -1
storage module immutable gtResult CSignedInt32 1
storage module immutable eqResult CSignedInt32 0
call lessCheckCall math.lessThanF64
argument lessCheckCall left CFloat64 left
argument lessCheckCall right CFloat64 right
run lessCheckCall
bind value isLess Bool lessCheckCall
branch if condition isLess target emitLtResult
call greaterCheckCall math.greaterThanF64
argument greaterCheckCall left CFloat64 left
argument greaterCheckCall right CFloat64 right
run greaterCheckCall
bind value isGreater Bool greaterCheckCall
branch if condition isGreater target emitGtResult
return ok eqResult
label emitLtResult
return ok ltResult
label emitGtResult
return ok gtResult

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Compare 1.5 < 2.5 and print 'less' for negative classification, 'equal' for zero, 'more' for positive."
invariant operation main "Exercises math.lessThanF64 via classifyFloat user op."
label startMain
storage module immutable oneAndHalf CFloat64 1.5
storage module immutable twoAndHalf CFloat64 2.5
call classifyCall classifyFloat
argument classifyCall left CFloat64 oneAndHalf
argument classifyCall right CFloat64 twoAndHalf
run classifyCall
bind ok classification CSignedInt32 classifyCall
memory main mutable classificationStorage I64 0
set memory classificationStorage classification
storage module immutable zeroValue I64 0
call isNegativeCall math.lessThanI64
argument isNegativeCall left I64 classificationStorage
argument isNegativeCall right I64 zeroValue
run isNegativeCall
bind value isNegative Bool isNegativeCall
branch if condition isNegative target printLess
storage module immutable greetingMore CNullTerminatedByteString "more\n"
call writeMoreCall console.writeLine
argument writeMoreCall console Console console
argument writeMoreCall text CNullTerminatedByteString greetingMore
run writeMoreCall
ignore void source writeMoreCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
label printLess
storage module immutable greetingLess CNullTerminatedByteString "less"
call writeLessCall console.writeLine
argument writeLessCall console Console console
argument writeLessCall text CNullTerminatedByteString greetingLess
run writeLessCall
ignore void source writeLessCall
storage module immutable lessExitCode ExitCode 0
return ok lessExitCode
