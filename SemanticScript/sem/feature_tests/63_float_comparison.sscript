# expect.stdout: less\n
# expect.exit: 0
project FloatComparisonTest
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32

operation classifyFloat
input operation classifyFloat left Float64
input operation classifyFloat right Float64
output operation classifyFloat Result Int32 Void
memory classifyFloat heap no
async classifyFloat no
purpose operation classifyFloat "Returns -1 when left < right, 0 when equal, +1 when greater. Uses math.lessThanFloat64 / math.greaterThanFloat64."
invariant operation classifyFloat "Bool result is 0 or 1; map back to a sign by branching."
label startClassifyFloat
storage module immutable ltResult Int32 -1
storage module immutable gtResult Int32 1
storage module immutable eqResult Int32 0
call lessCheckCall math.lessThanFloat64
argument lessCheckCall left Float64 left
argument lessCheckCall right Float64 right
run lessCheckCall
bind value isLess Bool lessCheckCall
branch if condition isLess target emitLtResult
call greaterCheckCall math.greaterThanFloat64
argument greaterCheckCall left Float64 left
argument greaterCheckCall right Float64 right
run greaterCheckCall
bind value isGreater Bool greaterCheckCall
branch if condition isGreater target emitGtResult
return ok eqResult
label emitLtResult
return ok ltResult
label emitGtResult
return ok gtResult

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Compare 1.5 < 2.5 and print 'less' for negative classification, 'equal' for zero, 'more' for positive."
invariant operation main "Exercises math.lessThanFloat64 via classifyFloat user op."
label startMain
storage module immutable oneAndHalf Float64 1.5
storage module immutable twoAndHalf Float64 2.5
call classifyCall classifyFloat
argument classifyCall left Float64 oneAndHalf
argument classifyCall right Float64 twoAndHalf
run classifyCall
bind ok classification Int32 classifyCall
memory main mutable classificationStorage Int64 0
set memory classificationStorage classification
storage module immutable zeroValue Int64 0
call isNegativeCall math.lessThanInt64
argument isNegativeCall left Int64 classificationStorage
argument isNegativeCall right Int64 zeroValue
run isNegativeCall
bind value isNegative Bool isNegativeCall
branch if condition isNegative target printLess
storage module immutable greetingMore String "more\n"
call writeMoreCall console.writeLine
argument writeMoreCall console Console console
argument writeMoreCall text String greetingMore
run writeMoreCall
ignore void source writeMoreCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
label printLess
storage module immutable greetingLess String "less"
call writeLessCall console.writeLine
argument writeLessCall console Console console
argument writeLessCall text String greetingLess
run writeLessCall
ignore void source writeLessCall
storage module immutable lessExitCode ExitCode 0
return ok lessExitCode
