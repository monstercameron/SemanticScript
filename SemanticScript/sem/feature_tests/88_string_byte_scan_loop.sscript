# expect.stdout: 17\n
# expect.exit: 0
project StringByteScanLoop
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32

operation findChar
input operation findChar haystack String
input operation findChar needleByte Int32
output operation findChar Result Int64 Void
effect findChar read memory.buffer
memory findChar heap no
async findChar no
purpose operation findChar "Walk haystack byte-by-byte; return the zero-based offset of the first match or -1 when not found. Exercises pointer.loadByte in a recursion-free loop with multiple branchIf branches sharing a single counter var."
invariant operation findChar "Stops at the first NUL terminator if no match."
label startFindChar
storage module immutable zeroPos Int64 0
storage module immutable oneStep Int64 1
storage module immutable negOneInitial Int64 -1
storage module immutable nullByte Int64 0
memory findChar mutable cursor Int64 zeroPos
label scanLoopFc
call probeByteCall pointer.loadByte
argument probeByteCall buffer String haystack
argument probeByteCall offset Int64 cursor
run probeByteCall
bind value probedByte Int8 probeByteCall
call hitNulCall math.equalInt64
argument hitNulCall left Int8 probedByte
argument hitNulCall right Int64 nullByte
run hitNulCall
bind value hitNul Bool hitNulCall
branch if condition hitNul target fcReportNotFound
call matchCheckCall math.equalInt64
argument matchCheckCall left Int8 probedByte
argument matchCheckCall right Int64 needleByte
run matchCheckCall
bind value matched Bool matchCheckCall
branch if condition matched target fcReportFound
call advanceCall math.addInt64
argument advanceCall left Int64 cursor
argument advanceCall right Int64 oneStep
run advanceCall
bind value nextCursor Int64 advanceCall
set memory cursor nextCursor
jump target scanLoopFc
label fcReportFound
return ok cursor
label fcReportNotFound
return ok negOneInitial

