argument hitNulCall left I8 probedByte
argument hitNulCall right I64 nullByte
run hitNulCall
bind value hitNul Bool hitNulCall
branch if condition hitNul target fcReportNotFound
call matchCheckCall math.equalI64
argument matchCheckCall left I8 probedByte
argument matchCheckCall right I64 needleByte
