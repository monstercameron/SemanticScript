# expect.stdout: 16.000000\n
# expect.exit: 0
project FloatVarInLoop
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder CSignedInt32
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Loop that doubles a CFloat64 var four times: 1.0 -> 2 -> 4 -> 8 -> 16. Exercises a CFloat64 var modified inside a branchIf-driven loop alongside an i64 counter."
invariant operation main "Uses both float and int math.* primitives in the same operation."
label startMain
storage module immutable oneFloat CFloat64 1.0
storage module immutable twoFloat CFloat64 2.0
storage module immutable oneStep CSignedInt64 1
storage module immutable zeroInitial CSignedInt64 0
storage module immutable fourTimes CSignedInt64 4
memory main mutable accumulator CFloat64 oneFloat
memory main mutable iterationIndex CSignedInt64 zeroInitial
label loopHead
call doneCheckCall math.greaterThanOrEqualI64
argument doneCheckCall left CSignedInt64 iterationIndex
argument doneCheckCall right CSignedInt64 fourTimes
run doneCheckCall
bind value isDone Bool doneCheckCall
branch if condition isDone target loopExit
call doubleCall math.multiplyF64
argument doubleCall left CFloat64 accumulator
argument doubleCall right CFloat64 twoFloat
run doubleCall
bind value doubledValue CFloat64 doubleCall
set memory accumulator doubledValue
call incCall math.addI64
argument incCall left I64 iterationIndex
argument incCall right I64 oneStep
run incCall
bind value nextIterationIndex CSignedInt64 incCall
set memory iterationIndex nextIterationIndex
jump target loopHead
label loopExit
call writeCall console.writeFloatLine
argument writeCall console Console console
argument writeCall value CFloat64 accumulator
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
