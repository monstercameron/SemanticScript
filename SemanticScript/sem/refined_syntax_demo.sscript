# refined_syntax_demo.sscript
#
# A small, runnable program written entirely in refined syntax. Exercises
# the runtime-binding lowerings and intrinsic lowerings end-to-end so a
# reader can verify the refined-syntax surface actually computes real
# values, not just compile-stubs.
#
# Build + run via:
#   python compiler/semsc.py sem/refined_syntax_demo.sscript --emit-ir /tmp/d.ll
#   clang /tmp/d.ll -o /tmp/d.exe
#   /tmp/d.exe
#
# Expected stdout, in order:
#   5            <- math.addInt64(2, 3)
#   1            <- isLeapYear(2024) — true
#   0            <- compareCString("hello", "hello") — strcmp equal
#   5            <- stringByteLength("hello") — strlen
#   150          <- retryPolicy.delayForAttempt(_, 2) implemented in .sem
#   15           <- metrics.computeIncrementInt64(_, 10, 5) implemented in .sem

project RefinedSyntaxDemo
target console
runtime AgentRuntime 0.1
entry console main

error DemoError
errorCase DemoError ConsoleWriteFailed ConsoleWriteError

# ----- error types reused by the bindings -----

error CStringCompareError
errorCase CStringCompareError InvalidCStringInput
errorCase CStringCompareError RuntimeCompareFailed

error CStringLengthError
errorCase CStringLengthError RuntimeLengthReadFailed

error TimePredicateError
errorCase TimePredicateError InvalidYear

error RetryPolicyError
errorCase RetryPolicyError DelayComputeFailed

error MetricsWriteError
errorCase MetricsWriteError IncrementFailed

# ----- intrinsic-bodied math op -----

operation math.addInt64
input operation math.addInt64 left Int64
input operation math.addInt64 right Int64
output operation math.addInt64 Int64
effect math.addInt64 read left
effect math.addInt64 read right
memory math.addInt64 heap no
async math.addInt64 no
operationBody math.addInt64 intrinsic
purpose operation math.addInt64 "Signed 64-bit integer addition"
intrinsicName math.addInt64 arithmetic.addInt64

operation math.multiplyInt64
input operation math.multiplyInt64 left Int64
input operation math.multiplyInt64 right Int64
output operation math.multiplyInt64 Int64
effect math.multiplyInt64 read left
effect math.multiplyInt64 read right
memory math.multiplyInt64 heap no
async math.multiplyInt64 no
operationBody math.multiplyInt64 intrinsic
purpose operation math.multiplyInt64 "Signed 64-bit integer multiplication"
intrinsicName math.multiplyInt64 arithmetic.multiplyInt64

# ----- libc-bodied string ops -----

operation compareCString
input operation compareCString left String
input operation compareCString right String
output operation compareCString Result Int32 CStringCompareError
effect compareCString read left
effect compareCString read right
memory compareCString heap no
async compareCString no
operationBody compareCString runtimeBinding
purpose operation compareCString "Compare two null-terminated byte strings; wraps strcmp."
runtimeBinding compareCString runtime.cstring.compare

operation stringByteLength
input operation stringByteLength inputText String
output operation stringByteLength Result ByteCount CStringLengthError
effect stringByteLength read inputText
memory stringByteLength heap no
async stringByteLength no
operationBody stringByteLength runtimeBinding
purpose operation stringByteLength "Return the byte length of a null-terminated string; wraps strlen."
runtimeBinding stringByteLength runtime.cstring.byteLength

# ----- SemanticScript-bodied calendar op -----

operation isLeapYear
input operation isLeapYear candidateYear Int64
output operation isLeapYear Result Bool TimePredicateError
effect isLeapYear read candidateYear
memory isLeapYear heap no
async isLeapYear no
purpose operation isLeapYear "True iff candidateYear is a leap year under the proleptic Gregorian rule."
label startLeapYear
storage module immutable leapFour Int64 4
storage module immutable leapHundred Int64 100
storage module immutable leapFourHundred Int64 400
storage module immutable leapZero Int64 0
storage module immutable leapTrueSeed Int64 1
storage module immutable leapFalseSeed Int64 0
call leapMod400Call math.moduloInt64
argument leapMod400Call left Int64 candidateYear
argument leapMod400Call right Int64 leapFourHundred
run leapMod400Call
bind value leapMod400 Int64 leapMod400Call
call leapEq400Call math.equalInt64
argument leapEq400Call left Int64 leapMod400
argument leapEq400Call right Int64 leapZero
run leapEq400Call
bind value leapDivisibleBy400 Bool leapEq400Call
branch if condition leapDivisibleBy400 target leapReturnTrue
call leapMod100Call math.moduloInt64
argument leapMod100Call left Int64 candidateYear
argument leapMod100Call right Int64 leapHundred
run leapMod100Call
bind value leapMod100 Int64 leapMod100Call
call leapEq100Call math.equalInt64
argument leapEq100Call left Int64 leapMod100
argument leapEq100Call right Int64 leapZero
run leapEq100Call
bind value leapDivisibleBy100 Bool leapEq100Call
branch if condition leapDivisibleBy100 target leapReturnFalse
call leapMod4Call math.moduloInt64
argument leapMod4Call left Int64 candidateYear
argument leapMod4Call right Int64 leapFour
run leapMod4Call
bind value leapMod4 Int64 leapMod4Call
call leapEq4Call math.equalInt64
argument leapEq4Call left Int64 leapMod4
argument leapEq4Call right Int64 leapZero
run leapEq4Call
bind value leapDivisibleBy4 Bool leapEq4Call
branch if condition leapDivisibleBy4 target leapReturnTrue
label leapReturnFalse
memory isLeapYear mutable leapFalse Bool leapFalseSeed
return ok leapFalse
label leapReturnTrue
memory isLeapYear mutable leapTrue Bool leapTrueSeed
return ok leapTrue

# ----- SemanticScript-bodied retry-delay op -----

operation retryPolicy.delayForAttempt
input operation retryPolicy.delayForAttempt policy RetryPolicy
input operation retryPolicy.delayForAttempt attemptIndex Int64
output operation retryPolicy.delayForAttempt Result DurationMilliseconds RetryPolicyError
effect retryPolicy.delayForAttempt read policy
effect retryPolicy.delayForAttempt read attemptIndex
memory retryPolicy.delayForAttempt heap no
async retryPolicy.delayForAttempt no
purpose operation retryPolicy.delayForAttempt "Compute the delay before retry attempt N using the demo policy's 50ms linear backoff."
label startDelayForAttempt
storage module immutable retryDelayOne Int64 1
storage module immutable retryDelayStepMilliseconds Int64 50
call delayAttemptOrdinalCall math.addInt64
argument delayAttemptOrdinalCall left Int64 attemptIndex
argument delayAttemptOrdinalCall right Int64 retryDelayOne
run delayAttemptOrdinalCall
bind value delayAttemptOrdinal Int64 delayAttemptOrdinalCall
call delayMillisecondsCall math.multiplyInt64
argument delayMillisecondsCall left Int64 delayAttemptOrdinal
argument delayMillisecondsCall right Int64 retryDelayStepMilliseconds
run delayMillisecondsCall
bind value computedDelayMilliseconds DurationMilliseconds delayMillisecondsCall
return ok computedDelayMilliseconds

# ----- SemanticScript-bodied metrics-increment op -----

operation metrics.computeIncrementInt64
input operation metrics.computeIncrementInt64 runtime MetricsRuntime
input operation metrics.computeIncrementInt64 current Int64
input operation metrics.computeIncrementInt64 step Int64
output operation metrics.computeIncrementInt64 Result Int64 MetricsWriteError
effect metrics.computeIncrementInt64 read runtime
effect metrics.computeIncrementInt64 read current
effect metrics.computeIncrementInt64 read step
memory metrics.computeIncrementInt64 heap no
async metrics.computeIncrementInt64 no
purpose operation metrics.computeIncrementInt64 "Compute (current + step) through explicit SemanticScript arithmetic."
label startComputeIncrement
call metricsIncrementAddCall math.addInt64
argument metricsIncrementAddCall left Int64 current
argument metricsIncrementAddCall right Int64 step
run metricsIncrementAddCall
bind value computedIncrement Int64 metricsIncrementAddCall
return ok computedIncrement

# ----- driver -----

operation main
input operation main console Console
output operation main Result ExitCode DemoError
effect main read math
effect main read time
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Call each wired refined-syntax binding once and print its result on its own line."
invariant operation main "Output is the six lines documented at the top of this file."

label startMain

# 1) math.addInt64(2, 3) = 5
storage module immutable twoVal Int64 2
storage module immutable threeVal Int64 3
call addCall math.addInt64
argument addCall left Int64 twoVal
argument addCall right Int64 threeVal
run addCall
bind value addResult Int64 addCall
memory main mutable addVar Int64 twoVal
set memory addVar addResult
call printAddCall console.writeIntegerLine
argument printAddCall console Console console
argument printAddCall value Int64 addVar
run printAddCall
ignore void source printAddCall

# 2) isLeapYear(2024) = 1 (true)
storage module immutable yr2024 Int64 2024
call leapCall isLeapYear
argument leapCall candidateYear Int64 yr2024
run leapCall
bind ok leapResult Bool leapCall
memory main mutable leapVar Int64 twoVal
set memory leapVar leapResult
call printLeapCall console.writeIntegerLine
argument printLeapCall console Console console
argument printLeapCall value Int64 leapVar
run printLeapCall
ignore void source printLeapCall

# 3) compareCString("hello", "hello") = 0
storage module immutable greetLeft String "hello"
storage module immutable greetRight String "hello"
call cmpCall compareCString
argument cmpCall left String greetLeft
argument cmpCall right String greetRight
run cmpCall
bind ok cmpResult Int32 cmpCall
memory main mutable cmpVar Int64 twoVal
set memory cmpVar cmpResult
call printCmpCall console.writeIntegerLine
argument printCmpCall console Console console
argument printCmpCall value Int64 cmpVar
run printCmpCall
ignore void source printCmpCall

# 4) stringByteLength("hello") = 5
storage module immutable greetText String "hello"
call lenCall stringByteLength
argument lenCall inputText String greetText
run lenCall
bind ok lenResult ByteCount lenCall
memory main mutable lenVar Int64 twoVal
set memory lenVar lenResult
call printLenCall console.writeIntegerLine
argument printLenCall console Console console
argument printLenCall value Int64 lenVar
run printLenCall
ignore void source printLenCall

# 5) retryPolicy.delayForAttempt(_, 2) = 150
storage module immutable policyHandle RetryPolicy 0
storage module immutable attemptTwo Int64 2
call delayCall retryPolicy.delayForAttempt
argument delayCall policy RetryPolicy policyHandle
argument delayCall attemptIndex Int64 attemptTwo
run delayCall
bind ok delayResult DurationMilliseconds delayCall
memory main mutable delayVar Int64 twoVal
set memory delayVar delayResult
call printDelayCall console.writeIntegerLine
argument printDelayCall console Console console
argument printDelayCall value Int64 delayVar
run printDelayCall
ignore void source printDelayCall

# 6) metrics.computeIncrementInt64(_, 10, 5) = 15
storage module immutable runtimeHandle MetricsRuntime 0
storage module immutable tenVal Int64 10
storage module immutable fiveVal Int64 5
call incCall metrics.computeIncrementInt64
argument incCall runtime MetricsRuntime runtimeHandle
argument incCall current Int64 tenVal
argument incCall step Int64 fiveVal
run incCall
bind ok incResult Int64 incCall
memory main mutable incVar Int64 twoVal
set memory incVar incResult
call printIncCall console.writeIntegerLine
argument printIncCall console Console console
argument printIncCall value Int64 incVar
run printIncCall
ignore void source printIncCall

storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
