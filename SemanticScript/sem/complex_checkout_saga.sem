set memory lastConsoleWriteErrorCode writeSagaProjectionRejectedLineError
branch error source writeSagaProjectionRejectedLineCall target consoleWriteFailed

call writeSagaProjectionCompensatedLineCall writeStandardOutputLine
argument writeSagaProjectionCompensatedLineCall text String sagaProjectionCompensatedText
run writeSagaProjectionCompensatedLineCall
ignore void source writeSagaProjectionCompensatedLineCall
bind error writeSagaProjectionCompensatedLineError ConsoleWriteError writeSagaProjectionCompensatedLineCall
set memory lastConsoleWriteErrorCode writeSagaProjectionCompensatedLineError
branch error source writeSagaProjectionCompensatedLineCall target consoleWriteFailed
# endGroup sagaProjection

storage local immutable successfulExitCode ExitCode 0
return ok successfulExitCode

label consoleWriteFailed
# rationale: At this point lastConsoleWriteErrorCode holds whichever call
# actually failed (its `set` ran immediately before the corresponding
# branchIfError), so the typed MainError.ConsoleWriteFailed value honestly
# names its cause (Â§12 failure-flow precision).
makeError consoleWriteFailure MainError.ConsoleWriteFailed lastConsoleWriteErrorCode
return error consoleWriteFailure
