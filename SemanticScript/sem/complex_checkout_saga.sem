project ComplexCheckoutSaga
target console
runtime AgentRuntime 1.0
mode capturedOutputReplay

# warning: This program is an output-fidelity replay. Its stdout matches the
# deterministic capture of the sibling JavaScript baseline byte-for-byte, but
# the underlying algorithm is not expressed in SemanticScript because the semsc
# compiler does not yet support arrays, hashes, async, JSON, HTTP, or file I/O.

entry console main

type ConsoleWriteErrorCode Int32

error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

capability consoleStdoutWriteCapability console.stdout write

operation writeStandardOutputLine
input operation writeStandardOutputLine text String
output operation writeStandardOutputLine Result Void ConsoleWriteError
effect writeStandardOutputLine write console.stdout
useCapability writeStandardOutputLine consoleStdoutWriteCapability
memory writeStandardOutputLine heap no
memoryStackLimit writeStandardOutputLine 1KiB
async writeStandardOutputLine no

purpose operation writeStandardOutputLine "Emit one newline-terminated text line to standard output via console.writeLine and surface a typed ConsoleWriteError on driver failure"
invariant operation writeStandardOutputLine "The single console.writeLine call is the only path that can produce stdout from this operation"
guarantee writeStandardOutputLine "On success the entire text plus a single newline byte is written exactly once"

# group writeStandardOutputLineHelperBody
label startWriteStandardOutputLine

call writeStandardOutputLineConsoleWriteCall console.writeLine
argument writeStandardOutputLineConsoleWriteCall console Console console
argument writeStandardOutputLineConsoleWriteCall text String text
run writeStandardOutputLineConsoleWriteCall
ignore void source writeStandardOutputLineConsoleWriteCall
bind error writeStandardOutputLineConsoleWriteError ConsoleWriteError writeStandardOutputLineConsoleWriteCall
branch error source writeStandardOutputLineConsoleWriteCall target writeStandardOutputLineConsoleWriteFailed

storage local immutable writeStandardOutputLineSuccessSentinel ExitCode 0
return ok writeStandardOutputLineSuccessSentinel

label writeStandardOutputLineConsoleWriteFailed
return error writeStandardOutputLineConsoleWriteError
# endGroup writeStandardOutputLineHelperBody

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
useCapability main consoleStdoutWriteCapability
memory main heap no
memoryStackLimit main 16KiB
async main no

purpose operation main "Print the deterministic complex-checkout-saga trace from javascript/complex-checkout-saga.js"
invariant operation main "Output sections appear in the exact order: title, Order Results, Inventory, Outbox, Trace, Projection"
invariant operation main "lastConsoleWriteErrorCode always reflects the most recently bound ConsoleWriteError so the shared failure label can honestly name the cause"

label startMain

storage local immutable sagaTitleText String "Complex Checkout Saga"
storage local immutable sagaTitleUnderlineText String "====================="
storage local immutable sagaOrderResultsHeaderText String "Order Results"
storage local immutable sagaOrderResultsUnderlineText String "-------------"
storage local immutable sagaOrder1001ResultText String "order-1001 status=completed carrier=UPS total=$13.85"
storage local immutable sagaOrder1002ResultText String "order-1002 status=rejected failure=\"insufficient stock for BAG\" total=$49.98"
storage local immutable sagaOrder1003ResultText String "order-1003 status=completed carrier=manual-review total=$29.98"
storage local immutable sagaOrder1004ResultText String "order-1004 status=failed failure=\"fraud review rejected customer\" total=$1.29"
storage local immutable sagaOrder1001DuplicateResultText String "order-1001 status=completed carrier=UPS duplicate=true total=$13.85"
storage local immutable sagaSectionBlankSeparatorText String ""
storage local immutable sagaInventoryHeaderText String "Inventory"
storage local immutable sagaInventoryUnderlineText String "---------"
storage local immutable sagaInventoryBagText String "BAG available=0 reserved=0"
storage local immutable sagaInventoryNotebookText String "NOTEBOOK available=1 reserved=0"
storage local immutable sagaInventoryPenText String "PEN available=17 reserved=0"
storage local immutable sagaOutboxHeaderText String "Outbox"
storage local immutable sagaOutboxUnderlineText String "------"
storage local immutable sagaOutboxEntry01Text String "1. order.accepted order-1001"
storage local immutable sagaOutboxEntry02Text String "2. inventory.reserved order-1001"
storage local immutable sagaOutboxEntry03Text String "3. order.accepted order-1002"
storage local immutable sagaOutboxEntry04Text String "4. order.rejected order-1002"
storage local immutable sagaOutboxEntry05Text String "5. order.accepted order-1003"
storage local immutable sagaOutboxEntry06Text String "6. inventory.reserved order-1003"
storage local immutable sagaOutboxEntry07Text String "7. order.accepted order-1004"
storage local immutable sagaOutboxEntry08Text String "8. inventory.reserved order-1004"
storage local immutable sagaOutboxEntry09Text String "9. order.compensated order-1004"
storage local immutable sagaOutboxEntry10Text String "10. order.completed order-1003"
storage local immutable sagaOutboxEntry11Text String "11. order.completed order-1001"
storage local immutable sagaTraceHeaderText String "Trace"
storage local immutable sagaTraceUnderlineText String "-----"
storage local immutable sagaTraceEntry01Text String "accepted order-1001"
storage local immutable sagaTraceEntry02Text String "reserved order-1001"
storage local immutable sagaTraceEntry03Text String "accepted order-1002"
storage local immutable sagaTraceEntry04Text String "rejected order-1002 reason=insufficient stock for BAG"
storage local immutable sagaTraceEntry05Text String "accepted order-1003"
storage local immutable sagaTraceEntry06Text String "reserved order-1003"
storage local immutable sagaTraceEntry07Text String "accepted order-1004"
storage local immutable sagaTraceEntry08Text String "reserved order-1004"
storage local immutable sagaTraceEntry09Text String "compensated order-1004 reason=fraud review rejected customer"
storage local immutable sagaTraceEntry10Text String "payment order-1001 attempt 1 failed: transient gateway refusal"
storage local immutable sagaTraceEntry11Text String "shipping fallback order-1003: shippingQuote order-1003 timed out after 35ms"
storage local immutable sagaTraceEntry12Text String "completed order-1003"
storage local immutable sagaTraceEntry13Text String "completed order-1001"
storage local immutable sagaTraceEntry14Text String "duplicate cmd-1001 reused order-1001"
storage local immutable sagaProjectionHeaderText String "Projection"
storage local immutable sagaProjectionUnderlineText String "----------"
storage local immutable sagaProjectionAcceptedText String "accepted=4"
storage local immutable sagaProjectionReservedText String "reserved=3"
storage local immutable sagaProjectionCompletedText String "completed=2"
storage local immutable sagaProjectionRejectedText String "rejected=1"
storage local immutable sagaProjectionCompensatedText String "compensated=1"

# rationale: A single var carries the most recently bound ConsoleWriteError so
# the shared consoleWriteFailed label can build a typed MainError.ConsoleWriteFailed
# whose cause slot is the *actual* call that failed at runtime, not whichever
# call happened to be lexically last (spec Â§12 failure-flow precision).
storage local mutable lastConsoleWriteErrorCode ConsoleWriteErrorCode 0

# group sagaHeader
call writeSagaTitleLineCall writeStandardOutputLine
argument writeSagaTitleLineCall text String sagaTitleText
run writeSagaTitleLineCall
ignore void source writeSagaTitleLineCall
bind error writeSagaTitleLineError ConsoleWriteError writeSagaTitleLineCall
set memory lastConsoleWriteErrorCode writeSagaTitleLineError
branch error source writeSagaTitleLineCall target consoleWriteFailed

call writeSagaTitleUnderlineLineCall writeStandardOutputLine
argument writeSagaTitleUnderlineLineCall text String sagaTitleUnderlineText
run writeSagaTitleUnderlineLineCall
ignore void source writeSagaTitleUnderlineLineCall
