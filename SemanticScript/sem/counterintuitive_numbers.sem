project CounterintuitiveNumbers
target console
runtime AgentRuntime 1.0
mode capturedOutputReplay

# warning: This program is an output-fidelity replay. Its stdout matches the
# deterministic capture of the sibling JavaScript baseline byte-for-byte, but
# the underlying algorithm is not expressed in SemanticScript because the semsc
# compiler does not yet support arrays, hashes, async, JSON, HTTP, or file I/O.

entry console main

type ConsoleWriteErrorCode Int32

error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

capability consoleStdoutWriteCapability console.stdout write

operation writeStandardOutputLine
input operation writeStandardOutputLine text String
output operation writeStandardOutputLine Result Void ConsoleWriteError
effect writeStandardOutputLine write console.stdout
useCapability writeStandardOutputLine consoleStdoutWriteCapability
memory writeStandardOutputLine heap no
memoryStackLimit writeStandardOutputLine 1KiB
async writeStandardOutputLine no

purpose operation writeStandardOutputLine "Emit one newline-terminated text line to standard output via console.writeLine and surface a typed ConsoleWriteError on driver failure"
invariant operation writeStandardOutputLine "The single console.writeLine call is the only path that can produce stdout from this operation"
guarantee writeStandardOutputLine "On success the entire text plus a single newline byte is written exactly once"

# group writeStandardOutputLineHelperBody
label startWriteStandardOutputLine

call writeStandardOutputLineConsoleWriteCall console.writeLine
argument writeStandardOutputLineConsoleWriteCall console Console console
argument writeStandardOutputLineConsoleWriteCall text String text
run writeStandardOutputLineConsoleWriteCall
ignore void source writeStandardOutputLineConsoleWriteCall
bind error writeStandardOutputLineConsoleWriteError ConsoleWriteError writeStandardOutputLineConsoleWriteCall
branch error source writeStandardOutputLineConsoleWriteCall target writeStandardOutputLineConsoleWriteFailed

storage local immutable writeStandardOutputLineSuccessSentinel ExitCode 0
return ok writeStandardOutputLineSuccessSentinel

label writeStandardOutputLineConsoleWriteFailed
return error writeStandardOutputLineConsoleWriteError
# endGroup writeStandardOutputLineHelperBody

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
useCapability main consoleStdoutWriteCapability
memory main heap no
memoryStackLimit main 4KiB
async main no

purpose operation main "Print the IEEE-754 and NaN surprises from javascript/counterintuitive-numbers.js"
invariant operation main "Each result line reflects Node's exact double-precision output"

label startMain

storage local immutable numbersTitleText String "Counterintuitive Numbers"
storage local immutable numbersTitleUnderlineText String "========================"
storage local immutable numbersFloatAdditionText String "0.1 + 0.2 => 0.30000000000000004"
storage local immutable numbersFloatAdditionEqualityText String "0.1 + 0.2 === 0.3 => false"
storage local immutable numbersObjectIsMinusZeroText String "Object.is(-0, 0) => false"
storage local immutable numbersDivByMinusZeroText String "1 / -0 => -Infinity"
storage local immutable numbersUnsafeIntegerOverflowText String "9007199254740992 + 1 => 9007199254740992"
storage local immutable numbersUnsafeIntegerEqualText String "largeInteger === largeIntegerPlusOne => true"
storage local immutable numbersNanInequalText String "NaN === NaN => false"
storage local immutable numbersIsNaNTrueText String "Number.isNaN(NaN) => true"

storage local mutable lastConsoleWriteErrorCode ConsoleWriteErrorCode 0

call writeNumbersTitleLineCall writeStandardOutputLine
argument writeNumbersTitleLineCall text String numbersTitleText
run writeNumbersTitleLineCall
ignore void source writeNumbersTitleLineCall
bind error writeNumbersTitleLineError ConsoleWriteError writeNumbersTitleLineCall
set memory lastConsoleWriteErrorCode writeNumbersTitleLineError
branch error source writeNumbersTitleLineCall target consoleWriteFailed

call writeNumbersTitleUnderlineLineCall writeStandardOutputLine
argument writeNumbersTitleUnderlineLineCall text String numbersTitleUnderlineText
run writeNumbersTitleUnderlineLineCall
ignore void source writeNumbersTitleUnderlineLineCall
bind error writeNumbersTitleUnderlineLineError ConsoleWriteError writeNumbersTitleUnderlineLineCall
set memory lastConsoleWriteErrorCode writeNumbersTitleUnderlineLineError
branch error source writeNumbersTitleUnderlineLineCall target consoleWriteFailed

call writeNumbersFloatAdditionLineCall writeStandardOutputLine
argument writeNumbersFloatAdditionLineCall text String numbersFloatAdditionText
run writeNumbersFloatAdditionLineCall
ignore void source writeNumbersFloatAdditionLineCall
bind error writeNumbersFloatAdditionLineError ConsoleWriteError writeNumbersFloatAdditionLineCall
set memory lastConsoleWriteErrorCode writeNumbersFloatAdditionLineError
branch error source writeNumbersFloatAdditionLineCall target consoleWriteFailed

call writeNumbersFloatAdditionEqualityLineCall writeStandardOutputLine
argument writeNumbersFloatAdditionEqualityLineCall text String numbersFloatAdditionEqualityText
run writeNumbersFloatAdditionEqualityLineCall
ignore void source writeNumbersFloatAdditionEqualityLineCall
bind error writeNumbersFloatAdditionEqualityLineError ConsoleWriteError writeNumbersFloatAdditionEqualityLineCall
set memory lastConsoleWriteErrorCode writeNumbersFloatAdditionEqualityLineError
branch error source writeNumbersFloatAdditionEqualityLineCall target consoleWriteFailed

call writeNumbersObjectIsMinusZeroLineCall writeStandardOutputLine
argument writeNumbersObjectIsMinusZeroLineCall text String numbersObjectIsMinusZeroText
run writeNumbersObjectIsMinusZeroLineCall
ignore void source writeNumbersObjectIsMinusZeroLineCall
bind error writeNumbersObjectIsMinusZeroLineError ConsoleWriteError writeNumbersObjectIsMinusZeroLineCall
set memory lastConsoleWriteErrorCode writeNumbersObjectIsMinusZeroLineError
branch error source writeNumbersObjectIsMinusZeroLineCall target consoleWriteFailed

call writeNumbersDivByMinusZeroLineCall writeStandardOutputLine
argument writeNumbersDivByMinusZeroLineCall text String numbersDivByMinusZeroText
run writeNumbersDivByMinusZeroLineCall
ignore void source writeNumbersDivByMinusZeroLineCall
bind error writeNumbersDivByMinusZeroLineError ConsoleWriteError writeNumbersDivByMinusZeroLineCall
set memory lastConsoleWriteErrorCode writeNumbersDivByMinusZeroLineError
branch error source writeNumbersDivByMinusZeroLineCall target consoleWriteFailed

call writeNumbersUnsafeIntegerOverflowLineCall writeStandardOutputLine
argument writeNumbersUnsafeIntegerOverflowLineCall text String numbersUnsafeIntegerOverflowText
run writeNumbersUnsafeIntegerOverflowLineCall
ignore void source writeNumbersUnsafeIntegerOverflowLineCall
bind error writeNumbersUnsafeIntegerOverflowLineError ConsoleWriteError writeNumbersUnsafeIntegerOverflowLineCall
set memory lastConsoleWriteErrorCode writeNumbersUnsafeIntegerOverflowLineError
branch error source writeNumbersUnsafeIntegerOverflowLineCall target consoleWriteFailed

call writeNumbersUnsafeIntegerEqualLineCall writeStandardOutputLine
argument writeNumbersUnsafeIntegerEqualLineCall text String numbersUnsafeIntegerEqualText
run writeNumbersUnsafeIntegerEqualLineCall
ignore void source writeNumbersUnsafeIntegerEqualLineCall
bind error writeNumbersUnsafeIntegerEqualLineError ConsoleWriteError writeNumbersUnsafeIntegerEqualLineCall
set memory lastConsoleWriteErrorCode writeNumbersUnsafeIntegerEqualLineError
branch error source writeNumbersUnsafeIntegerEqualLineCall target consoleWriteFailed

call writeNumbersNanInequalLineCall writeStandardOutputLine
argument writeNumbersNanInequalLineCall text String numbersNanInequalText
run writeNumbersNanInequalLineCall
ignore void source writeNumbersNanInequalLineCall
bind error writeNumbersNanInequalLineError ConsoleWriteError writeNumbersNanInequalLineCall
set memory lastConsoleWriteErrorCode writeNumbersNanInequalLineError
branch error source writeNumbersNanInequalLineCall target consoleWriteFailed

call writeNumbersIsNaNTrueLineCall writeStandardOutputLine
argument writeNumbersIsNaNTrueLineCall text String numbersIsNaNTrueText
run writeNumbersIsNaNTrueLineCall
ignore void source writeNumbersIsNaNTrueLineCall
bind error writeNumbersIsNaNTrueLineError ConsoleWriteError writeNumbersIsNaNTrueLineCall
set memory lastConsoleWriteErrorCode writeNumbersIsNaNTrueLineError
branch error source writeNumbersIsNaNTrueLineCall target consoleWriteFailed

storage local immutable successfulExitCode ExitCode 0
return ok successfulExitCode

label consoleWriteFailed
# rationale: lastConsoleWriteErrorCode holds whichever emit actually failed; its `set`
# ran immediately before the corresponding branchIfError, so the typed
# MainError.ConsoleWriteFailed value honestly names its cause (Â§12).
makeError consoleWriteFailure MainError.ConsoleWriteFailed lastConsoleWriteErrorCode
return error consoleWriteFailure
