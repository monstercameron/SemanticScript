# syntax_sample_sqlite.sscript
#
# Refined-syntax sample for the proposed `standard.sqlite` standard module.
# This file is the canonical reference for what SQLite usage looks like in
# SemanticScript source: it pins the call surface, type universe, capability
# grant, error domain, and effect taxonomy that semsc / semlint / docs/reference/syntax-inventory.md
# must agree on once the compiler wiring lands.
#
# Status: the lowering for `sqlite.*` targets is not in semsc.py yet. The
# vendored amalgamation at third_party/sqlite/ and the C ABI at
# SemanticScript/runtime/native_sqlite/ are the runtime half; once the
# compiler half is wired, this sample becomes the executable smoke for the
# integration (mirrors how syntax_sample_web_server.sscript pins the
# http.* surface today).
#
# Design principles (all inherited from the existing http standard module):
#
#   1. Built-in like standard.http — the user writes one
#      `dependency standard.sqlite version 0.1 source standard` line; the
#      compiler resolves `SqliteDatabase`, `SqliteStatement`, the
#      `SqliteStepResult` / `SqliteColumnType` / `SqliteOpenMode` enums,
#      and the `sqlite.*` calls itself. No dependencyFunction rows are
#      required at the call site, parallel to how http needs none.
#
#   2. Descriptive identifiers, no upstream-SQLite abbreviations —
#      `errmsg` becomes `errorMessage`, `column_bytes` becomes
#      `columnByteCount`, `bind_*` becomes `bind*`. Each name reads
#      cleanly out of context.
#
#   3. ABI-faithful semantics. The SS_SQLITE_OPEN_* flag bits and the
#      SS_SQLITE_STEP_ROW / DONE / SS_SQLITE_COLUMN_* tags from
#      `sem_sqlite_runtime.h` surface as built-in enums whose case values
#      match the C ABI by hand, so lowering is a direct call without a
#      translation table.

project SqliteSyntaxSample
target console
runtime AgentRuntime 0.1

import sqlite standard.sqlite

dependency standard.sqlite version 0.1 source standard
dependencyEffect standard.sqlite readWrite database
dependencyEffect standard.sqlite read filesystem

module app.sqlite_syntax_sample

# ----- proposed built-in types -----
#
# type SqliteDatabase    — opaque connection handle (lowers to i8*)
# type SqliteStatement   — opaque prepared-statement handle (lowers to i8*)
# type SqliteRowId       — Int64 alias for last-insert-rowid values
#
# enum SqliteOpenMode repr Int32
#   readOnlySqliteOpenMode          1     # SS_SQLITE_OPEN_READONLY
#   readWriteSqliteOpenMode         2     # SS_SQLITE_OPEN_READWRITE
#   readWriteCreateSqliteOpenMode   6     # READWRITE | CREATE
#   inMemorySqliteOpenMode         14     # READWRITE | CREATE | MEMORY
#
# enum SqliteStepResult repr Int32
#   rowSqliteStepResult    100               # SS_SQLITE_STEP_ROW
#   doneSqliteStepResult   101               # SS_SQLITE_STEP_DONE
#
# enum SqliteColumnType repr Int32
#   integerSqliteColumnType  1
#   floatSqliteColumnType    2
#   textSqliteColumnType     3
#   blobSqliteColumnType     4
#   nullSqliteColumnType     5
#
# Case names carry the enum role as a suffix (`inMemorySqliteOpenMode`
# rather than bare `inMemory`) so a use site reads as a full role
# identifier — same convention semsc uses for MiddlewareControl.

# ----- error domain -----
#
# Every failing sqlite.* call returns Result<OK, SqliteError>, where
# SqliteError carries the phase that failed and the connection-scoped
# error message (string borrowed from SQLite, valid until the next call
# on the same database — same lifetime contract as the C ABI).

error SqliteError
errorCase SqliteError DatabaseOpenFailed SqliteDatabaseOpenFailure
errorCase SqliteError StatementPrepareFailed SqliteStatementPrepareFailure
errorCase SqliteError StatementBindFailed SqliteStatementBindFailure
errorCase SqliteError StatementStepFailed SqliteStatementStepFailure
errorCase SqliteError StatementResetFailed SqliteStatementResetFailure
errorCase SqliteError StatementFinalizeFailed SqliteStatementFinalizeFailure
errorCase SqliteError DatabaseExecFailed SqliteDatabaseExecFailure
errorCase SqliteError DatabaseCloseFailed SqliteDatabaseCloseFailure
errorCase SqliteError ConsoleWriteFailed ConsoleWriteFailure

# ----- capability -----
#
# A single capability grants the authority to open/read/write a SQLite
# database. Apps that should only read the database (admin scripts,
# read-replicas, healthchecks) can request a narrower `sqliteRead` instead
# once that's wired; the dependencyEffect surface above is the source of
# truth for which authorities are even available.

capability sqliteReadWrite database readWrite
purpose operation sqliteReadWrite "Authority to open SQLite databases and execute reads and writes against them"

capability sqliteSampleStdoutWrite console.stdout write
purpose operation sqliteSampleStdoutWrite "Authority to write the selected row body to standard output as a visible smoke marker"

# ----- constants -----

storage module immutable sqliteSampleDatabasePath String ":memory:"
storage module immutable sqliteSampleCreateTableStatement SqlText
sql body sqliteSampleCreateTableStatement
  CREATE TABLE notes (id INTEGER PRIMARY KEY, body TEXT NOT NULL)
storage module immutable sqliteSampleInsertStatement SqlText
sql body sqliteSampleInsertStatement
  INSERT INTO notes (body) VALUES (?)
storage module immutable sqliteSampleSelectStatement SqlText
sql body sqliteSampleSelectStatement
  SELECT id, body FROM notes WHERE id = ?
storage module immutable sqliteSampleInsertBodyText String "hello from sqlite syntax sample"
storage module immutable sqliteSampleFirstBindParameterIndex Int32 1
storage module immutable sqliteSampleIdentifierColumnIndex Int32 0
storage module immutable sqliteSampleBodyColumnIndex Int32 1

# ----- end-to-end operation -----

entry console runSqliteSyntaxSample

operation runSqliteSyntaxSample
input operation runSqliteSyntaxSample console Console
output operation runSqliteSyntaxSample Result Int32 SqliteError
effect runSqliteSyntaxSample readWrite database
effect runSqliteSyntaxSample write console.stdout
memory runSqliteSyntaxSample arena request
async runSqliteSyntaxSample no

useCapability runSqliteSyntaxSample sqliteReadWrite
useCapability runSqliteSyntaxSample sqliteSampleStdoutWrite

purpose operation runSqliteSyntaxSample "Demonstrate the full proposed sqlite.* surface: open, exec(CREATE), prepare(INSERT), bind, step, finalize, prepare(SELECT), bind, step, read columns, finalize, close — all on an in-memory database so the sample is hermetic"
invariant operation runSqliteSyntaxSample "Every prepared statement is finalized before the database is closed; every successful open is paired with a close on every exit path via defer"
guarantee runSqliteSyntaxSample "On any failure the original SqliteError is propagated unchanged so callers can attribute the failure to a specific phase"
warning runSqliteSyntaxSample "Text returned by sqlite.columnText points into SQLite-owned memory and is only valid until the next call on the same statement; copy if it must outlive the row"

label startRunSqliteSyntaxSample

# rationale: Open an in-memory database in read-write-create mode. The
# in-memory mode keeps the sample hermetic for tests and CI.
call openDatabaseCall sqlite.openDatabase
argument openDatabaseCall path String sqliteSampleDatabasePath
argument openDatabaseCall mode SqliteOpenMode inMemorySqliteOpenMode
run openDatabaseCall
bind ok sampleDatabase SqliteDatabase openDatabaseCall
bind error sampleDatabaseOpenError SqliteDatabaseOpenFailure openDatabaseCall
branch error source openDatabaseCall target sampleDatabaseOpenFailed

# rationale: Pair every successful open with a guaranteed close on all
# return paths via the defer cleanup verb.
defer sampleDatabaseCloseDefer sqlite.closeDatabase sampleDatabase

# rationale: Create the schema with a one-shot exec — no parameters, no
# result rows, so the prepare/step/finalize cycle is unnecessary.
call createNotesTableCall sqlite.exec
argument createNotesTableCall database SqliteDatabase sampleDatabase
argument createNotesTableCall sql SqlText sqliteSampleCreateTableStatement
run createNotesTableCall
ignore void source createNotesTableCall
bind error createNotesTableError SqliteDatabaseExecFailure createNotesTableCall
branch error source createNotesTableCall target sampleCreateTableFailed

# rationale: Prepare the parameterized INSERT once so it can be reused
# (here it's only stepped once, but the cycle illustrates the shape).
call prepareInsertCall sqlite.prepareStatement
argument prepareInsertCall database SqliteDatabase sampleDatabase
argument prepareInsertCall sql SqlText sqliteSampleInsertStatement
run prepareInsertCall
bind ok insertStatement SqliteStatement prepareInsertCall
bind error insertPrepareError SqliteStatementPrepareFailure prepareInsertCall
branch error source prepareInsertCall target sampleInsertPrepareFailed

defer insertStatementFinalizeDefer sqlite.finalizeStatement insertStatement

call bindInsertBodyCall sqlite.bindText
argument bindInsertBodyCall statement SqliteStatement insertStatement
argument bindInsertBodyCall parameterIndex Int32 sqliteSampleFirstBindParameterIndex
argument bindInsertBodyCall value String sqliteSampleInsertBodyText
run bindInsertBodyCall
ignore void source bindInsertBodyCall
bind error bindInsertBodyError SqliteStatementBindFailure bindInsertBodyCall
branch error source bindInsertBodyCall target sampleInsertBindFailed

# rationale: An INSERT step is expected to return SqliteStepResult.done
# (no result rows). Stepping past the boundary is a runtime error.
call stepInsertCall sqlite.stepStatement
argument stepInsertCall statement SqliteStatement insertStatement
run stepInsertCall
ignore ok source stepInsertCall type SqliteStepResult
bind error insertStepError SqliteStatementStepFailure stepInsertCall
branch error source stepInsertCall target sampleInsertStepFailed

# rationale: Capture the rowid before preparing the SELECT so the SELECT
# can bind against the inserted row even after the insert statement is
# finalized.
call lastInsertRowIdCall sqlite.lastInsertRowId
argument lastInsertRowIdCall database SqliteDatabase sampleDatabase
run lastInsertRowIdCall
bind value insertedRowId Int64 lastInsertRowIdCall

call prepareSelectCall sqlite.prepareStatement
argument prepareSelectCall database SqliteDatabase sampleDatabase
argument prepareSelectCall sql SqlText sqliteSampleSelectStatement
run prepareSelectCall
bind ok selectStatement SqliteStatement prepareSelectCall
bind error selectPrepareError SqliteStatementPrepareFailure prepareSelectCall
branch error source prepareSelectCall target sampleSelectPrepareFailed

defer selectStatementFinalizeDefer sqlite.finalizeStatement selectStatement

call bindSelectRowIdCall sqlite.bindInt64
argument bindSelectRowIdCall statement SqliteStatement selectStatement
argument bindSelectRowIdCall parameterIndex Int32 sqliteSampleFirstBindParameterIndex
argument bindSelectRowIdCall value Int64 insertedRowId
run bindSelectRowIdCall
ignore void source bindSelectRowIdCall
bind error bindSelectRowIdError SqliteStatementBindFailure bindSelectRowIdCall
branch error source bindSelectRowIdCall target sampleSelectBindFailed

call stepSelectCall sqlite.stepStatement
argument stepSelectCall statement SqliteStatement selectStatement
run stepSelectCall
ignore ok source stepSelectCall type SqliteStepResult
bind error selectStepError SqliteStatementStepFailure stepSelectCall
branch error source stepSelectCall target sampleSelectStepFailed

# rationale: Read the columns by index. The text pointer is borrowed
# from SQLite-owned memory; the warning attached to this operation
# documents that callers must copy if they need it past the next step.
call readSelectRowIdCall sqlite.columnInt64
argument readSelectRowIdCall statement SqliteStatement selectStatement
argument readSelectRowIdCall columnIndex Int32 sqliteSampleIdentifierColumnIndex
run readSelectRowIdCall
bind value selectedRowId Int64 readSelectRowIdCall

call readSelectBodyCall sqlite.columnText
argument readSelectBodyCall statement SqliteStatement selectStatement
argument readSelectBodyCall columnIndex Int32 sqliteSampleBodyColumnIndex
run readSelectBodyCall
bind value selectedBodyText String readSelectBodyCall

# rationale: Surface the result to stdout so the sample doubles as a
# visible smoke. Real apps would marshal these into a record/codec.
call writeSelectedBodyCall console.writeLine
argument writeSelectedBodyCall console Console console
argument writeSelectedBodyCall text String selectedBodyText
run writeSelectedBodyCall
ignore void source writeSelectedBodyCall
bind error writeSelectedBodyError ConsoleWriteFailure writeSelectedBodyCall
branch error source writeSelectedBodyCall target sampleConsoleWriteFailed

storage module immutable sqliteSampleSuccessExitCode Int32 0
return value sqliteSampleSuccessExitCode

# ----- failure labels: every branch returns the original error so the
# caller can attribute the failure to a specific phase. -----

label sampleDatabaseOpenFailed
makeError sampleDatabaseOpenUmbrellaFailure SqliteError.DatabaseOpenFailed sampleDatabaseOpenError
return error sampleDatabaseOpenUmbrellaFailure

label sampleCreateTableFailed
makeError sampleCreateTableUmbrellaFailure SqliteError.DatabaseExecFailed createNotesTableError
return error sampleCreateTableUmbrellaFailure

label sampleInsertPrepareFailed
makeError sampleInsertPrepareUmbrellaFailure SqliteError.StatementPrepareFailed insertPrepareError
return error sampleInsertPrepareUmbrellaFailure

label sampleInsertBindFailed
makeError sampleInsertBindUmbrellaFailure SqliteError.StatementBindFailed bindInsertBodyError
return error sampleInsertBindUmbrellaFailure

label sampleInsertStepFailed
makeError sampleInsertStepUmbrellaFailure SqliteError.StatementStepFailed insertStepError
return error sampleInsertStepUmbrellaFailure

label sampleSelectPrepareFailed
makeError sampleSelectPrepareUmbrellaFailure SqliteError.StatementPrepareFailed selectPrepareError
return error sampleSelectPrepareUmbrellaFailure

label sampleSelectBindFailed
makeError sampleSelectBindUmbrellaFailure SqliteError.StatementBindFailed bindSelectRowIdError
return error sampleSelectBindUmbrellaFailure

label sampleSelectStepFailed
makeError sampleSelectStepUmbrellaFailure SqliteError.StatementStepFailed selectStepError
return error sampleSelectStepUmbrellaFailure

label sampleConsoleWriteFailed
makeError sampleConsoleWriteUmbrellaFailure SqliteError.ConsoleWriteFailed writeSelectedBodyError
return error sampleConsoleWriteUmbrellaFailure

# ----- tests cross-link the operation by name -----

testCovers runSqliteSyntaxSampleHappyPathTest runSqliteSyntaxSample
testCovers runSqliteSyntaxSampleOpenFailureTest runSqliteSyntaxSample
testCovers runSqliteSyntaxSampleStepFailureTest runSqliteSyntaxSample
