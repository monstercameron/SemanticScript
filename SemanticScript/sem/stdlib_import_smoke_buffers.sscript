# ============================================================
# Second stdlib import-and-use smoke (buffer/array/sort/memory tier)
# ============================================================
#
# rationale: companion to stdlib_import_smoke.sscript. Where that file
#   samples the value-level tiers (logic / ordering / math / time /
#   strings), this file samples the buffer-touching tiers: bytes
#   scans, in-place sort, raw memory ops, deterministic random,
#   plus a representative metadata-cluster check from the constants
#   modules.
#
# invariant: every imported buffer-touching operation must run
#   correctly on a heap allocation we manage from inside this
#   smoke. If any import didn't actually wire through, the call
#   site would fail to typecheck.
#
# security: allocates one 8-byte scratch buffer via c.malloc,
#   exercises imported byte-array ops on it, frees it. No I/O
#   beyond writing "OK" / failure marker on stdout.
#
# timing: dominated by the imported deterministic-random LCG
#   reseed + step (constant cost ~50 i64 ops).
#
# observability: prints "OK\n" on full pass.

project StdlibImportSmokeBuffers
target console
runtime AgentRuntime 0.1
entry console stdlibImportSmokeBuffersMain

error MainError
errorCase MainError StdlibImportBuffersSmokeAssertionFailed
errorCase MainError ConsoleWriteFailed
errorCase MainError MemoryAllocationFailed

# section capability
# rationale: smoke writes an OK line to stdout and allocates / frees
# scratch buffers for sort + LCG state setup transitively through
# imported stdlib modules.
capability stdoutWriteCapability console.stdout write
capability heapAllocationCapability heap allocate
capability heapFreeCapability heap free

# ----- imports under test (different stochastic sample of seven modules) -----
import bytes bytes
import sort sort
import memory memory
import inttypes inttypes
import stdlib stdlib
import random random
import limits limits
import signal signal

operation stdlibImportSmokeBuffersMain
input operation stdlibImportSmokeBuffersMain console Console
output operation stdlibImportSmokeBuffersMain Result ExitCode MainError
useCapability stdlibImportSmokeBuffersMain stdoutWriteCapability
useCapability stdlibImportSmokeBuffersMain heapAllocationCapability
useCapability stdlibImportSmokeBuffersMain heapFreeCapability
effect stdlibImportSmokeBuffersMain write console.stdout
effect stdlibImportSmokeBuffersMain allocate heap
effect stdlibImportSmokeBuffersMain free heap
memory stdlibImportSmokeBuffersMain heap yes
memoryAllocationSource stdlibImportSmokeBuffersMain allocateSortBufferImportCall
async stdlibImportSmokeBuffersMain no
purpose operation stdlibImportSmokeBuffersMain "Exercise one operation from each of bytes, sort, memory, inttypes, stdlib, random, limits, signal — proving the buffer-and-runtime tier of std is importable."
invariant operation stdlibImportSmokeBuffersMain "Every imported assertion holds; final exit 0; stdout is 'OK\\n'."

label startStdlibImportSmokeBuffersMain

# ---- bytes: bytes.contains("hello", 5, 'l') == true ----
storage module immutable helloLiteralForArrayImport String "hello"
storage module immutable fiveByteCountForArrayImport ByteCount 5
storage module immutable lowercaseLByteCodeForArrayImport Int32 108
call assertContainsLowercaseLCall bytes.contains
argument assertContainsLowercaseLCall byteBuffer OpaquePointer helloLiteralForArrayImport
argument assertContainsLowercaseLCall byteCount ByteCount fiveByteCountForArrayImport
argument assertContainsLowercaseLCall targetValue Int32 lowercaseLByteCodeForArrayImport
run assertContainsLowercaseLCall
bind value containsLowercaseLResult Bool assertContainsLowercaseLCall
branch if condition containsLowercaseLResult target containsLowercaseLHolds
branch else target stdlibImportBuffersAssertionFailed
label containsLowercaseLHolds

# ---- bytes: bytes.count("hello", 5, 'l') == 2 ----
storage module immutable expectedTwoLowercaseLs Int64 2
call assertCountLowercaseLCall bytes.count
argument assertCountLowercaseLCall byteBuffer OpaquePointer helloLiteralForArrayImport
argument assertCountLowercaseLCall byteCount ByteCount fiveByteCountForArrayImport
argument assertCountLowercaseLCall targetValue Int32 lowercaseLByteCodeForArrayImport
run assertCountLowercaseLCall
bind value countLowercaseLResult Int64 assertCountLowercaseLCall
call checkCountLowercaseLCall math.equalInt64
argument checkCountLowercaseLCall left Int64 countLowercaseLResult
argument checkCountLowercaseLCall right Int64 expectedTwoLowercaseLs
run checkCountLowercaseLCall
bind value countLowercaseLOk Bool checkCountLowercaseLCall
branch if condition countLowercaseLOk target countLowercaseLHolds
branch else target stdlibImportBuffersAssertionFailed
label countLowercaseLHolds

# ---- memory + sort: allocate buffer, fill with {5,2,8,1,9}, bubble-sort, verify ascending ----
storage module immutable eightBytesAllocImport ByteCount 8
call allocateSortBufferImportCall c.malloc
argument allocateSortBufferImportCall size ByteCount eightBytesAllocImport
run allocateSortBufferImportCall
bind value sortBufferImport OpaquePointer allocateSortBufferImportCall
bind error sortBufferAllocError Int32 allocateSortBufferImportCall
branch error source allocateSortBufferImportCall target sortBufferAllocFailed
defer releaseAllocateSortBufferImportCall c.free sortBufferImport

storage module immutable byteFiveLiteralImport Int32 5
storage module immutable byteTwoLiteralImport Int32 2
storage module immutable byteEightLiteralImport Int32 8
storage module immutable byteOneLiteralImport Int32 1
storage module immutable byteNineLiteralImport Int32 9
storage module immutable offsetZeroByte ByteCount 0
storage module immutable offsetOneByte ByteCount 1
storage module immutable offsetTwoByte ByteCount 2
storage module immutable offsetThreeByte ByteCount 3
storage module immutable offsetFourByte ByteCount 4
storage module immutable totalSortLength ByteCount 5

call storeByteZeroForSortImportCall pointer.storeByte
argument storeByteZeroForSortImportCall buffer OpaquePointer sortBufferImport
argument storeByteZeroForSortImportCall offset ByteCount offsetZeroByte
argument storeByteZeroForSortImportCall value Int32 byteFiveLiteralImport
run storeByteZeroForSortImportCall
call storeByteOneForSortImportCall pointer.storeByte
argument storeByteOneForSortImportCall buffer OpaquePointer sortBufferImport
argument storeByteOneForSortImportCall offset ByteCount offsetOneByte
argument storeByteOneForSortImportCall value Int32 byteTwoLiteralImport
run storeByteOneForSortImportCall
call storeByteTwoForSortImportCall pointer.storeByte
argument storeByteTwoForSortImportCall buffer OpaquePointer sortBufferImport
argument storeByteTwoForSortImportCall offset ByteCount offsetTwoByte
argument storeByteTwoForSortImportCall value Int32 byteEightLiteralImport
run storeByteTwoForSortImportCall
call storeByteThreeForSortImportCall pointer.storeByte
argument storeByteThreeForSortImportCall buffer OpaquePointer sortBufferImport
argument storeByteThreeForSortImportCall offset ByteCount offsetThreeByte
argument storeByteThreeForSortImportCall value Int32 byteOneLiteralImport
run storeByteThreeForSortImportCall
call storeByteFourForSortImportCall pointer.storeByte
argument storeByteFourForSortImportCall buffer OpaquePointer sortBufferImport
argument storeByteFourForSortImportCall offset ByteCount offsetFourByte
argument storeByteFourForSortImportCall value Int32 byteNineLiteralImport
run storeByteFourForSortImportCall

call runImportedBubbleSortCall sortBytesWithBubbleSortInPlace
argument runImportedBubbleSortCall byteBuffer OpaquePointer sortBufferImport
argument runImportedBubbleSortCall byteCount ByteCount totalSortLength
run runImportedBubbleSortCall
ignore value source runImportedBubbleSortCall type ByteCount

call checkSortedAfterImportedSortCall areBytesSortedAscending
argument checkSortedAfterImportedSortCall byteBuffer OpaquePointer sortBufferImport
argument checkSortedAfterImportedSortCall byteCount ByteCount totalSortLength
run checkSortedAfterImportedSortCall
bind value sortedAfterImportResult Bool checkSortedAfterImportedSortCall
branch if condition sortedAfterImportResult target sortedAfterImportHolds
branch else target stdlibImportBuffersAssertionFailed
label sortedAfterImportHolds

# ---- memory: compareMemoryByteRanges of the just-sorted buffer against the byte sequence {1,2,5,8,9} should return 0 ----
# The expected literal is built byte-by-byte because the sorted buffer
# contains raw byte values (0x01..0x09), NOT ASCII characters '1'..'9'.
call allocateExpectedSortedImportCall c.malloc
argument allocateExpectedSortedImportCall size ByteCount eightBytesAllocImport
run allocateExpectedSortedImportCall
bind value expectedSortedBufferImport OpaquePointer allocateExpectedSortedImportCall
bind error expectedSortedAllocError Int32 allocateExpectedSortedImportCall
branch error source allocateExpectedSortedImportCall target expectedSortedAllocFailed
defer releaseAllocateExpectedSortedImportCall c.free expectedSortedBufferImport
call storeExpectedByteZeroCall pointer.storeByte
argument storeExpectedByteZeroCall buffer OpaquePointer expectedSortedBufferImport
argument storeExpectedByteZeroCall offset ByteCount offsetZeroByte
argument storeExpectedByteZeroCall value Int32 byteOneLiteralImport
run storeExpectedByteZeroCall
call storeExpectedByteOneCall pointer.storeByte
argument storeExpectedByteOneCall buffer OpaquePointer expectedSortedBufferImport
argument storeExpectedByteOneCall offset ByteCount offsetOneByte
argument storeExpectedByteOneCall value Int32 byteTwoLiteralImport
run storeExpectedByteOneCall
call storeExpectedByteTwoCall pointer.storeByte
argument storeExpectedByteTwoCall buffer OpaquePointer expectedSortedBufferImport
argument storeExpectedByteTwoCall offset ByteCount offsetTwoByte
argument storeExpectedByteTwoCall value Int32 byteFiveLiteralImport
run storeExpectedByteTwoCall
call storeExpectedByteThreeCall pointer.storeByte
argument storeExpectedByteThreeCall buffer OpaquePointer expectedSortedBufferImport
argument storeExpectedByteThreeCall offset ByteCount offsetThreeByte
argument storeExpectedByteThreeCall value Int32 byteEightLiteralImport
run storeExpectedByteThreeCall
call storeExpectedByteFourCall pointer.storeByte
argument storeExpectedByteFourCall buffer OpaquePointer expectedSortedBufferImport
argument storeExpectedByteFourCall offset ByteCount offsetFourByte
argument storeExpectedByteFourCall value Int32 byteNineLiteralImport
run storeExpectedByteFourCall
storage module immutable zeroSentinelForCompareImport Int64 0
call assertCompareAfterSortCall compareMemoryByteRanges
argument assertCompareAfterSortCall leftBuffer OpaquePointer sortBufferImport
argument assertCompareAfterSortCall rightBuffer OpaquePointer expectedSortedBufferImport
argument assertCompareAfterSortCall byteCount ByteCount totalSortLength
run assertCompareAfterSortCall
bind value compareAfterSortResult Int64 assertCompareAfterSortCall
call checkCompareAfterSortCall math.equalInt64
argument checkCompareAfterSortCall left Int64 compareAfterSortResult
argument checkCompareAfterSortCall right Int64 zeroSentinelForCompareImport
run checkCompareAfterSortCall
bind value compareAfterSortOk Bool checkCompareAfterSortCall
branch if condition compareAfterSortOk target compareAfterSortHolds
branch else target stdlibImportBuffersAssertionFailed
label compareAfterSortHolds

# ---- inttypes: absoluteMaxWidthSignedInt(-9) == 9 ----
storage module immutable negativeNineForAbsImport Int64 -9
storage module immutable nineExpectedForAbsImport Int64 9
call assertImportedAbsCall absoluteMaxWidthSignedInt
argument assertImportedAbsCall inputValue Int64 negativeNineForAbsImport
run assertImportedAbsCall
bind value importedAbsResult Int64 assertImportedAbsCall
call checkImportedAbsCall math.equalInt64
argument checkImportedAbsCall left Int64 importedAbsResult
argument checkImportedAbsCall right Int64 nineExpectedForAbsImport
run checkImportedAbsCall
bind value importedAbsOk Bool checkImportedAbsCall
branch if condition importedAbsOk target importedAbsHolds
branch else target stdlibImportBuffersAssertionFailed
label importedAbsHolds

# ---- stdlib: parseDecimalCStringToSignedInt64("  -42") == -42 ----
storage module immutable negativeFortyTwoTextImport String "  -42"
storage module immutable negativeFortyTwoExpectedImport Int64 -42
call assertParseDecimalImportCall parseDecimalCStringToSignedInt64
argument assertParseDecimalImportCall inputText String negativeFortyTwoTextImport
run assertParseDecimalImportCall
bind value parseDecimalImportResult Int64 assertParseDecimalImportCall
call checkParseDecimalImportCall math.equalInt64
argument checkParseDecimalImportCall left Int64 parseDecimalImportResult
argument checkParseDecimalImportCall right Int64 negativeFortyTwoExpectedImport
run checkParseDecimalImportCall
bind value parseDecimalImportOk Bool checkParseDecimalImportCall
branch if condition parseDecimalImportOk target parseDecimalImportHolds
branch else target stdlibImportBuffersAssertionFailed
label parseDecimalImportHolds

# ---- random: seed with 1, draw, verify 48271 (MINSTD canonical) ----
storage module immutable seedOneForLcgImport Int64 1
call createLcgStateImportCall createDeterministicRandomState
argument createLcgStateImportCall randomSeed Int64 seedOneForLcgImport
run createLcgStateImportCall
bind ok lcgStateSlotImport OpaquePointer createLcgStateImportCall
call drawFromLcgImportCall nextDeterministicRandomSignedInt64
argument drawFromLcgImportCall randomState OpaquePointer lcgStateSlotImport
run drawFromLcgImportCall
bind value lcgFirstDrawImport Int64 drawFromLcgImportCall
storage module immutable minstdFirstDrawExpected Int64 48271
call checkLcgDrawImportCall math.equalInt64
argument checkLcgDrawImportCall left Int64 lcgFirstDrawImport
argument checkLcgDrawImportCall right Int64 minstdFirstDrawExpected
run checkLcgDrawImportCall
bind value lcgDrawImportOk Bool checkLcgDrawImportCall
branch if condition lcgDrawImportOk target lcgDrawImportHolds
branch else target stdlibImportBuffersAssertionFailed
label lcgDrawImportHolds

call releaseLcgStateImportCall releaseDeterministicRandomState
argument releaseLcgStateImportCall randomState OpaquePointer lcgStateSlotImport
run releaseLcgStateImportCall
ignore value source releaseLcgStateImportCall type Int32

# ---- limits: maximumSignedInt32Value == 2147483647 ----
storage module immutable expectedMaximumSignedInt32 Int64 2147483647
call checkImportedLimitMaxInt32Call math.equalInt64
argument checkImportedLimitMaxInt32Call left Int64 maximumSignedInt32Value
argument checkImportedLimitMaxInt32Call right Int64 expectedMaximumSignedInt32
run checkImportedLimitMaxInt32Call
bind value importedLimitMaxInt32Ok Bool checkImportedLimitMaxInt32Call
branch if condition importedLimitMaxInt32Ok target importedLimitMaxInt32Holds
branch else target stdlibImportBuffersAssertionFailed
label importedLimitMaxInt32Holds

# ---- signal: interruptSignalNumber == 2 ----
storage module immutable expectedInterruptSignalNumber Int32 2
call checkImportedInterruptCall math.equalInt64
argument checkImportedInterruptCall left Int64 interruptSignalNumber
argument checkImportedInterruptCall right Int64 expectedInterruptSignalNumber
run checkImportedInterruptCall
bind value importedInterruptOk Bool checkImportedInterruptCall
branch if condition importedInterruptOk target importedInterruptHolds
branch else target stdlibImportBuffersAssertionFailed
label importedInterruptHolds

# All imported assertions held.
storage module immutable buffersImportSuccessMessage String "OK"
call writeBuffersImportSuccessCall console.writeLine
argument writeBuffersImportSuccessCall console Console console
argument writeBuffersImportSuccessCall text String buffersImportSuccessMessage
run writeBuffersImportSuccessCall
ignore ok source writeBuffersImportSuccessCall type Int32
bind error buffersImportConsoleWriteError Int32 writeBuffersImportSuccessCall
branch error source writeBuffersImportSuccessCall target buffersImportConsoleWriteFailed
storage module immutable buffersImportExitOk ExitCode 0
return ok buffersImportExitOk

label buffersImportConsoleWriteFailed
makeError buffersImportConsoleWriteFailure MainError.ConsoleWriteFailed buffersImportConsoleWriteError
return error buffersImportConsoleWriteFailure

# Heap-allocation failure handlers — surface MemoryAllocationFailed
# with the per-call bindError as cause. Each handler is dedicated to
# one malloc so the bindError value is referenced (per SS0106).
label sortBufferAllocFailed
makeError sortBufferAllocFailure MainError.MemoryAllocationFailed sortBufferAllocError
return error sortBufferAllocFailure
label expectedSortedAllocFailed
makeError expectedSortedAllocFailure MainError.MemoryAllocationFailed expectedSortedAllocError
return error expectedSortedAllocFailure

label stdlibImportBuffersAssertionFailed
makeError stdlibImportBuffersFailure MainError.StdlibImportBuffersSmokeAssertionFailed
return error stdlibImportBuffersFailure
