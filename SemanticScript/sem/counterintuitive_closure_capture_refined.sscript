# counterintuitive_closure_capture_refined.sscript
#
# Migration of sem/counterintuitive_closure_capture.sscript to refined syntax.
# Same behavior — print the var-vs-let closure-capture parity table.

section program.counterintuitiveClosureCaptureRefined

project CounterintuitiveClosureCaptureRefined
target console
runtime AgentRuntime 0.1
mode capturedOutputReplay
entry console main

section program.counterintuitiveClosureCaptureRefined.types

type ConsoleWriteErrorCode I32

section program.counterintuitiveClosureCaptureRefined.errors

error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

section program.counterintuitiveClosureCaptureRefined.literals

domainLiteral closureCaptureTitleText String "Counterintuitive Closure Capture"
domainLiteral closureCaptureTitleUnderlineText String "================================"
domainLiteral closureCaptureVarCallbacksText String "var callbacks => 3, 3, 3"
domainLiteral closureCaptureLetCallbacksText String "let callbacks => 0, 1, 2"
domainLiteral closureCaptureFirstAliasOneText String "firstCounterAlias() => 1"
domainLiteral closureCaptureSecondAliasTwoText String "secondCounterAlias() => 2"
domainLiteral closureCaptureFirstAliasThreeText String "firstCounterAlias() again => 3"
storage module immutable successfulExitCode ExitCode 0
storage module immutable writeStandardOutputLineSuccessSentinel ExitCode 0

section program.counterintuitiveClosureCaptureRefined.operations

operation writeStandardOutputLine
input operation writeStandardOutputLine text String
output operation writeStandardOutputLine Result Void ConsoleWriteError
effect writeStandardOutputLine write console.stdout
memory writeStandardOutputLine heap no
memoryStackLimit writeStandardOutputLine 1KiB
async writeStandardOutputLine no
operationBody writeStandardOutputLine sourceTape

purpose operation writeStandardOutputLine "Emit one newline-terminated text line to standard output via console.writeLine and surface a typed ConsoleWriteError on driver failure"
invariant operation writeStandardOutputLine "The single console.writeLine call is the only path that can produce stdout from this operation"
guarantee writeStandardOutputLine "On success the entire text plus a single newline byte is written exactly once"

label startWriteStandardOutputLine

call writeStandardOutputLineConsoleWriteCall console.writeLine
argument writeStandardOutputLineConsoleWriteCall console Console console
argument writeStandardOutputLineConsoleWriteCall text String text
run writeStandardOutputLineConsoleWriteCall
ignore void source writeStandardOutputLineConsoleWriteCall
bind error writeStandardOutputLineConsoleWriteError ConsoleWriteError writeStandardOutputLineConsoleWriteCall
branch error source writeStandardOutputLineConsoleWriteCall target writeStandardOutputLineConsoleWriteFailed

return ok writeStandardOutputLineSuccessSentinel

label writeStandardOutputLineConsoleWriteFailed
return error writeStandardOutputLineConsoleWriteError

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
memoryStackLimit main 4KiB
async main no
operationBody main sourceTape

purpose operation main "Print the var-vs-let closure-capture parity table from javascript/counterintuitive-closure-capture.js"
invariant operation main "Rows print in declared order"

label startMain

memory main mutable lastConsoleWriteErrorCode ConsoleWriteErrorCode 0

call writeClosureCaptureTitleLineCall writeStandardOutputLine
argument writeClosureCaptureTitleLineCall text String closureCaptureTitleText
run writeClosureCaptureTitleLineCall
ignore void source writeClosureCaptureTitleLineCall
bind error writeClosureCaptureTitleLineError ConsoleWriteError writeClosureCaptureTitleLineCall
set memory lastConsoleWriteErrorCode writeClosureCaptureTitleLineError
branch error source writeClosureCaptureTitleLineCall target consoleWriteFailed

call writeClosureCaptureTitleUnderlineLineCall writeStandardOutputLine
argument writeClosureCaptureTitleUnderlineLineCall text String closureCaptureTitleUnderlineText
run writeClosureCaptureTitleUnderlineLineCall
ignore void source writeClosureCaptureTitleUnderlineLineCall
bind error writeClosureCaptureTitleUnderlineLineError ConsoleWriteError writeClosureCaptureTitleUnderlineLineCall
set memory lastConsoleWriteErrorCode writeClosureCaptureTitleUnderlineLineError
branch error source writeClosureCaptureTitleUnderlineLineCall target consoleWriteFailed

call writeClosureCaptureVarCallbacksLineCall writeStandardOutputLine
argument writeClosureCaptureVarCallbacksLineCall text String closureCaptureVarCallbacksText
run writeClosureCaptureVarCallbacksLineCall
ignore void source writeClosureCaptureVarCallbacksLineCall
bind error writeClosureCaptureVarCallbacksLineError ConsoleWriteError writeClosureCaptureVarCallbacksLineCall
set memory lastConsoleWriteErrorCode writeClosureCaptureVarCallbacksLineError
branch error source writeClosureCaptureVarCallbacksLineCall target consoleWriteFailed

call writeClosureCaptureLetCallbacksLineCall writeStandardOutputLine
argument writeClosureCaptureLetCallbacksLineCall text String closureCaptureLetCallbacksText
run writeClosureCaptureLetCallbacksLineCall
ignore void source writeClosureCaptureLetCallbacksLineCall
bind error writeClosureCaptureLetCallbacksLineError ConsoleWriteError writeClosureCaptureLetCallbacksLineCall
set memory lastConsoleWriteErrorCode writeClosureCaptureLetCallbacksLineError
branch error source writeClosureCaptureLetCallbacksLineCall target consoleWriteFailed

call writeClosureCaptureFirstAliasOneLineCall writeStandardOutputLine
argument writeClosureCaptureFirstAliasOneLineCall text String closureCaptureFirstAliasOneText
run writeClosureCaptureFirstAliasOneLineCall
ignore void source writeClosureCaptureFirstAliasOneLineCall
bind error writeClosureCaptureFirstAliasOneLineError ConsoleWriteError writeClosureCaptureFirstAliasOneLineCall
set memory lastConsoleWriteErrorCode writeClosureCaptureFirstAliasOneLineError
branch error source writeClosureCaptureFirstAliasOneLineCall target consoleWriteFailed

call writeClosureCaptureSecondAliasTwoLineCall writeStandardOutputLine
argument writeClosureCaptureSecondAliasTwoLineCall text String closureCaptureSecondAliasTwoText
run writeClosureCaptureSecondAliasTwoLineCall
ignore void source writeClosureCaptureSecondAliasTwoLineCall
bind error writeClosureCaptureSecondAliasTwoLineError ConsoleWriteError writeClosureCaptureSecondAliasTwoLineCall
set memory lastConsoleWriteErrorCode writeClosureCaptureSecondAliasTwoLineError
branch error source writeClosureCaptureSecondAliasTwoLineCall target consoleWriteFailed

call writeClosureCaptureFirstAliasThreeLineCall writeStandardOutputLine
argument writeClosureCaptureFirstAliasThreeLineCall text String closureCaptureFirstAliasThreeText
run writeClosureCaptureFirstAliasThreeLineCall
ignore void source writeClosureCaptureFirstAliasThreeLineCall
bind error writeClosureCaptureFirstAliasThreeLineError ConsoleWriteError writeClosureCaptureFirstAliasThreeLineCall
set memory lastConsoleWriteErrorCode writeClosureCaptureFirstAliasThreeLineError
branch error source writeClosureCaptureFirstAliasThreeLineCall target consoleWriteFailed

return ok successfulExitCode

label consoleWriteFailed
makeError consoleWriteFailure MainError.ConsoleWriteFailed lastConsoleWriteErrorCode
return error consoleWriteFailure
