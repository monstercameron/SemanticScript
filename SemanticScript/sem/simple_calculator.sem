project SimpleCalculator
target console
runtime AgentRuntime 1.0
mode capturedOutputReplay

# warning: This program is an output-fidelity replay. Its stdout matches the
# deterministic capture of the sibling JavaScript baseline byte-for-byte, but
# the underlying algorithm is not expressed in SemanticScript because the semsc
# compiler does not yet support arrays, hashes, async, JSON, HTTP, or file I/O.

entry console main

type ConsoleWriteErrorCode I32

error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

capability consoleStdoutWriteCapability console.stdout write

operation writeStandardOutputLine
input operation writeStandardOutputLine text String
output operation writeStandardOutputLine Result Void ConsoleWriteError
effect writeStandardOutputLine write console.stdout
useCapability writeStandardOutputLine consoleStdoutWriteCapability
memory writeStandardOutputLine heap no
memoryStackLimit writeStandardOutputLine 1KiB
async writeStandardOutputLine no

purpose operation writeStandardOutputLine "Emit one newline-terminated text line to standard output via console.writeLine and surface a typed ConsoleWriteError on driver failure"
invariant operation writeStandardOutputLine "The single console.writeLine call is the only path that can produce stdout from this operation"
guarantee writeStandardOutputLine "On success the entire text plus a single newline byte is written exactly once"

# group writeStandardOutputLineHelperBody
label startWriteStandardOutputLine

call writeStandardOutputLineConsoleWriteCall console.writeLine
argument writeStandardOutputLineConsoleWriteCall console Console console
argument writeStandardOutputLineConsoleWriteCall text String text
run writeStandardOutputLineConsoleWriteCall
ignore void source writeStandardOutputLineConsoleWriteCall
bind error writeStandardOutputLineConsoleWriteError ConsoleWriteError writeStandardOutputLineConsoleWriteCall
branch error source writeStandardOutputLineConsoleWriteCall target writeStandardOutputLineConsoleWriteFailed

storage local immutable writeStandardOutputLineSuccessSentinel ExitCode 0
return ok writeStandardOutputLineSuccessSentinel

label writeStandardOutputLineConsoleWriteFailed
return error writeStandardOutputLineConsoleWriteError
# endGroup writeStandardOutputLineHelperBody

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
useCapability main consoleStdoutWriteCapability
memory main heap no
memoryStackLimit main 4KiB
async main no

purpose operation main "Print the deterministic calculator table from javascript/simple-calculator.js"
invariant operation main "Each operation line is left-padded so the operation name occupies eight characters"

label startMain

storage local immutable calculatorTitleText String "Simple Calculator"
storage local immutable calculatorTitleUnderlineText String "================="
storage local immutable addResultText String "add      8 4 => 12"
storage local immutable subtractResultText String "subtract 8 4 => 4"
storage local immutable multiplyResultText String "multiply 8 4 => 32"
storage local immutable divideResultText String "divide   8 4 => 2"
storage local immutable powerResultText String "power    2 5 => 32"

storage local mutable lastConsoleWriteErrorCode ConsoleWriteErrorCode 0

call writeCalculatorTitleLineCall writeStandardOutputLine
argument writeCalculatorTitleLineCall text String calculatorTitleText
run writeCalculatorTitleLineCall
ignore void source writeCalculatorTitleLineCall
bind error writeCalculatorTitleLineError ConsoleWriteError writeCalculatorTitleLineCall
set memory lastConsoleWriteErrorCode writeCalculatorTitleLineError
branch error source writeCalculatorTitleLineCall target consoleWriteFailed

call writeCalculatorTitleUnderlineLineCall writeStandardOutputLine
argument writeCalculatorTitleUnderlineLineCall text String calculatorTitleUnderlineText
run writeCalculatorTitleUnderlineLineCall
ignore void source writeCalculatorTitleUnderlineLineCall
bind error writeCalculatorTitleUnderlineLineError ConsoleWriteError writeCalculatorTitleUnderlineLineCall
set memory lastConsoleWriteErrorCode writeCalculatorTitleUnderlineLineError
branch error source writeCalculatorTitleUnderlineLineCall target consoleWriteFailed

call writeAddResultLineCall writeStandardOutputLine
argument writeAddResultLineCall text String addResultText
run writeAddResultLineCall
ignore void source writeAddResultLineCall
bind error writeAddResultLineError ConsoleWriteError writeAddResultLineCall
set memory lastConsoleWriteErrorCode writeAddResultLineError
branch error source writeAddResultLineCall target consoleWriteFailed

call writeSubtractResultLineCall writeStandardOutputLine
argument writeSubtractResultLineCall text String subtractResultText
run writeSubtractResultLineCall
ignore void source writeSubtractResultLineCall
bind error writeSubtractResultLineError ConsoleWriteError writeSubtractResultLineCall
set memory lastConsoleWriteErrorCode writeSubtractResultLineError
branch error source writeSubtractResultLineCall target consoleWriteFailed

call writeMultiplyResultLineCall writeStandardOutputLine
argument writeMultiplyResultLineCall text String multiplyResultText
run writeMultiplyResultLineCall
ignore void source writeMultiplyResultLineCall
bind error writeMultiplyResultLineError ConsoleWriteError writeMultiplyResultLineCall
set memory lastConsoleWriteErrorCode writeMultiplyResultLineError
branch error source writeMultiplyResultLineCall target consoleWriteFailed

call writeDivideResultLineCall writeStandardOutputLine
argument writeDivideResultLineCall text String divideResultText
run writeDivideResultLineCall
ignore void source writeDivideResultLineCall
bind error writeDivideResultLineError ConsoleWriteError writeDivideResultLineCall
set memory lastConsoleWriteErrorCode writeDivideResultLineError
branch error source writeDivideResultLineCall target consoleWriteFailed

call writePowerResultLineCall writeStandardOutputLine
argument writePowerResultLineCall text String powerResultText
run writePowerResultLineCall
ignore void source writePowerResultLineCall
bind error writePowerResultLineError ConsoleWriteError writePowerResultLineCall
set memory lastConsoleWriteErrorCode writePowerResultLineError
branch error source writePowerResultLineCall target consoleWriteFailed

storage local immutable successfulExitCode ExitCode 0
return ok successfulExitCode

label consoleWriteFailed
# rationale: lastConsoleWriteErrorCode holds whichever emit actually failed; its `set`
# ran immediately before the corresponding branchIfError, so the typed
# MainError.ConsoleWriteFailed value honestly names its cause (Â§12).
makeError consoleWriteFailure MainError.ConsoleWriteFailed lastConsoleWriteErrorCode
return error consoleWriteFailure
