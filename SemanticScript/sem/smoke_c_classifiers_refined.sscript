# smoke_c_classifiers_refined.sscript
#
# Migration of sem/smoke_c_classifiers.sscript to refined syntax. Verify the
# <math.h> macro-classifiers (isnan/isinf/isfinite/isnormal/signbit/
# fpclassify) lower to LLVM ops rather than libc externs.

section program.smokeCClassifiersRefined

project SmokeCClassifiersRefined
target console
runtime AgentRuntime 0.1
entry console main

section program.smokeCClassifiersRefined.errors

error MainError
errorCase MainError ConsoleWriteFailed Int32

section program.smokeCClassifiersRefined.literals

domainLiteral formatLineText String "isnan(%g)=%d isinf(%g)=%d isfinite(%g)=%d isnormal(%g)=%d signbit(%g)=%d fpclassify(%g)=%d\n"
domainLiteral probeValue Float64 3.14
domainLiteral zeroValue Float64 0.0
storage module immutable successfulExitCode ExitCode 0

section program.smokeCClassifiersRefined.operations

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
memoryStackLimit main 4KiB
async main no
operationBody main sourceTape

purpose operation main "Verify the <math.h> macro-classifiers (isnan/isinf/isfinite/isnormal/signbit/fpclassify) lower to LLVM ops rather than libc externs"
invariant operation main "Each classifier reports the spec-defined int for a representative input"

label startMain

call isnanCall c.isnan
argument isnanCall x Float64 probeValue
run isnanCall
bind value isnanResult Int32 isnanCall

call isinfCall c.isinf
argument isinfCall x Float64 probeValue
run isinfCall
bind value isinfResult Int32 isinfCall

call isfiniteCall c.isfinite
argument isfiniteCall x Float64 probeValue
run isfiniteCall
bind value isfiniteResult Int32 isfiniteCall

call isnormalCall c.isnormal
argument isnormalCall x Float64 probeValue
run isnormalCall
bind value isnormalResult Int32 isnormalCall

call signbitCall c.signbit
argument signbitCall x Float64 probeValue
run signbitCall
bind value signbitResult Int32 signbitCall

call fpclassifyCall c.fpclassify
argument fpclassifyCall x Float64 zeroValue
run fpclassifyCall
bind value fpclassifyResult Int32 fpclassifyCall

call reportCall c.printf
argument reportCall format String formatLineText
argument reportCall isnanX Float64 probeValue
argument reportCall isnanV Int32 isnanResult
argument reportCall isinfX Float64 probeValue
argument reportCall isinfV Int32 isinfResult
argument reportCall isfiniteX Float64 probeValue
argument reportCall isfiniteV Int32 isfiniteResult
argument reportCall isnormalX Float64 probeValue
argument reportCall isnormalV Int32 isnormalResult
argument reportCall signbitX Float64 probeValue
argument reportCall signbitV Int32 signbitResult
argument reportCall fpclassifyX Float64 zeroValue
argument reportCall fpclassifyV Int32 fpclassifyResult
run reportCall
ignore void source reportCall
bind error reportError Int32 reportCall
branch error source reportCall target reportWriteFailed

return ok successfulExitCode

label reportWriteFailed
makeError reportWriteFailure MainError.ConsoleWriteFailed reportError
return error reportWriteFailure
