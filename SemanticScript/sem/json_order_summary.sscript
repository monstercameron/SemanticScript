project JsonOrderSummary
target console
runtime AgentRuntime 0.1
mode capturedOutputReplay

# warning: This program is an output-fidelity replay. Its stdout matches the
# deterministic capture of the sibling JavaScript baseline byte-for-byte, but
# the underlying algorithm is not expressed in SemanticScript because the semsc
# compiler does not yet support arrays, hashes, async, JSON, HTTP, or file I/O.

entry console main

type ConsoleWriteErrorCode Int32

error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

operation writeStandardOutputLine
input operation writeStandardOutputLine text String
output operation writeStandardOutputLine Result Void ConsoleWriteError
effect writeStandardOutputLine write console.stdout
memory writeStandardOutputLine heap no
memory writeStandardOutputLine stack max 1KiB
async writeStandardOutputLine no

purpose operation writeStandardOutputLine "Emit one newline-terminated text line to standard output via console.writeLine and surface a typed ConsoleWriteError on driver failure"
invariant operation writeStandardOutputLine "The single console.writeLine call is the only path that can produce stdout from this operation"
guarantee writeStandardOutputLine "On success the entire text plus a single newline byte is written exactly once"

# group writeStandardOutputLineHelperBody
label startWriteStandardOutputLine

call writeStandardOutputLineConsoleWriteCall console.writeLine
argument writeStandardOutputLineConsoleWriteCall console Console console
argument writeStandardOutputLineConsoleWriteCall text String text
run writeStandardOutputLineConsoleWriteCall
ignore void source writeStandardOutputLineConsoleWriteCall
bind error writeStandardOutputLineConsoleWriteError ConsoleWriteError writeStandardOutputLineConsoleWriteCall
branch error source writeStandardOutputLineConsoleWriteCall target writeStandardOutputLineConsoleWriteFailed

storage module immutable writeStandardOutputLineSuccessSentinel ExitCode 0
return ok writeStandardOutputLineSuccessSentinel

label writeStandardOutputLineConsoleWriteFailed
return error writeStandardOutputLineConsoleWriteError
# endGroup writeStandardOutputLineHelperBody

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
memory main stack max 4KiB
async main no

purpose operation main "Print the deterministic order-summary JSON document from javascript/json-order-summary.js"
invariant operation main "JSON keys appear in the exact order produced by Node's JSON.stringify with two-space indentation"

label startMain

storage module immutable orderSummaryTitleText String "JSON Order Summary"
storage module immutable orderSummaryTitleUnderlineText String "=================="
storage module immutable orderSummaryOpenBraceText String "{"
storage module immutable orderSummaryOrderCountText String "  \"orderCount\": 3,"
storage module immutable orderSummaryTotalCentsText String "  \"totalCents\": 4400,"
storage module immutable orderSummaryCustomerTotalsHeaderText String "  \"customerTotals\": {"
storage module immutable orderSummaryCustomerTotalsAdaText String "    \"Ada\": 1901,"
storage module immutable orderSummaryCustomerTotalsGraceText String "    \"Grace\": 2499"
storage module immutable orderSummaryCustomerTotalsCloseText String "  },"
storage module immutable orderSummaryOrderTotalsHeaderText String "  \"orderTotals\": ["
storage module immutable orderSummaryOrderTotalsOrder1001OpenText String "    {"
storage module immutable orderSummaryOrderTotalsOrder1001IdText String "      \"id\": \"order-1001\","
storage module immutable orderSummaryOrderTotalsOrder1001CustomerText String "      \"customer\": \"Ada\","
storage module immutable orderSummaryOrderTotalsOrder1001TotalCentsText String "      \"totalCents\": 1643"
storage module immutable orderSummaryOrderTotalsOrder1001CloseText String "    },"
storage module immutable orderSummaryOrderTotalsOrder1002OpenText String "    {"
storage module immutable orderSummaryOrderTotalsOrder1002IdText String "      \"id\": \"order-1002\","
storage module immutable orderSummaryOrderTotalsOrder1002CustomerText String "      \"customer\": \"Grace\","
storage module immutable orderSummaryOrderTotalsOrder1002TotalCentsText String "      \"totalCents\": 2499"
storage module immutable orderSummaryOrderTotalsOrder1002CloseText String "    },"
storage module immutable orderSummaryOrderTotalsOrder1003OpenText String "    {"
storage module immutable orderSummaryOrderTotalsOrder1003IdText String "      \"id\": \"order-1003\","
storage module immutable orderSummaryOrderTotalsOrder1003CustomerText String "      \"customer\": \"Ada\","
storage module immutable orderSummaryOrderTotalsOrder1003TotalCentsText String "      \"totalCents\": 258"
storage module immutable orderSummaryOrderTotalsOrder1003CloseText String "    }"
storage module immutable orderSummaryOrderTotalsCloseText String "  ]"
storage module immutable orderSummaryCloseBraceText String "}"

memory main mutable lastConsoleWriteErrorCode ConsoleWriteErrorCode 0

call writeOrderSummaryTitleLineCall writeStandardOutputLine
argument writeOrderSummaryTitleLineCall text String orderSummaryTitleText
run writeOrderSummaryTitleLineCall
ignore void source writeOrderSummaryTitleLineCall
bind error writeOrderSummaryTitleLineError ConsoleWriteError writeOrderSummaryTitleLineCall
set memory lastConsoleWriteErrorCode writeOrderSummaryTitleLineError
branch error source writeOrderSummaryTitleLineCall target consoleWriteFailed

