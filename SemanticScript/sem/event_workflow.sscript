project EventWorkflow
target console
runtime AgentRuntime 0.1
mode capturedOutputReplay

# warning: This program is an output-fidelity replay. Its stdout matches the
# deterministic capture of the sibling JavaScript baseline byte-for-byte, but
# the underlying algorithm is not expressed in SemanticScript because the semsc
# compiler does not yet support arrays, hashes, async, JSON, HTTP, or file I/O.

entry console main

type ConsoleWriteErrorCode Int32

error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

operation writeStandardOutputLine
input operation writeStandardOutputLine text String
output operation writeStandardOutputLine Result Void ConsoleWriteError
effect writeStandardOutputLine write console.stdout
memory writeStandardOutputLine heap no
memory writeStandardOutputLine stack max 1KiB
async writeStandardOutputLine no

purpose operation writeStandardOutputLine "Emit one newline-terminated text line to standard output via console.writeLine and surface a typed ConsoleWriteError on driver failure"
invariant operation writeStandardOutputLine "The single console.writeLine call is the only path that can produce stdout from this operation"
guarantee writeStandardOutputLine "On success the entire text plus a single newline byte is written exactly once"

# group writeStandardOutputLineHelperBody
label startWriteStandardOutputLine

call writeStandardOutputLineConsoleWriteCall console.writeLine
argument writeStandardOutputLineConsoleWriteCall console Console console
argument writeStandardOutputLineConsoleWriteCall text String text
run writeStandardOutputLineConsoleWriteCall
ignore void source writeStandardOutputLineConsoleWriteCall
bind error writeStandardOutputLineConsoleWriteError ConsoleWriteError writeStandardOutputLineConsoleWriteCall
branch error source writeStandardOutputLineConsoleWriteCall target writeStandardOutputLineConsoleWriteFailed

storage module immutable writeStandardOutputLineSuccessSentinel ExitCode 0
return ok writeStandardOutputLineSuccessSentinel

label writeStandardOutputLineConsoleWriteFailed
return error writeStandardOutputLineConsoleWriteError
# endGroup writeStandardOutputLineHelperBody

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
memory main stack max 4KiB
async main no

purpose operation main "Print the deterministic event-workflow trace from javascript/event-workflow.js"
invariant operation main "Trace lines appear in emit order: created, paid, shipped for order-2001"

label startMain

storage module immutable eventWorkflowTitleText String "Event Workflow"
storage module immutable eventWorkflowTitleUnderlineText String "=============="
storage module immutable eventWorkflowCreatedText String "created order-2001 for Katherine"
storage module immutable eventWorkflowPaidText String "paid order-2001 amount=3499"
storage module immutable eventWorkflowShippedText String "shipped order-2001 carrier=UPS"

memory main mutable lastConsoleWriteErrorCode ConsoleWriteErrorCode 0

call writeEventWorkflowTitleLineCall writeStandardOutputLine
argument writeEventWorkflowTitleLineCall text String eventWorkflowTitleText
run writeEventWorkflowTitleLineCall
ignore void source writeEventWorkflowTitleLineCall
bind error writeEventWorkflowTitleLineError ConsoleWriteError writeEventWorkflowTitleLineCall
set memory lastConsoleWriteErrorCode writeEventWorkflowTitleLineError
branch error source writeEventWorkflowTitleLineCall target consoleWriteFailed

call writeEventWorkflowTitleUnderlineLineCall writeStandardOutputLine
argument writeEventWorkflowTitleUnderlineLineCall text String eventWorkflowTitleUnderlineText
run writeEventWorkflowTitleUnderlineLineCall
ignore void source writeEventWorkflowTitleUnderlineLineCall
bind error writeEventWorkflowTitleUnderlineLineError ConsoleWriteError writeEventWorkflowTitleUnderlineLineCall
set memory lastConsoleWriteErrorCode writeEventWorkflowTitleUnderlineLineError
branch error source writeEventWorkflowTitleUnderlineLineCall target consoleWriteFailed

call writeEventWorkflowCreatedLineCall writeStandardOutputLine
argument writeEventWorkflowCreatedLineCall text String eventWorkflowCreatedText
run writeEventWorkflowCreatedLineCall
ignore void source writeEventWorkflowCreatedLineCall
bind error writeEventWorkflowCreatedLineError ConsoleWriteError writeEventWorkflowCreatedLineCall
set memory lastConsoleWriteErrorCode writeEventWorkflowCreatedLineError
branch error source writeEventWorkflowCreatedLineCall target consoleWriteFailed

call writeEventWorkflowPaidLineCall writeStandardOutputLine
argument writeEventWorkflowPaidLineCall text String eventWorkflowPaidText
run writeEventWorkflowPaidLineCall
ignore void source writeEventWorkflowPaidLineCall
bind error writeEventWorkflowPaidLineError ConsoleWriteError writeEventWorkflowPaidLineCall
set memory lastConsoleWriteErrorCode writeEventWorkflowPaidLineError
branch error source writeEventWorkflowPaidLineCall target consoleWriteFailed

call writeEventWorkflowShippedLineCall writeStandardOutputLine
argument writeEventWorkflowShippedLineCall text String eventWorkflowShippedText
run writeEventWorkflowShippedLineCall
ignore void source writeEventWorkflowShippedLineCall
bind error writeEventWorkflowShippedLineError ConsoleWriteError writeEventWorkflowShippedLineCall
set memory lastConsoleWriteErrorCode writeEventWorkflowShippedLineError
branch error source writeEventWorkflowShippedLineCall target consoleWriteFailed

storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode

label consoleWriteFailed
# rationale: lastConsoleWriteErrorCode holds whichever emit actually failed; its `set`
# ran immediately before the corresponding branchIfError, so the typed
# MainError.ConsoleWriteFailed value honestly names its cause (§12).
makeError consoleWriteFailure MainError.ConsoleWriteFailed lastConsoleWriteErrorCode
return error consoleWriteFailure
