project EsotericStackLanguage
target console
runtime AgentRuntime 0.1
mode capturedOutputReplay

# warning: This program is an output-fidelity replay. Its stdout matches the
# deterministic capture of the sibling JavaScript baseline byte-for-byte, but
# the underlying algorithm is not expressed in SemanticScript because the semsc
# compiler does not yet support arrays, hashes, async, JSON, HTTP, or file I/O.

entry console main

type ConsoleWriteErrorCode I32

error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

operation writeStandardOutputLine
input writeStandardOutputLine text String
output writeStandardOutputLine Result Void ConsoleWriteError
effect writeStandardOutputLine write console.stdout
memory writeStandardOutputLine heap no
memory writeStandardOutputLine stack max 1KiB
async writeStandardOutputLine no

purpose writeStandardOutputLine "Emit one newline-terminated text line to standard output via console.writeLine and surface a typed ConsoleWriteError on driver failure"
invariant writeStandardOutputLine "The single console.writeLine call is the only path that can produce stdout from this operation"
guarantee writeStandardOutputLine "On success the entire text plus a single newline byte is written exactly once"

# group writeStandardOutputLineHelperBody
label startWriteStandardOutputLine

call writeStandardOutputLineConsoleWriteCall console.writeLine
arg writeStandardOutputLineConsoleWriteCall console console
arg writeStandardOutputLineConsoleWriteCall text text
run writeStandardOutputLineConsoleWriteCall
ignoreOk writeStandardOutputLineConsoleWriteCall Void
bindError writeStandardOutputLineConsoleWriteError ConsoleWriteError writeStandardOutputLineConsoleWriteCall
branchIfError writeStandardOutputLineConsoleWriteCall writeStandardOutputLineConsoleWriteFailed

const writeStandardOutputLineSuccessSentinel ExitCode 0
returnOk writeStandardOutputLineSuccessSentinel

label writeStandardOutputLineConsoleWriteFailed
returnError writeStandardOutputLineConsoleWriteError
# endGroup writeStandardOutputLineHelperBody

operation main
input main console Console
output main Result ExitCode MainError
effect main write console.stdout
memory main heap no
memory main stack max 4KiB
async main no

purpose main "Print the Forth-style interpreter session output from javascript/esoteric-stack-language.js"
invariant main "Output preserves the four print results followed by the empty final stack depth"

label startMain

const stackLangTitleText String "Esoteric Stack Language"
const stackLangTitleUnderlineText String "======================="
const stackLangSourceHeaderText String "source:"
const stackLangSourceSquareText String ": square dup * ;"
const stackLangSourceCubeText String ": cube dup dup * * ;"
const stackLangSourceAverageText String ": average + 2 / ;"
const stackLangSourceCallSquareText String "5 square print"
const stackLangSourceCallCubeText String "3 cube print"
const stackLangSourceCallAverageText String "9 3 average print"
const stackLangSourceSwapSubtractText String "7 4 swap - print"
const stackLangOutputHeaderText String "output:"
const stackLangOutputSquareText String "25"
const stackLangOutputCubeText String "27"
const stackLangOutputAverageText String "6"
const stackLangOutputSwapSubtractText String "-3"
const stackLangFinalStackDepthText String "finalStackDepth: 0"

var lastConsoleWriteErrorCode ConsoleWriteErrorCode 0

call writeStackLangTitleLineCall writeStandardOutputLine
arg writeStackLangTitleLineCall text stackLangTitleText
run writeStackLangTitleLineCall
ignoreOk writeStackLangTitleLineCall Void
bindError writeStackLangTitleLineError ConsoleWriteError writeStackLangTitleLineCall
set lastConsoleWriteErrorCode writeStackLangTitleLineError
branchIfError writeStackLangTitleLineCall consoleWriteFailed

call writeStackLangTitleUnderlineLineCall writeStandardOutputLine
arg writeStackLangTitleUnderlineLineCall text stackLangTitleUnderlineText
run writeStackLangTitleUnderlineLineCall
ignoreOk writeStackLangTitleUnderlineLineCall Void
bindError writeStackLangTitleUnderlineLineError ConsoleWriteError writeStackLangTitleUnderlineLineCall
set lastConsoleWriteErrorCode writeStackLangTitleUnderlineLineError
branchIfError writeStackLangTitleUnderlineLineCall consoleWriteFailed

call writeStackLangSourceHeaderLineCall writeStandardOutputLine
arg writeStackLangSourceHeaderLineCall text stackLangSourceHeaderText
run writeStackLangSourceHeaderLineCall
ignoreOk writeStackLangSourceHeaderLineCall Void
bindError writeStackLangSourceHeaderLineError ConsoleWriteError writeStackLangSourceHeaderLineCall
set lastConsoleWriteErrorCode writeStackLangSourceHeaderLineError
branchIfError writeStackLangSourceHeaderLineCall consoleWriteFailed

call writeStackLangSourceSquareLineCall writeStandardOutputLine
arg writeStackLangSourceSquareLineCall text stackLangSourceSquareText
run writeStackLangSourceSquareLineCall
ignoreOk writeStackLangSourceSquareLineCall Void
bindError writeStackLangSourceSquareLineError ConsoleWriteError writeStackLangSourceSquareLineCall
set lastConsoleWriteErrorCode writeStackLangSourceSquareLineError
branchIfError writeStackLangSourceSquareLineCall consoleWriteFailed

call writeStackLangSourceCubeLineCall writeStandardOutputLine
arg writeStackLangSourceCubeLineCall text stackLangSourceCubeText
run writeStackLangSourceCubeLineCall
ignoreOk writeStackLangSourceCubeLineCall Void
bindError writeStackLangSourceCubeLineError ConsoleWriteError writeStackLangSourceCubeLineCall
set lastConsoleWriteErrorCode writeStackLangSourceCubeLineError
branchIfError writeStackLangSourceCubeLineCall consoleWriteFailed

call writeStackLangSourceAverageLineCall writeStandardOutputLine
arg writeStackLangSourceAverageLineCall text stackLangSourceAverageText
run writeStackLangSourceAverageLineCall
ignoreOk writeStackLangSourceAverageLineCall Void
bindError writeStackLangSourceAverageLineError ConsoleWriteError writeStackLangSourceAverageLineCall
set lastConsoleWriteErrorCode writeStackLangSourceAverageLineError
branchIfError writeStackLangSourceAverageLineCall consoleWriteFailed

call writeStackLangSourceCallSquareLineCall writeStandardOutputLine
arg writeStackLangSourceCallSquareLineCall text stackLangSourceCallSquareText
run writeStackLangSourceCallSquareLineCall
ignoreOk writeStackLangSourceCallSquareLineCall Void
bindError writeStackLangSourceCallSquareLineError ConsoleWriteError writeStackLangSourceCallSquareLineCall
set lastConsoleWriteErrorCode writeStackLangSourceCallSquareLineError
branchIfError writeStackLangSourceCallSquareLineCall consoleWriteFailed

call writeStackLangSourceCallCubeLineCall writeStandardOutputLine
arg writeStackLangSourceCallCubeLineCall text stackLangSourceCallCubeText
run writeStackLangSourceCallCubeLineCall
ignoreOk writeStackLangSourceCallCubeLineCall Void
bindError writeStackLangSourceCallCubeLineError ConsoleWriteError writeStackLangSourceCallCubeLineCall
set lastConsoleWriteErrorCode writeStackLangSourceCallCubeLineError
branchIfError writeStackLangSourceCallCubeLineCall consoleWriteFailed

call writeStackLangSourceCallAverageLineCall writeStandardOutputLine
arg writeStackLangSourceCallAverageLineCall text stackLangSourceCallAverageText
run writeStackLangSourceCallAverageLineCall
ignoreOk writeStackLangSourceCallAverageLineCall Void
bindError writeStackLangSourceCallAverageLineError ConsoleWriteError writeStackLangSourceCallAverageLineCall
set lastConsoleWriteErrorCode writeStackLangSourceCallAverageLineError
branchIfError writeStackLangSourceCallAverageLineCall consoleWriteFailed

call writeStackLangSourceSwapSubtractLineCall writeStandardOutputLine
arg writeStackLangSourceSwapSubtractLineCall text stackLangSourceSwapSubtractText
run writeStackLangSourceSwapSubtractLineCall
ignoreOk writeStackLangSourceSwapSubtractLineCall Void
bindError writeStackLangSourceSwapSubtractLineError ConsoleWriteError writeStackLangSourceSwapSubtractLineCall
set lastConsoleWriteErrorCode writeStackLangSourceSwapSubtractLineError
branchIfError writeStackLangSourceSwapSubtractLineCall consoleWriteFailed

call writeStackLangOutputHeaderLineCall writeStandardOutputLine
arg writeStackLangOutputHeaderLineCall text stackLangOutputHeaderText
run writeStackLangOutputHeaderLineCall
ignoreOk writeStackLangOutputHeaderLineCall Void
bindError writeStackLangOutputHeaderLineError ConsoleWriteError writeStackLangOutputHeaderLineCall
set lastConsoleWriteErrorCode writeStackLangOutputHeaderLineError
branchIfError writeStackLangOutputHeaderLineCall consoleWriteFailed

call writeStackLangOutputSquareLineCall writeStandardOutputLine
arg writeStackLangOutputSquareLineCall text stackLangOutputSquareText
run writeStackLangOutputSquareLineCall
ignoreOk writeStackLangOutputSquareLineCall Void
bindError writeStackLangOutputSquareLineError ConsoleWriteError writeStackLangOutputSquareLineCall
set lastConsoleWriteErrorCode writeStackLangOutputSquareLineError
branchIfError writeStackLangOutputSquareLineCall consoleWriteFailed

call writeStackLangOutputCubeLineCall writeStandardOutputLine
arg writeStackLangOutputCubeLineCall text stackLangOutputCubeText
run writeStackLangOutputCubeLineCall
ignoreOk writeStackLangOutputCubeLineCall Void
bindError writeStackLangOutputCubeLineError ConsoleWriteError writeStackLangOutputCubeLineCall
set lastConsoleWriteErrorCode writeStackLangOutputCubeLineError
branchIfError writeStackLangOutputCubeLineCall consoleWriteFailed

call writeStackLangOutputAverageLineCall writeStandardOutputLine
arg writeStackLangOutputAverageLineCall text stackLangOutputAverageText
run writeStackLangOutputAverageLineCall
ignoreOk writeStackLangOutputAverageLineCall Void
bindError writeStackLangOutputAverageLineError ConsoleWriteError writeStackLangOutputAverageLineCall
set lastConsoleWriteErrorCode writeStackLangOutputAverageLineError
branchIfError writeStackLangOutputAverageLineCall consoleWriteFailed

call writeStackLangOutputSwapSubtractLineCall writeStandardOutputLine
arg writeStackLangOutputSwapSubtractLineCall text stackLangOutputSwapSubtractText
run writeStackLangOutputSwapSubtractLineCall
ignoreOk writeStackLangOutputSwapSubtractLineCall Void
bindError writeStackLangOutputSwapSubtractLineError ConsoleWriteError writeStackLangOutputSwapSubtractLineCall
set lastConsoleWriteErrorCode writeStackLangOutputSwapSubtractLineError
branchIfError writeStackLangOutputSwapSubtractLineCall consoleWriteFailed

call writeStackLangFinalStackDepthLineCall writeStandardOutputLine
arg writeStackLangFinalStackDepthLineCall text stackLangFinalStackDepthText
run writeStackLangFinalStackDepthLineCall
ignoreOk writeStackLangFinalStackDepthLineCall Void
bindError writeStackLangFinalStackDepthLineError ConsoleWriteError writeStackLangFinalStackDepthLineCall
set lastConsoleWriteErrorCode writeStackLangFinalStackDepthLineError
branchIfError writeStackLangFinalStackDepthLineCall consoleWriteFailed

const successfulExitCode ExitCode 0
returnOk successfulExitCode

label consoleWriteFailed
# rationale: lastConsoleWriteErrorCode holds whichever emit actually failed; its `set`
# ran immediately before the corresponding branchIfError, so the typed
# MainError.ConsoleWriteFailed value honestly names its cause (§12).
makeError consoleWriteFailure MainError.ConsoleWriteFailed lastConsoleWriteErrorCode
returnError consoleWriteFailure
