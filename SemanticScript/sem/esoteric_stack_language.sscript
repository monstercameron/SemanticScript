project EsotericStackLanguage
target console
runtime AgentRuntime 0.1
mode capturedOutputReplay

# warning: This program is an output-fidelity replay. Its stdout matches the
# deterministic capture of the sibling JavaScript baseline byte-for-byte, but
# the underlying algorithm is not expressed in SemanticScript because the semsc
# compiler does not yet support arrays, hashes, async, JSON, HTTP, or file I/O.

entry console main

type ConsoleWriteErrorCode Int32

error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

operation writeStandardOutputLine
input operation writeStandardOutputLine text String
output operation writeStandardOutputLine Result Void ConsoleWriteError
effect writeStandardOutputLine write console.stdout
memory writeStandardOutputLine heap no
memory writeStandardOutputLine stack max 1KiB
async writeStandardOutputLine no

purpose operation writeStandardOutputLine "Emit one newline-terminated text line to standard output via console.writeLine and surface a typed ConsoleWriteError on driver failure"
invariant operation writeStandardOutputLine "The single console.writeLine call is the only path that can produce stdout from this operation"
guarantee writeStandardOutputLine "On success the entire text plus a single newline byte is written exactly once"

# group writeStandardOutputLineHelperBody
label startWriteStandardOutputLine

call writeStandardOutputLineConsoleWriteCall console.writeLine
argument writeStandardOutputLineConsoleWriteCall console Console console
argument writeStandardOutputLineConsoleWriteCall text String text
run writeStandardOutputLineConsoleWriteCall
ignore void source writeStandardOutputLineConsoleWriteCall
bind error writeStandardOutputLineConsoleWriteError ConsoleWriteError writeStandardOutputLineConsoleWriteCall
branch error source writeStandardOutputLineConsoleWriteCall target writeStandardOutputLineConsoleWriteFailed

storage module immutable writeStandardOutputLineSuccessSentinel ExitCode 0
return ok writeStandardOutputLineSuccessSentinel

label writeStandardOutputLineConsoleWriteFailed
return error writeStandardOutputLineConsoleWriteError
# endGroup writeStandardOutputLineHelperBody

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
memory main stack max 4KiB
async main no

purpose operation main "Print the Forth-style interpreter session output from javascript/esoteric-stack-language.js"
invariant operation main "Output preserves the four print results followed by the empty final stack depth"

label startMain

storage module immutable stackLangTitleText String "Esoteric Stack Language"
storage module immutable stackLangTitleUnderlineText String "======================="
storage module immutable stackLangSourceHeaderText String "source:"
storage module immutable stackLangSourceSquareText String ": square dup * ;"
storage module immutable stackLangSourceCubeText String ": cube dup dup * * ;"
storage module immutable stackLangSourceAverageText String ": average + 2 / ;"
storage module immutable stackLangSourceCallSquareText String "5 square print"
storage module immutable stackLangSourceCallCubeText String "3 cube print"
storage module immutable stackLangSourceCallAverageText String "9 3 average print"
storage module immutable stackLangSourceSwapSubtractText String "7 4 swap - print"
storage module immutable stackLangOutputHeaderText String "output:"
storage module immutable stackLangOutputSquareText String "25"
storage module immutable stackLangOutputCubeText String "27"
storage module immutable stackLangOutputAverageText String "6"
storage module immutable stackLangOutputSwapSubtractText String "-3"
storage module immutable stackLangFinalStackDepthText String "finalStackDepth: 0"

memory main mutable lastConsoleWriteErrorCode ConsoleWriteErrorCode 0

call writeStackLangTitleLineCall writeStandardOutputLine
argument writeStackLangTitleLineCall text String stackLangTitleText
run writeStackLangTitleLineCall
ignore void source writeStackLangTitleLineCall
bind error writeStackLangTitleLineError ConsoleWriteError writeStackLangTitleLineCall
set memory lastConsoleWriteErrorCode writeStackLangTitleLineError
branch error source writeStackLangTitleLineCall target consoleWriteFailed

call writeStackLangTitleUnderlineLineCall writeStandardOutputLine
argument writeStackLangTitleUnderlineLineCall text String stackLangTitleUnderlineText
run writeStackLangTitleUnderlineLineCall
ignore void source writeStackLangTitleUnderlineLineCall
bind error writeStackLangTitleUnderlineLineError ConsoleWriteError writeStackLangTitleUnderlineLineCall
set memory lastConsoleWriteErrorCode writeStackLangTitleUnderlineLineError
branch error source writeStackLangTitleUnderlineLineCall target consoleWriteFailed

call writeStackLangSourceHeaderLineCall writeStandardOutputLine
argument writeStackLangSourceHeaderLineCall text String stackLangSourceHeaderText
run writeStackLangSourceHeaderLineCall
ignore void source writeStackLangSourceHeaderLineCall
bind error writeStackLangSourceHeaderLineError ConsoleWriteError writeStackLangSourceHeaderLineCall
set memory lastConsoleWriteErrorCode writeStackLangSourceHeaderLineError
branch error source writeStackLangSourceHeaderLineCall target consoleWriteFailed

call writeStackLangSourceSquareLineCall writeStandardOutputLine
argument writeStackLangSourceSquareLineCall text String stackLangSourceSquareText
run writeStackLangSourceSquareLineCall
ignore void source writeStackLangSourceSquareLineCall
bind error writeStackLangSourceSquareLineError ConsoleWriteError writeStackLangSourceSquareLineCall
set memory lastConsoleWriteErrorCode writeStackLangSourceSquareLineError
branch error source writeStackLangSourceSquareLineCall target consoleWriteFailed

call writeStackLangSourceCubeLineCall writeStandardOutputLine
argument writeStackLangSourceCubeLineCall text String stackLangSourceCubeText
run writeStackLangSourceCubeLineCall
ignore void source writeStackLangSourceCubeLineCall
bind error writeStackLangSourceCubeLineError ConsoleWriteError writeStackLangSourceCubeLineCall
set memory lastConsoleWriteErrorCode writeStackLangSourceCubeLineError
branch error source writeStackLangSourceCubeLineCall target consoleWriteFailed

call writeStackLangSourceAverageLineCall writeStandardOutputLine
argument writeStackLangSourceAverageLineCall text String stackLangSourceAverageText
run writeStackLangSourceAverageLineCall
ignore void source writeStackLangSourceAverageLineCall
bind error writeStackLangSourceAverageLineError ConsoleWriteError writeStackLangSourceAverageLineCall
set memory lastConsoleWriteErrorCode writeStackLangSourceAverageLineError
branch error source writeStackLangSourceAverageLineCall target consoleWriteFailed

call writeStackLangSourceCallSquareLineCall writeStandardOutputLine
argument writeStackLangSourceCallSquareLineCall text String stackLangSourceCallSquareText
run writeStackLangSourceCallSquareLineCall
ignore void source writeStackLangSourceCallSquareLineCall
bind error writeStackLangSourceCallSquareLineError ConsoleWriteError writeStackLangSourceCallSquareLineCall
set memory lastConsoleWriteErrorCode writeStackLangSourceCallSquareLineError
branch error source writeStackLangSourceCallSquareLineCall target consoleWriteFailed

call writeStackLangSourceCallCubeLineCall writeStandardOutputLine
argument writeStackLangSourceCallCubeLineCall text String stackLangSourceCallCubeText
run writeStackLangSourceCallCubeLineCall
ignore void source writeStackLangSourceCallCubeLineCall
bind error writeStackLangSourceCallCubeLineError ConsoleWriteError writeStackLangSourceCallCubeLineCall
set memory lastConsoleWriteErrorCode writeStackLangSourceCallCubeLineError
branch error source writeStackLangSourceCallCubeLineCall target consoleWriteFailed

call writeStackLangSourceCallAverageLineCall writeStandardOutputLine
argument writeStackLangSourceCallAverageLineCall text String stackLangSourceCallAverageText
run writeStackLangSourceCallAverageLineCall
ignore void source writeStackLangSourceCallAverageLineCall
bind error writeStackLangSourceCallAverageLineError ConsoleWriteError writeStackLangSourceCallAverageLineCall
set memory lastConsoleWriteErrorCode writeStackLangSourceCallAverageLineError
branch error source writeStackLangSourceCallAverageLineCall target consoleWriteFailed

call writeStackLangSourceSwapSubtractLineCall writeStandardOutputLine
argument writeStackLangSourceSwapSubtractLineCall text String stackLangSourceSwapSubtractText
run writeStackLangSourceSwapSubtractLineCall
ignore void source writeStackLangSourceSwapSubtractLineCall
bind error writeStackLangSourceSwapSubtractLineError ConsoleWriteError writeStackLangSourceSwapSubtractLineCall
set memory lastConsoleWriteErrorCode writeStackLangSourceSwapSubtractLineError
branch error source writeStackLangSourceSwapSubtractLineCall target consoleWriteFailed

call writeStackLangOutputHeaderLineCall writeStandardOutputLine
argument writeStackLangOutputHeaderLineCall text String stackLangOutputHeaderText
run writeStackLangOutputHeaderLineCall
ignore void source writeStackLangOutputHeaderLineCall
bind error writeStackLangOutputHeaderLineError ConsoleWriteError writeStackLangOutputHeaderLineCall
set memory lastConsoleWriteErrorCode writeStackLangOutputHeaderLineError
branch error source writeStackLangOutputHeaderLineCall target consoleWriteFailed

call writeStackLangOutputSquareLineCall writeStandardOutputLine
argument writeStackLangOutputSquareLineCall text String stackLangOutputSquareText
run writeStackLangOutputSquareLineCall
ignore void source writeStackLangOutputSquareLineCall
bind error writeStackLangOutputSquareLineError ConsoleWriteError writeStackLangOutputSquareLineCall
set memory lastConsoleWriteErrorCode writeStackLangOutputSquareLineError
branch error source writeStackLangOutputSquareLineCall target consoleWriteFailed

call writeStackLangOutputCubeLineCall writeStandardOutputLine
argument writeStackLangOutputCubeLineCall text String stackLangOutputCubeText
run writeStackLangOutputCubeLineCall
ignore void source writeStackLangOutputCubeLineCall
bind error writeStackLangOutputCubeLineError ConsoleWriteError writeStackLangOutputCubeLineCall
set memory lastConsoleWriteErrorCode writeStackLangOutputCubeLineError
branch error source writeStackLangOutputCubeLineCall target consoleWriteFailed

call writeStackLangOutputAverageLineCall writeStandardOutputLine
argument writeStackLangOutputAverageLineCall text String stackLangOutputAverageText
run writeStackLangOutputAverageLineCall
ignore void source writeStackLangOutputAverageLineCall
bind error writeStackLangOutputAverageLineError ConsoleWriteError writeStackLangOutputAverageLineCall
set memory lastConsoleWriteErrorCode writeStackLangOutputAverageLineError
branch error source writeStackLangOutputAverageLineCall target consoleWriteFailed

call writeStackLangOutputSwapSubtractLineCall writeStandardOutputLine
argument writeStackLangOutputSwapSubtractLineCall text String stackLangOutputSwapSubtractText
run writeStackLangOutputSwapSubtractLineCall
ignore void source writeStackLangOutputSwapSubtractLineCall
bind error writeStackLangOutputSwapSubtractLineError ConsoleWriteError writeStackLangOutputSwapSubtractLineCall
set memory lastConsoleWriteErrorCode writeStackLangOutputSwapSubtractLineError
branch error source writeStackLangOutputSwapSubtractLineCall target consoleWriteFailed

call writeStackLangFinalStackDepthLineCall writeStandardOutputLine
argument writeStackLangFinalStackDepthLineCall text String stackLangFinalStackDepthText
run writeStackLangFinalStackDepthLineCall
ignore void source writeStackLangFinalStackDepthLineCall
bind error writeStackLangFinalStackDepthLineError ConsoleWriteError writeStackLangFinalStackDepthLineCall
set memory lastConsoleWriteErrorCode writeStackLangFinalStackDepthLineError
branch error source writeStackLangFinalStackDepthLineCall target consoleWriteFailed

storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode

label consoleWriteFailed
# rationale: lastConsoleWriteErrorCode holds whichever emit actually failed; its `set`
# ran immediately before the corresponding branchIfError, so the typed
# MainError.ConsoleWriteFailed value honestly names its cause (§12).
makeError consoleWriteFailure MainError.ConsoleWriteFailed lastConsoleWriteErrorCode
return error consoleWriteFailure
