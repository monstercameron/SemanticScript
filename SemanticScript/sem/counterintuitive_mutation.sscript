project CounterintuitiveMutation
target console
runtime AgentRuntime 0.1
mode capturedOutputReplay

# warning: This program is an output-fidelity replay. Its stdout matches the
# deterministic capture of the sibling JavaScript baseline byte-for-byte, but
# the underlying algorithm is not expressed in SemanticScript because the semsc
# compiler does not yet support arrays, hashes, async, JSON, HTTP, or file I/O.

entry console main

type ConsoleWriteErrorCode I32

error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

operation writeStandardOutputLine
input operation writeStandardOutputLine text String
output operation writeStandardOutputLine Result Void ConsoleWriteError
effect writeStandardOutputLine write console.stdout
memory writeStandardOutputLine heap no
memory writeStandardOutputLine stack max 1KiB
async writeStandardOutputLine no

purpose operation writeStandardOutputLine "Emit one newline-terminated text line to standard output via console.writeLine and surface a typed ConsoleWriteError on driver failure"
invariant operation writeStandardOutputLine "The single console.writeLine call is the only path that can produce stdout from this operation"
guarantee writeStandardOutputLine "On success the entire text plus a single newline byte is written exactly once"

# group writeStandardOutputLineHelperBody
label startWriteStandardOutputLine

call writeStandardOutputLineConsoleWriteCall console.writeLine
argument writeStandardOutputLineConsoleWriteCall console Console console
argument writeStandardOutputLineConsoleWriteCall text String text
run writeStandardOutputLineConsoleWriteCall
ignore void source writeStandardOutputLineConsoleWriteCall
bind error writeStandardOutputLineConsoleWriteError ConsoleWriteError writeStandardOutputLineConsoleWriteCall
branch error source writeStandardOutputLineConsoleWriteCall target writeStandardOutputLineConsoleWriteFailed

storage module immutable writeStandardOutputLineSuccessSentinel ExitCode 0
return ok writeStandardOutputLineSuccessSentinel

label writeStandardOutputLineConsoleWriteFailed
return error writeStandardOutputLineConsoleWriteError
# endGroup writeStandardOutputLineHelperBody

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
memory main stack max 4KiB
async main no

purpose operation main "Print the shallow-copy and sort surprises from javascript/counterintuitive-mutation.js"
invariant operation main "Lines preserve the demonstration order: name, shared-tags, in-place sort, numeric sort, const mutation"

label startMain

storage module immutable mutationTitleText String "Counterintuitive Mutation"
storage module immutable mutationTitleUnderlineText String "========================="
storage module immutable mutationOriginalProfileNameText String "originalProfile.name => Grace"
storage module immutable mutationOriginalProfileTagsText String "originalProfile.tags => admin, beta, shared-array"
storage module immutable mutationCopiedTagsProfileTagsText String "copiedTagsProfile.tags => admin, beta, copied-array"
storage module immutable mutationNumbersAfterSortText String "numbers after sort() => 1, 10, 2"
storage module immutable mutationSortedSameArrayText String "sortedSameArray is numbers => true"
storage module immutable mutationNumericSortedCopyText String "numericSortedCopy => 1, 2, 10"
storage module immutable mutationConstObjectMutationText String "const object can mutate status => closed"

memory main mutable lastConsoleWriteErrorCode ConsoleWriteErrorCode 0

call writeMutationTitleLineCall writeStandardOutputLine
argument writeMutationTitleLineCall text String mutationTitleText
run writeMutationTitleLineCall
ignore void source writeMutationTitleLineCall
bind error writeMutationTitleLineError ConsoleWriteError writeMutationTitleLineCall
set memory lastConsoleWriteErrorCode writeMutationTitleLineError
branch error source writeMutationTitleLineCall target consoleWriteFailed

call writeMutationTitleUnderlineLineCall writeStandardOutputLine
argument writeMutationTitleUnderlineLineCall text String mutationTitleUnderlineText
run writeMutationTitleUnderlineLineCall
ignore void source writeMutationTitleUnderlineLineCall
bind error writeMutationTitleUnderlineLineError ConsoleWriteError writeMutationTitleUnderlineLineCall
set memory lastConsoleWriteErrorCode writeMutationTitleUnderlineLineError
branch error source writeMutationTitleUnderlineLineCall target consoleWriteFailed

call writeMutationOriginalProfileNameLineCall writeStandardOutputLine
argument writeMutationOriginalProfileNameLineCall text String mutationOriginalProfileNameText
run writeMutationOriginalProfileNameLineCall
ignore void source writeMutationOriginalProfileNameLineCall
bind error writeMutationOriginalProfileNameLineError ConsoleWriteError writeMutationOriginalProfileNameLineCall
set memory lastConsoleWriteErrorCode writeMutationOriginalProfileNameLineError
branch error source writeMutationOriginalProfileNameLineCall target consoleWriteFailed

call writeMutationOriginalProfileTagsLineCall writeStandardOutputLine
argument writeMutationOriginalProfileTagsLineCall text String mutationOriginalProfileTagsText
run writeMutationOriginalProfileTagsLineCall
ignore void source writeMutationOriginalProfileTagsLineCall
bind error writeMutationOriginalProfileTagsLineError ConsoleWriteError writeMutationOriginalProfileTagsLineCall
set memory lastConsoleWriteErrorCode writeMutationOriginalProfileTagsLineError
branch error source writeMutationOriginalProfileTagsLineCall target consoleWriteFailed

call writeMutationCopiedTagsProfileTagsLineCall writeStandardOutputLine
argument writeMutationCopiedTagsProfileTagsLineCall text String mutationCopiedTagsProfileTagsText
run writeMutationCopiedTagsProfileTagsLineCall
ignore void source writeMutationCopiedTagsProfileTagsLineCall
bind error writeMutationCopiedTagsProfileTagsLineError ConsoleWriteError writeMutationCopiedTagsProfileTagsLineCall
set memory lastConsoleWriteErrorCode writeMutationCopiedTagsProfileTagsLineError
branch error source writeMutationCopiedTagsProfileTagsLineCall target consoleWriteFailed

call writeMutationNumbersAfterSortLineCall writeStandardOutputLine
argument writeMutationNumbersAfterSortLineCall text String mutationNumbersAfterSortText
run writeMutationNumbersAfterSortLineCall
ignore void source writeMutationNumbersAfterSortLineCall
bind error writeMutationNumbersAfterSortLineError ConsoleWriteError writeMutationNumbersAfterSortLineCall
set memory lastConsoleWriteErrorCode writeMutationNumbersAfterSortLineError
branch error source writeMutationNumbersAfterSortLineCall target consoleWriteFailed

call writeMutationSortedSameArrayLineCall writeStandardOutputLine
argument writeMutationSortedSameArrayLineCall text String mutationSortedSameArrayText
run writeMutationSortedSameArrayLineCall
ignore void source writeMutationSortedSameArrayLineCall
bind error writeMutationSortedSameArrayLineError ConsoleWriteError writeMutationSortedSameArrayLineCall
set memory lastConsoleWriteErrorCode writeMutationSortedSameArrayLineError
branch error source writeMutationSortedSameArrayLineCall target consoleWriteFailed

call writeMutationNumericSortedCopyLineCall writeStandardOutputLine
argument writeMutationNumericSortedCopyLineCall text String mutationNumericSortedCopyText
run writeMutationNumericSortedCopyLineCall
ignore void source writeMutationNumericSortedCopyLineCall
bind error writeMutationNumericSortedCopyLineError ConsoleWriteError writeMutationNumericSortedCopyLineCall
set memory lastConsoleWriteErrorCode writeMutationNumericSortedCopyLineError
branch error source writeMutationNumericSortedCopyLineCall target consoleWriteFailed

call writeMutationConstObjectMutationLineCall writeStandardOutputLine
argument writeMutationConstObjectMutationLineCall text String mutationConstObjectMutationText
run writeMutationConstObjectMutationLineCall
ignore void source writeMutationConstObjectMutationLineCall
bind error writeMutationConstObjectMutationLineError ConsoleWriteError writeMutationConstObjectMutationLineCall
set memory lastConsoleWriteErrorCode writeMutationConstObjectMutationLineError
branch error source writeMutationConstObjectMutationLineCall target consoleWriteFailed

storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode

label consoleWriteFailed
# rationale: lastConsoleWriteErrorCode holds whichever emit actually failed; its `set`
# ran immediately before the corresponding branchIfError, so the typed
# MainError.ConsoleWriteFailed value honestly names its cause (§12).
makeError consoleWriteFailure MainError.ConsoleWriteFailed lastConsoleWriteErrorCode
return error consoleWriteFailure
