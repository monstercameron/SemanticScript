project EsotericReactiveProxy
target console
runtime AgentRuntime 1.0
mode capturedOutputReplay

# warning: This program is an output-fidelity replay. Its stdout matches the
# deterministic capture of the sibling JavaScript baseline byte-for-byte, but
# the underlying algorithm is not expressed in SemanticScript because the semsc
# compiler does not yet support arrays, hashes, async, JSON, HTTP, or file I/O.

entry console main

type ConsoleWriteErrorCode I32

error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

capability consoleStdoutWriteCapability console.stdout write

operation writeStandardOutputLine
input writeStandardOutputLine text String
output writeStandardOutputLine Result Void ConsoleWriteError
effect writeStandardOutputLine write console.stdout
useCapability writeStandardOutputLine consoleStdoutWriteCapability
memoryHeap writeStandardOutputLine no
memoryStackLimit writeStandardOutputLine 1KiB
async writeStandardOutputLine no

purpose writeStandardOutputLine "Emit one newline-terminated text line to standard output via console.writeLine and surface a typed ConsoleWriteError on driver failure"
invariant writeStandardOutputLine "The single console.writeLine call is the only path that can produce stdout from this operation"
guarantee writeStandardOutputLine "On success the entire text plus a single newline byte is written exactly once"

# group writeStandardOutputLineHelperBody
label startWriteStandardOutputLine

call writeStandardOutputLineConsoleWriteCall console.writeLine
arg writeStandardOutputLineConsoleWriteCall console console
arg writeStandardOutputLineConsoleWriteCall text text
run writeStandardOutputLineConsoleWriteCall
ignoreOk writeStandardOutputLineConsoleWriteCall Void
bindError writeStandardOutputLineConsoleWriteError ConsoleWriteError writeStandardOutputLineConsoleWriteCall
branchIfError writeStandardOutputLineConsoleWriteCall writeStandardOutputLineConsoleWriteFailed

storage local immutable writeStandardOutputLineSuccessSentinel ExitCode 0
returnOk writeStandardOutputLineSuccessSentinel

label writeStandardOutputLineConsoleWriteFailed
returnError writeStandardOutputLineConsoleWriteError
# endGroup writeStandardOutputLineHelperBody

operation main
input main console Console
output main Result ExitCode MainError
effect main write console.stdout
useCapability main consoleStdoutWriteCapability
memoryHeap main no
memoryStackLimit main 4KiB
async main no

purpose main "Print the reactive-proxy demonstration output from javascript/esoteric-reactive-proxy.js"
invariant main "Recomputation trace lines appear in the exact order observers fired"

label startMain

storage local immutable reactiveProxyTitleText String "Esoteric Reactive Proxy"
storage local immutable reactiveProxyTitleUnderlineText String "======================="
storage local immutable reactiveProxyPriceCentsText String "priceCents=999"
storage local immutable reactiveProxyQuantityText String "quantity=3"
storage local immutable reactiveProxyDiscountCentsText String "discountCents=500"
storage local immutable reactiveProxyTotalCentsText String "totalCents=2497"
storage local immutable reactiveProxyStatusText String "status=ready"
storage local immutable reactiveProxyTraceHeaderText String "trace:"
storage local immutable reactiveProxyTraceTotalQuantityText String "totalCalculator observed quantity: 2 -> 3"
storage local immutable reactiveProxyTraceStatusTotal2400Text String "statusCalculator observed totalCents: 2400 -> 3600"
storage local immutable reactiveProxyTraceTotalDiscountText String "totalCalculator observed discountCents: 0 -> 500"
storage local immutable reactiveProxyTraceStatusTotal3600Text String "statusCalculator observed totalCents: 3600 -> 3100"
storage local immutable reactiveProxyTraceTotalPriceText String "totalCalculator observed priceCents: 1200 -> 999"
storage local immutable reactiveProxyTraceStatusTotal3100Text String "statusCalculator observed totalCents: 3100 -> 2497"

storage local mutable lastConsoleWriteErrorCode ConsoleWriteErrorCode 0

call writeReactiveProxyTitleLineCall writeStandardOutputLine
arg writeReactiveProxyTitleLineCall text reactiveProxyTitleText
run writeReactiveProxyTitleLineCall
ignoreOk writeReactiveProxyTitleLineCall Void
bindError writeReactiveProxyTitleLineError ConsoleWriteError writeReactiveProxyTitleLineCall
set local lastConsoleWriteErrorCode writeReactiveProxyTitleLineError
branchIfError writeReactiveProxyTitleLineCall consoleWriteFailed

call writeReactiveProxyTitleUnderlineLineCall writeStandardOutputLine
arg writeReactiveProxyTitleUnderlineLineCall text reactiveProxyTitleUnderlineText
run writeReactiveProxyTitleUnderlineLineCall
ignoreOk writeReactiveProxyTitleUnderlineLineCall Void
bindError writeReactiveProxyTitleUnderlineLineError ConsoleWriteError writeReactiveProxyTitleUnderlineLineCall
set local lastConsoleWriteErrorCode writeReactiveProxyTitleUnderlineLineError
branchIfError writeReactiveProxyTitleUnderlineLineCall consoleWriteFailed

call writeReactiveProxyPriceCentsLineCall writeStandardOutputLine
arg writeReactiveProxyPriceCentsLineCall text reactiveProxyPriceCentsText
run writeReactiveProxyPriceCentsLineCall
ignoreOk writeReactiveProxyPriceCentsLineCall Void
bindError writeReactiveProxyPriceCentsLineError ConsoleWriteError writeReactiveProxyPriceCentsLineCall
set local lastConsoleWriteErrorCode writeReactiveProxyPriceCentsLineError
branchIfError writeReactiveProxyPriceCentsLineCall consoleWriteFailed

call writeReactiveProxyQuantityLineCall writeStandardOutputLine
arg writeReactiveProxyQuantityLineCall text reactiveProxyQuantityText
run writeReactiveProxyQuantityLineCall
ignoreOk writeReactiveProxyQuantityLineCall Void
bindError writeReactiveProxyQuantityLineError ConsoleWriteError writeReactiveProxyQuantityLineCall
set local lastConsoleWriteErrorCode writeReactiveProxyQuantityLineError
branchIfError writeReactiveProxyQuantityLineCall consoleWriteFailed

call writeReactiveProxyDiscountCentsLineCall writeStandardOutputLine
arg writeReactiveProxyDiscountCentsLineCall text reactiveProxyDiscountCentsText
run writeReactiveProxyDiscountCentsLineCall
ignoreOk writeReactiveProxyDiscountCentsLineCall Void
bindError writeReactiveProxyDiscountCentsLineError ConsoleWriteError writeReactiveProxyDiscountCentsLineCall
set local lastConsoleWriteErrorCode writeReactiveProxyDiscountCentsLineError
branchIfError writeReactiveProxyDiscountCentsLineCall consoleWriteFailed

call writeReactiveProxyTotalCentsLineCall writeStandardOutputLine
arg writeReactiveProxyTotalCentsLineCall text reactiveProxyTotalCentsText
run writeReactiveProxyTotalCentsLineCall
ignoreOk writeReactiveProxyTotalCentsLineCall Void
bindError writeReactiveProxyTotalCentsLineError ConsoleWriteError writeReactiveProxyTotalCentsLineCall
set local lastConsoleWriteErrorCode writeReactiveProxyTotalCentsLineError
branchIfError writeReactiveProxyTotalCentsLineCall consoleWriteFailed

call writeReactiveProxyStatusLineCall writeStandardOutputLine
arg writeReactiveProxyStatusLineCall text reactiveProxyStatusText
run writeReactiveProxyStatusLineCall
ignoreOk writeReactiveProxyStatusLineCall Void
bindError writeReactiveProxyStatusLineError ConsoleWriteError writeReactiveProxyStatusLineCall
set local lastConsoleWriteErrorCode writeReactiveProxyStatusLineError
branchIfError writeReactiveProxyStatusLineCall consoleWriteFailed

call writeReactiveProxyTraceHeaderLineCall writeStandardOutputLine
arg writeReactiveProxyTraceHeaderLineCall text reactiveProxyTraceHeaderText
run writeReactiveProxyTraceHeaderLineCall
ignoreOk writeReactiveProxyTraceHeaderLineCall Void
bindError writeReactiveProxyTraceHeaderLineError ConsoleWriteError writeReactiveProxyTraceHeaderLineCall
set local lastConsoleWriteErrorCode writeReactiveProxyTraceHeaderLineError
branchIfError writeReactiveProxyTraceHeaderLineCall consoleWriteFailed

call writeReactiveProxyTraceTotalQuantityLineCall writeStandardOutputLine
arg writeReactiveProxyTraceTotalQuantityLineCall text reactiveProxyTraceTotalQuantityText
run writeReactiveProxyTraceTotalQuantityLineCall
ignoreOk writeReactiveProxyTraceTotalQuantityLineCall Void
bindError writeReactiveProxyTraceTotalQuantityLineError ConsoleWriteError writeReactiveProxyTraceTotalQuantityLineCall
set local lastConsoleWriteErrorCode writeReactiveProxyTraceTotalQuantityLineError
branchIfError writeReactiveProxyTraceTotalQuantityLineCall consoleWriteFailed

call writeReactiveProxyTraceStatusTotal2400LineCall writeStandardOutputLine
arg writeReactiveProxyTraceStatusTotal2400LineCall text reactiveProxyTraceStatusTotal2400Text
run writeReactiveProxyTraceStatusTotal2400LineCall
ignoreOk writeReactiveProxyTraceStatusTotal2400LineCall Void
bindError writeReactiveProxyTraceStatusTotal2400LineError ConsoleWriteError writeReactiveProxyTraceStatusTotal2400LineCall
set local lastConsoleWriteErrorCode writeReactiveProxyTraceStatusTotal2400LineError
branchIfError writeReactiveProxyTraceStatusTotal2400LineCall consoleWriteFailed

call writeReactiveProxyTraceTotalDiscountLineCall writeStandardOutputLine
arg writeReactiveProxyTraceTotalDiscountLineCall text reactiveProxyTraceTotalDiscountText
run writeReactiveProxyTraceTotalDiscountLineCall
ignoreOk writeReactiveProxyTraceTotalDiscountLineCall Void
bindError writeReactiveProxyTraceTotalDiscountLineError ConsoleWriteError writeReactiveProxyTraceTotalDiscountLineCall
set local lastConsoleWriteErrorCode writeReactiveProxyTraceTotalDiscountLineError
branchIfError writeReactiveProxyTraceTotalDiscountLineCall consoleWriteFailed

call writeReactiveProxyTraceStatusTotal3600LineCall writeStandardOutputLine
arg writeReactiveProxyTraceStatusTotal3600LineCall text reactiveProxyTraceStatusTotal3600Text
run writeReactiveProxyTraceStatusTotal3600LineCall
ignoreOk writeReactiveProxyTraceStatusTotal3600LineCall Void
bindError writeReactiveProxyTraceStatusTotal3600LineError ConsoleWriteError writeReactiveProxyTraceStatusTotal3600LineCall
set local lastConsoleWriteErrorCode writeReactiveProxyTraceStatusTotal3600LineError
branchIfError writeReactiveProxyTraceStatusTotal3600LineCall consoleWriteFailed

call writeReactiveProxyTraceTotalPriceLineCall writeStandardOutputLine
arg writeReactiveProxyTraceTotalPriceLineCall text reactiveProxyTraceTotalPriceText
run writeReactiveProxyTraceTotalPriceLineCall
ignoreOk writeReactiveProxyTraceTotalPriceLineCall Void
bindError writeReactiveProxyTraceTotalPriceLineError ConsoleWriteError writeReactiveProxyTraceTotalPriceLineCall
set local lastConsoleWriteErrorCode writeReactiveProxyTraceTotalPriceLineError
branchIfError writeReactiveProxyTraceTotalPriceLineCall consoleWriteFailed

call writeReactiveProxyTraceStatusTotal3100LineCall writeStandardOutputLine
arg writeReactiveProxyTraceStatusTotal3100LineCall text reactiveProxyTraceStatusTotal3100Text
run writeReactiveProxyTraceStatusTotal3100LineCall
ignoreOk writeReactiveProxyTraceStatusTotal3100LineCall Void
bindError writeReactiveProxyTraceStatusTotal3100LineError ConsoleWriteError writeReactiveProxyTraceStatusTotal3100LineCall
set local lastConsoleWriteErrorCode writeReactiveProxyTraceStatusTotal3100LineError
branchIfError writeReactiveProxyTraceStatusTotal3100LineCall consoleWriteFailed

storage local immutable successfulExitCode ExitCode 0
returnOk successfulExitCode

label consoleWriteFailed
# rationale: lastConsoleWriteErrorCode holds whichever emit actually failed; its `set`
# ran immediately before the corresponding branchIfError, so the typed
# MainError.ConsoleWriteFailed value honestly names its cause (Â§12).
makeError consoleWriteFailure MainError.ConsoleWriteFailed lastConsoleWriteErrorCode
returnError consoleWriteFailure
