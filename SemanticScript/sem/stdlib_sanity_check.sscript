project StdlibSanityCheck
target console
runtime AgentRuntime 0.1

entry console main

error MainError
errorCase MainError WriteFailed CSignedInt32

# ============================================================
# Sanity-check demo: exercises a handful of std/* operations
# (inlined here because cross-file calls aren't supported yet).
#
# Operations exercised:
#   putByte / putString / putLine / putIntegerDecimal  (stdio.sscript)
#   strlen                                              (string.sscript)
#   factorial                                           (math.sscript)
# ============================================================

operation putByte
input operation putByte byteValue CSignedInt32
output operation putByte Result CSignedInt32 Void
effect putByte write console.stdout
memory putByte heap no
memory putByte stack max 1KiB
async putByte no
purpose operation putByte "Write one byte to stdout. The only line that crosses to the host OS."
invariant operation putByte "Returns the byte written when c.putchar reports a non-negative result."

label startPutByte
call putByteHostCall c.putchar
argument putByteHostCall c CSignedInt32 byteValue
run putByteHostCall
bind value putByteResult CSignedInt32 putByteHostCall
return ok putByteResult

operation putString
input operation putString sourceText CNullTerminatedByteString
output operation putString Result CByteCount Void
effect putString write console.stdout
effect putString read memory.buffer
memory putString heap no
memory putString stack max 1KiB
async putString no
purpose operation putString "Walk a C-string and emit each byte via putByte until a NUL terminator."
invariant operation putString "At putStringLoop, cursorIndex bytes have already been written to stdout."

label startPutString
storage module immutable zeroIndex CByteCount 0
storage module immutable oneIndex CByteCount 1
memory putString mutable cursorIndex CByteCount zeroIndex

label putStringLoop
call loadByteCall pointer.loadByte
argument loadByteCall buffer CNullTerminatedByteString sourceText
argument loadByteCall offset CByteCount cursorIndex
run loadByteCall
bind value currentByte I8 loadByteCall

call isNulCall math.equalI64
argument isNulCall left I8 currentByte
argument isNulCall right I64 zeroIndex
run isNulCall
bind value reachedNul Bool isNulCall
branch if condition reachedNul target putStringDone

call emitByteCall putByte
argument emitByteCall byteValue CSignedInt32 currentByte
run emitByteCall
ignore ok source emitByteCall type CSignedInt32

call advanceCursorCall math.addI64
argument advanceCursorCall left I64 cursorIndex
argument advanceCursorCall right I64 oneIndex
run advanceCursorCall
bind value nextCursor CByteCount advanceCursorCall
set memory cursorIndex nextCursor
jump target putStringLoop

label putStringDone
return ok cursorIndex

operation putLine
input operation putLine sourceText CNullTerminatedByteString
output operation putLine Result CByteCount Void
effect putLine write console.stdout
effect putLine read memory.buffer
memory putLine heap no
memory putLine stack max 1KiB
async putLine no
purpose operation putLine "Write sourceText to stdout, then emit a single newline byte."
invariant operation putLine "totalBytesWritten always equals putString's count plus one for the newline."

label startPutLine
call putLineBodyCall putString
argument putLineBodyCall sourceText CNullTerminatedByteString sourceText
run putLineBodyCall
bind ok bodyByteCount CByteCount putLineBodyCall

storage module immutable newlineByte CSignedInt32 10
call putLineNewlineCall putByte
argument putLineNewlineCall byteValue CSignedInt32 newlineByte
run putLineNewlineCall
ignore ok source putLineNewlineCall type CSignedInt32

storage module immutable oneNewline CByteCount 1
call totalBytesCall math.addI64
argument totalBytesCall left I64 bodyByteCount
argument totalBytesCall right I64 oneNewline
run totalBytesCall
bind value totalBytesWritten CByteCount totalBytesCall
return ok totalBytesWritten

operation putIntegerDecimal
input operation putIntegerDecimal numberToPrint CSignedInt64
output operation putIntegerDecimal Result CByteCount Void
effect putIntegerDecimal write console.stdout
effect putIntegerDecimal allocate heap
effect putIntegerDecimal free heap
effect putIntegerDecimal write memory.buffer
effect putIntegerDecimal read memory.buffer
memory putIntegerDecimal heap yes
memory putIntegerDecimal stack max 4KiB
async putIntegerDecimal no
purpose operation putIntegerDecimal "Print a signed 64-bit decimal integer (no trailing newline). Pure-SemanticScript itoa."
invariant operation putIntegerDecimal "At digitDecomposeLoop, digitCount equals the number of digits already buffered in reverse order."
invariant operation putIntegerDecimal "digitBuffer is allocated on entry to decompose and freed on exit from emitDone."

label startPutIntegerDecimal
storage module immutable zeroValue CSignedInt64 0
storage module immutable oneValue CSignedInt64 1
storage module immutable tenValue CSignedInt64 10
storage module immutable negativeOneValue CSignedInt64 -1
storage module immutable asciiZeroOffset CSignedInt64 48
storage module immutable asciiMinusByte CSignedInt32 45
storage module immutable digitBufferBytes CByteCount 32

call allocBufferCall c.malloc
argument allocBufferCall size CByteCount digitBufferBytes
run allocBufferCall
bind value digitBuffer COpaqueMemoryAddress allocBufferCall

memory putIntegerDecimal mutable workingMagnitude CSignedInt64 zeroValue
set memory workingMagnitude numberToPrint
memory putIntegerDecimal mutable negativeFlag CSignedInt64 zeroValue

call signCheckCall math.lessThanI64
argument signCheckCall left CSignedInt64 numberToPrint
argument signCheckCall right CSignedInt64 zeroValue
run signCheckCall
bind value isNegativeBool Bool signCheckCall
branch if condition isNegativeBool target flipSign
branch else target signDone

label flipSign
set memory negativeFlag oneValue
call negateCall math.multiplyI64
argument negateCall left CSignedInt64 numberToPrint
argument negateCall right CSignedInt64 negativeOneValue
run negateCall
bind value negatedValue CSignedInt64 negateCall
set memory workingMagnitude negatedValue
jump target signDone

label signDone
call isZeroCheckCall math.equalI64
argument isZeroCheckCall left CSignedInt64 workingMagnitude
argument isZeroCheckCall right I64 zeroValue
run isZeroCheckCall
bind value isZeroValue Bool isZeroCheckCall
branch if condition isZeroValue target emitZeroDigit
branch else target decomposeDigits

label emitZeroDigit
storage module immutable asciiZeroByte CSignedInt32 48
call putZeroDigitCall putByte
argument putZeroDigitCall byteValue CSignedInt32 asciiZeroByte
run putZeroDigitCall
ignore ok source putZeroDigitCall type CSignedInt32
jump target emitDone

label decomposeDigits
storage module immutable zeroIndexDec CByteCount 0
storage module immutable oneIndexDec CByteCount 1
memory putIntegerDecimal mutable digitCount CByteCount zeroIndexDec

label digitDecomposeLoop
call extractDigitCall math.moduloI64
argument extractDigitCall left CSignedInt64 workingMagnitude
argument extractDigitCall right CSignedInt64 tenValue
run extractDigitCall
bind value digitValue CSignedInt64 extractDigitCall

call digitToAsciiCall math.addI64
argument digitToAsciiCall left I64 digitValue
argument digitToAsciiCall right I64 asciiZeroOffset
run digitToAsciiCall
bind value digitAsciiByte CSignedInt32 digitToAsciiCall

call storeDigitCall pointer.storeByte
argument storeDigitCall buffer COpaqueMemoryAddress digitBuffer
argument storeDigitCall offset CByteCount digitCount
argument storeDigitCall value CSignedInt32 digitAsciiByte
run storeDigitCall

call incrementCountCall math.addI64
argument incrementCountCall left I64 digitCount
argument incrementCountCall right I64 oneIndexDec
run incrementCountCall
bind value nextDigitCount CByteCount incrementCountCall
set memory digitCount nextDigitCount

call divideByTenCall math.divideI64
argument divideByTenCall left CSignedInt64 workingMagnitude
argument divideByTenCall right CSignedInt64 tenValue
run divideByTenCall
bind value nextMagnitude CSignedInt64 divideByTenCall
set memory workingMagnitude nextMagnitude

call hasMoreCall math.greaterThanI64
argument hasMoreCall left CSignedInt64 workingMagnitude
argument hasMoreCall right CSignedInt64 zeroValue
run hasMoreCall
bind value hasMoreDigits Bool hasMoreCall
branch if condition hasMoreDigits target digitDecomposeLoop
branch else target emitSignByte

label emitSignByte
call needsSignCall math.equalI64
argument needsSignCall left CSignedInt64 negativeFlag
argument needsSignCall right I64 oneValue
run needsSignCall
bind value needsMinusSign Bool needsSignCall
branch if condition needsMinusSign target emitMinusSign
branch else target emitDigitsForward

label emitMinusSign
call putMinusCall putByte
argument putMinusCall byteValue CSignedInt32 asciiMinusByte
run putMinusCall
ignore ok source putMinusCall type CSignedInt32
jump target emitDigitsForward

label emitDigitsForward
memory putIntegerDecimal mutable emitCursor CByteCount zeroIndexDec
set memory emitCursor digitCount

label emitNextDigit
call cursorAtZeroCall math.equalI64
argument cursorAtZeroCall left CByteCount emitCursor
argument cursorAtZeroCall right I64 zeroValue
run cursorAtZeroCall
bind value cursorIsZero Bool cursorAtZeroCall
branch if condition cursorIsZero target emitDone

call decrementCursorCall math.subtractI64
argument decrementCursorCall left CByteCount emitCursor
argument decrementCursorCall right CByteCount oneIndexDec
run decrementCursorCall
bind value decrementedCursor CByteCount decrementCursorCall
set memory emitCursor decrementedCursor

call loadDigitByteCall pointer.loadByte
argument loadDigitByteCall buffer COpaqueMemoryAddress digitBuffer
argument loadDigitByteCall offset CByteCount decrementedCursor
run loadDigitByteCall
bind value digitByteToEmit I8 loadDigitByteCall

call putDigitByteCall putByte
argument putDigitByteCall byteValue CSignedInt32 digitByteToEmit
run putDigitByteCall
ignore ok source putDigitByteCall type CSignedInt32
jump target emitNextDigit

label emitDone
call freeBufferCall c.free
argument freeBufferCall ptr COpaqueMemoryAddress digitBuffer
run freeBufferCall
storage module immutable finishedByteCount CByteCount 1
return ok finishedByteCount

operation strlen
input operation strlen sourceText CNullTerminatedByteString
output operation strlen Result CByteCount Void
effect strlen read memory.buffer
memory strlen heap no
memory strlen stack max 1KiB
async strlen no
purpose operation strlen "Pure-SemanticScript strlen: walk bytes from sourceText until a NUL, returning the byte count."
invariant operation strlen "At strlenLoop, cursorByteCount equals the number of non-NUL bytes seen so far."

label startStrlen
storage module immutable zeroByteCount CByteCount 0
storage module immutable oneByteCount CByteCount 1
memory strlen mutable cursorByteCount CByteCount zeroByteCount

label strlenLoop
call probeByteCall pointer.loadByte
argument probeByteCall buffer CNullTerminatedByteString sourceText
argument probeByteCall offset CByteCount cursorByteCount
run probeByteCall
bind value probedByte I8 probeByteCall

call probeIsNulCall math.equalI64
argument probeIsNulCall left I8 probedByte
argument probeIsNulCall right I64 zeroByteCount
run probeIsNulCall
bind value probeReachedNul Bool probeIsNulCall
branch if condition probeReachedNul target strlenDone

call advanceProbeCall math.addI64
argument advanceProbeCall left I64 cursorByteCount
argument advanceProbeCall right I64 oneByteCount
run advanceProbeCall
bind value nextProbeIndex CByteCount advanceProbeCall
set memory cursorByteCount nextProbeIndex
jump target strlenLoop

label strlenDone
return ok cursorByteCount

operation factorial
input operation factorial upperLimit CSignedInt64
output operation factorial Result CSignedInt64 Void
memory factorial heap no
memory factorial stack max 1KiB
async factorial no
purpose operation factorial "Compute upperLimit! using a multiplicative loop; returns 1 when upperLimit <= 0."
invariant operation factorial "At factorialLoop, runningProduct equals factorial(currentCounter - 1)."

label startFactorial
storage module immutable zeroFactorial CSignedInt64 0
storage module immutable oneFactorial CSignedInt64 1

call upperLimitNonPositiveCall math.lessThanOrEqualI64
argument upperLimitNonPositiveCall left CSignedInt64 upperLimit
argument upperLimitNonPositiveCall right CSignedInt64 zeroFactorial
run upperLimitNonPositiveCall
bind value upperLimitNonPositive Bool upperLimitNonPositiveCall
branch if condition upperLimitNonPositive target factorialReturnsOne

memory factorial mutable runningProduct CSignedInt64 oneFactorial
memory factorial mutable currentCounter CSignedInt64 oneFactorial

label factorialLoop
call counterPastLimitCall math.greaterThanI64
argument counterPastLimitCall left CSignedInt64 currentCounter
argument counterPastLimitCall right CSignedInt64 upperLimit
run counterPastLimitCall
bind value counterPastLimit Bool counterPastLimitCall
branch if condition counterPastLimit target factorialReturnProduct

call multiplyAccumulatorCall math.multiplyI64
argument multiplyAccumulatorCall left CSignedInt64 runningProduct
argument multiplyAccumulatorCall right CSignedInt64 currentCounter
run multiplyAccumulatorCall
bind value nextProduct CSignedInt64 multiplyAccumulatorCall
set memory runningProduct nextProduct

call advanceCounterCall math.addI64
argument advanceCounterCall left I64 currentCounter
argument advanceCounterCall right I64 oneFactorial
run advanceCounterCall
bind value nextCounter CSignedInt64 advanceCounterCall
set memory currentCounter nextCounter
jump target factorialLoop

label factorialReturnProduct
return ok runningProduct

label factorialReturnsOne
return ok oneFactorial

# ============================================================
# main: exercise the operations and print results.
# ============================================================

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
effect main read memory.buffer
effect main allocate heap
effect main free heap
effect main write memory.buffer
memory main heap yes
memory main stack max 4KiB
async main no
purpose operation main "Run a small sanity check across stdlib operations and print the results."
invariant operation main "Each demo line completes successfully before the next call is issued."

label startMain

storage module immutable greetingText CNullTerminatedByteString "SemanticScript stdlib sanity check"
call printGreetingCall putLine
argument printGreetingCall sourceText CNullTerminatedByteString greetingText
run printGreetingCall
ignore ok source printGreetingCall type CByteCount

storage module immutable strlenLabelText CNullTerminatedByteString "strlen(\"Hello, SemanticScript!\") = "
call printStrlenLabelCall putString
argument printStrlenLabelCall sourceText CNullTerminatedByteString strlenLabelText
run printStrlenLabelCall
ignore ok source printStrlenLabelCall type CByteCount

storage module immutable sampleText CNullTerminatedByteString "Hello, SemanticScript!"
call measureSampleCall strlen
argument measureSampleCall sourceText CNullTerminatedByteString sampleText
run measureSampleCall
bind ok sampleByteCount CByteCount measureSampleCall

call printSampleLengthCall putIntegerDecimal
argument printSampleLengthCall numberToPrint CSignedInt64 sampleByteCount
run printSampleLengthCall
ignore ok source printSampleLengthCall type CByteCount

storage module immutable newlineByteValue CSignedInt32 10
call newlineAfterStrlenCall putByte
argument newlineAfterStrlenCall byteValue CSignedInt32 newlineByteValue
run newlineAfterStrlenCall
ignore ok source newlineAfterStrlenCall type CSignedInt32

storage module immutable factorialFiveLabelText CNullTerminatedByteString "5! = "
call printFactorialFiveLabelCall putString
argument printFactorialFiveLabelCall sourceText CNullTerminatedByteString factorialFiveLabelText
run printFactorialFiveLabelCall
ignore ok source printFactorialFiveLabelCall type CByteCount

storage module immutable factorialFiveInput CSignedInt64 5
call computeFactorialFiveCall factorial
argument computeFactorialFiveCall upperLimit CSignedInt64 factorialFiveInput
run computeFactorialFiveCall
bind ok factorialFiveResult CSignedInt64 computeFactorialFiveCall

call printFactorialFiveCall putIntegerDecimal
argument printFactorialFiveCall numberToPrint CSignedInt64 factorialFiveResult
run printFactorialFiveCall
ignore ok source printFactorialFiveCall type CByteCount

call newlineAfterFactorialFiveCall putByte
argument newlineAfterFactorialFiveCall byteValue CSignedInt32 newlineByteValue
run newlineAfterFactorialFiveCall
ignore ok source newlineAfterFactorialFiveCall type CSignedInt32

storage module immutable factorialTenLabelText CNullTerminatedByteString "10! = "
call printFactorialTenLabelCall putString
argument printFactorialTenLabelCall sourceText CNullTerminatedByteString factorialTenLabelText
run printFactorialTenLabelCall
ignore ok source printFactorialTenLabelCall type CByteCount

storage module immutable factorialTenInput CSignedInt64 10
call computeFactorialTenCall factorial
argument computeFactorialTenCall upperLimit CSignedInt64 factorialTenInput
run computeFactorialTenCall
bind ok factorialTenResult CSignedInt64 computeFactorialTenCall

call printFactorialTenCall putIntegerDecimal
argument printFactorialTenCall numberToPrint CSignedInt64 factorialTenResult
run printFactorialTenCall
ignore ok source printFactorialTenCall type CByteCount

call newlineAfterFactorialTenCall putByte
argument newlineAfterFactorialTenCall byteValue CSignedInt32 newlineByteValue
run newlineAfterFactorialTenCall
ignore ok source newlineAfterFactorialTenCall type CSignedInt32

storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
