project StdlibSanityCheck
target console
runtime AgentRuntime 0.1

entry console main

error MainError
errorCase MainError WriteFailed Int32

# ============================================================
# Sanity-check demo: exercises a handful of std/* operations
# (inlined here because cross-file calls aren't supported yet).
#
# Operations exercised:
#   putByte / putString / putLine / putIntegerDecimal  (stdio.sscript)
#   strlen                                              (string.sscript)
#   factorial                                           (math.sscript)
# ============================================================

operation putByte
input operation putByte byteValue Int32
output operation putByte Result Int32 Void
effect putByte write console.stdout
memory putByte heap no
memory putByte stack max 1KiB
async putByte no
purpose operation putByte "Write one byte to stdout. The only line that crosses to the host OS."
invariant operation putByte "Returns the byte written when c.putchar reports a non-negative result."

label startPutByte
call putByteHostCall c.putchar
argument putByteHostCall c Int32 byteValue
run putByteHostCall
bind value putByteResult Int32 putByteHostCall
return ok putByteResult

operation putString
input operation putString sourceText String
output operation putString Result ByteCount Void
effect putString write console.stdout
effect putString read memory.buffer
memory putString heap no
memory putString stack max 1KiB
async putString no
purpose operation putString "Walk a C-string and emit each byte via putByte until a NUL terminator."
invariant operation putString "At putStringLoop, cursorIndex bytes have already been written to stdout."

label startPutString
storage module immutable zeroIndex ByteCount 0
storage module immutable oneIndex ByteCount 1
storage module immutable zeroByte Int32 0
memory putString mutable cursorIndex ByteCount zeroIndex

label putStringLoop
call loadByteCall pointer.loadByte
argument loadByteCall buffer OpaquePointer sourceText
argument loadByteCall offset ByteCount cursorIndex
run loadByteCall
bind value currentByte Int32 loadByteCall

call isNulCall math.equalInt32
argument isNulCall left Int32 currentByte
argument isNulCall right Int32 zeroByte
run isNulCall
bind value reachedNul Bool isNulCall
branch if condition reachedNul target putStringDone

call emitByteCall putByte
argument emitByteCall byteValue Int32 currentByte
run emitByteCall
ignore ok source emitByteCall type Int32

call advanceCursorCall math.addInt64
argument advanceCursorCall left Int64 cursorIndex
argument advanceCursorCall right Int64 oneIndex
run advanceCursorCall
bind value nextCursor ByteCount advanceCursorCall
set memory cursorIndex nextCursor
jump target putStringLoop

label putStringDone
return ok cursorIndex

operation putLine
input operation putLine sourceText String
output operation putLine Result ByteCount Void
effect putLine write console.stdout
effect putLine read memory.buffer
memory putLine heap no
memory putLine stack max 1KiB
async putLine no
purpose operation putLine "Write sourceText to stdout, then emit a single newline byte."
invariant operation putLine "totalBytesWritten always equals putString's count plus one for the newline."

label startPutLine
call putLineBodyCall putString
argument putLineBodyCall sourceText String sourceText
run putLineBodyCall
bind ok bodyByteCount ByteCount putLineBodyCall

storage module immutable newlineByte Int32 10
call putLineNewlineCall putByte
argument putLineNewlineCall byteValue Int32 newlineByte
run putLineNewlineCall
ignore ok source putLineNewlineCall type Int32

storage module immutable oneNewline ByteCount 1
call totalBytesCall math.addInt64
argument totalBytesCall left Int64 bodyByteCount
argument totalBytesCall right Int64 oneNewline
run totalBytesCall
bind value totalBytesWritten ByteCount totalBytesCall
return ok totalBytesWritten

operation putIntegerDecimal
input operation putIntegerDecimal numberToPrint Int64
output operation putIntegerDecimal Result ByteCount Void
effect putIntegerDecimal write console.stdout
effect putIntegerDecimal allocate heap
effect putIntegerDecimal free heap
effect putIntegerDecimal write memory.buffer
effect putIntegerDecimal read memory.buffer
memory putIntegerDecimal heap yes
memory putIntegerDecimal stack max 4KiB
async putIntegerDecimal no
purpose operation putIntegerDecimal "Print a signed 64-bit decimal integer (no trailing newline). Pure-SemanticScript itoa."
invariant operation putIntegerDecimal "At digitDecomposeLoop, digitCount equals the number of digits already buffered in reverse order."
invariant operation putIntegerDecimal "digitBuffer is allocated on entry to decompose and freed on exit from emitDone."

label startPutIntegerDecimal
storage module immutable zeroValue Int64 0
storage module immutable oneValue Int64 1
storage module immutable tenValue Int64 10
storage module immutable negativeOneValue Int64 -1
storage module immutable asciiZeroOffset Int64 48
storage module immutable asciiMinusByte Int32 45
storage module immutable digitBufferBytes ByteCount 32

call allocBufferCall c.malloc
argument allocBufferCall size ByteCount digitBufferBytes
run allocBufferCall
bind value digitBuffer OpaquePointer allocBufferCall

memory putIntegerDecimal mutable workingMagnitude Int64 zeroValue
set memory workingMagnitude numberToPrint
memory putIntegerDecimal mutable negativeFlag Int64 zeroValue

call signCheckCall math.lessThanInt64
argument signCheckCall left Int64 numberToPrint
argument signCheckCall right Int64 zeroValue
run signCheckCall
bind value isNegativeBool Bool signCheckCall
branch if condition isNegativeBool target flipSign
branch else target signDone

label flipSign
set memory negativeFlag oneValue
call negateCall math.multiplyInt64
argument negateCall left Int64 numberToPrint
argument negateCall right Int64 negativeOneValue
run negateCall
bind value negatedValue Int64 negateCall
set memory workingMagnitude negatedValue
jump target signDone

label signDone
call isZeroCheckCall math.equalInt64
argument isZeroCheckCall left Int64 workingMagnitude
argument isZeroCheckCall right Int64 zeroValue
run isZeroCheckCall
bind value isZeroValue Bool isZeroCheckCall
branch if condition isZeroValue target emitZeroDigit
branch else target decomposeDigits

label emitZeroDigit
storage module immutable asciiZeroByte Int32 48
call putZeroDigitCall putByte
argument putZeroDigitCall byteValue Int32 asciiZeroByte
run putZeroDigitCall
ignore ok source putZeroDigitCall type Int32
jump target emitDone

label decomposeDigits
storage module immutable zeroIndexDec ByteCount 0
storage module immutable oneIndexDec ByteCount 1
memory putIntegerDecimal mutable digitCount ByteCount zeroIndexDec

label digitDecomposeLoop
call extractDigitCall math.moduloInt64
argument extractDigitCall left Int64 workingMagnitude
argument extractDigitCall right Int64 tenValue
run extractDigitCall
bind value digitValue Int64 extractDigitCall

call digitToAsciiCall math.addInt64
argument digitToAsciiCall left Int64 digitValue
argument digitToAsciiCall right Int64 asciiZeroOffset
run digitToAsciiCall
bind value digitAsciiByte Int64 digitToAsciiCall

call storeDigitCall pointer.storeByte
argument storeDigitCall buffer OpaquePointer digitBuffer
argument storeDigitCall offset ByteCount digitCount
argument storeDigitCall value Int64 digitAsciiByte
run storeDigitCall

call incrementCountCall math.addInt64
argument incrementCountCall left Int64 digitCount
argument incrementCountCall right Int64 oneIndexDec
run incrementCountCall
bind value nextDigitCount ByteCount incrementCountCall
set memory digitCount nextDigitCount

call divideByTenCall math.divideInt64
argument divideByTenCall left Int64 workingMagnitude
argument divideByTenCall right Int64 tenValue
run divideByTenCall
bind value nextMagnitude Int64 divideByTenCall
set memory workingMagnitude nextMagnitude

call hasMoreCall math.greaterThanInt64
argument hasMoreCall left Int64 workingMagnitude
argument hasMoreCall right Int64 zeroValue
run hasMoreCall
bind value hasMoreDigits Bool hasMoreCall
branch if condition hasMoreDigits target digitDecomposeLoop
branch else target emitSignByte

label emitSignByte
call needsSignCall math.equalInt64
argument needsSignCall left Int64 negativeFlag
argument needsSignCall right Int64 oneValue
run needsSignCall
bind value needsMinusSign Bool needsSignCall
branch if condition needsMinusSign target emitMinusSign
branch else target emitDigitsForward

label emitMinusSign
call putMinusCall putByte
argument putMinusCall byteValue Int32 asciiMinusByte
run putMinusCall
ignore ok source putMinusCall type Int32
jump target emitDigitsForward

label emitDigitsForward
memory putIntegerDecimal mutable emitCursor ByteCount zeroIndexDec
set memory emitCursor digitCount

label emitNextDigit
call cursorAtZeroCall math.equalInt64
argument cursorAtZeroCall left Int64 emitCursor
argument cursorAtZeroCall right Int64 zeroValue
run cursorAtZeroCall
bind value cursorIsZero Bool cursorAtZeroCall
branch if condition cursorIsZero target emitDone

call decrementCursorCall math.subtractInt64
argument decrementCursorCall left Int64 emitCursor
argument decrementCursorCall right Int64 oneIndexDec
run decrementCursorCall
bind value decrementedCursor ByteCount decrementCursorCall
set memory emitCursor decrementedCursor

call loadDigitByteCall pointer.loadByte
argument loadDigitByteCall buffer OpaquePointer digitBuffer
argument loadDigitByteCall offset ByteCount decrementedCursor
run loadDigitByteCall
bind value digitByteToEmit Int32 loadDigitByteCall

call putDigitByteCall putByte
argument putDigitByteCall byteValue Int32 digitByteToEmit
run putDigitByteCall
ignore ok source putDigitByteCall type Int32
jump target emitNextDigit

label emitDone
call freeBufferCall c.free
argument freeBufferCall ptr OpaquePointer digitBuffer
run freeBufferCall
storage module immutable finishedByteCount ByteCount 1
return ok finishedByteCount

operation strlen
input operation strlen sourceText String
output operation strlen Result ByteCount Void
effect strlen read memory.buffer
memory strlen heap no
memory strlen stack max 1KiB
async strlen no
purpose operation strlen "Pure-SemanticScript strlen: walk bytes from sourceText until a NUL, returning the byte count."
invariant operation strlen "At strlenLoop, cursorByteCount equals the number of non-NUL bytes seen so far."

label startStrlen
storage module immutable zeroByteCount ByteCount 0
storage module immutable oneByteCount ByteCount 1
storage module immutable zeroByteValue Int32 0
memory strlen mutable cursorByteCount ByteCount zeroByteCount

label strlenLoop
call probeByteCall pointer.loadByte
argument probeByteCall buffer OpaquePointer sourceText
argument probeByteCall offset ByteCount cursorByteCount
run probeByteCall
bind value probedByte Int32 probeByteCall

call probeIsNulCall math.equalInt32
argument probeIsNulCall left Int32 probedByte
argument probeIsNulCall right Int32 zeroByteValue
run probeIsNulCall
bind value probeReachedNul Bool probeIsNulCall
branch if condition probeReachedNul target strlenDone

call advanceProbeCall math.addInt64
argument advanceProbeCall left Int64 cursorByteCount
argument advanceProbeCall right Int64 oneByteCount
run advanceProbeCall
bind value nextProbeIndex ByteCount advanceProbeCall
set memory cursorByteCount nextProbeIndex
jump target strlenLoop

label strlenDone
return ok cursorByteCount

operation factorial
input operation factorial upperLimit Int64
output operation factorial Result Int64 Void
memory factorial heap no
memory factorial stack max 1KiB
async factorial no
purpose operation factorial "Compute upperLimit! using a multiplicative loop; returns 1 when upperLimit <= 0."
invariant operation factorial "At factorialLoop, runningProduct equals factorial(currentCounter - 1)."

label startFactorial
storage module immutable zeroFactorial Int64 0
storage module immutable oneFactorial Int64 1

call upperLimitNonPositiveCall math.lessThanOrEqualInt64
argument upperLimitNonPositiveCall left Int64 upperLimit
argument upperLimitNonPositiveCall right Int64 zeroFactorial
run upperLimitNonPositiveCall
bind value upperLimitNonPositive Bool upperLimitNonPositiveCall
branch if condition upperLimitNonPositive target factorialReturnsOne

memory factorial mutable runningProduct Int64 oneFactorial
memory factorial mutable currentCounter Int64 oneFactorial

label factorialLoop
call counterPastLimitCall math.greaterThanInt64
argument counterPastLimitCall left Int64 currentCounter
argument counterPastLimitCall right Int64 upperLimit
run counterPastLimitCall
bind value counterPastLimit Bool counterPastLimitCall
branch if condition counterPastLimit target factorialReturnProduct

call multiplyAccumulatorCall math.multiplyInt64
argument multiplyAccumulatorCall left Int64 runningProduct
argument multiplyAccumulatorCall right Int64 currentCounter
run multiplyAccumulatorCall
bind value nextProduct Int64 multiplyAccumulatorCall
set memory runningProduct nextProduct

call advanceCounterCall math.addInt64
argument advanceCounterCall left Int64 currentCounter
argument advanceCounterCall right Int64 oneFactorial
run advanceCounterCall
bind value nextCounter Int64 advanceCounterCall
set memory currentCounter nextCounter
jump target factorialLoop

label factorialReturnProduct
return ok runningProduct

label factorialReturnsOne
return ok oneFactorial

# ============================================================
# main: exercise the operations and print results.
# ============================================================

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
effect main read memory.buffer
effect main allocate heap
effect main free heap
effect main write memory.buffer
memory main heap yes
memory main stack max 4KiB
async main no
purpose operation main "Run a small sanity check across stdlib operations and print the results."
invariant operation main "Each demo line completes successfully before the next call is issued."

label startMain

storage module immutable greetingText String "SemanticScript stdlib sanity check"
call printGreetingCall putLine
argument printGreetingCall sourceText String greetingText
run printGreetingCall
ignore ok source printGreetingCall type ByteCount

storage module immutable strlenLabelText String "strlen(\"Hello, SemanticScript!\") = "
call printStrlenLabelCall putString
argument printStrlenLabelCall sourceText String strlenLabelText
run printStrlenLabelCall
ignore ok source printStrlenLabelCall type ByteCount

storage module immutable sampleText String "Hello, SemanticScript!"
call measureSampleCall strlen
argument measureSampleCall sourceText String sampleText
run measureSampleCall
bind ok sampleByteCount ByteCount measureSampleCall

call printSampleLengthCall putIntegerDecimal
argument printSampleLengthCall numberToPrint Int64 sampleByteCount
run printSampleLengthCall
ignore ok source printSampleLengthCall type ByteCount

storage module immutable newlineByteValue Int32 10
call newlineAfterStrlenCall putByte
argument newlineAfterStrlenCall byteValue Int32 newlineByteValue
run newlineAfterStrlenCall
ignore ok source newlineAfterStrlenCall type Int32

storage module immutable factorialFiveLabelText String "5! = "
call printFactorialFiveLabelCall putString
argument printFactorialFiveLabelCall sourceText String factorialFiveLabelText
run printFactorialFiveLabelCall
ignore ok source printFactorialFiveLabelCall type ByteCount

storage module immutable factorialFiveInput Int64 5
call computeFactorialFiveCall factorial
argument computeFactorialFiveCall upperLimit Int64 factorialFiveInput
run computeFactorialFiveCall
bind ok factorialFiveResult Int64 computeFactorialFiveCall

call printFactorialFiveCall putIntegerDecimal
argument printFactorialFiveCall numberToPrint Int64 factorialFiveResult
run printFactorialFiveCall
ignore ok source printFactorialFiveCall type ByteCount

call newlineAfterFactorialFiveCall putByte
argument newlineAfterFactorialFiveCall byteValue Int32 newlineByteValue
run newlineAfterFactorialFiveCall
ignore ok source newlineAfterFactorialFiveCall type Int32

storage module immutable factorialTenLabelText String "10! = "
call printFactorialTenLabelCall putString
argument printFactorialTenLabelCall sourceText String factorialTenLabelText
run printFactorialTenLabelCall
ignore ok source printFactorialTenLabelCall type ByteCount

storage module immutable factorialTenInput Int64 10
call computeFactorialTenCall factorial
argument computeFactorialTenCall upperLimit Int64 factorialTenInput
run computeFactorialTenCall
bind ok factorialTenResult Int64 computeFactorialTenCall

call printFactorialTenCall putIntegerDecimal
argument printFactorialTenCall numberToPrint Int64 factorialTenResult
run printFactorialTenCall
ignore ok source printFactorialTenCall type ByteCount

call newlineAfterFactorialTenCall putByte
argument newlineAfterFactorialTenCall byteValue Int32 newlineByteValue
run newlineAfterFactorialTenCall
ignore ok source newlineAfterFactorialTenCall type Int32

storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
