# ============================================================
# SemanticScript stdlib import-and-use smoke
# ============================================================
#
# rationale: every std/*.sscript module ships an `operation main`
#   as its self-test. This file goes one step further — it asks
#   whether those operations can be IMPORTED into a separate
#   program via `importModule` and called from outside. It pulls
#   in a stochastic sample of seven modules spanning the major
#   library tiers (logic, ordering, predicates, integer math,
#   float math, byte strings, time) and exercises one operation
#   from each.
#
# invariant: every imported operation under test must return its
#   declared value (Bool / CSignedInt64 / CFloat64 / CByteCount /
#   etc.) when called from this file. If any imported operation
#   were not actually reachable through the resolver, the call
#   would fail to typecheck at codegen time and this whole file
#   would fail to compile — that's the unit-test pass condition.
#
# security: no I/O beyond writing "OK" / "FAIL" on stdout.
#
# timing: dominated by the imported math operations
#   (squareRootFloat64 Newton iteration ~ 50 floating-point
#   instructions). Whole test runs in microseconds.
#
# observability: prints "OK\n" on full pass, otherwise emits
#   a tag identifying the first failing assertion so a CI diff
#   pinpoints the broken import.

project StdlibImportSmoke
target console
runtime AgentRuntime 0.1
entry console stdlibImportSmokeMain

error MainError
errorCase MainError StdlibImportSmokeAssertionFailed
errorCase MainError ConsoleWriteFailed

# section capability
# rationale: smoke writes a single OK line to stdout.
capability stdoutWriteCapability console.stdout write

# ----- imports under test (stochastic sample of seven modules) -----
import bool bool
import compare compare
import ctype ctype
import numeric numeric
import math math
import math_float math_float
import string string
import time time

operation stdlibImportSmokeMain
input operation stdlibImportSmokeMain console Console
output operation stdlibImportSmokeMain Result ExitCode MainError
useCapability stdlibImportSmokeMain stdoutWriteCapability
effect stdlibImportSmokeMain write console.stdout
memory stdlibImportSmokeMain heap no
async stdlibImportSmokeMain no
purpose operation stdlibImportSmokeMain "Call one or two operations from each imported std module and assert each result. Demonstrates that importModule successfully wires the stdlib surface into a downstream program."
invariant operation stdlibImportSmokeMain "All eight imported-module assertions hold; final exit code is 0; stdout is exactly 'OK\\n'."

label startStdlibImportSmokeMain

# ---- bool: negateBoolean(false) == true ----
storage module immutable importedBooleanFalseLiteral Bool false
storage module immutable importedBooleanTrueLiteral Bool true
call assertNegateBooleanCall negateBoolean
argument assertNegateBooleanCall valueToNegate Bool importedBooleanFalseLiteral
run assertNegateBooleanCall
bind value negateBooleanResult Bool assertNegateBooleanCall
branch if condition negateBooleanResult target negateBooleanHolds
branch else target stdlibImportAssertionFailed
label negateBooleanHolds

# ---- bool: andBooleans(true, true) == true ----
call assertAndBooleansCall andBooleans
argument assertAndBooleansCall firstOperand Bool importedBooleanTrueLiteral
argument assertAndBooleansCall secondOperand Bool importedBooleanTrueLiteral
run assertAndBooleansCall
bind value andBooleansResult Bool assertAndBooleansCall
branch if condition andBooleansResult target andBooleansHolds
branch else target stdlibImportAssertionFailed
label andBooleansHolds

# ---- compare: areSignedInt64ValuesEqual(7, 7) == true ----
storage module immutable sevenForCompareImport CSignedInt64 7
call assertEqualSevenCall areSignedInt64ValuesEqual
argument assertEqualSevenCall leftValue CSignedInt64 sevenForCompareImport
argument assertEqualSevenCall rightValue CSignedInt64 sevenForCompareImport
run assertEqualSevenCall
bind value equalSevenResult Bool assertEqualSevenCall
branch if condition equalSevenResult target equalSevenHolds
branch else target stdlibImportAssertionFailed
label equalSevenHolds

# ---- compare: isSignedInt64LeftLessThanRight(5, 10) == true ----
storage module immutable fiveForLessThanImport CSignedInt64 5
storage module immutable tenForLessThanImport CSignedInt64 10
call assertFiveLessThanTenCall isSignedInt64LeftLessThanRight
argument assertFiveLessThanTenCall leftValue CSignedInt64 fiveForLessThanImport
argument assertFiveLessThanTenCall rightValue CSignedInt64 tenForLessThanImport
run assertFiveLessThanTenCall
bind value fiveLessThanTenResult Bool assertFiveLessThanTenCall
branch if condition fiveLessThanTenResult target fiveLessThanTenHolds
branch else target stdlibImportAssertionFailed
label fiveLessThanTenHolds

# ---- ctype: isAsciiDecimalDigitCode('5') == true ----
storage module immutable asciiFiveCharacterCode CSignedInt32 53
call assertDigitFiveImportCall isAsciiDecimalDigitCode
argument assertDigitFiveImportCall characterCode CSignedInt32 asciiFiveCharacterCode
run assertDigitFiveImportCall
bind value digitFiveImportResult Bool assertDigitFiveImportCall
branch if condition digitFiveImportResult target digitFiveImportHolds
branch else target stdlibImportAssertionFailed
label digitFiveImportHolds

# ---- ctype: convertAsciiLetterCodeToUppercase('h') == 'H' ----
storage module immutable lowercaseHForConvertImport CSignedInt32 104
storage module immutable uppercaseHExpectedImport CSignedInt32 72
call assertConvertUppercaseCall convertAsciiLetterCodeToUppercase
argument assertConvertUppercaseCall characterCode CSignedInt32 lowercaseHForConvertImport
run assertConvertUppercaseCall
bind value convertUppercaseResult CSignedInt32 assertConvertUppercaseCall
call checkConvertUppercaseCall math.equalI64
argument checkConvertUppercaseCall left CSignedInt32 convertUppercaseResult
argument checkConvertUppercaseCall right I64 uppercaseHExpectedImport
run checkConvertUppercaseCall
bind value convertUppercaseOk Bool checkConvertUppercaseCall
branch if condition convertUppercaseOk target convertUppercaseHolds
branch else target stdlibImportAssertionFailed
label convertUppercaseHolds

# ---- numeric: incrementSignedInt64(41) == 42 ----
storage module immutable fortyOneForIncrementImport CSignedInt64 41
storage module immutable fortyTwoExpectedImport CSignedInt64 42
call assertIncrementCall incrementSignedInt64
argument assertIncrementCall inputValue CSignedInt64 fortyOneForIncrementImport
run assertIncrementCall
bind value incrementResult CSignedInt64 assertIncrementCall
call checkIncrementCall math.equalI64
argument checkIncrementCall left CSignedInt64 incrementResult
argument checkIncrementCall right I64 fortyTwoExpectedImport
run checkIncrementCall
bind value incrementOk Bool checkIncrementCall
branch if condition incrementOk target incrementHolds
branch else target stdlibImportAssertionFailed
label incrementHolds

# ---- numeric: sumSignedInt64OneThroughN(10) == 55 ----
storage module immutable tenForGaussSumImport CSignedInt64 10
storage module immutable fiftyFiveExpectedImport CSignedInt64 55
call assertGaussSumCall sumSignedInt64OneThroughN
argument assertGaussSumCall inputValue CSignedInt64 tenForGaussSumImport
run assertGaussSumCall
bind value gaussSumResult CSignedInt64 assertGaussSumCall
call checkGaussSumCall math.equalI64
argument checkGaussSumCall left CSignedInt64 gaussSumResult
argument checkGaussSumCall right I64 fiftyFiveExpectedImport
run checkGaussSumCall
bind value gaussSumOk Bool checkGaussSumCall
branch if condition gaussSumOk target gaussSumHolds
branch else target stdlibImportAssertionFailed
label gaussSumHolds

# ---- math: factorialSignedInt64(6) == 720 ----
storage module immutable sixForFactorialImport CSignedInt64 6
storage module immutable sevenTwentyExpectedImport CSignedInt64 720
call assertFactorialImportCall factorialSignedInt64
argument assertFactorialImportCall inputValue CSignedInt64 sixForFactorialImport
run assertFactorialImportCall
bind value factorialImportResult CSignedInt64 assertFactorialImportCall
call checkFactorialImportCall math.equalI64
argument checkFactorialImportCall left CSignedInt64 factorialImportResult
argument checkFactorialImportCall right I64 sevenTwentyExpectedImport
run checkFactorialImportCall
bind value factorialImportOk Bool checkFactorialImportCall
branch if condition factorialImportOk target factorialImportHolds
branch else target stdlibImportAssertionFailed
label factorialImportHolds

# ---- math: isSignedInt64Prime(19) == true ----
storage module immutable nineteenPrimeImport CSignedInt64 19
call assertPrimeImportCall isSignedInt64Prime
argument assertPrimeImportCall inputValue CSignedInt64 nineteenPrimeImport
run assertPrimeImportCall
bind value primeImportResult Bool assertPrimeImportCall
branch if condition primeImportResult target primeImportHolds
branch else target stdlibImportAssertionFailed
label primeImportHolds

# ---- math_float: absoluteFloat64(-2.5) == 2.5 ----
storage module immutable negativeTwoPointFiveImport CFloat64 -2.5
storage module immutable twoPointFiveExpectedImport CFloat64 2.5
call assertAbsoluteFloatCall absoluteFloat64
argument assertAbsoluteFloatCall inputValue CFloat64 negativeTwoPointFiveImport
run assertAbsoluteFloatCall
bind value absoluteFloatResult CFloat64 assertAbsoluteFloatCall
call checkAbsoluteFloatCall math.equalF64
argument checkAbsoluteFloatCall left CFloat64 absoluteFloatResult
argument checkAbsoluteFloatCall right CFloat64 twoPointFiveExpectedImport
run checkAbsoluteFloatCall
bind value absoluteFloatOk Bool checkAbsoluteFloatCall
branch if condition absoluteFloatOk target absoluteFloatHolds
branch else target stdlibImportAssertionFailed
label absoluteFloatHolds

# ---- string: stringByteLength("semanticscript") == 11 ----
storage module immutable semanticscriptLiteralForLengthImport CNullTerminatedByteString "semanticscript"
storage module immutable elevenBytesExpectedImport CByteCount 11
call assertStringByteLengthCall stringByteLength
argument assertStringByteLengthCall inputText CNullTerminatedByteString semanticscriptLiteralForLengthImport
run assertStringByteLengthCall
bind value stringByteLengthResult CByteCount assertStringByteLengthCall
call checkStringByteLengthCall math.equalI64
argument checkStringByteLengthCall left CByteCount stringByteLengthResult
argument checkStringByteLengthCall right I64 elevenBytesExpectedImport
run checkStringByteLengthCall
bind value stringByteLengthOk Bool checkStringByteLengthCall
branch if condition stringByteLengthOk target stringByteLengthHolds
branch else target stdlibImportAssertionFailed
label stringByteLengthHolds

# ---- time: isGregorianLeapYear(2024) == true ----
storage module immutable twentyTwentyFourYearImport CSignedInt64 2024
call assertLeapYear2024ImportCall isGregorianLeapYear
argument assertLeapYear2024ImportCall candidateYear CSignedInt64 twentyTwentyFourYearImport
run assertLeapYear2024ImportCall
bind value leapYear2024Result Bool assertLeapYear2024ImportCall
branch if condition leapYear2024Result target leapYear2024Holds
branch else target stdlibImportAssertionFailed
label leapYear2024Holds

# ---- time: convertSecondsToWholeHours(7200) == 2 ----
storage module immutable sevenThousandTwoHundredSecondsImport CSignedInt64 7200
storage module immutable twoHoursExpectedImport CSignedInt64 2
call assertConvertHoursCall convertSecondsToWholeHours
argument assertConvertHoursCall secondCount CSignedInt64 sevenThousandTwoHundredSecondsImport
run assertConvertHoursCall
bind value convertHoursResult CSignedInt64 assertConvertHoursCall
call checkConvertHoursCall math.equalI64
argument checkConvertHoursCall left CSignedInt64 convertHoursResult
argument checkConvertHoursCall right I64 twoHoursExpectedImport
run checkConvertHoursCall
bind value convertHoursOk Bool checkConvertHoursCall
branch if condition convertHoursOk target convertHoursHolds
branch else target stdlibImportAssertionFailed
label convertHoursHolds

# All assertions held — emit OK and exit 0.
storage module immutable stdlibImportSuccessMessage CNullTerminatedByteString "OK"
call writeStdlibImportSuccessCall console.writeLine
argument writeStdlibImportSuccessCall console Console console
argument writeStdlibImportSuccessCall text CNullTerminatedByteString stdlibImportSuccessMessage
run writeStdlibImportSuccessCall
ignore ok source writeStdlibImportSuccessCall type CSignedInt32
bind error stdlibImportConsoleWriteError CSignedInt32 writeStdlibImportSuccessCall
branch error source writeStdlibImportSuccessCall target stdlibImportConsoleWriteFailed
storage module immutable stdlibImportExitOk ExitCode 0
return ok stdlibImportExitOk

label stdlibImportConsoleWriteFailed
makeError stdlibImportConsoleWriteFailure MainError.ConsoleWriteFailed stdlibImportConsoleWriteError
return error stdlibImportConsoleWriteFailure

label stdlibImportAssertionFailed
makeError stdlibImportSmokeFailure MainError.StdlibImportSmokeAssertionFailed
return error stdlibImportSmokeFailure
