call writeCoercionBooleanStringFalseExplanationLineCall writeStandardOutputLine
argument writeCoercionBooleanStringFalseExplanationLineCall text String coercionBooleanStringFalseExplanationText
run writeCoercionBooleanStringFalseExplanationLineCall
ignore void source writeCoercionBooleanStringFalseExplanationLineCall
bind error writeCoercionBooleanStringFalseExplanationLineError ConsoleWriteError writeCoercionBooleanStringFalseExplanationLineCall
set memory lastConsoleWriteErrorCode writeCoercionBooleanStringFalseExplanationLineError
branch error source writeCoercionBooleanStringFalseExplanationLineCall target consoleWriteFailed

storage local immutable successfulExitCode ExitCode 0
return ok successfulExitCode

label consoleWriteFailed
# rationale: lastConsoleWriteErrorCode holds whichever emit actually failed; its `set`
# ran immediately before the corresponding branchIfError, so the typed
# MainError.ConsoleWriteFailed value honestly names its cause (Â§12).
makeError consoleWriteFailure MainError.ConsoleWriteFailed lastConsoleWriteErrorCode
return error consoleWriteFailure
