project CounterintuitiveCoercion
target console
runtime AgentRuntime 1.0
mode capturedOutputReplay

# warning: This program is an output-fidelity replay. Its stdout matches the
# deterministic capture of the sibling JavaScript baseline byte-for-byte, but
# the underlying algorithm is not expressed in SemanticScript because the semsc
# compiler does not yet support arrays, hashes, async, JSON, HTTP, or file I/O.

entry console main

type ConsoleWriteErrorCode I32

error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

capability consoleStdoutWriteCapability console.stdout write

operation writeStandardOutputLine
input writeStandardOutputLine text String
output writeStandardOutputLine Result Void ConsoleWriteError
effect writeStandardOutputLine write console.stdout
useCapability writeStandardOutputLine consoleStdoutWriteCapability
memoryHeap writeStandardOutputLine no
memoryStackLimit writeStandardOutputLine 1KiB
async writeStandardOutputLine no

purpose writeStandardOutputLine "Emit one newline-terminated text line to standard output via console.writeLine and surface a typed ConsoleWriteError on driver failure"
invariant writeStandardOutputLine "The single console.writeLine call is the only path that can produce stdout from this operation"
guarantee writeStandardOutputLine "On success the entire text plus a single newline byte is written exactly once"

# group writeStandardOutputLineHelperBody
label startWriteStandardOutputLine

call writeStandardOutputLineConsoleWriteCall console.writeLine
arg writeStandardOutputLineConsoleWriteCall console console
arg writeStandardOutputLineConsoleWriteCall text text
run writeStandardOutputLineConsoleWriteCall
ignoreOk writeStandardOutputLineConsoleWriteCall Void
bindError writeStandardOutputLineConsoleWriteError ConsoleWriteError writeStandardOutputLineConsoleWriteCall
branchIfError writeStandardOutputLineConsoleWriteCall writeStandardOutputLineConsoleWriteFailed

storage local immutable writeStandardOutputLineSuccessSentinel ExitCode 0
returnOk writeStandardOutputLineSuccessSentinel

label writeStandardOutputLineConsoleWriteFailed
returnError writeStandardOutputLineConsoleWriteError
# endGroup writeStandardOutputLineHelperBody

operation main
input main console Console
output main Result ExitCode MainError
effect main write console.stdout
useCapability main consoleStdoutWriteCapability
memoryHeap main no
memoryStackLimit main 4KiB
async main no

purpose main "Print the JavaScript loose-equality demonstration output from javascript/counterintuitive-coercion.js"
invariant main "Each result line is followed by its explanation line, in source order"

label startMain

storage local immutable coercionTitleText String "Counterintuitive Coercion"
storage local immutable coercionTitleUnderlineText String "========================="
storage local immutable coercionArrayEqFalseText String "[] == false => true"
storage local immutable coercionArrayEqFalseExplanationText String "  [] becomes an empty string, then 0; false also becomes 0."
storage local immutable coercionArrayEqNotArrayText String "[] == ![] => true"
storage local immutable coercionArrayEqNotArrayExplanationText String "  ![] is false, then the comparison follows the [] == false path."
storage local immutable coercionEmptyStringEqZeroText String "\"\" == 0 => true"
storage local immutable coercionEmptyStringEqZeroExplanationText String "  The empty string becomes numeric 0."
storage local immutable coercionStringZeroEqFalseText String "\"0\" == false => true"
storage local immutable coercionStringZeroEqFalseExplanationText String "  Both sides become numeric 0."
storage local immutable coercionNullEqUndefinedText String "null == undefined => true"
storage local immutable coercionNullEqUndefinedExplanationText String "  Loose equality has a special case for null and undefined."
storage local immutable coercionNullEqZeroText String "null == 0 => false"
storage local immutable coercionNullEqZeroExplanationText String "  The null/undefined special case does not extend to numbers."
storage local immutable coercionBooleanStringFalseText String "Boolean(\"false\") => true"
storage local immutable coercionBooleanStringFalseExplanationText String "  Any non-empty string is truthy."

storage local mutable lastConsoleWriteErrorCode ConsoleWriteErrorCode 0

call writeCoercionTitleLineCall writeStandardOutputLine
arg writeCoercionTitleLineCall text coercionTitleText
run writeCoercionTitleLineCall
ignoreOk writeCoercionTitleLineCall Void
bindError writeCoercionTitleLineError ConsoleWriteError writeCoercionTitleLineCall
set local lastConsoleWriteErrorCode writeCoercionTitleLineError
branchIfError writeCoercionTitleLineCall consoleWriteFailed

call writeCoercionTitleUnderlineLineCall writeStandardOutputLine
arg writeCoercionTitleUnderlineLineCall text coercionTitleUnderlineText
run writeCoercionTitleUnderlineLineCall
ignoreOk writeCoercionTitleUnderlineLineCall Void
bindError writeCoercionTitleUnderlineLineError ConsoleWriteError writeCoercionTitleUnderlineLineCall
set local lastConsoleWriteErrorCode writeCoercionTitleUnderlineLineError
branchIfError writeCoercionTitleUnderlineLineCall consoleWriteFailed

call writeCoercionArrayEqFalseLineCall writeStandardOutputLine
arg writeCoercionArrayEqFalseLineCall text coercionArrayEqFalseText
run writeCoercionArrayEqFalseLineCall
ignoreOk writeCoercionArrayEqFalseLineCall Void
bindError writeCoercionArrayEqFalseLineError ConsoleWriteError writeCoercionArrayEqFalseLineCall
set local lastConsoleWriteErrorCode writeCoercionArrayEqFalseLineError
branchIfError writeCoercionArrayEqFalseLineCall consoleWriteFailed

call writeCoercionArrayEqFalseExplanationLineCall writeStandardOutputLine
arg writeCoercionArrayEqFalseExplanationLineCall text coercionArrayEqFalseExplanationText
run writeCoercionArrayEqFalseExplanationLineCall
ignoreOk writeCoercionArrayEqFalseExplanationLineCall Void
bindError writeCoercionArrayEqFalseExplanationLineError ConsoleWriteError writeCoercionArrayEqFalseExplanationLineCall
set local lastConsoleWriteErrorCode writeCoercionArrayEqFalseExplanationLineError
branchIfError writeCoercionArrayEqFalseExplanationLineCall consoleWriteFailed

call writeCoercionArrayEqNotArrayLineCall writeStandardOutputLine
arg writeCoercionArrayEqNotArrayLineCall text coercionArrayEqNotArrayText
run writeCoercionArrayEqNotArrayLineCall
ignoreOk writeCoercionArrayEqNotArrayLineCall Void
bindError writeCoercionArrayEqNotArrayLineError ConsoleWriteError writeCoercionArrayEqNotArrayLineCall
set local lastConsoleWriteErrorCode writeCoercionArrayEqNotArrayLineError
branchIfError writeCoercionArrayEqNotArrayLineCall consoleWriteFailed

call writeCoercionArrayEqNotArrayExplanationLineCall writeStandardOutputLine
arg writeCoercionArrayEqNotArrayExplanationLineCall text coercionArrayEqNotArrayExplanationText
run writeCoercionArrayEqNotArrayExplanationLineCall
ignoreOk writeCoercionArrayEqNotArrayExplanationLineCall Void
bindError writeCoercionArrayEqNotArrayExplanationLineError ConsoleWriteError writeCoercionArrayEqNotArrayExplanationLineCall
set local lastConsoleWriteErrorCode writeCoercionArrayEqNotArrayExplanationLineError
branchIfError writeCoercionArrayEqNotArrayExplanationLineCall consoleWriteFailed

call writeCoercionEmptyStringEqZeroLineCall writeStandardOutputLine
arg writeCoercionEmptyStringEqZeroLineCall text coercionEmptyStringEqZeroText
run writeCoercionEmptyStringEqZeroLineCall
ignoreOk writeCoercionEmptyStringEqZeroLineCall Void
bindError writeCoercionEmptyStringEqZeroLineError ConsoleWriteError writeCoercionEmptyStringEqZeroLineCall
set local lastConsoleWriteErrorCode writeCoercionEmptyStringEqZeroLineError
branchIfError writeCoercionEmptyStringEqZeroLineCall consoleWriteFailed

call writeCoercionEmptyStringEqZeroExplanationLineCall writeStandardOutputLine
arg writeCoercionEmptyStringEqZeroExplanationLineCall text coercionEmptyStringEqZeroExplanationText
run writeCoercionEmptyStringEqZeroExplanationLineCall
ignoreOk writeCoercionEmptyStringEqZeroExplanationLineCall Void
bindError writeCoercionEmptyStringEqZeroExplanationLineError ConsoleWriteError writeCoercionEmptyStringEqZeroExplanationLineCall
set local lastConsoleWriteErrorCode writeCoercionEmptyStringEqZeroExplanationLineError
branchIfError writeCoercionEmptyStringEqZeroExplanationLineCall consoleWriteFailed

call writeCoercionStringZeroEqFalseLineCall writeStandardOutputLine
arg writeCoercionStringZeroEqFalseLineCall text coercionStringZeroEqFalseText
run writeCoercionStringZeroEqFalseLineCall
ignoreOk writeCoercionStringZeroEqFalseLineCall Void
bindError writeCoercionStringZeroEqFalseLineError ConsoleWriteError writeCoercionStringZeroEqFalseLineCall
set local lastConsoleWriteErrorCode writeCoercionStringZeroEqFalseLineError
branchIfError writeCoercionStringZeroEqFalseLineCall consoleWriteFailed

call writeCoercionStringZeroEqFalseExplanationLineCall writeStandardOutputLine
arg writeCoercionStringZeroEqFalseExplanationLineCall text coercionStringZeroEqFalseExplanationText
run writeCoercionStringZeroEqFalseExplanationLineCall
ignoreOk writeCoercionStringZeroEqFalseExplanationLineCall Void
bindError writeCoercionStringZeroEqFalseExplanationLineError ConsoleWriteError writeCoercionStringZeroEqFalseExplanationLineCall
set local lastConsoleWriteErrorCode writeCoercionStringZeroEqFalseExplanationLineError
branchIfError writeCoercionStringZeroEqFalseExplanationLineCall consoleWriteFailed

call writeCoercionNullEqUndefinedLineCall writeStandardOutputLine
arg writeCoercionNullEqUndefinedLineCall text coercionNullEqUndefinedText
run writeCoercionNullEqUndefinedLineCall
ignoreOk writeCoercionNullEqUndefinedLineCall Void
bindError writeCoercionNullEqUndefinedLineError ConsoleWriteError writeCoercionNullEqUndefinedLineCall
set local lastConsoleWriteErrorCode writeCoercionNullEqUndefinedLineError
branchIfError writeCoercionNullEqUndefinedLineCall consoleWriteFailed

call writeCoercionNullEqUndefinedExplanationLineCall writeStandardOutputLine
arg writeCoercionNullEqUndefinedExplanationLineCall text coercionNullEqUndefinedExplanationText
run writeCoercionNullEqUndefinedExplanationLineCall
ignoreOk writeCoercionNullEqUndefinedExplanationLineCall Void
bindError writeCoercionNullEqUndefinedExplanationLineError ConsoleWriteError writeCoercionNullEqUndefinedExplanationLineCall
set local lastConsoleWriteErrorCode writeCoercionNullEqUndefinedExplanationLineError
branchIfError writeCoercionNullEqUndefinedExplanationLineCall consoleWriteFailed

call writeCoercionNullEqZeroLineCall writeStandardOutputLine
arg writeCoercionNullEqZeroLineCall text coercionNullEqZeroText
run writeCoercionNullEqZeroLineCall
ignoreOk writeCoercionNullEqZeroLineCall Void
bindError writeCoercionNullEqZeroLineError ConsoleWriteError writeCoercionNullEqZeroLineCall
set local lastConsoleWriteErrorCode writeCoercionNullEqZeroLineError
branchIfError writeCoercionNullEqZeroLineCall consoleWriteFailed

call writeCoercionNullEqZeroExplanationLineCall writeStandardOutputLine
arg writeCoercionNullEqZeroExplanationLineCall text coercionNullEqZeroExplanationText
run writeCoercionNullEqZeroExplanationLineCall
ignoreOk writeCoercionNullEqZeroExplanationLineCall Void
bindError writeCoercionNullEqZeroExplanationLineError ConsoleWriteError writeCoercionNullEqZeroExplanationLineCall
set local lastConsoleWriteErrorCode writeCoercionNullEqZeroExplanationLineError
branchIfError writeCoercionNullEqZeroExplanationLineCall consoleWriteFailed

call writeCoercionBooleanStringFalseLineCall writeStandardOutputLine
arg writeCoercionBooleanStringFalseLineCall text coercionBooleanStringFalseText
run writeCoercionBooleanStringFalseLineCall
ignoreOk writeCoercionBooleanStringFalseLineCall Void
bindError writeCoercionBooleanStringFalseLineError ConsoleWriteError writeCoercionBooleanStringFalseLineCall
set local lastConsoleWriteErrorCode writeCoercionBooleanStringFalseLineError
branchIfError writeCoercionBooleanStringFalseLineCall consoleWriteFailed

call writeCoercionBooleanStringFalseExplanationLineCall writeStandardOutputLine
arg writeCoercionBooleanStringFalseExplanationLineCall text coercionBooleanStringFalseExplanationText
run writeCoercionBooleanStringFalseExplanationLineCall
ignoreOk writeCoercionBooleanStringFalseExplanationLineCall Void
bindError writeCoercionBooleanStringFalseExplanationLineError ConsoleWriteError writeCoercionBooleanStringFalseExplanationLineCall
set local lastConsoleWriteErrorCode writeCoercionBooleanStringFalseExplanationLineError
branchIfError writeCoercionBooleanStringFalseExplanationLineCall consoleWriteFailed

storage local immutable successfulExitCode ExitCode 0
returnOk successfulExitCode

label consoleWriteFailed
# rationale: lastConsoleWriteErrorCode holds whichever emit actually failed; its `set`
# ran immediately before the corresponding branchIfError, so the typed
# MainError.ConsoleWriteFailed value honestly names its cause (Â§12).
makeError consoleWriteFailure MainError.ConsoleWriteFailed lastConsoleWriteErrorCode
returnError consoleWriteFailure
