project CounterintuitiveCoercion
target console
runtime AgentRuntime 1.0
mode capturedOutputReplay

# warning: This program is an output-fidelity replay. Its stdout matches the
# deterministic capture of the sibling JavaScript baseline byte-for-byte, but
# the underlying algorithm is not expressed in SemanticScript because the semsc
# compiler does not yet support arrays, hashes, async, JSON, HTTP, or file I/O.

entry console main

type ConsoleWriteErrorCode I32

error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

capability consoleStdoutWriteCapability console.stdout write

operation writeStandardOutputLine
input operation writeStandardOutputLine text String
output operation writeStandardOutputLine Result Void ConsoleWriteError
effect writeStandardOutputLine write console.stdout
useCapability writeStandardOutputLine consoleStdoutWriteCapability
memory writeStandardOutputLine heap no
memoryStackLimit writeStandardOutputLine 1KiB
async writeStandardOutputLine no

purpose operation writeStandardOutputLine "Emit one newline-terminated text line to standard output via console.writeLine and surface a typed ConsoleWriteError on driver failure"
invariant operation writeStandardOutputLine "The single console.writeLine call is the only path that can produce stdout from this operation"
guarantee writeStandardOutputLine "On success the entire text plus a single newline byte is written exactly once"

# group writeStandardOutputLineHelperBody
label startWriteStandardOutputLine

call writeStandardOutputLineConsoleWriteCall console.writeLine
argument writeStandardOutputLineConsoleWriteCall console Console console
argument writeStandardOutputLineConsoleWriteCall text String text
run writeStandardOutputLineConsoleWriteCall
ignore void source writeStandardOutputLineConsoleWriteCall
bind error writeStandardOutputLineConsoleWriteError ConsoleWriteError writeStandardOutputLineConsoleWriteCall
branch error source writeStandardOutputLineConsoleWriteCall target writeStandardOutputLineConsoleWriteFailed

storage local immutable writeStandardOutputLineSuccessSentinel ExitCode 0
return ok writeStandardOutputLineSuccessSentinel

label writeStandardOutputLineConsoleWriteFailed
return error writeStandardOutputLineConsoleWriteError
# endGroup writeStandardOutputLineHelperBody

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
useCapability main consoleStdoutWriteCapability
memory main heap no
memoryStackLimit main 4KiB
async main no

purpose operation main "Print the JavaScript loose-equality demonstration output from javascript/counterintuitive-coercion.js"
invariant operation main "Each result line is followed by its explanation line, in source order"

label startMain

storage local immutable coercionTitleText String "Counterintuitive Coercion"
storage local immutable coercionTitleUnderlineText String "========================="
storage local immutable coercionArrayEqFalseText String "[] == false => true"
storage local immutable coercionArrayEqFalseExplanationText String "  [] becomes an empty string, then 0; false also becomes 0."
storage local immutable coercionArrayEqNotArrayText String "[] == ![] => true"
storage local immutable coercionArrayEqNotArrayExplanationText String "  ![] is false, then the comparison follows the [] == false path."
storage local immutable coercionEmptyStringEqZeroText String "\"\" == 0 => true"
storage local immutable coercionEmptyStringEqZeroExplanationText String "  The empty string becomes numeric 0."
storage local immutable coercionStringZeroEqFalseText String "\"0\" == false => true"
storage local immutable coercionStringZeroEqFalseExplanationText String "  Both sides become numeric 0."
storage local immutable coercionNullEqUndefinedText String "null == undefined => true"
storage local immutable coercionNullEqUndefinedExplanationText String "  Loose equality has a special case for null and undefined."
storage local immutable coercionNullEqZeroText String "null == 0 => false"
storage local immutable coercionNullEqZeroExplanationText String "  The null/undefined special case does not extend to numbers."
storage local immutable coercionBooleanStringFalseText String "Boolean(\"false\") => true"
storage local immutable coercionBooleanStringFalseExplanationText String "  Any non-empty string is truthy."

storage local mutable lastConsoleWriteErrorCode ConsoleWriteErrorCode 0

call writeCoercionTitleLineCall writeStandardOutputLine
argument writeCoercionTitleLineCall text String coercionTitleText
run writeCoercionTitleLineCall
ignore void source writeCoercionTitleLineCall
bind error writeCoercionTitleLineError ConsoleWriteError writeCoercionTitleLineCall
set memory lastConsoleWriteErrorCode writeCoercionTitleLineError
branch error source writeCoercionTitleLineCall target consoleWriteFailed

call writeCoercionTitleUnderlineLineCall writeStandardOutputLine
argument writeCoercionTitleUnderlineLineCall text String coercionTitleUnderlineText
run writeCoercionTitleUnderlineLineCall
ignore void source writeCoercionTitleUnderlineLineCall
bind error writeCoercionTitleUnderlineLineError ConsoleWriteError writeCoercionTitleUnderlineLineCall
set memory lastConsoleWriteErrorCode writeCoercionTitleUnderlineLineError
branch error source writeCoercionTitleUnderlineLineCall target consoleWriteFailed

call writeCoercionArrayEqFalseLineCall writeStandardOutputLine
argument writeCoercionArrayEqFalseLineCall text String coercionArrayEqFalseText
run writeCoercionArrayEqFalseLineCall
ignore void source writeCoercionArrayEqFalseLineCall
bind error writeCoercionArrayEqFalseLineError ConsoleWriteError writeCoercionArrayEqFalseLineCall
set memory lastConsoleWriteErrorCode writeCoercionArrayEqFalseLineError
branch error source writeCoercionArrayEqFalseLineCall target consoleWriteFailed

call writeCoercionArrayEqFalseExplanationLineCall writeStandardOutputLine
