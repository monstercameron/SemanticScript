# ============================================================
# Fourth stdlib import smoke (runtime + I/O modules)
# ============================================================
#
# rationale: closes the import-test coverage for the remaining
#   four modules: convert (numeric / pointer width adapters),
#   assert (typed AssertionError contracts), stdio (byte / string /
#   integer writers), and process (lifecycle terminators).
#   Together with the three earlier smoke tests, this completes
#   coverage of every std module behind importModule —
#   28 of 28 modules verified importable + usable from a
#   downstream program.
#
# invariant: convert/assert/stdio assertions hold; the process
#   module is only imported (not invoked) because its terminators
#   exitProcessWithStatusCode / abortCurrentProcess would kill the
#   test runner. The import succeeding is the unit test for
#   process — call sites are reachable through unreachable branches
#   so the linker still validates them.
#
# security: writes through stdio land on stdout; assertions
#   may write a short 'assert!\n' banner on failure. Test passes
#   imply no failure banner is emitted.
#
# timing: O(1) ops + a few stdio byte writes; entire test
#   runs in microseconds.
#
# observability: prints exactly one line of output —
#   the stdio writer test prints '12345\n', then 'OK\n' on success.

project StdlibImportSmokeRuntime
target console
runtime AgentRuntime 0.1
entry console stdlibImportSmokeRuntimeMain

error MainError
errorCase MainError StdlibImportRuntimeSmokeAssertionFailed
errorCase MainError ConsoleWriteFailed

# section capability
# rationale: smoke writes integer-writer output + an OK line to stdout.
# stdio.writeSignedInt64DecimalToStandardOutput allocates a small heap
# scratch buffer, so this smoke transitively needs heap allocate/free
# capabilities (memoryHeap stdlibImportSmokeRuntimeMain yes below).
capability stdoutWriteCapability console.stdout write
capability heapAllocationCapability heap allocate
capability heapFreeCapability heap free

# ----- imports under test (last four modules) -----
import convert convert
import assert assert
import stdio stdio
import process process

operation stdlibImportSmokeRuntimeMain
input operation stdlibImportSmokeRuntimeMain console Console
output operation stdlibImportSmokeRuntimeMain Result ExitCode MainError
useCapability stdlibImportSmokeRuntimeMain stdoutWriteCapability
useCapability stdlibImportSmokeRuntimeMain heapAllocationCapability
useCapability stdlibImportSmokeRuntimeMain heapFreeCapability
effect stdlibImportSmokeRuntimeMain write console.stdout
effect stdlibImportSmokeRuntimeMain allocate heap
effect stdlibImportSmokeRuntimeMain free heap
memory stdlibImportSmokeRuntimeMain heap yes
memoryAllocationSource stdlibImportSmokeRuntimeMain assertDecimalWriterCall
async stdlibImportSmokeRuntimeMain no
purpose operation stdlibImportSmokeRuntimeMain "Verify the last four stdlib modules (convert / assert / stdio / process) are reachable through importModule. process is imported but not invoked because its terminators would kill the test."
invariant operation stdlibImportSmokeRuntimeMain "convert + assert + stdio all return their declared values. process imports cleanly. Exit 0; stdout includes the integer-writer output then 'OK\\n'."

label startStdlibImportSmokeRuntimeMain

# ---- convert: widenSignedInt32ToSignedInt64(-1) preserves the value ----
storage module immutable negativeOneAsSignedInt32Import CSignedInt32 -1
storage module immutable negativeOneAsSignedInt64Import CSignedInt64 -1
call assertWidenNegativeOneCall widenSignedInt32ToSignedInt64
argument assertWidenNegativeOneCall inputValue CSignedInt32 negativeOneAsSignedInt32Import
run assertWidenNegativeOneCall
bind value widenNegativeOneResult CSignedInt64 assertWidenNegativeOneCall
call checkWidenNegativeOneCall math.equalI64
argument checkWidenNegativeOneCall left CSignedInt64 widenNegativeOneResult
argument checkWidenNegativeOneCall right I64 negativeOneAsSignedInt64Import
run checkWidenNegativeOneCall
bind value widenNegativeOneOk Bool checkWidenNegativeOneCall
branch if condition widenNegativeOneOk target widenNegativeOneHolds
branch else target stdlibImportRuntimeAssertionFailed
label widenNegativeOneHolds

# ---- convert: convertByteValueToUnsignedInt32(-1) == 255 ----
storage module immutable expectedTwoFiftyFiveForByteCoerceImport CSignedInt32 255
call assertByteCoerceCall convertByteValueToUnsignedInt32
argument assertByteCoerceCall signExtendedByteValue CSignedInt32 negativeOneAsSignedInt32Import
run assertByteCoerceCall
bind value byteCoerceResult CSignedInt32 assertByteCoerceCall
call checkByteCoerceCall math.equalI64
argument checkByteCoerceCall left CSignedInt32 byteCoerceResult
argument checkByteCoerceCall right I64 expectedTwoFiftyFiveForByteCoerceImport
run checkByteCoerceCall
bind value byteCoerceOk Bool checkByteCoerceCall
branch if condition byteCoerceOk target byteCoerceHolds
branch else target stdlibImportRuntimeAssertionFailed
label byteCoerceHolds

# ---- convert: convertFloat64ToSignedInt64(3.7) == 3 (truncate toward zero) ----
storage module immutable threePointSevenForFloatToIntImport CFloat64 3.7
storage module immutable threeExpectedForFloatToIntImport CSignedInt64 3
call assertFloatToIntCall convertFloat64ToSignedInt64
argument assertFloatToIntCall inputValue CFloat64 threePointSevenForFloatToIntImport
run assertFloatToIntCall
bind value floatToIntResult CSignedInt64 assertFloatToIntCall
call checkFloatToIntCall math.equalI64
argument checkFloatToIntCall left CSignedInt64 floatToIntResult
argument checkFloatToIntCall right I64 threeExpectedForFloatToIntImport
run checkFloatToIntCall
bind value floatToIntOk Bool checkFloatToIntCall
branch if condition floatToIntOk target floatToIntHolds
branch else target stdlibImportRuntimeAssertionFailed
label floatToIntHolds

# ---- assert: requireConditionTrue(true) succeeds — branchIfError continues ----
storage module immutable conditionTrueForAssertImport Bool true
call assertImportedConditionTrueCall requireConditionTrue
argument assertImportedConditionTrueCall conditionValue Bool conditionTrueForAssertImport
run assertImportedConditionTrueCall
branch error source assertImportedConditionTrueCall target stdlibImportRuntimeAssertionFailed

# ---- assert: requireSignedInt64ValuesEqual(42, 42) succeeds ----
storage module immutable fortyTwoForRequireEqualImport CSignedInt64 42
call assertImportedRequireEqualCall requireSignedInt64ValuesEqual
argument assertImportedRequireEqualCall leftValue CSignedInt64 fortyTwoForRequireEqualImport
argument assertImportedRequireEqualCall rightValue CSignedInt64 fortyTwoForRequireEqualImport
run assertImportedRequireEqualCall
branch error source assertImportedRequireEqualCall target stdlibImportRuntimeAssertionFailed

# ---- stdio: writeSignedInt64DecimalToStandardOutput(12345) writes the digits + newline.
# The byte count we get back should be 5 (digit count, not including newline).
storage module immutable twelveThousandThreeHundredFortyFiveForStdioImport CSignedInt64 12345
storage module immutable fiveExpectedDigitCountForStdioImport CByteCount 5
call assertStdioWriteIntegerCall writeSignedInt64DecimalToStandardOutput
argument assertStdioWriteIntegerCall inputValue CSignedInt64 twelveThousandThreeHundredFortyFiveForStdioImport
run assertStdioWriteIntegerCall
bind value stdioWriteIntegerResult CByteCount assertStdioWriteIntegerCall
call checkStdioWriteIntegerCall math.equalI64
argument checkStdioWriteIntegerCall left CByteCount stdioWriteIntegerResult
argument checkStdioWriteIntegerCall right I64 fiveExpectedDigitCountForStdioImport
run checkStdioWriteIntegerCall
bind value stdioWriteIntegerOk Bool checkStdioWriteIntegerCall
branch if condition stdioWriteIntegerOk target stdioWriteIntegerHolds
branch else target stdlibImportRuntimeAssertionFailed
label stdioWriteIntegerHolds

# ---- process: imports must resolve. We deliberately do NOT call
#      exitProcessWithStatusCode or abortCurrentProcess — both
#      terminate the process and would kill the test runner.
#      The unreachable branch below references both names so the
#      compiler links them, proving the import surface is wired up.
storage module immutable zeroForProcessImport CSignedInt32 0
storage module immutable importedFalseGuard Bool false
branch if condition importedFalseGuard target unreachableProcessSinkBranch
branch else target stdioWriteIntegerPostProcess
label unreachableProcessSinkBranch
call neverExitCall exitProcessWithStatusCode
argument neverExitCall exitStatusCode CSignedInt32 zeroForProcessImport
run neverExitCall
call neverAbortCall abortCurrentProcess
run neverAbortCall
jump target stdioWriteIntegerPostProcess
label stdioWriteIntegerPostProcess

storage module immutable runtimeImportSuccessMessage CNullTerminatedByteString "OK"
call writeRuntimeImportSuccessCall console.writeLine
argument writeRuntimeImportSuccessCall console Console console
argument writeRuntimeImportSuccessCall text CNullTerminatedByteString runtimeImportSuccessMessage
run writeRuntimeImportSuccessCall
ignore ok source writeRuntimeImportSuccessCall type CSignedInt32
bind error runtimeImportConsoleWriteError CSignedInt32 writeRuntimeImportSuccessCall
branch error source writeRuntimeImportSuccessCall target runtimeImportConsoleWriteFailed
storage module immutable runtimeImportExitOk ExitCode 0
return ok runtimeImportExitOk

label runtimeImportConsoleWriteFailed
makeError runtimeImportConsoleWriteFailure MainError.ConsoleWriteFailed runtimeImportConsoleWriteError
return error runtimeImportConsoleWriteFailure

label stdlibImportRuntimeAssertionFailed
makeError stdlibImportRuntimeFailure MainError.StdlibImportRuntimeSmokeAssertionFailed
return error stdlibImportRuntimeFailure
