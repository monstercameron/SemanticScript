# ============================================================
# Third stdlib import smoke (metadata-cluster modules)
# ============================================================
#
# rationale: the constants-style modules (char / constants /
#   stddef / errno / errno_more / signal_more) expose their surface
#   primarily through module-scope `domainLiteral` declarations, not
#   operations. This file proves those literals are reachable
#   through `importModule` and resolve to the right values. Two
#   small total-op modules (iso646 / bit) round out the sample.
#
# invariant: every imported constant matches its canonical
#   spec value; the two operations (evaluateIso646NotKeyword and
#   isSignedInt64BitSet) return the documented Bool outcome.
#
# security: pure value-level checks; no I/O beyond writing OK.
#
# timing: every check is O(1); whole test runs in microseconds.
#
# observability: prints `OK\n` on full pass.

project StdlibImportSmokeMetadata
target console
runtime AgentRuntime 0.1
entry console stdlibImportSmokeMetadataMain

error MainError
errorCase MainError StdlibImportMetadataSmokeAssertionFailed
errorCase MainError ConsoleWriteFailed

# section capability
# rationale: smoke writes a single OK line to stdout.
capability stdoutWriteCapability console.stdout write

# ----- imports under test (eight metadata-cluster modules) -----
import char standard.char
import constants standard.constants
import stddef standard.stddef
import errno standard.errno
import errno_more standard.errno_more
import signal_more standard.signal_more
import iso646 standard.iso646
import bit standard.bit
importConstant importedAsciiNewlineCharacterCode char asciiNewlineCharacterCode
importConstant importedAsciiDeleteCharacterCode char asciiDeleteCharacterCode
importConstant importedMathematicalPiFloat64 constants mathematicalPiFloat64
importConstant importedMathematicalEulerNumberFloat64 constants mathematicalEulerNumberFloat64
importConstant importedByteSizeOfOpaquePointer stddef byteSizeOfOpaquePointer
importConstant importedByteSizeOfFloat64 stddef byteSizeOfFloat64
importConstant importedFileNotFoundErrorNumber errno fileNotFoundErrorNumber
importConstant importedTryAgainErrorNumber errno_more tryAgainErrorNumber
importConstant importedOperationTimedOutErrorNumber errno_more operationTimedOutErrorNumber
importConstant importedKillSignalNumber signal_more killSignalNumber
importConstant importedHangupSignalNumber signal_more hangupSignalNumber

operation stdlibImportSmokeMetadataMain
input operation stdlibImportSmokeMetadataMain console Console
output operation stdlibImportSmokeMetadataMain Result ExitCode MainError
useCapability stdlibImportSmokeMetadataMain stdoutWriteCapability
effect stdlibImportSmokeMetadataMain write console.stdout
memory stdlibImportSmokeMetadataMain heap no
async stdlibImportSmokeMetadataMain no
purpose operation stdlibImportSmokeMetadataMain "Verify char / constants / stddef / errno / errno_more / signal_more / iso646 / bit domainLiterals and operations resolve correctly through importModule."
invariant operation stdlibImportSmokeMetadataMain "Every imported value equals its expected literal; final exit 0; stdout is 'OK\\n'."

label startStdlibImportSmokeMetadataMain

# ---- char: asciiNewlineCharacterCode == 10 ----
storage module immutable tenExpectedForNewlineImport Int32 10
call checkAsciiNewlineCall math.equalInt32
argument checkAsciiNewlineCall left Int32 importedAsciiNewlineCharacterCode
argument checkAsciiNewlineCall right Int32 tenExpectedForNewlineImport
run checkAsciiNewlineCall
bind value asciiNewlineOk Bool checkAsciiNewlineCall
branch if condition asciiNewlineOk target asciiNewlineHolds
branch else target stdlibImportMetadataAssertionFailed
label asciiNewlineHolds

# ---- char: asciiDeleteCharacterCode == 127 ----
storage module immutable oneHundredTwentySevenExpectedImport Int32 127
call checkAsciiDeleteCall math.equalInt32
argument checkAsciiDeleteCall left Int32 importedAsciiDeleteCharacterCode
argument checkAsciiDeleteCall right Int32 oneHundredTwentySevenExpectedImport
run checkAsciiDeleteCall
bind value asciiDeleteOk Bool checkAsciiDeleteCall
branch if condition asciiDeleteOk target asciiDeleteHolds
branch else target stdlibImportMetadataAssertionFailed
label asciiDeleteHolds

# ---- constants: mathematicalPiFloat64 == 3.141592653589793 ----
storage module immutable piLiteralExpectedImport Float64 3.141592653589793
call checkPiConstantCall math.equalFloat64
argument checkPiConstantCall left Float64 importedMathematicalPiFloat64
argument checkPiConstantCall right Float64 piLiteralExpectedImport
run checkPiConstantCall
bind value piConstantOk Bool checkPiConstantCall
branch if condition piConstantOk target piConstantHolds
branch else target stdlibImportMetadataAssertionFailed
label piConstantHolds

# ---- constants: mathematicalEulerNumberFloat64 == 2.718281828459045 ----
storage module immutable eulerNumberExpectedImport Float64 2.718281828459045
call checkEulerConstantCall math.equalFloat64
argument checkEulerConstantCall left Float64 importedMathematicalEulerNumberFloat64
argument checkEulerConstantCall right Float64 eulerNumberExpectedImport
run checkEulerConstantCall
bind value eulerConstantOk Bool checkEulerConstantCall
branch if condition eulerConstantOk target eulerConstantHolds
branch else target stdlibImportMetadataAssertionFailed
label eulerConstantHolds

# ---- stddef: byteSizeOfOpaquePointer == 8 (x86-64 ABI) ----
storage module immutable eightExpectedForPointerByteSizeImport Int64 8
call checkPointerByteSizeCall math.equalInt64
argument checkPointerByteSizeCall left Int64 importedByteSizeOfOpaquePointer
argument checkPointerByteSizeCall right Int64 eightExpectedForPointerByteSizeImport
run checkPointerByteSizeCall
bind value pointerByteSizeOk Bool checkPointerByteSizeCall
branch if condition pointerByteSizeOk target pointerByteSizeHolds
branch else target stdlibImportMetadataAssertionFailed
label pointerByteSizeHolds

# ---- stddef: byteSizeOfFloat64 == 8 ----
call checkFloat64ByteSizeCall math.equalInt64
argument checkFloat64ByteSizeCall left Int64 importedByteSizeOfFloat64
argument checkFloat64ByteSizeCall right Int64 eightExpectedForPointerByteSizeImport
run checkFloat64ByteSizeCall
bind value float64ByteSizeOk Bool checkFloat64ByteSizeCall
branch if condition float64ByteSizeOk target float64ByteSizeHolds
branch else target stdlibImportMetadataAssertionFailed
label float64ByteSizeHolds

# ---- errno: fileNotFoundErrorNumber == 2 (POSIX ENOENT) ----
storage module immutable twoExpectedForEnoentImport Int32 2
call checkEnoentCall math.equalInt32
argument checkEnoentCall left Int32 importedFileNotFoundErrorNumber
argument checkEnoentCall right Int32 twoExpectedForEnoentImport
run checkEnoentCall
bind value enoentOk Bool checkEnoentCall
branch if condition enoentOk target enoentHolds
branch else target stdlibImportMetadataAssertionFailed
label enoentHolds

# ---- errno: lookupErrnoMessageCString(2) is callable through the import ----
call lookupEnoentMessageCall lookupErrnoMessageCString
argument lookupEnoentMessageCall errorNumber Int32 importedFileNotFoundErrorNumber
run lookupEnoentMessageCall
ignore value source lookupEnoentMessageCall type String

# ---- errno_more: tryAgainErrorNumber == 11 (POSIX EAGAIN) ----
storage module immutable elevenExpectedForEagainImport Int32 11
call checkEagainCall math.equalInt32
argument checkEagainCall left Int32 importedTryAgainErrorNumber
argument checkEagainCall right Int32 elevenExpectedForEagainImport
run checkEagainCall
bind value eagainOk Bool checkEagainCall
branch if condition eagainOk target eagainHolds
branch else target stdlibImportMetadataAssertionFailed
label eagainHolds

# ---- errno_more: operationTimedOutErrorNumber == 110 (POSIX ETIMEDOUT) ----
storage module immutable oneHundredTenExpectedForEtimedoutImport Int32 110
call checkEtimedoutCall math.equalInt32
argument checkEtimedoutCall left Int32 importedOperationTimedOutErrorNumber
argument checkEtimedoutCall right Int32 oneHundredTenExpectedForEtimedoutImport
run checkEtimedoutCall
bind value etimedoutOk Bool checkEtimedoutCall
branch if condition etimedoutOk target etimedoutHolds
branch else target stdlibImportMetadataAssertionFailed
label etimedoutHolds

# ---- signal_more: killSignalNumber == 9 (POSIX SIGKILL) ----
storage module immutable nineExpectedForSigkillImport Int32 9
call checkSigkillCall math.equalInt32
argument checkSigkillCall left Int32 importedKillSignalNumber
argument checkSigkillCall right Int32 nineExpectedForSigkillImport
run checkSigkillCall
bind value sigkillOk Bool checkSigkillCall
branch if condition sigkillOk target sigkillHolds
branch else target stdlibImportMetadataAssertionFailed
label sigkillHolds

# ---- signal_more: hangupSignalNumber == 1 (POSIX SIGHUP) ----
storage module immutable oneExpectedForSighupImport Int32 1
call checkSighupCall math.equalInt32
argument checkSighupCall left Int32 importedHangupSignalNumber
argument checkSighupCall right Int32 oneExpectedForSighupImport
run checkSighupCall
bind value sighupOk Bool checkSighupCall
branch if condition sighupOk target sighupHolds
branch else target stdlibImportMetadataAssertionFailed
label sighupHolds

# ---- iso646: evaluateIso646NotKeyword(0) == true ----
storage module immutable integerZeroForIso646Import Int64 0
call assertIso646NotZeroCall evaluateIso646NotKeyword
argument assertIso646NotZeroCall inputValue Int64 integerZeroForIso646Import
run assertIso646NotZeroCall
bind value iso646NotZeroResult Bool assertIso646NotZeroCall
branch if condition iso646NotZeroResult target iso646NotZeroHolds
branch else target stdlibImportMetadataAssertionFailed
label iso646NotZeroHolds

# ---- iso646: evaluateIso646NotEqualKeyword(1, 2) == true ----
storage module immutable integerOneForIso646Import Int64 1
storage module immutable integerTwoForIso646Import Int64 2
call assertIso646NotEqualCall evaluateIso646NotEqualKeyword
argument assertIso646NotEqualCall leftValue Int64 integerOneForIso646Import
argument assertIso646NotEqualCall rightValue Int64 integerTwoForIso646Import
run assertIso646NotEqualCall
bind value iso646NotEqualResult Bool assertIso646NotEqualCall
branch if condition iso646NotEqualResult target iso646NotEqualHolds
branch else target stdlibImportMetadataAssertionFailed
label iso646NotEqualHolds

# ---- bit: isSignedInt64BitSet(48, 4) == true (48 == 0b110000, bit 4 set) ----
storage module immutable fortyEightForBitImport Int64 48
storage module immutable fourthBitIndexForBitImport Int64 4
call assertBitSetImportCall isSignedInt64BitSet
argument assertBitSetImportCall inputValue Int64 fortyEightForBitImport
argument assertBitSetImportCall bitIndex Int64 fourthBitIndexForBitImport
run assertBitSetImportCall
bind value bitSetImportResult Bool assertBitSetImportCall
branch if condition bitSetImportResult target bitSetImportHolds
branch else target stdlibImportMetadataAssertionFailed
label bitSetImportHolds

# ---- bit: shiftSignedInt64BitsLeft(3, 4) == 48 ----
storage module immutable threeForShiftLeftImport Int64 3
storage module immutable fortyEightExpectedForShiftLeftImport Int64 48
call assertShiftLeftImportCall shiftSignedInt64BitsLeft
argument assertShiftLeftImportCall inputValue Int64 threeForShiftLeftImport
argument assertShiftLeftImportCall bitIndex Int64 fourthBitIndexForBitImport
run assertShiftLeftImportCall
bind value shiftLeftImportResult Int64 assertShiftLeftImportCall
call checkShiftLeftImportCall math.equalInt64
argument checkShiftLeftImportCall left Int64 shiftLeftImportResult
argument checkShiftLeftImportCall right Int64 fortyEightExpectedForShiftLeftImport
run checkShiftLeftImportCall
bind value shiftLeftImportOk Bool checkShiftLeftImportCall
branch if condition shiftLeftImportOk target shiftLeftImportHolds
branch else target stdlibImportMetadataAssertionFailed
label shiftLeftImportHolds

# All metadata-cluster checks held.
storage module immutable metadataImportSuccessMessage String "OK"
call writeMetadataImportSuccessCall console.writeLine
argument writeMetadataImportSuccessCall text String metadataImportSuccessMessage
run writeMetadataImportSuccessCall
ignore void source writeMetadataImportSuccessCall
bind error metadataImportConsoleWriteError Int32 writeMetadataImportSuccessCall
branch error source writeMetadataImportSuccessCall target metadataImportConsoleWriteFailed
storage module immutable metadataImportExitOk ExitCode 0
return ok metadataImportExitOk

label metadataImportConsoleWriteFailed
makeError metadataImportConsoleWriteFailure MainError.ConsoleWriteFailed metadataImportConsoleWriteError
return error metadataImportConsoleWriteFailure

label stdlibImportMetadataAssertionFailed
makeError stdlibImportMetadataFailure MainError.StdlibImportMetadataSmokeAssertionFailed
return error stdlibImportMetadataFailure
