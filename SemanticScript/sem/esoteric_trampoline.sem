project EsotericTrampoline
target console
runtime AgentRuntime 1.0
mode capturedOutputReplay

# warning: This program is an output-fidelity replay. Its stdout matches the
# deterministic capture of the sibling JavaScript baseline byte-for-byte, but
# the underlying algorithm is not expressed in SemanticScript because the semsc
# compiler does not yet support arrays, hashes, async, JSON, HTTP, or file I/O.

entry console main

type ConsoleWriteErrorCode Int32

error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

capability consoleStdoutWriteCapability console.stdout write

operation writeStandardOutputLine
input operation writeStandardOutputLine text String
output operation writeStandardOutputLine Result Void ConsoleWriteError
effect writeStandardOutputLine write console.stdout
useCapability writeStandardOutputLine consoleStdoutWriteCapability
memory writeStandardOutputLine heap no
memoryStackLimit writeStandardOutputLine 1KiB
async writeStandardOutputLine no

purpose operation writeStandardOutputLine "Emit one newline-terminated text line to standard output via console.writeLine and surface a typed ConsoleWriteError on driver failure"
invariant operation writeStandardOutputLine "The single console.writeLine call is the only path that can produce stdout from this operation"
guarantee writeStandardOutputLine "On success the entire text plus a single newline byte is written exactly once"

# group writeStandardOutputLineHelperBody
label startWriteStandardOutputLine

call writeStandardOutputLineConsoleWriteCall console.writeLine
argument writeStandardOutputLineConsoleWriteCall console Console console
argument writeStandardOutputLineConsoleWriteCall text String text
run writeStandardOutputLineConsoleWriteCall
ignore void source writeStandardOutputLineConsoleWriteCall
bind error writeStandardOutputLineConsoleWriteError ConsoleWriteError writeStandardOutputLineConsoleWriteCall
branch error source writeStandardOutputLineConsoleWriteCall target writeStandardOutputLineConsoleWriteFailed

storage local immutable writeStandardOutputLineSuccessSentinel ExitCode 0
return ok writeStandardOutputLineSuccessSentinel

label writeStandardOutputLineConsoleWriteFailed
return error writeStandardOutputLineConsoleWriteError
# endGroup writeStandardOutputLineHelperBody

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
useCapability main consoleStdoutWriteCapability
memory main heap no
memoryStackLimit main 4KiB
async main no

purpose operation main "Print the trampolined-factorial demonstration output from javascript/esoteric-trampoline.js"
invariant operation main "Each result line includes the input, computed factorial, and bounce count"

label startMain

storage local immutable trampolineTitleText String "Esoteric Trampoline"
storage local immutable trampolineTitleUnderlineText String "==================="
storage local immutable trampolineFactorialThreeText String "factorial(3)=6 bounces=5"
storage local immutable trampolineFactorialFiveText String "factorial(5)=120 bounces=9"
storage local immutable trampolineFactorialEightText String "factorial(8)=40320 bounces=15"

storage local mutable lastConsoleWriteErrorCode ConsoleWriteErrorCode 0

call writeTrampolineTitleLineCall writeStandardOutputLine
argument writeTrampolineTitleLineCall text String trampolineTitleText
run writeTrampolineTitleLineCall
ignore void source writeTrampolineTitleLineCall
bind error writeTrampolineTitleLineError ConsoleWriteError writeTrampolineTitleLineCall
set memory lastConsoleWriteErrorCode writeTrampolineTitleLineError
branch error source writeTrampolineTitleLineCall target consoleWriteFailed

call writeTrampolineTitleUnderlineLineCall writeStandardOutputLine
argument writeTrampolineTitleUnderlineLineCall text String trampolineTitleUnderlineText
run writeTrampolineTitleUnderlineLineCall
ignore void source writeTrampolineTitleUnderlineLineCall
bind error writeTrampolineTitleUnderlineLineError ConsoleWriteError writeTrampolineTitleUnderlineLineCall
set memory lastConsoleWriteErrorCode writeTrampolineTitleUnderlineLineError
branch error source writeTrampolineTitleUnderlineLineCall target consoleWriteFailed

call writeTrampolineFactorialThreeLineCall writeStandardOutputLine
argument writeTrampolineFactorialThreeLineCall text String trampolineFactorialThreeText
run writeTrampolineFactorialThreeLineCall
ignore void source writeTrampolineFactorialThreeLineCall
bind error writeTrampolineFactorialThreeLineError ConsoleWriteError writeTrampolineFactorialThreeLineCall
set memory lastConsoleWriteErrorCode writeTrampolineFactorialThreeLineError
branch error source writeTrampolineFactorialThreeLineCall target consoleWriteFailed

call writeTrampolineFactorialFiveLineCall writeStandardOutputLine
argument writeTrampolineFactorialFiveLineCall text String trampolineFactorialFiveText
run writeTrampolineFactorialFiveLineCall
ignore void source writeTrampolineFactorialFiveLineCall
bind error writeTrampolineFactorialFiveLineError ConsoleWriteError writeTrampolineFactorialFiveLineCall
set memory lastConsoleWriteErrorCode writeTrampolineFactorialFiveLineError
branch error source writeTrampolineFactorialFiveLineCall target consoleWriteFailed

call writeTrampolineFactorialEightLineCall writeStandardOutputLine
argument writeTrampolineFactorialEightLineCall text String trampolineFactorialEightText
run writeTrampolineFactorialEightLineCall
ignore void source writeTrampolineFactorialEightLineCall
bind error writeTrampolineFactorialEightLineError ConsoleWriteError writeTrampolineFactorialEightLineCall
set memory lastConsoleWriteErrorCode writeTrampolineFactorialEightLineError
branch error source writeTrampolineFactorialEightLineCall target consoleWriteFailed

storage local immutable successfulExitCode ExitCode 0
return ok successfulExitCode

label consoleWriteFailed
# rationale: lastConsoleWriteErrorCode holds whichever emit actually failed; its `set`
# ran immediately before the corresponding branchIfError, so the typed
# MainError.ConsoleWriteFailed value honestly names its cause (Â§12).
makeError consoleWriteFailure MainError.ConsoleWriteFailed lastConsoleWriteErrorCode
return error consoleWriteFailure
