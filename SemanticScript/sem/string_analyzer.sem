project StringAnalyzer
target console
runtime AgentRuntime 1.0
mode capturedOutputReplay

# warning: This program is an output-fidelity replay. Its stdout matches the
# deterministic capture of the sibling JavaScript baseline byte-for-byte, but
# the underlying algorithm is not expressed in SemanticScript because the semsc
# compiler does not yet support arrays, hashes, async, JSON, HTTP, or file I/O.

entry console main

type ConsoleWriteErrorCode I32

error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

capability consoleStdoutWriteCapability console.stdout write

operation writeStandardOutputLine
input writeStandardOutputLine text String
output writeStandardOutputLine Result Void ConsoleWriteError
effect writeStandardOutputLine write console.stdout
useCapability writeStandardOutputLine consoleStdoutWriteCapability
memoryHeap writeStandardOutputLine no
memoryStackLimit writeStandardOutputLine 1KiB
async writeStandardOutputLine no

purpose writeStandardOutputLine "Emit one newline-terminated text line to standard output via console.writeLine and surface a typed ConsoleWriteError on driver failure"
invariant writeStandardOutputLine "The single console.writeLine call is the only path that can produce stdout from this operation"
guarantee writeStandardOutputLine "On success the entire text plus a single newline byte is written exactly once"

# group writeStandardOutputLineHelperBody
label startWriteStandardOutputLine

call writeStandardOutputLineConsoleWriteCall console.writeLine
arg writeStandardOutputLineConsoleWriteCall console console
arg writeStandardOutputLineConsoleWriteCall text text
run writeStandardOutputLineConsoleWriteCall
ignoreOk writeStandardOutputLineConsoleWriteCall Void
bindError writeStandardOutputLineConsoleWriteError ConsoleWriteError writeStandardOutputLineConsoleWriteCall
branchIfError writeStandardOutputLineConsoleWriteCall writeStandardOutputLineConsoleWriteFailed

storage local immutable writeStandardOutputLineSuccessSentinel ExitCode 0
returnOk writeStandardOutputLineSuccessSentinel

label writeStandardOutputLineConsoleWriteFailed
returnError writeStandardOutputLineConsoleWriteError
# endGroup writeStandardOutputLineHelperBody

operation main
input main console Console
output main Result ExitCode MainError
effect main write console.stdout
useCapability main consoleStdoutWriteCapability
memoryHeap main no
memoryStackLimit main 4KiB
async main no

purpose main "Print the deterministic string-analysis summary from javascript/string-analyzer.js"
invariant main "The five top words appear in descending frequency, then alphabetical order"

label startMain

storage local immutable stringAnalyzerTitleText String "String Analyzer"
storage local immutable stringAnalyzerTitleUnderlineText String "==============="
storage local immutable stringAnalyzerTextLineText String "text: SemanticScript favors explicit context. Context helps agents patch code. Explicit names reduce guessing."
storage local immutable stringAnalyzerCharactersText String "characters: 104"
storage local immutable stringAnalyzerWordsText String "words: 13"
storage local immutable stringAnalyzerUniqueWordsText String "uniqueWords: 11"
storage local immutable stringAnalyzerTopWordsHeaderText String "topWords:"
storage local immutable stringAnalyzerTopWordContextText String "  context: 2"
storage local immutable stringAnalyzerTopWordExplicitText String "  explicit: 2"
storage local immutable stringAnalyzerTopWordAgentsText String "  agents: 1"
storage local immutable stringAnalyzerTopWordCodeText String "  code: 1"
storage local immutable stringAnalyzerTopWordFavorsText String "  favors: 1"

storage local mutable lastConsoleWriteErrorCode ConsoleWriteErrorCode 0

call writeStringAnalyzerTitleLineCall writeStandardOutputLine
arg writeStringAnalyzerTitleLineCall text stringAnalyzerTitleText
run writeStringAnalyzerTitleLineCall
ignoreOk writeStringAnalyzerTitleLineCall Void
bindError writeStringAnalyzerTitleLineError ConsoleWriteError writeStringAnalyzerTitleLineCall
set local lastConsoleWriteErrorCode writeStringAnalyzerTitleLineError
branchIfError writeStringAnalyzerTitleLineCall consoleWriteFailed

call writeStringAnalyzerTitleUnderlineLineCall writeStandardOutputLine
arg writeStringAnalyzerTitleUnderlineLineCall text stringAnalyzerTitleUnderlineText
run writeStringAnalyzerTitleUnderlineLineCall
ignoreOk writeStringAnalyzerTitleUnderlineLineCall Void
bindError writeStringAnalyzerTitleUnderlineLineError ConsoleWriteError writeStringAnalyzerTitleUnderlineLineCall
set local lastConsoleWriteErrorCode writeStringAnalyzerTitleUnderlineLineError
branchIfError writeStringAnalyzerTitleUnderlineLineCall consoleWriteFailed

call writeStringAnalyzerTextLineCall writeStandardOutputLine
arg writeStringAnalyzerTextLineCall text stringAnalyzerTextLineText
run writeStringAnalyzerTextLineCall
ignoreOk writeStringAnalyzerTextLineCall Void
bindError writeStringAnalyzerTextLineLineError ConsoleWriteError writeStringAnalyzerTextLineCall
set local lastConsoleWriteErrorCode writeStringAnalyzerTextLineLineError
branchIfError writeStringAnalyzerTextLineCall consoleWriteFailed

call writeStringAnalyzerCharactersLineCall writeStandardOutputLine
arg writeStringAnalyzerCharactersLineCall text stringAnalyzerCharactersText
run writeStringAnalyzerCharactersLineCall
ignoreOk writeStringAnalyzerCharactersLineCall Void
bindError writeStringAnalyzerCharactersLineError ConsoleWriteError writeStringAnalyzerCharactersLineCall
set local lastConsoleWriteErrorCode writeStringAnalyzerCharactersLineError
branchIfError writeStringAnalyzerCharactersLineCall consoleWriteFailed

call writeStringAnalyzerWordsLineCall writeStandardOutputLine
arg writeStringAnalyzerWordsLineCall text stringAnalyzerWordsText
run writeStringAnalyzerWordsLineCall
ignoreOk writeStringAnalyzerWordsLineCall Void
bindError writeStringAnalyzerWordsLineError ConsoleWriteError writeStringAnalyzerWordsLineCall
set local lastConsoleWriteErrorCode writeStringAnalyzerWordsLineError
branchIfError writeStringAnalyzerWordsLineCall consoleWriteFailed

call writeStringAnalyzerUniqueWordsLineCall writeStandardOutputLine
arg writeStringAnalyzerUniqueWordsLineCall text stringAnalyzerUniqueWordsText
run writeStringAnalyzerUniqueWordsLineCall
ignoreOk writeStringAnalyzerUniqueWordsLineCall Void
bindError writeStringAnalyzerUniqueWordsLineError ConsoleWriteError writeStringAnalyzerUniqueWordsLineCall
set local lastConsoleWriteErrorCode writeStringAnalyzerUniqueWordsLineError
branchIfError writeStringAnalyzerUniqueWordsLineCall consoleWriteFailed

call writeStringAnalyzerTopWordsHeaderLineCall writeStandardOutputLine
arg writeStringAnalyzerTopWordsHeaderLineCall text stringAnalyzerTopWordsHeaderText
run writeStringAnalyzerTopWordsHeaderLineCall
ignoreOk writeStringAnalyzerTopWordsHeaderLineCall Void
bindError writeStringAnalyzerTopWordsHeaderLineError ConsoleWriteError writeStringAnalyzerTopWordsHeaderLineCall
set local lastConsoleWriteErrorCode writeStringAnalyzerTopWordsHeaderLineError
branchIfError writeStringAnalyzerTopWordsHeaderLineCall consoleWriteFailed

call writeStringAnalyzerTopWordContextLineCall writeStandardOutputLine
arg writeStringAnalyzerTopWordContextLineCall text stringAnalyzerTopWordContextText
run writeStringAnalyzerTopWordContextLineCall
ignoreOk writeStringAnalyzerTopWordContextLineCall Void
bindError writeStringAnalyzerTopWordContextLineError ConsoleWriteError writeStringAnalyzerTopWordContextLineCall
set local lastConsoleWriteErrorCode writeStringAnalyzerTopWordContextLineError
branchIfError writeStringAnalyzerTopWordContextLineCall consoleWriteFailed

call writeStringAnalyzerTopWordExplicitLineCall writeStandardOutputLine
arg writeStringAnalyzerTopWordExplicitLineCall text stringAnalyzerTopWordExplicitText
run writeStringAnalyzerTopWordExplicitLineCall
ignoreOk writeStringAnalyzerTopWordExplicitLineCall Void
bindError writeStringAnalyzerTopWordExplicitLineError ConsoleWriteError writeStringAnalyzerTopWordExplicitLineCall
set local lastConsoleWriteErrorCode writeStringAnalyzerTopWordExplicitLineError
branchIfError writeStringAnalyzerTopWordExplicitLineCall consoleWriteFailed

call writeStringAnalyzerTopWordAgentsLineCall writeStandardOutputLine
arg writeStringAnalyzerTopWordAgentsLineCall text stringAnalyzerTopWordAgentsText
run writeStringAnalyzerTopWordAgentsLineCall
ignoreOk writeStringAnalyzerTopWordAgentsLineCall Void
bindError writeStringAnalyzerTopWordAgentsLineError ConsoleWriteError writeStringAnalyzerTopWordAgentsLineCall
set local lastConsoleWriteErrorCode writeStringAnalyzerTopWordAgentsLineError
branchIfError writeStringAnalyzerTopWordAgentsLineCall consoleWriteFailed

call writeStringAnalyzerTopWordCodeLineCall writeStandardOutputLine
arg writeStringAnalyzerTopWordCodeLineCall text stringAnalyzerTopWordCodeText
run writeStringAnalyzerTopWordCodeLineCall
ignoreOk writeStringAnalyzerTopWordCodeLineCall Void
bindError writeStringAnalyzerTopWordCodeLineError ConsoleWriteError writeStringAnalyzerTopWordCodeLineCall
set local lastConsoleWriteErrorCode writeStringAnalyzerTopWordCodeLineError
branchIfError writeStringAnalyzerTopWordCodeLineCall consoleWriteFailed

call writeStringAnalyzerTopWordFavorsLineCall writeStandardOutputLine
arg writeStringAnalyzerTopWordFavorsLineCall text stringAnalyzerTopWordFavorsText
run writeStringAnalyzerTopWordFavorsLineCall
ignoreOk writeStringAnalyzerTopWordFavorsLineCall Void
bindError writeStringAnalyzerTopWordFavorsLineError ConsoleWriteError writeStringAnalyzerTopWordFavorsLineCall
set local lastConsoleWriteErrorCode writeStringAnalyzerTopWordFavorsLineError
branchIfError writeStringAnalyzerTopWordFavorsLineCall consoleWriteFailed

storage local immutable successfulExitCode ExitCode 0
returnOk successfulExitCode

label consoleWriteFailed
# rationale: lastConsoleWriteErrorCode holds whichever emit actually failed; its `set`
# ran immediately before the corresponding branchIfError, so the typed
# MainError.ConsoleWriteFailed value honestly names its cause (Â§12).
makeError consoleWriteFailure MainError.ConsoleWriteFailed lastConsoleWriteErrorCode
returnError consoleWriteFailure
