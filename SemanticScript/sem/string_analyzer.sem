project StringAnalyzer
target console
runtime AgentRuntime 1.0
mode capturedOutputReplay

# warning: This program is an output-fidelity replay. Its stdout matches the
# deterministic capture of the sibling JavaScript baseline byte-for-byte, but
# the underlying algorithm is not expressed in SemanticScript because the semsc
# compiler does not yet support arrays, hashes, async, JSON, HTTP, or file I/O.

entry console main

type ConsoleWriteErrorCode I32

error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

capability consoleStdoutWriteCapability console.stdout write

operation writeStandardOutputLine
input operation writeStandardOutputLine text String
output operation writeStandardOutputLine Result Void ConsoleWriteError
effect writeStandardOutputLine write console.stdout
useCapability writeStandardOutputLine consoleStdoutWriteCapability
memory writeStandardOutputLine heap no
memoryStackLimit writeStandardOutputLine 1KiB
async writeStandardOutputLine no

purpose operation writeStandardOutputLine "Emit one newline-terminated text line to standard output via console.writeLine and surface a typed ConsoleWriteError on driver failure"
invariant operation writeStandardOutputLine "The single console.writeLine call is the only path that can produce stdout from this operation"
guarantee writeStandardOutputLine "On success the entire text plus a single newline byte is written exactly once"

# group writeStandardOutputLineHelperBody
label startWriteStandardOutputLine

call writeStandardOutputLineConsoleWriteCall console.writeLine
argument writeStandardOutputLineConsoleWriteCall console Console console
argument writeStandardOutputLineConsoleWriteCall text String text
run writeStandardOutputLineConsoleWriteCall
ignore void source writeStandardOutputLineConsoleWriteCall
bind error writeStandardOutputLineConsoleWriteError ConsoleWriteError writeStandardOutputLineConsoleWriteCall
branch error source writeStandardOutputLineConsoleWriteCall target writeStandardOutputLineConsoleWriteFailed

storage local immutable writeStandardOutputLineSuccessSentinel ExitCode 0
return ok writeStandardOutputLineSuccessSentinel

label writeStandardOutputLineConsoleWriteFailed
return error writeStandardOutputLineConsoleWriteError
# endGroup writeStandardOutputLineHelperBody

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
useCapability main consoleStdoutWriteCapability
memory main heap no
memoryStackLimit main 4KiB
async main no

purpose operation main "Print the deterministic string-analysis summary from javascript/string-analyzer.js"
invariant operation main "The five top words appear in descending frequency, then alphabetical order"

label startMain

storage local immutable stringAnalyzerTitleText String "String Analyzer"
storage local immutable stringAnalyzerTitleUnderlineText String "==============="
storage local immutable stringAnalyzerTextLineText String "text: SemanticScript favors explicit context. Context helps agents patch code. Explicit names reduce guessing."
storage local immutable stringAnalyzerCharactersText String "characters: 104"
storage local immutable stringAnalyzerWordsText String "words: 13"
storage local immutable stringAnalyzerUniqueWordsText String "uniqueWords: 11"
storage local immutable stringAnalyzerTopWordsHeaderText String "topWords:"
storage local immutable stringAnalyzerTopWordContextText String "  context: 2"
storage local immutable stringAnalyzerTopWordExplicitText String "  explicit: 2"
storage local immutable stringAnalyzerTopWordAgentsText String "  agents: 1"
storage local immutable stringAnalyzerTopWordCodeText String "  code: 1"
storage local immutable stringAnalyzerTopWordFavorsText String "  favors: 1"

storage local mutable lastConsoleWriteErrorCode ConsoleWriteErrorCode 0

call writeStringAnalyzerTitleLineCall writeStandardOutputLine
argument writeStringAnalyzerTitleLineCall text String stringAnalyzerTitleText
run writeStringAnalyzerTitleLineCall
ignore void source writeStringAnalyzerTitleLineCall
bind error writeStringAnalyzerTitleLineError ConsoleWriteError writeStringAnalyzerTitleLineCall
set memory lastConsoleWriteErrorCode writeStringAnalyzerTitleLineError
branch error source writeStringAnalyzerTitleLineCall target consoleWriteFailed

call writeStringAnalyzerTitleUnderlineLineCall writeStandardOutputLine
argument writeStringAnalyzerTitleUnderlineLineCall text String stringAnalyzerTitleUnderlineText
run writeStringAnalyzerTitleUnderlineLineCall
ignore void source writeStringAnalyzerTitleUnderlineLineCall
bind error writeStringAnalyzerTitleUnderlineLineError ConsoleWriteError writeStringAnalyzerTitleUnderlineLineCall
set memory lastConsoleWriteErrorCode writeStringAnalyzerTitleUnderlineLineError
branch error source writeStringAnalyzerTitleUnderlineLineCall target consoleWriteFailed

call writeStringAnalyzerTextLineCall writeStandardOutputLine
argument writeStringAnalyzerTextLineCall text String stringAnalyzerTextLineText
run writeStringAnalyzerTextLineCall
ignore void source writeStringAnalyzerTextLineCall
bind error writeStringAnalyzerTextLineLineError ConsoleWriteError writeStringAnalyzerTextLineCall
set memory lastConsoleWriteErrorCode writeStringAnalyzerTextLineLineError
branch error source writeStringAnalyzerTextLineCall target consoleWriteFailed

call writeStringAnalyzerCharactersLineCall writeStandardOutputLine
argument writeStringAnalyzerCharactersLineCall text String stringAnalyzerCharactersText
run writeStringAnalyzerCharactersLineCall
ignore void source writeStringAnalyzerCharactersLineCall
bind error writeStringAnalyzerCharactersLineError ConsoleWriteError writeStringAnalyzerCharactersLineCall
set memory lastConsoleWriteErrorCode writeStringAnalyzerCharactersLineError
branch error source writeStringAnalyzerCharactersLineCall target consoleWriteFailed

call writeStringAnalyzerWordsLineCall writeStandardOutputLine
argument writeStringAnalyzerWordsLineCall text String stringAnalyzerWordsText
run writeStringAnalyzerWordsLineCall
ignore void source writeStringAnalyzerWordsLineCall
bind error writeStringAnalyzerWordsLineError ConsoleWriteError writeStringAnalyzerWordsLineCall
set memory lastConsoleWriteErrorCode writeStringAnalyzerWordsLineError
branch error source writeStringAnalyzerWordsLineCall target consoleWriteFailed

call writeStringAnalyzerUniqueWordsLineCall writeStandardOutputLine
argument writeStringAnalyzerUniqueWordsLineCall text String stringAnalyzerUniqueWordsText
run writeStringAnalyzerUniqueWordsLineCall
ignore void source writeStringAnalyzerUniqueWordsLineCall
bind error writeStringAnalyzerUniqueWordsLineError ConsoleWriteError writeStringAnalyzerUniqueWordsLineCall
set memory lastConsoleWriteErrorCode writeStringAnalyzerUniqueWordsLineError
branch error source writeStringAnalyzerUniqueWordsLineCall target consoleWriteFailed

call writeStringAnalyzerTopWordsHeaderLineCall writeStandardOutputLine
argument writeStringAnalyzerTopWordsHeaderLineCall text String stringAnalyzerTopWordsHeaderText
run writeStringAnalyzerTopWordsHeaderLineCall
ignore void source writeStringAnalyzerTopWordsHeaderLineCall
bind error writeStringAnalyzerTopWordsHeaderLineError ConsoleWriteError writeStringAnalyzerTopWordsHeaderLineCall
set memory lastConsoleWriteErrorCode writeStringAnalyzerTopWordsHeaderLineError
branch error source writeStringAnalyzerTopWordsHeaderLineCall target consoleWriteFailed

call writeStringAnalyzerTopWordContextLineCall writeStandardOutputLine
argument writeStringAnalyzerTopWordContextLineCall text String stringAnalyzerTopWordContextText
run writeStringAnalyzerTopWordContextLineCall
ignore void source writeStringAnalyzerTopWordContextLineCall
bind error writeStringAnalyzerTopWordContextLineError ConsoleWriteError writeStringAnalyzerTopWordContextLineCall
set memory lastConsoleWriteErrorCode writeStringAnalyzerTopWordContextLineError
branch error source writeStringAnalyzerTopWordContextLineCall target consoleWriteFailed

call writeStringAnalyzerTopWordExplicitLineCall writeStandardOutputLine
argument writeStringAnalyzerTopWordExplicitLineCall text String stringAnalyzerTopWordExplicitText
run writeStringAnalyzerTopWordExplicitLineCall
ignore void source writeStringAnalyzerTopWordExplicitLineCall
bind error writeStringAnalyzerTopWordExplicitLineError ConsoleWriteError writeStringAnalyzerTopWordExplicitLineCall
set memory lastConsoleWriteErrorCode writeStringAnalyzerTopWordExplicitLineError
branch error source writeStringAnalyzerTopWordExplicitLineCall target consoleWriteFailed

call writeStringAnalyzerTopWordAgentsLineCall writeStandardOutputLine
argument writeStringAnalyzerTopWordAgentsLineCall text String stringAnalyzerTopWordAgentsText
run writeStringAnalyzerTopWordAgentsLineCall
ignore void source writeStringAnalyzerTopWordAgentsLineCall
bind error writeStringAnalyzerTopWordAgentsLineError ConsoleWriteError writeStringAnalyzerTopWordAgentsLineCall
set memory lastConsoleWriteErrorCode writeStringAnalyzerTopWordAgentsLineError
branch error source writeStringAnalyzerTopWordAgentsLineCall target consoleWriteFailed

call writeStringAnalyzerTopWordCodeLineCall writeStandardOutputLine
argument writeStringAnalyzerTopWordCodeLineCall text String stringAnalyzerTopWordCodeText
run writeStringAnalyzerTopWordCodeLineCall
ignore void source writeStringAnalyzerTopWordCodeLineCall
bind error writeStringAnalyzerTopWordCodeLineError ConsoleWriteError writeStringAnalyzerTopWordCodeLineCall
set memory lastConsoleWriteErrorCode writeStringAnalyzerTopWordCodeLineError
branch error source writeStringAnalyzerTopWordCodeLineCall target consoleWriteFailed

call writeStringAnalyzerTopWordFavorsLineCall writeStandardOutputLine
argument writeStringAnalyzerTopWordFavorsLineCall text String stringAnalyzerTopWordFavorsText
run writeStringAnalyzerTopWordFavorsLineCall
ignore void source writeStringAnalyzerTopWordFavorsLineCall
bind error writeStringAnalyzerTopWordFavorsLineError ConsoleWriteError writeStringAnalyzerTopWordFavorsLineCall
set memory lastConsoleWriteErrorCode writeStringAnalyzerTopWordFavorsLineError
branch error source writeStringAnalyzerTopWordFavorsLineCall target consoleWriteFailed

storage local immutable successfulExitCode ExitCode 0
return ok successfulExitCode

label consoleWriteFailed
# rationale: lastConsoleWriteErrorCode holds whichever emit actually failed; its `set`
# ran immediately before the corresponding branchIfError, so the typed
# MainError.ConsoleWriteFailed value honestly names its cause (Â§12).
makeError consoleWriteFailure MainError.ConsoleWriteFailed lastConsoleWriteErrorCode
return error consoleWriteFailure
