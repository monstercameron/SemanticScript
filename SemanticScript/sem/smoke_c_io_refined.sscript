# smoke_c_io_refined.sscript
#
# Migration of sem/smoke_c_io.sscript to refined syntax. Demonstrates c.puts,
# c.printf, and c.getenv via the SemanticScript libc surface.

section program.smokeCIoRefined

project SmokeCIoRefined
target console
runtime AgentRuntime 0.1
entry console main

section program.smokeCIoRefined.errors

error MainError
errorCase MainError ConsoleWriteFailed Int32

section program.smokeCIoRefined.literals

domainLiteral smokeIoBannerText String "=== smoke_c_io ==="
domainLiteral smokeIoPutsDemoLineText String "via c.puts: hello from puts"
domainLiteral smokeIoPrintfFiveCharFormatText String "via c.printf: %c%c%c%c%c\n"
domainLiteral smokeIoGetenvProbeName String "PATH"
domainLiteral smokeIoGetenvReportFormatText String "via c.getenv: PATH is reachable (sentinel=%d)\n"
# ASCII code points spelling "Hello" — printed individually through printf %c
# to demonstrate that variadic Int32 args round-trip through the c.* ABI.
domainLiteral helloAsciiCapitalH Int32 72
domainLiteral helloAsciiLowercaseE Int32 101
domainLiteral helloAsciiLowercaseLFirst Int32 108
domainLiteral helloAsciiLowercaseLSecond Int32 108
domainLiteral helloAsciiLowercaseO Int32 111
domainLiteral getenvCallReachedSentinel Int32 1
storage module immutable successfulExitCode ExitCode 0

section program.smokeCIoRefined.operations

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main read clock.cpu
effect main read process.arguments
effect main read process.environment
effect main write console.stdout
memory main heap no
memoryStackLimit main 4KiB
async main no
operationBody main sourceTape

purpose operation main "Demonstrate c.puts / c.printf / c.getenv from SemanticScript and confirm the libc surface is reachable beyond writeLine"
invariant operation main "Each c.* call writes a single observable line of stdout output"

label startMain

# c.puts — direct libc invocation, no console.* wrapper.
call writeBannerPutsCall c.puts
argument writeBannerPutsCall text String smokeIoBannerText
run writeBannerPutsCall
ignore void source writeBannerPutsCall
bind error writeBannerPutsError Int32 writeBannerPutsCall
branch error source writeBannerPutsCall target writeBannerPutsFailed

call writePutsDemoLineCall c.puts
argument writePutsDemoLineCall text String smokeIoPutsDemoLineText
run writePutsDemoLineCall
ignore void source writePutsDemoLineCall
bind error writePutsDemoLineError Int32 writePutsDemoLineCall
branch error source writePutsDemoLineCall target writePutsDemoLineFailed

# c.printf with five %c args — emits the string "Hello" one char at a time.
call writeHelloByCharsCall c.printf
argument writeHelloByCharsCall format String smokeIoPrintfFiveCharFormatText
argument writeHelloByCharsCall firstChar Int32 helloAsciiCapitalH
argument writeHelloByCharsCall secondChar Int32 helloAsciiLowercaseE
argument writeHelloByCharsCall thirdChar Int32 helloAsciiLowercaseLFirst
argument writeHelloByCharsCall fourthChar Int32 helloAsciiLowercaseLSecond
argument writeHelloByCharsCall fifthChar Int32 helloAsciiLowercaseO
run writeHelloByCharsCall
ignore void source writeHelloByCharsCall
bind error writeHelloByCharsError Int32 writeHelloByCharsCall
branch error source writeHelloByCharsCall target writeHelloByCharsFailed

# c.getenv — confirms the runtime resolves the symbol and returns a pointer.
# The returned char* is not deref'd here (would need pointer.loadByte); we
# only confirm the call shape works by printing a sentinel value of 1.
call getenvPathCall c.getenv
argument getenvPathCall name String smokeIoGetenvProbeName
run getenvPathCall
bind value environmentPathPointer OpaquePointer getenvPathCall

call writeGetenvReportCall c.printf
argument writeGetenvReportCall format String smokeIoGetenvReportFormatText
argument writeGetenvReportCall sentinel Int32 getenvCallReachedSentinel
run writeGetenvReportCall
ignore void source writeGetenvReportCall
bind error writeGetenvReportError Int32 writeGetenvReportCall
branch error source writeGetenvReportCall target writeGetenvReportFailed

return ok successfulExitCode

label writeBannerPutsFailed
makeError writeBannerPutsFailure MainError.ConsoleWriteFailed writeBannerPutsError
return error writeBannerPutsFailure

label writePutsDemoLineFailed
makeError writePutsDemoLineFailure MainError.ConsoleWriteFailed writePutsDemoLineError
return error writePutsDemoLineFailure

label writeHelloByCharsFailed
makeError writeHelloByCharsFailure MainError.ConsoleWriteFailed writeHelloByCharsError
return error writeHelloByCharsFailure

label writeGetenvReportFailed
makeError writeGetenvReportFailure MainError.ConsoleWriteFailed writeGetenvReportError
return error writeGetenvReportFailure
