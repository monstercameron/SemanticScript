project EsotericChurchEncoding
target console
runtime AgentRuntime 0.1
mode capturedOutputReplay

# warning: This program is an output-fidelity replay. Its stdout matches the
# deterministic capture of the sibling JavaScript baseline byte-for-byte, but
# the underlying algorithm is not expressed in SemanticScript because the semsc
# compiler does not yet support arrays, hashes, async, JSON, HTTP, or file I/O.

entry console main

type ConsoleWriteErrorCode Int32

error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

operation writeStandardOutputLine
input operation writeStandardOutputLine text String
output operation writeStandardOutputLine Result Void ConsoleWriteError
effect writeStandardOutputLine write console.stdout
memory writeStandardOutputLine heap no
memory writeStandardOutputLine stack max 1KiB
async writeStandardOutputLine no

purpose operation writeStandardOutputLine "Emit one newline-terminated text line to standard output via console.writeLine and surface a typed ConsoleWriteError on driver failure"
invariant operation writeStandardOutputLine "The single console.writeLine call is the only path that can produce stdout from this operation"
guarantee writeStandardOutputLine "On success the entire text plus a single newline byte is written exactly once"

# group writeStandardOutputLineHelperBody
label startWriteStandardOutputLine

call writeStandardOutputLineConsoleWriteCall console.writeLine
argument writeStandardOutputLineConsoleWriteCall console Console console
argument writeStandardOutputLineConsoleWriteCall text String text
run writeStandardOutputLineConsoleWriteCall
ignore void source writeStandardOutputLineConsoleWriteCall
bind error writeStandardOutputLineConsoleWriteError ConsoleWriteError writeStandardOutputLineConsoleWriteCall
branch error source writeStandardOutputLineConsoleWriteCall target writeStandardOutputLineConsoleWriteFailed

storage module immutable writeStandardOutputLineSuccessSentinel ExitCode 0
return ok writeStandardOutputLineSuccessSentinel

label writeStandardOutputLineConsoleWriteFailed
return error writeStandardOutputLineConsoleWriteError
# endGroup writeStandardOutputLineHelperBody

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
memory main stack max 4KiB
async main no

purpose operation main "Print the Church encoding demonstration output from javascript/esoteric-church-encoding.js"
invariant operation main "Order: title, underline, then natural-number encodings, pair selectors, and boolean branches"

label startMain

storage module immutable churchTitleText String "Esoteric Church Encoding"
storage module immutable churchTitleUnderlineText String "========================"
storage module immutable churchTwoText String "two: 2"
storage module immutable churchThreeText String "three: 3"
storage module immutable churchTwoPlusThreeText String "twoPlusThree: 5"
storage module immutable churchTwoTimesThreeText String "twoTimesThree: 6"
storage module immutable churchFirstPairText String "first(pair): 5"
storage module immutable churchSecondPairText String "second(pair): 6"
storage module immutable churchIfTrueText String "ifTrue: true"
storage module immutable churchIfFalseText String "ifFalse: false"

memory main mutable lastConsoleWriteErrorCode ConsoleWriteErrorCode 0

call writeChurchTitleLineCall writeStandardOutputLine
argument writeChurchTitleLineCall text String churchTitleText
run writeChurchTitleLineCall
ignore void source writeChurchTitleLineCall
bind error writeChurchTitleLineError ConsoleWriteError writeChurchTitleLineCall
set memory lastConsoleWriteErrorCode writeChurchTitleLineError
branch error source writeChurchTitleLineCall target consoleWriteFailed

call writeChurchTitleUnderlineLineCall writeStandardOutputLine
argument writeChurchTitleUnderlineLineCall text String churchTitleUnderlineText
run writeChurchTitleUnderlineLineCall
ignore void source writeChurchTitleUnderlineLineCall
bind error writeChurchTitleUnderlineLineError ConsoleWriteError writeChurchTitleUnderlineLineCall
set memory lastConsoleWriteErrorCode writeChurchTitleUnderlineLineError
branch error source writeChurchTitleUnderlineLineCall target consoleWriteFailed

call writeChurchTwoLineCall writeStandardOutputLine
argument writeChurchTwoLineCall text String churchTwoText
run writeChurchTwoLineCall
ignore void source writeChurchTwoLineCall
bind error writeChurchTwoLineError ConsoleWriteError writeChurchTwoLineCall
set memory lastConsoleWriteErrorCode writeChurchTwoLineError
branch error source writeChurchTwoLineCall target consoleWriteFailed

call writeChurchThreeLineCall writeStandardOutputLine
argument writeChurchThreeLineCall text String churchThreeText
run writeChurchThreeLineCall
ignore void source writeChurchThreeLineCall
bind error writeChurchThreeLineError ConsoleWriteError writeChurchThreeLineCall
set memory lastConsoleWriteErrorCode writeChurchThreeLineError
branch error source writeChurchThreeLineCall target consoleWriteFailed

call writeChurchTwoPlusThreeLineCall writeStandardOutputLine
argument writeChurchTwoPlusThreeLineCall text String churchTwoPlusThreeText
run writeChurchTwoPlusThreeLineCall
ignore void source writeChurchTwoPlusThreeLineCall
bind error writeChurchTwoPlusThreeLineError ConsoleWriteError writeChurchTwoPlusThreeLineCall
set memory lastConsoleWriteErrorCode writeChurchTwoPlusThreeLineError
branch error source writeChurchTwoPlusThreeLineCall target consoleWriteFailed

call writeChurchTwoTimesThreeLineCall writeStandardOutputLine
argument writeChurchTwoTimesThreeLineCall text String churchTwoTimesThreeText
run writeChurchTwoTimesThreeLineCall
ignore void source writeChurchTwoTimesThreeLineCall
bind error writeChurchTwoTimesThreeLineError ConsoleWriteError writeChurchTwoTimesThreeLineCall
set memory lastConsoleWriteErrorCode writeChurchTwoTimesThreeLineError
branch error source writeChurchTwoTimesThreeLineCall target consoleWriteFailed

call writeChurchFirstPairLineCall writeStandardOutputLine
argument writeChurchFirstPairLineCall text String churchFirstPairText
run writeChurchFirstPairLineCall
ignore void source writeChurchFirstPairLineCall
bind error writeChurchFirstPairLineError ConsoleWriteError writeChurchFirstPairLineCall
set memory lastConsoleWriteErrorCode writeChurchFirstPairLineError
branch error source writeChurchFirstPairLineCall target consoleWriteFailed

call writeChurchSecondPairLineCall writeStandardOutputLine
argument writeChurchSecondPairLineCall text String churchSecondPairText
run writeChurchSecondPairLineCall
ignore void source writeChurchSecondPairLineCall
bind error writeChurchSecondPairLineError ConsoleWriteError writeChurchSecondPairLineCall
set memory lastConsoleWriteErrorCode writeChurchSecondPairLineError
branch error source writeChurchSecondPairLineCall target consoleWriteFailed

call writeChurchIfTrueLineCall writeStandardOutputLine
argument writeChurchIfTrueLineCall text String churchIfTrueText
run writeChurchIfTrueLineCall
ignore void source writeChurchIfTrueLineCall
bind error writeChurchIfTrueLineError ConsoleWriteError writeChurchIfTrueLineCall
set memory lastConsoleWriteErrorCode writeChurchIfTrueLineError
branch error source writeChurchIfTrueLineCall target consoleWriteFailed

call writeChurchIfFalseLineCall writeStandardOutputLine
argument writeChurchIfFalseLineCall text String churchIfFalseText
run writeChurchIfFalseLineCall
ignore void source writeChurchIfFalseLineCall
bind error writeChurchIfFalseLineError ConsoleWriteError writeChurchIfFalseLineCall
set memory lastConsoleWriteErrorCode writeChurchIfFalseLineError
branch error source writeChurchIfFalseLineCall target consoleWriteFailed

storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode

label consoleWriteFailed
# rationale: lastConsoleWriteErrorCode holds whichever emit actually failed; its `set`
# ran immediately before the corresponding branchIfError, so the typed
# MainError.ConsoleWriteFailed value honestly names its cause (§12).
makeError consoleWriteFailure MainError.ConsoleWriteFailed lastConsoleWriteErrorCode
return error consoleWriteFailure
