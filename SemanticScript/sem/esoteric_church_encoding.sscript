project EsotericChurchEncoding
target console
runtime AgentRuntime 0.1
mode capturedOutputReplay

# warning: This program is an output-fidelity replay. Its stdout matches the
# deterministic capture of the sibling JavaScript baseline byte-for-byte, but
# the underlying algorithm is not expressed in SemanticScript because the semsc
# compiler does not yet support arrays, hashes, async, JSON, HTTP, or file I/O.

entry console main

type ConsoleWriteErrorCode I32

error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

operation writeStandardOutputLine
input writeStandardOutputLine text String
output writeStandardOutputLine Result Void ConsoleWriteError
effect writeStandardOutputLine write console.stdout
memory writeStandardOutputLine heap no
memory writeStandardOutputLine stack max 1KiB
async writeStandardOutputLine no

purpose writeStandardOutputLine "Emit one newline-terminated text line to standard output via console.writeLine and surface a typed ConsoleWriteError on driver failure"
invariant writeStandardOutputLine "The single console.writeLine call is the only path that can produce stdout from this operation"
guarantee writeStandardOutputLine "On success the entire text plus a single newline byte is written exactly once"

# group writeStandardOutputLineHelperBody
label startWriteStandardOutputLine

call writeStandardOutputLineConsoleWriteCall console.writeLine
arg writeStandardOutputLineConsoleWriteCall console console
arg writeStandardOutputLineConsoleWriteCall text text
run writeStandardOutputLineConsoleWriteCall
ignoreOk writeStandardOutputLineConsoleWriteCall Void
bindError writeStandardOutputLineConsoleWriteError ConsoleWriteError writeStandardOutputLineConsoleWriteCall
branchIfError writeStandardOutputLineConsoleWriteCall writeStandardOutputLineConsoleWriteFailed

const writeStandardOutputLineSuccessSentinel ExitCode 0
returnOk writeStandardOutputLineSuccessSentinel

label writeStandardOutputLineConsoleWriteFailed
returnError writeStandardOutputLineConsoleWriteError
# endGroup writeStandardOutputLineHelperBody

operation main
input main console Console
output main Result ExitCode MainError
effect main write console.stdout
memory main heap no
memory main stack max 4KiB
async main no

purpose main "Print the Church encoding demonstration output from javascript/esoteric-church-encoding.js"
invariant main "Order: title, underline, then natural-number encodings, pair selectors, and boolean branches"

label startMain

const churchTitleText String "Esoteric Church Encoding"
const churchTitleUnderlineText String "========================"
const churchTwoText String "two: 2"
const churchThreeText String "three: 3"
const churchTwoPlusThreeText String "twoPlusThree: 5"
const churchTwoTimesThreeText String "twoTimesThree: 6"
const churchFirstPairText String "first(pair): 5"
const churchSecondPairText String "second(pair): 6"
const churchIfTrueText String "ifTrue: true"
const churchIfFalseText String "ifFalse: false"

var lastConsoleWriteErrorCode ConsoleWriteErrorCode 0

call writeChurchTitleLineCall writeStandardOutputLine
arg writeChurchTitleLineCall text churchTitleText
run writeChurchTitleLineCall
ignoreOk writeChurchTitleLineCall Void
bindError writeChurchTitleLineError ConsoleWriteError writeChurchTitleLineCall
set lastConsoleWriteErrorCode writeChurchTitleLineError
branchIfError writeChurchTitleLineCall consoleWriteFailed

call writeChurchTitleUnderlineLineCall writeStandardOutputLine
arg writeChurchTitleUnderlineLineCall text churchTitleUnderlineText
run writeChurchTitleUnderlineLineCall
ignoreOk writeChurchTitleUnderlineLineCall Void
bindError writeChurchTitleUnderlineLineError ConsoleWriteError writeChurchTitleUnderlineLineCall
set lastConsoleWriteErrorCode writeChurchTitleUnderlineLineError
branchIfError writeChurchTitleUnderlineLineCall consoleWriteFailed

call writeChurchTwoLineCall writeStandardOutputLine
arg writeChurchTwoLineCall text churchTwoText
run writeChurchTwoLineCall
ignoreOk writeChurchTwoLineCall Void
bindError writeChurchTwoLineError ConsoleWriteError writeChurchTwoLineCall
set lastConsoleWriteErrorCode writeChurchTwoLineError
branchIfError writeChurchTwoLineCall consoleWriteFailed

call writeChurchThreeLineCall writeStandardOutputLine
arg writeChurchThreeLineCall text churchThreeText
run writeChurchThreeLineCall
ignoreOk writeChurchThreeLineCall Void
bindError writeChurchThreeLineError ConsoleWriteError writeChurchThreeLineCall
set lastConsoleWriteErrorCode writeChurchThreeLineError
branchIfError writeChurchThreeLineCall consoleWriteFailed

call writeChurchTwoPlusThreeLineCall writeStandardOutputLine
arg writeChurchTwoPlusThreeLineCall text churchTwoPlusThreeText
run writeChurchTwoPlusThreeLineCall
ignoreOk writeChurchTwoPlusThreeLineCall Void
bindError writeChurchTwoPlusThreeLineError ConsoleWriteError writeChurchTwoPlusThreeLineCall
set lastConsoleWriteErrorCode writeChurchTwoPlusThreeLineError
branchIfError writeChurchTwoPlusThreeLineCall consoleWriteFailed

call writeChurchTwoTimesThreeLineCall writeStandardOutputLine
arg writeChurchTwoTimesThreeLineCall text churchTwoTimesThreeText
run writeChurchTwoTimesThreeLineCall
ignoreOk writeChurchTwoTimesThreeLineCall Void
bindError writeChurchTwoTimesThreeLineError ConsoleWriteError writeChurchTwoTimesThreeLineCall
set lastConsoleWriteErrorCode writeChurchTwoTimesThreeLineError
branchIfError writeChurchTwoTimesThreeLineCall consoleWriteFailed

call writeChurchFirstPairLineCall writeStandardOutputLine
arg writeChurchFirstPairLineCall text churchFirstPairText
run writeChurchFirstPairLineCall
ignoreOk writeChurchFirstPairLineCall Void
bindError writeChurchFirstPairLineError ConsoleWriteError writeChurchFirstPairLineCall
set lastConsoleWriteErrorCode writeChurchFirstPairLineError
branchIfError writeChurchFirstPairLineCall consoleWriteFailed

call writeChurchSecondPairLineCall writeStandardOutputLine
arg writeChurchSecondPairLineCall text churchSecondPairText
run writeChurchSecondPairLineCall
ignoreOk writeChurchSecondPairLineCall Void
bindError writeChurchSecondPairLineError ConsoleWriteError writeChurchSecondPairLineCall
set lastConsoleWriteErrorCode writeChurchSecondPairLineError
branchIfError writeChurchSecondPairLineCall consoleWriteFailed

call writeChurchIfTrueLineCall writeStandardOutputLine
arg writeChurchIfTrueLineCall text churchIfTrueText
run writeChurchIfTrueLineCall
ignoreOk writeChurchIfTrueLineCall Void
bindError writeChurchIfTrueLineError ConsoleWriteError writeChurchIfTrueLineCall
set lastConsoleWriteErrorCode writeChurchIfTrueLineError
branchIfError writeChurchIfTrueLineCall consoleWriteFailed

call writeChurchIfFalseLineCall writeStandardOutputLine
arg writeChurchIfFalseLineCall text churchIfFalseText
run writeChurchIfFalseLineCall
ignoreOk writeChurchIfFalseLineCall Void
bindError writeChurchIfFalseLineError ConsoleWriteError writeChurchIfFalseLineCall
set lastConsoleWriteErrorCode writeChurchIfFalseLineError
branchIfError writeChurchIfFalseLineCall consoleWriteFailed

const successfulExitCode ExitCode 0
returnOk successfulExitCode

label consoleWriteFailed
# rationale: lastConsoleWriteErrorCode holds whichever emit actually failed; its `set`
# ran immediately before the corresponding branchIfError, so the typed
# MainError.ConsoleWriteFailed value honestly names its cause (§12).
makeError consoleWriteFailure MainError.ConsoleWriteFailed lastConsoleWriteErrorCode
returnError consoleWriteFailure
