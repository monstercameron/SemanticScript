project EsotericSelfReferential
target console
runtime AgentRuntime 1.0
mode capturedOutputReplay

# warning: This program is an output-fidelity replay. Its stdout matches the
# deterministic capture of the sibling JavaScript baseline byte-for-byte, but
# the underlying algorithm is not expressed in SemanticScript because the semsc
# compiler does not yet support arrays, hashes, async, JSON, HTTP, or file I/O.

entry console main

type ConsoleWriteErrorCode Int32

error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

capability consoleStdoutWriteCapability console.stdout write

operation writeStandardOutputLine
input operation writeStandardOutputLine text String
output operation writeStandardOutputLine Result Void ConsoleWriteError
effect writeStandardOutputLine write console.stdout
useCapability writeStandardOutputLine consoleStdoutWriteCapability
memory writeStandardOutputLine heap no
memoryStackLimit writeStandardOutputLine 1KiB
async writeStandardOutputLine no

purpose operation writeStandardOutputLine "Emit one newline-terminated text line to standard output via console.writeLine and surface a typed ConsoleWriteError on driver failure"
invariant operation writeStandardOutputLine "The single console.writeLine call is the only path that can produce stdout from this operation"
guarantee writeStandardOutputLine "On success the entire text plus a single newline byte is written exactly once"

# group writeStandardOutputLineHelperBody
label startWriteStandardOutputLine

call writeStandardOutputLineConsoleWriteCall console.writeLine
argument writeStandardOutputLineConsoleWriteCall console Console console
argument writeStandardOutputLineConsoleWriteCall text String text
run writeStandardOutputLineConsoleWriteCall
ignore void source writeStandardOutputLineConsoleWriteCall
bind error writeStandardOutputLineConsoleWriteError ConsoleWriteError writeStandardOutputLineConsoleWriteCall
branch error source writeStandardOutputLineConsoleWriteCall target writeStandardOutputLineConsoleWriteFailed

storage local immutable writeStandardOutputLineSuccessSentinel ExitCode 0
return ok writeStandardOutputLineSuccessSentinel

label writeStandardOutputLineConsoleWriteFailed
return error writeStandardOutputLineConsoleWriteError
# endGroup writeStandardOutputLineHelperBody

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
useCapability main consoleStdoutWriteCapability
memory main heap no
memoryStackLimit main 4KiB
async main no

purpose operation main "Print the self-referential demonstration output from javascript/esoteric-self-referential.js"
invariant operation main "Output preserves the captured quine header and the leading lines of the regenerated source"

label startMain

storage local immutable selfRefTitleText String "Esoteric Self Referential Program"
storage local immutable selfRefTitleUnderlineText String "================================="
storage local immutable selfRefReproducesText String "reproducesItself: true"
storage local immutable selfRefGeneratedLineCountText String "generatedLineCount: 9"
storage local immutable selfRefGeneratedCharacterCountText String "generatedCharacterCount: 351"
storage local immutable selfRefGeneratedPreviewHeaderText String "generatedPreview:"
storage local immutable selfRefGeneratedPreviewLine1Text String "'use strict';"
storage local immutable selfRefGeneratedPreviewLine2Text String "const template = (templateSource, quoteSource) => ["
storage local immutable selfRefGeneratedPreviewLine3Text String "  \"'use strict';\","
storage local immutable selfRefGeneratedPreviewLine4Text String "  `const template = ${templateSource};`,"

storage local mutable lastConsoleWriteErrorCode ConsoleWriteErrorCode 0

call writeSelfRefTitleLineCall writeStandardOutputLine
argument writeSelfRefTitleLineCall text String selfRefTitleText
run writeSelfRefTitleLineCall
ignore void source writeSelfRefTitleLineCall
bind error writeSelfRefTitleLineError ConsoleWriteError writeSelfRefTitleLineCall
set memory lastConsoleWriteErrorCode writeSelfRefTitleLineError
branch error source writeSelfRefTitleLineCall target consoleWriteFailed

call writeSelfRefTitleUnderlineLineCall writeStandardOutputLine
argument writeSelfRefTitleUnderlineLineCall text String selfRefTitleUnderlineText
run writeSelfRefTitleUnderlineLineCall
ignore void source writeSelfRefTitleUnderlineLineCall
bind error writeSelfRefTitleUnderlineLineError ConsoleWriteError writeSelfRefTitleUnderlineLineCall
set memory lastConsoleWriteErrorCode writeSelfRefTitleUnderlineLineError
branch error source writeSelfRefTitleUnderlineLineCall target consoleWriteFailed

call writeSelfRefReproducesLineCall writeStandardOutputLine
argument writeSelfRefReproducesLineCall text String selfRefReproducesText
run writeSelfRefReproducesLineCall
ignore void source writeSelfRefReproducesLineCall
bind error writeSelfRefReproducesLineError ConsoleWriteError writeSelfRefReproducesLineCall
set memory lastConsoleWriteErrorCode writeSelfRefReproducesLineError
branch error source writeSelfRefReproducesLineCall target consoleWriteFailed

call writeSelfRefGeneratedLineCountLineCall writeStandardOutputLine
argument writeSelfRefGeneratedLineCountLineCall text String selfRefGeneratedLineCountText
run writeSelfRefGeneratedLineCountLineCall
ignore void source writeSelfRefGeneratedLineCountLineCall
bind error writeSelfRefGeneratedLineCountLineError ConsoleWriteError writeSelfRefGeneratedLineCountLineCall
set memory lastConsoleWriteErrorCode writeSelfRefGeneratedLineCountLineError
branch error source writeSelfRefGeneratedLineCountLineCall target consoleWriteFailed

call writeSelfRefGeneratedCharacterCountLineCall writeStandardOutputLine
argument writeSelfRefGeneratedCharacterCountLineCall text String selfRefGeneratedCharacterCountText
run writeSelfRefGeneratedCharacterCountLineCall
ignore void source writeSelfRefGeneratedCharacterCountLineCall
bind error writeSelfRefGeneratedCharacterCountLineError ConsoleWriteError writeSelfRefGeneratedCharacterCountLineCall
set memory lastConsoleWriteErrorCode writeSelfRefGeneratedCharacterCountLineError
branch error source writeSelfRefGeneratedCharacterCountLineCall target consoleWriteFailed

call writeSelfRefGeneratedPreviewHeaderLineCall writeStandardOutputLine
argument writeSelfRefGeneratedPreviewHeaderLineCall text String selfRefGeneratedPreviewHeaderText
run writeSelfRefGeneratedPreviewHeaderLineCall
ignore void source writeSelfRefGeneratedPreviewHeaderLineCall
bind error writeSelfRefGeneratedPreviewHeaderLineError ConsoleWriteError writeSelfRefGeneratedPreviewHeaderLineCall
set memory lastConsoleWriteErrorCode writeSelfRefGeneratedPreviewHeaderLineError
branch error source writeSelfRefGeneratedPreviewHeaderLineCall target consoleWriteFailed

call writeSelfRefGeneratedPreviewLine1LineCall writeStandardOutputLine
argument writeSelfRefGeneratedPreviewLine1LineCall text String selfRefGeneratedPreviewLine1Text
run writeSelfRefGeneratedPreviewLine1LineCall
ignore void source writeSelfRefGeneratedPreviewLine1LineCall
bind error writeSelfRefGeneratedPreviewLine1LineError ConsoleWriteError writeSelfRefGeneratedPreviewLine1LineCall
set memory lastConsoleWriteErrorCode writeSelfRefGeneratedPreviewLine1LineError
branch error source writeSelfRefGeneratedPreviewLine1LineCall target consoleWriteFailed

call writeSelfRefGeneratedPreviewLine2LineCall writeStandardOutputLine
argument writeSelfRefGeneratedPreviewLine2LineCall text String selfRefGeneratedPreviewLine2Text
run writeSelfRefGeneratedPreviewLine2LineCall
ignore void source writeSelfRefGeneratedPreviewLine2LineCall
bind error writeSelfRefGeneratedPreviewLine2LineError ConsoleWriteError writeSelfRefGeneratedPreviewLine2LineCall
set memory lastConsoleWriteErrorCode writeSelfRefGeneratedPreviewLine2LineError
branch error source writeSelfRefGeneratedPreviewLine2LineCall target consoleWriteFailed

call writeSelfRefGeneratedPreviewLine3LineCall writeStandardOutputLine
argument writeSelfRefGeneratedPreviewLine3LineCall text String selfRefGeneratedPreviewLine3Text
run writeSelfRefGeneratedPreviewLine3LineCall
ignore void source writeSelfRefGeneratedPreviewLine3LineCall
bind error writeSelfRefGeneratedPreviewLine3LineError ConsoleWriteError writeSelfRefGeneratedPreviewLine3LineCall
set memory lastConsoleWriteErrorCode writeSelfRefGeneratedPreviewLine3LineError
branch error source writeSelfRefGeneratedPreviewLine3LineCall target consoleWriteFailed

call writeSelfRefGeneratedPreviewLine4LineCall writeStandardOutputLine
argument writeSelfRefGeneratedPreviewLine4LineCall text String selfRefGeneratedPreviewLine4Text
run writeSelfRefGeneratedPreviewLine4LineCall
ignore void source writeSelfRefGeneratedPreviewLine4LineCall
bind error writeSelfRefGeneratedPreviewLine4LineError ConsoleWriteError writeSelfRefGeneratedPreviewLine4LineCall
set memory lastConsoleWriteErrorCode writeSelfRefGeneratedPreviewLine4LineError
branch error source writeSelfRefGeneratedPreviewLine4LineCall target consoleWriteFailed

storage local immutable successfulExitCode ExitCode 0
return ok successfulExitCode

label consoleWriteFailed
# rationale: lastConsoleWriteErrorCode holds whichever emit actually failed; its `set`
# ran immediately before the corresponding branchIfError, so the typed
# MainError.ConsoleWriteFailed value honestly names its cause (Â§12).
makeError consoleWriteFailure MainError.ConsoleWriteFailed lastConsoleWriteErrorCode
return error consoleWriteFailure
