project JsonOrderSummary
target console
runtime AgentRuntime 1.0
mode capturedOutputReplay

# warning: This program is an output-fidelity replay. Its stdout matches the
# deterministic capture of the sibling JavaScript baseline byte-for-byte, but
# the underlying algorithm is not expressed in SemanticScript because the semsc
# compiler does not yet support arrays, hashes, async, JSON, HTTP, or file I/O.

entry console main

type ConsoleWriteErrorCode I32

error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

capability consoleStdoutWriteCapability console.stdout write

operation writeStandardOutputLine
input writeStandardOutputLine text String
output writeStandardOutputLine Result Void ConsoleWriteError
effect writeStandardOutputLine write console.stdout
useCapability writeStandardOutputLine consoleStdoutWriteCapability
memoryHeap writeStandardOutputLine no
memoryStackLimit writeStandardOutputLine 1KiB
async writeStandardOutputLine no

purpose writeStandardOutputLine "Emit one newline-terminated text line to standard output via console.writeLine and surface a typed ConsoleWriteError on driver failure"
invariant writeStandardOutputLine "The single console.writeLine call is the only path that can produce stdout from this operation"
guarantee writeStandardOutputLine "On success the entire text plus a single newline byte is written exactly once"

# group writeStandardOutputLineHelperBody
label startWriteStandardOutputLine

call writeStandardOutputLineConsoleWriteCall console.writeLine
arg writeStandardOutputLineConsoleWriteCall console console
arg writeStandardOutputLineConsoleWriteCall text text
run writeStandardOutputLineConsoleWriteCall
ignoreOk writeStandardOutputLineConsoleWriteCall Void
bindError writeStandardOutputLineConsoleWriteError ConsoleWriteError writeStandardOutputLineConsoleWriteCall
branchIfError writeStandardOutputLineConsoleWriteCall writeStandardOutputLineConsoleWriteFailed

storage local immutable writeStandardOutputLineSuccessSentinel ExitCode 0
returnOk writeStandardOutputLineSuccessSentinel

label writeStandardOutputLineConsoleWriteFailed
returnError writeStandardOutputLineConsoleWriteError
# endGroup writeStandardOutputLineHelperBody

operation main
input main console Console
output main Result ExitCode MainError
effect main write console.stdout
useCapability main consoleStdoutWriteCapability
memoryHeap main no
memoryStackLimit main 4KiB
async main no

purpose main "Print the deterministic order-summary JSON document from javascript/json-order-summary.js"
invariant main "JSON keys appear in the exact order produced by Node's JSON.stringify with two-space indentation"

label startMain

storage local immutable orderSummaryTitleText String "JSON Order Summary"
storage local immutable orderSummaryTitleUnderlineText String "=================="
storage local immutable orderSummaryOpenBraceText String "{"
storage local immutable orderSummaryOrderCountText String "  \"orderCount\": 3,"
storage local immutable orderSummaryTotalCentsText String "  \"totalCents\": 4400,"
storage local immutable orderSummaryCustomerTotalsHeaderText String "  \"customerTotals\": {"
storage local immutable orderSummaryCustomerTotalsAdaText String "    \"Ada\": 1901,"
storage local immutable orderSummaryCustomerTotalsGraceText String "    \"Grace\": 2499"
storage local immutable orderSummaryCustomerTotalsCloseText String "  },"
storage local immutable orderSummaryOrderTotalsHeaderText String "  \"orderTotals\": ["
storage local immutable orderSummaryOrderTotalsOrder1001OpenText String "    {"
storage local immutable orderSummaryOrderTotalsOrder1001IdText String "      \"id\": \"order-1001\","
storage local immutable orderSummaryOrderTotalsOrder1001CustomerText String "      \"customer\": \"Ada\","
storage local immutable orderSummaryOrderTotalsOrder1001TotalCentsText String "      \"totalCents\": 1643"
storage local immutable orderSummaryOrderTotalsOrder1001CloseText String "    },"
storage local immutable orderSummaryOrderTotalsOrder1002OpenText String "    {"
storage local immutable orderSummaryOrderTotalsOrder1002IdText String "      \"id\": \"order-1002\","
storage local immutable orderSummaryOrderTotalsOrder1002CustomerText String "      \"customer\": \"Grace\","
storage local immutable orderSummaryOrderTotalsOrder1002TotalCentsText String "      \"totalCents\": 2499"
storage local immutable orderSummaryOrderTotalsOrder1002CloseText String "    },"
storage local immutable orderSummaryOrderTotalsOrder1003OpenText String "    {"
storage local immutable orderSummaryOrderTotalsOrder1003IdText String "      \"id\": \"order-1003\","
storage local immutable orderSummaryOrderTotalsOrder1003CustomerText String "      \"customer\": \"Ada\","
storage local immutable orderSummaryOrderTotalsOrder1003TotalCentsText String "      \"totalCents\": 258"
storage local immutable orderSummaryOrderTotalsOrder1003CloseText String "    }"
storage local immutable orderSummaryOrderTotalsCloseText String "  ]"
storage local immutable orderSummaryCloseBraceText String "}"

storage local mutable lastConsoleWriteErrorCode ConsoleWriteErrorCode 0

call writeOrderSummaryTitleLineCall writeStandardOutputLine
arg writeOrderSummaryTitleLineCall text orderSummaryTitleText
run writeOrderSummaryTitleLineCall
ignoreOk writeOrderSummaryTitleLineCall Void
bindError writeOrderSummaryTitleLineError ConsoleWriteError writeOrderSummaryTitleLineCall
set local lastConsoleWriteErrorCode writeOrderSummaryTitleLineError
branchIfError writeOrderSummaryTitleLineCall consoleWriteFailed

