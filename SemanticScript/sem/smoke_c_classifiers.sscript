project SmokeCClassifiers
target console
runtime AgentRuntime 0.1

entry console main

error MainError
errorCase MainError ConsoleWriteFailed CSignedInt32

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
memory main stack max 4KiB
async main no

purpose operation main "Verify the <math.h> macro-classifiers (isnan/isinf/isfinite/isnormal/signbit/fpclassify) lower to LLVM ops rather than libc externs"
invariant operation main "Each classifier reports the spec-defined int for a representative input"

label startMain

storage module immutable formatLineText CNullTerminatedByteString "isnan(%g)=%d isinf(%g)=%d isfinite(%g)=%d isnormal(%g)=%d signbit(%g)=%d fpclassify(%g)=%d\n"

storage module immutable probeValue CFloat64 3.14
storage module immutable zeroValue CFloat64 0.0

call isnanCall c.isnan
argument isnanCall x CFloat64 probeValue
run isnanCall
bind value isnanResult CSignedInt32 isnanCall

call isinfCall c.isinf
argument isinfCall x CFloat64 probeValue
run isinfCall
bind value isinfResult CSignedInt32 isinfCall

call isfiniteCall c.isfinite
argument isfiniteCall x CFloat64 probeValue
run isfiniteCall
bind value isfiniteResult CSignedInt32 isfiniteCall

call isnormalCall c.isnormal
argument isnormalCall x CFloat64 probeValue
run isnormalCall
bind value isnormalResult CSignedInt32 isnormalCall

call signbitCall c.signbit
argument signbitCall x CFloat64 probeValue
run signbitCall
bind value signbitResult CSignedInt32 signbitCall

call fpclassifyCall c.fpclassify
argument fpclassifyCall x CFloat64 zeroValue
run fpclassifyCall
bind value fpclassifyResult CSignedInt32 fpclassifyCall

call reportCall c.printf
argument reportCall format CNullTerminatedByteString formatLineText
argument reportCall isnanX CFloat64 probeValue
argument reportCall isnanV CSignedInt32 isnanResult
argument reportCall isinfX CFloat64 probeValue
argument reportCall isinfV CSignedInt32 isinfResult
argument reportCall isfiniteX CFloat64 probeValue
argument reportCall isfiniteV CSignedInt32 isfiniteResult
argument reportCall isnormalX CFloat64 probeValue
argument reportCall isnormalV CSignedInt32 isnormalResult
argument reportCall signbitX CFloat64 probeValue
argument reportCall signbitV CSignedInt32 signbitResult
argument reportCall fpclassifyX CFloat64 zeroValue
argument reportCall fpclassifyV CSignedInt32 fpclassifyResult
run reportCall
ignore void source reportCall
bind error reportError CSignedInt32 reportCall
branch error source reportCall target reportWriteFailed

storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode

label reportWriteFailed
makeError reportWriteFailure MainError.ConsoleWriteFailed reportError
return error reportWriteFailure
