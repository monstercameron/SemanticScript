project SmokeCString
target console
runtime AgentRuntime 0.1

entry console main

error MainError
errorCase MainError ConsoleWriteFailed Int32

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
memory main stack max 4KiB
async main no

purpose operation main "Exercise c.strlen and c.strcmp against printf to confirm pointer-typed args round-trip correctly"
invariant operation main "Each c.* string call lowers to a direct extern with no SemanticScript-side wrapping"

label startMain

storage module immutable inputProbeText String "SemanticScript"
storage module immutable inputReferenceText String "SemanticScript"
storage module immutable inputDistinctText String "Distinct"
storage module immutable formatStrlenText String "strlen(\"%s\") = %lld\n"
storage module immutable formatStrcmpText String "strcmp(\"%s\", \"%s\") = %d\n"

call strlenProbeCall c.strlen
argument strlenProbeCall text String inputProbeText
run strlenProbeCall
bind value probeTextLengthInBytes ByteCount strlenProbeCall

call printStrlenCall c.printf
argument printStrlenCall format String formatStrlenText
argument printStrlenCall input String inputProbeText
argument printStrlenCall length ByteCount probeTextLengthInBytes
run printStrlenCall
ignore void source printStrlenCall
bind error printStrlenError Int32 printStrlenCall
branch error source printStrlenCall target strlenWriteFailed

call strcmpEqualCall c.strcmp
argument strcmpEqualCall left String inputProbeText
argument strcmpEqualCall right String inputReferenceText
run strcmpEqualCall
bind value probeEqualToReferenceComparison Int32 strcmpEqualCall

call printStrcmpEqualCall c.printf
argument printStrcmpEqualCall format String formatStrcmpText
argument printStrcmpEqualCall left String inputProbeText
argument printStrcmpEqualCall right String inputReferenceText
argument printStrcmpEqualCall comparison Int32 probeEqualToReferenceComparison
run printStrcmpEqualCall
ignore void source printStrcmpEqualCall
bind error printStrcmpEqualError Int32 printStrcmpEqualCall
branch error source printStrcmpEqualCall target strcmpEqualWriteFailed

call strcmpDifferentCall c.strcmp
argument strcmpDifferentCall left String inputProbeText
argument strcmpDifferentCall right String inputDistinctText
run strcmpDifferentCall
bind value probeDifferentFromDistinctComparison Int32 strcmpDifferentCall

call printStrcmpDifferentCall c.printf
argument printStrcmpDifferentCall format String formatStrcmpText
argument printStrcmpDifferentCall left String inputProbeText
argument printStrcmpDifferentCall right String inputDistinctText
argument printStrcmpDifferentCall comparison Int32 probeDifferentFromDistinctComparison
run printStrcmpDifferentCall
ignore void source printStrcmpDifferentCall
bind error printStrcmpDifferentError Int32 printStrcmpDifferentCall
branch error source printStrcmpDifferentCall target strcmpDifferentWriteFailed

storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode

label strlenWriteFailed
makeError strlenWriteFailure MainError.ConsoleWriteFailed printStrlenError
return error strlenWriteFailure

label strcmpEqualWriteFailed
makeError strcmpEqualWriteFailure MainError.ConsoleWriteFailed printStrcmpEqualError
return error strcmpEqualWriteFailure

label strcmpDifferentWriteFailed
makeError strcmpDifferentWriteFailure MainError.ConsoleWriteFailed printStrcmpDifferentError
return error strcmpDifferentWriteFailure
