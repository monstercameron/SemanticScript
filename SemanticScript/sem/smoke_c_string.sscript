project SmokeCString
target console
runtime AgentRuntime 0.1

entry console main

error MainError
errorCase MainError ConsoleWriteFailed CSignedInt32

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
memory main stack max 4KiB
async main no

purpose operation main "Exercise c.strlen and c.strcmp against printf to confirm pointer-typed args round-trip correctly"
invariant operation main "Each c.* string call lowers to a direct extern with no SemanticScript-side wrapping"

label startMain

storage module immutable inputProbeText CNullTerminatedByteString "SemanticScript"
storage module immutable inputReferenceText CNullTerminatedByteString "SemanticScript"
storage module immutable inputDistinctText CNullTerminatedByteString "Distinct"
storage module immutable formatStrlenText CNullTerminatedByteString "strlen(\"%s\") = %lld\n"
storage module immutable formatStrcmpText CNullTerminatedByteString "strcmp(\"%s\", \"%s\") = %d\n"

call strlenProbeCall c.strlen
argument strlenProbeCall text CNullTerminatedByteString inputProbeText
run strlenProbeCall
bind value probeTextLengthInBytes CByteCount strlenProbeCall

call printStrlenCall c.printf
argument printStrlenCall format CNullTerminatedByteString formatStrlenText
argument printStrlenCall input CNullTerminatedByteString inputProbeText
argument printStrlenCall length CByteCount probeTextLengthInBytes
run printStrlenCall
ignore void source printStrlenCall
bind error printStrlenError CSignedInt32 printStrlenCall
branch error source printStrlenCall target strlenWriteFailed

call strcmpEqualCall c.strcmp
argument strcmpEqualCall left CNullTerminatedByteString inputProbeText
argument strcmpEqualCall right CNullTerminatedByteString inputReferenceText
run strcmpEqualCall
bind value probeEqualToReferenceComparison CSignedInt32 strcmpEqualCall

call printStrcmpEqualCall c.printf
argument printStrcmpEqualCall format CNullTerminatedByteString formatStrcmpText
argument printStrcmpEqualCall left CNullTerminatedByteString inputProbeText
argument printStrcmpEqualCall right CNullTerminatedByteString inputReferenceText
argument printStrcmpEqualCall comparison CSignedInt32 probeEqualToReferenceComparison
run printStrcmpEqualCall
ignore void source printStrcmpEqualCall
bind error printStrcmpEqualError CSignedInt32 printStrcmpEqualCall
branch error source printStrcmpEqualCall target strcmpEqualWriteFailed

call strcmpDifferentCall c.strcmp
argument strcmpDifferentCall left CNullTerminatedByteString inputProbeText
argument strcmpDifferentCall right CNullTerminatedByteString inputDistinctText
run strcmpDifferentCall
bind value probeDifferentFromDistinctComparison CSignedInt32 strcmpDifferentCall

call printStrcmpDifferentCall c.printf
argument printStrcmpDifferentCall format CNullTerminatedByteString formatStrcmpText
argument printStrcmpDifferentCall left CNullTerminatedByteString inputProbeText
argument printStrcmpDifferentCall right CNullTerminatedByteString inputDistinctText
argument printStrcmpDifferentCall comparison CSignedInt32 probeDifferentFromDistinctComparison
run printStrcmpDifferentCall
ignore void source printStrcmpDifferentCall
bind error printStrcmpDifferentError CSignedInt32 printStrcmpDifferentCall
branch error source printStrcmpDifferentCall target strcmpDifferentWriteFailed

storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode

label strlenWriteFailed
makeError strlenWriteFailure MainError.ConsoleWriteFailed printStrlenError
return error strlenWriteFailure

label strcmpEqualWriteFailed
makeError strcmpEqualWriteFailure MainError.ConsoleWriteFailed printStrcmpEqualError
return error strcmpEqualWriteFailure

label strcmpDifferentWriteFailed
makeError strcmpDifferentWriteFailure MainError.ConsoleWriteFailed printStrcmpDifferentError
return error strcmpDifferentWriteFailure
