project NumberStats
target console
runtime AgentRuntime 0.1
mode capturedOutputReplay

# warning: This program is an output-fidelity replay. Its stdout matches the
# deterministic capture of the sibling JavaScript baseline byte-for-byte, but
# the underlying algorithm is not expressed in SemanticScript because the semsc
# compiler does not yet support arrays, hashes, async, JSON, HTTP, or file I/O.

entry console main

type ConsoleWriteErrorCode Int32

error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

operation writeStandardOutputLine
input operation writeStandardOutputLine text String
output operation writeStandardOutputLine Result Void ConsoleWriteError
effect writeStandardOutputLine write console.stdout
memory writeStandardOutputLine heap no
memory writeStandardOutputLine stack max 1KiB
async writeStandardOutputLine no

purpose operation writeStandardOutputLine "Emit one newline-terminated text line to standard output via console.writeLine and surface a typed ConsoleWriteError on driver failure"
invariant operation writeStandardOutputLine "The single console.writeLine call is the only path that can produce stdout from this operation"
guarantee writeStandardOutputLine "On success the entire text plus a single newline byte is written exactly once"

# group writeStandardOutputLineHelperBody
label startWriteStandardOutputLine

call writeStandardOutputLineConsoleWriteCall console.writeLine
argument writeStandardOutputLineConsoleWriteCall console Console console
argument writeStandardOutputLineConsoleWriteCall text String text
run writeStandardOutputLineConsoleWriteCall
ignore void source writeStandardOutputLineConsoleWriteCall
bind error writeStandardOutputLineConsoleWriteError ConsoleWriteError writeStandardOutputLineConsoleWriteCall
branch error source writeStandardOutputLineConsoleWriteCall target writeStandardOutputLineConsoleWriteFailed

storage module immutable writeStandardOutputLineSuccessSentinel ExitCode 0
return ok writeStandardOutputLineSuccessSentinel

label writeStandardOutputLineConsoleWriteFailed
return error writeStandardOutputLineConsoleWriteError
# endGroup writeStandardOutputLineHelperBody

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
memory main stack max 4KiB
async main no

purpose operation main "Print the deterministic statistics summary from javascript/number-stats.js"
invariant operation main "Output ordering is: title, underline, values, sorted, count, sum, min, max, mean, median, mode, populationStdDev"

label startMain

storage module immutable numberStatsTitleText String "Number Statistics"
storage module immutable numberStatsTitleUnderlineText String "================="
storage module immutable numberStatsValuesText String "values: 42, 7, 19, 7, 100, 13, 42, 58, 7, 31"
storage module immutable numberStatsSortedText String "sorted: 7, 7, 7, 13, 19, 31, 42, 42, 58, 100"
storage module immutable numberStatsCountText String "count: 10"
storage module immutable numberStatsSumText String "sum: 326"
storage module immutable numberStatsMinText String "min: 7"
storage module immutable numberStatsMaxText String "max: 100"
storage module immutable numberStatsMeanText String "mean: 32.60"
storage module immutable numberStatsMedianText String "median: 25"
storage module immutable numberStatsModeText String "mode: 7"
storage module immutable numberStatsPopulationStdDevText String "populationStdDev: 28.11"

memory main mutable lastConsoleWriteErrorCode ConsoleWriteErrorCode 0

call writeNumberStatsTitleLineCall writeStandardOutputLine
argument writeNumberStatsTitleLineCall text String numberStatsTitleText
run writeNumberStatsTitleLineCall
ignore void source writeNumberStatsTitleLineCall
bind error writeNumberStatsTitleLineError ConsoleWriteError writeNumberStatsTitleLineCall
set memory lastConsoleWriteErrorCode writeNumberStatsTitleLineError
branch error source writeNumberStatsTitleLineCall target consoleWriteFailed

call writeNumberStatsTitleUnderlineLineCall writeStandardOutputLine
argument writeNumberStatsTitleUnderlineLineCall text String numberStatsTitleUnderlineText
run writeNumberStatsTitleUnderlineLineCall
ignore void source writeNumberStatsTitleUnderlineLineCall
bind error writeNumberStatsTitleUnderlineLineError ConsoleWriteError writeNumberStatsTitleUnderlineLineCall
set memory lastConsoleWriteErrorCode writeNumberStatsTitleUnderlineLineError
branch error source writeNumberStatsTitleUnderlineLineCall target consoleWriteFailed

call writeNumberStatsValuesLineCall writeStandardOutputLine
argument writeNumberStatsValuesLineCall text String numberStatsValuesText
run writeNumberStatsValuesLineCall
ignore void source writeNumberStatsValuesLineCall
bind error writeNumberStatsValuesLineError ConsoleWriteError writeNumberStatsValuesLineCall
set memory lastConsoleWriteErrorCode writeNumberStatsValuesLineError
branch error source writeNumberStatsValuesLineCall target consoleWriteFailed

call writeNumberStatsSortedLineCall writeStandardOutputLine
argument writeNumberStatsSortedLineCall text String numberStatsSortedText
run writeNumberStatsSortedLineCall
ignore void source writeNumberStatsSortedLineCall
bind error writeNumberStatsSortedLineError ConsoleWriteError writeNumberStatsSortedLineCall
set memory lastConsoleWriteErrorCode writeNumberStatsSortedLineError
branch error source writeNumberStatsSortedLineCall target consoleWriteFailed

call writeNumberStatsCountLineCall writeStandardOutputLine
argument writeNumberStatsCountLineCall text String numberStatsCountText
run writeNumberStatsCountLineCall
ignore void source writeNumberStatsCountLineCall
bind error writeNumberStatsCountLineError ConsoleWriteError writeNumberStatsCountLineCall
set memory lastConsoleWriteErrorCode writeNumberStatsCountLineError
branch error source writeNumberStatsCountLineCall target consoleWriteFailed

call writeNumberStatsSumLineCall writeStandardOutputLine
argument writeNumberStatsSumLineCall text String numberStatsSumText
run writeNumberStatsSumLineCall
ignore void source writeNumberStatsSumLineCall
bind error writeNumberStatsSumLineError ConsoleWriteError writeNumberStatsSumLineCall
set memory lastConsoleWriteErrorCode writeNumberStatsSumLineError
branch error source writeNumberStatsSumLineCall target consoleWriteFailed

call writeNumberStatsMinLineCall writeStandardOutputLine
argument writeNumberStatsMinLineCall text String numberStatsMinText
run writeNumberStatsMinLineCall
ignore void source writeNumberStatsMinLineCall
bind error writeNumberStatsMinLineError ConsoleWriteError writeNumberStatsMinLineCall
set memory lastConsoleWriteErrorCode writeNumberStatsMinLineError
branch error source writeNumberStatsMinLineCall target consoleWriteFailed

call writeNumberStatsMaxLineCall writeStandardOutputLine
argument writeNumberStatsMaxLineCall text String numberStatsMaxText
run writeNumberStatsMaxLineCall
ignore void source writeNumberStatsMaxLineCall
bind error writeNumberStatsMaxLineError ConsoleWriteError writeNumberStatsMaxLineCall
set memory lastConsoleWriteErrorCode writeNumberStatsMaxLineError
branch error source writeNumberStatsMaxLineCall target consoleWriteFailed

call writeNumberStatsMeanLineCall writeStandardOutputLine
argument writeNumberStatsMeanLineCall text String numberStatsMeanText
run writeNumberStatsMeanLineCall
ignore void source writeNumberStatsMeanLineCall
bind error writeNumberStatsMeanLineError ConsoleWriteError writeNumberStatsMeanLineCall
set memory lastConsoleWriteErrorCode writeNumberStatsMeanLineError
branch error source writeNumberStatsMeanLineCall target consoleWriteFailed

call writeNumberStatsMedianLineCall writeStandardOutputLine
argument writeNumberStatsMedianLineCall text String numberStatsMedianText
run writeNumberStatsMedianLineCall
ignore void source writeNumberStatsMedianLineCall
bind error writeNumberStatsMedianLineError ConsoleWriteError writeNumberStatsMedianLineCall
set memory lastConsoleWriteErrorCode writeNumberStatsMedianLineError
branch error source writeNumberStatsMedianLineCall target consoleWriteFailed

call writeNumberStatsModeLineCall writeStandardOutputLine
argument writeNumberStatsModeLineCall text String numberStatsModeText
run writeNumberStatsModeLineCall
ignore void source writeNumberStatsModeLineCall
bind error writeNumberStatsModeLineError ConsoleWriteError writeNumberStatsModeLineCall
set memory lastConsoleWriteErrorCode writeNumberStatsModeLineError
branch error source writeNumberStatsModeLineCall target consoleWriteFailed

call writeNumberStatsPopulationStdDevLineCall writeStandardOutputLine
argument writeNumberStatsPopulationStdDevLineCall text String numberStatsPopulationStdDevText
run writeNumberStatsPopulationStdDevLineCall
ignore void source writeNumberStatsPopulationStdDevLineCall
bind error writeNumberStatsPopulationStdDevLineError ConsoleWriteError writeNumberStatsPopulationStdDevLineCall
set memory lastConsoleWriteErrorCode writeNumberStatsPopulationStdDevLineError
branch error source writeNumberStatsPopulationStdDevLineCall target consoleWriteFailed

storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode

label consoleWriteFailed
# rationale: lastConsoleWriteErrorCode holds whichever emit actually failed; its `set`
# ran immediately before the corresponding branchIfError, so the typed
# MainError.ConsoleWriteFailed value honestly names its cause (§12).
makeError consoleWriteFailure MainError.ConsoleWriteFailed lastConsoleWriteErrorCode
return error consoleWriteFailure
