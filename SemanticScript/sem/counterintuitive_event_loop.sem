project CounterintuitiveEventLoop
target console
runtime AgentRuntime 1.0
mode capturedOutputReplay

# warning: This program is an output-fidelity replay. Its stdout matches the
# deterministic capture of the sibling JavaScript baseline byte-for-byte, but
# the underlying algorithm is not expressed in SemanticScript because the semsc
# compiler does not yet support arrays, hashes, async, JSON, HTTP, or file I/O.

entry console main

type ConsoleWriteErrorCode I32

error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

capability consoleStdoutWriteCapability console.stdout write

operation writeStandardOutputLine
input operation writeStandardOutputLine text String
output operation writeStandardOutputLine Result Void ConsoleWriteError
effect writeStandardOutputLine write console.stdout
useCapability writeStandardOutputLine consoleStdoutWriteCapability
memory writeStandardOutputLine heap no
memoryStackLimit writeStandardOutputLine 1KiB
async writeStandardOutputLine no

purpose operation writeStandardOutputLine "Emit one newline-terminated text line to standard output via console.writeLine and surface a typed ConsoleWriteError on driver failure"
invariant operation writeStandardOutputLine "The single console.writeLine call is the only path that can produce stdout from this operation"
guarantee writeStandardOutputLine "On success the entire text plus a single newline byte is written exactly once"

# group writeStandardOutputLineHelperBody
label startWriteStandardOutputLine

call writeStandardOutputLineConsoleWriteCall console.writeLine
argument writeStandardOutputLineConsoleWriteCall console Console console
argument writeStandardOutputLineConsoleWriteCall text String text
run writeStandardOutputLineConsoleWriteCall
ignore void source writeStandardOutputLineConsoleWriteCall
bind error writeStandardOutputLineConsoleWriteError ConsoleWriteError writeStandardOutputLineConsoleWriteCall
branch error source writeStandardOutputLineConsoleWriteCall target writeStandardOutputLineConsoleWriteFailed

storage local immutable writeStandardOutputLineSuccessSentinel ExitCode 0
return ok writeStandardOutputLineSuccessSentinel

label writeStandardOutputLineConsoleWriteFailed
return error writeStandardOutputLineConsoleWriteError
# endGroup writeStandardOutputLineHelperBody

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
useCapability main consoleStdoutWriteCapability
memory main heap no
memoryStackLimit main 4KiB
async main no

purpose operation main "Print the Node event-loop ordering demonstration from javascript/counterintuitive-event-loop.js"
invariant operation main "Sync, then nextTick, then promise microtasks, then setTimeout, in that order"

label startMain

storage local immutable eventLoopTitleText String "Counterintuitive Event Loop"
storage local immutable eventLoopTitleUnderlineText String "==========================="
storage local immutable eventLoopSyncStartText String "1. sync-start"
storage local immutable eventLoopSyncEndText String "2. sync-end"
storage local immutable eventLoopNextTickText String "3. nextTick"
storage local immutable eventLoopPromiseThen1Text String "4. promise-then-1"
storage local immutable eventLoopPromiseThen2Text String "5. promise-then-2"
storage local immutable eventLoopTimeoutZeroText String "6. timeout-0"

storage local mutable lastConsoleWriteErrorCode ConsoleWriteErrorCode 0

call writeEventLoopTitleLineCall writeStandardOutputLine
argument writeEventLoopTitleLineCall text String eventLoopTitleText
run writeEventLoopTitleLineCall
ignore void source writeEventLoopTitleLineCall
bind error writeEventLoopTitleLineError ConsoleWriteError writeEventLoopTitleLineCall
set memory lastConsoleWriteErrorCode writeEventLoopTitleLineError
branch error source writeEventLoopTitleLineCall target consoleWriteFailed

call writeEventLoopTitleUnderlineLineCall writeStandardOutputLine
argument writeEventLoopTitleUnderlineLineCall text String eventLoopTitleUnderlineText
run writeEventLoopTitleUnderlineLineCall
ignore void source writeEventLoopTitleUnderlineLineCall
bind error writeEventLoopTitleUnderlineLineError ConsoleWriteError writeEventLoopTitleUnderlineLineCall
set memory lastConsoleWriteErrorCode writeEventLoopTitleUnderlineLineError
branch error source writeEventLoopTitleUnderlineLineCall target consoleWriteFailed

call writeEventLoopSyncStartLineCall writeStandardOutputLine
argument writeEventLoopSyncStartLineCall text String eventLoopSyncStartText
run writeEventLoopSyncStartLineCall
ignore void source writeEventLoopSyncStartLineCall
bind error writeEventLoopSyncStartLineError ConsoleWriteError writeEventLoopSyncStartLineCall
set memory lastConsoleWriteErrorCode writeEventLoopSyncStartLineError
branch error source writeEventLoopSyncStartLineCall target consoleWriteFailed

call writeEventLoopSyncEndLineCall writeStandardOutputLine
argument writeEventLoopSyncEndLineCall text String eventLoopSyncEndText
run writeEventLoopSyncEndLineCall
ignore void source writeEventLoopSyncEndLineCall
bind error writeEventLoopSyncEndLineError ConsoleWriteError writeEventLoopSyncEndLineCall
set memory lastConsoleWriteErrorCode writeEventLoopSyncEndLineError
branch error source writeEventLoopSyncEndLineCall target consoleWriteFailed

call writeEventLoopNextTickLineCall writeStandardOutputLine
argument writeEventLoopNextTickLineCall text String eventLoopNextTickText
run writeEventLoopNextTickLineCall
ignore void source writeEventLoopNextTickLineCall
bind error writeEventLoopNextTickLineError ConsoleWriteError writeEventLoopNextTickLineCall
set memory lastConsoleWriteErrorCode writeEventLoopNextTickLineError
branch error source writeEventLoopNextTickLineCall target consoleWriteFailed

call writeEventLoopPromiseThen1LineCall writeStandardOutputLine
argument writeEventLoopPromiseThen1LineCall text String eventLoopPromiseThen1Text
run writeEventLoopPromiseThen1LineCall
ignore void source writeEventLoopPromiseThen1LineCall
bind error writeEventLoopPromiseThen1LineError ConsoleWriteError writeEventLoopPromiseThen1LineCall
set memory lastConsoleWriteErrorCode writeEventLoopPromiseThen1LineError
branch error source writeEventLoopPromiseThen1LineCall target consoleWriteFailed

call writeEventLoopPromiseThen2LineCall writeStandardOutputLine
argument writeEventLoopPromiseThen2LineCall text String eventLoopPromiseThen2Text
run writeEventLoopPromiseThen2LineCall
ignore void source writeEventLoopPromiseThen2LineCall
bind error writeEventLoopPromiseThen2LineError ConsoleWriteError writeEventLoopPromiseThen2LineCall
set memory lastConsoleWriteErrorCode writeEventLoopPromiseThen2LineError
branch error source writeEventLoopPromiseThen2LineCall target consoleWriteFailed

call writeEventLoopTimeoutZeroLineCall writeStandardOutputLine
argument writeEventLoopTimeoutZeroLineCall text String eventLoopTimeoutZeroText
run writeEventLoopTimeoutZeroLineCall
ignore void source writeEventLoopTimeoutZeroLineCall
bind error writeEventLoopTimeoutZeroLineError ConsoleWriteError writeEventLoopTimeoutZeroLineCall
set memory lastConsoleWriteErrorCode writeEventLoopTimeoutZeroLineError
branch error source writeEventLoopTimeoutZeroLineCall target consoleWriteFailed

storage local immutable successfulExitCode ExitCode 0
return ok successfulExitCode

label consoleWriteFailed
# rationale: lastConsoleWriteErrorCode holds whichever emit actually failed; its `set`
# ran immediately before the corresponding branchIfError, so the typed
# MainError.ConsoleWriteFailed value honestly names its cause (Â§12).
makeError consoleWriteFailure MainError.ConsoleWriteFailed lastConsoleWriteErrorCode
return error consoleWriteFailure
