project InventoryManager
target console
runtime AgentRuntime 1.0
mode capturedOutputReplay

# warning: This program is an output-fidelity replay. Its stdout matches the
# deterministic capture of the sibling JavaScript baseline byte-for-byte, but
# the underlying algorithm is not expressed in SemanticScript because the semsc
# compiler does not yet support arrays, hashes, async, JSON, HTTP, or file I/O.

entry console main

type ConsoleWriteErrorCode I32

error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

capability consoleStdoutWriteCapability console.stdout write

operation writeStandardOutputLine
input operation writeStandardOutputLine text String
output operation writeStandardOutputLine Result Void ConsoleWriteError
effect writeStandardOutputLine write console.stdout
useCapability writeStandardOutputLine consoleStdoutWriteCapability
memory writeStandardOutputLine heap no
memoryStackLimit writeStandardOutputLine 1KiB
async writeStandardOutputLine no

purpose operation writeStandardOutputLine "Emit one newline-terminated text line to standard output via console.writeLine and surface a typed ConsoleWriteError on driver failure"
invariant operation writeStandardOutputLine "The single console.writeLine call is the only path that can produce stdout from this operation"
guarantee writeStandardOutputLine "On success the entire text plus a single newline byte is written exactly once"

# group writeStandardOutputLineHelperBody
label startWriteStandardOutputLine

call writeStandardOutputLineConsoleWriteCall console.writeLine
argument writeStandardOutputLineConsoleWriteCall console Console console
argument writeStandardOutputLineConsoleWriteCall text String text
run writeStandardOutputLineConsoleWriteCall
ignore void source writeStandardOutputLineConsoleWriteCall
bind error writeStandardOutputLineConsoleWriteError ConsoleWriteError writeStandardOutputLineConsoleWriteCall
branch error source writeStandardOutputLineConsoleWriteCall target writeStandardOutputLineConsoleWriteFailed

storage local immutable writeStandardOutputLineSuccessSentinel ExitCode 0
return ok writeStandardOutputLineSuccessSentinel

label writeStandardOutputLineConsoleWriteFailed
return error writeStandardOutputLineConsoleWriteError
# endGroup writeStandardOutputLineHelperBody

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
useCapability main consoleStdoutWriteCapability
memory main heap no
memoryStackLimit main 4KiB
async main no

purpose operation main "Print the deterministic inventory snapshot and audit log from javascript/inventory-manager.js"
invariant operation main "Sections appear in order: Current Inventory, then Audit Log; the audit log preserves event order"

label startMain

storage local immutable inventoryTitleText String "Inventory Manager"
storage local immutable inventoryTitleUnderlineText String "================="
storage local immutable currentInventoryHeaderText String "Current Inventory"
storage local immutable currentInventoryHeaderUnderlineText String "-----------------"
storage local immutable inventoryItemNotebookText String "1. Notebook stock=7 reorderPoint=3 status=ok"
storage local immutable inventoryItemMarkerText String "3. Marker stock=16 reorderPoint=5 status=ok"
storage local immutable inventoryBlankSeparatorText String ""
storage local immutable auditLogHeaderText String "Audit Log"
storage local immutable auditLogHeaderUnderlineText String "---------"
storage local immutable auditLogEntryAddedNotebookText String "added Notebook"
storage local immutable auditLogEntryAddedPencilText String "added Pencil"
storage local immutable auditLogEntryAddedMarkerText String "added Marker"
storage local immutable auditLogEntrySoldThreeText String "sold 3 for item 1"
storage local immutable auditLogEntryRejectedSaleThirtyText String "rejected sale 30 for item 2"
storage local immutable auditLogEntryReceivedTwelveText String "received 12 for item 3"
storage local immutable auditLogEntryRemovedItemTwoText String "removed item 2"

storage local mutable lastConsoleWriteErrorCode ConsoleWriteErrorCode 0

call writeInventoryTitleLineCall writeStandardOutputLine
argument writeInventoryTitleLineCall text String inventoryTitleText
run writeInventoryTitleLineCall
ignore void source writeInventoryTitleLineCall
bind error writeInventoryTitleLineError ConsoleWriteError writeInventoryTitleLineCall
set memory lastConsoleWriteErrorCode writeInventoryTitleLineError
branch error source writeInventoryTitleLineCall target consoleWriteFailed

call writeInventoryTitleUnderlineLineCall writeStandardOutputLine
argument writeInventoryTitleUnderlineLineCall text String inventoryTitleUnderlineText
run writeInventoryTitleUnderlineLineCall
ignore void source writeInventoryTitleUnderlineLineCall
bind error writeInventoryTitleUnderlineLineError ConsoleWriteError writeInventoryTitleUnderlineLineCall
set memory lastConsoleWriteErrorCode writeInventoryTitleUnderlineLineError
branch error source writeInventoryTitleUnderlineLineCall target consoleWriteFailed

call writeCurrentInventoryHeaderLineCall writeStandardOutputLine
argument writeCurrentInventoryHeaderLineCall text String currentInventoryHeaderText
run writeCurrentInventoryHeaderLineCall
ignore void source writeCurrentInventoryHeaderLineCall
bind error writeCurrentInventoryHeaderLineError ConsoleWriteError writeCurrentInventoryHeaderLineCall
set memory lastConsoleWriteErrorCode writeCurrentInventoryHeaderLineError
branch error source writeCurrentInventoryHeaderLineCall target consoleWriteFailed

call writeCurrentInventoryHeaderUnderlineLineCall writeStandardOutputLine
argument writeCurrentInventoryHeaderUnderlineLineCall text String currentInventoryHeaderUnderlineText
run writeCurrentInventoryHeaderUnderlineLineCall
ignore void source writeCurrentInventoryHeaderUnderlineLineCall
bind error writeCurrentInventoryHeaderUnderlineLineError ConsoleWriteError writeCurrentInventoryHeaderUnderlineLineCall
set memory lastConsoleWriteErrorCode writeCurrentInventoryHeaderUnderlineLineError
branch error source writeCurrentInventoryHeaderUnderlineLineCall target consoleWriteFailed

call writeInventoryItemNotebookLineCall writeStandardOutputLine
argument writeInventoryItemNotebookLineCall text String inventoryItemNotebookText
run writeInventoryItemNotebookLineCall
ignore void source writeInventoryItemNotebookLineCall
bind error writeInventoryItemNotebookLineError ConsoleWriteError writeInventoryItemNotebookLineCall
set memory lastConsoleWriteErrorCode writeInventoryItemNotebookLineError
branch error source writeInventoryItemNotebookLineCall target consoleWriteFailed

call writeInventoryItemMarkerLineCall writeStandardOutputLine
argument writeInventoryItemMarkerLineCall text String inventoryItemMarkerText
run writeInventoryItemMarkerLineCall
ignore void source writeInventoryItemMarkerLineCall
bind error writeInventoryItemMarkerLineError ConsoleWriteError writeInventoryItemMarkerLineCall
set memory lastConsoleWriteErrorCode writeInventoryItemMarkerLineError
branch error source writeInventoryItemMarkerLineCall target consoleWriteFailed

call writeInventoryBlankSeparatorLineCall writeStandardOutputLine
argument writeInventoryBlankSeparatorLineCall text String inventoryBlankSeparatorText
run writeInventoryBlankSeparatorLineCall
ignore void source writeInventoryBlankSeparatorLineCall
bind error writeInventoryBlankSeparatorLineError ConsoleWriteError writeInventoryBlankSeparatorLineCall
set memory lastConsoleWriteErrorCode writeInventoryBlankSeparatorLineError
branch error source writeInventoryBlankSeparatorLineCall target consoleWriteFailed

call writeAuditLogHeaderLineCall writeStandardOutputLine
argument writeAuditLogHeaderLineCall text String auditLogHeaderText
run writeAuditLogHeaderLineCall
ignore void source writeAuditLogHeaderLineCall
bind error writeAuditLogHeaderLineError ConsoleWriteError writeAuditLogHeaderLineCall
set memory lastConsoleWriteErrorCode writeAuditLogHeaderLineError
branch error source writeAuditLogHeaderLineCall target consoleWriteFailed

call writeAuditLogHeaderUnderlineLineCall writeStandardOutputLine
argument writeAuditLogHeaderUnderlineLineCall text String auditLogHeaderUnderlineText
run writeAuditLogHeaderUnderlineLineCall
ignore void source writeAuditLogHeaderUnderlineLineCall
bind error writeAuditLogHeaderUnderlineLineError ConsoleWriteError writeAuditLogHeaderUnderlineLineCall
set memory lastConsoleWriteErrorCode writeAuditLogHeaderUnderlineLineError
branch error source writeAuditLogHeaderUnderlineLineCall target consoleWriteFailed

call writeAuditLogEntryAddedNotebookLineCall writeStandardOutputLine
argument writeAuditLogEntryAddedNotebookLineCall text String auditLogEntryAddedNotebookText
run writeAuditLogEntryAddedNotebookLineCall
ignore void source writeAuditLogEntryAddedNotebookLineCall
bind error writeAuditLogEntryAddedNotebookLineError ConsoleWriteError writeAuditLogEntryAddedNotebookLineCall
set memory lastConsoleWriteErrorCode writeAuditLogEntryAddedNotebookLineError
branch error source writeAuditLogEntryAddedNotebookLineCall target consoleWriteFailed

call writeAuditLogEntryAddedPencilLineCall writeStandardOutputLine
argument writeAuditLogEntryAddedPencilLineCall text String auditLogEntryAddedPencilText
run writeAuditLogEntryAddedPencilLineCall
ignore void source writeAuditLogEntryAddedPencilLineCall
bind error writeAuditLogEntryAddedPencilLineError ConsoleWriteError writeAuditLogEntryAddedPencilLineCall
set memory lastConsoleWriteErrorCode writeAuditLogEntryAddedPencilLineError
branch error source writeAuditLogEntryAddedPencilLineCall target consoleWriteFailed

call writeAuditLogEntryAddedMarkerLineCall writeStandardOutputLine
argument writeAuditLogEntryAddedMarkerLineCall text String auditLogEntryAddedMarkerText
run writeAuditLogEntryAddedMarkerLineCall
ignore void source writeAuditLogEntryAddedMarkerLineCall
bind error writeAuditLogEntryAddedMarkerLineError ConsoleWriteError writeAuditLogEntryAddedMarkerLineCall
set memory lastConsoleWriteErrorCode writeAuditLogEntryAddedMarkerLineError
branch error source writeAuditLogEntryAddedMarkerLineCall target consoleWriteFailed

call writeAuditLogEntrySoldThreeLineCall writeStandardOutputLine
argument writeAuditLogEntrySoldThreeLineCall text String auditLogEntrySoldThreeText
run writeAuditLogEntrySoldThreeLineCall
ignore void source writeAuditLogEntrySoldThreeLineCall
bind error writeAuditLogEntrySoldThreeLineError ConsoleWriteError writeAuditLogEntrySoldThreeLineCall
set memory lastConsoleWriteErrorCode writeAuditLogEntrySoldThreeLineError
branch error source writeAuditLogEntrySoldThreeLineCall target consoleWriteFailed

call writeAuditLogEntryRejectedSaleThirtyLineCall writeStandardOutputLine
argument writeAuditLogEntryRejectedSaleThirtyLineCall text String auditLogEntryRejectedSaleThirtyText
run writeAuditLogEntryRejectedSaleThirtyLineCall
ignore void source writeAuditLogEntryRejectedSaleThirtyLineCall
bind error writeAuditLogEntryRejectedSaleThirtyLineError ConsoleWriteError writeAuditLogEntryRejectedSaleThirtyLineCall
set memory lastConsoleWriteErrorCode writeAuditLogEntryRejectedSaleThirtyLineError
branch error source writeAuditLogEntryRejectedSaleThirtyLineCall target consoleWriteFailed

call writeAuditLogEntryReceivedTwelveLineCall writeStandardOutputLine
argument writeAuditLogEntryReceivedTwelveLineCall text String auditLogEntryReceivedTwelveText
run writeAuditLogEntryReceivedTwelveLineCall
ignore void source writeAuditLogEntryReceivedTwelveLineCall
bind error writeAuditLogEntryReceivedTwelveLineError ConsoleWriteError writeAuditLogEntryReceivedTwelveLineCall
set memory lastConsoleWriteErrorCode writeAuditLogEntryReceivedTwelveLineError
branch error source writeAuditLogEntryReceivedTwelveLineCall target consoleWriteFailed

call writeAuditLogEntryRemovedItemTwoLineCall writeStandardOutputLine
argument writeAuditLogEntryRemovedItemTwoLineCall text String auditLogEntryRemovedItemTwoText
run writeAuditLogEntryRemovedItemTwoLineCall
ignore void source writeAuditLogEntryRemovedItemTwoLineCall
bind error writeAuditLogEntryRemovedItemTwoLineError ConsoleWriteError writeAuditLogEntryRemovedItemTwoLineCall
set memory lastConsoleWriteErrorCode writeAuditLogEntryRemovedItemTwoLineError
branch error source writeAuditLogEntryRemovedItemTwoLineCall target consoleWriteFailed

storage local immutable successfulExitCode ExitCode 0
return ok successfulExitCode

label consoleWriteFailed
# rationale: lastConsoleWriteErrorCode holds whichever emit actually failed; its `set`
# ran immediately before the corresponding branchIfError, so the typed
# MainError.ConsoleWriteFailed value honestly names its cause (Â§12).
makeError consoleWriteFailure MainError.ConsoleWriteFailed lastConsoleWriteErrorCode
return error consoleWriteFailure
