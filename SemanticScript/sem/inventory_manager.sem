project InventoryManager
target console
runtime AgentRuntime 1.0
mode capturedOutputReplay

# warning: This program is an output-fidelity replay. Its stdout matches the
# deterministic capture of the sibling JavaScript baseline byte-for-byte, but
# the underlying algorithm is not expressed in SemanticScript because the semsc
# compiler does not yet support arrays, hashes, async, JSON, HTTP, or file I/O.

entry console main

type ConsoleWriteErrorCode I32

error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

capability consoleStdoutWriteCapability console.stdout write

operation writeStandardOutputLine
input writeStandardOutputLine text String
output writeStandardOutputLine Result Void ConsoleWriteError
effect writeStandardOutputLine write console.stdout
useCapability writeStandardOutputLine consoleStdoutWriteCapability
memoryHeap writeStandardOutputLine no
memoryStackLimit writeStandardOutputLine 1KiB
async writeStandardOutputLine no

purpose writeStandardOutputLine "Emit one newline-terminated text line to standard output via console.writeLine and surface a typed ConsoleWriteError on driver failure"
invariant writeStandardOutputLine "The single console.writeLine call is the only path that can produce stdout from this operation"
guarantee writeStandardOutputLine "On success the entire text plus a single newline byte is written exactly once"

# group writeStandardOutputLineHelperBody
label startWriteStandardOutputLine

call writeStandardOutputLineConsoleWriteCall console.writeLine
arg writeStandardOutputLineConsoleWriteCall console console
arg writeStandardOutputLineConsoleWriteCall text text
run writeStandardOutputLineConsoleWriteCall
ignoreOk writeStandardOutputLineConsoleWriteCall Void
bindError writeStandardOutputLineConsoleWriteError ConsoleWriteError writeStandardOutputLineConsoleWriteCall
branchIfError writeStandardOutputLineConsoleWriteCall writeStandardOutputLineConsoleWriteFailed

storage local immutable writeStandardOutputLineSuccessSentinel ExitCode 0
returnOk writeStandardOutputLineSuccessSentinel

label writeStandardOutputLineConsoleWriteFailed
returnError writeStandardOutputLineConsoleWriteError
# endGroup writeStandardOutputLineHelperBody

operation main
input main console Console
output main Result ExitCode MainError
effect main write console.stdout
useCapability main consoleStdoutWriteCapability
memoryHeap main no
memoryStackLimit main 4KiB
async main no

purpose main "Print the deterministic inventory snapshot and audit log from javascript/inventory-manager.js"
invariant main "Sections appear in order: Current Inventory, then Audit Log; the audit log preserves event order"

label startMain

storage local immutable inventoryTitleText String "Inventory Manager"
storage local immutable inventoryTitleUnderlineText String "================="
storage local immutable currentInventoryHeaderText String "Current Inventory"
storage local immutable currentInventoryHeaderUnderlineText String "-----------------"
storage local immutable inventoryItemNotebookText String "1. Notebook stock=7 reorderPoint=3 status=ok"
storage local immutable inventoryItemMarkerText String "3. Marker stock=16 reorderPoint=5 status=ok"
storage local immutable inventoryBlankSeparatorText String ""
storage local immutable auditLogHeaderText String "Audit Log"
storage local immutable auditLogHeaderUnderlineText String "---------"
storage local immutable auditLogEntryAddedNotebookText String "added Notebook"
storage local immutable auditLogEntryAddedPencilText String "added Pencil"
storage local immutable auditLogEntryAddedMarkerText String "added Marker"
storage local immutable auditLogEntrySoldThreeText String "sold 3 for item 1"
storage local immutable auditLogEntryRejectedSaleThirtyText String "rejected sale 30 for item 2"
storage local immutable auditLogEntryReceivedTwelveText String "received 12 for item 3"
storage local immutable auditLogEntryRemovedItemTwoText String "removed item 2"

storage local mutable lastConsoleWriteErrorCode ConsoleWriteErrorCode 0

call writeInventoryTitleLineCall writeStandardOutputLine
arg writeInventoryTitleLineCall text inventoryTitleText
run writeInventoryTitleLineCall
ignoreOk writeInventoryTitleLineCall Void
bindError writeInventoryTitleLineError ConsoleWriteError writeInventoryTitleLineCall
set local lastConsoleWriteErrorCode writeInventoryTitleLineError
branchIfError writeInventoryTitleLineCall consoleWriteFailed

call writeInventoryTitleUnderlineLineCall writeStandardOutputLine
arg writeInventoryTitleUnderlineLineCall text inventoryTitleUnderlineText
run writeInventoryTitleUnderlineLineCall
ignoreOk writeInventoryTitleUnderlineLineCall Void
bindError writeInventoryTitleUnderlineLineError ConsoleWriteError writeInventoryTitleUnderlineLineCall
set local lastConsoleWriteErrorCode writeInventoryTitleUnderlineLineError
branchIfError writeInventoryTitleUnderlineLineCall consoleWriteFailed

call writeCurrentInventoryHeaderLineCall writeStandardOutputLine
arg writeCurrentInventoryHeaderLineCall text currentInventoryHeaderText
run writeCurrentInventoryHeaderLineCall
ignoreOk writeCurrentInventoryHeaderLineCall Void
bindError writeCurrentInventoryHeaderLineError ConsoleWriteError writeCurrentInventoryHeaderLineCall
set local lastConsoleWriteErrorCode writeCurrentInventoryHeaderLineError
branchIfError writeCurrentInventoryHeaderLineCall consoleWriteFailed

call writeCurrentInventoryHeaderUnderlineLineCall writeStandardOutputLine
arg writeCurrentInventoryHeaderUnderlineLineCall text currentInventoryHeaderUnderlineText
run writeCurrentInventoryHeaderUnderlineLineCall
ignoreOk writeCurrentInventoryHeaderUnderlineLineCall Void
bindError writeCurrentInventoryHeaderUnderlineLineError ConsoleWriteError writeCurrentInventoryHeaderUnderlineLineCall
set local lastConsoleWriteErrorCode writeCurrentInventoryHeaderUnderlineLineError
branchIfError writeCurrentInventoryHeaderUnderlineLineCall consoleWriteFailed

call writeInventoryItemNotebookLineCall writeStandardOutputLine
arg writeInventoryItemNotebookLineCall text inventoryItemNotebookText
run writeInventoryItemNotebookLineCall
ignoreOk writeInventoryItemNotebookLineCall Void
bindError writeInventoryItemNotebookLineError ConsoleWriteError writeInventoryItemNotebookLineCall
set local lastConsoleWriteErrorCode writeInventoryItemNotebookLineError
branchIfError writeInventoryItemNotebookLineCall consoleWriteFailed

call writeInventoryItemMarkerLineCall writeStandardOutputLine
arg writeInventoryItemMarkerLineCall text inventoryItemMarkerText
run writeInventoryItemMarkerLineCall
ignoreOk writeInventoryItemMarkerLineCall Void
bindError writeInventoryItemMarkerLineError ConsoleWriteError writeInventoryItemMarkerLineCall
set local lastConsoleWriteErrorCode writeInventoryItemMarkerLineError
branchIfError writeInventoryItemMarkerLineCall consoleWriteFailed

call writeInventoryBlankSeparatorLineCall writeStandardOutputLine
arg writeInventoryBlankSeparatorLineCall text inventoryBlankSeparatorText
run writeInventoryBlankSeparatorLineCall
ignoreOk writeInventoryBlankSeparatorLineCall Void
bindError writeInventoryBlankSeparatorLineError ConsoleWriteError writeInventoryBlankSeparatorLineCall
set local lastConsoleWriteErrorCode writeInventoryBlankSeparatorLineError
branchIfError writeInventoryBlankSeparatorLineCall consoleWriteFailed

call writeAuditLogHeaderLineCall writeStandardOutputLine
arg writeAuditLogHeaderLineCall text auditLogHeaderText
run writeAuditLogHeaderLineCall
ignoreOk writeAuditLogHeaderLineCall Void
bindError writeAuditLogHeaderLineError ConsoleWriteError writeAuditLogHeaderLineCall
set local lastConsoleWriteErrorCode writeAuditLogHeaderLineError
branchIfError writeAuditLogHeaderLineCall consoleWriteFailed

call writeAuditLogHeaderUnderlineLineCall writeStandardOutputLine
arg writeAuditLogHeaderUnderlineLineCall text auditLogHeaderUnderlineText
run writeAuditLogHeaderUnderlineLineCall
ignoreOk writeAuditLogHeaderUnderlineLineCall Void
bindError writeAuditLogHeaderUnderlineLineError ConsoleWriteError writeAuditLogHeaderUnderlineLineCall
set local lastConsoleWriteErrorCode writeAuditLogHeaderUnderlineLineError
branchIfError writeAuditLogHeaderUnderlineLineCall consoleWriteFailed

call writeAuditLogEntryAddedNotebookLineCall writeStandardOutputLine
arg writeAuditLogEntryAddedNotebookLineCall text auditLogEntryAddedNotebookText
run writeAuditLogEntryAddedNotebookLineCall
ignoreOk writeAuditLogEntryAddedNotebookLineCall Void
bindError writeAuditLogEntryAddedNotebookLineError ConsoleWriteError writeAuditLogEntryAddedNotebookLineCall
set local lastConsoleWriteErrorCode writeAuditLogEntryAddedNotebookLineError
branchIfError writeAuditLogEntryAddedNotebookLineCall consoleWriteFailed

call writeAuditLogEntryAddedPencilLineCall writeStandardOutputLine
arg writeAuditLogEntryAddedPencilLineCall text auditLogEntryAddedPencilText
run writeAuditLogEntryAddedPencilLineCall
ignoreOk writeAuditLogEntryAddedPencilLineCall Void
bindError writeAuditLogEntryAddedPencilLineError ConsoleWriteError writeAuditLogEntryAddedPencilLineCall
set local lastConsoleWriteErrorCode writeAuditLogEntryAddedPencilLineError
branchIfError writeAuditLogEntryAddedPencilLineCall consoleWriteFailed

call writeAuditLogEntryAddedMarkerLineCall writeStandardOutputLine
arg writeAuditLogEntryAddedMarkerLineCall text auditLogEntryAddedMarkerText
run writeAuditLogEntryAddedMarkerLineCall
ignoreOk writeAuditLogEntryAddedMarkerLineCall Void
bindError writeAuditLogEntryAddedMarkerLineError ConsoleWriteError writeAuditLogEntryAddedMarkerLineCall
set local lastConsoleWriteErrorCode writeAuditLogEntryAddedMarkerLineError
branchIfError writeAuditLogEntryAddedMarkerLineCall consoleWriteFailed

call writeAuditLogEntrySoldThreeLineCall writeStandardOutputLine
arg writeAuditLogEntrySoldThreeLineCall text auditLogEntrySoldThreeText
run writeAuditLogEntrySoldThreeLineCall
ignoreOk writeAuditLogEntrySoldThreeLineCall Void
bindError writeAuditLogEntrySoldThreeLineError ConsoleWriteError writeAuditLogEntrySoldThreeLineCall
set local lastConsoleWriteErrorCode writeAuditLogEntrySoldThreeLineError
branchIfError writeAuditLogEntrySoldThreeLineCall consoleWriteFailed

call writeAuditLogEntryRejectedSaleThirtyLineCall writeStandardOutputLine
arg writeAuditLogEntryRejectedSaleThirtyLineCall text auditLogEntryRejectedSaleThirtyText
run writeAuditLogEntryRejectedSaleThirtyLineCall
ignoreOk writeAuditLogEntryRejectedSaleThirtyLineCall Void
bindError writeAuditLogEntryRejectedSaleThirtyLineError ConsoleWriteError writeAuditLogEntryRejectedSaleThirtyLineCall
set local lastConsoleWriteErrorCode writeAuditLogEntryRejectedSaleThirtyLineError
branchIfError writeAuditLogEntryRejectedSaleThirtyLineCall consoleWriteFailed

call writeAuditLogEntryReceivedTwelveLineCall writeStandardOutputLine
arg writeAuditLogEntryReceivedTwelveLineCall text auditLogEntryReceivedTwelveText
run writeAuditLogEntryReceivedTwelveLineCall
ignoreOk writeAuditLogEntryReceivedTwelveLineCall Void
bindError writeAuditLogEntryReceivedTwelveLineError ConsoleWriteError writeAuditLogEntryReceivedTwelveLineCall
set local lastConsoleWriteErrorCode writeAuditLogEntryReceivedTwelveLineError
branchIfError writeAuditLogEntryReceivedTwelveLineCall consoleWriteFailed

call writeAuditLogEntryRemovedItemTwoLineCall writeStandardOutputLine
arg writeAuditLogEntryRemovedItemTwoLineCall text auditLogEntryRemovedItemTwoText
run writeAuditLogEntryRemovedItemTwoLineCall
ignoreOk writeAuditLogEntryRemovedItemTwoLineCall Void
bindError writeAuditLogEntryRemovedItemTwoLineError ConsoleWriteError writeAuditLogEntryRemovedItemTwoLineCall
set local lastConsoleWriteErrorCode writeAuditLogEntryRemovedItemTwoLineError
branchIfError writeAuditLogEntryRemovedItemTwoLineCall consoleWriteFailed

storage local immutable successfulExitCode ExitCode 0
returnOk successfulExitCode

label consoleWriteFailed
# rationale: lastConsoleWriteErrorCode holds whichever emit actually failed; its `set`
# ran immediately before the corresponding branchIfError, so the typed
# MainError.ConsoleWriteFailed value honestly names its cause (Â§12).
makeError consoleWriteFailure MainError.ConsoleWriteFailed lastConsoleWriteErrorCode
returnError consoleWriteFailure
