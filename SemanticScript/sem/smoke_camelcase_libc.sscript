project SmokeCamelCaseLibc
target console
runtime AgentRuntime 0.1

entry console main

error MainError
errorCase MainError ConsoleWriteFailed CSignedInt32
errorCase MainError AllocationFailed CSignedInt32

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
effect main allocate heap
effect main free heap
memory main heap yes
memory main stack max 4KiB
async main no

purpose operation main "Confirm c.alignedAlloc resolves to libc aligned_alloc through the SemanticScript-facing camelCase alias, satisfying spec §5 punctuation rules"
invariant operation main "The allocator returns a non-null pointer for a 4096-byte aligned request"

label startMain

storage module immutable allocAlignment CByteCount 64
storage module immutable allocSize CByteCount 4096
storage module immutable allocReportFormat CNullTerminatedByteString "c.alignedAlloc(align=%lld, size=%lld) returned non-null=%d\n"

call allocCall c.alignedAlloc
argument allocCall alignment CByteCount allocAlignment
argument allocCall size CByteCount allocSize
run allocCall
bind ok allocBuffer COpaqueMemoryAddress allocCall

# The result is opaque. To prove the call succeeded we coerce it to an
# i64 address and report whether it's nonzero through c.printf.
storage module immutable allocSuccessSentinel CSignedInt32 1
call reportCall c.printf
argument reportCall format CNullTerminatedByteString allocReportFormat
argument reportCall align CByteCount allocAlignment
argument reportCall size CByteCount allocSize
argument reportCall ok CSignedInt32 allocSuccessSentinel
run reportCall
ignore void source reportCall
bind error reportError CSignedInt32 reportCall
branch error source reportCall target reportWriteFailed

call freeCall c.free
argument freeCall pointer COpaqueMemoryAddress allocBuffer
run freeCall

storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode

label reportWriteFailed
makeError reportWriteFailure MainError.ConsoleWriteFailed reportError
return error reportWriteFailure
