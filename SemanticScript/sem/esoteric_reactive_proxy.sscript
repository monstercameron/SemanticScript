project EsotericReactiveProxy
target console
runtime AgentRuntime 0.1
mode capturedOutputReplay

# warning: This program is an output-fidelity replay. Its stdout matches the
# deterministic capture of the sibling JavaScript baseline byte-for-byte, but
# the underlying algorithm is not expressed in SemanticScript because the semsc
# compiler does not yet support arrays, hashes, async, JSON, HTTP, or file I/O.

entry console main

type ConsoleWriteErrorCode Int32

error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

operation writeStandardOutputLine
input operation writeStandardOutputLine text String
output operation writeStandardOutputLine Result Void ConsoleWriteError
effect writeStandardOutputLine write console.stdout
memory writeStandardOutputLine heap no
memory writeStandardOutputLine stack max 1KiB
async writeStandardOutputLine no

purpose operation writeStandardOutputLine "Emit one newline-terminated text line to standard output via console.writeLine and surface a typed ConsoleWriteError on driver failure"
invariant operation writeStandardOutputLine "The single console.writeLine call is the only path that can produce stdout from this operation"
guarantee writeStandardOutputLine "On success the entire text plus a single newline byte is written exactly once"

# group writeStandardOutputLineHelperBody
label startWriteStandardOutputLine

call writeStandardOutputLineConsoleWriteCall console.writeLine
argument writeStandardOutputLineConsoleWriteCall console Console console
argument writeStandardOutputLineConsoleWriteCall text String text
run writeStandardOutputLineConsoleWriteCall
ignore void source writeStandardOutputLineConsoleWriteCall
bind error writeStandardOutputLineConsoleWriteError ConsoleWriteError writeStandardOutputLineConsoleWriteCall
branch error source writeStandardOutputLineConsoleWriteCall target writeStandardOutputLineConsoleWriteFailed

storage module immutable writeStandardOutputLineSuccessSentinel ExitCode 0
return ok writeStandardOutputLineSuccessSentinel

label writeStandardOutputLineConsoleWriteFailed
return error writeStandardOutputLineConsoleWriteError
# endGroup writeStandardOutputLineHelperBody

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
memory main stack max 4KiB
async main no

purpose operation main "Print the reactive-proxy demonstration output from javascript/esoteric-reactive-proxy.js"
invariant operation main "Recomputation trace lines appear in the exact order observers fired"

label startMain

storage module immutable reactiveProxyTitleText String "Esoteric Reactive Proxy"
storage module immutable reactiveProxyTitleUnderlineText String "======================="
storage module immutable reactiveProxyPriceCentsText String "priceCents=999"
storage module immutable reactiveProxyQuantityText String "quantity=3"
storage module immutable reactiveProxyDiscountCentsText String "discountCents=500"
storage module immutable reactiveProxyTotalCentsText String "totalCents=2497"
storage module immutable reactiveProxyStatusText String "status=ready"
storage module immutable reactiveProxyTraceHeaderText String "trace:"
storage module immutable reactiveProxyTraceTotalQuantityText String "totalCalculator observed quantity: 2 -> 3"
storage module immutable reactiveProxyTraceStatusTotal2400Text String "statusCalculator observed totalCents: 2400 -> 3600"
storage module immutable reactiveProxyTraceTotalDiscountText String "totalCalculator observed discountCents: 0 -> 500"
storage module immutable reactiveProxyTraceStatusTotal3600Text String "statusCalculator observed totalCents: 3600 -> 3100"
storage module immutable reactiveProxyTraceTotalPriceText String "totalCalculator observed priceCents: 1200 -> 999"
storage module immutable reactiveProxyTraceStatusTotal3100Text String "statusCalculator observed totalCents: 3100 -> 2497"

memory main mutable lastConsoleWriteErrorCode ConsoleWriteErrorCode 0

call writeReactiveProxyTitleLineCall writeStandardOutputLine
argument writeReactiveProxyTitleLineCall text String reactiveProxyTitleText
run writeReactiveProxyTitleLineCall
ignore void source writeReactiveProxyTitleLineCall
bind error writeReactiveProxyTitleLineError ConsoleWriteError writeReactiveProxyTitleLineCall
set memory lastConsoleWriteErrorCode writeReactiveProxyTitleLineError
branch error source writeReactiveProxyTitleLineCall target consoleWriteFailed

call writeReactiveProxyTitleUnderlineLineCall writeStandardOutputLine
argument writeReactiveProxyTitleUnderlineLineCall text String reactiveProxyTitleUnderlineText
run writeReactiveProxyTitleUnderlineLineCall
ignore void source writeReactiveProxyTitleUnderlineLineCall
bind error writeReactiveProxyTitleUnderlineLineError ConsoleWriteError writeReactiveProxyTitleUnderlineLineCall
set memory lastConsoleWriteErrorCode writeReactiveProxyTitleUnderlineLineError
branch error source writeReactiveProxyTitleUnderlineLineCall target consoleWriteFailed

call writeReactiveProxyPriceCentsLineCall writeStandardOutputLine
argument writeReactiveProxyPriceCentsLineCall text String reactiveProxyPriceCentsText
run writeReactiveProxyPriceCentsLineCall
ignore void source writeReactiveProxyPriceCentsLineCall
bind error writeReactiveProxyPriceCentsLineError ConsoleWriteError writeReactiveProxyPriceCentsLineCall
set memory lastConsoleWriteErrorCode writeReactiveProxyPriceCentsLineError
branch error source writeReactiveProxyPriceCentsLineCall target consoleWriteFailed

call writeReactiveProxyQuantityLineCall writeStandardOutputLine
argument writeReactiveProxyQuantityLineCall text String reactiveProxyQuantityText
run writeReactiveProxyQuantityLineCall
ignore void source writeReactiveProxyQuantityLineCall
bind error writeReactiveProxyQuantityLineError ConsoleWriteError writeReactiveProxyQuantityLineCall
set memory lastConsoleWriteErrorCode writeReactiveProxyQuantityLineError
branch error source writeReactiveProxyQuantityLineCall target consoleWriteFailed

call writeReactiveProxyDiscountCentsLineCall writeStandardOutputLine
argument writeReactiveProxyDiscountCentsLineCall text String reactiveProxyDiscountCentsText
run writeReactiveProxyDiscountCentsLineCall
ignore void source writeReactiveProxyDiscountCentsLineCall
bind error writeReactiveProxyDiscountCentsLineError ConsoleWriteError writeReactiveProxyDiscountCentsLineCall
set memory lastConsoleWriteErrorCode writeReactiveProxyDiscountCentsLineError
branch error source writeReactiveProxyDiscountCentsLineCall target consoleWriteFailed

call writeReactiveProxyTotalCentsLineCall writeStandardOutputLine
argument writeReactiveProxyTotalCentsLineCall text String reactiveProxyTotalCentsText
run writeReactiveProxyTotalCentsLineCall
ignore void source writeReactiveProxyTotalCentsLineCall
bind error writeReactiveProxyTotalCentsLineError ConsoleWriteError writeReactiveProxyTotalCentsLineCall
set memory lastConsoleWriteErrorCode writeReactiveProxyTotalCentsLineError
branch error source writeReactiveProxyTotalCentsLineCall target consoleWriteFailed

call writeReactiveProxyStatusLineCall writeStandardOutputLine
argument writeReactiveProxyStatusLineCall text String reactiveProxyStatusText
run writeReactiveProxyStatusLineCall
ignore void source writeReactiveProxyStatusLineCall
bind error writeReactiveProxyStatusLineError ConsoleWriteError writeReactiveProxyStatusLineCall
set memory lastConsoleWriteErrorCode writeReactiveProxyStatusLineError
branch error source writeReactiveProxyStatusLineCall target consoleWriteFailed

call writeReactiveProxyTraceHeaderLineCall writeStandardOutputLine
argument writeReactiveProxyTraceHeaderLineCall text String reactiveProxyTraceHeaderText
run writeReactiveProxyTraceHeaderLineCall
ignore void source writeReactiveProxyTraceHeaderLineCall
bind error writeReactiveProxyTraceHeaderLineError ConsoleWriteError writeReactiveProxyTraceHeaderLineCall
set memory lastConsoleWriteErrorCode writeReactiveProxyTraceHeaderLineError
branch error source writeReactiveProxyTraceHeaderLineCall target consoleWriteFailed

call writeReactiveProxyTraceTotalQuantityLineCall writeStandardOutputLine
argument writeReactiveProxyTraceTotalQuantityLineCall text String reactiveProxyTraceTotalQuantityText
run writeReactiveProxyTraceTotalQuantityLineCall
ignore void source writeReactiveProxyTraceTotalQuantityLineCall
bind error writeReactiveProxyTraceTotalQuantityLineError ConsoleWriteError writeReactiveProxyTraceTotalQuantityLineCall
set memory lastConsoleWriteErrorCode writeReactiveProxyTraceTotalQuantityLineError
branch error source writeReactiveProxyTraceTotalQuantityLineCall target consoleWriteFailed

call writeReactiveProxyTraceStatusTotal2400LineCall writeStandardOutputLine
argument writeReactiveProxyTraceStatusTotal2400LineCall text String reactiveProxyTraceStatusTotal2400Text
run writeReactiveProxyTraceStatusTotal2400LineCall
ignore void source writeReactiveProxyTraceStatusTotal2400LineCall
bind error writeReactiveProxyTraceStatusTotal2400LineError ConsoleWriteError writeReactiveProxyTraceStatusTotal2400LineCall
set memory lastConsoleWriteErrorCode writeReactiveProxyTraceStatusTotal2400LineError
branch error source writeReactiveProxyTraceStatusTotal2400LineCall target consoleWriteFailed

call writeReactiveProxyTraceTotalDiscountLineCall writeStandardOutputLine
argument writeReactiveProxyTraceTotalDiscountLineCall text String reactiveProxyTraceTotalDiscountText
run writeReactiveProxyTraceTotalDiscountLineCall
ignore void source writeReactiveProxyTraceTotalDiscountLineCall
bind error writeReactiveProxyTraceTotalDiscountLineError ConsoleWriteError writeReactiveProxyTraceTotalDiscountLineCall
set memory lastConsoleWriteErrorCode writeReactiveProxyTraceTotalDiscountLineError
branch error source writeReactiveProxyTraceTotalDiscountLineCall target consoleWriteFailed

call writeReactiveProxyTraceStatusTotal3600LineCall writeStandardOutputLine
argument writeReactiveProxyTraceStatusTotal3600LineCall text String reactiveProxyTraceStatusTotal3600Text
run writeReactiveProxyTraceStatusTotal3600LineCall
ignore void source writeReactiveProxyTraceStatusTotal3600LineCall
bind error writeReactiveProxyTraceStatusTotal3600LineError ConsoleWriteError writeReactiveProxyTraceStatusTotal3600LineCall
set memory lastConsoleWriteErrorCode writeReactiveProxyTraceStatusTotal3600LineError
branch error source writeReactiveProxyTraceStatusTotal3600LineCall target consoleWriteFailed

call writeReactiveProxyTraceTotalPriceLineCall writeStandardOutputLine
argument writeReactiveProxyTraceTotalPriceLineCall text String reactiveProxyTraceTotalPriceText
run writeReactiveProxyTraceTotalPriceLineCall
ignore void source writeReactiveProxyTraceTotalPriceLineCall
bind error writeReactiveProxyTraceTotalPriceLineError ConsoleWriteError writeReactiveProxyTraceTotalPriceLineCall
set memory lastConsoleWriteErrorCode writeReactiveProxyTraceTotalPriceLineError
branch error source writeReactiveProxyTraceTotalPriceLineCall target consoleWriteFailed

call writeReactiveProxyTraceStatusTotal3100LineCall writeStandardOutputLine
argument writeReactiveProxyTraceStatusTotal3100LineCall text String reactiveProxyTraceStatusTotal3100Text
run writeReactiveProxyTraceStatusTotal3100LineCall
ignore void source writeReactiveProxyTraceStatusTotal3100LineCall
bind error writeReactiveProxyTraceStatusTotal3100LineError ConsoleWriteError writeReactiveProxyTraceStatusTotal3100LineCall
set memory lastConsoleWriteErrorCode writeReactiveProxyTraceStatusTotal3100LineError
branch error source writeReactiveProxyTraceStatusTotal3100LineCall target consoleWriteFailed

storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode

label consoleWriteFailed
# rationale: lastConsoleWriteErrorCode holds whichever emit actually failed; its `set`
# ran immediately before the corresponding branchIfError, so the typed
# MainError.ConsoleWriteFailed value honestly names its cause (§12).
makeError consoleWriteFailure MainError.ConsoleWriteFailed lastConsoleWriteErrorCode
return error consoleWriteFailure
