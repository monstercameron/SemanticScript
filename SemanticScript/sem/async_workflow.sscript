project AsyncWorkflow
target console
runtime AgentRuntime 0.1
mode capturedOutputReplay

# warning: This program is an output-fidelity replay. Its stdout matches the
# deterministic capture of the sibling JavaScript baseline byte-for-byte, but
# the underlying algorithm is not expressed in SemanticScript because the semsc
# compiler does not yet support arrays, hashes, async, JSON, HTTP, or file I/O.

entry console main

type ConsoleWriteErrorCode Int32

error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

operation writeStandardOutputLine
input operation writeStandardOutputLine text String
output operation writeStandardOutputLine Result Void ConsoleWriteError
effect writeStandardOutputLine write console.stdout
memory writeStandardOutputLine heap no
memory writeStandardOutputLine stack max 1KiB
async writeStandardOutputLine no

purpose operation writeStandardOutputLine "Emit one newline-terminated text line to standard output via console.writeLine and surface a typed ConsoleWriteError on driver failure"
invariant operation writeStandardOutputLine "The single console.writeLine call is the only path that can produce stdout from this operation"
guarantee writeStandardOutputLine "On success the entire text plus a single newline byte is written exactly once"

# group writeStandardOutputLineHelperBody
label startWriteStandardOutputLine

call writeStandardOutputLineConsoleWriteCall console.writeLine
argument writeStandardOutputLineConsoleWriteCall console Console console
argument writeStandardOutputLineConsoleWriteCall text String text
run writeStandardOutputLineConsoleWriteCall
ignore void source writeStandardOutputLineConsoleWriteCall
bind error writeStandardOutputLineConsoleWriteError ConsoleWriteError writeStandardOutputLineConsoleWriteCall
branch error source writeStandardOutputLineConsoleWriteCall target writeStandardOutputLineConsoleWriteFailed

storage module immutable writeStandardOutputLineSuccessSentinel ExitCode 0
return ok writeStandardOutputLineSuccessSentinel

label writeStandardOutputLineConsoleWriteFailed
return error writeStandardOutputLineConsoleWriteError
# endGroup writeStandardOutputLineHelperBody

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
memory main stack max 4KiB
async main no

purpose operation main "Print the deterministic Promise.all workflow results from javascript/async-workflow.js"
invariant operation main "Job rows appear sorted alphabetically by job name after all three jobs settle"

label startMain

storage module immutable asyncWorkflowTitleText String "Async Workflow"
storage module immutable asyncWorkflowTitleUnderlineText String "=============="
storage module immutable asyncWorkflowLoadCacheText String "loadCache: succeeded - loadCache completed after 5ms"
storage module immutable asyncWorkflowReadConfigText String "readConfig: succeeded - readConfig completed after 10ms"
storage module immutable asyncWorkflowWarmSearchIndexText String "warmSearchIndex: failed - warmSearchIndex failed after 15ms"

memory main mutable lastConsoleWriteErrorCode ConsoleWriteErrorCode 0

call writeAsyncWorkflowTitleLineCall writeStandardOutputLine
argument writeAsyncWorkflowTitleLineCall text String asyncWorkflowTitleText
run writeAsyncWorkflowTitleLineCall
ignore void source writeAsyncWorkflowTitleLineCall
bind error writeAsyncWorkflowTitleLineError ConsoleWriteError writeAsyncWorkflowTitleLineCall
set memory lastConsoleWriteErrorCode writeAsyncWorkflowTitleLineError
branch error source writeAsyncWorkflowTitleLineCall target consoleWriteFailed

call writeAsyncWorkflowTitleUnderlineLineCall writeStandardOutputLine
argument writeAsyncWorkflowTitleUnderlineLineCall text String asyncWorkflowTitleUnderlineText
run writeAsyncWorkflowTitleUnderlineLineCall
ignore void source writeAsyncWorkflowTitleUnderlineLineCall
bind error writeAsyncWorkflowTitleUnderlineLineError ConsoleWriteError writeAsyncWorkflowTitleUnderlineLineCall
set memory lastConsoleWriteErrorCode writeAsyncWorkflowTitleUnderlineLineError
branch error source writeAsyncWorkflowTitleUnderlineLineCall target consoleWriteFailed

call writeAsyncWorkflowLoadCacheLineCall writeStandardOutputLine
argument writeAsyncWorkflowLoadCacheLineCall text String asyncWorkflowLoadCacheText
run writeAsyncWorkflowLoadCacheLineCall
ignore void source writeAsyncWorkflowLoadCacheLineCall
bind error writeAsyncWorkflowLoadCacheLineError ConsoleWriteError writeAsyncWorkflowLoadCacheLineCall
set memory lastConsoleWriteErrorCode writeAsyncWorkflowLoadCacheLineError
branch error source writeAsyncWorkflowLoadCacheLineCall target consoleWriteFailed

call writeAsyncWorkflowReadConfigLineCall writeStandardOutputLine
argument writeAsyncWorkflowReadConfigLineCall text String asyncWorkflowReadConfigText
run writeAsyncWorkflowReadConfigLineCall
ignore void source writeAsyncWorkflowReadConfigLineCall
bind error writeAsyncWorkflowReadConfigLineError ConsoleWriteError writeAsyncWorkflowReadConfigLineCall
set memory lastConsoleWriteErrorCode writeAsyncWorkflowReadConfigLineError
branch error source writeAsyncWorkflowReadConfigLineCall target consoleWriteFailed

call writeAsyncWorkflowWarmSearchIndexLineCall writeStandardOutputLine
argument writeAsyncWorkflowWarmSearchIndexLineCall text String asyncWorkflowWarmSearchIndexText
run writeAsyncWorkflowWarmSearchIndexLineCall
ignore void source writeAsyncWorkflowWarmSearchIndexLineCall
bind error writeAsyncWorkflowWarmSearchIndexLineError ConsoleWriteError writeAsyncWorkflowWarmSearchIndexLineCall
set memory lastConsoleWriteErrorCode writeAsyncWorkflowWarmSearchIndexLineError
branch error source writeAsyncWorkflowWarmSearchIndexLineCall target consoleWriteFailed

storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode

label consoleWriteFailed
# rationale: lastConsoleWriteErrorCode holds whichever emit actually failed; its `set`
# ran immediately before the corresponding branchIfError, so the typed
# MainError.ConsoleWriteFailed value honestly names its cause (§12).
makeError consoleWriteFailure MainError.ConsoleWriteFailed lastConsoleWriteErrorCode
return error consoleWriteFailure
