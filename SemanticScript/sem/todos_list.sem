project TodosList
target console
runtime AgentRuntime 1.0
mode capturedOutputReplay

# warning: This program is an output-fidelity replay. Its stdout matches the
# deterministic capture of the sibling JavaScript baseline byte-for-byte, but
# the underlying algorithm is not expressed in SemanticScript because the semsc
# compiler does not yet support arrays, hashes, async, JSON, HTTP, or file I/O.

entry console main

type ConsoleWriteErrorCode Int32

error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

capability consoleStdoutWriteCapability console.stdout write

operation writeStandardOutputLine
input operation writeStandardOutputLine text String
output operation writeStandardOutputLine Result Void ConsoleWriteError
effect writeStandardOutputLine write console.stdout
useCapability writeStandardOutputLine consoleStdoutWriteCapability
memory writeStandardOutputLine heap no
memoryStackLimit writeStandardOutputLine 1KiB
async writeStandardOutputLine no

purpose operation writeStandardOutputLine "Emit one newline-terminated text line to standard output via console.writeLine and surface a typed ConsoleWriteError on driver failure"
invariant operation writeStandardOutputLine "The single console.writeLine call is the only path that can produce stdout from this operation"
guarantee writeStandardOutputLine "On success the entire text plus a single newline byte is written exactly once"

# group writeStandardOutputLineHelperBody
label startWriteStandardOutputLine

call writeStandardOutputLineConsoleWriteCall console.writeLine
argument writeStandardOutputLineConsoleWriteCall console Console console
argument writeStandardOutputLineConsoleWriteCall text String text
run writeStandardOutputLineConsoleWriteCall
ignore void source writeStandardOutputLineConsoleWriteCall
bind error writeStandardOutputLineConsoleWriteError ConsoleWriteError writeStandardOutputLineConsoleWriteCall
branch error source writeStandardOutputLineConsoleWriteCall target writeStandardOutputLineConsoleWriteFailed

storage local immutable writeStandardOutputLineSuccessSentinel ExitCode 0
return ok writeStandardOutputLineSuccessSentinel

label writeStandardOutputLineConsoleWriteFailed
return error writeStandardOutputLineConsoleWriteError
# endGroup writeStandardOutputLineHelperBody

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
useCapability main consoleStdoutWriteCapability
memory main heap no
memoryStackLimit main 4KiB
async main no

purpose operation main "Print the deterministic two-step Todo Console session from javascript/todos-list.js with stdin 1 then 7"
invariant operation main "The session menu is printed twice; the first selection lists todos; the second selection quits"

label startMain

storage local immutable todosBannerText String "Raw Node Todo Console"
storage local immutable todosBlankLineText String ""
storage local immutable todosMenuTitleText String "Todo Console"
storage local immutable todosMenuUnderlineText String "============"
storage local immutable todosMenuOption1Text String "1. List todos"
storage local immutable todosMenuOption2Text String "2. View todo"
storage local immutable todosMenuOption3Text String "3. Add todo"
storage local immutable todosMenuOption4Text String "4. Update todo title"
storage local immutable todosMenuOption5Text String "5. Toggle todo complete"
storage local immutable todosMenuOption6Text String "6. Delete todo"
storage local immutable todosMenuOption7Text String "7. Quit"
storage local immutable todosChoosePromptListText String "Choose an action: 1"
storage local immutable todosHeaderText String "Todos"
storage local immutable todosHeaderUnderlineText String "-----"
storage local immutable todosListItem1Text String "1. [open] Write SemanticScript baseline examples"
storage local immutable todosListItem2Text String "2. [done] Run the JavaScript snippets"
storage local immutable todosChoosePromptQuitText String "Choose an action: 7"
storage local immutable todosGoodbyeText String "Goodbye."

storage local mutable lastConsoleWriteErrorCode ConsoleWriteErrorCode 0

call writeTodosBannerLineCall writeStandardOutputLine
argument writeTodosBannerLineCall text String todosBannerText
run writeTodosBannerLineCall
ignore void source writeTodosBannerLineCall
bind error writeTodosBannerLineError ConsoleWriteError writeTodosBannerLineCall
set memory lastConsoleWriteErrorCode writeTodosBannerLineError
branch error source writeTodosBannerLineCall target consoleWriteFailed

