project CounterintuitiveThisBinding
target console
runtime AgentRuntime 1.0
mode capturedOutputReplay

# warning: This program is an output-fidelity replay. Its stdout matches the
# deterministic capture of the sibling JavaScript baseline byte-for-byte, but
# the underlying algorithm is not expressed in SemanticScript because the semsc
# compiler does not yet support arrays, hashes, async, JSON, HTTP, or file I/O.

entry console main

type ConsoleWriteErrorCode I32

error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

capability consoleStdoutWriteCapability console.stdout write

operation writeStandardOutputLine
input operation writeStandardOutputLine text String
output operation writeStandardOutputLine Result Void ConsoleWriteError
effect writeStandardOutputLine write console.stdout
useCapability writeStandardOutputLine consoleStdoutWriteCapability
memory writeStandardOutputLine heap no
memoryStackLimit writeStandardOutputLine 1KiB
async writeStandardOutputLine no

purpose operation writeStandardOutputLine "Emit one newline-terminated text line to standard output via console.writeLine and surface a typed ConsoleWriteError on driver failure"
invariant operation writeStandardOutputLine "The single console.writeLine call is the only path that can produce stdout from this operation"
guarantee writeStandardOutputLine "On success the entire text plus a single newline byte is written exactly once"

# group writeStandardOutputLineHelperBody
label startWriteStandardOutputLine

call writeStandardOutputLineConsoleWriteCall console.writeLine
argument writeStandardOutputLineConsoleWriteCall console Console console
argument writeStandardOutputLineConsoleWriteCall text String text
run writeStandardOutputLineConsoleWriteCall
ignore void source writeStandardOutputLineConsoleWriteCall
bind error writeStandardOutputLineConsoleWriteError ConsoleWriteError writeStandardOutputLineConsoleWriteCall
branch error source writeStandardOutputLineConsoleWriteCall target writeStandardOutputLineConsoleWriteFailed

storage local immutable writeStandardOutputLineSuccessSentinel ExitCode 0
return ok writeStandardOutputLineSuccessSentinel

label writeStandardOutputLineConsoleWriteFailed
return error writeStandardOutputLineConsoleWriteError
# endGroup writeStandardOutputLineHelperBody

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
useCapability main consoleStdoutWriteCapability
memory main heap no
memoryStackLimit main 4KiB
async main no

purpose operation main "Print the JavaScript this-binding surprises from javascript/counterintuitive-this-binding.js"
invariant operation main "Detached method invocation reports TypeError; arrow functions ignore explicit .call"

label startMain

storage local immutable thisBindingTitleText String "Counterintuitive This Binding"
storage local immutable thisBindingTitleUnderlineText String "============================="
storage local immutable thisBindingCounterReadText String "counter.readCount() => 3"
storage local immutable thisBindingDetachedTypeErrorText String "detachedReadCount() => TypeError"
storage local immutable thisBindingBoundReadText String "boundReadCount() => 3"
storage local immutable thisBindingOtherReadText String "otherCounter.readCount() => 99"
storage local immutable thisBindingArrowCallText String "arrowReadCount.call({ count: 42 }) => 3"

storage local mutable lastConsoleWriteErrorCode ConsoleWriteErrorCode 0

call writeThisBindingTitleLineCall writeStandardOutputLine
argument writeThisBindingTitleLineCall text String thisBindingTitleText
run writeThisBindingTitleLineCall
ignore void source writeThisBindingTitleLineCall
bind error writeThisBindingTitleLineError ConsoleWriteError writeThisBindingTitleLineCall
set memory lastConsoleWriteErrorCode writeThisBindingTitleLineError
branch error source writeThisBindingTitleLineCall target consoleWriteFailed

call writeThisBindingTitleUnderlineLineCall writeStandardOutputLine
argument writeThisBindingTitleUnderlineLineCall text String thisBindingTitleUnderlineText
run writeThisBindingTitleUnderlineLineCall
ignore void source writeThisBindingTitleUnderlineLineCall
bind error writeThisBindingTitleUnderlineLineError ConsoleWriteError writeThisBindingTitleUnderlineLineCall
set memory lastConsoleWriteErrorCode writeThisBindingTitleUnderlineLineError
branch error source writeThisBindingTitleUnderlineLineCall target consoleWriteFailed

call writeThisBindingCounterReadLineCall writeStandardOutputLine
argument writeThisBindingCounterReadLineCall text String thisBindingCounterReadText
run writeThisBindingCounterReadLineCall
ignore void source writeThisBindingCounterReadLineCall
bind error writeThisBindingCounterReadLineError ConsoleWriteError writeThisBindingCounterReadLineCall
set memory lastConsoleWriteErrorCode writeThisBindingCounterReadLineError
branch error source writeThisBindingCounterReadLineCall target consoleWriteFailed

call writeThisBindingDetachedTypeErrorLineCall writeStandardOutputLine
argument writeThisBindingDetachedTypeErrorLineCall text String thisBindingDetachedTypeErrorText
run writeThisBindingDetachedTypeErrorLineCall
ignore void source writeThisBindingDetachedTypeErrorLineCall
bind error writeThisBindingDetachedTypeLineError ConsoleWriteError writeThisBindingDetachedTypeErrorLineCall
set memory lastConsoleWriteErrorCode writeThisBindingDetachedTypeLineError
branch error source writeThisBindingDetachedTypeErrorLineCall target consoleWriteFailed

call writeThisBindingBoundReadLineCall writeStandardOutputLine
argument writeThisBindingBoundReadLineCall text String thisBindingBoundReadText
run writeThisBindingBoundReadLineCall
ignore void source writeThisBindingBoundReadLineCall
bind error writeThisBindingBoundReadLineError ConsoleWriteError writeThisBindingBoundReadLineCall
set memory lastConsoleWriteErrorCode writeThisBindingBoundReadLineError
branch error source writeThisBindingBoundReadLineCall target consoleWriteFailed

call writeThisBindingOtherReadLineCall writeStandardOutputLine
argument writeThisBindingOtherReadLineCall text String thisBindingOtherReadText
run writeThisBindingOtherReadLineCall
ignore void source writeThisBindingOtherReadLineCall
bind error writeThisBindingOtherReadLineError ConsoleWriteError writeThisBindingOtherReadLineCall
set memory lastConsoleWriteErrorCode writeThisBindingOtherReadLineError
branch error source writeThisBindingOtherReadLineCall target consoleWriteFailed

call writeThisBindingArrowCallLineCall writeStandardOutputLine
argument writeThisBindingArrowCallLineCall text String thisBindingArrowCallText
run writeThisBindingArrowCallLineCall
ignore void source writeThisBindingArrowCallLineCall
bind error writeThisBindingArrowCallLineError ConsoleWriteError writeThisBindingArrowCallLineCall
set memory lastConsoleWriteErrorCode writeThisBindingArrowCallLineError
branch error source writeThisBindingArrowCallLineCall target consoleWriteFailed

storage local immutable successfulExitCode ExitCode 0
return ok successfulExitCode

label consoleWriteFailed
# rationale: lastConsoleWriteErrorCode holds whichever emit actually failed; its `set`
# ran immediately before the corresponding branchIfError, so the typed
# MainError.ConsoleWriteFailed value honestly names its cause (Â§12).
makeError consoleWriteFailure MainError.ConsoleWriteFailed lastConsoleWriteErrorCode
return error consoleWriteFailure
