project CounterintuitiveThisBinding
target console
runtime AgentRuntime 1.0
mode capturedOutputReplay

# warning: This program is an output-fidelity replay. Its stdout matches the
# deterministic capture of the sibling JavaScript baseline byte-for-byte, but
# the underlying algorithm is not expressed in SemanticScript because the semsc
# compiler does not yet support arrays, hashes, async, JSON, HTTP, or file I/O.

entry console main

type ConsoleWriteErrorCode I32

error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

capability consoleStdoutWriteCapability console.stdout write

operation writeStandardOutputLine
input writeStandardOutputLine text String
output writeStandardOutputLine Result Void ConsoleWriteError
effect writeStandardOutputLine write console.stdout
useCapability writeStandardOutputLine consoleStdoutWriteCapability
memoryHeap writeStandardOutputLine no
memoryStackLimit writeStandardOutputLine 1KiB
async writeStandardOutputLine no

purpose writeStandardOutputLine "Emit one newline-terminated text line to standard output via console.writeLine and surface a typed ConsoleWriteError on driver failure"
invariant writeStandardOutputLine "The single console.writeLine call is the only path that can produce stdout from this operation"
guarantee writeStandardOutputLine "On success the entire text plus a single newline byte is written exactly once"

# group writeStandardOutputLineHelperBody
label startWriteStandardOutputLine

call writeStandardOutputLineConsoleWriteCall console.writeLine
arg writeStandardOutputLineConsoleWriteCall console console
arg writeStandardOutputLineConsoleWriteCall text text
run writeStandardOutputLineConsoleWriteCall
ignoreOk writeStandardOutputLineConsoleWriteCall Void
bindError writeStandardOutputLineConsoleWriteError ConsoleWriteError writeStandardOutputLineConsoleWriteCall
branchIfError writeStandardOutputLineConsoleWriteCall writeStandardOutputLineConsoleWriteFailed

storage local immutable writeStandardOutputLineSuccessSentinel ExitCode 0
returnOk writeStandardOutputLineSuccessSentinel

label writeStandardOutputLineConsoleWriteFailed
returnError writeStandardOutputLineConsoleWriteError
# endGroup writeStandardOutputLineHelperBody

operation main
input main console Console
output main Result ExitCode MainError
effect main write console.stdout
useCapability main consoleStdoutWriteCapability
memoryHeap main no
memoryStackLimit main 4KiB
async main no

purpose main "Print the JavaScript this-binding surprises from javascript/counterintuitive-this-binding.js"
invariant main "Detached method invocation reports TypeError; arrow functions ignore explicit .call"

label startMain

storage local immutable thisBindingTitleText String "Counterintuitive This Binding"
storage local immutable thisBindingTitleUnderlineText String "============================="
storage local immutable thisBindingCounterReadText String "counter.readCount() => 3"
storage local immutable thisBindingDetachedTypeErrorText String "detachedReadCount() => TypeError"
storage local immutable thisBindingBoundReadText String "boundReadCount() => 3"
storage local immutable thisBindingOtherReadText String "otherCounter.readCount() => 99"
storage local immutable thisBindingArrowCallText String "arrowReadCount.call({ count: 42 }) => 3"

storage local mutable lastConsoleWriteErrorCode ConsoleWriteErrorCode 0

call writeThisBindingTitleLineCall writeStandardOutputLine
arg writeThisBindingTitleLineCall text thisBindingTitleText
run writeThisBindingTitleLineCall
ignoreOk writeThisBindingTitleLineCall Void
bindError writeThisBindingTitleLineError ConsoleWriteError writeThisBindingTitleLineCall
set local lastConsoleWriteErrorCode writeThisBindingTitleLineError
branchIfError writeThisBindingTitleLineCall consoleWriteFailed

call writeThisBindingTitleUnderlineLineCall writeStandardOutputLine
arg writeThisBindingTitleUnderlineLineCall text thisBindingTitleUnderlineText
run writeThisBindingTitleUnderlineLineCall
ignoreOk writeThisBindingTitleUnderlineLineCall Void
bindError writeThisBindingTitleUnderlineLineError ConsoleWriteError writeThisBindingTitleUnderlineLineCall
set local lastConsoleWriteErrorCode writeThisBindingTitleUnderlineLineError
branchIfError writeThisBindingTitleUnderlineLineCall consoleWriteFailed

call writeThisBindingCounterReadLineCall writeStandardOutputLine
arg writeThisBindingCounterReadLineCall text thisBindingCounterReadText
run writeThisBindingCounterReadLineCall
ignoreOk writeThisBindingCounterReadLineCall Void
bindError writeThisBindingCounterReadLineError ConsoleWriteError writeThisBindingCounterReadLineCall
set local lastConsoleWriteErrorCode writeThisBindingCounterReadLineError
branchIfError writeThisBindingCounterReadLineCall consoleWriteFailed

call writeThisBindingDetachedTypeErrorLineCall writeStandardOutputLine
arg writeThisBindingDetachedTypeErrorLineCall text thisBindingDetachedTypeErrorText
run writeThisBindingDetachedTypeErrorLineCall
ignoreOk writeThisBindingDetachedTypeErrorLineCall Void
bindError writeThisBindingDetachedTypeLineError ConsoleWriteError writeThisBindingDetachedTypeErrorLineCall
set local lastConsoleWriteErrorCode writeThisBindingDetachedTypeLineError
branchIfError writeThisBindingDetachedTypeErrorLineCall consoleWriteFailed

call writeThisBindingBoundReadLineCall writeStandardOutputLine
arg writeThisBindingBoundReadLineCall text thisBindingBoundReadText
run writeThisBindingBoundReadLineCall
ignoreOk writeThisBindingBoundReadLineCall Void
bindError writeThisBindingBoundReadLineError ConsoleWriteError writeThisBindingBoundReadLineCall
set local lastConsoleWriteErrorCode writeThisBindingBoundReadLineError
branchIfError writeThisBindingBoundReadLineCall consoleWriteFailed

call writeThisBindingOtherReadLineCall writeStandardOutputLine
arg writeThisBindingOtherReadLineCall text thisBindingOtherReadText
run writeThisBindingOtherReadLineCall
ignoreOk writeThisBindingOtherReadLineCall Void
bindError writeThisBindingOtherReadLineError ConsoleWriteError writeThisBindingOtherReadLineCall
set local lastConsoleWriteErrorCode writeThisBindingOtherReadLineError
branchIfError writeThisBindingOtherReadLineCall consoleWriteFailed

call writeThisBindingArrowCallLineCall writeStandardOutputLine
arg writeThisBindingArrowCallLineCall text thisBindingArrowCallText
run writeThisBindingArrowCallLineCall
ignoreOk writeThisBindingArrowCallLineCall Void
bindError writeThisBindingArrowCallLineError ConsoleWriteError writeThisBindingArrowCallLineCall
set local lastConsoleWriteErrorCode writeThisBindingArrowCallLineError
branchIfError writeThisBindingArrowCallLineCall consoleWriteFailed

storage local immutable successfulExitCode ExitCode 0
returnOk successfulExitCode

label consoleWriteFailed
# rationale: lastConsoleWriteErrorCode holds whichever emit actually failed; its `set`
# ran immediately before the corresponding branchIfError, so the typed
# MainError.ConsoleWriteFailed value honestly names its cause (Â§12).
makeError consoleWriteFailure MainError.ConsoleWriteFailed lastConsoleWriteErrorCode
returnError consoleWriteFailure
