call bytesEmptyContainsCall bytes.contains
argument bytesEmptyContainsCall byteBuffer OpaquePointer helloLiteral
argument bytesEmptyContainsCall byteCount ByteCount zeroByteCount
argument bytesEmptyContainsCall targetValue Int32 lowercaseLCode
run bytesEmptyContainsCall
bind value bytesEmptyContainsResult Bool bytesEmptyContainsCall
branch if condition bytesEmptyContainsResult target smokeAssertionFailed

call highByteAllocCall c.malloc
argument highByteAllocCall size ByteCount expectedTwoMatches
run highByteAllocCall
bind value highByteBuffer OpaquePointer highByteAllocCall
bind error highByteAllocError Int32 highByteAllocCall
branch error source highByteAllocCall target heapAllocationFailedHandler
defer releaseHighByteAllocCall c.free highByteBuffer
storage module immutable offsetZero ByteCount 0
storage module immutable highByteValue Int64 200
storage module immutable highByteTarget Int32 200
storage module immutable oneByteCount ByteCount 1
call storeHighByteCall pointer.storeByte
argument storeHighByteCall buffer OpaquePointer highByteBuffer
argument storeHighByteCall offset ByteCount offsetZero
argument storeHighByteCall value Int64 highByteValue
run storeHighByteCall
call highByteContainsCall bytes.contains
argument highByteContainsCall byteBuffer OpaquePointer highByteBuffer
argument highByteContainsCall byteCount ByteCount oneByteCount
