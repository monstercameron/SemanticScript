branch if condition octalByteBelowRange target octalParseDone
call detectOctalByteAboveRangeCall math.greaterThanInt64
argument detectOctalByteAboveRangeCall left Int64 currentOctalByte
argument detectOctalByteAboveRangeCall right Int64 asciiDigitSevenByte
run detectOctalByteAboveRangeCall
bind value octalByteAboveRange Bool detectOctalByteAboveRangeCall
branch if condition octalByteAboveRange target octalParseDone
call computeOctalDigitValueCall math.subtractInt64
argument computeOctalDigitValueCall left Int64 currentOctalByte
argument computeOctalDigitValueCall right Int64 asciiDigitZeroByte
run computeOctalDigitValueCall
bind value currentOctalDigitValue Int64 computeOctalDigitValueCall
call shiftAccumulatorForOctalCall math.multiplyInt64
argument shiftAccumulatorForOctalCall left Int64 octalAccumulator
