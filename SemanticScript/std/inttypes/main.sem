# SemanticScript standard-library canonical module: standard.inttypes.

module standard.inttypes
purpose module standard.inttypes "Canonical standard-library module for inttypes-style parsing and formatting helpers."
moduleOwns standard.inttypes "The official import path `standard.inttypes` and this module's implementation body."
moduleDoesNotOwn standard.inttypes "App-specific wrappers, compatibility aliases, or generated build artifacts."
invariant module standard.inttypes "The standard module entry is this file; tests live beside it as `main.test.sem`."

exportConstant standard.inttypes inttypesModuleVersionText
storage module immutable inttypesModuleVersionText CNullTerminatedByteString "standard.inttypes 0.1"

# Canonical standard-library implementation body.
# ============================================================
# SEMANTICSCRIPT STANDARD LIBRARY: <inttypes.h>-style helpers
# ============================================================
#
# rationale: C's <inttypes.h> provides intmax_t arithmetic helpers
#   (imaxabs, imaxdiv) plus base-2 / base-8 parsing utilities. The
#   pre-refined version returned `Result CSignedInt64 Void` from
#   every operation, hiding real fallibility (division by zero) and
#   real partiality (parsing). The refined surface separates the
#   total ops (abs) from the fallible ones (divide-by-zero), and
#   keeps the parsers total â€” they stop scanning at the first
#   non-matching byte and return whatever has accumulated so far.
#
# invariant: integer arithmetic is two's-complement; division
#   rounds toward zero (LLVM's sdiv); modulo carries the sign of
#   the dividend (LLVM's srem).
#
# security: parsers walk a null-terminated input byte by byte and
#   stop at the first byte outside the digit set OR the NUL
#   terminator (byte == 0 stops because '0' is byte 48, not 0).
#   No bounds check needed; the NUL terminator is the boundary.
#
# timing: arithmetic ops are O(1); parsers are O(byteLength).
#
# observability: no logs; parsers do not signal "junk after the
#   digits were consumed" â€” that contract belongs to a stricter
#   variant in stdlib.sscript.

# Pure-module file: smoke + extended tests live in
# std/inttypes/main.test.sem.

# Typed error domain for integer arithmetic. SemanticScript-style errors
# replace the previous "negative return = failure" C convention. The
# only currently-detected failure is divide-by-zero â€” overflow is not
# detected here because LLVM's sdiv/srem wrap silently and we accept
# that as the documented behavior in the operation warnings below.
error IntegerArithmeticError
errorCase IntegerArithmeticError DivisionByZeroAttempted

domainLiteral integerZeroComparisonValue CSignedInt64 0
domainLiteralTrust integerZeroComparisonValue trustedStaticLiteral
domainLiteral integerNegativeOneMultiplier CSignedInt64 -1
domainLiteralTrust integerNegativeOneMultiplier trustedStaticLiteral
domainLiteral asciiDigitZeroByte CSignedInt64 48
domainLiteralTrust asciiDigitZeroByte trustedStaticLiteral
domainLiteral asciiDigitOneByte CSignedInt64 49
domainLiteralTrust asciiDigitOneByte trustedStaticLiteral
domainLiteral asciiDigitSevenByte CSignedInt64 55
domainLiteralTrust asciiDigitSevenByte trustedStaticLiteral
domainLiteral binaryBase CSignedInt64 2
domainLiteralTrust binaryBase trustedStaticLiteral
domainLiteral octalBase CSignedInt64 8
domainLiteralTrust octalBase trustedStaticLiteral
domainLiteral integerOneStep CSignedInt64 1
domainLiteralTrust integerOneStep trustedStaticLiteral

# section inttypes.absoluteValue

operation absoluteMaxWidthSignedInt
input operation absoluteMaxWidthSignedInt inputValue CSignedInt64
output operation absoluteMaxWidthSignedInt CSignedInt64
memory absoluteMaxWidthSignedInt heap no
async absoluteMaxWidthSignedInt no
purpose operation absoluteMaxWidthSignedInt "Returns |inputValue| over the CSignedInt64 domain."
invariant operation absoluteMaxWidthSignedInt "Non-negative result for every input except INT64_MIN."
warning absoluteMaxWidthSignedInt "INT64_MIN negated overflows back to INT64_MIN (no positive representation exists in two's complement)."
guarantee absoluteMaxWidthSignedInt "Total â€” every input produces some CSignedInt64 result."
label startAbsoluteMaxWidthSignedInt
call detectInputIsNegativeCall math.lessThanI64
argument detectInputIsNegativeCall left I64 inputValue
argument detectInputIsNegativeCall right I64 integerZeroComparisonValue
run detectInputIsNegativeCall
bind value inputIsNegative Bool detectInputIsNegativeCall
branch if condition inputIsNegative target negateInputForAbsoluteValue
return value inputValue
label negateInputForAbsoluteValue
call multiplyByNegativeOneCall math.multiplyI64
argument multiplyByNegativeOneCall left I64 inputValue
argument multiplyByNegativeOneCall right I64 integerNegativeOneMultiplier
run multiplyByNegativeOneCall
bind value negatedAbsoluteValue CSignedInt64 multiplyByNegativeOneCall
return value negatedAbsoluteValue

# section inttypes.division

operation divideMaxWidthSignedIntQuotient
input operation divideMaxWidthSignedIntQuotient dividendValue CSignedInt64
input operation divideMaxWidthSignedIntQuotient divisorValue CSignedInt64
output operation divideMaxWidthSignedIntQuotient Result CSignedInt64 IntegerArithmeticError
memory divideMaxWidthSignedIntQuotient heap no
async divideMaxWidthSignedIntQuotient no
purpose operation divideMaxWidthSignedIntQuotient "Integer quotient dividendValue / divisorValue, rounded toward zero. Fails when divisorValue is zero."
invariant operation divideMaxWidthSignedIntQuotient "Quotient sign is dividend sign XOR divisor sign."
failure divideMaxWidthSignedIntQuotient DivisionByZeroAttempted "Returned when divisorValue equals zero â€” caller must screen first."
guarantee divideMaxWidthSignedIntQuotient "Defined for every (dividendValue, nonZeroDivisorValue) input pair."
label startDivideMaxWidthSignedIntQuotient
call detectDivisorIsZeroCall math.equalI64
argument detectDivisorIsZeroCall left I64 divisorValue
argument detectDivisorIsZeroCall right I64 integerZeroComparisonValue
run detectDivisorIsZeroCall
bind value divisorIsZero Bool detectDivisorIsZeroCall
branch if condition divisorIsZero target raiseDivisionByZeroForQuotient
call computeSignedQuotientCall math.divideI64
argument computeSignedQuotientCall left I64 dividendValue
argument computeSignedQuotientCall right I64 divisorValue
run computeSignedQuotientCall
bind value computedQuotient CSignedInt64 computeSignedQuotientCall
return ok computedQuotient
label raiseDivisionByZeroForQuotient
makeError quotientDivisionByZeroFailure IntegerArithmeticError.DivisionByZeroAttempted
return error quotientDivisionByZeroFailure

operation divideMaxWidthSignedIntRemainder
input operation divideMaxWidthSignedIntRemainder dividendValue CSignedInt64
input operation divideMaxWidthSignedIntRemainder divisorValue CSignedInt64
output operation divideMaxWidthSignedIntRemainder Result CSignedInt64 IntegerArithmeticError
memory divideMaxWidthSignedIntRemainder heap no
async divideMaxWidthSignedIntRemainder no
purpose operation divideMaxWidthSignedIntRemainder "Integer remainder dividendValue % divisorValue. Fails when divisorValue is zero."
invariant operation divideMaxWidthSignedIntRemainder "Remainder sign carries the dividend sign (LLVM srem semantics)."
failure divideMaxWidthSignedIntRemainder DivisionByZeroAttempted "Returned when divisorValue equals zero."
guarantee divideMaxWidthSignedIntRemainder "Defined for every (dividendValue, nonZeroDivisorValue) input pair."
label startDivideMaxWidthSignedIntRemainder
call detectDivisorIsZeroForRemainderCall math.equalI64
argument detectDivisorIsZeroForRemainderCall left I64 divisorValue
argument detectDivisorIsZeroForRemainderCall right I64 integerZeroComparisonValue
run detectDivisorIsZeroForRemainderCall
bind value divisorIsZeroForRemainder Bool detectDivisorIsZeroForRemainderCall
branch if condition divisorIsZeroForRemainder target raiseDivisionByZeroForRemainder
call computeSignedRemainderCall math.moduloI64
argument computeSignedRemainderCall left I64 dividendValue
argument computeSignedRemainderCall right I64 divisorValue
run computeSignedRemainderCall
bind value computedRemainder CSignedInt64 computeSignedRemainderCall
return ok computedRemainder
label raiseDivisionByZeroForRemainder
makeError remainderDivisionByZeroFailure IntegerArithmeticError.DivisionByZeroAttempted
return error remainderDivisionByZeroFailure

# section inttypes.parsers

operation parsePositiveBinaryCStringToSignedInt64
input operation parsePositiveBinaryCStringToSignedInt64 inputText CNullTerminatedByteString
output operation parsePositiveBinaryCStringToSignedInt64 CSignedInt64
memory parsePositiveBinaryCStringToSignedInt64 heap no
async parsePositiveBinaryCStringToSignedInt64 no
purpose operation parsePositiveBinaryCStringToSignedInt64 "Parse a null-terminated C string of '0' / '1' bytes as an unsigned base-2 integer. Stops at the first byte that is neither '0' nor '1' and returns the partial accumulator."
invariant operation parsePositiveBinaryCStringToSignedInt64 "Empty or junk inputs return 0; otherwise the prefix of valid binary digits is consumed left-to-right."
warning parsePositiveBinaryCStringToSignedInt64 "No overflow detection â€” inputs longer than 63 binary digits silently wrap around CSignedInt64."
guarantee parsePositiveBinaryCStringToSignedInt64 "Total (no error path); always terminates at the NUL terminator or first invalid byte."
label startParsePositiveBinaryCStringToSignedInt64
memory parsePositiveBinaryCStringToSignedInt64 mutable binaryAccumulator I64 0
memory parsePositiveBinaryCStringToSignedInt64 mutable binaryByteCursor I64 0
label binaryParseLoop
call loadBinaryByteCall pointer.loadByte
argument loadBinaryByteCall buffer COpaqueMemoryAddress inputText
argument loadBinaryByteCall offset CByteCount binaryByteCursor
run loadBinaryByteCall
bind value currentBinaryByte I8 loadBinaryByteCall
call detectBinaryByteIsZeroCall math.equalI64
argument detectBinaryByteIsZeroCall left I64 currentBinaryByte
argument detectBinaryByteIsZeroCall right I64 asciiDigitZeroByte
run detectBinaryByteIsZeroCall
bind value binaryByteIsZeroChar Bool detectBinaryByteIsZeroCall
branch if condition binaryByteIsZeroChar target shiftAccumulatorForZeroBit
call detectBinaryByteIsOneCall math.equalI64
argument detectBinaryByteIsOneCall left I64 currentBinaryByte
argument detectBinaryByteIsOneCall right I64 asciiDigitOneByte
run detectBinaryByteIsOneCall
bind value binaryByteIsOneChar Bool detectBinaryByteIsOneCall
branch if condition binaryByteIsOneChar target shiftAccumulatorForOneBit
branch else target binaryParseDone
label shiftAccumulatorForZeroBit
call doubleAccumulatorForZeroCall math.multiplyI64
argument doubleAccumulatorForZeroCall left I64 binaryAccumulator
argument doubleAccumulatorForZeroCall right I64 binaryBase
run doubleAccumulatorForZeroCall
bind value accumulatorAfterZeroBit I64 doubleAccumulatorForZeroCall
set memory binaryAccumulator accumulatorAfterZeroBit
jump target advanceBinaryCursor
label shiftAccumulatorForOneBit
call doubleAccumulatorForOneCall math.multiplyI64
argument doubleAccumulatorForOneCall left I64 binaryAccumulator
argument doubleAccumulatorForOneCall right I64 binaryBase
run doubleAccumulatorForOneCall
bind value shiftedAccumulatorForOneBit I64 doubleAccumulatorForOneCall
call addOneBitCall math.addI64
argument addOneBitCall left I64 shiftedAccumulatorForOneBit
argument addOneBitCall right I64 integerOneStep
run addOneBitCall
bind value accumulatorAfterOneBit I64 addOneBitCall
set memory binaryAccumulator accumulatorAfterOneBit
jump target advanceBinaryCursor
label advanceBinaryCursor
call advanceBinaryCursorCall math.addI64
argument advanceBinaryCursorCall left I64 binaryByteCursor
argument advanceBinaryCursorCall right I64 integerOneStep
run advanceBinaryCursorCall
bind value nextBinaryCursorPosition I64 advanceBinaryCursorCall
set memory binaryByteCursor nextBinaryCursorPosition
jump target binaryParseLoop
label binaryParseDone
return value binaryAccumulator

operation parsePositiveOctalCStringToSignedInt64
input operation parsePositiveOctalCStringToSignedInt64 inputText CNullTerminatedByteString
output operation parsePositiveOctalCStringToSignedInt64 CSignedInt64
memory parsePositiveOctalCStringToSignedInt64 heap no
async parsePositiveOctalCStringToSignedInt64 no
purpose operation parsePositiveOctalCStringToSignedInt64 "Parse a null-terminated C string of '0'..'7' bytes as an unsigned base-8 integer. Stops at the first byte outside that range."
invariant operation parsePositiveOctalCStringToSignedInt64 "Empty or junk inputs return 0; otherwise the prefix of valid octal digits is consumed left-to-right."
warning parsePositiveOctalCStringToSignedInt64 "No overflow detection â€” inputs longer than 21 octal digits silently wrap around CSignedInt64."
guarantee parsePositiveOctalCStringToSignedInt64 "Total."
label startParsePositiveOctalCStringToSignedInt64
memory parsePositiveOctalCStringToSignedInt64 mutable octalAccumulator I64 0
memory parsePositiveOctalCStringToSignedInt64 mutable octalByteCursor I64 0
label octalParseLoop
call loadOctalByteCall pointer.loadByte
argument loadOctalByteCall buffer COpaqueMemoryAddress inputText
argument loadOctalByteCall offset CByteCount octalByteCursor
run loadOctalByteCall
bind value currentOctalByte I8 loadOctalByteCall
call detectOctalByteBelowRangeCall math.lessThanI64
argument detectOctalByteBelowRangeCall left I64 currentOctalByte
argument detectOctalByteBelowRangeCall right I64 asciiDigitZeroByte
run detectOctalByteBelowRangeCall
bind value octalByteBelowRange Bool detectOctalByteBelowRangeCall
branch if condition octalByteBelowRange target octalParseDone
call detectOctalByteAboveRangeCall math.greaterThanI64
argument detectOctalByteAboveRangeCall left I64 currentOctalByte
argument detectOctalByteAboveRangeCall right I64 asciiDigitSevenByte
run detectOctalByteAboveRangeCall
bind value octalByteAboveRange Bool detectOctalByteAboveRangeCall
branch if condition octalByteAboveRange target octalParseDone
call computeOctalDigitValueCall math.subtractI64
argument computeOctalDigitValueCall left I64 currentOctalByte
argument computeOctalDigitValueCall right I64 asciiDigitZeroByte
run computeOctalDigitValueCall
bind value currentOctalDigitValue I64 computeOctalDigitValueCall
call shiftAccumulatorForOctalCall math.multiplyI64
argument shiftAccumulatorForOctalCall left I64 octalAccumulator
argument shiftAccumulatorForOctalCall right I64 octalBase
run shiftAccumulatorForOctalCall
bind value shiftedOctalAccumulator I64 shiftAccumulatorForOctalCall
call addOctalDigitCall math.addI64
argument addOctalDigitCall left I64 shiftedOctalAccumulator
argument addOctalDigitCall right I64 currentOctalDigitValue
run addOctalDigitCall
bind value octalAccumulatorAfterDigit I64 addOctalDigitCall
set memory octalAccumulator octalAccumulatorAfterDigit
call advanceOctalCursorCall math.addI64
argument advanceOctalCursorCall left I64 octalByteCursor
argument advanceOctalCursorCall right I64 integerOneStep
run advanceOctalCursorCall
bind value nextOctalCursorPosition I64 advanceOctalCursorCall
set memory octalByteCursor nextOctalCursorPosition
jump target octalParseLoop
label octalParseDone
return value octalAccumulator

