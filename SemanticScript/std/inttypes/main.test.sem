# ============================================================
# SEMANTICSCRIPT STDLIB TESTS: inttypes
# ============================================================
#
# Companion smoke + extended unit tests for std/inttypes/main.sem.
# Imports the inttypes module and asserts each helper (abs / div
# quotient / div remainder / parse binary / parse octal) plus the
# Euclidean property qÂ·d + r == n.
#
# Pattern: std/main.sem ships pure-module operations only;
# std/main.test.sem carries every smoke / unit test for it.

project StdInttypesTest
target console
runtime AgentRuntime 0.1
entry console main

import inttypes standard.inttypes
error MainError
errorCase MainError InttypesSmokeAssertionFailed
errorCase MainError ConsoleWriteFailed

# section capability
# rationale: smoke-test main writes a single OK line to stdout.
capability stdoutWriteCapability console.stdout write

# ============================================================
# Smoke test
# ============================================================

operation main
input operation main console Console
output operation main Result ExitCode MainError
useCapability main stdoutWriteCapability
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Smoke-test the inttypes helpers end-to-end."
invariant operation main "All assertions hold or the failure path runs."

label startMain

# absoluteMaxWidthSignedInt(-7) == 7
storage module immutable negativeSevenValue CSignedInt64 -7
call assertAbsCall absoluteMaxWidthSignedInt
argument assertAbsCall inputValue CSignedInt64 negativeSevenValue
run assertAbsCall
bind value absResult CSignedInt64 assertAbsCall
storage module immutable sevenValue CSignedInt64 7
call checkAbsCall math.equalI64
argument checkAbsCall left I64 absResult
argument checkAbsCall right I64 sevenValue
run checkAbsCall
bind value absOk Bool checkAbsCall
branch if condition absOk target absHolds
branch else target smokeAssertionFailed
label absHolds

# parsePositiveBinaryCStringToSignedInt64("1101") == 13
storage module immutable binaryThirteenText CNullTerminatedByteString "1101"
call assertParseBinaryCall parsePositiveBinaryCStringToSignedInt64
argument assertParseBinaryCall inputText CNullTerminatedByteString binaryThirteenText
run assertParseBinaryCall
bind value parseBinaryResult CSignedInt64 assertParseBinaryCall
storage module immutable thirteenValue CSignedInt64 13
call checkParseBinaryCall math.equalI64
argument checkParseBinaryCall left I64 parseBinaryResult
argument checkParseBinaryCall right I64 thirteenValue
run checkParseBinaryCall
bind value parseBinaryOk Bool checkParseBinaryCall
branch if condition parseBinaryOk target parseBinaryHolds
branch else target smokeAssertionFailed
label parseBinaryHolds

# parsePositiveOctalCStringToSignedInt64("755") == 493
storage module immutable octal755Text CNullTerminatedByteString "755"
call assertParseOctalCall parsePositiveOctalCStringToSignedInt64
argument assertParseOctalCall inputText CNullTerminatedByteString octal755Text
run assertParseOctalCall
bind value parseOctalResult CSignedInt64 assertParseOctalCall
storage module immutable fourNinetyThreeValue CSignedInt64 493
call checkParseOctalCall math.equalI64
argument checkParseOctalCall left I64 parseOctalResult
argument checkParseOctalCall right I64 fourNinetyThreeValue
run checkParseOctalCall
bind value parseOctalOk Bool checkParseOctalCall
branch if condition parseOctalOk target parseOctalHolds
branch else target smokeAssertionFailed
label parseOctalHolds

# ============================================================
# Extended unit tests: covers the 2 ops the smoke previously
# omitted (divideMaxWidthSignedIntQuotient + Remainder).
# ============================================================

storage module immutable numeratorTwentyThree CSignedInt64 23
storage module immutable denominatorFour CSignedInt64 4
storage module immutable expectedQuotientFive CSignedInt64 5
storage module immutable expectedRemainderThree CSignedInt64 3

# divideMaxWidthSignedIntQuotient(23, 4) == 5
call divQuotientCall divideMaxWidthSignedIntQuotient
argument divQuotientCall numeratorValue CSignedInt64 numeratorTwentyThree
argument divQuotientCall denominatorValue CSignedInt64 denominatorFour
run divQuotientCall
bind ok divQuotientResult CSignedInt64 divQuotientCall
call checkDivQuotientCall math.equalI64
argument checkDivQuotientCall left I64 divQuotientResult
argument checkDivQuotientCall right I64 expectedQuotientFive
run checkDivQuotientCall
bind value divQuotientOk Bool checkDivQuotientCall
branch if condition divQuotientOk target divQuotientHolds
branch else target smokeAssertionFailed
label divQuotientHolds

# divideMaxWidthSignedIntRemainder(23, 4) == 3
call divRemainderCall divideMaxWidthSignedIntRemainder
argument divRemainderCall numeratorValue CSignedInt64 numeratorTwentyThree
argument divRemainderCall denominatorValue CSignedInt64 denominatorFour
run divRemainderCall
bind ok divRemainderResult CSignedInt64 divRemainderCall
call checkDivRemainderCall math.equalI64
argument checkDivRemainderCall left I64 divRemainderResult
argument checkDivRemainderCall right I64 expectedRemainderThree
run checkDivRemainderCall
bind value divRemainderOk Bool checkDivRemainderCall
branch if condition divRemainderOk target divRemainderHolds
branch else target smokeAssertionFailed
label divRemainderHolds

# Property: quotient * denominator + remainder == numerator
# (5 * 4 + 3 == 23)
call propMulCall math.multiplyI64
argument propMulCall left I64 divQuotientResult
argument propMulCall right I64 denominatorFour
run propMulCall
bind value propMulResult CSignedInt64 propMulCall
call propAddCall math.addI64
argument propAddCall left I64 propMulResult
argument propAddCall right I64 divRemainderResult
run propAddCall
bind value propAddResult CSignedInt64 propAddCall
call propCheckCall math.equalI64
argument propCheckCall left I64 propAddResult
argument propCheckCall right I64 numeratorTwentyThree
run propCheckCall
bind value propCheckOk Bool propCheckCall
branch if condition propCheckOk target propCheckHolds
branch else target smokeAssertionFailed
label propCheckHolds

# divideMaxWidthSignedIntQuotient(0, 5) == 0 (zero dividend)
storage module immutable zeroNumerator CSignedInt64 0
storage module immutable fiveDenominator CSignedInt64 5
call divZeroQuotientCall divideMaxWidthSignedIntQuotient
argument divZeroQuotientCall numeratorValue CSignedInt64 zeroNumerator
argument divZeroQuotientCall denominatorValue CSignedInt64 fiveDenominator
run divZeroQuotientCall
bind ok divZeroQuotientResult CSignedInt64 divZeroQuotientCall
call checkDivZeroQuotientCall math.equalI64
argument checkDivZeroQuotientCall left I64 divZeroQuotientResult
argument checkDivZeroQuotientCall right I64 zeroNumerator
run checkDivZeroQuotientCall
bind value divZeroQuotientOk Bool checkDivZeroQuotientCall
branch if condition divZeroQuotientOk target divZeroQuotientHolds
branch else target smokeAssertionFailed
label divZeroQuotientHolds

# parsePositiveBinaryCStringToSignedInt64("0") == 0 (boundary)
storage module immutable binaryZeroText CNullTerminatedByteString "0"
call parseZeroBinaryCall parsePositiveBinaryCStringToSignedInt64
argument parseZeroBinaryCall inputText CNullTerminatedByteString binaryZeroText
run parseZeroBinaryCall
bind value parseZeroBinaryResult CSignedInt64 parseZeroBinaryCall
call checkParseZeroBinaryCall math.equalI64
argument checkParseZeroBinaryCall left I64 parseZeroBinaryResult
argument checkParseZeroBinaryCall right I64 zeroNumerator
run checkParseZeroBinaryCall
bind value parseZeroBinaryOk Bool checkParseZeroBinaryCall
branch if condition parseZeroBinaryOk target parseZeroBinaryHolds
branch else target smokeAssertionFailed
label parseZeroBinaryHolds

# absoluteMaxWidthSignedInt(0) == 0 (boundary)
call absZeroCall absoluteMaxWidthSignedInt
argument absZeroCall inputValue CSignedInt64 zeroNumerator
run absZeroCall
bind value absZeroResult CSignedInt64 absZeroCall
call checkAbsZeroCall math.equalI64
argument checkAbsZeroCall left I64 absZeroResult
argument checkAbsZeroCall right I64 zeroNumerator
run checkAbsZeroCall
bind value absZeroOk Bool checkAbsZeroCall
branch if condition absZeroOk target absZeroHolds
branch else target smokeAssertionFailed
label absZeroHolds

storage module immutable successMessageText CNullTerminatedByteString "OK"
call writeSuccessLineCall console.writeLine
argument writeSuccessLineCall console Console console
argument writeSuccessLineCall text CNullTerminatedByteString successMessageText
run writeSuccessLineCall
ignore ok source writeSuccessLineCall type CSignedInt32
bind error consoleWriteResultError CSignedInt32 writeSuccessLineCall
branch error source writeSuccessLineCall target consoleWriteFailedHandler
storage module immutable exitOkCode ExitCode 0
return ok exitOkCode

# Failure leg: surface the raw negative CSignedInt32 from
# console.writeLine as the cause attached to the typed
# MainError.ConsoleWriteFailed variant.
label consoleWriteFailedHandler
makeError consoleWriteFailedFailure MainError.ConsoleWriteFailed consoleWriteResultError
return error consoleWriteFailedFailure
label smokeAssertionFailed
makeError inttypesSmokeFailure MainError.InttypesSmokeAssertionFailed
return error inttypesSmokeFailure
