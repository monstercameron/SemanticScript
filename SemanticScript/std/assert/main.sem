# SemanticScript standard-library canonical module: standard.assert.

module standard.assert
purpose module standard.assert "Canonical standard-library module for assertion helpers."
moduleOwns standard.assert "The official import path `standard.assert` and this module's implementation body."
moduleDoesNotOwn standard.assert "App-specific wrappers, compatibility aliases, or generated build artifacts."
invariant module standard.assert "The standard module entry is this file; tests live beside it as `main.test.sem`."

exportConstant standard.assert assertModuleVersionText
storage module immutable assertModuleVersionText CNullTerminatedByteString "standard.assert 0.1"

# Canonical standard-library implementation body.
# ============================================================
# SEMANTICSCRIPT STANDARD LIBRARY: typed assertions
# ============================================================
#
# rationale: C's <assert.h> macro raises SIGABRT on failure with
#   no structured information. The refined surface defines a typed
#   AssertionError domain (ConditionWasFalse / ValuesWereNotEqual /
#   ValuesShouldNotMatch / OrderingViolated / OutOfRange /
#   PointerWasNull) so a failing assertion surfaces in the typed
#   error system rather than terminating the process. Callers that
#   want the abort-on-failure shape can wrap any require* op with
#   `branchIfError ... -> c.abort`.
#
# invariant: every require* operation returns Result Void
#   AssertionError. Success path is a clean `returnOk` with no
#   side effect; failure path writes a short message via
#   writeAssertionByteToStandardOutput and returns an AssertionError
#   variant carrying the structured failure reason.
#
# security: assertion messages are written to stdout â€” keep
#   sensitive values out of conditions when assertions might
#   trigger in production.
#
# timing: each assertion is O(1) on the success path; failure
#   adds ~8 putchar calls for the "assert!\n" diagnostic.

# Pure-module file: smoke + extended tests live in
# std/assert/main.test.sem.

# Typed error domain for failed assertions.
error AssertionError
errorCase AssertionError ConditionWasFalse
errorCase AssertionError ValuesWereNotEqual
errorCase AssertionError ValuesShouldNotMatch
errorCase AssertionError OrderingViolated
errorCase AssertionError OutOfRange
errorCase AssertionError PointerWasNull

# section capability
# rationale: the diagnostic writers below stream to stdout, so the
# capability is referenced from this module's own operations (not
# just the test smoke).
capability stdoutWriteCapability console.stdout write

# section assert.diagnosticBytes

operation writeAssertionByteToStandardOutput
input operation writeAssertionByteToStandardOutput characterCode CSignedInt32
output operation writeAssertionByteToStandardOutput CSignedInt32
useCapability writeAssertionByteToStandardOutput stdoutWriteCapability
effect writeAssertionByteToStandardOutput write console.stdout
memory writeAssertionByteToStandardOutput heap no
memory writeAssertionByteToStandardOutput stack max 1024
async writeAssertionByteToStandardOutput no
purpose operation writeAssertionByteToStandardOutput "Single-byte writer wrapping c.putchar for assertion-failure diagnostics."
invariant operation writeAssertionByteToStandardOutput "Writes exactly one byte; returns the libc putchar return value (the character on success, EOF / negative on error which we propagate to the caller)."
guarantee writeAssertionByteToStandardOutput "Always returns; negative return signals a stdout-write failure."
label startWriteAssertionByteToStandardOutput
call libcPutcharCall c.putchar
argument libcPutcharCall c CSignedInt32 characterCode
run libcPutcharCall
ignore ok source libcPutcharCall type CSignedInt32
bind error libcPutcharError CSignedInt32 libcPutcharCall
branch error source libcPutcharCall target returnPutcharError
bind value libcPutcharResult CSignedInt32 libcPutcharCall
# The assertion-banner emitter doesn't surface stdout-write errors
# as typed failures (assertion failure is the primary signal), so
# we just propagate the libc putchar return as-is.
return value libcPutcharResult
# On putchar error we propagate the negative error value to the
# caller, who can decide whether to abort or continue.
label returnPutcharError
return value libcPutcharError

# section assert.diagnosticHelpers

operation emitAssertionFailureBanner
output operation emitAssertionFailureBanner CSignedInt32
useCapability emitAssertionFailureBanner stdoutWriteCapability
effect emitAssertionFailureBanner write console.stdout
memory emitAssertionFailureBanner heap no
memory emitAssertionFailureBanner stack max 1024
async emitAssertionFailureBanner no
purpose operation emitAssertionFailureBanner "Emit the literal 'assert!\\n' on stdout. Internal helper used by every assertion-failure path."
invariant operation emitAssertionFailureBanner "Exactly eight bytes written: 'a', 's', 's', 'e', 'r', 't', '!', '\\n'."
guarantee emitAssertionFailureBanner "Always returns."
label startEmitAssertionFailureBanner
storage module immutable asciiLowerA CSignedInt32 97
storage module immutable asciiLowerS CSignedInt32 115
storage module immutable asciiLowerE CSignedInt32 101
storage module immutable asciiLowerR CSignedInt32 114
storage module immutable asciiLowerT CSignedInt32 116
storage module immutable asciiExclamation CSignedInt32 33
storage module immutable asciiNewline CSignedInt32 10
call writeBannerLetterACall writeAssertionByteToStandardOutput
argument writeBannerLetterACall characterCode CSignedInt32 asciiLowerA
run writeBannerLetterACall
ignore value source writeBannerLetterACall type CSignedInt32
call writeBannerFirstLetterSCall writeAssertionByteToStandardOutput
argument writeBannerFirstLetterSCall characterCode CSignedInt32 asciiLowerS
run writeBannerFirstLetterSCall
ignore value source writeBannerFirstLetterSCall type CSignedInt32
call writeBannerSecondLetterSCall writeAssertionByteToStandardOutput
argument writeBannerSecondLetterSCall characterCode CSignedInt32 asciiLowerS
run writeBannerSecondLetterSCall
ignore value source writeBannerSecondLetterSCall type CSignedInt32
call writeBannerLetterECall writeAssertionByteToStandardOutput
argument writeBannerLetterECall characterCode CSignedInt32 asciiLowerE
run writeBannerLetterECall
ignore value source writeBannerLetterECall type CSignedInt32
call writeBannerLetterRCall writeAssertionByteToStandardOutput
argument writeBannerLetterRCall characterCode CSignedInt32 asciiLowerR
run writeBannerLetterRCall
ignore value source writeBannerLetterRCall type CSignedInt32
call writeBannerLetterTCall writeAssertionByteToStandardOutput
argument writeBannerLetterTCall characterCode CSignedInt32 asciiLowerT
run writeBannerLetterTCall
ignore value source writeBannerLetterTCall type CSignedInt32
call writeBannerExclamationCall writeAssertionByteToStandardOutput
argument writeBannerExclamationCall characterCode CSignedInt32 asciiExclamation
run writeBannerExclamationCall
ignore value source writeBannerExclamationCall type CSignedInt32
call writeBannerNewlineCall writeAssertionByteToStandardOutput
argument writeBannerNewlineCall characterCode CSignedInt32 asciiNewline
run writeBannerNewlineCall
ignore value source writeBannerNewlineCall type CSignedInt32
storage module immutable bannerReturnCode CSignedInt32 0
return value bannerReturnCode

# section assert.predicates

operation requireConditionTrue
input operation requireConditionTrue conditionValue Bool
output operation requireConditionTrue Result CSignedInt32 AssertionError
useCapability requireConditionTrue stdoutWriteCapability
effect requireConditionTrue write console.stdout
memory requireConditionTrue heap no
memory requireConditionTrue stack max 1024
async requireConditionTrue no
purpose operation requireConditionTrue "Succeeds when conditionValue is true; emits an 'assert!\\n' banner and returns AssertionError.ConditionWasFalse otherwise."
invariant operation requireConditionTrue "Success returns 0; failure returns a typed AssertionError variant."
failure requireConditionTrue ConditionWasFalse "Returned when conditionValue is false."
guarantee requireConditionTrue "Total â€” every input produces either an Ok or an Error."
label startRequireConditionTrue
branch if condition conditionValue target returnAssertionOk
call emitBannerCall emitAssertionFailureBanner
run emitBannerCall
ignore value source emitBannerCall type CSignedInt32
makeError conditionFailure AssertionError.ConditionWasFalse
return error conditionFailure
label returnAssertionOk
storage module immutable assertionOkCode CSignedInt32 0
return ok assertionOkCode

operation requireSignedInt64ValuesEqual
