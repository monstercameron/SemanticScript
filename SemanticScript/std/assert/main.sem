call detectEqualityCall math.equalI64
argument detectEqualityCall left I64 leftValue
argument detectEqualityCall right I64 rightValue
run detectEqualityCall
bind value valuesEqual Bool detectEqualityCall
branch if condition valuesEqual target returnEqualityOk
call emitEqualityBannerCall emitAssertionFailureBanner
run emitEqualityBannerCall
ignore value source emitEqualityBannerCall type CSignedInt32
makeError equalityFailure AssertionError.ValuesWereNotEqual
return error equalityFailure
label returnEqualityOk
storage module immutable equalityOkCode CSignedInt32 0
return ok equalityOkCode

