# copyCStringToDestinationBuffer hello -> heap buffer, then compareCString it
storage module immutable bufSize CByteCount 16
call alloc1Call c.malloc
argument alloc1Call size CByteCount bufSize
run alloc1Call
bind value dest1 COpaqueMemoryAddress alloc1Call
bind error alloc1Error CSignedInt32 alloc1Call
branch error source alloc1Call target alloc1FailedHandler
defer releaseAlloc1Call c.free dest1

call cc1Call copyCStringToDestinationBuffer
argument cc1Call dest COpaqueMemoryAddress dest1
argument cc1Call src CNullTerminatedByteString hello
run cc1Call
ignore ok source cc1Call type CByteCount

call cc1CmpCall compareCString
argument cc1CmpCall a COpaqueMemoryAddress dest1
argument cc1CmpCall b CNullTerminatedByteString hello
run cc1CmpCall
bind ok cc1CmpRes CSignedInt32 cc1CmpCall
call cc1CheckCall math.equalI64
argument cc1CheckCall left I64 cc1CmpRes
argument cc1CheckCall right I64 zeroI32
run cc1CheckCall
bind value cc1Ok Bool cc1CheckCall
branch if condition cc1Ok target cc1OkLabel
branch else target testFailed
label cc1OkLabel

