# duplicateCStringIntoOwnedMemory("Hello") returns a heap copy that compareCString's equal to original
call sd1Call duplicateCStringIntoOwnedMemory
argument sd1Call s String hello
run sd1Call
bind ok sd1Res OpaquePointer sd1Call
call sd1NullCheckCall pointer.isNull
argument sd1NullCheckCall pointer OpaquePointer sd1Res
run sd1NullCheckCall
bind value sd1IsNull Bool sd1NullCheckCall
branch if condition sd1IsNull target testFailed
call sd1CmpCall compareCString
argument sd1CmpCall a OpaquePointer sd1Res
argument sd1CmpCall b String hello
run sd1CmpCall
bind ok sd1CmpRes Int32 sd1CmpCall
call sd1CheckCall math.equalInt64
argument sd1CheckCall left Int64 sd1CmpRes
argument sd1CheckCall right Int64 zeroInt32
run sd1CheckCall
bind value sd1Ok Bool sd1CheckCall
branch if condition sd1Ok target sd1OkLabel
branch else target testFailed
label sd1OkLabel
call sd1FreeCall c.free
argument sd1FreeCall ptr OpaquePointer sd1Res
run sd1FreeCall

# cstringBeginsWithPrefix("Hello, World", "Hello") == 1
storage module immutable oneInt32trueChk Int32 1
call bw1Call cstringBeginsWithPrefix
