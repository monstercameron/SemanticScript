bind ok ch1Res CSignedInt64 ch1Call
call ch1CheckCall math.equalI64
argument ch1CheckCall left I64 ch1Res
argument ch1CheckCall right I64 twoI64
run ch1CheckCall
bind value ch1Ok Bool ch1CheckCall
branch if condition ch1Ok target ch1OkLabel
branch else target testFailed
label ch1OkLabel

# findLastCharacterInCString("Hello", 'l') == 3
call rch1Call findLastCharacterInCString
argument rch1Call s CNullTerminatedByteString hello
argument rch1Call c CSignedInt32 lowerL
run rch1Call
bind ok rch1Res CSignedInt64 rch1Call
call rch1CheckCall math.equalI64
argument rch1CheckCall left I64 rch1Res
argument rch1CheckCall right I64 threeI64
run rch1CheckCall
bind value rch1Ok Bool rch1CheckCall
