# appendCStringPrefixToDestinationBuffer: seed with "Hi", append "there!" max 4 -> "Hithere"
storage module immutable bufSizeNc ByteCount 32
storage module immutable hi String "Hi"
storage module immutable thereMore String "there!"
storage module immutable expectedHiThere String "Hither"
storage module immutable fourNc ByteCount 4
call allocNcCall c.malloc
argument allocNcCall size ByteCount bufSizeNc
run allocNcCall
bind value destNc OpaquePointer allocNcCall
bind error allocNcError Int32 allocNcCall
branch error source allocNcCall target allocNcFailedHandler
defer releaseAllocNcCall c.free destNc
call seedNcCall copyCStringToDestinationBuffer
argument seedNcCall dest OpaquePointer destNc
argument seedNcCall src String hi
run seedNcCall
ignore ok source seedNcCall type ByteCount
call ncatCall appendCStringPrefixToDestinationBuffer
argument ncatCall dest OpaquePointer destNc
argument ncatCall src String thereMore
argument ncatCall n ByteCount fourNc
run ncatCall
ignore ok source ncatCall type ByteCount
call ncCmpCall compareCString
argument ncCmpCall a OpaquePointer destNc
argument ncCmpCall b String expectedHiThere
run ncCmpCall
bind ok ncCmpRes Int32 ncCmpCall
call ncCheckCall math.equalInt64
argument ncCheckCall left Int64 ncCmpRes
argument ncCheckCall right Int64 zeroInt32
run ncCheckCall
bind value ncOk Bool ncCheckCall
branch if condition ncOk target ncOkLabel
branch else target testFailed
label ncOkLabel

# ============================================================
# Extended unit-test cases: empty-string boundary, not-found
# search results, ordering comparisons, and predicate-false legs
# for the prefix/suffix checks. Each existing op already has one
# happy-path assertion above; these target the alternate branch.
# ============================================================

storage module immutable emptyStr String ""
storage module immutable helloPlus String "Hello!"
storage module immutable helloFull String "Hello, World"
storage module immutable helloA String "abc"
storage module immutable helloAd String "abd"
storage module immutable helloAb String "ab"
storage module immutable upperZ Int32 90
storage module immutable zeroByteCount ByteCount 0
storage module immutable sixInt64case Int64 6
storage module immutable zeroInt32trueChk Int32 0

# stringByteLength("") == 0 (empty boundary)
call lenEmptyCall stringByteLength
argument lenEmptyCall s String emptyStr
run lenEmptyCall
bind ok lenEmptyRes ByteCount lenEmptyCall
call lenEmptyCheckCall math.equalInt64
argument lenEmptyCheckCall left Int64 lenEmptyRes
argument lenEmptyCheckCall right Int64 zeroByteCount
run lenEmptyCheckCall
bind value lenEmptyOk Bool lenEmptyCheckCall
branch if condition lenEmptyOk target lenEmptyOkLabel
branch else target testFailed
label lenEmptyOkLabel

# stringByteLength("Hello!") == 6
call lenSixCall stringByteLength
argument lenSixCall s String helloPlus
run lenSixCall
bind ok lenSixRes ByteCount lenSixCall
call lenSixCheckCall math.equalInt64
argument lenSixCheckCall left Int64 lenSixRes
argument lenSixCheckCall right Int64 sixInt64case
run lenSixCheckCall
bind value lenSixOk Bool lenSixCheckCall
branch if condition lenSixOk target lenSixOkLabel
branch else target testFailed
label lenSixOkLabel

# compareCString("abc", "abd") < 0 (lexicographic order)
call cmpLessCall compareCString
argument cmpLessCall a String helloA
argument cmpLessCall b String helloAd
run cmpLessCall
bind ok cmpLessRes Int32 cmpLessCall
call cmpLessCheckCall math.lessThanInt64
argument cmpLessCheckCall left Int64 cmpLessRes
argument cmpLessCheckCall right Int64 zeroInt32trueChk
run cmpLessCheckCall
bind value cmpLessOk Bool cmpLessCheckCall
branch if condition cmpLessOk target cmpLessOkLabel
branch else target testFailed
label cmpLessOkLabel

# compareCString("abd", "abc") > 0 (reverse direction)
call cmpGreaterCall compareCString
argument cmpGreaterCall a String helloAd
argument cmpGreaterCall b String helloA
run cmpGreaterCall
bind ok cmpGreaterRes Int32 cmpGreaterCall
call cmpGreaterCheckCall math.greaterThanInt64
argument cmpGreaterCheckCall left Int64 cmpGreaterRes
argument cmpGreaterCheckCall right Int64 zeroInt32trueChk
run cmpGreaterCheckCall
bind value cmpGreaterOk Bool cmpGreaterCheckCall
branch if condition cmpGreaterOk target cmpGreaterOkLabel
branch else target testFailed
label cmpGreaterOkLabel

# compareCString("abc", "ab") > 0 (longer string greater when prefix-matches)
call cmpLongerCall compareCString
argument cmpLongerCall a String helloA
argument cmpLongerCall b String helloAb
run cmpLongerCall
bind ok cmpLongerRes Int32 cmpLongerCall
call cmpLongerCheckCall math.greaterThanInt64
argument cmpLongerCheckCall left Int64 cmpLongerRes
argument cmpLongerCheckCall right Int64 zeroInt32trueChk
run cmpLongerCheckCall
bind value cmpLongerOk Bool cmpLongerCheckCall
branch if condition cmpLongerOk target cmpLongerOkLabel
branch else target testFailed
label cmpLongerOkLabel

# compareCStringPrefixBytes(a, b, 0) == 0 (zero-length is always equal)
call cmpZeroNCall compareCStringPrefixBytes
argument cmpZeroNCall a String hello
argument cmpZeroNCall b String xyz
argument cmpZeroNCall n ByteCount zeroByteCount
run cmpZeroNCall
bind ok cmpZeroNRes Int32 cmpZeroNCall
call cmpZeroNCheckCall math.equalInt64
argument cmpZeroNCheckCall left Int64 cmpZeroNRes
argument cmpZeroNCheckCall right Int64 zeroInt32trueChk
run cmpZeroNCheckCall
bind value cmpZeroNOk Bool cmpZeroNCheckCall
branch if condition cmpZeroNOk target cmpZeroNOkLabel
branch else target testFailed
label cmpZeroNOkLabel

