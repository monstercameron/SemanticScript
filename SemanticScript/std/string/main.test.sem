# appendCStringPrefixToDestinationBuffer: seed with "Hi", append "there!" max 4 -> "Hithere"
storage module immutable bufSizeNc CByteCount 32
storage module immutable hi CNullTerminatedByteString "Hi"
storage module immutable thereMore CNullTerminatedByteString "there!"
storage module immutable expectedHiThere CNullTerminatedByteString "Hither"
storage module immutable fourNc CByteCount 4
call allocNcCall c.malloc
argument allocNcCall size CByteCount bufSizeNc
run allocNcCall
bind value destNc COpaqueMemoryAddress allocNcCall
bind error allocNcError CSignedInt32 allocNcCall
