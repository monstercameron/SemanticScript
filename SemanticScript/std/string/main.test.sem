call ncp1Call copyCStringPrefixToDestinationBuffer
argument ncp1Call dest COpaqueMemoryAddress dest3
argument ncp1Call src CNullTerminatedByteString hello
argument ncp1Call n CByteCount sixteenLen
run ncp1Call
ignore ok source ncp1Call type CByteCount
# Verify first 5 bytes are "Hello", rest are NUL.
call ncpCmpCall compareCStringPrefixBytes
argument ncpCmpCall a COpaqueMemoryAddress dest3
argument ncpCmpCall b CNullTerminatedByteString hello
argument ncpCmpCall n I64 fiveLen
run ncpCmpCall
bind ok ncpCmpRes CSignedInt32 ncpCmpCall
call ncpCheckCall math.equalI64
argument ncpCheckCall left I64 ncpCmpRes
argument ncpCheckCall right I64 zeroI32
run ncpCheckCall
bind value ncpOk Bool ncpCheckCall
branch if condition ncpOk target ncpOkLabel
branch else target testFailed
label ncpOkLabel

# countInitialCStringBytesNotInRejectSet("hello,world", ",") == 5 (the comma is at index 5)
