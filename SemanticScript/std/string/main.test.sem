# ============================================================
# SEMANTICSCRIPT STANDARD LIBRARY TESTS: pure-SemanticScript C-string operations
# ============================================================
#
# rationale: companion test file for std/string/main.sem. Imports
#   the string module and exercises every C-string operation it
#   exports â€” length / compare / search / copy / append / duplicate /
#   prefix-suffix predicates â€” across happy-path and boundary cases
#   (empty buffer, not-found, ordering, prefix-longer-than-string).
#
# invariant: success prints "OK\n" and exits 0; assertion failures
#   surface MainError.StringSmokeAssertionFailed; heap allocation
#   failure surfaces MainError.MemoryAllocationFailed.
#
# # pattern: this is the canonical main.test.sem form â€” same directory
#   as main.sem, importModule foo, project block local to the test,
#   entry console main. The implementation file std/string/main.sem
#   carries no smoke main itself.

project StdStringTest
target console
runtime AgentRuntime 0.1
entry console main

import string standard.string
error MainError
errorCase MainError StringSmokeAssertionFailed
errorCase MainError ConsoleWriteFailed
errorCase MainError MemoryAllocationFailed

# section capability
# rationale: smoke-test main writes a single OK line to stdout and
# frees heap buffers. The memory.buffer read / write and heap-
# allocate capabilities are also redeclared here so the linter
# (which does not trace cross-module imports) resolves the
# `useCapability main â€¦` references below; the canonical
# declarations live in std/string/main.sem alongside the impl ops
# that consume them.
capability stdoutWriteCapability console.stdout write
capability heapFreeCapability heap free
capability heapAllocationCapability heap allocate
capability memoryBufferReadCapability memory.buffer read
capability memoryBufferWriteCapability memory.buffer write

# ============================================================
# Smoke test
# ============================================================

operation main
input operation main console Console
output operation main Result ExitCode MainError
useCapability main stdoutWriteCapability
useCapability main heapAllocationCapability
useCapability main heapFreeCapability
useCapability main memoryBufferReadCapability
useCapability main memoryBufferWriteCapability
effect main allocate heap
effect main free heap
effect main write console.stdout
effect main read memory.buffer
effect main write memory.buffer
memory main heap yes
memoryAllocationSource main alloc1Call
async main no
purpose operation main "Smoke-test every string operation. Prints OK on success."
invariant operation main "Each assertion that should hold returns Ok; final OK line is written via console.writeLine."

label startMain

storage module immutable hello String "Hello"
storage module immutable helloCopy String "Hello"
storage module immutable helloComma String "Hello, World"
storage module immutable lo String "lo,"
storage module immutable xyz String "xyz"
storage module immutable digits String "0123456789"
storage module immutable justDigits String "12345abc"

storage module immutable fiveLen Int64 5
storage module immutable zeroInt32 Int32 0
storage module immutable twoInt64 Int64 2
storage module immutable threeInt64 Int64 3
storage module immutable negOneInt64test Int64 -1

# stringByteLength("Hello") == 5
call l1Call stringByteLength
argument l1Call s String hello
run l1Call
bind ok l1Res ByteCount l1Call
call l1CheckCall math.equalInt64
argument l1CheckCall left Int64 l1Res
argument l1CheckCall right Int64 fiveLen
run l1CheckCall
bind value l1Ok Bool l1CheckCall
branch if condition l1Ok target l1OkLabel
branch else target testFailed
label l1OkLabel

# compareCString("Hello", "Hello") == 0
call c1Call compareCString
argument c1Call a String hello
argument c1Call b String helloCopy
run c1Call
bind ok c1Res Int32 c1Call
call c1CheckCall math.equalInt64
argument c1CheckCall left Int64 c1Res
argument c1CheckCall right Int64 zeroInt32
run c1CheckCall
bind value c1Ok Bool c1CheckCall
branch if condition c1Ok target c1OkLabel
branch else target testFailed
label c1OkLabel

# compareCStringPrefixBytes("Hello, World", "Hello", 5) == 0
call nc1Call compareCStringPrefixBytes
argument nc1Call a String helloComma
argument nc1Call b String hello
argument nc1Call n Int64 fiveLen
run nc1Call
bind ok nc1Res Int32 nc1Call
call nc1CheckCall math.equalInt64
argument nc1CheckCall left Int64 nc1Res
argument nc1CheckCall right Int64 zeroInt32
run nc1CheckCall
bind value nc1Ok Bool nc1CheckCall
branch if condition nc1Ok target nc1OkLabel
branch else target testFailed
label nc1OkLabel

# findFirstCharacterInCString("Hello", 'l') == 2
storage module immutable lowerL Int32 108
call ch1Call findFirstCharacterInCString
argument ch1Call s String hello
argument ch1Call c Int32 lowerL
run ch1Call
bind ok ch1Res Int64 ch1Call
call ch1CheckCall math.equalInt64
argument ch1CheckCall left Int64 ch1Res
argument ch1CheckCall right Int64 twoInt64
run ch1CheckCall
bind value ch1Ok Bool ch1CheckCall
branch if condition ch1Ok target ch1OkLabel
branch else target testFailed
label ch1OkLabel

# findLastCharacterInCString("Hello", 'l') == 3
call rch1Call findLastCharacterInCString
argument rch1Call s String hello
argument rch1Call c Int32 lowerL
run rch1Call
bind ok rch1Res Int64 rch1Call
call rch1CheckCall math.equalInt64
argument rch1CheckCall left Int64 rch1Res
argument rch1CheckCall right Int64 threeInt64
run rch1CheckCall
bind value rch1Ok Bool rch1CheckCall
branch if condition rch1Ok target rch1OkLabel
branch else target testFailed
label rch1OkLabel

# findSubstringInCString("Hello, World", "lo,") == 3
call ss1Call findSubstringInCString
argument ss1Call haystack String helloComma
argument ss1Call needle String lo
run ss1Call
bind ok ss1Res Int64 ss1Call
call ss1CheckCall math.equalInt64
argument ss1CheckCall left Int64 ss1Res
argument ss1CheckCall right Int64 threeInt64
run ss1CheckCall
bind value ss1Ok Bool ss1CheckCall
branch if condition ss1Ok target ss1OkLabel
branch else target testFailed
