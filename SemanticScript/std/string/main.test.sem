# copyCStringToDestinationBuffer hello -> heap buffer, then compareCString it
storage module immutable bufSize ByteCount 16
call alloc1Call c.malloc
argument alloc1Call size ByteCount bufSize
run alloc1Call
bind value dest1 OpaquePointer alloc1Call
bind error alloc1Error Int32 alloc1Call
branch error source alloc1Call target alloc1FailedHandler
defer releaseAlloc1Call c.free dest1

call cc1Call copyCStringToDestinationBuffer
argument cc1Call dest OpaquePointer dest1
argument cc1Call src String hello
run cc1Call
ignore ok source cc1Call type ByteCount

call cc1CmpCall compareCString
argument cc1CmpCall a OpaquePointer dest1
argument cc1CmpCall b String hello
run cc1CmpCall
bind ok cc1CmpRes Int32 cc1CmpCall
call cc1CheckCall math.equalInt64
argument cc1CheckCall left Int64 cc1CmpRes
argument cc1CheckCall right Int64 zeroInt32
run cc1CheckCall
bind value cc1Ok Bool cc1CheckCall
branch if condition cc1Ok target cc1OkLabel
branch else target testFailed
label cc1OkLabel

# appendCStringToDestinationBuffer into a buffer that already has "Hello"; append "!" -> "Hello!"
storage module immutable bufSize2 ByteCount 32
storage module immutable helloExc String "Hello!"
storage module immutable exclSuffix String "!"
call alloc2Call c.malloc
argument alloc2Call size ByteCount bufSize2
run alloc2Call
bind value dest2 OpaquePointer alloc2Call
bind error alloc2Error Int32 alloc2Call
branch error source alloc2Call target alloc2FailedHandler
defer releaseAlloc2Call c.free dest2
call seed2Call copyCStringToDestinationBuffer
argument seed2Call dest OpaquePointer dest2
argument seed2Call src String hello
run seed2Call
ignore ok source seed2Call type ByteCount
call cat2Call appendCStringToDestinationBuffer
argument cat2Call dest OpaquePointer dest2
argument cat2Call src String exclSuffix
run cat2Call
ignore ok source cat2Call type ByteCount
call catCmpCall compareCString
argument catCmpCall a OpaquePointer dest2
argument catCmpCall b String helloExc
run catCmpCall
bind ok catCmpRes Int32 catCmpCall
call catCheckCall math.equalInt64
argument catCheckCall left Int64 catCmpRes
argument catCheckCall right Int64 zeroInt32
run catCheckCall
bind value catOk Bool catCheckCall
branch if condition catOk target catOkLabel
branch else target testFailed
label catOkLabel

# copyCStringPrefixToDestinationBuffer hello -> 16-byte buffer, pad rest with zeros.
storage module immutable sixteenLen ByteCount 16
call alloc3Call c.malloc
argument alloc3Call size ByteCount sixteenLen
run alloc3Call
bind value dest3 OpaquePointer alloc3Call
bind error alloc3Error Int32 alloc3Call
branch error source alloc3Call target alloc3FailedHandler
defer releaseAlloc3Call c.free dest3
call ncp1Call copyCStringPrefixToDestinationBuffer
argument ncp1Call dest OpaquePointer dest3
argument ncp1Call src String hello
argument ncp1Call n ByteCount sixteenLen
run ncp1Call
ignore ok source ncp1Call type ByteCount
# Verify first 5 bytes are "Hello", rest are NUL.
call ncpCmpCall compareCStringPrefixBytes
argument ncpCmpCall a OpaquePointer dest3
argument ncpCmpCall b String hello
argument ncpCmpCall n Int64 fiveLen
run ncpCmpCall
bind ok ncpCmpRes Int32 ncpCmpCall
call ncpCheckCall math.equalInt64
argument ncpCheckCall left Int64 ncpCmpRes
argument ncpCheckCall right Int64 zeroInt32
run ncpCheckCall
bind value ncpOk Bool ncpCheckCall
branch if condition ncpOk target ncpOkLabel
branch else target testFailed
label ncpOkLabel

# countInitialCStringBytesNotInRejectSet("hello,world", ",") == 5 (the comma is at index 5)
storage module immutable helloWorld String "hello,world"
storage module immutable commaStr String ","
call csn1Call countInitialCStringBytesNotInRejectSet
argument csn1Call s String helloWorld
argument csn1Call reject String commaStr
run csn1Call
bind ok csn1Res ByteCount csn1Call
call csn1CheckCall math.equalInt64
argument csn1CheckCall left Int64 csn1Res
argument csn1CheckCall right Int64 fiveLen
run csn1CheckCall
bind value csn1Ok Bool csn1CheckCall
branch if condition csn1Ok target csn1OkLabel
branch else target testFailed
label csn1OkLabel

# findFirstCStringByteInAcceptSet("hello,world", ",.;") == 5
storage module immutable punctSet String ",.;"
call pbk1Call findFirstCStringByteInAcceptSet
argument pbk1Call s String helloWorld
argument pbk1Call accept String punctSet
run pbk1Call
bind ok pbk1Res Int64 pbk1Call
call pbk1CheckCall math.equalInt64
argument pbk1CheckCall left Int64 pbk1Res
argument pbk1CheckCall right Int64 fiveLen
run pbk1CheckCall
bind value pbk1Ok Bool pbk1CheckCall
branch if condition pbk1Ok target pbk1OkLabel
