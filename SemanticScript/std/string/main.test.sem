# cstringBeginsWithPrefix("Hello", "Hello, World") == 0 (prefix longer than string)
call beginsLongerCall cstringBeginsWithPrefix
argument beginsLongerCall s String hello
argument beginsLongerCall prefix String helloFull
run beginsLongerCall
bind ok beginsLongerRes Int32 beginsLongerCall
call beginsLongerCheckCall math.equalInt64
argument beginsLongerCheckCall left Int64 beginsLongerRes
argument beginsLongerCheckCall right Int64 zeroInt32trueChk
run beginsLongerCheckCall
bind value beginsLongerOk Bool beginsLongerCheckCall
branch if condition beginsLongerOk target beginsLongerOkLabel
branch else target testFailed
label beginsLongerOkLabel

# cstringEndsWithSuffix("Hello, World", "Hello") == 0 (matches prefix, not suffix)
call endsMismatchCall cstringEndsWithSuffix
argument endsMismatchCall s String helloComma
argument endsMismatchCall suffix String hello
run endsMismatchCall
bind ok endsMismatchRes Int32 endsMismatchCall
call endsMismatchCheckCall math.equalInt64
argument endsMismatchCheckCall left Int64 endsMismatchRes
argument endsMismatchCheckCall right Int64 zeroInt32trueChk
run endsMismatchCheckCall
bind value endsMismatchOk Bool endsMismatchCheckCall
branch if condition endsMismatchOk target endsMismatchOkLabel
branch else target testFailed
label endsMismatchOkLabel

# All assertions hold. Emit "OK" via console.writeLine â€” uniform
# with the other stdlib smokes, references the runtime console
# handle, and surfaces a typed ConsoleWriteFailed if stdout fails.
storage module immutable successMessageText String "OK"
call writeSuccessLineCall console.writeLine
argument writeSuccessLineCall console Console console
argument writeSuccessLineCall text String successMessageText
run writeSuccessLineCall
ignore ok source writeSuccessLineCall type Int32
bind error consoleWriteResultError Int32 writeSuccessLineCall
branch error source writeSuccessLineCall target consoleWriteFailedHandler

storage module immutable exitOk ExitCode 0
return ok exitOk

label testFailed
storage module immutable exitFail Int32 1
makeError testFailure MainError.StringSmokeAssertionFailed exitFail
return error testFailure

# Failure leg: surface the raw negative Int32 from
# console.writeLine as the cause attached to the typed
# MainError.ConsoleWriteFailed variant.
label consoleWriteFailedHandler
makeError consoleWriteFailedFailure MainError.ConsoleWriteFailed consoleWriteResultError
return error consoleWriteFailedFailure

# Heap-allocation failure legs: one handler per c.malloc call so
# the bindError value for each is referenced (linter wants every
# bindError consumed). Each surfaces MainError.MemoryAllocationFailed
# with the call-specific raw error as the cause. The deferred frees
# registered after each successful malloc still fire on these paths
# for any allocations that did succeed prior to the failure.
label alloc1FailedHandler
makeError alloc1Failure MainError.MemoryAllocationFailed alloc1Error
return error alloc1Failure
label alloc2FailedHandler
makeError alloc2Failure MainError.MemoryAllocationFailed alloc2Error
return error alloc2Failure
label alloc3FailedHandler
makeError alloc3Failure MainError.MemoryAllocationFailed alloc3Error
return error alloc3Failure
label allocNcFailedHandler
makeError allocNcFailure MainError.MemoryAllocationFailed allocNcError
return error allocNcFailure
