# findSubstringInCString("Hello, World", "xyz") == -1
call ss2Call findSubstringInCString
argument ss2Call haystack String helloComma
argument ss2Call needle String xyz
run ss2Call
bind ok ss2Res Int64 ss2Call
call ss2CheckCall math.equalInt64
argument ss2CheckCall left Int64 ss2Res
argument ss2CheckCall right Int64 negOneInt64test
run ss2CheckCall
bind value ss2Ok Bool ss2CheckCall
branch if condition ss2Ok target ss2OkLabel
branch else target testFailed
