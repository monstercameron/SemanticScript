defer releaseAllocNcCall c.free destNc
call seedNcCall copyCStringToDestinationBuffer
argument seedNcCall dest COpaqueMemoryAddress destNc
argument seedNcCall src CNullTerminatedByteString hi
run seedNcCall
ignore ok source seedNcCall type CByteCount
call ncatCall appendCStringPrefixToDestinationBuffer
argument ncatCall dest COpaqueMemoryAddress destNc
argument ncatCall src CNullTerminatedByteString thereMore
argument ncatCall n CByteCount fourNc
run ncatCall
ignore ok source ncatCall type CByteCount
call ncCmpCall compareCString
argument ncCmpCall a COpaqueMemoryAddress destNc
argument ncCmpCall b CNullTerminatedByteString expectedHiThere
run ncCmpCall
bind ok ncCmpRes CSignedInt32 ncCmpCall
call ncCheckCall math.equalI64
argument ncCheckCall left I64 ncCmpRes
argument ncCheckCall right I64 zeroI32
run ncCheckCall
bind value ncOk Bool ncCheckCall
branch if condition ncOk target ncOkLabel
branch else target testFailed
label ncOkLabel

# ============================================================
# Extended unit-test cases: empty-string boundary, not-found
# search results, ordering comparisons, and predicate-false legs
# for the prefix/suffix checks. Each existing op already has one
# happy-path assertion above; these target the alternate branch.
# ============================================================

storage module immutable emptyStr CNullTerminatedByteString ""
storage module immutable helloPlus CNullTerminatedByteString "Hello!"
storage module immutable helloFull CNullTerminatedByteString "Hello, World"
storage module immutable helloA CNullTerminatedByteString "abc"
storage module immutable helloAd CNullTerminatedByteString "abd"
storage module immutable helloAb CNullTerminatedByteString "ab"
storage module immutable upperZ CSignedInt32 90
storage module immutable zeroByteCount CByteCount 0
storage module immutable sixI64case I64 6
storage module immutable zeroI32trueChk CSignedInt32 0

# stringByteLength("") == 0 (empty boundary)
call lenEmptyCall stringByteLength
argument lenEmptyCall s CNullTerminatedByteString emptyStr
run lenEmptyCall
bind ok lenEmptyRes CByteCount lenEmptyCall
call lenEmptyCheckCall math.equalI64
argument lenEmptyCheckCall left I64 lenEmptyRes
argument lenEmptyCheckCall right I64 zeroByteCount
run lenEmptyCheckCall
bind value lenEmptyOk Bool lenEmptyCheckCall
branch if condition lenEmptyOk target lenEmptyOkLabel
branch else target testFailed
label lenEmptyOkLabel

# stringByteLength("Hello!") == 6
call lenSixCall stringByteLength
argument lenSixCall s CNullTerminatedByteString helloPlus
run lenSixCall
bind ok lenSixRes CByteCount lenSixCall
call lenSixCheckCall math.equalI64
argument lenSixCheckCall left I64 lenSixRes
argument lenSixCheckCall right I64 sixI64case
run lenSixCheckCall
bind value lenSixOk Bool lenSixCheckCall
branch if condition lenSixOk target lenSixOkLabel
branch else target testFailed
label lenSixOkLabel

