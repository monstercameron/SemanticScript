# countInitialCStringBytesInAcceptSet("12345abc", "0123456789") == 5
call sp1Call countInitialCStringBytesInAcceptSet
argument sp1Call s CNullTerminatedByteString justDigits
argument sp1Call accept CNullTerminatedByteString digits
run sp1Call
bind ok sp1Res CByteCount sp1Call
call sp1CheckCall math.equalI64
argument sp1CheckCall left I64 sp1Res
argument sp1CheckCall right I64 fiveLen
run sp1CheckCall
bind value sp1Ok Bool sp1CheckCall
branch if condition sp1Ok target sp1OkLabel
branch else target testFailed
