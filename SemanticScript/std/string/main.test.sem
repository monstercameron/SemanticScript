# findSubstringInCString("Hello, World", "xyz") == -1
call ss2Call findSubstringInCString
argument ss2Call haystack CNullTerminatedByteString helloComma
argument ss2Call needle CNullTerminatedByteString xyz
run ss2Call
bind ok ss2Res CSignedInt64 ss2Call
call ss2CheckCall math.equalI64
argument ss2CheckCall left I64 ss2Res
argument ss2CheckCall right I64 negOneI64test
run ss2CheckCall
