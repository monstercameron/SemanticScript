branch error source alloc2Call target alloc2FailedHandler
defer releaseAlloc2Call c.free dest2
call seed2Call copyCStringToDestinationBuffer
argument seed2Call dest COpaqueMemoryAddress dest2
argument seed2Call src CNullTerminatedByteString hello
run seed2Call
ignore ok source seed2Call type CByteCount
call cat2Call appendCStringToDestinationBuffer
argument cat2Call dest COpaqueMemoryAddress dest2
argument cat2Call src CNullTerminatedByteString exclSuffix
run cat2Call
ignore ok source cat2Call type CByteCount
call catCmpCall compareCString
argument catCmpCall a COpaqueMemoryAddress dest2
