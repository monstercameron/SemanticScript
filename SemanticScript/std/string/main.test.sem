# countInitialCStringBytesInAcceptSet("12345abc", "0123456789") == 5
call sp1Call countInitialCStringBytesInAcceptSet
argument sp1Call s String justDigits
argument sp1Call accept String digits
run sp1Call
bind ok sp1Res ByteCount sp1Call
call sp1CheckCall math.equalInt64
argument sp1CheckCall left Int64 sp1Res
argument sp1CheckCall right Int64 fiveLen
run sp1CheckCall
bind value sp1Ok Bool sp1CheckCall
branch if condition sp1Ok target sp1OkLabel
branch else target testFailed
