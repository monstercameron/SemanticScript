branch if condition cmpLessOk target cmpLessOkLabel
branch else target testFailed
label cmpLessOkLabel

# compareCString("abd", "abc") > 0 (reverse direction)
call cmpGreaterCall compareCString
argument cmpGreaterCall a CNullTerminatedByteString helloAd
argument cmpGreaterCall b CNullTerminatedByteString helloA
run cmpGreaterCall
bind ok cmpGreaterRes CSignedInt32 cmpGreaterCall
call cmpGreaterCheckCall math.greaterThanI64
argument cmpGreaterCheckCall left I64 cmpGreaterRes
argument cmpGreaterCheckCall right I64 zeroI32trueChk
run cmpGreaterCheckCall
bind value cmpGreaterOk Bool cmpGreaterCheckCall
branch if condition cmpGreaterOk target cmpGreaterOkLabel
branch else target testFailed
label cmpGreaterOkLabel

# compareCString("abc", "ab") > 0 (longer string greater when prefix-matches)
call cmpLongerCall compareCString
argument cmpLongerCall a CNullTerminatedByteString helloA
argument cmpLongerCall b CNullTerminatedByteString helloAb
run cmpLongerCall
bind ok cmpLongerRes CSignedInt32 cmpLongerCall
call cmpLongerCheckCall math.greaterThanI64
argument cmpLongerCheckCall left I64 cmpLongerRes
argument cmpLongerCheckCall right I64 zeroI32trueChk
run cmpLongerCheckCall
bind value cmpLongerOk Bool cmpLongerCheckCall
branch if condition cmpLongerOk target cmpLongerOkLabel
branch else target testFailed
label cmpLongerOkLabel

# compareCStringPrefixBytes(a, b, 0) == 0 (zero-length is always equal)
call cmpZeroNCall compareCStringPrefixBytes
argument cmpZeroNCall a CNullTerminatedByteString hello
argument cmpZeroNCall b CNullTerminatedByteString xyz
argument cmpZeroNCall n CByteCount zeroByteCount
