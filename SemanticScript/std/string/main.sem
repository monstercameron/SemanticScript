operation duplicateCStringIntoOwnedMemory
input operation duplicateCStringIntoOwnedMemory inputText String
output operation duplicateCStringIntoOwnedMemory OpaquePointer
useCapability duplicateCStringIntoOwnedMemory memoryBufferReadCapability
useCapability duplicateCStringIntoOwnedMemory heapAllocationCapability
effect duplicateCStringIntoOwnedMemory read memory.buffer
effect duplicateCStringIntoOwnedMemory allocate heap
memory duplicateCStringIntoOwnedMemory heap yes
memory duplicateCStringIntoOwnedMemory stack max 1024
memoryAllocationSource duplicateCStringIntoOwnedMemory mallocCall
async duplicateCStringIntoOwnedMemory no
purpose operation duplicateCStringIntoOwnedMemory "Allocate a heap copy of s. Caller owns the returned pointer (must c.free). Returns NULL on allocation failure."
invariant operation duplicateCStringIntoOwnedMemory "Computes source length, allocates length+1 bytes, copies bytes, writes the final NUL; returns the new buffer pointer (caller frees)."

label startDuplicateCStringIntoOwnedMemory
# len = stringByteLength(s)
call lenCall stringByteLength
argument lenCall s String inputText
run lenCall
bind value lenV ByteCount lenCall

storage module immutable oneIDup ByteCount 1
call allocSizeCall math.addInt64
argument allocSizeCall left Int64 lenV
argument allocSizeCall right Int64 oneIDup
run allocSizeCall
bind value allocSize ByteCount allocSizeCall

call mallocCall c.malloc
argument mallocCall size ByteCount allocSize
run mallocCall
bind value dest OpaquePointer mallocCall
bind error duplicateCStringMallocError Int32 mallocCall
branch error source mallocCall target strdupAllocationFailed

# Otherwise copy via copyCStringToDestinationBuffer.
call copyCall copyCStringToDestinationBuffer
argument copyCall dest OpaquePointer dest
argument copyCall src String inputText
run copyCall
ignore ok source copyCall type ByteCount

return value dest

# Allocation failed: surface the NULL through the bindError value
# (which cast back to a pointer is also NULL) so the caller sees
# the standard NULL-on-OOM contract.
label strdupAllocationFailed
return value duplicateCStringMallocError

operation appendCStringPrefixToDestinationBuffer
input operation appendCStringPrefixToDestinationBuffer destinationBuffer OpaquePointer
input operation appendCStringPrefixToDestinationBuffer sourceBuffer String
input operation appendCStringPrefixToDestinationBuffer maxByteCount ByteCount
output operation appendCStringPrefixToDestinationBuffer ByteCount
useCapability appendCStringPrefixToDestinationBuffer memoryBufferReadCapability
effect appendCStringPrefixToDestinationBuffer read memory.buffer
useCapability appendCStringPrefixToDestinationBuffer memoryBufferWriteCapability
effect appendCStringPrefixToDestinationBuffer write memory.buffer
memory appendCStringPrefixToDestinationBuffer heap no
memory appendCStringPrefixToDestinationBuffer stack max 1024
async appendCStringPrefixToDestinationBuffer no
purpose operation appendCStringPrefixToDestinationBuffer "Append at most n bytes from src to dest's existing NUL-terminated content. Always writes a NUL terminator after the appended bytes."
invariant operation appendCStringPrefixToDestinationBuffer "Walks destination to its NUL, then copies up to byteCount source bytes plus a final NUL; returns destination byte count after append."
label startAppendCStringPrefixToDestinationBuffer
storage module immutable zeroNc Int64 0
storage module immutable oneNc Int64 1
# Find end of dest.
memory appendCStringPrefixToDestinationBuffer mutable dEnd Int64 0
label ncFindEnd
call ncLoadCall pointer.loadByte
argument ncLoadCall buffer OpaquePointer destinationBuffer
argument ncLoadCall offset ByteCount dEnd
run ncLoadCall
bind value ncByte Int8 ncLoadCall
call ncEndCall math.equalInt64
argument ncEndCall left Int64 ncByte
argument ncEndCall right Int64 zeroNc
run ncEndCall
bind value ncAtEnd Bool ncEndCall
branch if condition ncAtEnd target ncEndFound
call ncIncCall math.addInt64
argument ncIncCall left Int64 dEnd
argument ncIncCall right Int64 oneNc
run ncIncCall
bind value ncNext Int64 ncIncCall
set memory dEnd ncNext
jump target ncFindEnd
label ncEndFound
# Copy up to n bytes (stop early on src NUL)
memory appendCStringPrefixToDestinationBuffer mutable srcIdx Int64 0
label ncCopyLoop
call ncDoneCall math.greaterThanOrEqualInt64
argument ncDoneCall left Int64 srcIdx
argument ncDoneCall right Int64 maxByteCount
run ncDoneCall
bind value ncDone Bool ncDoneCall
branch if condition ncDone target ncWriteNul
call ncSrcLoadCall pointer.loadByte
argument ncSrcLoadCall buffer OpaquePointer sourceBuffer
argument ncSrcLoadCall offset ByteCount srcIdx
run ncSrcLoadCall
bind value ncSrcByte Int8 ncSrcLoadCall
call ncSrcEndCall math.equalInt64
argument ncSrcEndCall left Int64 ncSrcByte
argument ncSrcEndCall right Int64 zeroNc
run ncSrcEndCall
bind value ncSrcAtEnd Bool ncSrcEndCall
branch if condition ncSrcAtEnd target ncWriteNul
call ncWriteOffCall math.addInt64
argument ncWriteOffCall left Int64 dEnd
argument ncWriteOffCall right Int64 srcIdx
run ncWriteOffCall
bind value writeOff Int64 ncWriteOffCall
call ncStoreCall pointer.storeByte
argument ncStoreCall buffer OpaquePointer destinationBuffer
argument ncStoreCall offset ByteCount writeOff
argument ncStoreCall value Int64 ncSrcByte
run ncStoreCall
call ncIdxIncCall math.addInt64
argument ncIdxIncCall left Int64 srcIdx
argument ncIdxIncCall right Int64 oneNc
run ncIdxIncCall
bind value ncIdxNext Int64 ncIdxIncCall
set memory srcIdx ncIdxNext
jump target ncCopyLoop
label ncWriteNul
call ncNulOffCall math.addInt64
argument ncNulOffCall left Int64 dEnd
argument ncNulOffCall right Int64 srcIdx
run ncNulOffCall
bind value nulOff Int64 ncNulOffCall
call ncNulStoreCall pointer.storeByte
argument ncNulStoreCall buffer OpaquePointer destinationBuffer
argument ncNulStoreCall offset ByteCount nulOff
argument ncNulStoreCall value Int64 zeroNc
run ncNulStoreCall
call ncTotalCall math.addInt64
argument ncTotalCall left Int64 dEnd
argument ncTotalCall right Int64 srcIdx
run ncTotalCall
bind value ncTotalRes ByteCount ncTotalCall
return value ncTotalRes

operation cstringBeginsWithPrefix
input operation cstringBeginsWithPrefix inputText String
input operation cstringBeginsWithPrefix prefixText String
output operation cstringBeginsWithPrefix Int32
useCapability cstringBeginsWithPrefix memoryBufferReadCapability
effect cstringBeginsWithPrefix read memory.buffer
memory cstringBeginsWithPrefix heap no
memory cstringBeginsWithPrefix stack max 1024
async cstringBeginsWithPrefix no
purpose operation cstringBeginsWithPrefix "1 if s starts with prefix; 0 otherwise. Pure SemanticScript via byte-by-byte compare."
invariant operation cstringBeginsWithPrefix "Returns true when every byte of prefixText matches the corresponding byte in inputText starting at offset 0."
label startCstringBeginsWithPrefix
storage module immutable zeroBw Int64 0
storage module immutable oneBw Int64 1
storage module immutable trueBw Int32 1
storage module immutable falseBw Int32 0
memory cstringBeginsWithPrefix mutable bwIdx Int64 0
label bwLoop
call bwPrefLoadCall pointer.loadByte
argument bwPrefLoadCall buffer OpaquePointer prefixText
argument bwPrefLoadCall offset ByteCount bwIdx
run bwPrefLoadCall
bind value bwPrefByte Int8 bwPrefLoadCall
call bwPrefEndCall math.equalInt64
argument bwPrefEndCall left Int64 bwPrefByte
argument bwPrefEndCall right Int64 zeroBw
run bwPrefEndCall
bind value bwPrefAtEnd Bool bwPrefEndCall
branch if condition bwPrefAtEnd target bwAllMatched
call bwSLoadCall pointer.loadByte
argument bwSLoadCall buffer OpaquePointer inputText
argument bwSLoadCall offset ByteCount bwIdx
run bwSLoadCall
bind value bwSByte Int8 bwSLoadCall
call bwSEndCall math.equalInt64
argument bwSEndCall left Int64 bwSByte
argument bwSEndCall right Int64 zeroBw
run bwSEndCall
bind value bwSAtEnd Bool bwSEndCall
branch if condition bwSAtEnd target bwMismatch
call bwEqCall math.equalInt64
argument bwEqCall left Int64 bwPrefByte
argument bwEqCall right Int64 bwSByte
run bwEqCall
bind value bwEqB Bool bwEqCall
branch if condition bwEqB target bwAdvance
branch else target bwMismatch
label bwAdvance
call bwIncCall math.addInt64
argument bwIncCall left Int64 bwIdx
argument bwIncCall right Int64 oneBw
run bwIncCall
bind value bwNext Int64 bwIncCall
set memory bwIdx bwNext
jump target bwLoop
label bwAllMatched
return value trueBw
label bwMismatch
return value falseBw

operation cstringEndsWithSuffix
input operation cstringEndsWithSuffix inputText String
input operation cstringEndsWithSuffix suffixText String
output operation cstringEndsWithSuffix Int32
useCapability cstringEndsWithSuffix memoryBufferReadCapability
effect cstringEndsWithSuffix read memory.buffer
memory cstringEndsWithSuffix heap no
memory cstringEndsWithSuffix stack max 1024
async cstringEndsWithSuffix no
purpose operation cstringEndsWithSuffix "1 if s ends with suffix; 0 otherwise. Implemented as: stringByteLength(suffix) <= stringByteLength(s), then compare last stringByteLength(suffix) bytes of s with suffix."
invariant operation cstringEndsWithSuffix "Computes both lengths via stringByteLength, then matches suffixText against inputText starting at the offset (inputLength - suffixLength)."
label startCstringEndsWithSuffix
storage module immutable trueEw Int32 1
storage module immutable falseEw Int32 0
storage module immutable oneEw Int64 1

call sLenCall stringByteLength
argument sLenCall s String inputText
run sLenCall
bind value sLen ByteCount sLenCall

call suffLenCall stringByteLength
argument suffLenCall s String suffixText
run suffLenCall
bind value suffLen ByteCount suffLenCall

# If suffix longer than s -> false
call suffLongerCall math.greaterThanInt64
argument suffLongerCall left Int64 suffLen
argument suffLongerCall right Int64 sLen
run suffLongerCall
bind value suffLonger Bool suffLongerCall
branch if condition suffLonger target ewFalse

# Start offset in s = sLen - suffLen
call startOffCall math.subtractInt64
argument startOffCall left Int64 sLen
argument startOffCall right Int64 suffLen
run startOffCall
bind value ewStart Int64 startOffCall

memory cstringEndsWithSuffix mutable ewIdx Int64 0
label ewLoop
call ewDoneCall math.greaterThanOrEqualInt64
argument ewDoneCall left Int64 ewIdx
argument ewDoneCall right Int64 suffLen
run ewDoneCall
bind value ewDoneB Bool ewDoneCall
branch if condition ewDoneB target ewTrue

call ewSuffLoadCall pointer.loadByte
argument ewSuffLoadCall buffer OpaquePointer suffixText
argument ewSuffLoadCall offset ByteCount ewIdx
run ewSuffLoadCall
bind value ewSuffByte Int8 ewSuffLoadCall
call ewSOffCall math.addInt64
argument ewSOffCall left Int64 ewStart
argument ewSOffCall right Int64 ewIdx
run ewSOffCall
bind value ewSOff Int64 ewSOffCall
call ewSLoadCall pointer.loadByte
argument ewSLoadCall buffer OpaquePointer inputText
argument ewSLoadCall offset ByteCount ewSOff
run ewSLoadCall
bind value ewSByte Int8 ewSLoadCall
call ewEqCall math.equalInt64
argument ewEqCall left Int64 ewSuffByte
argument ewEqCall right Int64 ewSByte
run ewEqCall
bind value ewEqB Bool ewEqCall
branch if condition ewEqB target ewAdv
branch else target ewFalse
label ewAdv
call ewIncCall math.addInt64
argument ewIncCall left Int64 ewIdx
argument ewIncCall right Int64 oneEw
run ewIncCall
bind value ewNext Int64 ewIncCall
set memory ewIdx ewNext
jump target ewLoop

label ewTrue
return value trueEw
label ewFalse
return value falseEw
