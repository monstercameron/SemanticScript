bind value ncpIsEnd Bool ncpIsEndCall
branch if condition ncpIsEnd target ncpEnterPadMode

call ncpStoreCall pointer.storeByte
argument ncpStoreCall buffer OpaquePointer destinationBuffer
argument ncpStoreCall offset ByteCount ncpIdx
argument ncpStoreCall value Int64 ncpByte
run ncpStoreCall
jump target ncpAdvance

label ncpEnterPadMode
set memory ncpReachedNul oneNcp
jump target ncpPadZero

label ncpPadZero
call ncpZeroStoreCall pointer.storeByte
argument ncpZeroStoreCall buffer OpaquePointer destinationBuffer
argument ncpZeroStoreCall offset ByteCount ncpIdx
argument ncpZeroStoreCall value Int64 zeroNcp
run ncpZeroStoreCall
jump target ncpAdvance

label ncpAdvance
call ncpIncCall math.addInt64
argument ncpIncCall left Int64 ncpIdx
argument ncpIncCall right Int64 oneNcp
run ncpIncCall
bind value ncpNext Int64 ncpIncCall
set memory ncpIdx ncpNext
jump target ncpLoop

label strncpyReturn
return value maxByteCount

