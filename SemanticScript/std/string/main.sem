argument catIncCall left I64 destEnd
argument catIncCall right I64 oneCat
run catIncCall
bind value catNext I64 catIncCall
set memory destEnd catNext
jump target catFindEnd

label catEndFound

# Copy src bytes (including NUL) starting at offset destEnd in dest.
memory appendCStringToDestinationBuffer mutable catSrcIdx I64 0
