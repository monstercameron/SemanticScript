call catSrcLoadCall pointer.loadByte
argument catSrcLoadCall buffer COpaqueMemoryAddress sourceBuffer
argument catSrcLoadCall offset CByteCount catSrcIdx
run catSrcLoadCall
bind value catSrcByte I8 catSrcLoadCall

call catWriteOffsetCall math.addI64
argument catWriteOffsetCall left I64 destEnd
argument catWriteOffsetCall right I64 catSrcIdx
run catWriteOffsetCall
bind value catWriteOffset I64 catWriteOffsetCall

call catStoreCall pointer.storeByte
argument catStoreCall buffer COpaqueMemoryAddress destinationBuffer
argument catStoreCall offset CByteCount catWriteOffset
argument catStoreCall value CSignedInt64 catSrcByte
run catStoreCall

call catSrcEndCall math.equalI64
argument catSrcEndCall left I64 catSrcByte
argument catSrcEndCall right I64 zeroCat
run catSrcEndCall
bind value catSrcAtEnd Bool catSrcEndCall
