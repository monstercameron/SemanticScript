label startFindFirstCStringByteInAcceptSet
storage module immutable zeroPb Int64 0
storage module immutable oneIPb Int64 1
storage module immutable negOnePb Int64 -1
memory findFirstCStringByteInAcceptSet mutable pbIdx Int64 0

label pbSLoop
