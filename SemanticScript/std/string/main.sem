input operation findFirstCStringByteInAcceptSet acceptedCharacters CNullTerminatedByteString
output operation findFirstCStringByteInAcceptSet CSignedInt64
useCapability findFirstCStringByteInAcceptSet memoryBufferReadCapability
effect findFirstCStringByteInAcceptSet read memory.buffer
memory findFirstCStringByteInAcceptSet heap no
memory findFirstCStringByteInAcceptSet stack max 1024
async findFirstCStringByteInAcceptSet no
purpose operation findFirstCStringByteInAcceptSet "Offset of the first byte of s that appears anywhere in accept, or -1 if absent before the NUL."
invariant operation findFirstCStringByteInAcceptSet "Walks forward and returns the first offset where the byte appears in acceptSet, or -1."

label startFindFirstCStringByteInAcceptSet
storage module immutable zeroPb I64 0
storage module immutable oneIPb I64 1
storage module immutable negOnePb I64 -1
memory findFirstCStringByteInAcceptSet mutable pbIdx I64 0

label pbSLoop
call pbLoadSCall pointer.loadByte
argument pbLoadSCall buffer COpaqueMemoryAddress inputText
argument pbLoadSCall offset CByteCount pbIdx
run pbLoadSCall
bind value pbSByte I8 pbLoadSCall
call pbSEndCall math.equalI64
argument pbSEndCall left I64 pbSByte
argument pbSEndCall right I64 zeroPb
run pbSEndCall
bind value pbAtEnd Bool pbSEndCall
branch if condition pbAtEnd target pbNotFound

memory findFirstCStringByteInAcceptSet mutable pbAidx I64 0
label pbALoop
call pbLoadACall pointer.loadByte
argument pbLoadACall buffer COpaqueMemoryAddress acceptedCharacters
argument pbLoadACall offset CByteCount pbAidx
run pbLoadACall
bind value pbAByte I8 pbLoadACall
call pbAEndCall math.equalI64
argument pbAEndCall left I64 pbAByte
argument pbAEndCall right I64 zeroPb
run pbAEndCall
bind value pbAEnd Bool pbAEndCall
branch if condition pbAEnd target pbAdvanceS

call pbEqCall math.equalI64
argument pbEqCall left I64 pbAByte
argument pbEqCall right I64 pbSByte
run pbEqCall
bind value pbEq Bool pbEqCall
branch if condition pbEq target pbFound

call pbAIncCall math.addI64
argument pbAIncCall left I64 pbAidx
argument pbAIncCall right I64 oneIPb
run pbAIncCall
bind value pbANext I64 pbAIncCall
set memory pbAidx pbANext
jump target pbALoop

label pbAdvanceS
set memory pbAidx zeroPb
call pbSIncCall math.addI64
argument pbSIncCall left I64 pbIdx
argument pbSIncCall right I64 oneIPb
run pbSIncCall
bind value pbSNext I64 pbSIncCall
set memory pbIdx pbSNext
jump target pbSLoop

label pbFound
return value pbIdx
label pbNotFound
return value negOnePb

operation duplicateCStringIntoOwnedMemory
input operation duplicateCStringIntoOwnedMemory inputText CNullTerminatedByteString
output operation duplicateCStringIntoOwnedMemory COpaqueMemoryAddress
useCapability duplicateCStringIntoOwnedMemory memoryBufferReadCapability
useCapability duplicateCStringIntoOwnedMemory heapAllocationCapability
effect duplicateCStringIntoOwnedMemory read memory.buffer
effect duplicateCStringIntoOwnedMemory allocate heap
memory duplicateCStringIntoOwnedMemory heap yes
memory duplicateCStringIntoOwnedMemory stack max 1024
memoryAllocationSource duplicateCStringIntoOwnedMemory mallocCall
async duplicateCStringIntoOwnedMemory no
purpose operation duplicateCStringIntoOwnedMemory "Allocate a heap copy of s. Caller owns the returned pointer (must c.free). Returns NULL on allocation failure."
invariant operation duplicateCStringIntoOwnedMemory "Computes source length, allocates length+1 bytes, copies bytes, writes the final NUL; returns the new buffer pointer (caller frees)."

label startDuplicateCStringIntoOwnedMemory
# len = stringByteLength(s)
call lenCall stringByteLength
argument lenCall s CNullTerminatedByteString inputText
run lenCall
bind value lenV CByteCount lenCall

storage module immutable oneIDup CByteCount 1
call allocSizeCall math.addI64
argument allocSizeCall left I64 lenV
argument allocSizeCall right I64 oneIDup
run allocSizeCall
bind value allocSize CByteCount allocSizeCall

call mallocCall c.malloc
argument mallocCall size CByteCount allocSize
run mallocCall
bind value dest COpaqueMemoryAddress mallocCall
bind error duplicateCStringMallocError CSignedInt32 mallocCall
branch error source mallocCall target strdupAllocationFailed

# Otherwise copy via copyCStringToDestinationBuffer.
call copyCall copyCStringToDestinationBuffer
argument copyCall dest COpaqueMemoryAddress dest
argument copyCall src CNullTerminatedByteString inputText
run copyCall
ignore ok source copyCall type CByteCount

return value dest

# Allocation failed: surface the NULL through the bindError value
# (which cast back to a pointer is also NULL) so the caller sees
# the standard NULL-on-OOM contract.
label strdupAllocationFailed
return value duplicateCStringMallocError

operation appendCStringPrefixToDestinationBuffer
input operation appendCStringPrefixToDestinationBuffer destinationBuffer COpaqueMemoryAddress
input operation appendCStringPrefixToDestinationBuffer sourceBuffer CNullTerminatedByteString
input operation appendCStringPrefixToDestinationBuffer maxByteCount CByteCount
output operation appendCStringPrefixToDestinationBuffer CByteCount
useCapability appendCStringPrefixToDestinationBuffer memoryBufferReadCapability
effect appendCStringPrefixToDestinationBuffer read memory.buffer
useCapability appendCStringPrefixToDestinationBuffer memoryBufferWriteCapability
effect appendCStringPrefixToDestinationBuffer write memory.buffer
memory appendCStringPrefixToDestinationBuffer heap no
memory appendCStringPrefixToDestinationBuffer stack max 1024
async appendCStringPrefixToDestinationBuffer no
purpose operation appendCStringPrefixToDestinationBuffer "Append at most n bytes from src to dest's existing NUL-terminated content. Always writes a NUL terminator after the appended bytes."
invariant operation appendCStringPrefixToDestinationBuffer "Walks destination to its NUL, then copies up to byteCount source bytes plus a final NUL; returns destination byte count after append."
label startAppendCStringPrefixToDestinationBuffer
storage module immutable zeroNc I64 0
storage module immutable oneNc I64 1
# Find end of dest.
memory appendCStringPrefixToDestinationBuffer mutable dEnd I64 0
label ncFindEnd
call ncLoadCall pointer.loadByte
argument ncLoadCall buffer COpaqueMemoryAddress destinationBuffer
argument ncLoadCall offset CByteCount dEnd
run ncLoadCall
bind value ncByte I8 ncLoadCall
call ncEndCall math.equalI64
argument ncEndCall left I64 ncByte
argument ncEndCall right I64 zeroNc
run ncEndCall
bind value ncAtEnd Bool ncEndCall
branch if condition ncAtEnd target ncEndFound
call ncIncCall math.addI64
argument ncIncCall left I64 dEnd
argument ncIncCall right I64 oneNc
run ncIncCall
bind value ncNext I64 ncIncCall
set memory dEnd ncNext
jump target ncFindEnd
label ncEndFound
# Copy up to n bytes (stop early on src NUL)
memory appendCStringPrefixToDestinationBuffer mutable srcIdx I64 0
label ncCopyLoop
call ncDoneCall math.greaterThanOrEqualI64
argument ncDoneCall left I64 srcIdx
argument ncDoneCall right I64 maxByteCount
run ncDoneCall
bind value ncDone Bool ncDoneCall
branch if condition ncDone target ncWriteNul
call ncSrcLoadCall pointer.loadByte
argument ncSrcLoadCall buffer COpaqueMemoryAddress sourceBuffer
argument ncSrcLoadCall offset CByteCount srcIdx
run ncSrcLoadCall
bind value ncSrcByte I8 ncSrcLoadCall
call ncSrcEndCall math.equalI64
argument ncSrcEndCall left I64 ncSrcByte
argument ncSrcEndCall right I64 zeroNc
run ncSrcEndCall
bind value ncSrcAtEnd Bool ncSrcEndCall
branch if condition ncSrcAtEnd target ncWriteNul
call ncWriteOffCall math.addI64
argument ncWriteOffCall left I64 dEnd
argument ncWriteOffCall right I64 srcIdx
run ncWriteOffCall
bind value writeOff I64 ncWriteOffCall
call ncStoreCall pointer.storeByte
argument ncStoreCall buffer COpaqueMemoryAddress destinationBuffer
argument ncStoreCall offset CByteCount writeOff
argument ncStoreCall value CSignedInt64 ncSrcByte
run ncStoreCall
call ncIdxIncCall math.addI64
argument ncIdxIncCall left I64 srcIdx
argument ncIdxIncCall right I64 oneNc
run ncIdxIncCall
bind value ncIdxNext I64 ncIdxIncCall
set memory srcIdx ncIdxNext
jump target ncCopyLoop
label ncWriteNul
call ncNulOffCall math.addI64
argument ncNulOffCall left I64 dEnd
argument ncNulOffCall right I64 srcIdx
run ncNulOffCall
bind value nulOff I64 ncNulOffCall
call ncNulStoreCall pointer.storeByte
argument ncNulStoreCall buffer COpaqueMemoryAddress destinationBuffer
argument ncNulStoreCall offset CByteCount nulOff
argument ncNulStoreCall value CSignedInt64 zeroNc
run ncNulStoreCall
call ncTotalCall math.addI64
argument ncTotalCall left I64 dEnd
argument ncTotalCall right I64 srcIdx
run ncTotalCall
bind value ncTotalRes CByteCount ncTotalCall
return value ncTotalRes

operation cstringBeginsWithPrefix
input operation cstringBeginsWithPrefix inputText CNullTerminatedByteString
input operation cstringBeginsWithPrefix prefixText CNullTerminatedByteString
output operation cstringBeginsWithPrefix CSignedInt32
useCapability cstringBeginsWithPrefix memoryBufferReadCapability
effect cstringBeginsWithPrefix read memory.buffer
memory cstringBeginsWithPrefix heap no
memory cstringBeginsWithPrefix stack max 1024
async cstringBeginsWithPrefix no
purpose operation cstringBeginsWithPrefix "1 if s starts with prefix; 0 otherwise. Pure SemanticScript via byte-by-byte compare."
invariant operation cstringBeginsWithPrefix "Returns true when every byte of prefixText matches the corresponding byte in inputText starting at offset 0."
label startCstringBeginsWithPrefix
storage module immutable zeroBw I64 0
storage module immutable oneBw I64 1
storage module immutable trueBw CSignedInt32 1
storage module immutable falseBw CSignedInt32 0
memory cstringBeginsWithPrefix mutable bwIdx I64 0
label bwLoop
call bwPrefLoadCall pointer.loadByte
argument bwPrefLoadCall buffer COpaqueMemoryAddress prefixText
argument bwPrefLoadCall offset CByteCount bwIdx
run bwPrefLoadCall
bind value bwPrefByte I8 bwPrefLoadCall
call bwPrefEndCall math.equalI64
argument bwPrefEndCall left I64 bwPrefByte
argument bwPrefEndCall right I64 zeroBw
run bwPrefEndCall
bind value bwPrefAtEnd Bool bwPrefEndCall
branch if condition bwPrefAtEnd target bwAllMatched
call bwSLoadCall pointer.loadByte
argument bwSLoadCall buffer COpaqueMemoryAddress inputText
argument bwSLoadCall offset CByteCount bwIdx
run bwSLoadCall
bind value bwSByte I8 bwSLoadCall
call bwSEndCall math.equalI64
argument bwSEndCall left I64 bwSByte
argument bwSEndCall right I64 zeroBw
run bwSEndCall
bind value bwSAtEnd Bool bwSEndCall
branch if condition bwSAtEnd target bwMismatch
call bwEqCall math.equalI64
argument bwEqCall left I64 bwPrefByte
argument bwEqCall right I64 bwSByte
run bwEqCall
bind value bwEqB Bool bwEqCall
branch if condition bwEqB target bwAdvance
branch else target bwMismatch
label bwAdvance
call bwIncCall math.addI64
argument bwIncCall left I64 bwIdx
argument bwIncCall right I64 oneBw
run bwIncCall
bind value bwNext I64 bwIncCall
set memory bwIdx bwNext
jump target bwLoop
label bwAllMatched
return value trueBw
label bwMismatch
return value falseBw

operation cstringEndsWithSuffix
input operation cstringEndsWithSuffix inputText CNullTerminatedByteString
input operation cstringEndsWithSuffix suffixText CNullTerminatedByteString
output operation cstringEndsWithSuffix CSignedInt32
useCapability cstringEndsWithSuffix memoryBufferReadCapability
effect cstringEndsWithSuffix read memory.buffer
memory cstringEndsWithSuffix heap no
memory cstringEndsWithSuffix stack max 1024
async cstringEndsWithSuffix no
purpose operation cstringEndsWithSuffix "1 if s ends with suffix; 0 otherwise. Implemented as: stringByteLength(suffix) <= stringByteLength(s), then compare last stringByteLength(suffix) bytes of s with suffix."
invariant operation cstringEndsWithSuffix "Computes both lengths via stringByteLength, then matches suffixText against inputText starting at the offset (inputLength - suffixLength)."
label startCstringEndsWithSuffix
storage module immutable trueEw CSignedInt32 1
storage module immutable falseEw CSignedInt32 0
storage module immutable oneEw I64 1

call sLenCall stringByteLength
argument sLenCall s CNullTerminatedByteString inputText
run sLenCall
bind value sLen CByteCount sLenCall

call suffLenCall stringByteLength
argument suffLenCall s CNullTerminatedByteString suffixText
run suffLenCall
bind value suffLen CByteCount suffLenCall

# If suffix longer than s -> false
call suffLongerCall math.greaterThanI64
argument suffLongerCall left I64 suffLen
argument suffLongerCall right I64 sLen
run suffLongerCall
bind value suffLonger Bool suffLongerCall
branch if condition suffLonger target ewFalse

# Start offset in s = sLen - suffLen
call startOffCall math.subtractI64
argument startOffCall left I64 sLen
argument startOffCall right I64 suffLen
run startOffCall
bind value ewStart I64 startOffCall

memory cstringEndsWithSuffix mutable ewIdx I64 0
label ewLoop
call ewDoneCall math.greaterThanOrEqualI64
argument ewDoneCall left I64 ewIdx
argument ewDoneCall right I64 suffLen
run ewDoneCall
bind value ewDoneB Bool ewDoneCall
branch if condition ewDoneB target ewTrue

call ewSuffLoadCall pointer.loadByte
argument ewSuffLoadCall buffer COpaqueMemoryAddress suffixText
argument ewSuffLoadCall offset CByteCount ewIdx
run ewSuffLoadCall
bind value ewSuffByte I8 ewSuffLoadCall
call ewSOffCall math.addI64
argument ewSOffCall left I64 ewStart
argument ewSOffCall right I64 ewIdx
run ewSOffCall
bind value ewSOff I64 ewSOffCall
call ewSLoadCall pointer.loadByte
argument ewSLoadCall buffer COpaqueMemoryAddress inputText
argument ewSLoadCall offset CByteCount ewSOff
run ewSLoadCall
bind value ewSByte I8 ewSLoadCall
call ewEqCall math.equalI64
argument ewEqCall left I64 ewSuffByte
argument ewEqCall right I64 ewSByte
run ewEqCall
bind value ewEqB Bool ewEqCall
branch if condition ewEqB target ewAdv
branch else target ewFalse
label ewAdv
call ewIncCall math.addI64
argument ewIncCall left I64 ewIdx
argument ewIncCall right I64 oneEw
run ewIncCall
bind value ewNext I64 ewIncCall
set memory ewIdx ewNext
jump target ewLoop

label ewTrue
return value trueEw
label ewFalse
return value falseEw
