memory findSubstringInCString stack max 1024
async findSubstringInCString no
purpose operation findSubstringInCString "Pure-SemanticScript naive substring search. Returns offset of needle in haystack, or -1 if absent. Special case: needle empty -> 0."
invariant operation findSubstringInCString "For each starting offset in haystack, walks needle forward; returns the first start where every needle byte matches."

label startFindSubstringInCString
storage module immutable zeroI64e I64 0
storage module immutable oneI64e I64 1
storage module immutable negOneI64e I64 -1
memory findSubstringInCString mutable hStart I64 0

label strstrOuter
call peekNeedleCall pointer.loadByte
argument peekNeedleCall buffer COpaqueMemoryAddress targetSubstring
argument peekNeedleCall offset CByteCount zeroI64e
run peekNeedleCall
bind value needleHead I8 peekNeedleCall
call needleEmptyCall math.equalI64
argument needleEmptyCall left I64 needleHead
argument needleEmptyCall right I64 zeroI64e
run needleEmptyCall
bind value needleEmpty Bool needleEmptyCall
branch if condition needleEmpty target strstrFound

call peekHaystackCall pointer.loadByte
argument peekHaystackCall buffer COpaqueMemoryAddress searchText
argument peekHaystackCall offset CByteCount hStart
run peekHaystackCall
bind value haystackHere I8 peekHaystackCall
call haystackEndCall math.equalI64
argument haystackEndCall left I64 haystackHere
argument haystackEndCall right I64 zeroI64e
run haystackEndCall
bind value haystackAtEnd Bool haystackEndCall
branch if condition haystackAtEnd target strstrNotFound

memory findSubstringInCString mutable matchOffset I64 0
label strstrInner
call innerNeedleCall pointer.loadByte
argument innerNeedleCall buffer COpaqueMemoryAddress targetSubstring
argument innerNeedleCall offset CByteCount matchOffset
run innerNeedleCall
bind value innerNeedleByte I8 innerNeedleCall
call innerNeedleEndCall math.equalI64
argument innerNeedleEndCall left I64 innerNeedleByte
argument innerNeedleEndCall right I64 zeroI64e
run innerNeedleEndCall
bind value innerNeedleEnd Bool innerNeedleEndCall
branch if condition innerNeedleEnd target strstrFound

call innerHaystackOffsetCall math.addI64
argument innerHaystackOffsetCall left I64 hStart
argument innerHaystackOffsetCall right I64 matchOffset
run innerHaystackOffsetCall
bind value innerHaystackOffset I64 innerHaystackOffsetCall
call innerHaystackLoadCall pointer.loadByte
argument innerHaystackLoadCall buffer COpaqueMemoryAddress searchText
argument innerHaystackLoadCall offset CByteCount innerHaystackOffset
run innerHaystackLoadCall
bind value innerHaystackByte I8 innerHaystackLoadCall

call innerHEndCall math.equalI64
argument innerHEndCall left I64 innerHaystackByte
argument innerHEndCall right I64 zeroI64e
run innerHEndCall
bind value innerHAtEnd Bool innerHEndCall
branch if condition innerHAtEnd target strstrAdvance

call innerEqCall math.equalI64
argument innerEqCall left I64 innerNeedleByte
argument innerEqCall right I64 innerHaystackByte
run innerEqCall
bind value innerEq Bool innerEqCall
branch if condition innerEq target strstrInnerAdvance
branch else target strstrAdvance

label strstrInnerAdvance
call innerIncCall math.addI64
argument innerIncCall left I64 matchOffset
argument innerIncCall right I64 oneI64e
run innerIncCall
bind value matchNext I64 innerIncCall
set memory matchOffset matchNext
jump target strstrInner

label strstrAdvance
set memory matchOffset zeroI64e
call outerIncCall math.addI64
argument outerIncCall left I64 hStart
argument outerIncCall right I64 oneI64e
run outerIncCall
bind value hStartNext I64 outerIncCall
set memory hStart hStartNext
jump target strstrOuter

label strstrFound
return value hStart

label strstrNotFound
return value negOneI64e

