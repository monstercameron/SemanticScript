bind value ncpAlreadyAtEnd Bool ncpReachedCheckCall
branch if condition ncpAlreadyAtEnd target ncpPadZero

call ncpLoadCall pointer.loadByte
argument ncpLoadCall buffer COpaqueMemoryAddress sourceBuffer
argument ncpLoadCall offset CByteCount ncpIdx
run ncpLoadCall
bind value ncpByte I8 ncpLoadCall

call ncpIsEndCall math.equalI64
argument ncpIsEndCall left I64 ncpByte
argument ncpIsEndCall right I64 zeroNcp
run ncpIsEndCall
bind value ncpIsEnd Bool ncpIsEndCall
branch if condition ncpIsEnd target ncpEnterPadMode

call ncpStoreCall pointer.storeByte
argument ncpStoreCall buffer COpaqueMemoryAddress destinationBuffer
argument ncpStoreCall offset CByteCount ncpIdx
argument ncpStoreCall value CSignedInt64 ncpByte
run ncpStoreCall
jump target ncpAdvance

label ncpEnterPadMode
set memory ncpReachedNul oneNcp
jump target ncpPadZero

label ncpPadZero
call ncpZeroStoreCall pointer.storeByte
argument ncpZeroStoreCall buffer COpaqueMemoryAddress destinationBuffer
argument ncpZeroStoreCall offset CByteCount ncpIdx
argument ncpZeroStoreCall value CSignedInt64 zeroNcp
run ncpZeroStoreCall
jump target ncpAdvance

label ncpAdvance
call ncpIncCall math.addI64
argument ncpIncCall left I64 ncpIdx
argument ncpIncCall right I64 oneNcp
run ncpIncCall
bind value ncpNext I64 ncpIncCall
set memory ncpIdx ncpNext
jump target ncpLoop

label strncpyReturn
return value maxByteCount

operation countInitialCStringBytesNotInRejectSet
input operation countInitialCStringBytesNotInRejectSet inputText CNullTerminatedByteString
input operation countInitialCStringBytesNotInRejectSet rejectedCharacters CNullTerminatedByteString
output operation countInitialCStringBytesNotInRejectSet CByteCount
useCapability countInitialCStringBytesNotInRejectSet memoryBufferReadCapability
effect countInitialCStringBytesNotInRejectSet read memory.buffer
memory countInitialCStringBytesNotInRejectSet heap no
memory countInitialCStringBytesNotInRejectSet stack max 1024
async countInitialCStringBytesNotInRejectSet no
purpose operation countInitialCStringBytesNotInRejectSet "Length of leading prefix of s NOT containing any byte in reject. Pure SemanticScript: O(len(s) * len(reject))."
invariant operation countInitialCStringBytesNotInRejectSet "Walks forward while the current byte does NOT appear in rejectSet; stops at the first byte in the set or NUL."

label startCountInitialCStringBytesNotInRejectSet
storage module immutable zeroCs I64 0
storage module immutable oneCs I64 1
memory countInitialCStringBytesNotInRejectSet mutable csIdx I64 0

label cspnSLoop
call cspnLoadSCall pointer.loadByte
argument cspnLoadSCall buffer COpaqueMemoryAddress inputText
argument cspnLoadSCall offset CByteCount csIdx
run cspnLoadSCall
bind value cspnSByte I8 cspnLoadSCall
call cspnSEndCall math.equalI64
argument cspnSEndCall left I64 cspnSByte
argument cspnSEndCall right I64 zeroCs
run cspnSEndCall
bind value cspnSAtEnd Bool cspnSEndCall
branch if condition cspnSAtEnd target cspnDone

memory countInitialCStringBytesNotInRejectSet mutable aIdxCs I64 0
label cspnALoop
call cspnLoadACall pointer.loadByte
argument cspnLoadACall buffer COpaqueMemoryAddress rejectedCharacters
argument cspnLoadACall offset CByteCount aIdxCs
run cspnLoadACall
bind value cspnAByte I8 cspnLoadACall
call cspnAEndCall math.equalI64
argument cspnAEndCall left I64 cspnAByte
argument cspnAEndCall right I64 zeroCs
run cspnAEndCall
bind value cspnAAtEnd Bool cspnAEndCall
branch if condition cspnAAtEnd target cspnAdvanceS

call cspnMatchCall math.equalI64
argument cspnMatchCall left I64 cspnAByte
argument cspnMatchCall right I64 cspnSByte
run cspnMatchCall
bind value cspnMatch Bool cspnMatchCall
branch if condition cspnMatch target cspnDone

call cspnAIncCall math.addI64
argument cspnAIncCall left I64 aIdxCs
argument cspnAIncCall right I64 oneCs
run cspnAIncCall
bind value cspnANext I64 cspnAIncCall
set memory aIdxCs cspnANext
jump target cspnALoop

label cspnAdvanceS
set memory aIdxCs zeroCs
call cspnSIncCall math.addI64
argument cspnSIncCall left I64 csIdx
argument cspnSIncCall right I64 oneCs
run cspnSIncCall
bind value cspnSNext I64 cspnSIncCall
set memory csIdx cspnSNext
jump target cspnSLoop

label cspnDone
return value csIdx

operation findFirstCStringByteInAcceptSet
