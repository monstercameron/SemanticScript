# ============================================================
# SEMANTICSCRIPT STANDARD LIBRARY TESTS: bitwise operations
# ============================================================
#
# rationale: companion test file for std/bit/main.sem. Imports
#   the bit module and exercises every operation it exports â€”
#   shift / set / clear / toggle / predicate â€” with multiple cases
#   per op (identity, boundary, inverse, round-trip, property).
#
# invariant: success prints "OK\n" and exits 0; any failed
#   assertion surfaces MainError.BitSmokeAssertionFailed.
#
# # pattern: this is the canonical main.test.sem form â€” same
#   directory as main.sem, importModule foo, project block local
#   to the test, entry console main. The implementation file
#   std/bit/main.sem carries no smoke main itself.

project StdBitTest
target console
runtime AgentRuntime 0.1
entry console main

import bit standard.bit
error MainError
errorCase MainError BitSmokeAssertionFailed
errorCase MainError ConsoleWriteFailed

# section capability
# rationale: smoke-test main writes a single OK line to stdout.
capability stdoutWriteCapability console.stdout write

# ============================================================
# Smoke test
# ============================================================

operation main
input operation main console Console
output operation main Result ExitCode MainError
useCapability main stdoutWriteCapability
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Smoke-test the bit operations end-to-end."
invariant operation main "shift / set / clear / toggle / predicate all produce the expected values."

label startMain
storage module immutable threeValue CSignedInt64 3
storage module immutable fourValue CSignedInt64 4
storage module immutable fortyEightValue CSignedInt64 48
storage module immutable zeroValue CSignedInt64 0
storage module immutable eightValue CSignedInt64 8
storage module immutable fifteenValue CSignedInt64 15
storage module immutable oneValue CSignedInt64 1
storage module immutable thirteenValue CSignedInt64 13
storage module immutable fiveValue CSignedInt64 5
storage module immutable sevenValue CSignedInt64 7

# shiftSignedInt64BitsLeft(3, 4) == 48
call assertShiftLeftCall shiftSignedInt64BitsLeft
argument assertShiftLeftCall inputValue CSignedInt64 threeValue
argument assertShiftLeftCall bitIndex CSignedInt64 fourValue
run assertShiftLeftCall
bind value shiftLeftResult CSignedInt64 assertShiftLeftCall
call checkShiftLeftCall math.equalI64
argument checkShiftLeftCall left I64 shiftLeftResult
argument checkShiftLeftCall right I64 fortyEightValue
run checkShiftLeftCall
bind value shiftLeftOk Bool checkShiftLeftCall
branch if condition shiftLeftOk target shiftLeftHolds
branch else target smokeAssertionFailed
label shiftLeftHolds

# shiftSignedInt64BitsRight(48, 4) == 3
call assertShiftRightCall shiftSignedInt64BitsRight
argument assertShiftRightCall inputValue CSignedInt64 fortyEightValue
argument assertShiftRightCall bitIndex CSignedInt64 fourValue
run assertShiftRightCall
bind value shiftRightResult CSignedInt64 assertShiftRightCall
call checkShiftRightCall math.equalI64
argument checkShiftRightCall left I64 shiftRightResult
argument checkShiftRightCall right I64 threeValue
run checkShiftRightCall
bind value shiftRightOk Bool checkShiftRightCall
branch if condition shiftRightOk target shiftRightHolds
branch else target smokeAssertionFailed
label shiftRightHolds

# isSignedInt64BitSet(48, 4) == true (48 == 0b110000, bit 4 is set)
call assertBitSetCall isSignedInt64BitSet
argument assertBitSetCall inputValue CSignedInt64 fortyEightValue
argument assertBitSetCall bitIndex CSignedInt64 fourValue
run assertBitSetCall
bind value bitSetResult Bool assertBitSetCall
branch if condition bitSetResult target bitSetHolds
branch else target smokeAssertionFailed
label bitSetHolds

# setSignedInt64Bit(0, 3) == 8
call assertSetBitCall setSignedInt64Bit
argument assertSetBitCall inputValue CSignedInt64 zeroValue
argument assertSetBitCall bitIndex CSignedInt64 threeValue
run assertSetBitCall
bind value setBitResult CSignedInt64 assertSetBitCall
call checkSetBitCall math.equalI64
argument checkSetBitCall left I64 setBitResult
argument checkSetBitCall right I64 eightValue
run checkSetBitCall
bind value setBitOk Bool checkSetBitCall
branch if condition setBitOk target setBitHolds
branch else target smokeAssertionFailed
label setBitHolds

# clearSignedInt64Bit(15, 1) == 13
call assertClearBitCall clearSignedInt64Bit
argument assertClearBitCall inputValue CSignedInt64 fifteenValue
argument assertClearBitCall bitIndex CSignedInt64 oneValue
run assertClearBitCall
bind value clearBitResult CSignedInt64 assertClearBitCall
call checkClearBitCall math.equalI64
argument checkClearBitCall left I64 clearBitResult
argument checkClearBitCall right I64 thirteenValue
run checkClearBitCall
bind value clearBitOk Bool checkClearBitCall
branch if condition clearBitOk target clearBitHolds
branch else target smokeAssertionFailed
label clearBitHolds

# toggleSignedInt64Bit(5, 1) == 7
call assertToggleBitCall toggleSignedInt64Bit
argument assertToggleBitCall inputValue CSignedInt64 fiveValue
argument assertToggleBitCall bitIndex CSignedInt64 oneValue
run assertToggleBitCall
bind value toggleBitResult CSignedInt64 assertToggleBitCall
call checkToggleBitCall math.equalI64
argument checkToggleBitCall left I64 toggleBitResult
argument checkToggleBitCall right I64 sevenValue
run checkToggleBitCall
bind value toggleBitOk Bool checkToggleBitCall
branch if condition toggleBitOk target toggleBitHolds
branch else target smokeAssertionFailed
label toggleBitHolds

# Regression (negative input): bit 63 of -1 is set. -1 is all-ones in
# two's complement, so every bit is 1. The pre-optimization sdiv-based
# implementation computed (-1 / 2^63) == 0 and reported the bit clear;
# the logical-shift version reads the real bit pattern.
storage module immutable negativeOneForBit CSignedInt64 -1
storage module immutable bitIndexSixtyThree CSignedInt64 63
call assertNegativeBitSetCall isSignedInt64BitSet
argument assertNegativeBitSetCall inputValue CSignedInt64 negativeOneForBit
argument assertNegativeBitSetCall bitIndex CSignedInt64 bitIndexSixtyThree
run assertNegativeBitSetCall
bind value negativeBitSetResult Bool assertNegativeBitSetCall
branch if condition negativeBitSetResult target negativeBitSetHolds
branch else target smokeAssertionFailed
label negativeBitSetHolds

storage module immutable successMessageText CNullTerminatedByteString "OK"
call writeSuccessLineCall console.writeLine
argument writeSuccessLineCall console Console console
argument writeSuccessLineCall text CNullTerminatedByteString successMessageText
run writeSuccessLineCall
ignore ok source writeSuccessLineCall type CSignedInt32
bind error consoleWriteResultError CSignedInt32 writeSuccessLineCall
branch error source writeSuccessLineCall target consoleWriteFailedHandler
storage module immutable exitOkCode ExitCode 0
return ok exitOkCode

# Failure leg: surface the raw negative CSignedInt32 from
# console.writeLine as the cause attached to the typed
# MainError.ConsoleWriteFailed variant.
label consoleWriteFailedHandler
makeError consoleWriteFailedFailure MainError.ConsoleWriteFailed consoleWriteResultError
return error consoleWriteFailedFailure
label smokeAssertionFailed
makeError bitSmokeFailure MainError.BitSmokeAssertionFailed
return error bitSmokeFailure
