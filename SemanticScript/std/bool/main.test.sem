# ============================================================
# SEMANTICSCRIPT STDLIB TESTS: bool
# ============================================================
#
# Companion smoke + extended unit tests for std/bool/main.sem.
# Imports the bool module and asserts every exported combinator
# (negate / and / or / xor / equivalent / convertToCInt /
# convertFromCInt) plus involution / commutativity / de Morgan /
# round-trip property tests.
#
# Pattern: std/main.sem ships pure-module operations only;
# std/main.test.sem carries every smoke / unit test for it.

project StdBoolTest
target console
runtime AgentRuntime 0.1
entry console main

import bool standard.bool
# Typed error domain used only by this smoke test. The library
# operations themselves are total and declare no errors.
error MainError
errorCase MainError BooleanSmokeAssertionFailed
errorCase MainError ConsoleWriteFailed

# section capability
# rationale: smoke-test main writes a single OK line to stdout.
capability stdoutWriteCapability console.stdout write

# ============================================================
# Smoke test
# ============================================================

operation main
input operation main console Console
output operation main Result ExitCode MainError
useCapability main stdoutWriteCapability
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Smoke-test refined Bool combinators end-to-end. Prints OK then exits 0."
invariant operation main "Exit 0 when every assertion holds; returnError with BooleanSmokeAssertionFailed otherwise."
# observability: the success path writes the literal "OK\n" so a CI
#   diff can pin the expected output; the failure path is observable
#   through the non-zero exit code only.

label startMain

# Verify negateBoolean(false) == true.
call assertNegateFalseCall negateBoolean
argument assertNegateFalseCall valueToNegate Bool canonicalBooleanFalse
run assertNegateFalseCall
bind value negateFalseResult Bool assertNegateFalseCall
branch if condition negateFalseResult target negateFalseHolds
branch else target smokeAssertionFailed
label negateFalseHolds

# Verify andBooleans(true, true) == true.
call assertAndTrueTrueCall andBooleans
argument assertAndTrueTrueCall firstOperand Bool canonicalBooleanTrue
argument assertAndTrueTrueCall secondOperand Bool canonicalBooleanTrue
run assertAndTrueTrueCall
bind value andTrueTrueResult Bool assertAndTrueTrueCall
branch if condition andTrueTrueResult target andTrueTrueHolds
branch else target smokeAssertionFailed
label andTrueTrueHolds

# Verify andBooleans(true, false) == false.
call assertAndTrueFalseCall andBooleans
argument assertAndTrueFalseCall firstOperand Bool canonicalBooleanTrue
argument assertAndTrueFalseCall secondOperand Bool canonicalBooleanFalse
run assertAndTrueFalseCall
bind value andTrueFalseResult Bool assertAndTrueFalseCall
branch if condition andTrueFalseResult target smokeAssertionFailed

# Verify orBooleans(false, true) == true.
call assertOrFalseTrueCall orBooleans
argument assertOrFalseTrueCall firstOperand Bool canonicalBooleanFalse
argument assertOrFalseTrueCall secondOperand Bool canonicalBooleanTrue
run assertOrFalseTrueCall
bind value orFalseTrueResult Bool assertOrFalseTrueCall
branch if condition orFalseTrueResult target orFalseTrueHolds
branch else target smokeAssertionFailed
label orFalseTrueHolds

# Verify exclusiveOrBooleans(true, false) == true.
call assertXorTrueFalseCall exclusiveOrBooleans
argument assertXorTrueFalseCall firstOperand Bool canonicalBooleanTrue
argument assertXorTrueFalseCall secondOperand Bool canonicalBooleanFalse
run assertXorTrueFalseCall
bind value xorTrueFalseResult Bool assertXorTrueFalseCall
branch if condition xorTrueFalseResult target xorTrueFalseHolds
branch else target smokeAssertionFailed
label xorTrueFalseHolds

# Verify exclusiveOrBooleans(true, true) == false.
call assertXorTrueTrueCall exclusiveOrBooleans
argument assertXorTrueTrueCall firstOperand Bool canonicalBooleanTrue
argument assertXorTrueTrueCall secondOperand Bool canonicalBooleanTrue
run assertXorTrueTrueCall
bind value xorTrueTrueResult Bool assertXorTrueTrueCall
branch if condition xorTrueTrueResult target smokeAssertionFailed

# Verify areBooleansEquivalent(true, true) == true.
call assertEquivTrueTrueCall areBooleansEquivalent
argument assertEquivTrueTrueCall firstOperand Bool canonicalBooleanTrue
argument assertEquivTrueTrueCall secondOperand Bool canonicalBooleanTrue
run assertEquivTrueTrueCall
bind value equivTrueTrueResult Bool assertEquivTrueTrueCall
branch if condition equivTrueTrueResult target equivTrueTrueHolds
branch else target smokeAssertionFailed
label equivTrueTrueHolds

# Verify convertBooleanToCSignedInt32(true) == 1.
call convertTrueToIntCall convertBooleanToCSignedInt32
argument convertTrueToIntCall sourceBoolean Bool canonicalBooleanTrue
run convertTrueToIntCall
bind value trueAsCInt CSignedInt32 convertTrueToIntCall
storage module immutable oneI32Expected CSignedInt32 1
call checkConvertTrueCall math.equalI64
argument checkConvertTrueCall left I64 trueAsCInt
argument checkConvertTrueCall right I64 oneI32Expected
run checkConvertTrueCall
bind value convertTrueOk Bool checkConvertTrueCall
branch if condition convertTrueOk target convertTrueHolds
branch else target smokeAssertionFailed
label convertTrueHolds

# Verify convertCSignedInt32ToBoolean(0) == false.
storage module immutable zeroI32Input CSignedInt32 0
call convertZeroToBoolCall convertCSignedInt32ToBoolean
argument convertZeroToBoolCall sourceCSignedInt32Value CSignedInt32 zeroI32Input
run convertZeroToBoolCall
bind value zeroAsBool Bool convertZeroToBoolCall
branch if condition zeroAsBool target smokeAssertionFailed

# ============================================================
# Extended unit tests: missing cases (negate(true), and(false,false),
# convertBack(1)) plus involution, commutativity, and de Morgan
# property tests over the four Bool combinations.
# ============================================================

# negate(true) == false
call negateTrueCall negateBoolean
argument negateTrueCall valueToNegate Bool canonicalBooleanTrue
run negateTrueCall
bind value negateTrueResult Bool negateTrueCall
branch if condition negateTrueResult target smokeAssertionFailed
branch else target negateTrueHolds
label negateTrueHolds

# Involution: negate(negate(true)) == true
call invStep1Call negateBoolean
argument invStep1Call valueToNegate Bool canonicalBooleanTrue
run invStep1Call
bind value invStep1Result Bool invStep1Call
call invStep2Call negateBoolean
argument invStep2Call valueToNegate Bool invStep1Result
run invStep2Call
bind value invStep2Result Bool invStep2Call
branch if condition invStep2Result target invHolds
branch else target smokeAssertionFailed
label invHolds

# and(false, false) == false
call andFalseFalseCall andBooleans
argument andFalseFalseCall firstOperand Bool canonicalBooleanFalse
argument andFalseFalseCall secondOperand Bool canonicalBooleanFalse
run andFalseFalseCall
bind value andFalseFalseResult Bool andFalseFalseCall
branch if condition andFalseFalseResult target smokeAssertionFailed
branch else target andFalseFalseHolds
label andFalseFalseHolds

# or(false, false) == false
call orFalseFalseCall orBooleans
argument orFalseFalseCall firstOperand Bool canonicalBooleanFalse
argument orFalseFalseCall secondOperand Bool canonicalBooleanFalse
run orFalseFalseCall
bind value orFalseFalseResult Bool orFalseFalseCall
branch if condition orFalseFalseResult target smokeAssertionFailed
branch else target orFalseFalseHolds
label orFalseFalseHolds

# or(true, true) == true
call orTrueTrueCall orBooleans
argument orTrueTrueCall firstOperand Bool canonicalBooleanTrue
argument orTrueTrueCall secondOperand Bool canonicalBooleanTrue
run orTrueTrueCall
bind value orTrueTrueResult Bool orTrueTrueCall
branch if condition orTrueTrueResult target orTrueTrueHolds
branch else target smokeAssertionFailed
label orTrueTrueHolds

# Commutativity: xor(true, false) == xor(false, true)
call xorTFCall exclusiveOrBooleans
argument xorTFCall firstOperand Bool canonicalBooleanTrue
argument xorTFCall secondOperand Bool canonicalBooleanFalse
run xorTFCall
bind value xorTFResult Bool xorTFCall
call xorFTCall exclusiveOrBooleans
argument xorFTCall firstOperand Bool canonicalBooleanFalse
argument xorFTCall secondOperand Bool canonicalBooleanTrue
run xorFTCall
bind value xorFTResult Bool xorFTCall
call xorCommutativeCall areBooleansEquivalent
argument xorCommutativeCall firstOperand Bool xorTFResult
argument xorCommutativeCall secondOperand Bool xorFTResult
run xorCommutativeCall
bind value xorCommutativeResult Bool xorCommutativeCall
branch if condition xorCommutativeResult target xorCommHolds
branch else target smokeAssertionFailed
label xorCommHolds

# De Morgan: negate(and(true, false)) == or(negate(true), negate(false))
# = negate(false) == or(false, true)
# = true == true
call deMorganAndCall andBooleans
argument deMorganAndCall firstOperand Bool canonicalBooleanTrue
argument deMorganAndCall secondOperand Bool canonicalBooleanFalse
run deMorganAndCall
bind value deMorganAndResult Bool deMorganAndCall
call deMorganLhsCall negateBoolean
argument deMorganLhsCall valueToNegate Bool deMorganAndResult
run deMorganLhsCall
bind value deMorganLhsResult Bool deMorganLhsCall
call deMorganNegFirstCall negateBoolean
argument deMorganNegFirstCall valueToNegate Bool canonicalBooleanTrue
run deMorganNegFirstCall
bind value deMorganNegFirstResult Bool deMorganNegFirstCall
call deMorganNegSecondCall negateBoolean
argument deMorganNegSecondCall valueToNegate Bool canonicalBooleanFalse
run deMorganNegSecondCall
bind value deMorganNegSecondResult Bool deMorganNegSecondCall
call deMorganRhsCall orBooleans
argument deMorganRhsCall firstOperand Bool deMorganNegFirstResult
argument deMorganRhsCall secondOperand Bool deMorganNegSecondResult
run deMorganRhsCall
bind value deMorganRhsResult Bool deMorganRhsCall
call deMorganEquivCall areBooleansEquivalent
argument deMorganEquivCall firstOperand Bool deMorganLhsResult
argument deMorganEquivCall secondOperand Bool deMorganRhsResult
run deMorganEquivCall
bind value deMorganEquivResult Bool deMorganEquivCall
branch if condition deMorganEquivResult target deMorganHolds
branch else target smokeAssertionFailed
label deMorganHolds

# convertBooleanToCSignedInt32(false) == 0
call convertFalseToIntCall convertBooleanToCSignedInt32
argument convertFalseToIntCall sourceBoolean Bool canonicalBooleanFalse
run convertFalseToIntCall
bind value falseAsCInt CSignedInt32 convertFalseToIntCall
call checkConvertFalseCall math.equalI64
argument checkConvertFalseCall left I64 falseAsCInt
argument checkConvertFalseCall right I64 zeroI32Input
run checkConvertFalseCall
bind value convertFalseOk Bool checkConvertFalseCall
branch if condition convertFalseOk target convertFalseHolds
branch else target smokeAssertionFailed
label convertFalseHolds

# convertCSignedInt32ToBoolean(1) == true
call convertOneToBoolCall convertCSignedInt32ToBoolean
argument convertOneToBoolCall sourceCSignedInt32Value CSignedInt32 oneI32Expected
run convertOneToBoolCall
bind value oneAsBool Bool convertOneToBoolCall
branch if condition oneAsBool target oneAsBoolHolds
branch else target smokeAssertionFailed
label oneAsBoolHolds

# Round trip: convertCSignedInt32ToBoolean(convertBooleanToCSignedInt32(true)) == true
call roundTripBoolToIntCall convertBooleanToCSignedInt32
argument roundTripBoolToIntCall sourceBoolean Bool canonicalBooleanTrue
run roundTripBoolToIntCall
bind value roundTripIntValue CSignedInt32 roundTripBoolToIntCall
call roundTripIntToBoolCall convertCSignedInt32ToBoolean
argument roundTripIntToBoolCall sourceCSignedInt32Value CSignedInt32 roundTripIntValue
run roundTripIntToBoolCall
bind value roundTripBoolResult Bool roundTripIntToBoolCall
branch if condition roundTripBoolResult target roundTripBoolHolds
branch else target smokeAssertionFailed
label roundTripBoolHolds

# All assertions hold. Emit OK\n and exit 0.
storage module immutable successMessageText CNullTerminatedByteString "OK"
call writeSuccessLineCall console.writeLine
argument writeSuccessLineCall console Console console
argument writeSuccessLineCall text CNullTerminatedByteString successMessageText
run writeSuccessLineCall
ignore ok source writeSuccessLineCall type CSignedInt32
bind error consoleWriteResultError CSignedInt32 writeSuccessLineCall
branch error source writeSuccessLineCall target consoleWriteFailedHandler
storage module immutable exitOkCode ExitCode 0
return ok exitOkCode

# Failure leg: surface the raw negative CSignedInt32 from
# console.writeLine as the cause attached to the typed
# MainError.ConsoleWriteFailed variant.
label consoleWriteFailedHandler
makeError consoleWriteFailedFailure MainError.ConsoleWriteFailed consoleWriteResultError
return error consoleWriteFailedFailure
label smokeAssertionFailed
makeError booleanSmokeFailure MainError.BooleanSmokeAssertionFailed
return error booleanSmokeFailure
