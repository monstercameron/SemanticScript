# ============================================================
# SEMANTICSCRIPT STANDARD LIBRARY TESTS: bulk memory operations
# ============================================================
#
# rationale: companion test file for std/memory/main.sem. Imports
#   the memory module and exercises every operation it exports â€”
#   copy / move / fill / zero / compare / find / hash â€” including
#   boundary cases (empty buffer, not-found, overlap, determinism).
#
# invariant: success prints "OK\n" and exits 0; assertion failures
#   surface MainError.MemorySmokeAssertionFailed; heap allocation
#   failure surfaces MainError.MemoryAllocationFailed.
#
# # pattern: this is the canonical main.test.sem form â€” same directory
#   as main.sem, importModule foo, project block local to the test,
#   entry console main. The implementation file std/memory/main.sem
#   carries no smoke main itself.

project StdMemoryTest
target console
runtime AgentRuntime 0.1
entry console main

import memory standard.memory
error MainError
errorCase MainError MemorySmokeAssertionFailed
errorCase MainError ConsoleWriteFailed
errorCase MainError MemoryAllocationFailed

# section capability
# rationale: smoke-test main writes a single OK line to stdout.
capability stdoutWriteCapability console.stdout write
# Smoke-test main allocates and frees a working buffer via libc.
capability heapAllocationCapability heap allocate
capability heapFreeCapability heap free

# ============================================================
# Smoke test
# ============================================================

operation main
input operation main console Console
output operation main Result ExitCode MainError
useCapability main stdoutWriteCapability
useCapability main heapAllocationCapability
useCapability main heapFreeCapability
effect main allocate heap
effect main free heap
effect main write console.stdout
memory main heap yes
memoryStackLimit main 4096
memoryAllocationSource main allocateBufferCall
async main no
purpose operation main "Smoke-test copy / fill / compare / find on a heap-allocated buffer."
invariant operation main "Smoke fails closed: malloc failure surfaces MemoryAllocationFailed; any assertion failure surfaces MemorySmokeAssertionFailed."

label startMain
storage module immutable allocSize CByteCount 16
call allocateBufferCall c.malloc
argument allocateBufferCall size CByteCount allocSize
run allocateBufferCall
bind value workBuffer COpaqueMemoryAddress allocateBufferCall
bind error heapAllocationError CSignedInt32 allocateBufferCall
branch error source allocateBufferCall target heapAllocationFailedHandler
defer releaseAllocateBufferCall c.free workBuffer

storage module immutable upperALetterCode CSignedInt32 65
storage module immutable fiveByteCount CByteCount 5
storage module immutable fiveAsAscii CNullTerminatedByteString "AAAAA"
storage module immutable helloLiteralForMemory CNullTerminatedByteString "hello"
storage module immutable integerZeroBoundaryForMemoryLocal CSignedInt64 0

call runFillCall fillMemoryBytesWithValue
argument runFillCall byteBuffer COpaqueMemoryAddress workBuffer
argument runFillCall targetValue CSignedInt32 upperALetterCode
argument runFillCall byteCount CByteCount fiveByteCount
run runFillCall
ignore value source runFillCall type CByteCount

call assertFillCompareCall compareMemoryByteRanges
argument assertFillCompareCall leftBuffer CNullTerminatedByteString workBuffer
argument assertFillCompareCall rightBuffer CNullTerminatedByteString fiveAsAscii
argument assertFillCompareCall byteCount CByteCount fiveByteCount
run assertFillCompareCall
bind value fillCompareResult CSignedInt64 assertFillCompareCall
call checkFillCompareCall math.equalI64
argument checkFillCompareCall left I64 fillCompareResult
argument checkFillCompareCall right I64 integerZeroBoundaryForMemoryLocal
run checkFillCompareCall
bind value fillCompareOk Bool checkFillCompareCall
branch if condition fillCompareOk target fillCompareHolds
branch else target smokeAssertionFailed
label fillCompareHolds

call runCopyCall copyMemoryBytes
argument runCopyCall destinationBuffer COpaqueMemoryAddress workBuffer
argument runCopyCall sourceBuffer CNullTerminatedByteString helloLiteralForMemory
argument runCopyCall byteCount CByteCount fiveByteCount
run runCopyCall
ignore value source runCopyCall type CByteCount

call assertCopyCompareCall compareMemoryByteRanges
argument assertCopyCompareCall leftBuffer CNullTerminatedByteString workBuffer
argument assertCopyCompareCall rightBuffer CNullTerminatedByteString helloLiteralForMemory
argument assertCopyCompareCall byteCount CByteCount fiveByteCount
run assertCopyCompareCall
bind value copyCompareResult CSignedInt64 assertCopyCompareCall
call checkCopyCompareCall math.equalI64
argument checkCopyCompareCall left I64 copyCompareResult
argument checkCopyCompareCall right I64 integerZeroBoundaryForMemoryLocal
run checkCopyCompareCall
bind value copyCompareOk Bool checkCopyCompareCall
branch if condition copyCompareOk target copyCompareHolds
branch else target smokeAssertionFailed
label copyCompareHolds

# findByteValueInMemoryRange: 'l' in "hello" at offset 2
storage module immutable lowercaseLForMemory CSignedInt32 108
storage module immutable expectedFindOffset CSignedInt64 2
call assertFindCall findByteValueInMemoryRange
argument assertFindCall byteBuffer CNullTerminatedByteString workBuffer
argument assertFindCall targetValue CSignedInt32 lowercaseLForMemory
argument assertFindCall byteCount CByteCount fiveByteCount
run assertFindCall
bind value findResult CSignedInt64 assertFindCall
call checkFindCall math.equalI64
argument checkFindCall left I64 findResult
argument checkFindCall right I64 expectedFindOffset
run checkFindCall
bind value findOk Bool checkFindCall
branch if condition findOk target findHolds
branch else target smokeAssertionFailed
label findHolds

# ============================================================
# Extended unit tests: covers the 3 ops the smoke previously
# omitted (moveMemoryBytesAllowOverlap, zeroMemoryBytes,
# hashMemoryBytesWithFnv1a) plus boundary / property cases.
# ============================================================

storage module immutable zeroByteCountMem CByteCount 0
storage module immutable helloAgainLiteral CNullTerminatedByteString "hello"
storage module immutable lowercaseZForMem CSignedInt32 122

# zeroMemoryBytes: zero out the first 5 bytes of the buffer, then
# verify byte at offset 0 is 0 via findByteValueInMemoryRange.
call runZeroCall zeroMemoryBytes
argument runZeroCall byteBuffer COpaqueMemoryAddress workBuffer
argument runZeroCall byteCount CByteCount fiveByteCount
run runZeroCall
ignore value source runZeroCall type CByteCount

storage module immutable nullByteCodeMem CSignedInt32 0
storage module immutable zeroOffset CSignedInt64 0
call findZeroCall findByteValueInMemoryRange
argument findZeroCall byteBuffer CNullTerminatedByteString workBuffer
argument findZeroCall targetValue CSignedInt32 nullByteCodeMem
argument findZeroCall byteCount CByteCount fiveByteCount
run findZeroCall
bind value findZeroResult CSignedInt64 findZeroCall
call checkFindZeroCall math.equalI64
argument checkFindZeroCall left I64 findZeroResult
argument checkFindZeroCall right I64 zeroOffset
run checkFindZeroCall
bind value findZeroOk Bool checkFindZeroCall
branch if condition findZeroOk target findZeroHolds
branch else target smokeAssertionFailed
label findZeroHolds

# Re-copy "hello" into the buffer, then test moveMemoryBytesAllowOverlap.
# After move from buffer[0..5] to buffer[2..7] (overlapping right), the
# 5-byte content at offset 2 should be "hello".
call refillCopyCall copyMemoryBytes
argument refillCopyCall destinationBuffer COpaqueMemoryAddress workBuffer
argument refillCopyCall sourceBuffer CNullTerminatedByteString helloAgainLiteral
argument refillCopyCall byteCount CByteCount fiveByteCount
run refillCopyCall
ignore value source refillCopyCall type CByteCount

# Compute destination = workBuffer + 2 via pointer arithmetic.
storage module immutable twoByteOffset CByteCount 2
call advanceForMoveCall pointer.offset
argument advanceForMoveCall base COpaqueMemoryAddress workBuffer
argument advanceForMoveCall offset CByteCount twoByteOffset
run advanceForMoveCall
bind value moveDestPtr COpaqueMemoryAddress advanceForMoveCall

call runMoveCall moveMemoryBytesAllowOverlap
argument runMoveCall destinationBuffer COpaqueMemoryAddress moveDestPtr
argument runMoveCall sourceBuffer CNullTerminatedByteString workBuffer
argument runMoveCall byteCount CByteCount fiveByteCount
run runMoveCall
ignore value source runMoveCall type CByteCount

# After overlapping move, bytes at offset 2..7 should be "hello".
call moveCompareCall compareMemoryByteRanges
argument moveCompareCall leftBuffer CNullTerminatedByteString moveDestPtr
argument moveCompareCall rightBuffer CNullTerminatedByteString helloAgainLiteral
argument moveCompareCall byteCount CByteCount fiveByteCount
run moveCompareCall
bind value moveCompareResult CSignedInt64 moveCompareCall
call checkMoveCompareCall math.equalI64
argument checkMoveCompareCall left I64 moveCompareResult
argument checkMoveCompareCall right I64 integerZeroBoundaryForMemoryLocal
run checkMoveCompareCall
bind value moveCompareOk Bool checkMoveCompareCall
branch if condition moveCompareOk target moveCompareHolds
branch else target smokeAssertionFailed
label moveCompareHolds

# hashMemoryBytesWithFnv1a: hash of zero-length buffer == initial offset basis.
storage module immutable expectedZeroHashBasis CSignedInt64 -3750763034362895579
call hashZeroCall hashMemoryBytesWithFnv1a
argument hashZeroCall byteBuffer CNullTerminatedByteString helloAgainLiteral
argument hashZeroCall byteCount CByteCount zeroByteCountMem
run hashZeroCall
bind value hashZeroResult CSignedInt64 hashZeroCall
call hashZeroCheckCall math.equalI64
argument hashZeroCheckCall left I64 hashZeroResult
argument hashZeroCheckCall right I64 expectedZeroHashBasis
run hashZeroCheckCall
bind value hashZeroOk Bool hashZeroCheckCall
branch if condition hashZeroOk target hashZeroHolds
branch else target smokeAssertionFailed
label hashZeroHolds

# Property: hash is deterministic â€” same input always produces same output.
call hashFirstCall hashMemoryBytesWithFnv1a
argument hashFirstCall byteBuffer CNullTerminatedByteString helloAgainLiteral
argument hashFirstCall byteCount CByteCount fiveByteCount
run hashFirstCall
bind value hashFirstResult CSignedInt64 hashFirstCall
call hashSecondCall hashMemoryBytesWithFnv1a
argument hashSecondCall byteBuffer CNullTerminatedByteString helloAgainLiteral
argument hashSecondCall byteCount CByteCount fiveByteCount
run hashSecondCall
bind value hashSecondResult CSignedInt64 hashSecondCall
call hashDeterministicCheckCall math.equalI64
argument hashDeterministicCheckCall left I64 hashFirstResult
argument hashDeterministicCheckCall right I64 hashSecondResult
run hashDeterministicCheckCall
bind value hashDeterministicOk Bool hashDeterministicCheckCall
branch if condition hashDeterministicOk target hashDeterministicHolds
branch else target smokeAssertionFailed
label hashDeterministicHolds

# Property: distinct inputs produce distinct hashes â€” hash("hello") != hash("world").
storage module immutable worldLiteralMem CNullTerminatedByteString "world"
call hashWorldCall hashMemoryBytesWithFnv1a
argument hashWorldCall byteBuffer CNullTerminatedByteString worldLiteralMem
argument hashWorldCall byteCount CByteCount fiveByteCount
run hashWorldCall
bind value hashWorldResult CSignedInt64 hashWorldCall
call hashDistinctCheckCall math.notEqualI64
argument hashDistinctCheckCall left I64 hashFirstResult
argument hashDistinctCheckCall right I64 hashWorldResult
run hashDistinctCheckCall
bind value hashDistinctOk Bool hashDistinctCheckCall
branch if condition hashDistinctOk target hashDistinctHolds
branch else target smokeAssertionFailed
label hashDistinctHolds

# findByteValueInMemoryRange: 'z' not in "hello" -> -1
storage module immutable negativeOneFindResult CSignedInt64 -1
call findNotFoundCall findByteValueInMemoryRange
argument findNotFoundCall byteBuffer CNullTerminatedByteString helloAgainLiteral
argument findNotFoundCall targetValue CSignedInt32 lowercaseZForMem
argument findNotFoundCall byteCount CByteCount fiveByteCount
run findNotFoundCall
bind value findNotFoundResult CSignedInt64 findNotFoundCall
call checkFindNotFoundCall math.equalI64
argument checkFindNotFoundCall left I64 findNotFoundResult
argument checkFindNotFoundCall right I64 negativeOneFindResult
run checkFindNotFoundCall
bind value findNotFoundOk Bool checkFindNotFoundCall
branch if condition findNotFoundOk target findNotFoundHolds
branch else target smokeAssertionFailed
label findNotFoundHolds

# Property: comparing buffer to itself returns 0
call selfCompareCall compareMemoryByteRanges
argument selfCompareCall leftBuffer CNullTerminatedByteString helloAgainLiteral
argument selfCompareCall rightBuffer CNullTerminatedByteString helloAgainLiteral
argument selfCompareCall byteCount CByteCount fiveByteCount
run selfCompareCall
bind value selfCompareResult CSignedInt64 selfCompareCall
call checkSelfCompareCall math.equalI64
argument checkSelfCompareCall left I64 selfCompareResult
argument checkSelfCompareCall right I64 integerZeroBoundaryForMemoryLocal
run checkSelfCompareCall
bind value selfCompareOk Bool checkSelfCompareCall
branch if condition selfCompareOk target selfCompareHolds
branch else target smokeAssertionFailed
label selfCompareHolds

storage module immutable successMessageText CNullTerminatedByteString "OK"
call writeSuccessLineCall console.writeLine
argument writeSuccessLineCall console Console console
argument writeSuccessLineCall text CNullTerminatedByteString successMessageText
run writeSuccessLineCall
ignore ok source writeSuccessLineCall type CSignedInt32
bind error consoleWriteResultError CSignedInt32 writeSuccessLineCall
branch error source writeSuccessLineCall target consoleWriteFailedHandler
storage module immutable exitOkCode ExitCode 0
return ok exitOkCode

# Failure leg: surface the raw negative CSignedInt32 from
# console.writeLine as the cause attached to the typed
# MainError.ConsoleWriteFailed variant.
label consoleWriteFailedHandler
makeError consoleWriteFailedFailure MainError.ConsoleWriteFailed consoleWriteResultError
return error consoleWriteFailedFailure
label smokeAssertionFailed
makeError memorySmokeFailure MainError.MemorySmokeAssertionFailed
return error memorySmokeFailure

# Heap-allocation failure leg: c.malloc returned NULL. Surface the
# typed MemoryAllocationFailed variant with the raw negative status
# as the cause. The deferred c.free does not fire here because the
# defer was registered AFTER this branch's branchIfError.
label heapAllocationFailedHandler
makeError heapAllocationFailure MainError.MemoryAllocationFailed heapAllocationError
return error heapAllocationFailure
