# ============================================================
# SEMANTICSCRIPT STANDARD LIBRARY TESTS: bulk memory operations
# ============================================================
#
# rationale: companion test file for std/memory/main.sem. Imports
#   the memory module and exercises every operation it exports â€”
#   copy / move / fill / zero / compare / find / hash â€” including
#   boundary cases (empty buffer, not-found, overlap, determinism).
#
# invariant: success prints "OK\n" and exits 0; assertion failures
#   surface MainError.MemorySmokeAssertionFailed; standard.memory allocation
#   failure surfaces MainError.MemoryAllocationFailed.
#
# # pattern: this is the canonical main.test.sem form â€” same directory
#   as main.sem, import foo standard.foo, project block local to the test,
#   entry console main. The implementation file std/memory/main.sem
#   carries no smoke main itself.

project StdMemoryTest
target console
runtime AgentRuntime 0.1
entry console main

import memory standard.memory
error MainError
errorCase MainError MemorySmokeAssertionFailed
errorCase MainError ConsoleWriteFailed
errorCase MainError MemoryAllocationFailed

# section capability
# rationale: smoke-test main writes a single OK line to stdout.
capability stdoutWriteCapability console.stdout write
# Smoke-test main allocates and frees a working buffer via standard.memory.
capability heapAllocationCapability heap allocate
capability heapFreeCapability heap free

# ============================================================
# Smoke test
# ============================================================

operation main
input operation main console Console
output operation main Result ExitCode MainError
useCapability main stdoutWriteCapability
useCapability main heapAllocationCapability
useCapability main heapFreeCapability
effect main allocate heap
effect main free heap
effect main write console.stdout
memory main heap yes
memory main stack max 4096
memoryAllocationSource main allocateBufferCall
async main no
purpose operation main "Smoke-test copy / fill / compare / find on a heap-allocated buffer."
invariant operation main "Smoke fails closed: allocation failure surfaces MemoryAllocationFailed; any assertion failure surfaces MemorySmokeAssertionFailed."

label startMain
storage module immutable allocSize ByteCount 16
call allocateBufferCall memory.allocateMemoryBytes
argument allocateBufferCall byteCount ByteCount allocSize
run allocateBufferCall
bind ok workBuffer OpaquePointer allocateBufferCall
bind error heapAllocationError MemoryAllocationError allocateBufferCall
branch error source allocateBufferCall target heapAllocationFailedHandler
defer releaseAllocateBufferCall memory.releaseMemoryBytes workBuffer

storage module immutable upperALetterCode Int32 65
storage module immutable fiveByteCount ByteCount 5
storage module immutable fiveAsAscii String "AAAAA"
storage module immutable helloLiteralForMemory String "hello"
storage module immutable integerZeroBoundaryForMemoryLocal Int64 0

call runFillCall fillMemoryBytesWithValue
argument runFillCall byteBuffer OpaquePointer workBuffer
argument runFillCall targetValue Int32 upperALetterCode
argument runFillCall byteCount ByteCount fiveByteCount
run runFillCall
ignore value source runFillCall type ByteCount

call assertFillCompareCall compareMemoryByteRanges
argument assertFillCompareCall leftBuffer String workBuffer
argument assertFillCompareCall rightBuffer String fiveAsAscii
argument assertFillCompareCall byteCount ByteCount fiveByteCount
run assertFillCompareCall
bind value fillCompareResult Int64 assertFillCompareCall
call checkFillCompareCall math.equalInt64
argument checkFillCompareCall left Int64 fillCompareResult
argument checkFillCompareCall right Int64 integerZeroBoundaryForMemoryLocal
run checkFillCompareCall
bind value fillCompareOk Bool checkFillCompareCall
branch if condition fillCompareOk target fillCompareHolds
branch else target smokeAssertionFailed
label fillCompareHolds

call runCopyCall copyMemoryBytes
argument runCopyCall destinationBuffer OpaquePointer workBuffer
argument runCopyCall sourceBuffer String helloLiteralForMemory
argument runCopyCall byteCount ByteCount fiveByteCount
run runCopyCall
ignore value source runCopyCall type ByteCount

call assertCopyCompareCall compareMemoryByteRanges
argument assertCopyCompareCall leftBuffer String workBuffer
argument assertCopyCompareCall rightBuffer String helloLiteralForMemory
argument assertCopyCompareCall byteCount ByteCount fiveByteCount
run assertCopyCompareCall
bind value copyCompareResult Int64 assertCopyCompareCall
call checkCopyCompareCall math.equalInt64
argument checkCopyCompareCall left Int64 copyCompareResult
argument checkCopyCompareCall right Int64 integerZeroBoundaryForMemoryLocal
run checkCopyCompareCall
bind value copyCompareOk Bool checkCopyCompareCall
branch if condition copyCompareOk target copyCompareHolds
branch else target smokeAssertionFailed
label copyCompareHolds

# findByteValueInMemoryRange: 'l' in "hello" at offset 2
storage module immutable lowercaseLForMemory Int32 108
storage module immutable expectedFindOffset Int64 2
call assertFindCall findByteValueInMemoryRange
argument assertFindCall byteBuffer String workBuffer
argument assertFindCall targetValue Int32 lowercaseLForMemory
argument assertFindCall byteCount ByteCount fiveByteCount
run assertFindCall
bind value findResult Int64 assertFindCall
call checkFindCall math.equalInt64
argument checkFindCall left Int64 findResult
argument checkFindCall right Int64 expectedFindOffset
run checkFindCall
bind value findOk Bool checkFindCall
branch if condition findOk target findHolds
branch else target smokeAssertionFailed
label findHolds

# ============================================================
# Extended unit tests: covers the 3 ops the smoke previously
# omitted (moveMemoryBytesAllowOverlap, zeroMemoryBytes,
# hashMemoryBytesWithFnv1a) plus boundary / property cases.
# ============================================================

storage module immutable zeroByteCountMem ByteCount 0
storage module immutable helloAgainLiteral String "hello"
storage module immutable lowercaseZForMem Int32 122

# zeroMemoryBytes: zero out the first 5 bytes of the buffer, then
# verify byte at offset 0 is 0 via findByteValueInMemoryRange.
call runZeroCall zeroMemoryBytes
argument runZeroCall byteBuffer OpaquePointer workBuffer
argument runZeroCall byteCount ByteCount fiveByteCount
run runZeroCall
ignore value source runZeroCall type ByteCount

storage module immutable nullByteCodeMem Int32 0
storage module immutable zeroOffset Int64 0
call findZeroCall findByteValueInMemoryRange
argument findZeroCall byteBuffer String workBuffer
argument findZeroCall targetValue Int32 nullByteCodeMem
argument findZeroCall byteCount ByteCount fiveByteCount
run findZeroCall
bind value findZeroResult Int64 findZeroCall
call checkFindZeroCall math.equalInt64
argument checkFindZeroCall left Int64 findZeroResult
argument checkFindZeroCall right Int64 zeroOffset
run checkFindZeroCall
bind value findZeroOk Bool checkFindZeroCall
branch if condition findZeroOk target findZeroHolds
branch else target smokeAssertionFailed
label findZeroHolds

# Re-copy "hello" into the buffer, then test moveMemoryBytesAllowOverlap.
# After move from buffer[0..5] to buffer[2..7] (overlapping right), the
# 5-byte content at offset 2 should be "hello".
call refillCopyCall copyMemoryBytes
argument refillCopyCall destinationBuffer OpaquePointer workBuffer
argument refillCopyCall sourceBuffer String helloAgainLiteral
argument refillCopyCall byteCount ByteCount fiveByteCount
run refillCopyCall
ignore value source refillCopyCall type ByteCount

# Compute destination = workBuffer + 2 via pointer arithmetic.
storage module immutable twoByteOffset ByteCount 2
call advanceForMoveCall pointer.offset
argument advanceForMoveCall base OpaquePointer workBuffer
argument advanceForMoveCall offset ByteCount twoByteOffset
run advanceForMoveCall
bind value moveDestPtr OpaquePointer advanceForMoveCall

call runMoveCall moveMemoryBytesAllowOverlap
argument runMoveCall destinationBuffer OpaquePointer moveDestPtr
argument runMoveCall sourceBuffer String workBuffer
argument runMoveCall byteCount ByteCount fiveByteCount
run runMoveCall
ignore value source runMoveCall type ByteCount

# After overlapping move, bytes at offset 2..7 should be "hello".
call moveCompareCall compareMemoryByteRanges
argument moveCompareCall leftBuffer String moveDestPtr
argument moveCompareCall rightBuffer String helloAgainLiteral
argument moveCompareCall byteCount ByteCount fiveByteCount
run moveCompareCall
bind value moveCompareResult Int64 moveCompareCall
call checkMoveCompareCall math.equalInt64
argument checkMoveCompareCall left Int64 moveCompareResult
argument checkMoveCompareCall right Int64 integerZeroBoundaryForMemoryLocal
run checkMoveCompareCall
bind value moveCompareOk Bool checkMoveCompareCall
branch if condition moveCompareOk target moveCompareHolds
branch else target smokeAssertionFailed
label moveCompareHolds

# hashMemoryBytesWithFnv1a: hash of zero-length buffer == initial offset basis.
storage module immutable expectedZeroHashBasis Int64 -3750763034362895579
call hashZeroCall hashMemoryBytesWithFnv1a
argument hashZeroCall byteBuffer String helloAgainLiteral
argument hashZeroCall byteCount ByteCount zeroByteCountMem
run hashZeroCall
bind value hashZeroResult Int64 hashZeroCall
call hashZeroCheckCall math.equalInt64
argument hashZeroCheckCall left Int64 hashZeroResult
argument hashZeroCheckCall right Int64 expectedZeroHashBasis
run hashZeroCheckCall
bind value hashZeroOk Bool hashZeroCheckCall
branch if condition hashZeroOk target hashZeroHolds
branch else target smokeAssertionFailed
label hashZeroHolds

# Property: hash is deterministic â€” same input always produces same output.
call hashFirstCall hashMemoryBytesWithFnv1a
argument hashFirstCall byteBuffer String helloAgainLiteral
argument hashFirstCall byteCount ByteCount fiveByteCount
run hashFirstCall
bind value hashFirstResult Int64 hashFirstCall
call hashSecondCall hashMemoryBytesWithFnv1a
argument hashSecondCall byteBuffer String helloAgainLiteral
argument hashSecondCall byteCount ByteCount fiveByteCount
run hashSecondCall
bind value hashSecondResult Int64 hashSecondCall
call hashDeterministicCheckCall math.equalInt64
argument hashDeterministicCheckCall left Int64 hashFirstResult
argument hashDeterministicCheckCall right Int64 hashSecondResult
run hashDeterministicCheckCall
bind value hashDeterministicOk Bool hashDeterministicCheckCall
branch if condition hashDeterministicOk target hashDeterministicHolds
branch else target smokeAssertionFailed
label hashDeterministicHolds

# Property: distinct inputs produce distinct hashes â€” hash("hello") != hash("world").
storage module immutable worldLiteralMem String "world"
call hashWorldCall hashMemoryBytesWithFnv1a
argument hashWorldCall byteBuffer String worldLiteralMem
argument hashWorldCall byteCount ByteCount fiveByteCount
run hashWorldCall
bind value hashWorldResult Int64 hashWorldCall
call hashDistinctCheckCall math.notEqualInt64
argument hashDistinctCheckCall left Int64 hashFirstResult
argument hashDistinctCheckCall right Int64 hashWorldResult
run hashDistinctCheckCall
bind value hashDistinctOk Bool hashDistinctCheckCall
branch if condition hashDistinctOk target hashDistinctHolds
branch else target smokeAssertionFailed
label hashDistinctHolds

# findByteValueInMemoryRange: 'z' not in "hello" -> -1
storage module immutable negativeOneFindResult Int64 -1
call findNotFoundCall findByteValueInMemoryRange
argument findNotFoundCall byteBuffer String helloAgainLiteral
argument findNotFoundCall targetValue Int32 lowercaseZForMem
argument findNotFoundCall byteCount ByteCount fiveByteCount
run findNotFoundCall
bind value findNotFoundResult Int64 findNotFoundCall
call checkFindNotFoundCall math.equalInt64
argument checkFindNotFoundCall left Int64 findNotFoundResult
argument checkFindNotFoundCall right Int64 negativeOneFindResult
run checkFindNotFoundCall
bind value findNotFoundOk Bool checkFindNotFoundCall
branch if condition findNotFoundOk target findNotFoundHolds
branch else target smokeAssertionFailed
label findNotFoundHolds

# Property: comparing buffer to itself returns 0
call selfCompareCall compareMemoryByteRanges
argument selfCompareCall leftBuffer String helloAgainLiteral
argument selfCompareCall rightBuffer String helloAgainLiteral
argument selfCompareCall byteCount ByteCount fiveByteCount
run selfCompareCall
bind value selfCompareResult Int64 selfCompareCall
call checkSelfCompareCall math.equalInt64
argument checkSelfCompareCall left Int64 selfCompareResult
argument checkSelfCompareCall right Int64 integerZeroBoundaryForMemoryLocal
run checkSelfCompareCall
bind value selfCompareOk Bool checkSelfCompareCall
branch if condition selfCompareOk target selfCompareHolds
branch else target smokeAssertionFailed
label selfCompareHolds

# Regression (high byte >= 128): fill the buffer with unsigned 200 (0xC8)
# and confirm findByteValueInMemoryRange locates it at offset 0. Before the
# fix, the loaded byte sign-extended to -56 and never matched targetValue
# 200, so find wrongly returned -1 even though fill had just written it.
storage module immutable highByteFillValue Int32 200
storage module immutable oneByteFillCount ByteCount 1
call fillHighByteCall fillMemoryBytesWithValue
argument fillHighByteCall byteBuffer OpaquePointer workBuffer
argument fillHighByteCall targetValue Int32 highByteFillValue
argument fillHighByteCall byteCount ByteCount oneByteFillCount
run fillHighByteCall
ignore value source fillHighByteCall type ByteCount
call findHighByteCall findByteValueInMemoryRange
argument findHighByteCall byteBuffer String workBuffer
argument findHighByteCall targetValue Int32 highByteFillValue
argument findHighByteCall byteCount ByteCount oneByteFillCount
run findHighByteCall
bind value findHighByteResult Int64 findHighByteCall
call checkFindHighByteCall math.equalInt64
argument checkFindHighByteCall left Int64 findHighByteResult
argument checkFindHighByteCall right Int64 integerZeroBoundaryForMemoryLocal
run checkFindHighByteCall
bind value findHighByteOk Bool checkFindHighByteCall
branch if condition findHighByteOk target findHighByteHolds
branch else target smokeAssertionFailed
label findHighByteHolds

storage module immutable successMessageText String "OK"
call writeSuccessLineCall console.writeLine
argument writeSuccessLineCall text String successMessageText
run writeSuccessLineCall
ignore void source writeSuccessLineCall
bind error consoleWriteResultError Int32 writeSuccessLineCall
branch error source writeSuccessLineCall target consoleWriteFailedHandler
storage module immutable exitOkCode ExitCode 0
return ok exitOkCode

# Failure leg: surface the raw negative Int32 from
# console.writeLine as the cause attached to the typed
# MainError.ConsoleWriteFailed variant.
label consoleWriteFailedHandler
makeError consoleWriteFailedFailure MainError.ConsoleWriteFailed consoleWriteResultError
return error consoleWriteFailedFailure
label smokeAssertionFailed
makeError memorySmokeFailure MainError.MemorySmokeAssertionFailed
return error memorySmokeFailure

# Heap-allocation failure leg: standard.memory returned an allocation error.
# The deferred releaseMemoryBytes does not fire here because the defer was
# registered AFTER this branch's branchIfError.
label heapAllocationFailedHandler
makeError heapAllocationFailure MainError.MemoryAllocationFailed heapAllocationError
return error heapAllocationFailure
