invariant operation copyMemoryBytes "Forward copy â€” caller must guarantee non-overlapping regions; use moveMemoryBytesAllowOverlap when they may overlap."
guarantee copyMemoryBytes "Total."
label startCopyMemoryBytes
memory copyMemoryBytes mutable copyCursor I64 0
label copyForwardLoop
call detectCopyDoneCall math.greaterThanOrEqualI64
argument detectCopyDoneCall left I64 copyCursor
argument detectCopyDoneCall right I64 byteCount
run detectCopyDoneCall
bind value copyDone Bool detectCopyDoneCall
branch if condition copyDone target copyComplete
call loadByteForCopyCall pointer.loadByte
argument loadByteForCopyCall buffer COpaqueMemoryAddress sourceBuffer
argument loadByteForCopyCall offset CByteCount copyCursor
run loadByteForCopyCall
bind value currentCopyByte I8 loadByteForCopyCall
call storeByteForCopyCall pointer.storeByte
argument storeByteForCopyCall buffer COpaqueMemoryAddress destinationBuffer
argument storeByteForCopyCall offset CByteCount copyCursor
argument storeByteForCopyCall value CSignedInt64 currentCopyByte
run storeByteForCopyCall
call advanceCopyCursorCall math.addI64
argument advanceCopyCursorCall left I64 copyCursor
argument advanceCopyCursorCall right I64 integerOneStepValue
run advanceCopyCursorCall
bind value nextCopyCursor I64 advanceCopyCursorCall
set memory copyCursor nextCopyCursor
jump target copyForwardLoop
label copyComplete
return value byteCount

