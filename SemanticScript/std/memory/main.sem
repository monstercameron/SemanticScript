argument addMixedHashByteCall left I64 hashAccumulator
argument addMixedHashByteCall right I64 mixedHashByte
run addMixedHashByteCall
bind value hashAfterMixedAdd I64 addMixedHashByteCall
call addRawHashByteCall math.addI64
argument addRawHashByteCall left I64 hashAfterMixedAdd
argument addRawHashByteCall right I64 unsignedHashByte
run addRawHashByteCall
bind value hashAfterRawAdd I64 addRawHashByteCall
