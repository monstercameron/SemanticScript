# ============================================================
# SEMANTICSCRIPT STDLIB TESTS: iso646
# ============================================================
#
# Companion smoke + extended unit tests for std/iso646/main.sem.
# Imports the iso646 module and asserts every logical-keyword
# combinator (and / or / not / xor / equal / notEqual) plus
# reflexive / commutativity property tests.
#
# Pattern: std/main.sem ships pure-module operations only;
# std/main.test.sem carries every smoke / unit test for it.

project StdIso646Test
target console
runtime AgentRuntime 0.1
entry console main

import iso646 standard.iso646
error MainError
errorCase MainError Iso646SmokeAssertionFailed
errorCase MainError ConsoleWriteFailed

# section capability
# rationale: smoke-test main writes a single OK line to stdout.
capability stdoutWriteCapability console.stdout write

# Smoke test
# ============================================================

operation main
input operation main console Console
output operation main Result ExitCode MainError
useCapability main stdoutWriteCapability
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Smoke-test the ISO 646 keyword operations end-to-end."
invariant operation main "All assertions hold or the failure path runs."

label startMain
storage module immutable integerOneValue CSignedInt64 1
storage module immutable integerTwoValue CSignedInt64 2

# and(1, 1) == true
call assertAndCall evaluateIso646AndKeyword
argument assertAndCall leftValue CSignedInt64 integerOneValue
argument assertAndCall rightValue CSignedInt64 integerOneValue
run assertAndCall
bind value andResult Bool assertAndCall
branch if condition andResult target andHolds
branch else target smokeAssertionFailed
label andHolds

# equal(1, 2) == false
call assertEqualCall evaluateIso646EqualKeyword
argument assertEqualCall leftValue CSignedInt64 integerOneValue
argument assertEqualCall rightValue CSignedInt64 integerTwoValue
run assertEqualCall
bind value equalResult Bool assertEqualCall
branch if condition equalResult target smokeAssertionFailed

# notEqual(1, 2) == true
call assertNotEqualCall evaluateIso646NotEqualKeyword
argument assertNotEqualCall leftValue CSignedInt64 integerOneValue
argument assertNotEqualCall rightValue CSignedInt64 integerTwoValue
run assertNotEqualCall
bind value notEqualResult Bool assertNotEqualCall
branch if condition notEqualResult target notEqualHolds
branch else target smokeAssertionFailed
label notEqualHolds

# xor(1, 0) == true
call assertXorCall evaluateIso646XorKeyword
argument assertXorCall leftValue CSignedInt64 integerOneValue
argument assertXorCall rightValue CSignedInt64 integerZeroBoundaryValue
run assertXorCall
bind value xorResult Bool assertXorCall
branch if condition xorResult target xorHolds
branch else target smokeAssertionFailed
label xorHolds

# not(0) == true
call assertNotCall evaluateIso646NotKeyword
argument assertNotCall inputValue CSignedInt64 integerZeroBoundaryValue
run assertNotCall
bind value notResult Bool assertNotCall
branch if condition notResult target notHolds
branch else target smokeAssertionFailed
label notHolds

# ============================================================
# Extended unit tests: missing op (or) + boundary cases for each.
# ============================================================

# or(1, 0) == true (was untested)
call orOneZeroCall evaluateIso646OrKeyword
argument orOneZeroCall leftValue CSignedInt64 integerOneValue
argument orOneZeroCall rightValue CSignedInt64 integerZeroBoundaryValue
run orOneZeroCall
bind value orOneZeroResult Bool orOneZeroCall
branch if condition orOneZeroResult target orOneZeroHolds
branch else target smokeAssertionFailed
label orOneZeroHolds

# or(0, 0) == false (both falsy)
call orZeroZeroCall evaluateIso646OrKeyword
argument orZeroZeroCall leftValue CSignedInt64 integerZeroBoundaryValue
argument orZeroZeroCall rightValue CSignedInt64 integerZeroBoundaryValue
run orZeroZeroCall
bind value orZeroZeroResult Bool orZeroZeroCall
branch if condition orZeroZeroResult target smokeAssertionFailed
branch else target orZeroZeroHolds
label orZeroZeroHolds

# and(0, 1) == false (one falsy)
call andZeroOneCall evaluateIso646AndKeyword
argument andZeroOneCall leftValue CSignedInt64 integerZeroBoundaryValue
argument andZeroOneCall rightValue CSignedInt64 integerOneValue
run andZeroOneCall
bind value andZeroOneResult Bool andZeroOneCall
branch if condition andZeroOneResult target smokeAssertionFailed
branch else target andZeroOneHolds
label andZeroOneHolds

# not(1) == false (truthy negated)
call notOneCall evaluateIso646NotKeyword
argument notOneCall inputValue CSignedInt64 integerOneValue
run notOneCall
bind value notOneResult Bool notOneCall
branch if condition notOneResult target smokeAssertionFailed
branch else target notOneHolds
label notOneHolds

# xor(1, 1) == false (same-truthy)
call xorSameCall evaluateIso646XorKeyword
argument xorSameCall leftValue CSignedInt64 integerOneValue
argument xorSameCall rightValue CSignedInt64 integerOneValue
run xorSameCall
bind value xorSameResult Bool xorSameCall
branch if condition xorSameResult target smokeAssertionFailed
branch else target xorSameHolds
label xorSameHolds

# equal(1, 1) == true (reflexive)
call equalSameCall evaluateIso646EqualKeyword
argument equalSameCall leftValue CSignedInt64 integerOneValue
argument equalSameCall rightValue CSignedInt64 integerOneValue
run equalSameCall
bind value equalSameResult Bool equalSameCall
branch if condition equalSameResult target equalSameHolds
branch else target smokeAssertionFailed
label equalSameHolds

# notEqual(2, 2) == false (irreflexive)
call notEqualSameCall evaluateIso646NotEqualKeyword
argument notEqualSameCall leftValue CSignedInt64 integerTwoValue
argument notEqualSameCall rightValue CSignedInt64 integerTwoValue
run notEqualSameCall
bind value notEqualSameResult Bool notEqualSameCall
branch if condition notEqualSameResult target smokeAssertionFailed
branch else target notEqualSameHolds
label notEqualSameHolds

storage module immutable successMessageText CNullTerminatedByteString "OK"
call writeSuccessLineCall console.writeLine
argument writeSuccessLineCall console Console console
argument writeSuccessLineCall text CNullTerminatedByteString successMessageText
run writeSuccessLineCall
ignore ok source writeSuccessLineCall type CSignedInt32
bind error consoleWriteResultError CSignedInt32 writeSuccessLineCall
branch error source writeSuccessLineCall target consoleWriteFailedHandler
storage module immutable exitOkCode ExitCode 0
return ok exitOkCode

# Failure leg: surface the raw negative CSignedInt32 from
# console.writeLine as the cause attached to the typed
# MainError.ConsoleWriteFailed variant.
label consoleWriteFailedHandler
makeError consoleWriteFailedFailure MainError.ConsoleWriteFailed consoleWriteResultError
return error consoleWriteFailedFailure
label smokeAssertionFailed
makeError iso646SmokeFailure MainError.Iso646SmokeAssertionFailed
return error iso646SmokeFailure
