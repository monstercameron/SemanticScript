# SemanticScript standard-library canonical module: standard.iso646.

module standard.iso646
purpose module standard.iso646 "Canonical standard-library module for iso646-style boolean operator helpers."
moduleOwns standard.iso646 "The official import path `standard.iso646` and this module's implementation body."
moduleDoesNotOwn standard.iso646 "App-specific wrappers, compatibility aliases, or generated build artifacts."
invariant module standard.iso646 "The standard module entry is this file; tests live beside it as `main.test.sem`."

exportConstant standard.iso646 iso646ModuleVersionText
storage module immutable iso646ModuleVersionText CNullTerminatedByteString "standard.iso646 0.1"

# Canonical standard-library implementation body.
# ============================================================
# SEMANTICSCRIPT STANDARD LIBRARY: <iso646.h>-style logical keywords
# ============================================================
#
# rationale: C's <iso646.h> defines `and`, `or`, `not`, `xor`,
#   `compl`, `bitand`, `bitor`, `not_eq` as macro spellings of C
#   operators. SemanticScript has no macro expansion, so this module
#   exposes each as a real operation. The refined surface returns
#   Bool (not CSignedInt32 0/1) and reads its inputs as CSignedInt64
#   integers â€” the keyword operates on the "truth" of an integer
#   (zero vs non-zero), matching C semantics exactly.
#
# invariant: every operation here is total. The result of "non-zero
#   integer truth" is encoded in Bool, eliminating the C convention
#   of "any non-zero" for inputs while normalizing the output.
#
# security: pure value-level math; no allocation; no I/O.
#
# timing: at most two `icmp` operations and one branch per call.
#
# observability: no logs or metrics.
#
# Operations exposed:
#   evaluateIso646AndKeyword(leftValue, rightValue)      -> Bool
#   evaluateIso646OrKeyword(leftValue, rightValue)       -> Bool
#   evaluateIso646NotKeyword(inputValue)                 -> Bool
#   evaluateIso646XorKeyword(leftValue, rightValue)      -> Bool
#   evaluateIso646EqualKeyword(leftValue, rightValue)    -> Bool
#   evaluateIso646NotEqualKeyword(leftValue, rightValue) -> Bool

# Pure-module file: smoke + extended tests live in
# std/iso646/main.test.sem.

domainLiteral integerZeroBoundaryValue CSignedInt64 0
domainLiteralTrust integerZeroBoundaryValue trustedStaticLiteral

# section iso646.logicalKeywords
# rationale: integer-truth combinators that return Bool.

operation evaluateIso646AndKeyword
input operation evaluateIso646AndKeyword leftValue CSignedInt64
input operation evaluateIso646AndKeyword rightValue CSignedInt64
output operation evaluateIso646AndKeyword Bool
memory evaluateIso646AndKeyword heap no
async evaluateIso646AndKeyword no
purpose operation evaluateIso646AndKeyword "Returns true when both inputs are non-zero (mirrors C's 'and' keyword applied to integers)."
invariant operation evaluateIso646AndKeyword "Commutative and associative under integer truth semantics."
guarantee evaluateIso646AndKeyword "Total."
label startEvaluateIso646AndKeyword
call detectLeftIsZeroCall math.equalI64
argument detectLeftIsZeroCall left I64 leftValue
argument detectLeftIsZeroCall right I64 integerZeroBoundaryValue
run detectLeftIsZeroCall
bind value leftIsZero Bool detectLeftIsZeroCall
branch if condition leftIsZero target returnAndFalse
call detectRightIsZeroCall math.equalI64
argument detectRightIsZeroCall left I64 rightValue
argument detectRightIsZeroCall right I64 integerZeroBoundaryValue
run detectRightIsZeroCall
bind value rightIsZero Bool detectRightIsZeroCall
branch if condition rightIsZero target returnAndFalse
storage module immutable andTrueResult Bool true
return value andTrueResult
label returnAndFalse
storage module immutable andFalseResult Bool false
return value andFalseResult

operation evaluateIso646OrKeyword
input operation evaluateIso646OrKeyword leftValue CSignedInt64
input operation evaluateIso646OrKeyword rightValue CSignedInt64
output operation evaluateIso646OrKeyword Bool
memory evaluateIso646OrKeyword heap no
async evaluateIso646OrKeyword no
purpose operation evaluateIso646OrKeyword "Returns true when at least one input is non-zero (mirrors C's 'or' keyword)."
invariant operation evaluateIso646OrKeyword "Commutative and associative under integer truth semantics."
guarantee evaluateIso646OrKeyword "Total."
label startEvaluateIso646OrKeyword
call detectLeftIsNonZeroCall math.notEqualI64
argument detectLeftIsNonZeroCall left I64 leftValue
argument detectLeftIsNonZeroCall right I64 integerZeroBoundaryValue
run detectLeftIsNonZeroCall
bind value leftIsNonZero Bool detectLeftIsNonZeroCall
branch if condition leftIsNonZero target returnOrTrue
call detectRightIsNonZeroCall math.notEqualI64
argument detectRightIsNonZeroCall left I64 rightValue
argument detectRightIsNonZeroCall right I64 integerZeroBoundaryValue
run detectRightIsNonZeroCall
bind value rightIsNonZero Bool detectRightIsNonZeroCall
branch if condition rightIsNonZero target returnOrTrue
storage module immutable orFalseResult Bool false
return value orFalseResult
label returnOrTrue
storage module immutable orTrueResult Bool true
return value orTrueResult

operation evaluateIso646NotKeyword
input operation evaluateIso646NotKeyword inputValue CSignedInt64
output operation evaluateIso646NotKeyword Bool
memory evaluateIso646NotKeyword heap no
async evaluateIso646NotKeyword no
purpose operation evaluateIso646NotKeyword "Returns true when the input is zero (mirrors C's 'not' keyword)."
invariant operation evaluateIso646NotKeyword "Involutive over Bool: evaluateIso646NotKeyword(evaluateIso646NotKeyword(x)) == truthOf(x)."
guarantee evaluateIso646NotKeyword "Total."
label startEvaluateIso646NotKeyword
call detectInputIsZeroCall math.equalI64
argument detectInputIsZeroCall left I64 inputValue
argument detectInputIsZeroCall right I64 integerZeroBoundaryValue
run detectInputIsZeroCall
bind value inputIsZero Bool detectInputIsZeroCall
return value inputIsZero

operation evaluateIso646XorKeyword
input operation evaluateIso646XorKeyword leftValue CSignedInt64
input operation evaluateIso646XorKeyword rightValue CSignedInt64
output operation evaluateIso646XorKeyword Bool
memory evaluateIso646XorKeyword heap no
async evaluateIso646XorKeyword no
purpose operation evaluateIso646XorKeyword "Returns true when exactly one input is non-zero (logical XOR over integer truth)."
invariant operation evaluateIso646XorKeyword "Self-inverse: evaluateIso646XorKeyword(x, x) == false for every x."
guarantee evaluateIso646XorKeyword "Total."
label startEvaluateIso646XorKeyword
call leftXorTruthCall math.notEqualI64
argument leftXorTruthCall left I64 leftValue
argument leftXorTruthCall right I64 integerZeroBoundaryValue
run leftXorTruthCall
bind value leftXorTruth Bool leftXorTruthCall
call rightXorTruthCall math.notEqualI64
argument rightXorTruthCall left I64 rightValue
argument rightXorTruthCall right I64 integerZeroBoundaryValue
run rightXorTruthCall
bind value rightXorTruth Bool rightXorTruthCall
call detectXorOperandsDifferCall math.notEqualI64
argument detectXorOperandsDifferCall left I64 leftXorTruth
argument detectXorOperandsDifferCall right I64 rightXorTruth
run detectXorOperandsDifferCall
bind value xorOperandsDiffer Bool detectXorOperandsDifferCall
return value xorOperandsDiffer

operation evaluateIso646EqualKeyword
input operation evaluateIso646EqualKeyword leftValue CSignedInt64
input operation evaluateIso646EqualKeyword rightValue CSignedInt64
output operation evaluateIso646EqualKeyword Bool
memory evaluateIso646EqualKeyword heap no
async evaluateIso646EqualKeyword no
purpose operation evaluateIso646EqualKeyword "Returns true when the two integer inputs are bitwise equal."
invariant operation evaluateIso646EqualKeyword "Symmetric; reflexive."
guarantee evaluateIso646EqualKeyword "Total."
label startEvaluateIso646EqualKeyword
call detectEqualCall math.equalI64
argument detectEqualCall left I64 leftValue
argument detectEqualCall right I64 rightValue
run detectEqualCall
bind value valuesEqual Bool detectEqualCall
return value valuesEqual

operation evaluateIso646NotEqualKeyword
input operation evaluateIso646NotEqualKeyword leftValue CSignedInt64
input operation evaluateIso646NotEqualKeyword rightValue CSignedInt64
output operation evaluateIso646NotEqualKeyword Bool
memory evaluateIso646NotEqualKeyword heap no
async evaluateIso646NotEqualKeyword no
purpose operation evaluateIso646NotEqualKeyword "Returns true when the two integer inputs differ."
invariant operation evaluateIso646NotEqualKeyword "Symmetric; irreflexive."
guarantee evaluateIso646NotEqualKeyword "Total."
label startEvaluateIso646NotEqualKeyword
call detectNotEqualCall math.notEqualI64
argument detectNotEqualCall left I64 leftValue
argument detectNotEqualCall right I64 rightValue
run detectNotEqualCall
bind value valuesDiffer Bool detectNotEqualCall
return value valuesDiffer
