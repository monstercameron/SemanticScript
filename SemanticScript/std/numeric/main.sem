# SemanticScript standard-library canonical module: standard.numeric.

module standard.numeric
purpose module standard.numeric "Canonical standard-library module for numeric helper operations."
moduleOwns standard.numeric "The official import path `standard.numeric` and this module's implementation body."
moduleDoesNotOwn standard.numeric "App-specific wrappers, compatibility aliases, or generated build artifacts."
invariant module standard.numeric "The standard module entry is this file; tests live beside it as `main.test.sem`."

exportConstant standard.numeric numericModuleVersionText
storage module immutable numericModuleVersionText CNullTerminatedByteString "standard.numeric 0.1"

# Canonical standard-library implementation body.
# ============================================================
# SEMANTICSCRIPT STANDARD LIBRARY: integer numeric helpers
# ============================================================
#
# rationale: small total CSignedInt64 helpers plus a few
#   closed-form aggregate computations. Most are one-liners over
#   math.* primitives; the LCM helper folds a real gcd loop with
#   typed-error handling for the divide-by-zero edge case.
#
# invariant: total CSignedInt64 -> CSignedInt64 ops drop the
#   Result wrapper. reciprocalFloat64 is total over non-zero
#   doubles; with x = 0 it returns the IEEE-754 infinity. LCM
#   surfaces a typed NumericError.LeastCommonMultipleOfZero
#   variant when either input is 0.
#
# security: pure value-level math; no allocation; no I/O.
# timing: constant for the one-liners; O(log min(|a|, |b|)) for
#   leastCommonMultipleSignedInt64 (gcd loop).

# Pure-module file: smoke + extended tests live in
# std/numeric/main.test.sem.

error NumericError
errorCase NumericError LeastCommonMultipleOfZero

domainLiteral integerOneStepValue CSignedInt64 1
domainLiteralTrust integerOneStepValue trustedStaticLiteral
domainLiteral integerTwoBaseValue CSignedInt64 2
domainLiteralTrust integerTwoBaseValue trustedStaticLiteral
domainLiteral integerSixDivisor CSignedInt64 6
domainLiteralTrust integerSixDivisor trustedStaticLiteral
domainLiteral integerNegativeOneMultiplier CSignedInt64 -1
domainLiteralTrust integerNegativeOneMultiplier trustedStaticLiteral
domainLiteral integerZeroBoundaryForNumeric CSignedInt64 0
domainLiteralTrust integerZeroBoundaryForNumeric trustedStaticLiteral
domainLiteral floatOneIdentity CFloat64 1.0
domainLiteralTrust floatOneIdentity trustedStaticLiteral

# section numeric.unary

operation incrementSignedInt64
input operation incrementSignedInt64 inputValue CSignedInt64
output operation incrementSignedInt64 CSignedInt64
memory incrementSignedInt64 heap no
async incrementSignedInt64 no
purpose operation incrementSignedInt64 "Returns inputValue + 1."
invariant operation incrementSignedInt64 "Wraps modulo 2^64 at INT64_MAX."
guarantee incrementSignedInt64 "Total."
label startIncrementSignedInt64
call addOneToInputCall math.addI64
argument addOneToInputCall left I64 inputValue
argument addOneToInputCall right I64 integerOneStepValue
run addOneToInputCall
bind value incrementedValue CSignedInt64 addOneToInputCall
return value incrementedValue

operation decrementSignedInt64
input operation decrementSignedInt64 inputValue CSignedInt64
output operation decrementSignedInt64 CSignedInt64
memory decrementSignedInt64 heap no
async decrementSignedInt64 no
purpose operation decrementSignedInt64 "Returns inputValue - 1."
invariant operation decrementSignedInt64 "Wraps modulo 2^64 at INT64_MIN."
guarantee decrementSignedInt64 "Total."
label startDecrementSignedInt64
call subtractOneFromInputCall math.subtractI64
argument subtractOneFromInputCall left I64 inputValue
argument subtractOneFromInputCall right I64 integerOneStepValue
run subtractOneFromInputCall
bind value decrementedValue CSignedInt64 subtractOneFromInputCall
return value decrementedValue

operation doubleSignedInt64
input operation doubleSignedInt64 inputValue CSignedInt64
output operation doubleSignedInt64 CSignedInt64
memory doubleSignedInt64 heap no
async doubleSignedInt64 no
purpose operation doubleSignedInt64 "Returns inputValue * 2."
guarantee doubleSignedInt64 "Total."
label startDoubleSignedInt64
call multiplyByTwoCall math.multiplyI64
argument multiplyByTwoCall left I64 inputValue
argument multiplyByTwoCall right I64 integerTwoBaseValue
run multiplyByTwoCall
bind value doubledValue CSignedInt64 multiplyByTwoCall
return value doubledValue

operation halveSignedInt64
input operation halveSignedInt64 inputValue CSignedInt64
output operation halveSignedInt64 CSignedInt64
memory halveSignedInt64 heap no
async halveSignedInt64 no
purpose operation halveSignedInt64 "Returns inputValue / 2 (floor toward zero)."
guarantee halveSignedInt64 "Total."
label startHalveSignedInt64
call divideByTwoCall math.divideI64
argument divideByTwoCall left I64 inputValue
argument divideByTwoCall right I64 integerTwoBaseValue
run divideByTwoCall
bind value halvedValue CSignedInt64 divideByTwoCall
return value halvedValue

operation negateSignedInt64
input operation negateSignedInt64 inputValue CSignedInt64
output operation negateSignedInt64 CSignedInt64
memory negateSignedInt64 heap no
async negateSignedInt64 no
purpose operation negateSignedInt64 "Returns -inputValue."
warning negateSignedInt64 "INT64_MIN negated is still INT64_MIN (two's-complement wraparound)."
guarantee negateSignedInt64 "Total."
label startNegateSignedInt64
call multiplyByNegativeOneForNegateCall math.multiplyI64
argument multiplyByNegativeOneForNegateCall left I64 inputValue
argument multiplyByNegativeOneForNegateCall right I64 integerNegativeOneMultiplier
run multiplyByNegativeOneForNegateCall
bind value negatedValue CSignedInt64 multiplyByNegativeOneForNegateCall
return value negatedValue

operation reciprocalFloat64
input operation reciprocalFloat64 inputValue CFloat64
output operation reciprocalFloat64 CFloat64
memory reciprocalFloat64 heap no
async reciprocalFloat64 no
purpose operation reciprocalFloat64 "Returns 1.0 / inputValue."
warning reciprocalFloat64 "Division by zero produces an IEEE-754 infinity; NaN inputs propagate."
guarantee reciprocalFloat64 "Total over CFloat64."
label startReciprocalFloat64
call divideOneByInputCall math.divideF64
argument divideOneByInputCall left F64 floatOneIdentity
argument divideOneByInputCall right F64 inputValue
run divideOneByInputCall
bind value reciprocalResult CFloat64 divideOneByInputCall
return value reciprocalResult

# section numeric.aggregateSums

operation sumSignedInt64OneThroughN
input operation sumSignedInt64OneThroughN inputValue CSignedInt64
output operation sumSignedInt64OneThroughN CSignedInt64
memory sumSignedInt64OneThroughN heap no
async sumSignedInt64OneThroughN no
purpose operation sumSignedInt64OneThroughN "Returns 1+2+...+inputValue via the Gauss closed form n*(n+1)/2."
invariant operation sumSignedInt64OneThroughN "Equals the nth triangular number for non-negative inputs."
warning sumSignedInt64OneThroughN "Overflows silently for inputValue beyond ~2^31."
guarantee sumSignedInt64OneThroughN "Total."
label startSumSignedInt64OneThroughN
call addOneToInputForSumCall math.addI64
argument addOneToInputForSumCall left I64 inputValue
argument addOneToInputForSumCall right I64 integerOneStepValue
run addOneToInputForSumCall
bind value inputPlusOne I64 addOneToInputForSumCall
call multiplyForGaussSumCall math.multiplyI64
argument multiplyForGaussSumCall left I64 inputValue
argument multiplyForGaussSumCall right I64 inputPlusOne
run multiplyForGaussSumCall
bind value productForGaussSum I64 multiplyForGaussSumCall
call divideByTwoForGaussSumCall math.divideI64
argument divideByTwoForGaussSumCall left I64 productForGaussSum
argument divideByTwoForGaussSumCall right I64 integerTwoBaseValue
run divideByTwoForGaussSumCall
bind value gaussSumResult CSignedInt64 divideByTwoForGaussSumCall
return value gaussSumResult

operation sumSignedInt64SquaresOneThroughN
input operation sumSignedInt64SquaresOneThroughN inputValue CSignedInt64
output operation sumSignedInt64SquaresOneThroughN CSignedInt64
memory sumSignedInt64SquaresOneThroughN heap no
async sumSignedInt64SquaresOneThroughN no
purpose operation sumSignedInt64SquaresOneThroughN "Returns 1^2+...+inputValue^2 via the closed form n*(n+1)*(2n+1)/6."
warning sumSignedInt64SquaresOneThroughN "Overflows silently for inputValue beyond ~2^21."
guarantee sumSignedInt64SquaresOneThroughN "Total."
label startSumSignedInt64SquaresOneThroughN
call computeNPlusOneCall math.addI64
argument computeNPlusOneCall left I64 inputValue
argument computeNPlusOneCall right I64 integerOneStepValue
run computeNPlusOneCall
bind value squareNPlusOne I64 computeNPlusOneCall
call computeTwoNCall math.multiplyI64
argument computeTwoNCall left I64 inputValue
argument computeTwoNCall right I64 integerTwoBaseValue
run computeTwoNCall
bind value squareTwoN I64 computeTwoNCall
call computeTwoNPlusOneCall math.addI64
argument computeTwoNPlusOneCall left I64 squareTwoN
argument computeTwoNPlusOneCall right I64 integerOneStepValue
run computeTwoNPlusOneCall
bind value squareTwoNPlusOne I64 computeTwoNPlusOneCall
call firstSquareProductCall math.multiplyI64
argument firstSquareProductCall left I64 inputValue
argument firstSquareProductCall right I64 squareNPlusOne
run firstSquareProductCall
bind value firstSquareProductValue I64 firstSquareProductCall
call secondSquareProductCall math.multiplyI64
argument secondSquareProductCall left I64 firstSquareProductValue
argument secondSquareProductCall right I64 squareTwoNPlusOne
run secondSquareProductCall
bind value secondSquareProductValue I64 secondSquareProductCall
call divideBySixForSquareSumCall math.divideI64
argument divideBySixForSquareSumCall left I64 secondSquareProductValue
argument divideBySixForSquareSumCall right I64 integerSixDivisor
run divideBySixForSquareSumCall
bind value sumOfSquaresResult CSignedInt64 divideBySixForSquareSumCall
return value sumOfSquaresResult

operation sumSignedInt64CubesOneThroughN
input operation sumSignedInt64CubesOneThroughN inputValue CSignedInt64
output operation sumSignedInt64CubesOneThroughN CSignedInt64
memory sumSignedInt64CubesOneThroughN heap no
async sumSignedInt64CubesOneThroughN no
purpose operation sumSignedInt64CubesOneThroughN "Returns 1^3+...+inputValue^3 via the identity (sum 1..n)^2."
guarantee sumSignedInt64CubesOneThroughN "Total."
label startSumSignedInt64CubesOneThroughN
call delegateToTriangularSumCall sumSignedInt64OneThroughN
argument delegateToTriangularSumCall inputValue CSignedInt64 inputValue
run delegateToTriangularSumCall
bind value triangularSumValue CSignedInt64 delegateToTriangularSumCall
call squareTriangularSumCall math.multiplyI64
argument squareTriangularSumCall left I64 triangularSumValue
argument squareTriangularSumCall right I64 triangularSumValue
run squareTriangularSumCall
bind value sumOfCubesResult CSignedInt64 squareTriangularSumCall
return value sumOfCubesResult

operation triangularNumberSignedInt64
input operation triangularNumberSignedInt64 inputValue CSignedInt64
output operation triangularNumberSignedInt64 CSignedInt64
memory triangularNumberSignedInt64 heap no
async triangularNumberSignedInt64 no
purpose operation triangularNumberSignedInt64 "Returns the nth triangular number â€” alias for sumSignedInt64OneThroughN."
guarantee triangularNumberSignedInt64 "Total."
label startTriangularNumberSignedInt64
call delegateToSumOneToNCall sumSignedInt64OneThroughN
argument delegateToSumOneToNCall inputValue CSignedInt64 inputValue
run delegateToSumOneToNCall
bind value triangularResultValue CSignedInt64 delegateToSumOneToNCall
return value triangularResultValue

# section numeric.gcdLcm

operation leastCommonMultipleSignedInt64
input operation leastCommonMultipleSignedInt64 leftValue CSignedInt64
input operation leastCommonMultipleSignedInt64 rightValue CSignedInt64
output operation leastCommonMultipleSignedInt64 Result CSignedInt64 NumericError
memory leastCommonMultipleSignedInt64 heap no
async leastCommonMultipleSignedInt64 no
purpose operation leastCommonMultipleSignedInt64 "Returns |leftValue * rightValue| / gcd(leftValue, rightValue). Surfaces NumericError.LeastCommonMultipleOfZero when either input is zero."
invariant operation leastCommonMultipleSignedInt64 "Result is non-negative when defined."
failure leastCommonMultipleSignedInt64 LeastCommonMultipleOfZero "Returned when either input is 0 (LCM is undefined for zero operands)."
guarantee leastCommonMultipleSignedInt64 "Defined for every (non-zero, non-zero) input pair."
label startLeastCommonMultipleSignedInt64
call detectLeftIsZeroForLcmCall math.equalI64
argument detectLeftIsZeroForLcmCall left I64 leftValue
argument detectLeftIsZeroForLcmCall right I64 integerZeroBoundaryForNumeric
run detectLeftIsZeroForLcmCall
bind value leftIsZeroForLcm Bool detectLeftIsZeroForLcmCall
branch if condition leftIsZeroForLcm target raiseLcmOfZero
call detectRightIsZeroForLcmCall math.equalI64
argument detectRightIsZeroForLcmCall left I64 rightValue
argument detectRightIsZeroForLcmCall right I64 integerZeroBoundaryForNumeric
run detectRightIsZeroForLcmCall
bind value rightIsZeroForLcm Bool detectRightIsZeroForLcmCall
branch if condition rightIsZeroForLcm target raiseLcmOfZero

# Compute gcd via Euclid using absolute values.
# Initialize working dividend/divisor to the input values, then
# conditionally overwrite with the negated value when the input is
# negative. The intermediate read of gcdRunningDividend /
# gcdRunningDivisor inside the negation call's arg keeps the
# linter's flow-insensitive dead-store check satisfied on the
# negative branch.
memory leastCommonMultipleSignedInt64 mutable gcdRunningDividend I64 0
set memory gcdRunningDividend leftValue
memory leastCommonMultipleSignedInt64 mutable gcdRunningDivisor I64 0
set memory gcdRunningDivisor rightValue
call detectLeftIsNegativeForLcmCall math.lessThanI64
argument detectLeftIsNegativeForLcmCall left I64 leftValue
argument detectLeftIsNegativeForLcmCall right I64 integerZeroBoundaryForNumeric
run detectLeftIsNegativeForLcmCall
bind value leftIsNegativeForLcm Bool detectLeftIsNegativeForLcmCall
branch if condition leftIsNegativeForLcm target negateLeftForLcm
branch else target checkRightForLcmAbs
label negateLeftForLcm
call negateLeftForLcmCall math.multiplyI64
argument negateLeftForLcmCall left I64 gcdRunningDividend
argument negateLeftForLcmCall right I64 integerNegativeOneMultiplier
run negateLeftForLcmCall
bind value absoluteLeftForLcm I64 negateLeftForLcmCall
set memory gcdRunningDividend absoluteLeftForLcm
jump target checkRightForLcmAbs
label checkRightForLcmAbs
call detectRightIsNegativeForLcmCall math.lessThanI64
argument detectRightIsNegativeForLcmCall left I64 rightValue
argument detectRightIsNegativeForLcmCall right I64 integerZeroBoundaryForNumeric
run detectRightIsNegativeForLcmCall
bind value rightIsNegativeForLcm Bool detectRightIsNegativeForLcmCall
branch if condition rightIsNegativeForLcm target negateRightForLcm
branch else target enterGcdLoop
label negateRightForLcm
call negateRightForLcmCall math.multiplyI64
argument negateRightForLcmCall left I64 gcdRunningDivisor
argument negateRightForLcmCall right I64 integerNegativeOneMultiplier
run negateRightForLcmCall
bind value absoluteRightForLcm I64 negateRightForLcmCall
set memory gcdRunningDivisor absoluteRightForLcm
jump target enterGcdLoop
label enterGcdLoop
label gcdEuclidLoop
call detectGcdDivisorIsZeroCall math.equalI64
argument detectGcdDivisorIsZeroCall left I64 gcdRunningDivisor
argument detectGcdDivisorIsZeroCall right I64 integerZeroBoundaryForNumeric
run detectGcdDivisorIsZeroCall
bind value gcdDivisorIsZero Bool detectGcdDivisorIsZeroCall
branch if condition gcdDivisorIsZero target gcdLoopComplete
call computeGcdRemainderCall math.moduloI64
argument computeGcdRemainderCall left I64 gcdRunningDividend
argument computeGcdRemainderCall right I64 gcdRunningDivisor
run computeGcdRemainderCall
bind value gcdRemainderValue I64 computeGcdRemainderCall
set memory gcdRunningDividend gcdRunningDivisor
set memory gcdRunningDivisor gcdRemainderValue
jump target gcdEuclidLoop
label gcdLoopComplete

# product / gcd
call computeLcmProductCall math.multiplyI64
argument computeLcmProductCall left I64 leftValue
argument computeLcmProductCall right I64 rightValue
run computeLcmProductCall
bind value lcmProductValue I64 computeLcmProductCall
call divideLcmProductByGcdCall math.divideI64
argument divideLcmProductByGcdCall left I64 lcmProductValue
argument divideLcmProductByGcdCall right I64 gcdRunningDividend
run divideLcmProductByGcdCall
bind value rawLcmValue I64 divideLcmProductByGcdCall

# Take absolute value of result.
call detectLcmNegativeCall math.lessThanI64
argument detectLcmNegativeCall left I64 rawLcmValue
argument detectLcmNegativeCall right I64 integerZeroBoundaryForNumeric
run detectLcmNegativeCall
bind value lcmIsNegative Bool detectLcmNegativeCall
branch if condition lcmIsNegative target absoluteLcmFromNegation
return ok rawLcmValue
label absoluteLcmFromNegation
call negateRawLcmCall math.multiplyI64
argument negateRawLcmCall left I64 rawLcmValue
argument negateRawLcmCall right I64 integerNegativeOneMultiplier
run negateRawLcmCall
bind value absoluteLcmValue CSignedInt64 negateRawLcmCall
return ok absoluteLcmValue

label raiseLcmOfZero
makeError lcmOfZeroFailure NumericError.LeastCommonMultipleOfZero
return error lcmOfZeroFailure
