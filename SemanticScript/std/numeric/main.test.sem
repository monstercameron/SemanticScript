# ============================================================
# SEMANTICSCRIPT STDLIB TESTS: numeric
# ============================================================
#
# Companion smoke + extended unit tests for std/numeric/main.sem.
# Imports the numeric module and asserts every exported helper
# (increment / decrement / double / halve / negate / reciprocal /
# triangular sums / squares / cubes / LCM) plus boundary cases
# and round-trip / symmetry property tests.
#
# Pattern: std/main.sem ships pure-module operations only;
# std/main.test.sem carries every smoke / unit test for it.

project StdNumericTest
target console
runtime AgentRuntime 0.1
entry console main

import numeric standard.numeric
error MainError
errorCase MainError NumericSmokeAssertionFailed
errorCase MainError ConsoleWriteFailed

# section capability
# rationale: smoke-test main writes a single OK line to stdout.
capability stdoutWriteCapability console.stdout write

# ============================================================
# Smoke test
# ============================================================

operation main
input operation main console Console
output operation main Result ExitCode MainError
useCapability main stdoutWriteCapability
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Smoke-test the numeric helpers."
invariant operation main "sumSignedInt64OneThroughN(100) == 5050; LCM(12, 18) == 36."

label startMain

# sumSignedInt64OneThroughN(100) == 5050
storage module immutable oneHundredInput CSignedInt64 100
storage module immutable expectedTriangularSumOf100 CSignedInt64 5050
call assertGaussSumCall sumSignedInt64OneThroughN
argument assertGaussSumCall inputValue CSignedInt64 oneHundredInput
run assertGaussSumCall
bind value gaussSumActualResult CSignedInt64 assertGaussSumCall
call checkGaussSumCall math.equalI64
argument checkGaussSumCall left I64 gaussSumActualResult
argument checkGaussSumCall right I64 expectedTriangularSumOf100
run checkGaussSumCall
bind value gaussSumOk Bool checkGaussSumCall
branch if condition gaussSumOk target gaussSumHolds
branch else target smokeAssertionFailed
label gaussSumHolds

# LCM(12, 18) == 36
storage module immutable twelveValue CSignedInt64 12
storage module immutable eighteenValue CSignedInt64 18
storage module immutable thirtySixExpectedLcm CSignedInt64 36
call assertLcmCall leastCommonMultipleSignedInt64
argument assertLcmCall leftValue CSignedInt64 twelveValue
argument assertLcmCall rightValue CSignedInt64 eighteenValue
run assertLcmCall
bind ok lcmActualResult CSignedInt64 assertLcmCall
call checkLcmCall math.equalI64
argument checkLcmCall left I64 lcmActualResult
argument checkLcmCall right I64 thirtySixExpectedLcm
run checkLcmCall
bind value lcmOk Bool checkLcmCall
branch if condition lcmOk target lcmHolds
branch else target smokeAssertionFailed
label lcmHolds

# ============================================================
# Extended unit tests: covers 9 ops the smoke previously omitted
# (increment / decrement / double / halve / negate / reciprocal /
# sumSquares / sumCubes / triangularNumber), plus boundary cases.
# ============================================================

storage module immutable zeroNum CSignedInt64 0
storage module immutable oneNum CSignedInt64 1
storage module immutable twoNum CSignedInt64 2
storage module immutable threeNum CSignedInt64 3
storage module immutable fiveNum CSignedInt64 5
storage module immutable sixNum CSignedInt64 6
storage module immutable tenNum CSignedInt64 10
storage module immutable fourteenNum CSignedInt64 14
storage module immutable fifteenNum CSignedInt64 15
storage module immutable fiftyFiveNum CSignedInt64 55
storage module immutable minusFiveNum CSignedInt64 -5
storage module immutable minusOneNum CSignedInt64 -1

# increment(5) == 6
call incCall incrementSignedInt64
argument incCall inputValue CSignedInt64 fiveNum
run incCall
bind value incResult CSignedInt64 incCall
call incCheckCall math.equalI64
argument incCheckCall left I64 incResult
argument incCheckCall right I64 sixNum
run incCheckCall
bind value incOk Bool incCheckCall
branch if condition incOk target incHolds
branch else target smokeAssertionFailed
label incHolds

# increment(-1) == 0 (negative input)
call incNegCall incrementSignedInt64
argument incNegCall inputValue CSignedInt64 minusOneNum
run incNegCall
bind value incNegResult CSignedInt64 incNegCall
call incNegCheckCall math.equalI64
argument incNegCheckCall left I64 incNegResult
argument incNegCheckCall right I64 zeroNum
run incNegCheckCall
bind value incNegOk Bool incNegCheckCall
branch if condition incNegOk target incNegHolds
branch else target smokeAssertionFailed
label incNegHolds

# decrement(6) == 5 (inverse of increment)
call decCall decrementSignedInt64
argument decCall inputValue CSignedInt64 sixNum
run decCall
bind value decResult CSignedInt64 decCall
call decCheckCall math.equalI64
argument decCheckCall left I64 decResult
argument decCheckCall right I64 fiveNum
run decCheckCall
bind value decOk Bool decCheckCall
branch if condition decOk target decHolds
branch else target smokeAssertionFailed
label decHolds

# decrement(0) == -1
call decZeroCall decrementSignedInt64
argument decZeroCall inputValue CSignedInt64 zeroNum
run decZeroCall
bind value decZeroResult CSignedInt64 decZeroCall
call decZeroCheckCall math.equalI64
argument decZeroCheckCall left I64 decZeroResult
argument decZeroCheckCall right I64 minusOneNum
run decZeroCheckCall
bind value decZeroOk Bool decZeroCheckCall
branch if condition decZeroOk target decZeroHolds
branch else target smokeAssertionFailed
label decZeroHolds

# double(5) == 10
call doubleCall doubleSignedInt64
argument doubleCall inputValue CSignedInt64 fiveNum
run doubleCall
bind value doubleResult CSignedInt64 doubleCall
call doubleCheckCall math.equalI64
argument doubleCheckCall left I64 doubleResult
argument doubleCheckCall right I64 tenNum
run doubleCheckCall
bind value doubleOk Bool doubleCheckCall
branch if condition doubleOk target doubleHolds
branch else target smokeAssertionFailed
label doubleHolds

# double(0) == 0
call doubleZeroCall doubleSignedInt64
argument doubleZeroCall inputValue CSignedInt64 zeroNum
run doubleZeroCall
bind value doubleZeroResult CSignedInt64 doubleZeroCall
call doubleZeroCheckCall math.equalI64
argument doubleZeroCheckCall left I64 doubleZeroResult
argument doubleZeroCheckCall right I64 zeroNum
run doubleZeroCheckCall
bind value doubleZeroOk Bool doubleZeroCheckCall
branch if condition doubleZeroOk target doubleZeroHolds
branch else target smokeAssertionFailed
label doubleZeroHolds

# halve(10) == 5 (inverse of double)
call halveCall halveSignedInt64
argument halveCall inputValue CSignedInt64 tenNum
run halveCall
bind value halveResult CSignedInt64 halveCall
call halveCheckCall math.equalI64
argument halveCheckCall left I64 halveResult
argument halveCheckCall right I64 fiveNum
run halveCheckCall
bind value halveOk Bool halveCheckCall
branch if condition halveOk target halveHolds
branch else target smokeAssertionFailed
label halveHolds

# halve(1) == 0 (integer truncation toward zero)
call halveOneCall halveSignedInt64
argument halveOneCall inputValue CSignedInt64 oneNum
run halveOneCall
bind value halveOneResult CSignedInt64 halveOneCall
call halveOneCheckCall math.equalI64
argument halveOneCheckCall left I64 halveOneResult
argument halveOneCheckCall right I64 zeroNum
run halveOneCheckCall
bind value halveOneOk Bool halveOneCheckCall
branch if condition halveOneOk target halveOneHolds
branch else target smokeAssertionFailed
label halveOneHolds

# negate(5) == -5
call negateCall negateSignedInt64
argument negateCall inputValue CSignedInt64 fiveNum
run negateCall
bind value negateResult CSignedInt64 negateCall
call negateCheckCall math.equalI64
argument negateCheckCall left I64 negateResult
argument negateCheckCall right I64 minusFiveNum
run negateCheckCall
bind value negateOk Bool negateCheckCall
branch if condition negateOk target negateHolds
branch else target smokeAssertionFailed
label negateHolds

# negate(-5) == 5 (self-inverse on negatives)
call negateNegCall negateSignedInt64
argument negateNegCall inputValue CSignedInt64 minusFiveNum
run negateNegCall
bind value negateNegResult CSignedInt64 negateNegCall
call negateNegCheckCall math.equalI64
argument negateNegCheckCall left I64 negateNegResult
argument negateNegCheckCall right I64 fiveNum
run negateNegCheckCall
bind value negateNegOk Bool negateNegCheckCall
branch if condition negateNegOk target negateNegHolds
branch else target smokeAssertionFailed
label negateNegHolds

# negate(0) == 0
call negateZeroCall negateSignedInt64
argument negateZeroCall inputValue CSignedInt64 zeroNum
run negateZeroCall
bind value negateZeroResult CSignedInt64 negateZeroCall
call negateZeroCheckCall math.equalI64
argument negateZeroCheckCall left I64 negateZeroResult
argument negateZeroCheckCall right I64 zeroNum
run negateZeroCheckCall
bind value negateZeroOk Bool negateZeroCheckCall
branch if condition negateZeroOk target negateZeroHolds
branch else target smokeAssertionFailed
label negateZeroHolds

# reciprocal(2.0) â‰ˆ 0.5 (within tolerance)
storage module immutable twoFloat CFloat64 2.0
storage module immutable halfFloat CFloat64 0.5
storage module immutable recipTol CFloat64 0.0001
call reciprocalCall reciprocalFloat64
argument reciprocalCall inputValue CFloat64 twoFloat
run reciprocalCall
bind value reciprocalResult CFloat64 reciprocalCall
call reciprocalDiffCall math.subtractF64
argument reciprocalDiffCall left F64 reciprocalResult
argument reciprocalDiffCall right F64 halfFloat
run reciprocalDiffCall
bind value reciprocalDiff CFloat64 reciprocalDiffCall
# absolute value of difference: if negative, multiply by -1
memory main mutable reciprocalAbsAccum CFloat64 0.0
set memory reciprocalAbsAccum reciprocalDiff
storage module immutable zeroFloatRecip CFloat64 0.0
storage module immutable negOneFloatRecip CFloat64 -1.0
call reciprocalNegCheckCall math.lessThanF64
argument reciprocalNegCheckCall left F64 reciprocalAbsAccum
argument reciprocalNegCheckCall right F64 zeroFloatRecip
run reciprocalNegCheckCall
bind value reciprocalIsNeg Bool reciprocalNegCheckCall
branch if condition reciprocalIsNeg target flipReciprocal
branch else target checkReciprocalTol
label flipReciprocal
call reciprocalFlipCall math.multiplyF64
argument reciprocalFlipCall left F64 reciprocalAbsAccum
argument reciprocalFlipCall right F64 negOneFloatRecip
run reciprocalFlipCall
bind value reciprocalFlipped CFloat64 reciprocalFlipCall
set memory reciprocalAbsAccum reciprocalFlipped
jump target checkReciprocalTol
label checkReciprocalTol
call reciprocalCheckCall math.lessThanF64
argument reciprocalCheckCall left F64 reciprocalAbsAccum
argument reciprocalCheckCall right F64 recipTol
run reciprocalCheckCall
bind value reciprocalOk Bool reciprocalCheckCall
branch if condition reciprocalOk target reciprocalHolds
branch else target smokeAssertionFailed
label reciprocalHolds

# triangularNumberSignedInt64(10) == 55 (1+2+...+10)
call triangularCall triangularNumberSignedInt64
argument triangularCall inputValue CSignedInt64 tenNum
run triangularCall
bind value triangularResult CSignedInt64 triangularCall
call triangularCheckCall math.equalI64
argument triangularCheckCall left I64 triangularResult
argument triangularCheckCall right I64 fiftyFiveNum
run triangularCheckCall
bind value triangularOk Bool triangularCheckCall
branch if condition triangularOk target triangularHolds
branch else target smokeAssertionFailed
label triangularHolds

# triangularNumberSignedInt64(0) == 0 (boundary)
call triangularZeroCall triangularNumberSignedInt64
argument triangularZeroCall inputValue CSignedInt64 zeroNum
run triangularZeroCall
bind value triangularZeroResult CSignedInt64 triangularZeroCall
call triangularZeroCheckCall math.equalI64
argument triangularZeroCheckCall left I64 triangularZeroResult
argument triangularZeroCheckCall right I64 zeroNum
run triangularZeroCheckCall
bind value triangularZeroOk Bool triangularZeroCheckCall
branch if condition triangularZeroOk target triangularZeroHolds
branch else target smokeAssertionFailed
label triangularZeroHolds

# sumSignedInt64SquaresOneThroughN(3) == 14 (1+4+9)
call sumSqCall sumSignedInt64SquaresOneThroughN
argument sumSqCall inputValue CSignedInt64 threeNum
run sumSqCall
bind value sumSqResult CSignedInt64 sumSqCall
call sumSqCheckCall math.equalI64
argument sumSqCheckCall left I64 sumSqResult
argument sumSqCheckCall right I64 fourteenNum
run sumSqCheckCall
bind value sumSqOk Bool sumSqCheckCall
branch if condition sumSqOk target sumSqHolds
branch else target smokeAssertionFailed
label sumSqHolds

# sumSignedInt64CubesOneThroughN(2) == 9 (1+8)
storage module immutable nineNum CSignedInt64 9
call sumCubesCall sumSignedInt64CubesOneThroughN
argument sumCubesCall inputValue CSignedInt64 twoNum
run sumCubesCall
bind value sumCubesResult CSignedInt64 sumCubesCall
call sumCubesCheckCall math.equalI64
argument sumCubesCheckCall left I64 sumCubesResult
argument sumCubesCheckCall right I64 nineNum
run sumCubesCheckCall
bind value sumCubesOk Bool sumCubesCheckCall
branch if condition sumCubesOk target sumCubesHolds
branch else target smokeAssertionFailed
label sumCubesHolds

# sumSignedInt64CubesOneThroughN(3) == 36 (1+8+27); also equal to triangular(3)^2 = 6^2
call sumCubes3Call sumSignedInt64CubesOneThroughN
argument sumCubes3Call inputValue CSignedInt64 threeNum
run sumCubes3Call
bind value sumCubes3Result CSignedInt64 sumCubes3Call
call sumCubes3CheckCall math.equalI64
argument sumCubes3CheckCall left I64 sumCubes3Result
argument sumCubes3CheckCall right I64 thirtySixExpectedLcm
run sumCubes3CheckCall
bind value sumCubes3Ok Bool sumCubes3CheckCall
branch if condition sumCubes3Ok target sumCubes3Holds
branch else target smokeAssertionFailed
label sumCubes3Holds

# Property: increment then decrement is identity. increment(decrement(5)) == 5
call propDecCall decrementSignedInt64
argument propDecCall inputValue CSignedInt64 fiveNum
run propDecCall
bind value propDecResult CSignedInt64 propDecCall
call propIncCall incrementSignedInt64
argument propIncCall inputValue CSignedInt64 propDecResult
run propIncCall
bind value propIncResult CSignedInt64 propIncCall
call propRoundCheckCall math.equalI64
argument propRoundCheckCall left I64 propIncResult
argument propRoundCheckCall right I64 fiveNum
run propRoundCheckCall
bind value propRoundOk Bool propRoundCheckCall
branch if condition propRoundOk target propRoundHolds
branch else target smokeAssertionFailed
label propRoundHolds

# Property: halve(double(x)) == x for even-friendly x. halve(double(15)) == 15
call propDoubleCall doubleSignedInt64
argument propDoubleCall inputValue CSignedInt64 fifteenNum
run propDoubleCall
bind value propDoubleResult CSignedInt64 propDoubleCall
call propHalveCall halveSignedInt64
argument propHalveCall inputValue CSignedInt64 propDoubleResult
run propHalveCall
bind value propHalveResult CSignedInt64 propHalveCall
call propHalveCheckCall math.equalI64
argument propHalveCheckCall left I64 propHalveResult
argument propHalveCheckCall right I64 fifteenNum
run propHalveCheckCall
bind value propHalveOk Bool propHalveCheckCall
branch if condition propHalveOk target propHalveHolds
branch else target smokeAssertionFailed
label propHalveHolds

# Property: LCM is symmetric â€” LCM(18, 12) == LCM(12, 18) == 36
call lcmSymCall leastCommonMultipleSignedInt64
argument lcmSymCall leftValue CSignedInt64 eighteenValue
argument lcmSymCall rightValue CSignedInt64 twelveValue
run lcmSymCall
bind ok lcmSymResult CSignedInt64 lcmSymCall
call lcmSymCheckCall math.equalI64
argument lcmSymCheckCall left I64 lcmSymResult
argument lcmSymCheckCall right I64 thirtySixExpectedLcm
run lcmSymCheckCall
bind value lcmSymOk Bool lcmSymCheckCall
branch if condition lcmSymOk target lcmSymHolds
branch else target smokeAssertionFailed
label lcmSymHolds

storage module immutable successMessageText CNullTerminatedByteString "OK"
call writeSuccessLineCall console.writeLine
argument writeSuccessLineCall console Console console
argument writeSuccessLineCall text CNullTerminatedByteString successMessageText
run writeSuccessLineCall
ignore ok source writeSuccessLineCall type CSignedInt32
bind error consoleWriteResultError CSignedInt32 writeSuccessLineCall
branch error source writeSuccessLineCall target consoleWriteFailedHandler
storage module immutable exitOkCode ExitCode 0
return ok exitOkCode

# Failure leg: surface the raw negative CSignedInt32 from
# console.writeLine as the cause attached to the typed
# MainError.ConsoleWriteFailed variant.
label consoleWriteFailedHandler
makeError consoleWriteFailedFailure MainError.ConsoleWriteFailed consoleWriteResultError
return error consoleWriteFailedFailure
label smokeAssertionFailed
makeError numericSmokeFailure MainError.NumericSmokeAssertionFailed
return error numericSmokeFailure
