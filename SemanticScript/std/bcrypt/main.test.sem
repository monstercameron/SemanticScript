# ============================================================
# SEMANTICSCRIPT STANDARD LIBRARY TESTS: standard.bcrypt round-trip
# ============================================================
#
# rationale: smoke for the bcrypt native ABI adapter. Hashes a plaintext
#   at the minimum cost (4 — fast enough for a smoke), then confirms the
#   produced hash verifies against the correct password and rejects a
#   wrong one. Exercises the Result-shaped bcrypt.hashPasswordResult +
#   bcrypt.verifyPasswordResult wrappers end to end.
#
# harness note: bcrypt.* are compiler-lowered native ABI calls backed by
#   the vendored bcrypt runtime, so this smoke is BUILT AND RUN AS A
#   NATIVE EXE (it cannot run under the JIT --run path):
#     python SemanticScript/compiler/semsc.py \
#       SemanticScript/std/bcrypt/main.test.sem --emit-exe bcrypt_smoke.exe
#     ./bcrypt_smoke.exe   # prints "OK", exit 0
#
# invariant: hashPasswordResult returns OK true; verifyPasswordResult returns
#   OK true for the correct password and OK false for a wrong one.

project StdBcryptTest
target console
runtime native 1
entry console main

import bcrypt standard.bcrypt
error MainError
errorCase MainError BcryptSmokeAssertionFailed
errorCase MainError MemoryAllocationFailed
errorCase MainError ConsoleWriteFailed

capability stdoutWriteCapability console.stdout write
capability heapAllocationCapability heap allocate

operation main
input operation main console Console
output operation main Result ExitCode MainError
useCapability main stdoutWriteCapability
useCapability main heapAllocationCapability
effect main write console.stdout
effect main allocate heap
effect main free heap
memory main heap auto
async main no
purpose operation main "Hash a password and verify the correct and a wrong password against it through Result-shaped bcrypt wrappers."
invariant operation main "hashPasswordResult OK true; verify(correct) OK true; verify(wrong) OK false."

label startMain

storage module immutable hashBufferCapacity ByteCount 61
call allocateHashBufferCall c.malloc
argument allocateHashBufferCall size ByteCount hashBufferCapacity
run allocateHashBufferCall
bind value hashBuffer OpaquePointer allocateHashBufferCall
bind error hashBufferAllocError Int32 allocateHashBufferCall
branch error source allocateHashBufferCall target heapAllocationFailedHandler
defer releaseHashBufferDefer c.free hashBuffer

storage module immutable smokePassword String "correct-horse-battery-staple"
storage module immutable wrongPassword String "Tr0ub4dor&3"
storage module immutable smokeBcryptCost Int32 4
storage module immutable hashBufferCapacityInt Int32 61
storage module immutable bcryptStatusOk Int32 0

call hashPasswordCall bcrypt.hashPasswordResult
argument hashPasswordCall plaintext String smokePassword
argument hashPasswordCall cost Int32 smokeBcryptCost
argument hashPasswordCall outBuffer OpaquePointer hashBuffer
argument hashPasswordCall outCapacity Int32 hashBufferCapacityInt
run hashPasswordCall
bind ok hashWritten Bool hashPasswordCall
bind error hashError Int32 hashPasswordCall
branch error source hashPasswordCall target smokeAssertionFailed
branch if condition hashWritten target hashStatusHolds
branch else target smokeAssertionFailed
label hashStatusHolds

# Correct password must verify (OK Bool true).
call verifyCorrectCall bcrypt.verifyPasswordResult
argument verifyCorrectCall plaintext String smokePassword
argument verifyCorrectCall expectedHash String hashBuffer
run verifyCorrectCall
bind ok verifyCorrectMatched Bool verifyCorrectCall
bind error verifyCorrectError Int32 verifyCorrectCall
branch error source verifyCorrectCall target smokeAssertionFailed
branch if condition verifyCorrectMatched target verifyCorrectHolds
branch else target smokeAssertionFailed
label verifyCorrectHolds

# Wrong password must NOT verify (OK Bool false).
call verifyWrongCall bcrypt.verifyPasswordResult
argument verifyWrongCall plaintext String wrongPassword
argument verifyWrongCall expectedHash String hashBuffer
run verifyWrongCall
bind ok verifyWrongMatched Bool verifyWrongCall
bind error verifyWrongError Int32 verifyWrongCall
branch error source verifyWrongCall target smokeAssertionFailed
branch if condition verifyWrongMatched target smokeAssertionFailed
branch else target verifyWrongHolds
label verifyWrongHolds

# issueSessionToken: a fresh CSPRNG token must encode with status 0.
storage module immutable sessionRandomByteCount ByteCount 32
call allocSessionRandomCall c.malloc
argument allocSessionRandomCall size ByteCount sessionRandomByteCount
run allocSessionRandomCall
bind value sessionRandomBuffer BcryptRandomBuffer allocSessionRandomCall
bind error sessionRandomAllocError Int32 allocSessionRandomCall
branch error source allocSessionRandomCall target sessionAllocFailedHandler
defer releaseSessionRandomDefer c.free sessionRandomBuffer
storage module immutable sessionTokenByteCount ByteCount 44
call allocSessionTokenCall c.malloc
argument allocSessionTokenCall size ByteCount sessionTokenByteCount
run allocSessionTokenCall
bind value sessionTokenBuffer Base64UrlBuffer allocSessionTokenCall
bind error sessionTokenAllocError Int32 allocSessionTokenCall
branch error source allocSessionTokenCall target sessionAllocFailedHandler
defer releaseSessionTokenDefer c.free sessionTokenBuffer
storage module immutable sessionLengthByteCount ByteCount 8
call allocSessionLengthCall c.malloc
argument allocSessionLengthCall size ByteCount sessionLengthByteCount
run allocSessionLengthCall
bind value sessionLengthBuffer OpaquePointer allocSessionLengthCall
bind error sessionLengthAllocError Int32 allocSessionLengthCall
branch error source allocSessionLengthCall target sessionAllocFailedHandler
defer releaseSessionLengthDefer c.free sessionLengthBuffer
storage module immutable sessionTokenCapacityInt Int32 44

call randomBytesResultCall bcrypt.randomBytesResult
argument randomBytesResultCall outBuffer BcryptRandomBuffer sessionRandomBuffer
argument randomBytesResultCall byteCount Int32 sessionRandomByteCount
run randomBytesResultCall
bind ok randomBytesResultOk Bool randomBytesResultCall
bind error randomBytesResultError Int32 randomBytesResultCall
branch error source randomBytesResultCall target smokeAssertionFailed
branch if condition randomBytesResultOk target randomBytesResultHolds
branch else target smokeAssertionFailed
label randomBytesResultHolds

call base64UrlEncodeResultCall bcrypt.base64UrlEncodeResult
argument base64UrlEncodeResultCall inputBuffer BcryptRandomBuffer sessionRandomBuffer
argument base64UrlEncodeResultCall inputCount Int32 sessionRandomByteCount
argument base64UrlEncodeResultCall outputBuffer Base64UrlBuffer sessionTokenBuffer
argument base64UrlEncodeResultCall outputCapacity Int32 sessionTokenCapacityInt
argument base64UrlEncodeResultCall outputLengthOut OpaquePointer sessionLengthBuffer
run base64UrlEncodeResultCall
bind ok base64UrlEncodeResultOk Bool base64UrlEncodeResultCall
bind error base64UrlEncodeResultError Int32 base64UrlEncodeResultCall
branch error source base64UrlEncodeResultCall target smokeAssertionFailed
branch if condition base64UrlEncodeResultOk target base64UrlEncodeResultHolds
branch else target smokeAssertionFailed
label base64UrlEncodeResultHolds

call issueSessionTokenCall bcrypt.issueSessionToken
argument issueSessionTokenCall randomScratch BcryptRandomBuffer sessionRandomBuffer
argument issueSessionTokenCall tokenBuffer Base64UrlBuffer sessionTokenBuffer
argument issueSessionTokenCall tokenCapacity Int32 sessionTokenCapacityInt
argument issueSessionTokenCall tokenLengthOut OpaquePointer sessionLengthBuffer
run issueSessionTokenCall
bind value issueSessionTokenStatus Int32 issueSessionTokenCall
call checkIssueStatusCall math.equalInt32
argument checkIssueStatusCall left Int32 issueSessionTokenStatus
argument checkIssueStatusCall right Int32 bcryptStatusOk
run checkIssueStatusCall
bind value issueStatusOk Bool checkIssueStatusCall
branch if condition issueStatusOk target issueStatusHolds
branch else target smokeAssertionFailed
label issueStatusHolds

# Session-token-at-rest flow: hash the issued token before persistence,
# then verify a presented token against the stored hash shape.
call hashSessionTokenCall bcrypt.hashSessionTokenResult
argument hashSessionTokenCall token SessionToken sessionTokenBuffer
argument hashSessionTokenCall cost Int32 smokeBcryptCost
argument hashSessionTokenCall outBuffer BcryptHashBuffer hashBuffer
argument hashSessionTokenCall outCapacity Int32 hashBufferCapacityInt
run hashSessionTokenCall
bind ok sessionTokenHashWritten Bool hashSessionTokenCall
bind error sessionTokenHashError Int32 hashSessionTokenCall
branch error source hashSessionTokenCall target smokeAssertionFailed
branch if condition sessionTokenHashWritten target sessionTokenHashStatusHolds
branch else target smokeAssertionFailed
label sessionTokenHashStatusHolds

call verifySessionTokenCall bcrypt.verifySessionTokenResult
argument verifySessionTokenCall token SessionToken sessionTokenBuffer
argument verifySessionTokenCall expectedHash SessionTokenHash hashBuffer
run verifySessionTokenCall
bind ok sessionTokenMatched Bool verifySessionTokenCall
bind error sessionTokenVerifyError Int32 verifySessionTokenCall
branch error source verifySessionTokenCall target smokeAssertionFailed
branch if condition sessionTokenMatched target sessionTokenVerifyHolds
branch else target smokeAssertionFailed
label sessionTokenVerifyHolds

call issueCsrfTokenCall bcrypt.issueCsrfToken
argument issueCsrfTokenCall randomScratch BcryptRandomBuffer sessionRandomBuffer
argument issueCsrfTokenCall tokenBuffer CsrfTokenBuffer sessionTokenBuffer
argument issueCsrfTokenCall tokenCapacity Int32 sessionTokenCapacityInt
argument issueCsrfTokenCall tokenLengthOut OpaquePointer sessionLengthBuffer
run issueCsrfTokenCall
bind value issueCsrfTokenStatus Int32 issueCsrfTokenCall
call checkCsrfStatusCall math.equalInt32
argument checkCsrfStatusCall left Int32 issueCsrfTokenStatus
argument checkCsrfStatusCall right Int32 bcryptStatusOk
run checkCsrfStatusCall
bind value csrfStatusOk Bool checkCsrfStatusCall
branch if condition csrfStatusOk target csrfStatusHolds
branch else target smokeAssertionFailed
label csrfStatusHolds

storage module immutable successMessageText String "OK"
call writeSuccessLineCall console.writeLine
argument writeSuccessLineCall text String successMessageText
run writeSuccessLineCall
ignore void source writeSuccessLineCall
bind error consoleWriteResultError Int32 writeSuccessLineCall
branch error source writeSuccessLineCall target consoleWriteFailedHandler
storage module immutable exitOkCode ExitCode 0
return ok exitOkCode

label consoleWriteFailedHandler
makeError consoleWriteFailedFailure MainError.ConsoleWriteFailed consoleWriteResultError
return error consoleWriteFailedFailure
label heapAllocationFailedHandler
makeError heapAllocationFailure MainError.MemoryAllocationFailed hashBufferAllocError
return error heapAllocationFailure
label smokeAssertionFailed
makeError bcryptSmokeFailure MainError.BcryptSmokeAssertionFailed
return error bcryptSmokeFailure
label sessionAllocFailedHandler
makeError sessionAllocFailure MainError.MemoryAllocationFailed
return error sessionAllocFailure
