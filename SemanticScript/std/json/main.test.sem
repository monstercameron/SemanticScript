project StdJsonMetadataTest
target console
runtime AgentRuntime 0.1
entry console main

import json standard.json
importConstant importedJsonModuleVersionText json jsonModuleVersionText
importType ImportedJsonBuilder json JsonBuilder

storage module immutable okText String "OK"
storage module immutable successCode ExitCode 0

operation main
output operation main ExitCode
effect main write console.stdout
authority main write console.stdout
memory main heap no
async main no
purpose operation main "Smoke-test the canonical standard.json import path from its module folder."

call writeCall console.writeLine
argument writeCall text String okText
run writeCall
ignore value source writeCall type Int32

return value successCode
