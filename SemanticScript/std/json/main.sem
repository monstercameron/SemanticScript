# ============================================================
# SEMANTICSCRIPT STANDARD LIBRARY: native JSON namespace
# ============================================================
#
# Import this module with:
#
#   import json standard.json
#
# The `json.*` call targets are compiler/runtime-owned intrinsics. This module
# owns the official standard-library import path and semantic type contracts for
# that intrinsic namespace.

# rationale: import as `import json standard.json` for typed JSON
#   builder, finder, document CRUD contracts, json.stringify.* targets,
#   and json.parse.* targets.
# invariant: document access is Result-aware and owned documents must use
#   json.destroyDocument through defer or explicit cleanup.
# memory: JsonBuilder and JsonDocument are opaque owned runtime handles; scratch output uses caller-owned JsonScratchBuffer with explicit JsonCapacityBytes.
# failure: JsonAccessError, JsonEncodeError, and JsonDecodeError describe path, capacity, type, serialization, and parse failures.
# security: treat JsonText, JsonPath, and JsonFieldName from requests or files as untrusted until parsed or validated by the JSON runtime.

module standard.json
purpose module standard.json "Standard-library namespace and contracts for JSON encode/decode, builder, finder, document CRUD, and typed stringify/parse intrinsics."
moduleOwns standard.json "The official import path `standard.json`, semantic JSON type aliases, enum tokens, error domains, default constants, and the compiler-owned `json.*` intrinsic namespace contract."
moduleDoesNotOwn standard.json "Application codecs, record-specific generated codecs, native JSON runtime memory internals, or caller-owned scratch-buffer allocation."
invariant module standard.json "The standard module entry is this file; new modules may import it as alias `json` before using compiler-owned targets in the `json.*` namespace."
invariant module standard.json "Document CRUD handles are capacity-bounded, cursor-addressed native runtime values; source code must use Result-aware access paths and defer cleanup for owned documents."

type JsonBuilder OpaquePointer
type JsonDocument OpaquePointer
type JsonCursor Int64
type JsonText String
type JsonFieldName String
type JsonPath String
type JsonStringValue String
type JsonScratchBuffer OpaquePointer
type JsonCapacityBytes ByteCount

# memory: JsonDocument owns a mutable native JSON tree; pair creation
#   paths with defer or explicit json.destroyDocument cleanup.
# invariant: JsonCursor is scoped to one JsonDocument; structural edits
#   can invalidate descendant cursors.
# memory: JsonScratchBuffer is caller-owned scratch memory; every output
#   reader or serializer must be paired with JsonCapacityBytes.
enum JsonValueKind repr Int32
enumCase JsonValueKind objectJsonValueKind 0
enumCase JsonValueKind arrayJsonValueKind 1
enumCase JsonValueKind stringJsonValueKind 2
enumCase JsonValueKind integerJsonValueKind 3
enumCase JsonValueKind doubleJsonValueKind 4
enumCase JsonValueKind booleanJsonValueKind 5
enumCase JsonValueKind nullJsonValueKind 6

error JsonAccessError
errorCase JsonAccessError PathNotFound Int32
errorCase JsonAccessError WrongType Int32
errorCase JsonAccessError IndexOutOfRange Int32
errorCase JsonAccessError FieldNameTooLong Int32
errorCase JsonAccessError DocumentNotMutable Int32
errorCase JsonAccessError CapacityExceeded Int32
errorCase JsonAccessError MalformedPath Int32
errorCase JsonAccessError ScratchTooSmall Int32

error JsonEncodeError
errorCase JsonEncodeError CapacityExceeded Int32
errorCase JsonEncodeError WrongType Int32
errorCase JsonEncodeError OutputBufferTooSmall Int32

error JsonDecodeError
errorCase JsonDecodeError UnexpectedToken Int32
errorCase JsonDecodeError MissingRequired Int32
errorCase JsonDecodeError WrongType Int32
errorCase JsonDecodeError Oversize Int32
errorCase JsonDecodeError Truncated Int32
errorCase JsonDecodeError EscapeMalformed Int32

# failure: JsonAccessError covers document, path, and cursor mutations;
#   JsonEncodeError covers serialization; JsonDecodeError covers parsing
#   or typed-codec decoding.
exportType standard.json JsonBuilder
exportType standard.json JsonDocument
exportType standard.json JsonCursor
exportType standard.json JsonText
exportType standard.json JsonFieldName
exportType standard.json JsonPath
exportType standard.json JsonStringValue
exportType standard.json JsonScratchBuffer
exportType standard.json JsonCapacityBytes
exportType standard.json JsonValueKind
exportError standard.json JsonAccessError
exportError standard.json JsonEncodeError
exportError standard.json JsonDecodeError
exportConstant standard.json jsonModuleVersionText
exportConstant standard.json defaultJsonBuilderCapacityBytes
exportConstant standard.json defaultJsonScratchCapacityBytes
exportConstant standard.json objectJsonValueKind
exportConstant standard.json arrayJsonValueKind
exportConstant standard.json stringJsonValueKind
exportConstant standard.json integerJsonValueKind
exportConstant standard.json doubleJsonValueKind
exportConstant standard.json booleanJsonValueKind
exportConstant standard.json nullJsonValueKind

typeInvariant JsonBuilder "Opaque handle created by json.createBuilder and freed by json.destroyBuilder."
typeInvariant JsonDocument "Opaque mutable document handle created by json.createDocument or json.createEmptyDocument and freed with defer json.destroyDocument; its backing buffer grows only up to capacityBytes and reports JsonAccessError.CapacityExceeded beyond that bound."
typeInvariant JsonCursor "Stable signed node index within one JsonDocument. Non-structural value replacements preserve existing cursors; removeObjectField, removeArrayElementAt, clearObject, clearArray, setObjectFieldObject, setObjectFieldArray, insertArrayElement*, and replaceArrayElement* with a container value invalidate descendants of the structurally changed node."
typeInvariant JsonText "Null-terminated JSON document or fragment text returned by json.finishBuilder or accepted by json.find* readers."
typeInvariant JsonFieldName "Top-level field name passed to json.field* and json.find* targets."
typeInvariant JsonPath "Null-terminated path parsed as zero or more .fieldName object steps and [index] array steps; every other segment form returns JsonAccessError.MalformedPath."
typeInvariant JsonStringValue "String value written by json.fieldString or json.elementString."
typeInvariant JsonScratchBuffer "Caller-owned byte buffer used by json.findString, json.cursorString, json.cursorObjectFieldNameAt, and json.serializeDocument for unescaped or serialized output."
typeInvariant JsonCapacityBytes "Capacity argument for JSON builder or scratch-buffer operations."
invariant module standard.json "High-level json.stringify.String uses native JSON escaping with bounded caller scratch; high-level primitive json.parse targets reject malformed tokens and trailing junk with JsonDecodeError.UnexpectedToken."

storage module immutable jsonModuleVersionText JsonText "standard.json 0.1"
storage module immutable defaultJsonBuilderCapacityBytes JsonCapacityBytes 4096
storage module immutable defaultJsonScratchCapacityBytes JsonCapacityBytes 1024
