# ============================================================
# Extended unit-test cases: covers the 17 operations the original
# smoke test omitted (tangent, sinh, cosh, tanh, expm1, log1p,
# arcsin, arccos, fma, max, min, positiveDifference, copySign,
# sign, round, cbrt, exp2), plus identity/zero boundaries for the
# already-covered operations.
# ============================================================

storage module immutable tolGeneral CFloat64 0.001
storage module immutable zeroExtra CFloat64 0.0
storage module immutable oneExtra CFloat64 1.0
storage module immutable negOneExtra CFloat64 -1.0
storage module immutable twoExtra CFloat64 2.0
storage module immutable threeExtra CFloat64 3.0
storage module immutable fourExtra CFloat64 4.0
storage module immutable fiveExtra CFloat64 5.0
storage module immutable tenExtra CFloat64 10.0
storage module immutable negFiveExtra CFloat64 -5.0
storage module immutable piHalf CFloat64 1.5707963267948966
storage module immutable piValue CFloat64 3.141592653589793

# absoluteFloat64(0.0) == 0.0
call fabsZeroCall absoluteFloat64
argument fabsZeroCall x CFloat64 zeroExtra
run fabsZeroCall
bind ok fabsZeroRes CFloat64 fabsZeroCall
call fabsZeroCheckCall math.equalF64
argument fabsZeroCheckCall left F64 fabsZeroRes
argument fabsZeroCheckCall right F64 zeroExtra
run fabsZeroCheckCall
bind value fabsZeroOk Bool fabsZeroCheckCall
branch if condition fabsZeroOk target fabsZeroOkLabel
branch else target testFailed
label fabsZeroOkLabel

# absoluteFloat64(3.5) == 3.5 (positive identity)
call fabsPosCall absoluteFloat64
argument fabsPosCall x CFloat64 expFabs
run fabsPosCall
bind ok fabsPosRes CFloat64 fabsPosCall
call fabsPosCheckCall math.equalF64
argument fabsPosCheckCall left F64 fabsPosRes
argument fabsPosCheckCall right F64 expFabs
run fabsPosCheckCall
bind value fabsPosOk Bool fabsPosCheckCall
branch if condition fabsPosOk target fabsPosOkLabel
branch else target testFailed
label fabsPosOkLabel

# squareRootFloat64(0.0) Ã¢â€°Ë† 0.0
