argument ce1CheckCall left Float64 ce1Res
argument ce1CheckCall right Float64 cThree
run ce1CheckCall
bind value ce1Ok Bool ce1CheckCall
branch if condition ce1Ok target ce1OkLabel
branch else target testFailed
label ce1OkLabel

# floatingRemainderFloat64(7.5, 2.0) == 1.5
storage module immutable cSevenHalf Float64 7.5
storage module immutable cTwoFl Float64 2.0
storage module immutable cOneHalf Float64 1.5
call fm1Call floatingRemainderFloat64
argument fm1Call x Float64 cSevenHalf
argument fm1Call y Float64 cTwoFl
run fm1Call
bind ok fm1Res Float64 fm1Call
call fm1CheckCall math.equalFloat64
argument fm1CheckCall left Float64 fm1Res
argument fm1CheckCall right Float64 cOneHalf
run fm1CheckCall
bind value fm1Ok Bool fm1CheckCall
branch if condition fm1Ok target fm1OkLabel
branch else target testFailed
label fm1OkLabel

# naturalLogFloat64(e) approximately 1.0
storage module immutable eApprox Float64 2.718281828
storage module immutable oneTarget Float64 1.0
storage module immutable tolLn Float64 0.01
call ln1Call naturalLogFloat64
argument ln1Call x Float64 eApprox
run ln1Call
bind ok ln1Res Float64 ln1Call
call ln1DiffCall math.subtractFloat64
argument ln1DiffCall left Float64 ln1Res
argument ln1DiffCall right Float64 oneTarget
run ln1DiffCall
bind value ln1DiffV Float64 ln1DiffCall
call ln1AbsCall absoluteFloat64
argument ln1AbsCall x Float64 ln1DiffV
run ln1AbsCall
bind ok ln1AbsV Float64 ln1AbsCall
call ln1CheckCall math.lessThanFloat64
argument ln1CheckCall left Float64 ln1AbsV
argument ln1CheckCall right Float64 tolLn
run ln1CheckCall
bind value ln1Ok Bool ln1CheckCall
branch if condition ln1Ok target ln1OkLabel
branch else target testFailed
label ln1OkLabel

# powerFloat64(2.0, 10.0) approximately 1024.0
storage module immutable cTen Float64 10.0
storage module immutable cOneOhTwoFour Float64 1024.0
storage module immutable tolPw Float64 5.0
call pw1Call powerFloat64
