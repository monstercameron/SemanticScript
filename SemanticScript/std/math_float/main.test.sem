bind ok sqrtZeroRes CFloat64 sqrtZeroCall
call sqrtZeroAbsCall absoluteFloat64
argument sqrtZeroAbsCall x CFloat64 sqrtZeroRes
run sqrtZeroAbsCall
bind ok sqrtZeroAbs CFloat64 sqrtZeroAbsCall
call sqrtZeroCheckCall math.lessThanF64
argument sqrtZeroCheckCall left F64 sqrtZeroAbs
argument sqrtZeroCheckCall right F64 tolGeneral
run sqrtZeroCheckCall
bind value sqrtZeroOk Bool sqrtZeroCheckCall
branch if condition sqrtZeroOk target sqrtZeroOkLabel
branch else target testFailed
label sqrtZeroOkLabel

