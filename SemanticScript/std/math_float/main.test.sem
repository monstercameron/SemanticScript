# ============================================================
# Extended unit-test cases: covers the 17 operations the original
# smoke test omitted (tangent, sinh, cosh, tanh, expm1, log1p,
# arcsin, arccos, fma, max, min, positiveDifference, copySign,
# sign, round, cbrt, exp2), plus identity/zero boundaries for the
# already-covered operations.
# ============================================================

storage module immutable tolGeneral Float64 0.001
storage module immutable zeroExtra Float64 0.0
storage module immutable oneExtra Float64 1.0
storage module immutable negOneExtra Float64 -1.0
storage module immutable twoExtra Float64 2.0
storage module immutable threeExtra Float64 3.0
storage module immutable fourExtra Float64 4.0
storage module immutable fiveExtra Float64 5.0
storage module immutable tenExtra Float64 10.0
storage module immutable negFiveExtra Float64 -5.0
storage module immutable piHalf Float64 1.5707963267948966
storage module immutable piValue Float64 3.141592653589793

# absoluteFloat64(0.0) == 0.0
call fabsZeroCall absoluteFloat64
argument fabsZeroCall x Float64 zeroExtra
run fabsZeroCall
bind ok fabsZeroRes Float64 fabsZeroCall
call fabsZeroCheckCall math.equalFloat64
argument fabsZeroCheckCall left Float64 fabsZeroRes
argument fabsZeroCheckCall right Float64 zeroExtra
run fabsZeroCheckCall
bind value fabsZeroOk Bool fabsZeroCheckCall
branch if condition fabsZeroOk target fabsZeroOkLabel
branch else target testFailed
label fabsZeroOkLabel

# absoluteFloat64(3.5) == 3.5 (positive identity)
