run pw1AbsCall
bind ok pw1AbsV Float64 pw1AbsCall
call pw1CheckCall math.lessThanFloat64
argument pw1CheckCall left Float64 pw1AbsV
argument pw1CheckCall right Float64 tolPw
run pw1CheckCall
bind value pw1Ok Bool pw1CheckCall
branch if condition pw1Ok target pw1OkLabel
branch else target testFailed
label pw1OkLabel

