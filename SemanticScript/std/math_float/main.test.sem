# ============================================================
# SEMANTICSCRIPT STDLIB TESTS: math_float
# ============================================================
#
# Companion smoke + extended unit tests for std/math_float/main.sem.
# Imports the math_float module and exercises the Float64
# transcendentals + arithmetic helpers end-to-end. Most assertions
# use a tolerance comparison since these functions are
# floating-point approximations (Newton's method for sqrt, Taylor
# series for exp/log/sin/cos, etc.).
#
# Pattern: std/main.sem ships pure-module operations only;
# std/main.test.sem carries every smoke / unit test for it.

project StdMathFloatTest
target console
runtime AgentRuntime 0.1
entry console main

import math_float standard.math_float
error MainError
errorCase MainError MathFloatSmokeAssertionFailed
errorCase MainError ConsoleWriteFailed

# section capability
# rationale: smoke-test main writes a single OK line to stdout.
capability stdoutWriteCapability console.stdout write

# ============================================================
# Smoke test
# ============================================================

operation main
input operation main console Console
output operation main Result ExitCode MainError
useCapability main stdoutWriteCapability
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Smoke-test absoluteFloat64 / squareRootFloat64 / exponentialBaseEFloat64. Prints OK on success."
invariant operation main "Every assertion that should hold returns Ok; final OK line is written via console.writeLine."

label startMain

# absoluteFloat64(-3.5) == 3.5
storage module immutable negPointFive Float64 -3.5
storage module immutable expFabs Float64 3.5
call f1Call absoluteFloat64
argument f1Call x Float64 negPointFive
run f1Call
bind ok f1Res Float64 f1Call
call f1CheckCall math.equalFloat64
argument f1CheckCall left Float64 f1Res
argument f1CheckCall right Float64 expFabs
run f1CheckCall
bind value f1Ok Bool f1CheckCall
branch if condition f1Ok target f1OkLabel
branch else target testFailed
label f1OkLabel

# squareRootFloat64(144.0) approximately 12.0
storage module immutable c144 Float64 144.0
storage module immutable c12 Float64 12.0
storage module immutable tol Float64 0.0001
call s1Call squareRootFloat64
argument s1Call x Float64 c144
run s1Call
bind ok s1Res Float64 s1Call
call diffCall math.subtractFloat64
argument diffCall left Float64 s1Res
argument diffCall right Float64 c12
run diffCall
bind value diff Float64 diffCall
call abs1Call absoluteFloat64
argument abs1Call x Float64 diff
run abs1Call
bind ok diffAbs Float64 abs1Call
call s1CheckCall math.lessThanFloat64
argument s1CheckCall left Float64 diffAbs
argument s1CheckCall right Float64 tol
run s1CheckCall
bind value s1Ok Bool s1CheckCall
branch if condition s1Ok target s1OkLabel
branch else target testFailed
label s1OkLabel

# exponentialBaseEFloat64(1.0) approximately 2.718281828
storage module immutable oneExp Float64 1.0
storage module immutable eulerApprox Float64 2.718281828
storage module immutable tolE Float64 0.001
call e1Call exponentialBaseEFloat64
argument e1Call x Float64 oneExp
run e1Call
bind ok e1Res Float64 e1Call
call diff2Call math.subtractFloat64
argument diff2Call left Float64 e1Res
argument diff2Call right Float64 eulerApprox
run diff2Call
bind value diff2 Float64 diff2Call
call abs2Call absoluteFloat64
argument abs2Call x Float64 diff2
run abs2Call
bind ok diff2Abs Float64 abs2Call
call e1CheckCall math.lessThanFloat64
argument e1CheckCall left Float64 diff2Abs
argument e1CheckCall right Float64 tolE
run e1CheckCall
bind value e1Ok Bool e1CheckCall
branch if condition e1Ok target e1OkLabel
branch else target testFailed
label e1OkLabel

# truncateFloat64TowardZero(3.7) == 3.0
storage module immutable cThreeSeven Float64 3.7
storage module immutable cThree Float64 3.0
call tr1Call truncateFloat64TowardZero
argument tr1Call x Float64 cThreeSeven
run tr1Call
bind ok tr1Res Float64 tr1Call
call tr1CheckCall math.equalFloat64
argument tr1CheckCall left Float64 tr1Res
argument tr1CheckCall right Float64 cThree
run tr1CheckCall
bind value tr1Ok Bool tr1CheckCall
branch if condition tr1Ok target tr1OkLabel
branch else target testFailed
label tr1OkLabel

# floorFloat64(-2.3) == -3.0
storage module immutable cNegTwoThree Float64 -2.3
storage module immutable cNegThree Float64 -3.0
call fl1Call floorFloat64
argument fl1Call x Float64 cNegTwoThree
run fl1Call
bind ok fl1Res Float64 fl1Call
call fl1CheckCall math.equalFloat64
argument fl1CheckCall left Float64 fl1Res
argument fl1CheckCall right Float64 cNegThree
run fl1CheckCall
bind value fl1Ok Bool fl1CheckCall
branch if condition fl1Ok target fl1OkLabel
branch else target testFailed
label fl1OkLabel

# ceilingFloat64(2.3) == 3.0
storage module immutable cTwoThree Float64 2.3
call ce1Call ceilingFloat64
argument ce1Call x Float64 cTwoThree
run ce1Call
bind ok ce1Res Float64 ce1Call
