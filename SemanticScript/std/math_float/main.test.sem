# ============================================================
# SEMANTICSCRIPT STDLIB TESTS: math_float
# ============================================================
#
# Companion smoke + extended unit tests for std/math_float/main.sem.
# Imports the math_float module and exercises the CFloat64
# transcendentals + arithmetic helpers end-to-end. Most assertions
# use a tolerance comparison since these functions are
# floating-point approximations (Newton's method for sqrt, Taylor
# series for exp/log/sin/cos, etc.).
#
# Pattern: std/main.sem ships pure-module operations only;
# std/main.test.sem carries every smoke / unit test for it.

project StdMathFloatTest
target console
runtime AgentRuntime 0.1
entry console main

import math_float standard.math_float
error MainError
errorCase MainError MathFloatSmokeAssertionFailed
errorCase MainError ConsoleWriteFailed

# section capability
# rationale: smoke-test main writes a single OK line to stdout.
capability stdoutWriteCapability console.stdout write

# ============================================================
# Smoke test
# ============================================================

operation main
input operation main console Console
output operation main Result ExitCode MainError
useCapability main stdoutWriteCapability
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Smoke-test absoluteFloat64 / squareRootFloat64 / exponentialBaseEFloat64. Prints OK on success."
invariant operation main "Every assertion that should hold returns Ok; final OK line is written via console.writeLine."

label startMain

# absoluteFloat64(-3.5) == 3.5
storage module immutable negPointFive CFloat64 -3.5
storage module immutable expFabs CFloat64 3.5
call f1Call absoluteFloat64
argument f1Call x CFloat64 negPointFive
run f1Call
bind ok f1Res CFloat64 f1Call
call f1CheckCall math.equalF64
argument f1CheckCall left F64 f1Res
argument f1CheckCall right F64 expFabs
run f1CheckCall
bind value f1Ok Bool f1CheckCall
branch if condition f1Ok target f1OkLabel
branch else target testFailed
label f1OkLabel

# squareRootFloat64(144.0) approximately 12.0
storage module immutable c144 CFloat64 144.0
storage module immutable c12 CFloat64 12.0
storage module immutable tol CFloat64 0.0001
call s1Call squareRootFloat64
argument s1Call x CFloat64 c144
run s1Call
bind ok s1Res CFloat64 s1Call
call diffCall math.subtractF64
argument diffCall left F64 s1Res
argument diffCall right F64 c12
run diffCall
bind value diff CFloat64 diffCall
call abs1Call absoluteFloat64
argument abs1Call x CFloat64 diff
run abs1Call
bind ok diffAbs CFloat64 abs1Call
call s1CheckCall math.lessThanF64
argument s1CheckCall left F64 diffAbs
argument s1CheckCall right F64 tol
run s1CheckCall
bind value s1Ok Bool s1CheckCall
branch if condition s1Ok target s1OkLabel
branch else target testFailed
label s1OkLabel

# exponentialBaseEFloat64(1.0) approximately 2.718281828
storage module immutable oneExp CFloat64 1.0
storage module immutable eulerApprox CFloat64 2.718281828
storage module immutable tolE CFloat64 0.001
call e1Call exponentialBaseEFloat64
argument e1Call x CFloat64 oneExp
run e1Call
bind ok e1Res CFloat64 e1Call
call diff2Call math.subtractF64
argument diff2Call left F64 e1Res
argument diff2Call right F64 eulerApprox
run diff2Call
bind value diff2 CFloat64 diff2Call
call abs2Call absoluteFloat64
argument abs2Call x CFloat64 diff2
run abs2Call
bind ok diff2Abs CFloat64 abs2Call
call e1CheckCall math.lessThanF64
argument e1CheckCall left F64 diff2Abs
argument e1CheckCall right F64 tolE
run e1CheckCall
bind value e1Ok Bool e1CheckCall
branch if condition e1Ok target e1OkLabel
branch else target testFailed
label e1OkLabel

# truncateFloat64TowardZero(3.7) == 3.0
storage module immutable cThreeSeven CFloat64 3.7
storage module immutable cThree CFloat64 3.0
call tr1Call truncateFloat64TowardZero
argument tr1Call x CFloat64 cThreeSeven
run tr1Call
bind ok tr1Res CFloat64 tr1Call
call tr1CheckCall math.equalF64
argument tr1CheckCall left F64 tr1Res
argument tr1CheckCall right F64 cThree
run tr1CheckCall
bind value tr1Ok Bool tr1CheckCall
branch if condition tr1Ok target tr1OkLabel
branch else target testFailed
label tr1OkLabel

# floorFloat64(-2.3) == -3.0
storage module immutable cNegTwoThree CFloat64 -2.3
storage module immutable cNegThree CFloat64 -3.0
call fl1Call floorFloat64
argument fl1Call x CFloat64 cNegTwoThree
run fl1Call
bind ok fl1Res CFloat64 fl1Call
call fl1CheckCall math.equalF64
argument fl1CheckCall left F64 fl1Res
argument fl1CheckCall right F64 cNegThree
run fl1CheckCall
bind value fl1Ok Bool fl1CheckCall
branch if condition fl1Ok target fl1OkLabel
branch else target testFailed
label fl1OkLabel

# ceilingFloat64(2.3) == 3.0
storage module immutable cTwoThree CFloat64 2.3
call ce1Call ceilingFloat64
argument ce1Call x CFloat64 cTwoThree
run ce1Call
bind ok ce1Res CFloat64 ce1Call
call ce1CheckCall math.equalF64
argument ce1CheckCall left F64 ce1Res
argument ce1CheckCall right F64 cThree
run ce1CheckCall
bind value ce1Ok Bool ce1CheckCall
branch if condition ce1Ok target ce1OkLabel
branch else target testFailed
label ce1OkLabel

# floatingRemainderFloat64(7.5, 2.0) == 1.5
storage module immutable cSevenHalf CFloat64 7.5
storage module immutable cTwoFl CFloat64 2.0
storage module immutable cOneHalf CFloat64 1.5
call fm1Call floatingRemainderFloat64
argument fm1Call x CFloat64 cSevenHalf
argument fm1Call y CFloat64 cTwoFl
run fm1Call
bind ok fm1Res CFloat64 fm1Call
call fm1CheckCall math.equalF64
argument fm1CheckCall left F64 fm1Res
argument fm1CheckCall right F64 cOneHalf
run fm1CheckCall
bind value fm1Ok Bool fm1CheckCall
branch if condition fm1Ok target fm1OkLabel
branch else target testFailed
label fm1OkLabel

# naturalLogFloat64(e) approximately 1.0
storage module immutable eApprox CFloat64 2.718281828
storage module immutable oneTarget CFloat64 1.0
storage module immutable tolLn CFloat64 0.01
call ln1Call naturalLogFloat64
argument ln1Call x CFloat64 eApprox
run ln1Call
bind ok ln1Res CFloat64 ln1Call
call ln1DiffCall math.subtractF64
argument ln1DiffCall left F64 ln1Res
argument ln1DiffCall right F64 oneTarget
run ln1DiffCall
bind value ln1DiffV CFloat64 ln1DiffCall
call ln1AbsCall absoluteFloat64
argument ln1AbsCall x CFloat64 ln1DiffV
run ln1AbsCall
bind ok ln1AbsV CFloat64 ln1AbsCall
call ln1CheckCall math.lessThanF64
argument ln1CheckCall left F64 ln1AbsV
argument ln1CheckCall right F64 tolLn
run ln1CheckCall
bind value ln1Ok Bool ln1CheckCall
branch if condition ln1Ok target ln1OkLabel
branch else target testFailed
label ln1OkLabel

# powerFloat64(2.0, 10.0) approximately 1024.0
storage module immutable cTen CFloat64 10.0
storage module immutable cOneOhTwoFour CFloat64 1024.0
storage module immutable tolPw CFloat64 5.0
call pw1Call powerFloat64
argument pw1Call base CFloat64 cTwoFl
argument pw1Call exponent CFloat64 cTen
run pw1Call
bind ok pw1Res CFloat64 pw1Call
call pw1DiffCall math.subtractF64
argument pw1DiffCall left F64 pw1Res
argument pw1DiffCall right F64 cOneOhTwoFour
run pw1DiffCall
bind value pw1DiffV CFloat64 pw1DiffCall
call pw1AbsCall absoluteFloat64
argument pw1AbsCall x CFloat64 pw1DiffV
run pw1AbsCall
bind ok pw1AbsV CFloat64 pw1AbsCall
call pw1CheckCall math.lessThanF64
argument pw1CheckCall left F64 pw1AbsV
argument pw1CheckCall right F64 tolPw
run pw1CheckCall
bind value pw1Ok Bool pw1CheckCall
branch if condition pw1Ok target pw1OkLabel
branch else target testFailed
label pw1OkLabel

# sineRadiansFloat64(0.0) approximately 0.0
storage module immutable zeroFs CFloat64 0.0
storage module immutable tolSin CFloat64 0.001
call sn1Call sineRadiansFloat64
argument sn1Call x CFloat64 zeroFs
