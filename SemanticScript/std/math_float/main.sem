argument subCall left Float64 inputValue
argument subCall right Float64 halfRd
run subCall
bind value shiftedN Float64 subCall
call cCall ceilingFloat64
argument cCall x Float64 shiftedN
run cCall
bind ok rResN Float64 cCall
return value rResN

