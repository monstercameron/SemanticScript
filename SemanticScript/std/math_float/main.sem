run absXcbCall
bind ok absXc Float64 absXcbCall
call powAbsCall powerFloat64
argument powAbsCall base Float64 absXc
argument powAbsCall exponent Float64 oneThirdCb
run powAbsCall
bind ok powAbsRes Float64 powAbsCall
call ltZeroCheckCall math.lessThanFloat64
argument ltZeroCheckCall left Float64 inputValue
argument ltZeroCheckCall right Float64 zeroCb
run ltZeroCheckCall
bind value xIsNeg Bool ltZeroCheckCall
branch if condition xIsNeg target cbrtNegate
return value powAbsRes
label cbrtNegate
call flipCbCall math.multiplyFloat64
argument flipCbCall left Float64 powAbsRes
argument flipCbCall right Float64 negOneCb
run flipCbCall
bind value flippedCb Float64 flipCbCall
return value flippedCb
label cbrtZero
return value zeroCb

