operation arctangentRadiansFloat64
input operation arctangentRadiansFloat64 inputValue CFloat64
output operation arctangentRadiansFloat64 CFloat64
memory arctangentRadiansFloat64 heap no
async arctangentRadiansFloat64 no
purpose operation arctangentRadiansFloat64 "atan(x) via Taylor series for |x| <= 1; uses the identity atan(x) = sign(x)*pi/2 - atan(1/x) for |x| > 1."
invariant operation arctangentRadiansFloat64 "For |x| <= 1, sums 50 Taylor terms with alternating sign. For |x| > 1, recurses on 1/x and reflects through sign(x) * pi/2."
label startArctangentRadiansFloat64
storage module immutable oneAt CFloat64 1.0
storage module immutable negOneAt CFloat64 -1.0
storage module immutable halfPiAt CFloat64 1.5707963267948966
storage module immutable zeroAt CFloat64 0.0

# If |x| > 1, recurse via reciprocal identity.
call absXAtCall absoluteFloat64
argument absXAtCall x CFloat64 inputValue
run absXAtCall
bind ok absX CFloat64 absXAtCall
call largeCall math.greaterThanF64
argument largeCall left CFloat64 absX
argument largeCall right CFloat64 oneAt
run largeCall
bind value isLarge Bool largeCall
branch if condition isLarge target atanLargeBranch
branch else target atanSeries

label atanLargeBranch
# atan(x) = sign(x)*pi/2 - atan(1/x)
call recipCall math.divideF64
argument recipCall left F64 oneAt
argument recipCall right F64 inputValue
run recipCall
bind value recipX CFloat64 recipCall
call recCall arctangentRadiansFloat64
argument recCall x CFloat64 recipX
run recCall
bind ok recV CFloat64 recCall
# sign(x): if x >= 0 use +halfPi, else -halfPi.
call posLargeCall math.greaterThanOrEqualF64
argument posLargeCall left CFloat64 inputValue
argument posLargeCall right CFloat64 zeroAt
run posLargeCall
bind value isPos Bool posLargeCall
memory arctangentRadiansFloat64 mutable signedPi CFloat64 0.0
branch if condition isPos target atanSetPosPi
branch else target atanSetNegPi
label atanSetPosPi
set memory signedPi halfPiAt
# Read signedPi between the two parallel sets so the linter's
# flow-insensitive dead-store check sees an observation. The
# compare-to-zero result is intentionally discarded Ã¢â‚¬â€ its only
# purpose is to surface signedPi as a read between the two sets.
call atanObservePositiveSignedPiCall math.equalF64
argument atanObservePositiveSignedPiCall left F64 signedPi
argument atanObservePositiveSignedPiCall right F64 zeroAt
run atanObservePositiveSignedPiCall
ignore value source atanObservePositiveSignedPiCall type Bool
jump target atanCombine
label atanSetNegPi
call flipPiCall math.multiplyF64
argument flipPiCall left F64 halfPiAt
argument flipPiCall right F64 negOneAt
run flipPiCall
bind value negPi CFloat64 flipPiCall
set memory signedPi negPi
jump target atanCombine
label atanCombine
call combineCall math.subtractF64
argument combineCall left F64 signedPi
argument combineCall right F64 recV
run combineCall
bind value atanLarge CFloat64 combineCall
return value atanLarge

label atanSeries
# Taylor for |x| <= 1: sum_{k=0..19} (-1)^k * x^(2k+1) / (2k+1)
storage module immutable maxTermsAt I64 25
storage module immutable oneIat I64 1
memory arctangentRadiansFloat64 mutable sumAt CFloat64 0.0
memory arctangentRadiansFloat64 mutable termAt CFloat64 0.0
set memory termAt inputValue
memory arctangentRadiansFloat64 mutable kAt I64 0
memory arctangentRadiansFloat64 mutable signAt CFloat64 1.0
# Add first term
set memory sumAt inputValue

label atanLoop
call atDoneCall math.greaterThanOrEqualI64
argument atDoneCall left I64 kAt
argument atDoneCall right I64 maxTermsAt
run atDoneCall
bind value atDoneB Bool atDoneCall
branch if condition atDoneB target atanReturn

# next term factor: -x^2 / (denominator we'll compute)
call xSqAtCall math.multiplyF64
argument xSqAtCall left F64 inputValue
argument xSqAtCall right F64 inputValue
run xSqAtCall
bind value xSqA CFloat64 xSqAtCall
call negXSqAtCall math.multiplyF64
argument negXSqAtCall left F64 xSqA
argument negXSqAtCall right F64 negOneAt
run negXSqAtCall
bind value negXSqA CFloat64 negXSqAtCall

# new exponent index: 2*(k+1)+1 = 2k+3; we accumulate term = term * negXSq * (2k+1) / (2k+3)
storage module immutable twoIat I64 2
call twoKatCall math.multiplyI64
argument twoKatCall left I64 kAt
argument twoKatCall right I64 twoIat
run twoKatCall
bind value twoKAt I64 twoKatCall
call oldExpCall math.addI64
argument oldExpCall left I64 twoKAt
argument oldExpCall right I64 oneIat
run oldExpCall
bind value oldExpI I64 oldExpCall
call newExpCall math.addI64
argument newExpCall left I64 twoKAt
argument newExpCall right I64 oneIat
run newExpCall
bind value newExpIA I64 newExpCall
call newExp2Call math.addI64
argument newExp2Call left I64 newExpIA
argument newExp2Call right I64 twoIat
run newExp2Call
bind value newExpI I64 newExp2Call

# multiply term by negXSq
call termTimesCall math.multiplyF64
argument termTimesCall left F64 termAt
argument termTimesCall right F64 negXSqA
run termTimesCall
bind value term1 CFloat64 termTimesCall
# multiply by oldExpCall / newExpCall
call oldExpFloatCall math.intToFloat
argument oldExpFloatCall value I64 oldExpI
run oldExpFloatCall
bind value oldExpF CFloat64 oldExpFloatCall
call newExpFloatCall math.intToFloat
argument newExpFloatCall value I64 newExpI
run newExpFloatCall
bind value newExpF CFloat64 newExpFloatCall
call termTimes2Call math.multiplyF64
argument termTimes2Call left F64 term1
argument termTimes2Call right F64 oldExpF
run termTimes2Call
bind value term2 CFloat64 termTimes2Call
call termDivCall math.divideF64
argument termDivCall left F64 term2
argument termDivCall right F64 newExpF
run termDivCall
bind value newTerm CFloat64 termDivCall
set memory termAt newTerm

call atSumCall math.addF64
argument atSumCall left F64 sumAt
argument atSumCall right F64 newTerm
run atSumCall
bind value nextSumAt CFloat64 atSumCall
set memory sumAt nextSumAt

call kAtIncCall math.addI64
argument kAtIncCall left I64 kAt
argument kAtIncCall right I64 oneIat
run kAtIncCall
bind value nextKat I64 kAtIncCall
set memory kAt nextKat
jump target atanLoop

label atanReturn
return value sumAt

