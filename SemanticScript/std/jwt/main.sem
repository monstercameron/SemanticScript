# ============================================================
# SEMANTICSCRIPT STANDARD LIBRARY: JWT namespace
# ============================================================
#
# Import this module with:
#
#   import jwt standard.jwt
#
# This module owns the JWT call surface and the native adapter link
# declaration. The compiler only understands generic runtimeBinding native
# symbols; it does not special-case jwt.* call names.

# rationale: Standard-library namespace and contracts for HS256 JWT signing, signature verification, flat claim reading, and token-bearing formatting helpers.
# invariant: Downstream modules import this module as alias `jwt` before calling exported JWT operations; the operation bodies delegate through generic native runtimeBinding rows.
# security: JWT secrets must come from deployment configuration before production. Source literals are acceptable only for local demos and tests.
module standard.jwt
purpose module standard.jwt "Standard-library namespace and contracts for HS256 JWT signing, signature verification, flat claim reading, and token-bearing formatting helpers."
moduleOwns standard.jwt "The official import path `standard.jwt`, JWT access-token trust types, generic claim payload signing, flat JWT claim readers, HS256 status codes, runtimeBinding operation wrappers, and the native adapter source declaration."
moduleDoesNotOwn standard.jwt "Application session state, secret management, claim policy, refresh-token persistence, or route-specific response contracts."
invariant module standard.jwt "Downstream modules import this module as alias `jwt` before calling exported JWT operations; the operation bodies delegate through generic native runtimeBinding rows."
moduleSecurity standard.jwt "JWT secrets must come from deployment configuration before production. Source literals are acceptable only for local demos and tests."
moduleSecurity standard.jwt "The native signer rejects payload templates unless they contain exactly one literal %s placeholder for jti and no other printf directives."

nativeRuntimeSource standard.jwt "SemanticScript/std/jwt/native/sem_jwt_runtime.c"
nativeRuntimeLinkArg standard.jwt windows "-lbcrypt"

capability jwtMemoryBufferRead memory.buffer read
purpose operation jwtMemoryBufferRead "Authority to read JWT inputs and token strings from caller-owned buffers."
capability jwtMemoryBufferWrite memory.buffer write
purpose operation jwtMemoryBufferWrite "Authority to write JWT outputs and auth envelopes into caller-owned buffers."

type JwtAccessToken String
type JwtSecret String
type JwtPayloadTemplate String
type JwtClaimName String
type JwtOutputBuffer OpaquePointer
type JwtClaimBuffer OpaquePointer
type AuthEnvelopeBuffer OpaquePointer

exportType standard.jwt JwtAccessToken
exportType standard.jwt JwtSecret
exportType standard.jwt JwtPayloadTemplate
exportType standard.jwt JwtClaimName
exportType standard.jwt JwtOutputBuffer
exportType standard.jwt JwtClaimBuffer
exportType standard.jwt AuthEnvelopeBuffer

typeInvariant JwtAccessToken "Null-terminated compact JWT string in header.payload.signature form."
typeTrust JwtAccessToken trusted
typeInvariant JwtSecret "Server-side HMAC secret. Must not be logged or sent to clients."
typeTrust JwtSecret secret
typeInvariant JwtPayloadTemplate "Caller-owned JSON claim payload template with exactly one literal %s placeholder for a generated jti and no other printf directives."
typeInvariant JwtClaimName "Top-level JWT claim name used by generic claim readers after signature verification."
typeInvariant JwtOutputBuffer "Caller-owned byte buffer for compact JWT output."
typeInvariant JwtClaimBuffer "Caller-owned byte buffer for decoded string claim output."
typeInvariant AuthEnvelopeBuffer "Caller-owned byte buffer for JSON auth envelopes containing generated tokens."

storage module immutable jwtModuleVersionText String "standard.jwt 0.1"
storage module immutable jwtStatusOk Int32 0
storage module immutable jwtStatusMatch Int32 1
storage module immutable jwtStatusMismatch Int32 0
storage module immutable jwtStatusConfigError Int32 -1
storage module immutable jwtStatusRandomError Int32 -2
storage module immutable jwtStatusMalformedError Int32 -3
storage module immutable jwtStatusOutputTooSmallError Int32 -4
storage module immutable jwtAccessTokenBufferRequiredBytes Int32 512
storage module immutable jwtAuthEnvelopeBufferRequiredBytes Int32 2048
storage module immutable jwtClaimBufferRequiredBytes Int32 128

exportConstant standard.jwt jwtModuleVersionText
exportConstant standard.jwt jwtStatusOk
exportConstant standard.jwt jwtStatusMatch
exportConstant standard.jwt jwtStatusMismatch
exportConstant standard.jwt jwtStatusConfigError
exportConstant standard.jwt jwtStatusRandomError
exportConstant standard.jwt jwtStatusMalformedError
exportConstant standard.jwt jwtStatusOutputTooSmallError
exportConstant standard.jwt jwtAccessTokenBufferRequiredBytes
exportConstant standard.jwt jwtAuthEnvelopeBufferRequiredBytes
exportConstant standard.jwt jwtClaimBufferRequiredBytes

exportOperation standard.jwt hs256SignJsonPayloadWithRandomJti
exportOperation standard.jwt hs256VerifyToken
exportOperation standard.jwt readStringClaim
exportOperation standard.jwt readInt64Claim
exportOperation standard.jwt formatBearerLoginEnvelope
exportOperation standard.jwt formatBearerRefreshEnvelope

# rationale: Write an HS256-signed JWT whose claim payload is supplied by the caller and receives a generated jti.
# invariant: The native binding does not own application claim policy; callers provide the payload template.
operation hs256SignJsonPayloadWithRandomJti
input operation hs256SignJsonPayloadWithRandomJti secret JwtSecret
input operation hs256SignJsonPayloadWithRandomJti payloadTemplate JwtPayloadTemplate
input operation hs256SignJsonPayloadWithRandomJti outBuffer JwtOutputBuffer
input operation hs256SignJsonPayloadWithRandomJti outCapacity Int32
output operation hs256SignJsonPayloadWithRandomJti Int32
effect hs256SignJsonPayloadWithRandomJti read memory.buffer
effect hs256SignJsonPayloadWithRandomJti write memory.buffer
memory hs256SignJsonPayloadWithRandomJti heap no
async hs256SignJsonPayloadWithRandomJti no
useCapability hs256SignJsonPayloadWithRandomJti jwtMemoryBufferRead
useCapability hs256SignJsonPayloadWithRandomJti jwtMemoryBufferWrite
operationBody hs256SignJsonPayloadWithRandomJti runtimeBinding
purpose operation hs256SignJsonPayloadWithRandomJti "Write an HS256-signed JWT whose claim payload is supplied by the caller and receives a generated jti."
invariant operation hs256SignJsonPayloadWithRandomJti "The native binding does not own application claim policy; callers provide the payload template."
runtimeBindingPrecondition hs256SignJsonPayloadWithRandomJti "secret and payloadTemplate are null-terminated, outBuffer points to writable memory, outCapacity is positive, and payloadTemplate contains exactly one literal %s placeholder and no other printf directives."
runtimeBinding hs256SignJsonPayloadWithRandomJti native.ss_jwt_hs256_sign_json_payload_with_random_jti

# rationale: Return jwtStatusMatch only when the compact JWT's HS256 signature matches the supplied secret.
# invariant: This verifier checks compact-token shape and signature only; callers own claim validation.
operation hs256VerifyToken
input operation hs256VerifyToken token JwtAccessToken
input operation hs256VerifyToken secret JwtSecret
output operation hs256VerifyToken Int32
effect hs256VerifyToken read memory.buffer
memory hs256VerifyToken heap no
async hs256VerifyToken no
useCapability hs256VerifyToken jwtMemoryBufferRead
operationBody hs256VerifyToken runtimeBinding
purpose operation hs256VerifyToken "Return jwtStatusMatch only when the compact JWT's HS256 signature matches the supplied secret."
invariant operation hs256VerifyToken "This verifier checks compact-token shape and signature only; callers own claim validation."
runtimeBindingPrecondition hs256VerifyToken "token and secret are null-terminated strings; token is expected to use compact JWT header.payload.signature shape."
runtimeBinding hs256VerifyToken native.ss_jwt_hs256_verify_token

# rationale: Decode a top-level string claim from a compact JWT into caller-owned scratch after the caller has verified signature trust.
# invariant: This helper reads payload shape only and does not authorize a token; callers must verify the signature and enforce claim policy.
operation readStringClaim
input operation readStringClaim token JwtAccessToken
input operation readStringClaim claimName JwtClaimName
input operation readStringClaim outBuffer JwtClaimBuffer
input operation readStringClaim outCapacity Int32
output operation readStringClaim String
effect readStringClaim read memory.buffer
effect readStringClaim write memory.buffer
memory readStringClaim heap no
async readStringClaim no
useCapability readStringClaim jwtMemoryBufferRead
useCapability readStringClaim jwtMemoryBufferWrite
operationBody readStringClaim runtimeBinding
purpose operation readStringClaim "Decode a top-level string claim from a compact JWT into caller-owned scratch after the caller has verified signature trust."
invariant operation readStringClaim "This helper reads payload shape only and does not authorize a token; callers must verify the signature and enforce claim policy."
runtimeBindingPrecondition readStringClaim "token, claimName, and outBuffer are non-null; outCapacity is positive and large enough for the decoded string claim."
runtimeBinding readStringClaim native.ss_jwt_read_string_claim

# rationale: Decode a top-level integer claim from a compact JWT or return the caller-supplied missing default.
# invariant: This helper reads payload shape only and does not authorize a token; callers must verify the signature and enforce claim policy.
operation readInt64Claim
input operation readInt64Claim token JwtAccessToken
input operation readInt64Claim claimName JwtClaimName
input operation readInt64Claim missingDefault Int64
output operation readInt64Claim Int64
effect readInt64Claim read memory.buffer
memory readInt64Claim heap no
async readInt64Claim no
useCapability readInt64Claim jwtMemoryBufferRead
operationBody readInt64Claim runtimeBinding
purpose operation readInt64Claim "Decode a top-level integer claim from a compact JWT or return the caller-supplied missing default."
invariant operation readInt64Claim "This helper reads payload shape only and does not authorize a token; callers must verify the signature and enforce claim policy."
runtimeBindingPrecondition readInt64Claim "token and claimName are non-null; missingDefault is returned for malformed, missing, or non-integer claims."
runtimeBinding readInt64Claim native.ss_jwt_read_int64_claim

# rationale: Format a bearer-token login envelope using caller-supplied user fields and scopes JSON.
# invariant: The formatter must not hard-code application user ids, roles, scopes, issuer, or audience.
operation formatBearerLoginEnvelope
input operation formatBearerLoginEnvelope accessToken JwtAccessToken
input operation formatBearerLoginEnvelope refreshToken String
input operation formatBearerLoginEnvelope userId String
input operation formatBearerLoginEnvelope username String
input operation formatBearerLoginEnvelope displayName String
input operation formatBearerLoginEnvelope roleName String
input operation formatBearerLoginEnvelope scopesJson String
input operation formatBearerLoginEnvelope outBuffer AuthEnvelopeBuffer
input operation formatBearerLoginEnvelope outCapacity Int32
output operation formatBearerLoginEnvelope Int32
effect formatBearerLoginEnvelope read memory.buffer
effect formatBearerLoginEnvelope write memory.buffer
memory formatBearerLoginEnvelope heap no
async formatBearerLoginEnvelope no
useCapability formatBearerLoginEnvelope jwtMemoryBufferRead
useCapability formatBearerLoginEnvelope jwtMemoryBufferWrite
operationBody formatBearerLoginEnvelope runtimeBinding
purpose operation formatBearerLoginEnvelope "Format a bearer-token login envelope using caller-supplied user fields and scopes JSON."
invariant operation formatBearerLoginEnvelope "The formatter must not hard-code application user ids, roles, scopes, issuer, or audience."
runtimeBindingPrecondition formatBearerLoginEnvelope "All text inputs are null-terminated, scopesJson is caller-validated JSON text, outBuffer points to writable memory, and outCapacity is positive."
runtimeBinding formatBearerLoginEnvelope native.ss_jwt_format_bearer_login_envelope

# rationale: Format a bearer-token refresh envelope containing rotated access and refresh tokens.
# invariant: The formatter includes only the caller-supplied tokens and generic bearer envelope fields.
operation formatBearerRefreshEnvelope
input operation formatBearerRefreshEnvelope accessToken JwtAccessToken
input operation formatBearerRefreshEnvelope refreshToken String
input operation formatBearerRefreshEnvelope outBuffer AuthEnvelopeBuffer
input operation formatBearerRefreshEnvelope outCapacity Int32
output operation formatBearerRefreshEnvelope Int32
effect formatBearerRefreshEnvelope read memory.buffer
effect formatBearerRefreshEnvelope write memory.buffer
memory formatBearerRefreshEnvelope heap no
async formatBearerRefreshEnvelope no
useCapability formatBearerRefreshEnvelope jwtMemoryBufferRead
useCapability formatBearerRefreshEnvelope jwtMemoryBufferWrite
operationBody formatBearerRefreshEnvelope runtimeBinding
purpose operation formatBearerRefreshEnvelope "Format a bearer-token refresh envelope containing rotated access and refresh tokens."
invariant operation formatBearerRefreshEnvelope "The formatter includes only the caller-supplied tokens and generic bearer envelope fields."
runtimeBindingPrecondition formatBearerRefreshEnvelope "accessToken and refreshToken are null-terminated, outBuffer points to writable memory, and outCapacity is positive."
runtimeBinding formatBearerRefreshEnvelope native.ss_jwt_format_bearer_refresh_envelope
