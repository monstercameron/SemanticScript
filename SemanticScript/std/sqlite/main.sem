# ============================================================
# SEMANTICSCRIPT STANDARD LIBRARY: native SQLite namespace
# ============================================================
#
# Import this module with:
#
#   import sqlite standard.sqlite
#
# The `sqlite.*` call targets are compiler/runtime-owned intrinsics. This
# module owns the official standard-library import path and semantic type,
# enum, constant, and capability contracts for that intrinsic namespace.

# rationale: Standard-library namespace and contracts for native SQLite database intrinsics.
# invariant: The standard module entry is this file; new modules may import it as alias `sqlite` before using compiler-owned targets in the `sqlite.*` namespace.
module standard.sqlite
purpose module standard.sqlite "Standard-library namespace and contracts for native SQLite database intrinsics."
moduleOwns standard.sqlite "The official import path `standard.sqlite`, semantic SQLite type aliases, enum tokens, reusable database capabilities, and the compiler-owned `sqlite.*` intrinsic namespace contract."
moduleDoesNotOwn standard.sqlite "Application schemas, migrations, query text, transaction policy, native SQLite runtime internals, or caller-owned statement lifetimes."
invariant module standard.sqlite "The standard module entry is this file; new modules may import it as alias `sqlite` before using compiler-owned targets in the `sqlite.*` namespace."

type SqliteDatabase OpaquePointer
type SqliteStatement OpaquePointer
type SqliteRowId Int64
type SqlText String
type SqliteText String
type SqliteBlob OpaquePointer
type SqliteByteCount ByteCount
type SqliteQueryFailure Int32
type SqliteJournalModeFailure Int32
type SqliteTransactionFailure Int32

enum SqliteOpenMode repr Int32
enumCase SqliteOpenMode readOnlySqliteOpenMode 1
enumCase SqliteOpenMode readWriteSqliteOpenMode 2
enumCase SqliteOpenMode readWriteCreateSqliteOpenMode 6
enumCase SqliteOpenMode inMemorySqliteOpenMode 14

enum SqliteStepResult repr Int32
enumCase SqliteStepResult rowSqliteStepResult 100
enumCase SqliteStepResult doneSqliteStepResult 101

enum SqliteColumnType repr Int32
enumCase SqliteColumnType integerSqliteColumnType 1
enumCase SqliteColumnType floatSqliteColumnType 2
enumCase SqliteColumnType textSqliteColumnType 3
enumCase SqliteColumnType blobSqliteColumnType 4
enumCase SqliteColumnType nullSqliteColumnType 5

exportType standard.sqlite SqliteDatabase
exportType standard.sqlite SqliteStatement
exportType standard.sqlite SqliteRowId
exportType standard.sqlite SqlText
exportType standard.sqlite SqliteText
exportType standard.sqlite SqliteBlob
exportType standard.sqlite SqliteByteCount
exportType standard.sqlite SqliteQueryFailure
exportType standard.sqlite SqliteJournalModeFailure
exportType standard.sqlite SqliteTransactionFailure
exportType standard.sqlite SqliteOpenMode
exportType standard.sqlite SqliteStepResult
exportType standard.sqlite SqliteColumnType
exportCapability standard.sqlite sqliteDatabaseReader
exportCapability standard.sqlite sqliteDatabaseReadWriter
exportConstant standard.sqlite sqliteModuleVersionText
exportConstant standard.sqlite readOnlySqliteOpenMode
exportConstant standard.sqlite readWriteSqliteOpenMode
exportConstant standard.sqlite readWriteCreateSqliteOpenMode
exportConstant standard.sqlite inMemorySqliteOpenMode
exportConstant standard.sqlite rowSqliteStepResult
exportConstant standard.sqlite doneSqliteStepResult
exportConstant standard.sqlite integerSqliteColumnType
exportConstant standard.sqlite floatSqliteColumnType
exportConstant standard.sqlite textSqliteColumnType
exportConstant standard.sqlite blobSqliteColumnType
exportConstant standard.sqlite nullSqliteColumnType
exportOperation standard.sqlite openDatabase
exportOperation standard.sqlite closeDatabase
exportOperation standard.sqlite errorMessage
exportOperation standard.sqlite lastInsertRowId
exportOperation standard.sqlite changedRowCount
exportOperation standard.sqlite queryScalarInt64
exportOperation standard.sqlite enableWalMode
exportOperation standard.sqlite prepareStatement
exportOperation standard.sqlite finalizeStatement
exportOperation standard.sqlite resetStatement
exportOperation standard.sqlite stepStatement
exportOperation standard.sqlite bindInt64
exportOperation standard.sqlite bindDouble
exportOperation standard.sqlite bindText
exportOperation standard.sqlite bindBlob
exportOperation standard.sqlite bindNull
exportOperation standard.sqlite columnCount
exportOperation standard.sqlite columnType
exportOperation standard.sqlite columnName
exportOperation standard.sqlite columnInt64
exportOperation standard.sqlite columnDouble
exportOperation standard.sqlite columnText
exportOperation standard.sqlite columnBlob
exportOperation standard.sqlite columnByteCount
exportOperation standard.sqlite libraryVersion
exportOperation standard.sqlite execStatus
exportOperation standard.sqlite exec
exportOperation standard.sqlite beginImmediateTransaction
exportOperation standard.sqlite commitTransaction
exportOperation standard.sqlite rollbackTransaction
typeInvariant SqliteDatabase "Opaque SQLite database handle created by sqlite.openDatabase and closed by sqlite.closeDatabase; webServer apps may store one process-lifetime handle in module/shared process state between startup and shutdown."
# warning: Process-lifetime SqliteDatabase reuse is not a connection pool; guard or replace it before using concurrent handler dispatch.
typeInvariant SqliteStatement "Opaque prepared-statement handle created by sqlite.prepareStatement and finalized by sqlite.finalizeStatement."
typeInvariant SqliteRowId "Signed 64-bit row identifier returned by sqlite.lastInsertRowId and column readers."
typeInvariant SqlText "Null-terminated SQL source text passed to sqlite.prepareStatement or sqlite.exec; dynamic values must use ? placeholders plus sqlite.bind* rows."
invariant module standard.sqlite "sqlite.queryScalarInt64 is the one-shot helper for static no-parameter Int64 scalar reads such as SELECT COUNT(*); parameterized or multi-column reads still use prepare/bind/step/column/finalize."
invariant module standard.sqlite "sqlite.enableWalMode and build-tape sqliteJournalMode PROJECT wal are the first-class WAL configuration surface; callers do not need raw PRAGMA journal_mode = WAL SqlText constants."
invariant module standard.sqlite "sqlite.beginImmediateTransaction, sqlite.commitTransaction, and sqlite.rollbackTransaction are the first-class flat transaction boundary helpers; callers do not need raw BEGIN/COMMIT/ROLLBACK SqlText constants for ordinary transactions."
invariant module standard.sqlite "Generated row identifiers should flow through INSERT ... RETURNING id plus sqlite.columnInt64 on that INSERT statement; sqlite.lastInsertRowId is compatibility-only connection-global state."
typeInvariant SqliteText "Null-terminated SQLite text value; sqlite.columnText/columnName return SQLite-owned memory valid until the same statement advances, resets, finalizes, or performs another pointer-returning column read."
typeInvariant SqliteBlob "Opaque SQLite blob pointer paired with SqliteByteCount."
typeInvariant SqliteByteCount "Byte count paired with SQLite blob/text buffers."
typeInvariant SqliteQueryFailure "Native SQLite status from sqlite.queryScalarInt64 prepare, empty-result, step, or finalize failure."
typeInvariant SqliteJournalModeFailure "Native SQLite status from sqlite.enableWalMode failure."
typeInvariant SqliteTransactionFailure "Native SQLite status from sqlite.beginImmediateTransaction, sqlite.commitTransaction, or sqlite.rollbackTransaction."

capability sqliteDatabaseReader database read
purpose operation sqliteDatabaseReader "Authority to execute read-only SQL — prepareStatement of SELECT statements, bind*, step, and the column readers — against an open SqliteDatabase handle."

capability sqliteDatabaseReadWriter database readWrite
purpose operation sqliteDatabaseReadWriter "Authority to execute read-or-write SQL — prepareStatement of any statement plus sqlite.exec for DDL — against an open SqliteDatabase handle."

storage module immutable sqliteModuleVersionText SqliteText "standard.sqlite 0.1"
