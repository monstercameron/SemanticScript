project StdSqliteModuleTest
target console
runtime native 1
entry console main

import sqlite standard.sqlite
importConstant importedSqliteModuleVersionText sqlite sqliteModuleVersionText

storage module immutable successCode ExitCode 0
storage module immutable okText String "OK"

operation main
output operation main ExitCode
effect main write console.stdout
authority main write console.stdout
memory main heap no
async main no
purpose operation main "Smoke-test that standard.sqlite imports and exposes its version constant."

call writeOkCall console.writeLine
argument writeOkCall text String okText
run writeOkCall
ignore value source writeOkCall type Int32

return value successCode
