# ============================================================
# SEMANTICSCRIPT STANDARD LIBRARY: browser DOM namespace
# ============================================================
#
# Import this module with:
#
#   import document standard.document
#
# The `document.*` operations are ordinary SemanticScript operation wrappers
# over generic native runtimeBinding symbols (`native.ss_dom_*`). The compiler
# does not special-case DOM call names. The runtime adapter is JavaScript, not
# C: it is the emscripten js-library `native/ss_dom_runtime.js`, linked by the
# wasm build (`SemanticScript/tools/build_wasm.py`) via `--js-library`. This
# module therefore only links/runs under the wasm32-emscripten browser target.

module standard.document
purpose module standard.document "Standard-library namespace and contracts for browser DOM read, mutation, and event-stream operations on the wasm32-emscripten target."
moduleOwns standard.document "The official import path `standard.document`, DOM handle types, status constants, reusable DOM capabilities, runtimeBinding operation wrappers, and the JavaScript runtime adapter declaration."
moduleDoesNotOwn standard.document "Application markup structure, CSS, framework component models, server-side rendering, or compiler DOM-specific lowering."
invariant module standard.document "Downstream modules import this module as alias `document`; DOM nodes are referenced by opaque integer handles owned by the JavaScript adapter; event operations are async-only and delegate through generic native runtimeBinding rows."
moduleWarning standard.document "This module targets the browser only. The native adapter is the emscripten js-library native/ss_dom_runtime.js; a native (non-wasm) build leaves the ss_dom_* symbols unresolved by design. Event operations require an Asyncify- or JSPI-enabled emcc build so async await can yield to the browser event loop."

# Handle into the adapter's node table. Zero is the explicit `no node` value
# (null lookups, not-found queries). Handles are integers, not pointers, so the
# same source is correct on ILP32 wasm32 and on a 64-bit host adapter.
type DomHandle Int32
type DomEventStreamHandle Int32
type DomElementId String
type DomSelector String
type DomTagName String
type DomText String
type DomHtmlMarkup String
type DomAttributeName String
type DomAttributeValue String
type DomClassName String
type DomStyleProperty String
type DomStyleValue String
type DomEventName String
type DomEventProperty String
type DomScriptSource String
type DomOutputBuffer OpaquePointer
type DomBufferCapacity Int32
type DomStatus Int32
type DomByteCount Int32

exportType standard.document DomHandle
exportType standard.document DomEventStreamHandle
exportType standard.document DomElementId
exportType standard.document DomSelector
exportType standard.document DomTagName
exportType standard.document DomText
exportType standard.document DomHtmlMarkup
exportType standard.document DomAttributeName
exportType standard.document DomAttributeValue
exportType standard.document DomClassName
exportType standard.document DomStyleProperty
exportType standard.document DomStyleValue
exportType standard.document DomEventName
exportType standard.document DomEventProperty
exportType standard.document DomScriptSource
exportType standard.document DomOutputBuffer
exportType standard.document DomBufferCapacity
exportType standard.document DomStatus
exportType standard.document DomByteCount

typeInvariant DomHandle "Opaque non-negative node handle owned by the JavaScript adapter node table; zero means no node; negative values never appear as handles."
typeTrust DomHandle trustedRuntimeHandle
typeInvariant DomEventStreamHandle "Opaque non-negative event-stream handle returned by document.addEventListener and released by document.removeEventListener; zero means no stream."
typeTrust DomEventStreamHandle trustedRuntimeHandle
typeInvariant DomElementId "Null-terminated element id used with document.getElementById; matched verbatim with no leading selector punctuation."
typeInvariant DomSelector "Null-terminated CSS selector string used with document.querySelector."
typeInvariant DomTagName "Null-terminated HTML tag name such as div or button."
typeInvariant DomText "Null-terminated UTF-8 text assigned to or read from a node's textContent or an input value."
typeInvariant DomHtmlMarkup "Null-terminated UTF-8 HTML markup assigned with document.setInnerHtml; the caller owns sanitization of any untrusted substring."
typeTrust DomHtmlMarkup trustedAfterCallerSanitization
typeInvariant DomAttributeName "Null-terminated attribute name such as href or data-id."
typeInvariant DomAttributeValue "Null-terminated attribute value string."
typeInvariant DomClassName "Null-terminated single CSS class token with no whitespace."
typeInvariant DomStyleProperty "Null-terminated CSS property name such as color or display."
typeInvariant DomStyleValue "Null-terminated CSS property value string."
typeInvariant DomEventName "Null-terminated DOM event type such as click, input, or submit."
typeInvariant DomEventProperty "Null-terminated event property name read by document.eventDetailInto, such as type, key, inputType, or data."
typeInvariant DomScriptSource "Null-terminated JavaScript source evaluated in the page global scope; the caller owns trust of this string."
typeTrust DomScriptSource trustedAfterCallerReview
typeInvariant DomOutputBuffer "Caller-owned writable byte buffer that receives a null-terminated string from a DOM read; null with zero capacity intentionally skips the read."
typeInvariant DomBufferCapacity "Positive byte capacity of a DomOutputBuffer including space for the null terminator, or zero when the buffer is null."
typeInvariant DomStatus "Zero on success or a negative DOM status code."
typeInvariant DomByteCount "Non-negative number of bytes a DOM read produced (excluding the null terminator), or a negative DomStatus on failure."

capability documentReader document.dom read
purpose operation documentReader "Authority to read DOM structure, text, attributes, and values."
capability documentWriter document.dom write
purpose operation documentWriter "Authority to create nodes and mutate DOM structure, text, attributes, classes, and styles."
capability documentEventSubscriber document.event read
purpose operation documentEventSubscriber "Authority to subscribe to and receive DOM events as an async stream."
capability documentEventController document.event close
purpose operation documentEventController "Authority to remove DOM event subscriptions."
capability documentScriptEvaluator document.script execute
purpose operation documentScriptEvaluator "Authority to evaluate JavaScript in the page global scope via document.evalScript."

exportCapability standard.document documentReader
exportCapability standard.document documentWriter
exportCapability standard.document documentEventSubscriber
exportCapability standard.document documentEventController
exportCapability standard.document documentScriptEvaluator

storage module immutable documentModuleVersionText String "standard.document 0.1"
storage module immutable domHandleNone DomHandle 0
storage module immutable domStatusOk DomStatus 0
storage module immutable domStatusError DomStatus -1
storage module immutable domStatusNotFound DomStatus -2
storage module immutable domStatusBufferTooSmall DomStatus -3
storage module immutable domStatusDetached DomStatus -4
storage module immutable domStatusNoEvent DomStatus 0
storage module immutable domStatusStreamClosed DomStatus -6
storage module immutable domStatusCancelled DomStatus -7

exportConstant standard.document documentModuleVersionText
exportConstant standard.document domHandleNone
exportConstant standard.document domStatusOk
exportConstant standard.document domStatusError
exportConstant standard.document domStatusNotFound
exportConstant standard.document domStatusBufferTooSmall
exportConstant standard.document domStatusDetached
exportConstant standard.document domStatusNoEvent
exportConstant standard.document domStatusStreamClosed
exportConstant standard.document domStatusCancelled

exportOperation standard.document bodyElement
exportOperation standard.document documentElement
exportOperation standard.document getElementById
exportOperation standard.document querySelector
exportOperation standard.document createElement
exportOperation standard.document createTextNode
exportOperation standard.document appendChild
exportOperation standard.document removeChild
exportOperation standard.document setTextContent
exportOperation standard.document getTextContentInto
exportOperation standard.document setValue
exportOperation standard.document getValueInto
exportOperation standard.document setInnerHtml
exportOperation standard.document setAttribute
exportOperation standard.document getAttributeInto
exportOperation standard.document removeAttribute
exportOperation standard.document classListAdd
exportOperation standard.document classListRemove
exportOperation standard.document classListToggle
exportOperation standard.document setStyleProperty
exportOperation standard.document addEventListener
exportOperation standard.document nextEvent
exportOperation standard.document eventTarget
exportOperation standard.document eventDetailInto
exportOperation standard.document removeEventListener
exportOperation standard.document releaseHandle
exportOperation standard.document evalScript

# ------------------------------------------------------------
# Node selection
# ------------------------------------------------------------

operation bodyElement
output operation bodyElement DomHandle
effect bodyElement read document.dom
memory bodyElement heap no
async bodyElement no
useCapability bodyElement documentReader
operationBody bodyElement runtimeBinding
purpose operation bodyElement "Return a handle to document.body, or domHandleNone before the body parses."
runtimeBindingPrecondition bodyElement "The page document exists; called only on the wasm32-emscripten browser target."
runtimeBinding bodyElement native.ss_dom_body

operation documentElement
output operation documentElement DomHandle
effect documentElement read document.dom
memory documentElement heap no
async documentElement no
useCapability documentElement documentReader
operationBody documentElement runtimeBinding
purpose operation documentElement "Return a handle to document.documentElement (the root html element)."
runtimeBindingPrecondition documentElement "The page document exists; called only on the wasm32-emscripten browser target."
runtimeBinding documentElement native.ss_dom_document_element

operation getElementById
input operation getElementById elementId DomElementId
output operation getElementById DomHandle
effect getElementById read document.dom
memory getElementById heap no
async getElementById no
useCapability getElementById documentReader
operationBody getElementById runtimeBinding
purpose operation getElementById "Return a handle to the element with the given id, or domHandleNone when no element matches."
runtimeBindingPrecondition getElementById "elementId is a non-null null-terminated string."
runtimeBinding getElementById native.ss_dom_get_element_by_id

operation querySelector
input operation querySelector selector DomSelector
output operation querySelector DomHandle
effect querySelector read document.dom
memory querySelector heap no
async querySelector no
useCapability querySelector documentReader
operationBody querySelector runtimeBinding
purpose operation querySelector "Return a handle to the first element matching a CSS selector, or domHandleNone when none match."
runtimeBindingPrecondition querySelector "selector is a non-null null-terminated valid CSS selector string."
runtimeBinding querySelector native.ss_dom_query_selector

