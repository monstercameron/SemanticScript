# ------------------------------------------------------------
# Events (async-only, pull model over an adapter-owned queue)
# ------------------------------------------------------------

operation addEventListener
input operation addEventListener node DomHandle
input operation addEventListener eventName DomEventName
output operation addEventListener DomEventStreamHandle
effect addEventListener read document.event
memory addEventListener heap no
async addEventListener no
useCapability addEventListener documentEventSubscriber
operationBody addEventListener runtimeBinding
purpose operation addEventListener "Register a DOM event listener on a node and return an event-stream handle whose queued events are drained with document.nextEvent."
invariant operation addEventListener "The returned handle is explicit caller-owned lifecycle state; the listener must be released with document.removeEventListener; no hidden listener persists after removal."
runtimeBindingPrecondition addEventListener "node is a live handle and eventName is a non-null null-terminated DOM event type."
runtimeBinding addEventListener native.ss_dom_add_event_listener

operation nextEvent
input operation nextEvent stream DomEventStreamHandle
output operation nextEvent DomStatus
effect nextEvent read document.event
memory nextEvent heap no
async nextEvent no
useCapability nextEvent documentEventSubscriber
operationBody nextEvent runtimeBinding
purpose operation nextEvent "Block until the next queued event on an event-stream handle, returning domStatusOk on an event or domStatusStreamClosed when the stream is removed."
invariant operation nextEvent "Suspension is delegated to the emcc Asyncify/JSPI layer, not to the SemanticScript async-future runtime: the JavaScript adapter import is declared async, so the wasm stack unwinds to the browser event loop while waiting and rewinds when the event fires. From the tape's view this is an ordinary blocking call; it never busy-waits."
warning nextEvent "Requires an Asyncify- or JSPI-enabled emcc build. Without it the call cannot suspend and will trap. There is no built-in timeout; pair long-lived listeners with document.removeEventListener on a shutdown path."
runtimeBindingPrecondition nextEvent "stream is a live event-stream handle returned by document.addEventListener."
runtimeBinding nextEvent native.ss_dom_next_event

operation eventTarget
input operation eventTarget stream DomEventStreamHandle
output operation eventTarget DomHandle
effect eventTarget read document.event
memory eventTarget heap no
async eventTarget no
useCapability eventTarget documentEventSubscriber
operationBody eventTarget runtimeBinding
purpose operation eventTarget "Return a handle to the target element of the event most recently delivered by document.nextEvent on this stream, or domHandleNone when none has been delivered."
runtimeBindingPrecondition eventTarget "stream is a live event-stream handle on which document.nextEvent has returned at least one event."
runtimeBinding eventTarget native.ss_dom_event_target

operation eventDetailInto
input operation eventDetailInto stream DomEventStreamHandle
input operation eventDetailInto property DomEventProperty
input operation eventDetailInto outValue DomOutputBuffer
input operation eventDetailInto outValueCapacity DomBufferCapacity
output operation eventDetailInto DomByteCount
effect eventDetailInto read document.event
effect eventDetailInto write memory.buffer
memory eventDetailInto heap no
async eventDetailInto no
useCapability eventDetailInto documentEventSubscriber
operationBody eventDetailInto runtimeBinding
purpose operation eventDetailInto "Copy a string property (such as type, key, inputType, or data) of the current event into a caller buffer and return the byte count, domStatusNotFound when the property is absent, or domStatusBufferTooSmall."
runtimeBindingPrecondition eventDetailInto "stream has a delivered event; property is non-null null-terminated; outValue is writable with outValueCapacity bytes including the null terminator."
runtimeBinding eventDetailInto native.ss_dom_event_detail

operation removeEventListener
input operation removeEventListener stream DomEventStreamHandle
output operation removeEventListener DomStatus
effect removeEventListener close document.event
memory removeEventListener heap no
async removeEventListener no
useCapability removeEventListener documentEventController
operationBody removeEventListener runtimeBinding
purpose operation removeEventListener "Detach the DOM listener for an event-stream handle and release its queue, returning domStatusOk or a negative status."
runtimeBindingPrecondition removeEventListener "stream is a live event-stream handle returned by document.addEventListener."
runtimeBinding removeEventListener native.ss_dom_remove_event_listener

operation releaseHandle
input operation releaseHandle node DomHandle
output operation releaseHandle DomStatus
effect releaseHandle read document.dom
memory releaseHandle heap no
async releaseHandle no
useCapability releaseHandle documentReader
operationBody releaseHandle runtimeBinding
purpose operation releaseHandle "Release a node handle from the adapter handle table so it can be reclaimed, returning domStatusOk or domStatusDetached when the handle is already free."
invariant operation releaseHandle "Releasing only drops the wasm-side handle; it does not remove the node from the DOM. Release handles for transient query results in long-lived programs to bound the handle table."
runtimeBindingPrecondition releaseHandle "node is a handle previously returned by this module; releasing domHandleNone is a no-op error."
runtimeBinding releaseHandle native.ss_dom_release

# ------------------------------------------------------------
# Escape hatch
# ------------------------------------------------------------

operation evalScript
input operation evalScript script DomScriptSource
output operation evalScript DomStatus
effect evalScript execute document.script
memory evalScript heap no
async evalScript no
useCapability evalScript documentScriptEvaluator
operationBody evalScript runtimeBinding
purpose operation evalScript "Evaluate JavaScript in the page global scope, returning domStatusOk or a negative status. The escape hatch for DOM behavior not yet wrapped by a typed operation."
invariant operation evalScript "Script trust is the caller's responsibility; prefer typed operations and reserve this for gaps in the wrapped surface."
runtimeBindingPrecondition evalScript "script is a non-null null-terminated JavaScript source string the caller has reviewed."
runtimeBinding evalScript native.ss_dom_eval_script
