# SemanticScript standard-library canonical module: standard.array.

module standard.array
purpose module standard.array "Canonical standard-library module for array helpers."
moduleOwns standard.array "The official import path `standard.array` and this module's implementation body."
moduleDoesNotOwn standard.array "App-specific wrappers, compatibility aliases, or generated build artifacts."
invariant module standard.array "The standard module entry is this file; tests live beside it as `main.test.sem`."

exportConstant standard.array arrayModuleVersionText
storage module immutable arrayModuleVersionText CNullTerminatedByteString "standard.array 0.1"

# Canonical standard-library implementation body.
# ============================================================
# SEMANTICSCRIPT STANDARD LIBRARY: byte-buffer array helpers
# ============================================================
#
# rationale: scans and in-place mutations over byte buffers.
#   The refined surface treats predicates as Bool (does the
#   buffer contain a byte? returns Bool, not 0/1) and lifts the
#   total scans (sum / min / max / count / reverse) out of the
#   Result wrapper. Byte normalization through (raw + 256) % 256
#   stays â€” pointer.loadByte sign-extends so this is needed for
#   "unsigned byte" semantics.
#
# invariant: every operation reads at most `byteCount` bytes
#   from byteBuffer. The caller is responsible for ensuring
#   that range is in-bounds â€” there is no capacity argument or
#   bounds enforcement here.
#
# security: all operations are read-only except
#   reverseBytesInBufferInPlace, which both reads and writes.
#   Out-of-bounds bytes are undefined behavior; the caller's
#   byteCount must match the actual allocation.
#
# timing: every operation is O(byteCount). No allocation.
#
# observability: no logs; consumers wrap when needed.

# Pure-module file: smoke + extended tests live in
# std/array/main.test.sem.

domainLiteral integerOneStepValue CSignedInt64 1
domainLiteralTrust integerOneStepValue trustedStaticLiteral
domainLiteral byteRoleAdjustmentValue CSignedInt64 256
domainLiteralTrust byteRoleAdjustmentValue trustedStaticLiteral
domainLiteral emptyBufferMinimumSentinel CSignedInt64 256
domainLiteralTrust emptyBufferMinimumSentinel trustedStaticLiteral
domainLiteral emptyBufferMaximumSentinel CSignedInt64 -1
domainLiteralTrust emptyBufferMaximumSentinel trustedStaticLiteral

# section array.aggregateScans

operation sumSignedByteValuesInBuffer
input operation sumSignedByteValuesInBuffer byteBuffer CNullTerminatedByteString
input operation sumSignedByteValuesInBuffer byteCount CByteCount
output operation sumSignedByteValuesInBuffer CSignedInt64
memory sumSignedByteValuesInBuffer heap no
async sumSignedByteValuesInBuffer no
purpose operation sumSignedByteValuesInBuffer "Returns the sum of byte values in the first byteCount bytes of byteBuffer (each byte treated as an unsigned 0..255 value)."
invariant operation sumSignedByteValuesInBuffer "Result is non-negative when byteCount fits within the buffer's allocation."
warning sumSignedByteValuesInBuffer "Overflows silently when byteCount * 255 exceeds CSignedInt64 (~3.6Ã—10^16 bytes)."
guarantee sumSignedByteValuesInBuffer "Total."
label startSumSignedByteValuesInBuffer
memory sumSignedByteValuesInBuffer mutable bufferRunningSum I64 0
memory sumSignedByteValuesInBuffer mutable bufferReadCursor I64 0
label sumLoop
call detectSumDoneCall math.greaterThanOrEqualI64
argument detectSumDoneCall left I64 bufferReadCursor
argument detectSumDoneCall right I64 byteCount
run detectSumDoneCall
bind value sumLoopDone Bool detectSumDoneCall
branch if condition sumLoopDone target sumDone
call loadByteForSumCall pointer.loadByte
argument loadByteForSumCall buffer COpaqueMemoryAddress byteBuffer
argument loadByteForSumCall offset CByteCount bufferReadCursor
run loadByteForSumCall
bind value rawSignExtendedByte I8 loadByteForSumCall
call shiftByteForUnsignedSumCall math.addI64
argument shiftByteForUnsignedSumCall left I64 rawSignExtendedByte
argument shiftByteForUnsignedSumCall right I64 byteRoleAdjustmentValue
run shiftByteForUnsignedSumCall
bind value shiftedByteForSum I64 shiftByteForUnsignedSumCall
call moduloByteForUnsignedSumCall math.moduloI64
argument moduloByteForUnsignedSumCall left I64 shiftedByteForSum
argument moduloByteForUnsignedSumCall right I64 byteRoleAdjustmentValue
run moduloByteForUnsignedSumCall
bind value unsignedByteValue I64 moduloByteForUnsignedSumCall
call addByteToRunningSumCall math.addI64
argument addByteToRunningSumCall left I64 bufferRunningSum
argument addByteToRunningSumCall right I64 unsignedByteValue
run addByteToRunningSumCall
bind value updatedRunningSum I64 addByteToRunningSumCall
set memory bufferRunningSum updatedRunningSum
call advanceSumCursorCall math.addI64
argument advanceSumCursorCall left I64 bufferReadCursor
argument advanceSumCursorCall right I64 integerOneStepValue
run advanceSumCursorCall
bind value nextSumCursorPosition I64 advanceSumCursorCall
set memory bufferReadCursor nextSumCursorPosition
jump target sumLoop
label sumDone
return value bufferRunningSum

