# ============================================================
# SEMANTICSCRIPT STANDARD LIBRARY TESTS: array
# ============================================================

project StdArrayTest
target console
runtime AgentRuntime 0.1
entry console main

import array standard.array

error MainError
errorCase MainError ArraySmokeAssertionFailed
errorCase MainError ConsoleWriteFailed

capability stdoutWriteCapability console.stdout write

operation main
input operation main console Console
output operation main Result ExitCode MainError
useCapability main stdoutWriteCapability
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Smoke-test the structural array.* helper surface."

label startMain

storage module immutable arrayLengthFive Int64 5
storage module immutable arrayLengthZero Int64 0
storage module immutable indexFour Int64 4
storage module immutable indexFive Int64 5
storage module immutable expectedLastIndex Int64 4
storage module immutable expectedMissingIndex Int64 -1

call arrayLengthCall array.length
argument arrayLengthCall arrayLength Int64 arrayLengthFive
run arrayLengthCall
bind value arrayLengthResult Int64 arrayLengthCall
call arrayLengthOkCall math.equalInt64
argument arrayLengthOkCall left Int64 arrayLengthResult
argument arrayLengthOkCall right Int64 arrayLengthFive
run arrayLengthOkCall
bind value arrayLengthOk Bool arrayLengthOkCall
branch if condition arrayLengthOk target arrayLengthHolds
branch else target smokeAssertionFailed
label arrayLengthHolds

call arrayIsEmptyCall array.isEmpty
argument arrayIsEmptyCall arrayLength Int64 arrayLengthZero
run arrayIsEmptyCall
bind value arrayIsEmptyResult Bool arrayIsEmptyCall
branch if condition arrayIsEmptyResult target arrayEmptyHolds
branch else target smokeAssertionFailed
label arrayEmptyHolds

call arrayContainsTrueCall array.containsIndex
argument arrayContainsTrueCall arrayLength Int64 arrayLengthFive
argument arrayContainsTrueCall index Int64 indexFour
run arrayContainsTrueCall
bind value arrayContainsTrueResult Bool arrayContainsTrueCall
branch if condition arrayContainsTrueResult target arrayContainsTrueHolds
branch else target smokeAssertionFailed
label arrayContainsTrueHolds

call arrayContainsFalseCall array.containsIndex
argument arrayContainsFalseCall arrayLength Int64 arrayLengthFive
argument arrayContainsFalseCall index Int64 indexFive
run arrayContainsFalseCall
bind value arrayContainsFalseResult Bool arrayContainsFalseCall
branch if condition arrayContainsFalseResult target smokeAssertionFailed

call arrayFirstIndexCall array.firstIndex
argument arrayFirstIndexCall arrayLength Int64 arrayLengthZero
run arrayFirstIndexCall
bind value arrayFirstIndexResult Int64 arrayFirstIndexCall
call arrayFirstIndexOkCall math.equalInt64
argument arrayFirstIndexOkCall left Int64 arrayFirstIndexResult
argument arrayFirstIndexOkCall right Int64 expectedMissingIndex
run arrayFirstIndexOkCall
bind value arrayFirstIndexOk Bool arrayFirstIndexOkCall
branch if condition arrayFirstIndexOk target arrayFirstIndexHolds
branch else target smokeAssertionFailed
label arrayFirstIndexHolds

call arrayLastIndexCall array.lastIndex
argument arrayLastIndexCall arrayLength Int64 arrayLengthFive
run arrayLastIndexCall
bind value arrayLastIndexResult Int64 arrayLastIndexCall
call arrayLastIndexOkCall math.equalInt64
argument arrayLastIndexOkCall left Int64 arrayLastIndexResult
argument arrayLastIndexOkCall right Int64 expectedLastIndex
run arrayLastIndexOkCall
bind value arrayLastIndexOk Bool arrayLastIndexOkCall
branch if condition arrayLastIndexOk target arrayLastIndexHolds
branch else target smokeAssertionFailed
label arrayLastIndexHolds

storage module immutable successMessageText String "OK"
call writeSuccessLineCall console.writeLine
argument writeSuccessLineCall text String successMessageText
run writeSuccessLineCall
ignore void source writeSuccessLineCall
bind error consoleWriteError Int32 writeSuccessLineCall
branch error source writeSuccessLineCall target consoleWriteFailedHandler
storage module immutable exitOkCode ExitCode 0
return ok exitOkCode

label consoleWriteFailedHandler
makeError consoleWriteFailedFailure MainError.ConsoleWriteFailed consoleWriteError
return error consoleWriteFailedFailure

label smokeAssertionFailed
makeError arraySmokeFailure MainError.ArraySmokeAssertionFailed
return error arraySmokeFailure
