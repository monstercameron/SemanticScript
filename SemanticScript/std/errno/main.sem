# SemanticScript standard-library canonical module: standard.errno.

module standard.errno
purpose module standard.errno "Canonical standard-library module for errno constants and helpers."
moduleOwns standard.errno "The official import path `standard.errno` and this module's implementation body."
moduleDoesNotOwn standard.errno "App-specific wrappers, compatibility aliases, or generated build artifacts."
invariant module standard.errno "The standard module entry is this file; tests live beside it as `main.test.sem`."

exportConstant standard.errno errnoModuleVersionText
storage module immutable errnoModuleVersionText CNullTerminatedByteString "standard.errno 0.1"

# Canonical standard-library implementation body.
# ============================================================
# SEMANTICSCRIPT STANDARD LIBRARY: POSIX errno numbers + message lookup
# ============================================================
#
# rationale: C's <errno.h> exposes EPERM/ENOENT/etc. as
#   preprocessor `#define`s. The refined surface replaces every
#   zero-arg accessor with a module-scope `domainLiteral` and keeps
#   the `lookupErrnoMessageCString` chain (a real string-mapping
#   operation with branching logic) as an `operation`.
#
# invariant: every errno value matches the canonical POSIX number.
#   Messages are short English text, ASCII-only, NUL-terminated.
#
# security: pure value-level mapping; no I/O; no allocation.
#
# timing: accessors are O(0). The message lookup is O(K) where K
#   is the number of known codes (currently 13); a code that is
#   not in the table maps to the "unknown error" sentinel.
#
# observability: no logs; callers wrap when needed.

# This is a pure-module (library) file: it exports operations and
# domainLiterals consumed by other programs (notably
# std/errno/main.test.sem which importModules it and runs the
# smoke). The project / target / runtime / entry block is retained
# so the module can still be linted standalone â€” the entry just
# points at the first exported operation rather than a `main` smoke.

# section errno.numbers
# rationale: POSIX errno constants.

domainLiteral permissionDeniedErrorNumber CSignedInt32 1
domainLiteralSource permissionDeniedErrorNumber posix.EPERM
domainLiteralTrust permissionDeniedErrorNumber trustedStaticLiteral

domainLiteral fileNotFoundErrorNumber CSignedInt32 2
domainLiteralSource fileNotFoundErrorNumber posix.ENOENT
domainLiteralTrust fileNotFoundErrorNumber trustedStaticLiteral

domainLiteral processNotFoundErrorNumber CSignedInt32 3
domainLiteralSource processNotFoundErrorNumber posix.ESRCH
domainLiteralTrust processNotFoundErrorNumber trustedStaticLiteral

domainLiteral interruptedSystemCallErrorNumber CSignedInt32 4
domainLiteralSource interruptedSystemCallErrorNumber posix.EINTR
domainLiteralTrust interruptedSystemCallErrorNumber trustedStaticLiteral

domainLiteral inputOutputErrorNumber CSignedInt32 5
domainLiteralSource inputOutputErrorNumber posix.EIO
domainLiteralTrust inputOutputErrorNumber trustedStaticLiteral

domainLiteral outOfMemoryErrorNumber CSignedInt32 12
domainLiteralSource outOfMemoryErrorNumber posix.ENOMEM
domainLiteralTrust outOfMemoryErrorNumber trustedStaticLiteral

domainLiteral accessDeniedErrorNumber CSignedInt32 13
domainLiteralSource accessDeniedErrorNumber posix.EACCES
domainLiteralTrust accessDeniedErrorNumber trustedStaticLiteral

domainLiteral badAddressErrorNumber CSignedInt32 14
domainLiteralSource badAddressErrorNumber posix.EFAULT
domainLiteralTrust badAddressErrorNumber trustedStaticLiteral

domainLiteral fileAlreadyExistsErrorNumber CSignedInt32 17
domainLiteralSource fileAlreadyExistsErrorNumber posix.EEXIST
domainLiteralTrust fileAlreadyExistsErrorNumber trustedStaticLiteral

domainLiteral invalidArgumentErrorNumber CSignedInt32 22
domainLiteralSource invalidArgumentErrorNumber posix.EINVAL
domainLiteralTrust invalidArgumentErrorNumber trustedStaticLiteral

domainLiteral noSpaceLeftOnDeviceErrorNumber CSignedInt32 28
domainLiteralSource noSpaceLeftOnDeviceErrorNumber posix.ENOSPC
domainLiteralTrust noSpaceLeftOnDeviceErrorNumber trustedStaticLiteral

domainLiteral brokenPipeErrorNumber CSignedInt32 32
domainLiteralSource brokenPipeErrorNumber posix.EPIPE
domainLiteralTrust brokenPipeErrorNumber trustedStaticLiteral

domainLiteral resultOutOfRangeErrorNumber CSignedInt32 34
domainLiteralSource resultOutOfRangeErrorNumber posix.ERANGE
domainLiteralTrust resultOutOfRangeErrorNumber trustedStaticLiteral

# section errno.messageLookup

operation lookupErrnoMessageCString
input operation lookupErrnoMessageCString errorNumber CSignedInt32
output operation lookupErrnoMessageCString CNullTerminatedByteString
memory lookupErrnoMessageCString heap no
async lookupErrnoMessageCString no
purpose operation lookupErrnoMessageCString "Map a POSIX errno number to a short English text description; returns 'unknown error' for codes outside the known set."
invariant operation lookupErrnoMessageCString "Output is always non-empty NUL-terminated ASCII."
guarantee lookupErrnoMessageCString "Total â€” every input produces some message."
# rationale: pure-SemanticScript comparison chain â€” no libc strerror dependency
#   (strerror is not thread-safe in all libcs and would pull in extra
#   FFI metadata for one short helper).
label startLookupErrnoMessageCString
storage module immutable messageForPermissionDenied CNullTerminatedByteString "operation not permitted"
storage module immutable messageForFileNotFound CNullTerminatedByteString "no such file or directory"
storage module immutable messageForProcessNotFound CNullTerminatedByteString "no such process"
storage module immutable messageForInterruptedSystemCall CNullTerminatedByteString "interrupted system call"
storage module immutable messageForInputOutputError CNullTerminatedByteString "input/output error"
storage module immutable messageForOutOfMemory CNullTerminatedByteString "out of memory"
storage module immutable messageForAccessDenied CNullTerminatedByteString "permission denied"
storage module immutable messageForBadAddress CNullTerminatedByteString "bad address"
storage module immutable messageForFileAlreadyExists CNullTerminatedByteString "file exists"
storage module immutable messageForInvalidArgument CNullTerminatedByteString "invalid argument"
storage module immutable messageForNoSpaceLeftOnDevice CNullTerminatedByteString "no space left on device"
storage module immutable messageForBrokenPipe CNullTerminatedByteString "broken pipe"
storage module immutable messageForResultOutOfRange CNullTerminatedByteString "result out of range"
storage module immutable messageForUnknownErrorCode CNullTerminatedByteString "unknown error"

call detectIsPermissionDeniedCall math.equalI64
argument detectIsPermissionDeniedCall left I64 errorNumber
argument detectIsPermissionDeniedCall right I64 permissionDeniedErrorNumber
run detectIsPermissionDeniedCall
bind value isPermissionDenied Bool detectIsPermissionDeniedCall
branch if condition isPermissionDenied target returnPermissionDeniedMessage
call detectIsFileNotFoundCall math.equalI64
argument detectIsFileNotFoundCall left I64 errorNumber
argument detectIsFileNotFoundCall right I64 fileNotFoundErrorNumber
run detectIsFileNotFoundCall
bind value isFileNotFound Bool detectIsFileNotFoundCall
branch if condition isFileNotFound target returnFileNotFoundMessage
call detectIsProcessNotFoundCall math.equalI64
argument detectIsProcessNotFoundCall left I64 errorNumber
argument detectIsProcessNotFoundCall right I64 processNotFoundErrorNumber
run detectIsProcessNotFoundCall
bind value isProcessNotFound Bool detectIsProcessNotFoundCall
branch if condition isProcessNotFound target returnProcessNotFoundMessage
call detectIsInterruptedSystemCallCall math.equalI64
argument detectIsInterruptedSystemCallCall left I64 errorNumber
argument detectIsInterruptedSystemCallCall right I64 interruptedSystemCallErrorNumber
run detectIsInterruptedSystemCallCall
bind value isInterruptedSystemCall Bool detectIsInterruptedSystemCallCall
branch if condition isInterruptedSystemCall target returnInterruptedSystemCallMessage
call detectIsInputOutputErrorCall math.equalI64
argument detectIsInputOutputErrorCall left I64 errorNumber
argument detectIsInputOutputErrorCall right I64 inputOutputErrorNumber
run detectIsInputOutputErrorCall
bind value isInputOutputError Bool detectIsInputOutputErrorCall
branch if condition isInputOutputError target returnInputOutputErrorMessage
call detectIsOutOfMemoryCall math.equalI64
argument detectIsOutOfMemoryCall left I64 errorNumber
argument detectIsOutOfMemoryCall right I64 outOfMemoryErrorNumber
run detectIsOutOfMemoryCall
bind value isOutOfMemory Bool detectIsOutOfMemoryCall
branch if condition isOutOfMemory target returnOutOfMemoryMessage
call detectIsAccessDeniedCall math.equalI64
argument detectIsAccessDeniedCall left I64 errorNumber
argument detectIsAccessDeniedCall right I64 accessDeniedErrorNumber
run detectIsAccessDeniedCall
bind value isAccessDenied Bool detectIsAccessDeniedCall
branch if condition isAccessDenied target returnAccessDeniedMessage
call detectIsBadAddressCall math.equalI64
argument detectIsBadAddressCall left I64 errorNumber
argument detectIsBadAddressCall right I64 badAddressErrorNumber
run detectIsBadAddressCall
bind value isBadAddress Bool detectIsBadAddressCall
branch if condition isBadAddress target returnBadAddressMessage
call detectIsFileAlreadyExistsCall math.equalI64
argument detectIsFileAlreadyExistsCall left I64 errorNumber
argument detectIsFileAlreadyExistsCall right I64 fileAlreadyExistsErrorNumber
run detectIsFileAlreadyExistsCall
bind value isFileAlreadyExists Bool detectIsFileAlreadyExistsCall
branch if condition isFileAlreadyExists target returnFileAlreadyExistsMessage
call detectIsInvalidArgumentCall math.equalI64
argument detectIsInvalidArgumentCall left I64 errorNumber
argument detectIsInvalidArgumentCall right I64 invalidArgumentErrorNumber
run detectIsInvalidArgumentCall
bind value isInvalidArgument Bool detectIsInvalidArgumentCall
branch if condition isInvalidArgument target returnInvalidArgumentMessage
call detectIsNoSpaceLeftOnDeviceCall math.equalI64
argument detectIsNoSpaceLeftOnDeviceCall left I64 errorNumber
argument detectIsNoSpaceLeftOnDeviceCall right I64 noSpaceLeftOnDeviceErrorNumber
run detectIsNoSpaceLeftOnDeviceCall
bind value isNoSpaceLeftOnDevice Bool detectIsNoSpaceLeftOnDeviceCall
branch if condition isNoSpaceLeftOnDevice target returnNoSpaceLeftOnDeviceMessage
call detectIsBrokenPipeCall math.equalI64
argument detectIsBrokenPipeCall left I64 errorNumber
argument detectIsBrokenPipeCall right I64 brokenPipeErrorNumber
run detectIsBrokenPipeCall
bind value isBrokenPipe Bool detectIsBrokenPipeCall
branch if condition isBrokenPipe target returnBrokenPipeMessage
call detectIsResultOutOfRangeCall math.equalI64
argument detectIsResultOutOfRangeCall left I64 errorNumber
argument detectIsResultOutOfRangeCall right I64 resultOutOfRangeErrorNumber
run detectIsResultOutOfRangeCall
bind value isResultOutOfRange Bool detectIsResultOutOfRangeCall
branch if condition isResultOutOfRange target returnResultOutOfRangeMessage
return value messageForUnknownErrorCode
label returnPermissionDeniedMessage
return value messageForPermissionDenied
label returnFileNotFoundMessage
return value messageForFileNotFound
label returnProcessNotFoundMessage
return value messageForProcessNotFound
label returnInterruptedSystemCallMessage
return value messageForInterruptedSystemCall
label returnInputOutputErrorMessage
return value messageForInputOutputError
label returnOutOfMemoryMessage
return value messageForOutOfMemory
label returnAccessDeniedMessage
return value messageForAccessDenied
label returnBadAddressMessage
return value messageForBadAddress
label returnFileAlreadyExistsMessage
return value messageForFileAlreadyExists
label returnInvalidArgumentMessage
return value messageForInvalidArgument
label returnNoSpaceLeftOnDeviceMessage
return value messageForNoSpaceLeftOnDevice
label returnBrokenPipeMessage
return value messageForBrokenPipe
label returnResultOutOfRangeMessage
