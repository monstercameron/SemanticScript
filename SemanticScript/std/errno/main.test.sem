# ============================================================
# SEMANTICSCRIPT STANDARD LIBRARY TESTS: POSIX errno numbers + lookup
# ============================================================
#
# rationale: companion test file for std/errno/main.sem. Imports
#   the errno module and exercises the canonical ENOENT constant
#   plus the lookupErrnoMessageCString message-table operation.
#
# invariant: success prints "OK\n" and exits 0; any failed
#   assertion surfaces MainError.ErrnoSmokeAssertionFailed.
#
# # pattern: this is the canonical main.test.sem form â€” same
#   directory as main.sem, import foo standard.foo, project block local
#   to the test, entry console main. The implementation file
#   std/errno/main.sem carries no smoke main itself.

project StdErrnoTest
target console
runtime AgentRuntime 0.1
entry console main

import errno standard.errno
error MainError
errorCase MainError ErrnoSmokeAssertionFailed
errorCase MainError ConsoleWriteFailed

# section capability
# rationale: smoke-test main writes a single OK line to stdout.
capability stdoutWriteCapability console.stdout write

# ============================================================
# Smoke test
# ============================================================

operation main
input operation main console Console
output operation main Result ExitCode MainError
useCapability main stdoutWriteCapability
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Verify errno constants and message lookup."
invariant operation main "ENOENT == 2; lookupErrnoMessageCString(2) is a non-empty string."

label startMain

storage module immutable twoExpected Int32 2
call checkEnoentCall math.equalInt64
argument checkEnoentCall left Int64 fileNotFoundErrorNumber
argument checkEnoentCall right Int64 twoExpected
run checkEnoentCall
bind value enoentOk Bool checkEnoentCall
branch if condition enoentOk target enoentHolds
branch else target smokeAssertionFailed
label enoentHolds

# Lookup returns a non-empty string for ENOENT.
call lookupEnoentCall lookupErrnoMessageCString
argument lookupEnoentCall errorNumber Int32 fileNotFoundErrorNumber
run lookupEnoentCall
bind value enoentMessage String lookupEnoentCall
storage module immutable zeroOffset ByteCount 0
call peekFirstByteCall pointer.loadByte
argument peekFirstByteCall buffer OpaquePointer enoentMessage
argument peekFirstByteCall offset ByteCount zeroOffset
run peekFirstByteCall
bind value firstMessageByte Int8 peekFirstByteCall
storage module immutable nullByteForComparison Int64 0
call detectMessageNonEmptyCall math.notEqualInt64
argument detectMessageNonEmptyCall left Int64 firstMessageByte
argument detectMessageNonEmptyCall right Int64 nullByteForComparison
run detectMessageNonEmptyCall
bind value messageNonEmpty Bool detectMessageNonEmptyCall
branch if condition messageNonEmpty target messageNonEmptyHolds
branch else target smokeAssertionFailed
label messageNonEmptyHolds

storage module immutable successMessageText String "OK"
call writeSuccessLineCall console.writeLine
argument writeSuccessLineCall console Console console
argument writeSuccessLineCall text String successMessageText
run writeSuccessLineCall
ignore ok source writeSuccessLineCall type Int32
bind error consoleWriteResultError Int32 writeSuccessLineCall
branch error source writeSuccessLineCall target consoleWriteFailedHandler
storage module immutable exitOkCode ExitCode 0
return ok exitOkCode

# Failure leg: surface the raw negative Int32 from
# console.writeLine as the cause attached to the typed
# MainError.ConsoleWriteFailed variant.
label consoleWriteFailedHandler
makeError consoleWriteFailedFailure MainError.ConsoleWriteFailed consoleWriteResultError
return error consoleWriteFailedFailure
label smokeAssertionFailed
makeError errnoSmokeFailure MainError.ErrnoSmokeAssertionFailed
return error errnoSmokeFailure
