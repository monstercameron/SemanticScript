# SemanticScript standard-library canonical module: standard.math.

# rationale: Canonical standard-library module for integer math helpers.
# invariant: The standard module entry is this file; tests live beside it as `main.test.sem`.
module standard.math
purpose module standard.math "Canonical standard-library module for integer math helpers."
moduleOwns standard.math "The official import path `standard.math` and this module's implementation body."
moduleDoesNotOwn standard.math "App-specific wrappers, compatibility aliases, or generated build artifacts."
invariant module standard.math "The standard module entry is this file; tests live beside it as `main.test.sem`."

exportConstant standard.math mathModuleVersionText
storage module immutable mathModuleVersionText String "standard.math 0.1"

# Canonical standard-library implementation body.
# ============================================================
# SEMANTICSCRIPT STANDARD LIBRARY: integer math helpers
# ============================================================
#
# rationale: pure-SemanticScript integer math - sqrt, factorial, primality,
#   power-of-two tests, bit counts. Every operation lowers to math.*
#   primitives plus branching; no libc math.h dependency.
#
# invariant: every operation is total over its declared Int64
#   domain. Predicates (isSignedInt64Prime / IsPowerOfTwo / IsEven /
#   IsOdd / IsWithinInclusiveRange) return Bool directly - no more
#   round-trips through "0 or 1 in a Int32".
#
# security: pure value-level computation. No I/O. No allocation.
#
# timing: integerSquareRoot is O(log n) (Newton iterations);
#   factorial is O(n); isSignedInt64Prime is O(sqrt(n)); bit counts
#   are O(64) - acceptable for tooling, not for hot loops.
#
# observability: no logs; consumers wrap when needed.

# Pure-module file: smoke + extended tests live in
# std/math/main.test.sem.

# rationale: Returns floor(sqrt(inputValue)) for inputValue >= 0 via Newton iteration; returns 0 for inputValue <= 0.
# invariant: For n >= 0, result*result <= n < (result+1)*(result+1).
operation integerSquareRootSignedInt64
input operation integerSquareRootSignedInt64 inputValue Int64
output operation integerSquareRootSignedInt64 Int64
memory integerSquareRootSignedInt64 heap no
memory integerSquareRootSignedInt64 stack max 1024
async integerSquareRootSignedInt64 no
purpose operation integerSquareRootSignedInt64 "Returns floor(sqrt(inputValue)) for inputValue >= 0 via Newton iteration; returns 0 for inputValue <= 0."
invariant operation integerSquareRootSignedInt64 "For n >= 0, result*result <= n < (result+1)*(result+1)."
guarantee integerSquareRootSignedInt64 "Total."

label startIntegerSquareRootSignedInt64
storage module immutable zeroInt64 Int64 0
storage module immutable twoInt64 Int64 2

# n <= 0 -> 0
call leZeroCall math.lessThanOrEqualInt64
argument leZeroCall left Int64 inputValue
argument leZeroCall right Int64 zeroInt64
run leZeroCall
bind value leZero Bool leZeroCall
branch if condition leZero target intSqrtZero

# Initial guess: n itself.
memory integerSquareRootSignedInt64 mutable guess Int64 0
set memory guess inputValue

label sqrtLoop
# next = (guess + n/guess) / 2
call divCall math.divideInt64
argument divCall left Int64 inputValue
argument divCall right Int64 guess
run divCall
bind value quot Int64 divCall

call sumCall math.addInt64
argument sumCall left Int64 guess
argument sumCall right Int64 quot
run sumCall
bind value sumGuess Int64 sumCall

call halveCall math.divideInt64
argument halveCall left Int64 sumGuess
argument halveCall right Int64 twoInt64
run halveCall
bind value nextGuess Int64 halveCall

# Stop when next >= guess (no further improvement).
call notImprovingCall math.greaterThanOrEqualInt64
argument notImprovingCall left Int64 nextGuess
argument notImprovingCall right Int64 guess
run notImprovingCall
bind value notImproving Bool notImprovingCall
branch if condition notImproving target intSqrtDone

set memory guess nextGuess
jump target sqrtLoop

label intSqrtDone
return value guess

label intSqrtZero
return value zeroInt64

# rationale: Returns inputValue! by repeated multiplication. Defined for inputValue in [0, 20]; n > 20 overflows Int64 silently.
# invariant: factorialSignedInt64(0) == 1 (convention).
# warning: Wraps silently above 20! - no overflow error surfaced.
operation factorialSignedInt64
input operation factorialSignedInt64 inputValue Int64
output operation factorialSignedInt64 Int64
memory factorialSignedInt64 heap no
memory factorialSignedInt64 stack max 1024
async factorialSignedInt64 no
purpose operation factorialSignedInt64 "Returns inputValue! by repeated multiplication. Defined for inputValue in [0, 20]; n > 20 overflows Int64 silently."
invariant operation factorialSignedInt64 "factorialSignedInt64(0) == 1 (convention)."
warning factorialSignedInt64 "Wraps silently above 20! - no overflow error surfaced."
guarantee factorialSignedInt64 "Total over the Int64 domain (with overflow wrap)."

label startFactorialSignedInt64
storage module immutable zeroFac Int64 0
storage module immutable oneFac Int64 1

call nLeZeroCall math.lessThanOrEqualInt64
argument nLeZeroCall left Int64 inputValue
argument nLeZeroCall right Int64 zeroFac
run nLeZeroCall
bind value nLeZero Bool nLeZeroCall
branch if condition nLeZero target factorialOne

memory factorialSignedInt64 mutable product Int64 1
memory factorialSignedInt64 mutable i Int64 1
label factorialLoop
call doneCall math.greaterThanInt64
argument doneCall left Int64 i
argument doneCall right Int64 inputValue
run doneCall
bind value done Bool doneCall
branch if condition done target factorialReturn
call mulCall math.multiplyInt64
argument mulCall left Int64 product
argument mulCall right Int64 i
run mulCall
bind value nextProd Int64 mulCall
set memory product nextProd
call incCall math.addInt64
argument incCall left Int64 i
argument incCall right Int64 oneFac
run incCall
bind value nextI Int64 incCall
set memory i nextI
jump target factorialLoop
label factorialReturn
return value product
label factorialOne
return value oneFac

# rationale: Returns true when inputValue is prime; n <= 1 returns false. Tests divisibility by 2 then odd numbers up to floor(sqrt(n)).
# invariant: Exact for inputValue in [2, INT64_MAX/2]; uses integerSquareRootSignedInt64 to bound the trial-division loop.
operation isSignedInt64Prime
input operation isSignedInt64Prime inputValue Int64
output operation isSignedInt64Prime Bool
memory isSignedInt64Prime heap no
memory isSignedInt64Prime stack max 1024
async isSignedInt64Prime no
purpose operation isSignedInt64Prime "Returns true when inputValue is prime; n <= 1 returns false. Tests divisibility by 2 then odd numbers up to floor(sqrt(n))."
invariant operation isSignedInt64Prime "Exact for inputValue in [2, INT64_MAX/2]; uses integerSquareRootSignedInt64 to bound the trial-division loop."
guarantee isSignedInt64Prime "Total."

label startIsSignedInt64Prime
storage module immutable zeroP Int64 0
storage module immutable oneP Int64 1
storage module immutable twoP Int64 2
storage module immutable truePr Bool true
storage module immutable falsePr Bool false

call leOneCall math.lessThanOrEqualInt64
argument leOneCall left Int64 inputValue
argument leOneCall right Int64 oneP
run leOneCall
bind value leOne Bool leOneCall
branch if condition leOne target isPrimeFalse

call eqTwoCall math.equalInt64
argument eqTwoCall left Int64 inputValue
argument eqTwoCall right Int64 twoP
run eqTwoCall
bind value eqTwo Bool eqTwoCall
branch if condition eqTwo target isPrimeTrue

# Even (other than 2) -> composite.
call modTwoCall math.moduloInt64
argument modTwoCall left Int64 inputValue
argument modTwoCall right Int64 twoP
run modTwoCall
bind value nMod2 Int64 modTwoCall
call isEvenCall math.equalInt64
argument isEvenCall left Int64 nMod2
argument isEvenCall right Int64 zeroP
run isEvenCall
bind value isSignedInt64Even Bool isEvenCall
branch if condition isSignedInt64Even target isPrimeFalse

# Trial divide by odd i from 3 up to floor(sqrt(n)).
call limitCall integerSquareRootSignedInt64
argument limitCall inputValue Int64 inputValue
run limitCall
bind value limit Int64 limitCall

memory isSignedInt64Prime mutable i Int64 3
label trialLoop
call beyondCall math.greaterThanInt64
argument beyondCall left Int64 i
argument beyondCall right Int64 limit
run beyondCall
bind value beyond Bool beyondCall
branch if condition beyond target isPrimeTrue
call primeRemainderCall math.moduloInt64
argument primeRemainderCall left Int64 inputValue
argument primeRemainderCall right Int64 i
run primeRemainderCall
bind value trialDivisionRemainder Int64 primeRemainderCall
call divCheckCall math.equalInt64
argument divCheckCall left Int64 trialDivisionRemainder
argument divCheckCall right Int64 zeroP
run divCheckCall
bind value divides Bool divCheckCall
branch if condition divides target isPrimeFalse
call iIncCall math.addInt64
argument iIncCall left Int64 i
argument iIncCall right Int64 twoP
run iIncCall
bind value nextI Int64 iIncCall
set memory i nextI
jump target trialLoop

label isPrimeFalse
return value falsePr
label isPrimeTrue
return value truePr

# rationale: Returns true when inputValue is a positive power of 2 (1, 2, 4, 8, ...), computed in O(1) as inputValue > 0 AND (inputValue AND (inputValue - 1)) == 0.
# invariant: A positive power of two has exactly one set bit, so clearing the lowest set bit via (n & (n-1)) yields 0. Zero / negative inputs return false.
operation isSignedInt64PowerOfTwo
input operation isSignedInt64PowerOfTwo inputValue Int64
output operation isSignedInt64PowerOfTwo Bool
memory isSignedInt64PowerOfTwo heap no
async isSignedInt64PowerOfTwo no
purpose operation isSignedInt64PowerOfTwo "Returns true when inputValue is a positive power of 2 (1, 2, 4, 8, ...), computed in O(1) as inputValue > 0 AND (inputValue AND (inputValue - 1)) == 0."
invariant operation isSignedInt64PowerOfTwo "A positive power of two has exactly one set bit, so clearing the lowest set bit via (n & (n-1)) yields 0. Zero / negative inputs return false."
guarantee isSignedInt64PowerOfTwo "Total. O(1) - one subtract, one and, two compares."

label startIsSignedInt64PowerOfTwo
storage module immutable zeroPt Int64 0
storage module immutable oneCount Int64 1
storage module immutable truePt Bool true
storage module immutable falsePt Bool false

call leZeroPtCall math.lessThanOrEqualInt64
argument leZeroPtCall left Int64 inputValue
argument leZeroPtCall right Int64 zeroPt
run leZeroPtCall
bind value leZeroPt Bool leZeroPtCall
branch if condition leZeroPt target isPowerOfTwoFalse

# Clear the lowest set bit: for a power of two (exactly one set bit) the
# result is 0; for anything else at least one other bit survives.
call decrementForMaskCall math.subtractInt64
argument decrementForMaskCall left Int64 inputValue
argument decrementForMaskCall right Int64 oneCount
run decrementForMaskCall
bind value inputMinusOne Int64 decrementForMaskCall
call clearLowestSetBitCall math.bitwiseAndInt64
argument clearLowestSetBitCall left Int64 inputValue
argument clearLowestSetBitCall right Int64 inputMinusOne
run clearLowestSetBitCall
bind value lowestSetBitCleared Int64 clearLowestSetBitCall
call detectNoRemainingBitsCall math.equalInt64
argument detectNoRemainingBitsCall left Int64 lowestSetBitCleared
argument detectNoRemainingBitsCall right Int64 zeroPt
run detectNoRemainingBitsCall
bind value noRemainingBits Bool detectNoRemainingBitsCall
branch if condition noRemainingBits target isPowerOfTwoTrue
branch else target isPowerOfTwoFalse

label isPowerOfTwoFalse
return value falsePt
label isPowerOfTwoTrue
return value truePt

# rationale: Returns the smallest power of 2 >= inputValue (1 for inputValue <= 1).
# invariant: Doubles a 1-seeded accumulator until it reaches or exceeds inputValue; inputs <= 1 short-circuit to 1.
operation nextPowerOfTwoForSignedInt64
input operation nextPowerOfTwoForSignedInt64 inputValue Int64
output operation nextPowerOfTwoForSignedInt64 Int64
memory nextPowerOfTwoForSignedInt64 heap no
async nextPowerOfTwoForSignedInt64 no
purpose operation nextPowerOfTwoForSignedInt64 "Returns the smallest power of 2 >= inputValue (1 for inputValue <= 1)."
invariant operation nextPowerOfTwoForSignedInt64 "Doubles a 1-seeded accumulator until it reaches or exceeds inputValue; inputs <= 1 short-circuit to 1."
guarantee nextPowerOfTwoForSignedInt64 "Total."

label startNextPowerOfTwoForSignedInt64
storage module immutable oneNp Int64 1
storage module immutable twoNp Int64 2

call leOneNpCall math.lessThanOrEqualInt64
argument leOneNpCall left Int64 inputValue
argument leOneNpCall right Int64 oneNp
run leOneNpCall
bind value leOneNp Bool leOneNpCall
branch if condition leOneNp target nextPowOne

memory nextPowerOfTwoForSignedInt64 mutable p Int64 1
label doubleLoop
call gePCall math.greaterThanOrEqualInt64
argument gePCall left Int64 p
argument gePCall right Int64 inputValue
run gePCall
bind value gep Bool gePCall
branch if condition gep target nextPowDone
call doubleCall math.multiplyInt64
argument doubleCall left Int64 p
argument doubleCall right Int64 twoNp
run doubleCall
bind value nextP Int64 doubleCall
set memory p nextP
jump target doubleLoop

label nextPowDone
return value p
label nextPowOne
return value oneNp

# rationale: Returns the count of decimal digits in |inputValue|. Returns 1 for inputValue == 0.
# invariant: Divides the absolute value by 10 until the quotient is zero, counting iterations. Negative inputs are absolute-valued via multiplication by -1 first.
operation countDecimalDigitsInSignedInt64
input operation countDecimalDigitsInSignedInt64 inputValue Int64
output operation countDecimalDigitsInSignedInt64 Int64
memory countDecimalDigitsInSignedInt64 heap no
async countDecimalDigitsInSignedInt64 no
purpose operation countDecimalDigitsInSignedInt64 "Returns the count of decimal digits in |inputValue|. Returns 1 for inputValue == 0."
invariant operation countDecimalDigitsInSignedInt64 "Divides the absolute value by 10 until the quotient is zero, counting iterations. Negative inputs are absolute-valued via multiplication by -1 first."
guarantee countDecimalDigitsInSignedInt64 "Total."

label startCountDecimalDigitsInSignedInt64
storage module immutable zeroCd Int64 0
storage module immutable oneCd Int64 1
storage module immutable tenCd Int64 10
storage module immutable negOneCd Int64 -1

call eqZeroCdCall math.equalInt64
argument eqZeroCdCall left Int64 inputValue
argument eqZeroCdCall right Int64 zeroCd
run eqZeroCdCall
bind value eqZeroCd Bool eqZeroCdCall
branch if condition eqZeroCd target countDigitsOne

memory countDecimalDigitsInSignedInt64 mutable v Int64 0
set memory v inputValue
call negCdCall math.lessThanInt64
argument negCdCall left Int64 v
argument negCdCall right Int64 zeroCd
run negCdCall
bind value isNegCd Bool negCdCall
branch if condition isNegCd target flipCd
branch else target countDigitsLoop

label flipCd
call flipCdCall math.multiplyInt64
argument flipCdCall left Int64 v
argument flipCdCall right Int64 negOneCd
run flipCdCall
bind value vFlipped Int64 flipCdCall
set memory v vFlipped
jump target countDigitsLoop

label countDigitsLoop
memory countDecimalDigitsInSignedInt64 mutable count Int64 0
label cdStep
call doneCdCall math.equalInt64
argument doneCdCall left Int64 v
argument doneCdCall right Int64 zeroCd
run doneCdCall
bind value doneCd Bool doneCdCall
branch if condition doneCd target countDigitsReturn
call cdDivCall math.divideInt64
argument cdDivCall left Int64 v
argument cdDivCall right Int64 tenCd
run cdDivCall
bind value vNext Int64 cdDivCall
set memory v vNext
call cdIncCall math.addInt64
argument cdIncCall left Int64 count
argument cdIncCall right Int64 oneCd
run cdIncCall
bind value nextCount Int64 cdIncCall
set memory count nextCount
jump target cdStep

label countDigitsReturn
return value count

label countDigitsOne
return value oneCd

# rationale: Returns true when inputValue % 2 == 0.
operation isSignedInt64Even
input operation isSignedInt64Even inputValue Int64
output operation isSignedInt64Even Bool
memory isSignedInt64Even heap no
async isSignedInt64Even no
purpose operation isSignedInt64Even "Returns true when inputValue % 2 == 0."
guarantee isSignedInt64Even "Total."
label startIsSignedInt64Even
storage module immutable zeroE Int64 0
storage module immutable twoE Int64 2
storage module immutable trueE Bool true
storage module immutable falseE Bool false
call modECall math.moduloInt64
argument modECall left Int64 inputValue
argument modECall right Int64 twoE
run modECall
bind value modE Int64 modECall
call eqZeroECall math.equalInt64
argument eqZeroECall left Int64 modE
argument eqZeroECall right Int64 zeroE
run eqZeroECall
bind value eqZeroE Bool eqZeroECall
branch if condition eqZeroE target isEvenTrue
return value falseE
label isEvenTrue
return value trueE

# rationale: Returns true when inputValue % 2 != 0.
operation isSignedInt64Odd
input operation isSignedInt64Odd inputValue Int64
output operation isSignedInt64Odd Bool
memory isSignedInt64Odd heap no
async isSignedInt64Odd no
purpose operation isSignedInt64Odd "Returns true when inputValue % 2 != 0."
guarantee isSignedInt64Odd "Total."
label startIsSignedInt64Odd
storage module immutable zeroO Int64 0
storage module immutable twoO Int64 2
storage module immutable trueO Bool true
storage module immutable falseO Bool false
call modOCall math.moduloInt64
argument modOCall left Int64 inputValue
argument modOCall right Int64 twoO
run modOCall
bind value modO Int64 modOCall
call neZeroOCall math.notEqualInt64
argument neZeroOCall left Int64 modO
argument neZeroOCall right Int64 zeroO
run neZeroOCall
bind value neZeroO Bool neZeroOCall
branch if condition neZeroO target isOddTrue
return value falseO
label isOddTrue
return value trueO

# rationale: Returns the population count of inputValue (number of 1-bits in its full 64-bit two's-complement representation). Correct for negative inputs: countSetBitsInSignedInt64(-1) == 64.
# invariant: For inputValue >= 0, inspects each bit via modulo-2 on a halving working value. For inputValue < 0, applies popcount(n) == 64 - popcount(-n - 1) so the sign-extension bits are counted (arithmetic divide-by-two toward zero would otherwise drop them).
operation countSetBitsInSignedInt64
input operation countSetBitsInSignedInt64 inputValue Int64
output operation countSetBitsInSignedInt64 Int64
memory countSetBitsInSignedInt64 heap no
async countSetBitsInSignedInt64 no
purpose operation countSetBitsInSignedInt64 "Returns the population count of inputValue (number of 1-bits in its full 64-bit two's-complement representation). Correct for negative inputs: countSetBitsInSignedInt64(-1) == 64."
invariant operation countSetBitsInSignedInt64 "For inputValue >= 0, inspects each bit via modulo-2 on a halving working value. For inputValue < 0, applies popcount(n) == 64 - popcount(-n - 1) so the sign-extension bits are counted (arithmetic divide-by-two toward zero would otherwise drop them)."
guarantee countSetBitsInSignedInt64 "Total - in [0, 64]."
label startCountSetBitsInSignedInt64
storage module immutable zeroPc Int64 0
storage module immutable onePc Int64 1
storage module immutable twoPc Int64 2
storage module immutable limitPc Int64 64
storage module immutable negOnePc Int64 -1
memory countSetBitsInSignedInt64 mutable pcVal Int64 0
set memory pcVal inputValue
memory countSetBitsInSignedInt64 mutable pcWasNegativeFlag Int64 0
memory countSetBitsInSignedInt64 mutable pcCount Int64 0
memory countSetBitsInSignedInt64 mutable pcIter Int64 0
# Negative inputs: arithmetic divide-by-two (toward zero) collapses a
# negative value's sign-extension bits, so the raw loop would undercount.
# Use popcount(n) == 64 - popcount(-n - 1) for n < 0: `-n - 1` is
# non-negative for every negative n (and wraps to INT64_MAX for INT64_MIN,
# which is still correct), so the unsigned loop below counts it exactly.
call pcDetectNegativeCall math.lessThanInt64
argument pcDetectNegativeCall left Int64 inputValue
argument pcDetectNegativeCall right Int64 zeroPc
run pcDetectNegativeCall
bind value pcInputIsNegative Bool pcDetectNegativeCall
branch if condition pcInputIsNegative target pcPrepareNegative
branch else target pcLoop
label pcPrepareNegative
set memory pcWasNegativeFlag onePc
call pcNegateInputCall math.multiplyInt64
argument pcNegateInputCall left Int64 inputValue
argument pcNegateInputCall right Int64 negOnePc
run pcNegateInputCall
bind value pcNegatedInput Int64 pcNegateInputCall
call pcComplementSourceCall math.subtractInt64
argument pcComplementSourceCall left Int64 pcNegatedInput
argument pcComplementSourceCall right Int64 onePc
run pcComplementSourceCall
bind value pcComplementSource Int64 pcComplementSourceCall
set memory pcVal pcComplementSource
jump target pcLoop
label pcLoop
call popcountDoneCall math.greaterThanOrEqualInt64
argument popcountDoneCall left Int64 pcIter
argument popcountDoneCall right Int64 limitPc
run popcountDoneCall
bind value popcountDoneCallB Bool popcountDoneCall
branch if condition popcountDoneCallB target pcReturn
call popcountModCall math.moduloInt64
argument popcountModCall left Int64 pcVal
argument popcountModCall right Int64 twoPc
run popcountModCall
bind value pcBit Int64 popcountModCall
call popcountBitNonzeroCall math.notEqualInt64
argument popcountBitNonzeroCall left Int64 pcBit
argument popcountBitNonzeroCall right Int64 zeroPc
run popcountBitNonzeroCall
bind value pcSet Bool popcountBitNonzeroCall
branch if condition pcSet target popcountIncrementBranch
branch else target pcAdvance
label popcountIncrementBranch
call popcountIncrementCall math.addInt64
argument popcountIncrementCall left Int64 pcCount
argument popcountIncrementCall right Int64 onePc
run popcountIncrementCall
bind value pcNext Int64 popcountIncrementCall
set memory pcCount pcNext
jump target pcAdvance
label pcAdvance
call popcountDivideCall math.divideInt64
argument popcountDivideCall left Int64 pcVal
argument popcountDivideCall right Int64 twoPc
run popcountDivideCall
bind value pcHalved Int64 popcountDivideCall
set memory pcVal pcHalved
call popcountIterIncrementCall math.addInt64
argument popcountIterIncrementCall left Int64 pcIter
argument popcountIterIncrementCall right Int64 onePc
run popcountIterIncrementCall
bind value pcIterNext Int64 popcountIterIncrementCall
set memory pcIter pcIterNext
jump target pcLoop
label pcReturn
call pcWasNegativeCheckCall math.equalInt64
argument pcWasNegativeCheckCall left Int64 pcWasNegativeFlag
argument pcWasNegativeCheckCall right Int64 onePc
run pcWasNegativeCheckCall
bind value pcWasNegativeResult Bool pcWasNegativeCheckCall
branch if condition pcWasNegativeResult target pcReturnComplement
return value pcCount
label pcReturnComplement
call pcFinalComplementCall math.subtractInt64
argument pcFinalComplementCall left Int64 limitPc
argument pcFinalComplementCall right Int64 pcCount
run pcFinalComplementCall
bind value pcComplementedCount Int64 pcFinalComplementCall
return value pcComplementedCount

# rationale: Returns the count of trailing zero bits in inputValue's 64-bit representation. Returns 64 for inputValue == 0 (matching GCC __builtin_ctzll).
# invariant: Halves the value while the low bit is zero, counting iterations. Zero input short-circuits to 64.
operation countTrailingZeroBitsInSignedInt64
input operation countTrailingZeroBitsInSignedInt64 inputValue Int64
output operation countTrailingZeroBitsInSignedInt64 Int64
memory countTrailingZeroBitsInSignedInt64 heap no
async countTrailingZeroBitsInSignedInt64 no
purpose operation countTrailingZeroBitsInSignedInt64 "Returns the count of trailing zero bits in inputValue's 64-bit representation. Returns 64 for inputValue == 0 (matching GCC __builtin_ctzll)."
invariant operation countTrailingZeroBitsInSignedInt64 "Halves the value while the low bit is zero, counting iterations. Zero input short-circuits to 64."
guarantee countTrailingZeroBitsInSignedInt64 "Total."
label startCountTrailingZeroBitsInSignedInt64
storage module immutable zeroTz Int64 0
storage module immutable oneTz Int64 1
storage module immutable twoTz Int64 2
storage module immutable sixtyFourTz Int64 64
# Special case n == 0
call ctzEqualZeroCall math.equalInt64
argument ctzEqualZeroCall left Int64 inputValue
argument ctzEqualZeroCall right Int64 zeroTz
run ctzEqualZeroCall
bind value nIsZero Bool ctzEqualZeroCall
branch if condition nIsZero target tzReturn64
memory countTrailingZeroBitsInSignedInt64 mutable tzVal Int64 0
set memory tzVal inputValue
memory countTrailingZeroBitsInSignedInt64 mutable tzCount Int64 0
label tzLoop
call tzModCall math.moduloInt64
argument tzModCall left Int64 tzVal
argument tzModCall right Int64 twoTz
run tzModCall
bind value tzMod Int64 tzModCall
call ctzBitSetCall math.notEqualInt64
argument ctzBitSetCall left Int64 tzMod
argument ctzBitSetCall right Int64 zeroTz
run ctzBitSetCall
bind value tzSet Bool ctzBitSetCall
branch if condition tzSet target tzReturn
call tzDivCall math.divideInt64
argument tzDivCall left Int64 tzVal
argument tzDivCall right Int64 twoTz
run tzDivCall
bind value tzNext Int64 tzDivCall
set memory tzVal tzNext
call tzIncCall math.addInt64
argument tzIncCall left Int64 tzCount
argument tzIncCall right Int64 oneTz
run tzIncCall
bind value tzCountNext Int64 tzIncCall
set memory tzCount tzCountNext
jump target tzLoop
label tzReturn
return value tzCount
label tzReturn64
return value sixtyFourTz

# rationale: Returns -1 when inputValue is negative, 1 when positive, 0 when zero.
operation signOfSignedInt64
input operation signOfSignedInt64 inputValue Int64
output operation signOfSignedInt64 Int64
memory signOfSignedInt64 heap no
async signOfSignedInt64 no
purpose operation signOfSignedInt64 "Returns -1 when inputValue is negative, 1 when positive, 0 when zero."
guarantee signOfSignedInt64 "Total - result is always exactly -1, 0, or 1."
label startSignOfSignedInt64
storage module immutable zeroSi Int64 0
storage module immutable oneSi Int64 1
storage module immutable negOneSi Int64 -1
call absDiffLessThanCall math.lessThanInt64
argument absDiffLessThanCall left Int64 inputValue
argument absDiffLessThanCall right Int64 zeroSi
run absDiffLessThanCall
bind value isNg Bool absDiffLessThanCall
branch if condition isNg target siNeg
call absDiffGreaterThanCall math.greaterThanInt64
argument absDiffGreaterThanCall left Int64 inputValue
argument absDiffGreaterThanCall right Int64 zeroSi
run absDiffGreaterThanCall
bind value isPs Bool absDiffGreaterThanCall
branch if condition isPs target siPos
return value zeroSi
label siNeg
return value negOneSi
label siPos
return value oneSi

# rationale: Returns |leftValue - rightValue|.
# invariant: Symmetric and non-negative.
operation absoluteDifferenceBetweenSignedInt64Values
input operation absoluteDifferenceBetweenSignedInt64Values leftValue Int64
input operation absoluteDifferenceBetweenSignedInt64Values rightValue Int64
output operation absoluteDifferenceBetweenSignedInt64Values Int64
memory absoluteDifferenceBetweenSignedInt64Values heap no
async absoluteDifferenceBetweenSignedInt64Values no
purpose operation absoluteDifferenceBetweenSignedInt64Values "Returns |leftValue - rightValue|."
invariant operation absoluteDifferenceBetweenSignedInt64Values "Symmetric and non-negative."
guarantee absoluteDifferenceBetweenSignedInt64Values "Total (modulo two's-complement INT64_MIN wraparound)."
label startAbsoluteDifferenceBetweenSignedInt64Values
storage module immutable zeroAdi Int64 0
storage module immutable negOneAdi Int64 -1
call diffCall math.subtractInt64
argument diffCall left Int64 leftValue
argument diffCall right Int64 rightValue
run diffCall
bind value diff Int64 diffCall
call absDiffLessThanZeroCall math.lessThanInt64
argument absDiffLessThanZeroCall left Int64 diff
argument absDiffLessThanZeroCall right Int64 zeroAdi
run absDiffLessThanZeroCall
bind value diffNeg Bool absDiffLessThanZeroCall
branch if condition diffNeg target flipDiff
return value diff
label flipDiff
call absDiffFlipSignCall math.multiplyInt64
argument absDiffFlipSignCall left Int64 diff
argument absDiffFlipSignCall right Int64 negOneAdi
