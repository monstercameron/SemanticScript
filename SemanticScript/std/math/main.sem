bind value isNg Bool absDiffLessThanCall
branch if condition isNg target siNeg
call absDiffGreaterThanCall math.greaterThanI64
argument absDiffGreaterThanCall left I64 inputValue
argument absDiffGreaterThanCall right I64 zeroSi
run absDiffGreaterThanCall
bind value isPs Bool absDiffGreaterThanCall
branch if condition isPs target siPos
return value zeroSi
label siNeg
return value negOneSi
label siPos
return value oneSi

