# SemanticScript standard-library canonical module: standard.math.

module standard.math
purpose module standard.math "Canonical standard-library module for integer math helpers."
moduleOwns standard.math "The official import path `standard.math` and this module's implementation body."
moduleDoesNotOwn standard.math "App-specific wrappers, compatibility aliases, or generated build artifacts."
invariant module standard.math "The standard module entry is this file; tests live beside it as `main.test.sem`."

exportConstant standard.math mathModuleVersionText
storage module immutable mathModuleVersionText CNullTerminatedByteString "standard.math 0.1"

# Canonical standard-library implementation body.
# ============================================================
# SEMANTICSCRIPT STANDARD LIBRARY: integer math helpers
# ============================================================
#
# rationale: pure-SemanticScript integer math â€” sqrt, factorial, primality,
#   power-of-two tests, bit counts. Every operation lowers to math.*
#   primitives plus branching; no libc math.h dependency.
#
# invariant: every operation is total over its declared CSignedInt64
#   domain. Predicates (isSignedInt64Prime / IsPowerOfTwo / IsEven /
#   IsOdd / IsWithinInclusiveRange) return Bool directly â€” no more
#   round-trips through "0 or 1 in a CSignedInt32".
#
# security: pure value-level computation. No I/O. No allocation.
#
# timing: integerSquareRoot is O(log n) (Newton iterations);
#   factorial is O(n); isSignedInt64Prime is O(sqrt(n)); bit counts
#   are O(64) â€” acceptable for tooling, not for hot loops.
#
# observability: no logs; consumers wrap when needed.

# Pure-module file: smoke + extended tests live in
# std/math/main.test.sem.

operation integerSquareRootSignedInt64
input operation integerSquareRootSignedInt64 inputValue CSignedInt64
output operation integerSquareRootSignedInt64 CSignedInt64
memory integerSquareRootSignedInt64 heap no
memory integerSquareRootSignedInt64 stack max 1024
async integerSquareRootSignedInt64 no
purpose operation integerSquareRootSignedInt64 "Returns floor(sqrt(inputValue)) for inputValue >= 0 via Newton iteration; returns 0 for inputValue <= 0."
invariant operation integerSquareRootSignedInt64 "For n >= 0, result*result <= n < (result+1)*(result+1)."
guarantee integerSquareRootSignedInt64 "Total."

label startIntegerSquareRootSignedInt64
storage module immutable zeroI64 I64 0
storage module immutable twoI64 I64 2

# n <= 0 -> 0
call leZeroCall math.lessThanOrEqualI64
argument leZeroCall left I64 inputValue
argument leZeroCall right I64 zeroI64
run leZeroCall
bind value leZero Bool leZeroCall
branch if condition leZero target intSqrtZero

# Initial guess: n itself.
memory integerSquareRootSignedInt64 mutable guess I64 0
set memory guess inputValue

label sqrtLoop
# next = (guess + n/guess) / 2
call divCall math.divideI64
argument divCall left I64 inputValue
argument divCall right I64 guess
run divCall
bind value quot I64 divCall

call sumCall math.addI64
argument sumCall left I64 guess
argument sumCall right I64 quot
run sumCall
bind value sumGuess I64 sumCall

call halveCall math.divideI64
argument halveCall left I64 sumGuess
argument halveCall right I64 twoI64
run halveCall
bind value nextGuess I64 halveCall

# Stop when next >= guess (no further improvement).
call notImprovingCall math.greaterThanOrEqualI64
argument notImprovingCall left I64 nextGuess
argument notImprovingCall right I64 guess
run notImprovingCall
bind value notImproving Bool notImprovingCall
branch if condition notImproving target intSqrtDone

set memory guess nextGuess
jump target sqrtLoop

label intSqrtDone
return value guess

label intSqrtZero
return value zeroI64

operation factorialSignedInt64
input operation factorialSignedInt64 inputValue CSignedInt64
output operation factorialSignedInt64 CSignedInt64
memory factorialSignedInt64 heap no
memory factorialSignedInt64 stack max 1024
async factorialSignedInt64 no
purpose operation factorialSignedInt64 "Returns inputValue! by repeated multiplication. Defined for inputValue in [0, 20]; n > 20 overflows CSignedInt64 silently."
invariant operation factorialSignedInt64 "factorialSignedInt64(0) == 1 (convention)."
warning factorialSignedInt64 "Wraps silently above 20! â€” no overflow error surfaced."
guarantee factorialSignedInt64 "Total over the CSignedInt64 domain (with overflow wrap)."

label startFactorialSignedInt64
storage module immutable zeroFac I64 0
storage module immutable oneFac I64 1

call nLeZeroCall math.lessThanOrEqualI64
argument nLeZeroCall left I64 inputValue
argument nLeZeroCall right I64 zeroFac
run nLeZeroCall
bind value nLeZero Bool nLeZeroCall
branch if condition nLeZero target factorialOne

memory factorialSignedInt64 mutable product I64 1
memory factorialSignedInt64 mutable i I64 1
label factorialLoop
call doneCall math.greaterThanI64
argument doneCall left I64 i
argument doneCall right I64 inputValue
run doneCall
bind value done Bool doneCall
branch if condition done target factorialReturn
call mulCall math.multiplyI64
argument mulCall left I64 product
argument mulCall right I64 i
run mulCall
bind value nextProd I64 mulCall
set memory product nextProd
call incCall math.addI64
argument incCall left I64 i
argument incCall right I64 oneFac
run incCall
bind value nextI I64 incCall
set memory i nextI
jump target factorialLoop
label factorialReturn
return value product
label factorialOne
return value oneFac

operation isSignedInt64Prime
input operation isSignedInt64Prime inputValue CSignedInt64
output operation isSignedInt64Prime Bool
memory isSignedInt64Prime heap no
memory isSignedInt64Prime stack max 1024
async isSignedInt64Prime no
purpose operation isSignedInt64Prime "Returns true when inputValue is prime; n <= 1 returns false. Tests divisibility by 2 then odd numbers up to floor(sqrt(n))."
invariant operation isSignedInt64Prime "Exact for inputValue in [2, INT64_MAX/2]; uses integerSquareRootSignedInt64 to bound the trial-division loop."
guarantee isSignedInt64Prime "Total."

label startIsSignedInt64Prime
storage module immutable zeroP I64 0
storage module immutable oneP I64 1
storage module immutable twoP I64 2
storage module immutable truePr Bool true
storage module immutable falsePr Bool false

call leOneCall math.lessThanOrEqualI64
argument leOneCall left I64 inputValue
argument leOneCall right I64 oneP
run leOneCall
bind value leOne Bool leOneCall
branch if condition leOne target isPrimeFalse

call eqTwoCall math.equalI64
argument eqTwoCall left I64 inputValue
argument eqTwoCall right I64 twoP
run eqTwoCall
bind value eqTwo Bool eqTwoCall
branch if condition eqTwo target isPrimeTrue

# Even (other than 2) -> composite.
call modTwoCall math.moduloI64
argument modTwoCall left I64 inputValue
argument modTwoCall right I64 twoP
run modTwoCall
bind value nMod2 I64 modTwoCall
call isEvenCall math.equalI64
argument isEvenCall left I64 nMod2
argument isEvenCall right I64 zeroP
run isEvenCall
bind value isSignedInt64Even Bool isEvenCall
branch if condition isSignedInt64Even target isPrimeFalse

# Trial divide by odd i from 3 up to floor(sqrt(n)).
call limitCall integerSquareRootSignedInt64
argument limitCall inputValue CSignedInt64 inputValue
run limitCall
bind value limit CSignedInt64 limitCall

memory isSignedInt64Prime mutable i I64 3
label trialLoop
call beyondCall math.greaterThanI64
argument beyondCall left I64 i
argument beyondCall right I64 limit
run beyondCall
bind value beyond Bool beyondCall
branch if condition beyond target isPrimeTrue
call primeRemainderCall math.moduloI64
argument primeRemainderCall left I64 inputValue
argument primeRemainderCall right I64 i
run primeRemainderCall
bind value trialDivisionRemainder I64 primeRemainderCall
call divCheckCall math.equalI64
argument divCheckCall left I64 trialDivisionRemainder
argument divCheckCall right I64 zeroP
run divCheckCall
bind value divides Bool divCheckCall
branch if condition divides target isPrimeFalse
call iIncCall math.addI64
argument iIncCall left I64 i
argument iIncCall right I64 twoP
run iIncCall
bind value nextI I64 iIncCall
set memory i nextI
jump target trialLoop

label isPrimeFalse
return value falsePr
label isPrimeTrue
return value truePr

operation isSignedInt64PowerOfTwo
input operation isSignedInt64PowerOfTwo inputValue CSignedInt64
output operation isSignedInt64PowerOfTwo Bool
memory isSignedInt64PowerOfTwo heap no
async isSignedInt64PowerOfTwo no
purpose operation isSignedInt64PowerOfTwo "Returns true when inputValue is a positive power of 2 (1, 2, 4, 8, ...), computed in O(1) as inputValue > 0 AND (inputValue AND (inputValue - 1)) == 0."
invariant operation isSignedInt64PowerOfTwo "A positive power of two has exactly one set bit, so clearing the lowest set bit via (n & (n-1)) yields 0. Zero / negative inputs return false."
guarantee isSignedInt64PowerOfTwo "Total. O(1) â€” one subtract, one and, two compares."

label startIsSignedInt64PowerOfTwo
storage module immutable zeroPt I64 0
storage module immutable oneCount I64 1
storage module immutable truePt Bool true
storage module immutable falsePt Bool false

call leZeroPtCall math.lessThanOrEqualI64
argument leZeroPtCall left I64 inputValue
argument leZeroPtCall right I64 zeroPt
run leZeroPtCall
bind value leZeroPt Bool leZeroPtCall
branch if condition leZeroPt target isPowerOfTwoFalse

# Clear the lowest set bit: for a power of two (exactly one set bit) the
# result is 0; for anything else at least one other bit survives.
call decrementForMaskCall math.subtractI64
argument decrementForMaskCall left I64 inputValue
argument decrementForMaskCall right I64 oneCount
run decrementForMaskCall
bind value inputMinusOne I64 decrementForMaskCall
call clearLowestSetBitCall math.bitwiseAndI64
argument clearLowestSetBitCall left I64 inputValue
argument clearLowestSetBitCall right I64 inputMinusOne
run clearLowestSetBitCall
bind value lowestSetBitCleared I64 clearLowestSetBitCall
call detectNoRemainingBitsCall math.equalI64
argument detectNoRemainingBitsCall left I64 lowestSetBitCleared
argument detectNoRemainingBitsCall right I64 zeroPt
run detectNoRemainingBitsCall
bind value noRemainingBits Bool detectNoRemainingBitsCall
branch if condition noRemainingBits target isPowerOfTwoTrue
branch else target isPowerOfTwoFalse

label isPowerOfTwoFalse
return value falsePt
label isPowerOfTwoTrue
return value truePt

operation nextPowerOfTwoForSignedInt64
input operation nextPowerOfTwoForSignedInt64 inputValue CSignedInt64
output operation nextPowerOfTwoForSignedInt64 CSignedInt64
memory nextPowerOfTwoForSignedInt64 heap no
async nextPowerOfTwoForSignedInt64 no
purpose operation nextPowerOfTwoForSignedInt64 "Returns the smallest power of 2 >= inputValue (1 for inputValue <= 1)."
invariant operation nextPowerOfTwoForSignedInt64 "Doubles a 1-seeded accumulator until it reaches or exceeds inputValue; inputs <= 1 short-circuit to 1."
guarantee nextPowerOfTwoForSignedInt64 "Total."

label startNextPowerOfTwoForSignedInt64
storage module immutable oneNp I64 1
storage module immutable twoNp I64 2

call leOneNpCall math.lessThanOrEqualI64
argument leOneNpCall left I64 inputValue
argument leOneNpCall right I64 oneNp
run leOneNpCall
bind value leOneNp Bool leOneNpCall
branch if condition leOneNp target nextPowOne

memory nextPowerOfTwoForSignedInt64 mutable p I64 1
label doubleLoop
call gePCall math.greaterThanOrEqualI64
argument gePCall left I64 p
argument gePCall right I64 inputValue
run gePCall
bind value gep Bool gePCall
branch if condition gep target nextPowDone
call doubleCall math.multiplyI64
argument doubleCall left I64 p
argument doubleCall right I64 twoNp
run doubleCall
bind value nextP I64 doubleCall
set memory p nextP
jump target doubleLoop

label nextPowDone
return value p
label nextPowOne
return value oneNp

operation countDecimalDigitsInSignedInt64
input operation countDecimalDigitsInSignedInt64 inputValue CSignedInt64
output operation countDecimalDigitsInSignedInt64 CSignedInt64
memory countDecimalDigitsInSignedInt64 heap no
async countDecimalDigitsInSignedInt64 no
purpose operation countDecimalDigitsInSignedInt64 "Returns the count of decimal digits in |inputValue|. Returns 1 for inputValue == 0."
invariant operation countDecimalDigitsInSignedInt64 "Divides the absolute value by 10 until the quotient is zero, counting iterations. Negative inputs are absolute-valued via multiplication by -1 first."
guarantee countDecimalDigitsInSignedInt64 "Total."

label startCountDecimalDigitsInSignedInt64
storage module immutable zeroCd I64 0
storage module immutable oneCd I64 1
storage module immutable tenCd I64 10
storage module immutable negOneCd I64 -1

call eqZeroCdCall math.equalI64
argument eqZeroCdCall left I64 inputValue
argument eqZeroCdCall right I64 zeroCd
run eqZeroCdCall
bind value eqZeroCd Bool eqZeroCdCall
branch if condition eqZeroCd target countDigitsOne

memory countDecimalDigitsInSignedInt64 mutable v I64 0
set memory v inputValue
call negCdCall math.lessThanI64
argument negCdCall left I64 v
argument negCdCall right I64 zeroCd
run negCdCall
bind value isNegCd Bool negCdCall
branch if condition isNegCd target flipCd
branch else target countDigitsLoop

label flipCd
call flipCdCall math.multiplyI64
argument flipCdCall left I64 v
argument flipCdCall right I64 negOneCd
run flipCdCall
bind value vFlipped I64 flipCdCall
set memory v vFlipped
jump target countDigitsLoop

label countDigitsLoop
memory countDecimalDigitsInSignedInt64 mutable count I64 0
label cdStep
call doneCdCall math.equalI64
argument doneCdCall left I64 v
argument doneCdCall right I64 zeroCd
run doneCdCall
bind value doneCd Bool doneCdCall
branch if condition doneCd target countDigitsReturn
call cdDivCall math.divideI64
argument cdDivCall left I64 v
argument cdDivCall right I64 tenCd
run cdDivCall
bind value vNext I64 cdDivCall
set memory v vNext
call cdIncCall math.addI64
argument cdIncCall left I64 count
argument cdIncCall right I64 oneCd
run cdIncCall
bind value nextCount I64 cdIncCall
set memory count nextCount
jump target cdStep

label countDigitsReturn
return value count

label countDigitsOne
return value oneCd

operation isSignedInt64Even
