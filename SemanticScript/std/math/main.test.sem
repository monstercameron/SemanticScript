# ============================================================
# SEMANTICSCRIPT STDLIB TESTS: math
# ============================================================
#
# Companion smoke + extended unit tests for std/math/main.sem.
# Imports the math module and asserts every exported integer
# helper (sqrt / factorial / isPrime / isPowerOfTwo / nextPowerOfTwo /
# digit count / parity / popcount / leading & trailing zero counts /
# sign / abs-diff / square / cube / range check) plus boundary +
# round-trip property tests (sqrtâˆ˜square, etc.).
#
# Pattern: std/main.sem ships pure-module operations only;
# std/main.test.sem carries every smoke / unit test for it.

project StdMathTest
target console
runtime AgentRuntime 0.1
entry console main

import math standard.math
error MainError
errorCase MainError MathSmokeAssertionFailed
errorCase MainError ConsoleWriteFailed

# section capability
# rationale: smoke-test main writes a single OK line to stdout.
capability stdoutWriteCapability console.stdout write

# ============================================================
# Smoke test
# ============================================================

operation floatWithinTolerance
input operation floatWithinTolerance actualValue Float64
input operation floatWithinTolerance expectedValue Float64
input operation floatWithinTolerance toleranceValue Float64
output operation floatWithinTolerance Bool
memory floatWithinTolerance heap no
async floatWithinTolerance no
purpose operation floatWithinTolerance "Return true when two Float64 values are closer than the supplied tolerance."
invariant operation floatWithinTolerance "Uses absolute difference so callers do not depend on approximation direction."

call toleranceDifferenceCall math.subtractFloat64
argument toleranceDifferenceCall left Float64 actualValue
argument toleranceDifferenceCall right Float64 expectedValue
run toleranceDifferenceCall
bind value toleranceDifference Float64 toleranceDifferenceCall
call toleranceMagnitudeCall absoluteFloat64
argument toleranceMagnitudeCall inputValue Float64 toleranceDifference
run toleranceMagnitudeCall
bind value toleranceMagnitude Float64 toleranceMagnitudeCall
call toleranceCompareCall math.lessThanFloat64
argument toleranceCompareCall left Float64 toleranceMagnitude
argument toleranceCompareCall right Float64 toleranceValue
run toleranceCompareCall
bind value isWithinTolerance Bool toleranceCompareCall
return value isWithinTolerance

operation main
input operation main console Console
output operation main Result ExitCode MainError
useCapability main stdoutWriteCapability
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Smoke-test the integer math helpers."
invariant operation main "Every named check holds, or the failure path runs."

label startMain

# integerSquareRootSignedInt64(144) == 12
storage module immutable oneHundredFortyFour Int64 144
storage module immutable twelveExpected Int64 12
call assertSqrtCall integerSquareRootSignedInt64
argument assertSqrtCall inputValue Int64 oneHundredFortyFour
run assertSqrtCall
bind value sqrtResult Int64 assertSqrtCall
call checkSqrtCall math.equalInt64
argument checkSqrtCall left Int64 sqrtResult
argument checkSqrtCall right Int64 twelveExpected
run checkSqrtCall
bind value sqrtOk Bool checkSqrtCall
branch if condition sqrtOk target sqrtHolds
branch else target smokeAssertionFailed
label sqrtHolds

# factorialSignedInt64(5) == 120
storage module immutable fiveInputForFactorial Int64 5
storage module immutable oneHundredTwentyExpected Int64 120
call assertFactorialCall factorialSignedInt64
argument assertFactorialCall inputValue Int64 fiveInputForFactorial
run assertFactorialCall
bind value factorialResult Int64 assertFactorialCall
call checkFactorialCall math.equalInt64
argument checkFactorialCall left Int64 factorialResult
argument checkFactorialCall right Int64 oneHundredTwentyExpected
run checkFactorialCall
bind value factorialOk Bool checkFactorialCall
branch if condition factorialOk target factorialHolds
branch else target smokeAssertionFailed
label factorialHolds

# isSignedInt64Prime(17) == true
storage module immutable seventeen Int64 17
call assertPrime17Call isSignedInt64Prime
argument assertPrime17Call inputValue Int64 seventeen
run assertPrime17Call
bind value prime17Result Bool assertPrime17Call
branch if condition prime17Result target prime17Holds
branch else target smokeAssertionFailed
label prime17Holds

# isSignedInt64Prime(15) == false
storage module immutable fifteen Int64 15
call assertPrime15Call isSignedInt64Prime
argument assertPrime15Call inputValue Int64 fifteen
run assertPrime15Call
bind value prime15Result Bool assertPrime15Call
branch if condition prime15Result target smokeAssertionFailed

# isSignedInt64PowerOfTwo(64) == true
storage module immutable sixtyFour Int64 64
call assertPow64Call isSignedInt64PowerOfTwo
argument assertPow64Call inputValue Int64 sixtyFour
run assertPow64Call
bind value pow64Result Bool assertPow64Call
branch if condition pow64Result target pow64Holds
branch else target smokeAssertionFailed
label pow64Holds

# isSignedInt64PowerOfTwo(48) == false
storage module immutable fortyEight Int64 48
call assertPow48Call isSignedInt64PowerOfTwo
argument assertPow48Call inputValue Int64 fortyEight
run assertPow48Call
bind value pow48Result Bool assertPow48Call
branch if condition pow48Result target smokeAssertionFailed

# nextPowerOfTwoForSignedInt64(100) == 128
storage module immutable oneHundred Int64 100
storage module immutable oneHundredTwentyEight Int64 128
call assertNextPow2Call nextPowerOfTwoForSignedInt64
argument assertNextPow2Call inputValue Int64 oneHundred
run assertNextPow2Call
bind value nextPow2Result Int64 assertNextPow2Call
call checkNextPow2Call math.equalInt64
argument checkNextPow2Call left Int64 nextPow2Result
argument checkNextPow2Call right Int64 oneHundredTwentyEight
run checkNextPow2Call
bind value nextPow2Ok Bool checkNextPow2Call
branch if condition nextPow2Ok target nextPow2Holds
branch else target smokeAssertionFailed
label nextPow2Holds

# countDecimalDigitsInSignedInt64(12345) == 5
storage module immutable twelveThousandThreeHundredFortyFive Int64 12345
storage module immutable fiveDigitsExpected Int64 5
call assertDigitCountCall countDecimalDigitsInSignedInt64
argument assertDigitCountCall inputValue Int64 twelveThousandThreeHundredFortyFive
run assertDigitCountCall
bind value digitCountResult Int64 assertDigitCountCall
call checkDigitCountCall math.equalInt64
argument checkDigitCountCall left Int64 digitCountResult
argument checkDigitCountCall right Int64 fiveDigitsExpected
run checkDigitCountCall
bind value digitCountOk Bool checkDigitCountCall
branch if condition digitCountOk target digitCountHolds
branch else target smokeAssertionFailed
label digitCountHolds

# isSignedInt64Even(10) == true
storage module immutable tenInteger Int64 10
call assertEvenCall isSignedInt64Even
argument assertEvenCall inputValue Int64 tenInteger
run assertEvenCall
bind value evenResult Bool assertEvenCall
branch if condition evenResult target evenHolds
branch else target smokeAssertionFailed
label evenHolds

# isSignedInt64Odd(10) == false
call assertOddCall isSignedInt64Odd
argument assertOddCall inputValue Int64 tenInteger
run assertOddCall
bind value oddResult Bool assertOddCall
branch if condition oddResult target smokeAssertionFailed

# countSetBitsInSignedInt64(13) == 3  (0b1101)
storage module immutable thirteen Int64 13
storage module immutable threeBits Int64 3
call assertPopcountCall countSetBitsInSignedInt64
argument assertPopcountCall inputValue Int64 thirteen
run assertPopcountCall
bind value popcountResult Int64 assertPopcountCall
call checkPopcountCall math.equalInt64
argument checkPopcountCall left Int64 popcountResult
argument checkPopcountCall right Int64 threeBits
run checkPopcountCall
bind value popcountOk Bool checkPopcountCall
branch if condition popcountOk target popcountHolds
branch else target smokeAssertionFailed
label popcountHolds

# Regression: countSetBitsInSignedInt64(-1) == 64. Every bit of the
# two's-complement representation of -1 is set; the pre-fix arithmetic
# divide-by-two collapsed the sign bits and returned 1.
storage module immutable negativeOnePopcount Int64 -1
storage module immutable sixtyFourBits Int64 64
call assertNegPopcountCall countSetBitsInSignedInt64
argument assertNegPopcountCall inputValue Int64 negativeOnePopcount
run assertNegPopcountCall
bind value negPopcountResult Int64 assertNegPopcountCall
call checkNegPopcountCall math.equalInt64
argument checkNegPopcountCall left Int64 negPopcountResult
argument checkNegPopcountCall right Int64 sixtyFourBits
run checkNegPopcountCall
bind value negPopcountOk Bool checkNegPopcountCall
branch if condition negPopcountOk target negPopcountHolds
branch else target smokeAssertionFailed
label negPopcountHolds

# countTrailingZeroBitsInSignedInt64(16) == 4
storage module immutable sixteenInteger Int64 16
storage module immutable fourTrailingZeros Int64 4
call assertCtzCall countTrailingZeroBitsInSignedInt64
argument assertCtzCall inputValue Int64 sixteenInteger
run assertCtzCall
bind value ctzResult Int64 assertCtzCall
call checkCtzCall math.equalInt64
argument checkCtzCall left Int64 ctzResult
argument checkCtzCall right Int64 fourTrailingZeros
run checkCtzCall
bind value ctzOk Bool checkCtzCall
branch if condition ctzOk target ctzHolds
branch else target smokeAssertionFailed
label ctzHolds

# signOfSignedInt64(-5) == -1
storage module immutable negativeFive Int64 -5
storage module immutable negativeOne Int64 -1
call assertSignCall signOfSignedInt64
argument assertSignCall inputValue Int64 negativeFive
run assertSignCall
bind value signResult Int64 assertSignCall
call checkSignCall math.equalInt64
argument checkSignCall left Int64 signResult
argument checkSignCall right Int64 negativeOne
run checkSignCall
bind value signOk Bool checkSignCall
branch if condition signOk target signHolds
branch else target smokeAssertionFailed
label signHolds

# absoluteDifferenceBetweenSignedInt64Values(10, 3) == 7
storage module immutable threeForAbsDiff Int64 3
storage module immutable sevenExpected Int64 7
call assertAbsDiffCall absoluteDifferenceBetweenSignedInt64Values
argument assertAbsDiffCall leftValue Int64 tenInteger
argument assertAbsDiffCall rightValue Int64 threeForAbsDiff
run assertAbsDiffCall
bind value absDiffResult Int64 assertAbsDiffCall
call checkAbsDiffCall math.equalInt64
argument checkAbsDiffCall left Int64 absDiffResult
argument checkAbsDiffCall right Int64 sevenExpected
run checkAbsDiffCall
bind value absDiffOk Bool checkAbsDiffCall
branch if condition absDiffOk target absDiffHolds
branch else target smokeAssertionFailed
label absDiffHolds

# ============================================================
# Per-operation extended unit tests: covers ops the original smoke
# test omitted (countLeadingZeroBitsInSignedInt64, squareSignedInt64,
# cubeSignedInt64, isSignedInt64WithinInclusiveRange) plus boundary
# cases (zero, one, two) and property invariants (commutativity,
# round-trip) for ops already covered.
# ============================================================

storage module immutable zeroSm Int64 0
storage module immutable oneSm Int64 1
storage module immutable twoSm Int64 2
storage module immutable sixSm Int64 6
storage module immutable negTenSm Int64 -10
storage module immutable negTwoSm Int64 -2
storage module immutable sixtyTwoSm Int64 62
storage module immutable sixtyThreeSm Int64 63
storage module immutable minusOneSm Int64 -1
storage module immutable oneHundredFortyFourEx Int64 144

# integerSquareRoot boundary: sqrt(0) == 0
call sqrtZeroCall integerSquareRootSignedInt64
argument sqrtZeroCall inputValue Int64 zeroSm
run sqrtZeroCall
bind value sqrtZeroResult Int64 sqrtZeroCall
call checkSqrtZeroCall math.equalInt64
argument checkSqrtZeroCall left Int64 sqrtZeroResult
argument checkSqrtZeroCall right Int64 zeroSm
run checkSqrtZeroCall
bind value sqrtZeroOk Bool checkSqrtZeroCall
branch if condition sqrtZeroOk target sqrtZeroHolds
branch else target smokeAssertionFailed
label sqrtZeroHolds

# integerSquareRoot boundary: sqrt(1) == 1
call sqrtOneCall integerSquareRootSignedInt64
argument sqrtOneCall inputValue Int64 oneSm
run sqrtOneCall
bind value sqrtOneResult Int64 sqrtOneCall
call checkSqrtOneCall math.equalInt64
argument checkSqrtOneCall left Int64 sqrtOneResult
argument checkSqrtOneCall right Int64 oneSm
run checkSqrtOneCall
bind value sqrtOneOk Bool checkSqrtOneCall
branch if condition sqrtOneOk target sqrtOneHolds
branch else target smokeAssertionFailed
label sqrtOneHolds

# integerSquareRoot negative: sqrt(-10) == 0 (clamps to zero)
call sqrtNegCall integerSquareRootSignedInt64
argument sqrtNegCall inputValue Int64 negTenSm
run sqrtNegCall
bind value sqrtNegResult Int64 sqrtNegCall
call checkSqrtNegCall math.equalInt64
argument checkSqrtNegCall left Int64 sqrtNegResult
argument checkSqrtNegCall right Int64 zeroSm
run checkSqrtNegCall
bind value sqrtNegOk Bool checkSqrtNegCall
branch if condition sqrtNegOk target sqrtNegHolds
branch else target smokeAssertionFailed
label sqrtNegHolds

