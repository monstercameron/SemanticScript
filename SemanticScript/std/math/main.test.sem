argument rangeBelowCall inputValue CSignedInt64 minusOneSm
argument rangeBelowCall lowerBound CSignedInt64 zeroSm
argument rangeBelowCall upperBound CSignedInt64 tenInteger
run rangeBelowCall
bind value rangeBelowResult Bool rangeBelowCall
branch if condition rangeBelowResult target smokeAssertionFailed

# 11 in [0, 10] == false (above upper)
storage module immutable elevenSm CSignedInt64 11
call rangeAboveCall isSignedInt64WithinInclusiveRange
argument rangeAboveCall inputValue CSignedInt64 elevenSm
argument rangeAboveCall lowerBound CSignedInt64 zeroSm
argument rangeAboveCall upperBound CSignedInt64 tenInteger
run rangeAboveCall
bind value rangeAboveResult Bool rangeAboveCall
branch if condition rangeAboveResult target smokeAssertionFailed

# Property: sqrt(square(x)) == x for x >= 0
call squareForRoundTripCall squareSignedInt64
argument squareForRoundTripCall inputValue CSignedInt64 twelveExpected
run squareForRoundTripCall
bind value squareForRoundTripResult CSignedInt64 squareForRoundTripCall
call sqrtAfterSquareCall integerSquareRootSignedInt64
argument sqrtAfterSquareCall inputValue CSignedInt64 squareForRoundTripResult
run sqrtAfterSquareCall
bind value sqrtAfterSquareResult CSignedInt64 sqrtAfterSquareCall
call checkRoundTripSquareSqrtCall math.equalI64
argument checkRoundTripSquareSqrtCall left I64 sqrtAfterSquareResult
argument checkRoundTripSquareSqrtCall right I64 twelveExpected
run checkRoundTripSquareSqrtCall
bind value roundTripSquareSqrtOk Bool checkRoundTripSquareSqrtCall
branch if condition roundTripSquareSqrtOk target roundTripSquareSqrtHolds
branch else target smokeAssertionFailed
label roundTripSquareSqrtHolds

storage module immutable successMessageText CNullTerminatedByteString "OK"
call writeSuccessLineCall console.writeLine
argument writeSuccessLineCall console Console console
argument writeSuccessLineCall text CNullTerminatedByteString successMessageText
run writeSuccessLineCall
ignore ok source writeSuccessLineCall type CSignedInt32
bind error consoleWriteResultError CSignedInt32 writeSuccessLineCall
branch error source writeSuccessLineCall target consoleWriteFailedHandler
storage module immutable exitOkCode ExitCode 0
return ok exitOkCode

# Failure leg: surface the raw negative CSignedInt32 from
# console.writeLine as the cause attached to the typed
# MainError.ConsoleWriteFailed variant.
label consoleWriteFailedHandler
makeError consoleWriteFailedFailure MainError.ConsoleWriteFailed consoleWriteResultError
return error consoleWriteFailedFailure
label smokeAssertionFailed
makeError mathSmokeFailure MainError.MathSmokeAssertionFailed
return error mathSmokeFailure
