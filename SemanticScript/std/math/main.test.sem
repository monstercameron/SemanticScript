# ============================================================
# SEMANTICSCRIPT STDLIB TESTS: math
# ============================================================
#
# Companion smoke + extended unit tests for std/math/main.sem.
# Imports the math module and asserts every exported integer
# helper (sqrt / factorial / isPrime / isPowerOfTwo / nextPowerOfTwo /
# digit count / parity / popcount / leading & trailing zero counts /
# sign / abs-diff / square / cube / range check) plus boundary +
# round-trip property tests (sqrtâˆ˜square, etc.).
#
# Pattern: std/main.sem ships pure-module operations only;
# std/main.test.sem carries every smoke / unit test for it.

project StdMathTest
target console
runtime AgentRuntime 0.1
entry console main

import math standard.math
error MainError
errorCase MainError MathSmokeAssertionFailed
errorCase MainError ConsoleWriteFailed

# section capability
# rationale: smoke-test main writes a single OK line to stdout.
capability stdoutWriteCapability console.stdout write

# ============================================================
# Smoke test
# ============================================================

operation main
input operation main console Console
output operation main Result ExitCode MainError
useCapability main stdoutWriteCapability
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Smoke-test the integer math helpers."
invariant operation main "Every named check holds, or the failure path runs."

label startMain

# integerSquareRootSignedInt64(144) == 12
storage module immutable oneHundredFortyFour CSignedInt64 144
storage module immutable twelveExpected CSignedInt64 12
call assertSqrtCall integerSquareRootSignedInt64
argument assertSqrtCall inputValue CSignedInt64 oneHundredFortyFour
run assertSqrtCall
bind value sqrtResult CSignedInt64 assertSqrtCall
call checkSqrtCall math.equalI64
argument checkSqrtCall left I64 sqrtResult
argument checkSqrtCall right I64 twelveExpected
run checkSqrtCall
bind value sqrtOk Bool checkSqrtCall
branch if condition sqrtOk target sqrtHolds
branch else target smokeAssertionFailed
label sqrtHolds

# factorialSignedInt64(5) == 120
storage module immutable fiveInputForFactorial CSignedInt64 5
storage module immutable oneHundredTwentyExpected CSignedInt64 120
call assertFactorialCall factorialSignedInt64
argument assertFactorialCall inputValue CSignedInt64 fiveInputForFactorial
run assertFactorialCall
bind value factorialResult CSignedInt64 assertFactorialCall
call checkFactorialCall math.equalI64
argument checkFactorialCall left I64 factorialResult
argument checkFactorialCall right I64 oneHundredTwentyExpected
run checkFactorialCall
bind value factorialOk Bool checkFactorialCall
branch if condition factorialOk target factorialHolds
branch else target smokeAssertionFailed
label factorialHolds

# isSignedInt64Prime(17) == true
storage module immutable seventeen CSignedInt64 17
call assertPrime17Call isSignedInt64Prime
argument assertPrime17Call inputValue CSignedInt64 seventeen
run assertPrime17Call
bind value prime17Result Bool assertPrime17Call
branch if condition prime17Result target prime17Holds
branch else target smokeAssertionFailed
label prime17Holds

# isSignedInt64Prime(15) == false
storage module immutable fifteen CSignedInt64 15
call assertPrime15Call isSignedInt64Prime
argument assertPrime15Call inputValue CSignedInt64 fifteen
run assertPrime15Call
bind value prime15Result Bool assertPrime15Call
branch if condition prime15Result target smokeAssertionFailed

# isSignedInt64PowerOfTwo(64) == true
storage module immutable sixtyFour CSignedInt64 64
call assertPow64Call isSignedInt64PowerOfTwo
argument assertPow64Call inputValue CSignedInt64 sixtyFour
run assertPow64Call
bind value pow64Result Bool assertPow64Call
branch if condition pow64Result target pow64Holds
branch else target smokeAssertionFailed
label pow64Holds

# isSignedInt64PowerOfTwo(48) == false
storage module immutable fortyEight CSignedInt64 48
call assertPow48Call isSignedInt64PowerOfTwo
argument assertPow48Call inputValue CSignedInt64 fortyEight
run assertPow48Call
bind value pow48Result Bool assertPow48Call
branch if condition pow48Result target smokeAssertionFailed

# nextPowerOfTwoForSignedInt64(100) == 128
storage module immutable oneHundred CSignedInt64 100
storage module immutable oneHundredTwentyEight CSignedInt64 128
call assertNextPow2Call nextPowerOfTwoForSignedInt64
argument assertNextPow2Call inputValue CSignedInt64 oneHundred
run assertNextPow2Call
bind value nextPow2Result CSignedInt64 assertNextPow2Call
call checkNextPow2Call math.equalI64
argument checkNextPow2Call left I64 nextPow2Result
argument checkNextPow2Call right I64 oneHundredTwentyEight
run checkNextPow2Call
bind value nextPow2Ok Bool checkNextPow2Call
branch if condition nextPow2Ok target nextPow2Holds
branch else target smokeAssertionFailed
label nextPow2Holds

# countDecimalDigitsInSignedInt64(12345) == 5
storage module immutable twelveThousandThreeHundredFortyFive CSignedInt64 12345
storage module immutable fiveDigitsExpected CSignedInt64 5
call assertDigitCountCall countDecimalDigitsInSignedInt64
argument assertDigitCountCall inputValue CSignedInt64 twelveThousandThreeHundredFortyFive
run assertDigitCountCall
bind value digitCountResult CSignedInt64 assertDigitCountCall
call checkDigitCountCall math.equalI64
argument checkDigitCountCall left I64 digitCountResult
argument checkDigitCountCall right I64 fiveDigitsExpected
run checkDigitCountCall
bind value digitCountOk Bool checkDigitCountCall
branch if condition digitCountOk target digitCountHolds
branch else target smokeAssertionFailed
label digitCountHolds

# isSignedInt64Even(10) == true
storage module immutable tenInteger CSignedInt64 10
call assertEvenCall isSignedInt64Even
argument assertEvenCall inputValue CSignedInt64 tenInteger
run assertEvenCall
bind value evenResult Bool assertEvenCall
branch if condition evenResult target evenHolds
branch else target smokeAssertionFailed
label evenHolds

# isSignedInt64Odd(10) == false
call assertOddCall isSignedInt64Odd
argument assertOddCall inputValue CSignedInt64 tenInteger
run assertOddCall
bind value oddResult Bool assertOddCall
branch if condition oddResult target smokeAssertionFailed

# countSetBitsInSignedInt64(13) == 3  (0b1101)
storage module immutable thirteen CSignedInt64 13
storage module immutable threeBits CSignedInt64 3
call assertPopcountCall countSetBitsInSignedInt64
argument assertPopcountCall inputValue CSignedInt64 thirteen
run assertPopcountCall
bind value popcountResult CSignedInt64 assertPopcountCall
call checkPopcountCall math.equalI64
argument checkPopcountCall left I64 popcountResult
argument checkPopcountCall right I64 threeBits
run checkPopcountCall
bind value popcountOk Bool checkPopcountCall
branch if condition popcountOk target popcountHolds
branch else target smokeAssertionFailed
label popcountHolds

# Regression: countSetBitsInSignedInt64(-1) == 64. Every bit of the
# two's-complement representation of -1 is set; the pre-fix arithmetic
# divide-by-two collapsed the sign bits and returned 1.
storage module immutable negativeOnePopcount CSignedInt64 -1
storage module immutable sixtyFourBits CSignedInt64 64
call assertNegPopcountCall countSetBitsInSignedInt64
argument assertNegPopcountCall inputValue CSignedInt64 negativeOnePopcount
run assertNegPopcountCall
bind value negPopcountResult CSignedInt64 assertNegPopcountCall
call checkNegPopcountCall math.equalI64
argument checkNegPopcountCall left I64 negPopcountResult
argument checkNegPopcountCall right I64 sixtyFourBits
run checkNegPopcountCall
bind value negPopcountOk Bool checkNegPopcountCall
branch if condition negPopcountOk target negPopcountHolds
branch else target smokeAssertionFailed
label negPopcountHolds

# countTrailingZeroBitsInSignedInt64(16) == 4
storage module immutable sixteenInteger CSignedInt64 16
storage module immutable fourTrailingZeros CSignedInt64 4
call assertCtzCall countTrailingZeroBitsInSignedInt64
argument assertCtzCall inputValue CSignedInt64 sixteenInteger
run assertCtzCall
bind value ctzResult CSignedInt64 assertCtzCall
call checkCtzCall math.equalI64
argument checkCtzCall left I64 ctzResult
argument checkCtzCall right I64 fourTrailingZeros
run checkCtzCall
bind value ctzOk Bool checkCtzCall
branch if condition ctzOk target ctzHolds
branch else target smokeAssertionFailed
label ctzHolds

# signOfSignedInt64(-5) == -1
storage module immutable negativeFive CSignedInt64 -5
storage module immutable negativeOne CSignedInt64 -1
call assertSignCall signOfSignedInt64
argument assertSignCall inputValue CSignedInt64 negativeFive
run assertSignCall
bind value signResult CSignedInt64 assertSignCall
call checkSignCall math.equalI64
argument checkSignCall left I64 signResult
argument checkSignCall right I64 negativeOne
run checkSignCall
bind value signOk Bool checkSignCall
branch if condition signOk target signHolds
branch else target smokeAssertionFailed
label signHolds

# absoluteDifferenceBetweenSignedInt64Values(10, 3) == 7
storage module immutable threeForAbsDiff CSignedInt64 3
storage module immutable sevenExpected CSignedInt64 7
call assertAbsDiffCall absoluteDifferenceBetweenSignedInt64Values
argument assertAbsDiffCall leftValue CSignedInt64 tenInteger
argument assertAbsDiffCall rightValue CSignedInt64 threeForAbsDiff
run assertAbsDiffCall
bind value absDiffResult CSignedInt64 assertAbsDiffCall
call checkAbsDiffCall math.equalI64
argument checkAbsDiffCall left I64 absDiffResult
argument checkAbsDiffCall right I64 sevenExpected
run checkAbsDiffCall
bind value absDiffOk Bool checkAbsDiffCall
branch if condition absDiffOk target absDiffHolds
branch else target smokeAssertionFailed
label absDiffHolds

# ============================================================
# Per-operation extended unit tests: covers ops the original smoke
# test omitted (countLeadingZeroBitsInSignedInt64, squareSignedInt64,
# cubeSignedInt64, isSignedInt64WithinInclusiveRange) plus boundary
# cases (zero, one, two) and property invariants (commutativity,
# round-trip) for ops already covered.
# ============================================================

storage module immutable zeroSm CSignedInt64 0
storage module immutable oneSm CSignedInt64 1
storage module immutable twoSm CSignedInt64 2
storage module immutable sixSm CSignedInt64 6
storage module immutable negTenSm CSignedInt64 -10
storage module immutable negTwoSm CSignedInt64 -2
storage module immutable sixtyTwoSm CSignedInt64 62
storage module immutable sixtyThreeSm CSignedInt64 63
storage module immutable minusOneSm CSignedInt64 -1
storage module immutable oneHundredFortyFourEx CSignedInt64 144

# integerSquareRoot boundary: sqrt(0) == 0
call sqrtZeroCall integerSquareRootSignedInt64
argument sqrtZeroCall inputValue CSignedInt64 zeroSm
run sqrtZeroCall
bind value sqrtZeroResult CSignedInt64 sqrtZeroCall
call checkSqrtZeroCall math.equalI64
argument checkSqrtZeroCall left I64 sqrtZeroResult
argument checkSqrtZeroCall right I64 zeroSm
run checkSqrtZeroCall
bind value sqrtZeroOk Bool checkSqrtZeroCall
branch if condition sqrtZeroOk target sqrtZeroHolds
branch else target smokeAssertionFailed
label sqrtZeroHolds

# integerSquareRoot boundary: sqrt(1) == 1
call sqrtOneCall integerSquareRootSignedInt64
argument sqrtOneCall inputValue CSignedInt64 oneSm
run sqrtOneCall
bind value sqrtOneResult CSignedInt64 sqrtOneCall
call checkSqrtOneCall math.equalI64
argument checkSqrtOneCall left I64 sqrtOneResult
argument checkSqrtOneCall right I64 oneSm
run checkSqrtOneCall
bind value sqrtOneOk Bool checkSqrtOneCall
branch if condition sqrtOneOk target sqrtOneHolds
branch else target smokeAssertionFailed
label sqrtOneHolds

# integerSquareRoot negative: sqrt(-10) == 0 (clamps to zero)
call sqrtNegCall integerSquareRootSignedInt64
argument sqrtNegCall inputValue CSignedInt64 negTenSm
run sqrtNegCall
bind value sqrtNegResult CSignedInt64 sqrtNegCall
call checkSqrtNegCall math.equalI64
argument checkSqrtNegCall left I64 sqrtNegResult
argument checkSqrtNegCall right I64 zeroSm
run checkSqrtNegCall
bind value sqrtNegOk Bool checkSqrtNegCall
branch if condition sqrtNegOk target sqrtNegHolds
branch else target smokeAssertionFailed
label sqrtNegHolds

