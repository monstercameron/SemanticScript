argument emitHexDigitCall characterCode CSignedInt32 hexDigitToEmit
run emitHexDigitCall
ignore value source emitHexDigitCall type CSignedInt32
jump target emitNextHexDigit
label emitHexTrailingNewline
call emitHexNewlineCall writeByteToStandardOutput
argument emitHexNewlineCall characterCode CSignedInt32 asciiNewlineByteCode
run emitHexNewlineCall
ignore value source emitHexNewlineCall type CSignedInt32
return value hexDigitCount

# Allocation-failure leg for the hex formatter.
label hexScratchAllocationFailedReturn
return value hexScratchAllocationError
label emitHexZero
call emitHexZeroByteCall writeByteToStandardOutput
argument emitHexZeroByteCall characterCode CSignedInt32 asciiZeroByteCode
run emitHexZeroByteCall
ignore value source emitHexZeroByteCall type CSignedInt32
call emitHexZeroNewlineCall writeByteToStandardOutput
argument emitHexZeroNewlineCall characterCode CSignedInt32 asciiNewlineByteCode
run emitHexZeroNewlineCall
ignore value source emitHexZeroNewlineCall type CSignedInt32
storage module immutable hexZeroByteCount CByteCount 1
return value hexZeroByteCount
