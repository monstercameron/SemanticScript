domainLiteral asciiNewlineByteCode Int32 10
domainLiteralTrust asciiNewlineByteCode trustedStaticLiteral
domainLiteral asciiMinusByteCode Int32 45
domainLiteralTrust asciiMinusByteCode trustedStaticLiteral
domainLiteral asciiZeroByteCode Int32 48
domainLiteralTrust asciiZeroByteCode trustedStaticLiteral
domainLiteral asciiZeroByteCodeAsInt64 Int64 48
domainLiteralTrust asciiZeroByteCodeAsInt64 trustedStaticLiteral
domainLiteral asciiLowercaseAOffsetForHex Int64 87
domainLiteralTrust asciiLowercaseAOffsetForHex trustedStaticLiteral
domainLiteral hexadecimalBase Int64 16
domainLiteralTrust hexadecimalBase trustedStaticLiteral
domainLiteral hexadecimalLetterThreshold Int64 10
domainLiteralTrust hexadecimalLetterThreshold trustedStaticLiteral
domainLiteral decimalBase Int64 10
domainLiteralTrust decimalBase trustedStaticLiteral
domainLiteral integerOneStepValue Int64 1
domainLiteralTrust integerOneStepValue trustedStaticLiteral
domainLiteral integerNegativeOneMultiplier Int64 -1
domainLiteralTrust integerNegativeOneMultiplier trustedStaticLiteral
domainLiteral integerZeroBoundaryForStdio Int64 0
domainLiteralTrust integerZeroBoundaryForStdio trustedStaticLiteral
domainLiteral digitBufferByteSize ByteCount 32
domainLiteralTrust digitBufferByteSize trustedStaticLiteral

# section stdio.bytePrimitive

operation writeByteToStandardOutput
input operation writeByteToStandardOutput characterCode Int32
output operation writeByteToStandardOutput Int32
useCapability writeByteToStandardOutput stdoutWriteCapability
effect writeByteToStandardOutput write console.stdout
memory writeByteToStandardOutput heap no
memory writeByteToStandardOutput stack max 1024
async writeByteToStandardOutput no
purpose operation writeByteToStandardOutput "Writes one byte to stdout via libc putchar. The only operation in std that crosses out to the host OS for I/O â€” every higher-level write bottoms out through here."
invariant operation writeByteToStandardOutput "Returns the libc putchar return value (typically the character itself, or negative on EOF/error)."
warning writeByteToStandardOutput "Writes are unbuffered at the SemanticScript layer â€” every byte yields to libc immediately."
guarantee writeByteToStandardOutput "Always returns; never throws."
label startWriteByteToStandardOutput
call libcPutcharCall c.putchar
argument libcPutcharCall c Int32 characterCode
run libcPutcharCall
ignore ok source libcPutcharCall type Int32
bind error libcPutcharErrorCodeError Int32 libcPutcharCall
branch error source libcPutcharCall target returnPutcharErrorPath
bind value libcPutcharResult Int32 libcPutcharCall
return value libcPutcharResult
# On putchar error (typically EOF) propagate the negative return
# to the caller; higher-level writers absorb this via ignoreValue.
label returnPutcharErrorPath
return value libcPutcharErrorCodeError

