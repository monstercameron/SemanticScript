# ============================================================
# SEMANTICSCRIPT STDLIB TESTS: stdio
# ============================================================
#
# Companion smoke for std/stdio/main.sem. Unlike most stdlib
# smokes (which print only "OK"), this one prints a multi-line
# demo of every writer because the writers' job IS to write â€”
# stdout IS the assertion surface. test_stdlib.py asserts the
# exact byte sequence emitted here matches its EXPECTED_STDIO_OUTPUT.
#
# Pattern: std/main.sem ships pure-module operations only;
# std/main.test.sem carries every smoke / unit test for it.
# stdio is special â€” the impl writers themselves declare
# stdoutWriteCapability + heapAllocationCapability + heapFreeCapability
# (they're not smoke-only), so those declarations STAY in stdio.sscript
# rather than moving here.

project StdStdioTest
target console
runtime AgentRuntime 0.1
entry console main

import stdio standard.stdio
# Typed error domain for write failures. Aggregate writers absorb
# putchar/EOF failures via ignoreValue; the smoke wires
# console.writeLine failures into MainError.ByteWriteFailedDuringSmoke.
error MainError
errorCase MainError ByteWriteFailedDuringSmoke

# ============================================================
# Smoke test â€” output expected by tests/test_stdlib.py:
#   "Hello, SemanticScript stdlib!\n"
#   "no-newline-then-writeStringLineToStandardOutput\n"
#   "42\n"
#   "-1234\n"
#   "0\n"
#   "255\n"
#   "ff\n"
# ============================================================

operation main
input operation main console Console
output operation main Result ExitCode MainError
useCapability main stdoutWriteCapability
useCapability main heapAllocationCapability
useCapability main heapFreeCapability
effect main write console.stdout
effect main allocate heap
effect main free heap
memory main heap yes
memoryStackLimit main 16384
# The decimal/hex formatters are the heap-allocators; we name one
# of them as the canonical allocation source for tooling.
memoryAllocationSource main emitFortyTwoCall
async main no
purpose operation main "Smoke-test every stdio writer. Output matches the byte-exact sequence expected by test_stdlib.py."
invariant operation main "Emits the test_stdlib.py-expected byte sequence; returns Ok 0 on success."

label startMain

# Emit the first banner via console.writeLine so the smoke
# references the runtime Console handle AND surfaces a typed
# failure path through MainError.ByteWriteFailedDuringSmoke if
# stdout itself fails (e.g. closed pipe). The remaining lines go
# through the byte-level writers under test.
storage module immutable helloSemanticScriptStdlibBanner String "Hello, SemanticScript stdlib!"
call emitHelloBannerCall console.writeLine
argument emitHelloBannerCall console Console console
argument emitHelloBannerCall text String helloSemanticScriptStdlibBanner
run emitHelloBannerCall
ignore ok source emitHelloBannerCall type Int32
bind error emitHelloBannerError Int32 emitHelloBannerCall
branch error source emitHelloBannerCall target byteWriteFailedDuringSmokeHandler

storage module immutable noNewlineProbeText String "no-newline-then-writeStringLineToStandardOutput"
call emitNoNewlineProbeCall writeStringToStandardOutput
argument emitNoNewlineProbeCall inputText String noNewlineProbeText
run emitNoNewlineProbeCall
ignore value source emitNoNewlineProbeCall type ByteCount

storage module immutable emptyTerminatorMarker String ""
call emitEmptyTerminatorCall writeStringLineToStandardOutput
argument emitEmptyTerminatorCall inputText String emptyTerminatorMarker
run emitEmptyTerminatorCall
ignore value source emitEmptyTerminatorCall type ByteCount

storage module immutable fortyTwoSampleValue Int64 42
call emitFortyTwoCall writeSignedInt64DecimalToStandardOutput
argument emitFortyTwoCall inputValue Int64 fortyTwoSampleValue
run emitFortyTwoCall
ignore value source emitFortyTwoCall type ByteCount

storage module immutable negativeTwelveThirtyFour Int64 -1234
call emitNegativeSampleCall writeSignedInt64DecimalToStandardOutput
argument emitNegativeSampleCall inputValue Int64 negativeTwelveThirtyFour
run emitNegativeSampleCall
ignore value source emitNegativeSampleCall type ByteCount

storage module immutable zeroSampleForDecimal Int64 0
call emitDecimalZeroSampleCall writeSignedInt64DecimalToStandardOutput
argument emitDecimalZeroSampleCall inputValue Int64 zeroSampleForDecimal
run emitDecimalZeroSampleCall
ignore value source emitDecimalZeroSampleCall type ByteCount

storage module immutable twoFiftyFiveSampleValue Int64 255
call emitUnsignedTwoFiftyFiveCall writeUnsignedInt64DecimalToStandardOutput
argument emitUnsignedTwoFiftyFiveCall inputValue Int64 twoFiftyFiveSampleValue
run emitUnsignedTwoFiftyFiveCall
ignore value source emitUnsignedTwoFiftyFiveCall type ByteCount

call emitHexTwoFiftyFiveCall writeSignedInt64HexToStandardOutput
argument emitHexTwoFiftyFiveCall inputValue Int64 twoFiftyFiveSampleValue
run emitHexTwoFiftyFiveCall
ignore value source emitHexTwoFiftyFiveCall type ByteCount

# Exercise writeByteToStandardOutput by emitting 'A' (65) then '\n' (10).
# This was the one stdio op missing from the original smoke; the
# expected stdout in test_stdlib.py is extended by exactly "A\n".
storage module immutable capitalAByteCode Int32 65
call emitCapitalAByteCall writeByteToStandardOutput
argument emitCapitalAByteCall characterCode Int32 capitalAByteCode
run emitCapitalAByteCall
ignore value source emitCapitalAByteCall type Int32
storage module immutable lineFeedByteCode Int32 10
call emitLineFeedByteCall writeByteToStandardOutput
argument emitLineFeedByteCall characterCode Int32 lineFeedByteCode
run emitLineFeedByteCall
ignore value source emitLineFeedByteCall type Int32

storage module immutable exitOkCode ExitCode 0
return ok exitOkCode

# Failure leg: the first banner write failed (closed pipe, etc.).
# Surface the typed variant with the raw negative status as cause.
label byteWriteFailedDuringSmokeHandler
makeError byteWriteFailedDuringSmokeFailure MainError.ByteWriteFailedDuringSmoke emitHelloBannerError
return error byteWriteFailedDuringSmokeFailure
