# ============================================================
# SEMANTICSCRIPT STANDARD LIBRARY TESTS: POSIX signal numbers
# ============================================================
#
# rationale: companion test file for std/signal/main.sem. Imports
#   the signal module and verifies the canonical SIGINT / SIGTERM
#   numbers. raiseProcessSignalNumber is deliberately NOT invoked
#   here â€” calling it would deliver a signal to the test runner.
#
# invariant: success prints "OK\n" and exits 0; any failed
#   assertion surfaces MainError.SignalSmokeAssertionFailed.
#
# # pattern: this is the canonical main.test.sem form â€” same
#   directory as main.sem, import foo standard.foo, project block local
#   to the test, entry console main. The implementation file
#   std/signal/main.sem carries no smoke main itself.

project StdSignalTest
target console
runtime AgentRuntime 0.1
entry console main

import signal standard.signal
importConstant interruptSignalNumber signal interruptSignalNumber
importConstant terminationSignalNumber signal terminationSignalNumber
error MainError
errorCase MainError SignalSmokeAssertionFailed
errorCase MainError ConsoleWriteFailed

# section capability
# rationale: smoke-test main writes a single OK line to stdout.
capability stdoutWriteCapability console.stdout write

# ============================================================
# Smoke test
# ============================================================

operation main
input operation main console Console
output operation main Result ExitCode MainError
useCapability main stdoutWriteCapability
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Verify signal-number constants resolve to expected POSIX values."
invariant operation main "SIGINT == 2, SIGTERM == 15."

label startMain

storage module immutable interruptExpectedValue Int32 2
call checkInterruptCall math.equalInt64
argument checkInterruptCall left Int64 interruptSignalNumber
argument checkInterruptCall right Int64 interruptExpectedValue
run checkInterruptCall
bind value interruptOk Bool checkInterruptCall
branch if condition interruptOk target interruptHolds
branch else target smokeAssertionFailed
label interruptHolds

storage module immutable terminationExpectedValue Int32 15
call checkTerminationCall math.equalInt64
argument checkTerminationCall left Int64 terminationSignalNumber
argument checkTerminationCall right Int64 terminationExpectedValue
run checkTerminationCall
bind value terminationOk Bool checkTerminationCall
branch if condition terminationOk target terminationHolds
branch else target smokeAssertionFailed
label terminationHolds

storage module immutable successMessageText String "OK"
call writeSuccessLineCall console.writeLine
argument writeSuccessLineCall text String successMessageText
run writeSuccessLineCall
ignore void source writeSuccessLineCall
bind error consoleWriteResultError Int32 writeSuccessLineCall
branch error source writeSuccessLineCall target consoleWriteFailedHandler
storage module immutable exitOkCode ExitCode 0
return ok exitOkCode

# Failure leg: surface the raw negative Int32 from
# console.writeLine as the cause attached to the typed
# MainError.ConsoleWriteFailed variant.
label consoleWriteFailedHandler
makeError consoleWriteFailedFailure MainError.ConsoleWriteFailed consoleWriteResultError
return error consoleWriteFailedFailure
label smokeAssertionFailed
makeError signalSmokeFailure MainError.SignalSmokeAssertionFailed
return error signalSmokeFailure
