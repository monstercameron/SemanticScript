project StdHtmlMetadataTest
target console
runtime AgentRuntime 0.1
entry console main

import html standard.html
importConstant importedHtmlModuleVersionText html htmlModuleVersionText

storage module immutable okText CNullTerminatedByteString "OK"
storage module immutable successCode ExitCode 0

operation main
output operation main ExitCode
effect main write console.stdout
authority main write console.stdout
memory main heap no
async main no
purpose operation main "Smoke-test the canonical standard.html import path from its module folder."

call writeCall console.writeLine
argument writeCall text CNullTerminatedByteString okText
run writeCall
ignore value source writeCall type CSignedInt32

return value successCode
