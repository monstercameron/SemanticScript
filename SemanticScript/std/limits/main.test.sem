# ============================================================
# SEMANTICSCRIPT STANDARD LIBRARY TESTS: <limits.h>-style bounds
# ============================================================
#
# rationale: companion test file for std/limits/main.sem. Imports
#   the limits module and verifies a representative subset of the
#   numeric-limit domainLiteral constants resolves to its ISO C99
#   value.
#
# invariant: success prints "OK\n" and exits 0; any failed
#   assertion surfaces MainError.LimitsSmokeAssertionFailed.
#
# pattern: canonical main.test.sem form — same directory as
#   main.sem, import the module, project block local to the test,
#   entry console main. The implementation file std/limits/main.sem
#   carries no smoke main itself.

project StdLimitsTest
target console
runtime AgentRuntime 0.1
entry console main

import limits standard.limits
importConstant maximumSignedInt8Value limits maximumSignedInt8Value
importConstant maximumSignedInt32Value limits maximumSignedInt32Value
importConstant bitCountPerByte limits bitCountPerByte
error MainError
errorCase MainError LimitsSmokeAssertionFailed
errorCase MainError ConsoleWriteFailed

# section capability
# rationale: smoke-test main writes a single OK line to stdout.
capability stdoutWriteCapability console.stdout write

# ============================================================
# Smoke test
# ============================================================

operation main
input operation main console Console
output operation main Result ExitCode MainError
useCapability main stdoutWriteCapability
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Verify a representative subset of the numeric-limit constants resolves correctly."
invariant operation main "INT8_MAX == 127, INT32_MAX == 2147483647, CHAR_BIT == 8."

label startMain

storage module immutable oneHundredTwentySeven Int64 127
call checkInt8MaxCall math.equalInt64
argument checkInt8MaxCall left Int64 maximumSignedInt8Value
argument checkInt8MaxCall right Int64 oneHundredTwentySeven
run checkInt8MaxCall
bind value int8MaxOk Bool checkInt8MaxCall
branch if condition int8MaxOk target int8MaxHolds
branch else target smokeAssertionFailed
label int8MaxHolds

storage module immutable twoToThirtyOneMinusOne Int64 2147483647
call checkInt32MaxCall math.equalInt64
argument checkInt32MaxCall left Int64 maximumSignedInt32Value
argument checkInt32MaxCall right Int64 twoToThirtyOneMinusOne
run checkInt32MaxCall
bind value int32MaxOk Bool checkInt32MaxCall
branch if condition int32MaxOk target int32MaxHolds
branch else target smokeAssertionFailed
label int32MaxHolds

storage module immutable eightBits Int64 8
call checkCharBitCall math.equalInt64
argument checkCharBitCall left Int64 bitCountPerByte
argument checkCharBitCall right Int64 eightBits
run checkCharBitCall
bind value charBitOk Bool checkCharBitCall
branch if condition charBitOk target charBitHolds
branch else target smokeAssertionFailed
label charBitHolds

storage module immutable successMessageText String "OK"
call writeSuccessLineCall console.writeLine
argument writeSuccessLineCall text String successMessageText
run writeSuccessLineCall
ignore void source writeSuccessLineCall
bind error consoleWriteResultError Int32 writeSuccessLineCall
branch error source writeSuccessLineCall target consoleWriteFailedHandler
storage module immutable exitOkCode ExitCode 0
return ok exitOkCode

# Failure leg: surface the raw negative Int32 from
# console.writeLine as the cause attached to the typed
# MainError.ConsoleWriteFailed variant.
label consoleWriteFailedHandler
makeError consoleWriteFailedFailure MainError.ConsoleWriteFailed consoleWriteResultError
return error consoleWriteFailedFailure
label smokeAssertionFailed
makeError limitsSmokeFailure MainError.LimitsSmokeAssertionFailed
return error limitsSmokeFailure
