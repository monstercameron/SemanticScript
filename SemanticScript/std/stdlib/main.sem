call detectExponentNegativeCall math.lessThanInt64
argument detectExponentNegativeCall left Int64 exponentValue
argument detectExponentNegativeCall right Int64 integerZeroBoundary
run detectExponentNegativeCall
bind value exponentIsNegative Bool detectExponentNegativeCall
branch if condition exponentIsNegative target raiseNegativeExponentError
memory powerSignedInt64 mutable powerProduct Int64 1
memory powerSignedInt64 mutable powerCounter Int64 0
