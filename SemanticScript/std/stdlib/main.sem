# SemanticScript standard-library canonical module: standard.stdlib.

# rationale: Canonical standard-library module for stdlib-style helpers.
# invariant: The standard module entry is this file; tests live beside it as `main.test.sem`.
module standard.stdlib
purpose module standard.stdlib "Canonical standard-library module for stdlib-style helpers."
moduleOwns standard.stdlib "The official import path `standard.stdlib` and this module's implementation body."
moduleDoesNotOwn standard.stdlib "App-specific wrappers, compatibility aliases, or generated build artifacts."
invariant module standard.stdlib "The standard module entry is this file; tests live beside it as `main.test.sem`."

exportConstant standard.stdlib stdlibModuleVersionText
storage module immutable stdlibModuleVersionText String "standard.stdlib 0.1"

exportOperation standard.stdlib parseDecimalCStringToSignedInt64

# Canonical standard-library implementation body.
# ============================================================
# SEMANTICSCRIPT STANDARD LIBRARY: <stdlib.h>-style numeric utilities
# ============================================================
#
# rationale: small numeric helpers (parsing, abs, min/max, integer
#   power, gcd, clamp). The refined surface returns natural values
#   (Int64 / Bool) and reserves a `NumericParseError` /
#   `NumericArithmeticError` domain for the operations that actually
#   have failure cases - negative exponents on integer power, and
#   degenerate-input gcd. Most ops are total.
#
# invariant: parsers walk the input byte-by-byte and stop at the
#   first non-matching byte; empty / junk inputs return 0 from the
#   parsers. abs / min / max / clamp are total.
#
# security: pure value-level computation; no allocation; no I/O.
#
# timing: parsers are O(byteLength); abs / min / max / clamp are
#   O(1); power is O(exponent); gcd is O(log min(|a|, |b|)).

# Pure-module file: smoke + extended tests live in
# std/stdlib/main.test.sem.

# Typed error domain for stdlib arithmetic failures. gcd(0, 0) is
# defined to return 0 by mathematical convention (see the operation
# invariant), so no error variant is needed for that case.
error NumericArithmeticError
errorCase NumericArithmeticError NegativeExponentNotSupported

