call detectPowerDoneCall math.greaterThanOrEqualInt64
argument detectPowerDoneCall left Int64 powerCounter
argument detectPowerDoneCall right Int64 exponentValue
run detectPowerDoneCall
bind value powerLoopDone Bool detectPowerDoneCall
branch if condition powerLoopDone target returnPowerProduct
call multiplyPowerProductByBaseCall math.multiplyInt64
argument multiplyPowerProductByBaseCall left Int64 powerProduct
argument multiplyPowerProductByBaseCall right Int64 baseValue
run multiplyPowerProductByBaseCall
bind value nextPowerProduct Int64 multiplyPowerProductByBaseCall
set memory powerProduct nextPowerProduct
