argument computeGcdRemainderCall left I64 gcdDividend
argument computeGcdRemainderCall right I64 gcdDivisor
run computeGcdRemainderCall
bind value gcdRemainder I64 computeGcdRemainderCall
set memory gcdDividend gcdDivisor
set memory gcdDivisor gcdRemainder
jump target gcdEuclidLoop
label returnGcd
return value gcdDividend

