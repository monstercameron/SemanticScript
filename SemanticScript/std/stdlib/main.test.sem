# ============================================================
# SEMANTICSCRIPT STDLIB TESTS: stdlib
# ============================================================
#
# Companion smoke + extended unit tests for std/stdlib/main.sem.
# Imports the stdlib module and asserts every exported numeric
# helper (parseDecimal / parseHex / abs / min / max / power / gcd /
# clamp) plus boundary cases.
#
# Pattern: std/main.sem ships pure-module operations only;
# std/main.test.sem carries every smoke / unit test for it.

project StdStdlibTest
target console
runtime AgentRuntime 0.1
entry console main

import stdlib standard.stdlib
error MainError
errorCase MainError StdlibSmokeAssertionFailed
errorCase MainError ConsoleWriteFailed

# section capability
# rationale: smoke-test main writes a single OK line to stdout.
capability stdoutWriteCapability console.stdout write

# ============================================================
# Smoke test
# ============================================================

operation main
input operation main console Console
output operation main Result ExitCode MainError
useCapability main stdoutWriteCapability
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Smoke-test the stdlib numeric ops."

label startMain

# parseDecimalCStringToSignedInt64("12345") == 12345
storage module immutable decimalSampleText CNullTerminatedByteString "12345"
storage module immutable expectedDecimalSample CSignedInt64 12345
call assertParseDecimalCall parseDecimalCStringToSignedInt64
argument assertParseDecimalCall inputText CNullTerminatedByteString decimalSampleText
run assertParseDecimalCall
bind value decimalParseResult CSignedInt64 assertParseDecimalCall
call checkParseDecimalCall math.equalI64
argument checkParseDecimalCall left I64 decimalParseResult
argument checkParseDecimalCall right I64 expectedDecimalSample
run checkParseDecimalCall
bind value parseDecimalOk Bool checkParseDecimalCall
branch if condition parseDecimalOk target parseDecimalHolds
branch else target smokeAssertionFailed
label parseDecimalHolds

# parseDecimalCStringToSignedInt64("  -42") == -42
storage module immutable decimalNegativeSampleText CNullTerminatedByteString "  -42"
storage module immutable expectedDecimalNegativeSample CSignedInt64 -42
call assertParseDecimalNegativeCall parseDecimalCStringToSignedInt64
argument assertParseDecimalNegativeCall inputText CNullTerminatedByteString decimalNegativeSampleText
run assertParseDecimalNegativeCall
bind value decimalNegativeParseResult CSignedInt64 assertParseDecimalNegativeCall
call checkParseDecimalNegativeCall math.equalI64
argument checkParseDecimalNegativeCall left I64 decimalNegativeParseResult
argument checkParseDecimalNegativeCall right I64 expectedDecimalNegativeSample
run checkParseDecimalNegativeCall
bind value parseDecimalNegativeOk Bool checkParseDecimalNegativeCall
branch if condition parseDecimalNegativeOk target parseDecimalNegativeHolds
branch else target smokeAssertionFailed
label parseDecimalNegativeHolds

# parseHexCStringToSignedInt64("0x1F") == 31
storage module immutable hexSampleText CNullTerminatedByteString "0x1F"
storage module immutable expectedHexSample CSignedInt64 31
call assertParseHexCall parseHexCStringToSignedInt64
argument assertParseHexCall inputText CNullTerminatedByteString hexSampleText
run assertParseHexCall
bind value hexParseResult CSignedInt64 assertParseHexCall
call checkParseHexCall math.equalI64
argument checkParseHexCall left I64 hexParseResult
argument checkParseHexCall right I64 expectedHexSample
run checkParseHexCall
bind value parseHexOk Bool checkParseHexCall
branch if condition parseHexOk target parseHexHolds
branch else target smokeAssertionFailed
label parseHexHolds

# absoluteSignedInt64(-99) == 99
storage module immutable negativeNinetyNine CSignedInt64 -99
storage module immutable ninetyNine CSignedInt64 99
call assertAbsoluteCall absoluteSignedInt64
argument assertAbsoluteCall inputValue CSignedInt64 negativeNinetyNine
run assertAbsoluteCall
bind value absoluteResult CSignedInt64 assertAbsoluteCall
call checkAbsoluteCall math.equalI64
argument checkAbsoluteCall left I64 absoluteResult
argument checkAbsoluteCall right I64 ninetyNine
run checkAbsoluteCall
bind value absoluteOk Bool checkAbsoluteCall
branch if condition absoluteOk target absoluteHolds
branch else target smokeAssertionFailed
label absoluteHolds

# minimumSignedInt64(7, 3) == 3
storage module immutable sevenInt CSignedInt64 7
storage module immutable threeInt CSignedInt64 3
call assertMinimumCall minimumSignedInt64
argument assertMinimumCall leftValue CSignedInt64 sevenInt
argument assertMinimumCall rightValue CSignedInt64 threeInt
run assertMinimumCall
bind value minimumResult CSignedInt64 assertMinimumCall
call checkMinimumCall math.equalI64
argument checkMinimumCall left I64 minimumResult
argument checkMinimumCall right I64 threeInt
run checkMinimumCall
bind value minimumOk Bool checkMinimumCall
branch if condition minimumOk target minimumHolds
branch else target smokeAssertionFailed
label minimumHolds

# maximumSignedInt64(7, 3) == 7
call assertMaximumCall maximumSignedInt64
argument assertMaximumCall leftValue CSignedInt64 sevenInt
argument assertMaximumCall rightValue CSignedInt64 threeInt
run assertMaximumCall
bind value maximumResult CSignedInt64 assertMaximumCall
call checkMaximumCall math.equalI64
argument checkMaximumCall left I64 maximumResult
argument checkMaximumCall right I64 sevenInt
run checkMaximumCall
bind value maximumOk Bool checkMaximumCall
branch if condition maximumOk target maximumHolds
branch else target smokeAssertionFailed
label maximumHolds

# powerSignedInt64(2, 10) == 1024
storage module immutable twoBaseValue CSignedInt64 2
storage module immutable tenExponentValue CSignedInt64 10
storage module immutable expectedTenTwentyFour CSignedInt64 1024
call assertPowerCall powerSignedInt64
argument assertPowerCall baseValue CSignedInt64 twoBaseValue
argument assertPowerCall exponentValue CSignedInt64 tenExponentValue
run assertPowerCall
bind ok powerResult CSignedInt64 assertPowerCall
call checkPowerCall math.equalI64
argument checkPowerCall left I64 powerResult
argument checkPowerCall right I64 expectedTenTwentyFour
run checkPowerCall
bind value powerOk Bool checkPowerCall
branch if condition powerOk target powerHolds
branch else target smokeAssertionFailed
label powerHolds

# greatestCommonDivisorSignedInt64(54, 24) == 6
storage module immutable fiftyFourValue CSignedInt64 54
storage module immutable twentyFourValue CSignedInt64 24
storage module immutable expectedGcdSix CSignedInt64 6
call assertGcdCall greatestCommonDivisorSignedInt64
argument assertGcdCall leftValue CSignedInt64 fiftyFourValue
argument assertGcdCall rightValue CSignedInt64 twentyFourValue
run assertGcdCall
bind value gcdResult CSignedInt64 assertGcdCall
call checkGcdCall math.equalI64
argument checkGcdCall left I64 gcdResult
argument checkGcdCall right I64 expectedGcdSix
run checkGcdCall
bind value gcdOk Bool checkGcdCall
branch if condition gcdOk target gcdHolds
branch else target smokeAssertionFailed
label gcdHolds

# clampSignedInt64ToInclusiveRange(50, 0, 10) == 10
storage module immutable fiftyValueForClamp CSignedInt64 50
storage module immutable zeroLowerBoundForClamp CSignedInt64 0
storage module immutable tenUpperBoundForClamp CSignedInt64 10
call assertClampCall clampSignedInt64ToInclusiveRange
argument assertClampCall inputValue CSignedInt64 fiftyValueForClamp
argument assertClampCall lowerBound CSignedInt64 zeroLowerBoundForClamp
argument assertClampCall upperBound CSignedInt64 tenUpperBoundForClamp
run assertClampCall
bind value clampResult CSignedInt64 assertClampCall
call checkClampCall math.equalI64
argument checkClampCall left I64 clampResult
argument checkClampCall right I64 tenUpperBoundForClamp
run checkClampCall
bind value clampOk Bool checkClampCall
branch if condition clampOk target clampHolds
branch else target smokeAssertionFailed
label clampHolds

# ============================================================
# Extended unit tests: boundary cases for each existing op.
# ============================================================

storage module immutable zeroSignedSm CSignedInt64 0
storage module immutable oneSignedSm CSignedInt64 1
storage module immutable negFiveSignedSm CSignedInt64 -5
storage module immutable fiveSignedSm CSignedInt64 5
storage module immutable zeroStr CNullTerminatedByteString "0"
storage module immutable hexZeroStr CNullTerminatedByteString "0x0"
storage module immutable oneHundredSm CSignedInt64 100

# parseDecimal("0") == 0
call parseZeroCall parseDecimalCStringToSignedInt64
argument parseZeroCall inputText CNullTerminatedByteString zeroStr
run parseZeroCall
bind value parseZeroResult CSignedInt64 parseZeroCall
call checkParseZeroCall math.equalI64
argument checkParseZeroCall left I64 parseZeroResult
argument checkParseZeroCall right I64 zeroSignedSm
run checkParseZeroCall
bind value parseZeroOk Bool checkParseZeroCall
branch if condition parseZeroOk target parseZeroHolds
branch else target smokeAssertionFailed
label parseZeroHolds

# parseHex("0x0") == 0
call parseHexZeroCall parseHexCStringToSignedInt64
argument parseHexZeroCall inputText CNullTerminatedByteString hexZeroStr
run parseHexZeroCall
bind value parseHexZeroResult CSignedInt64 parseHexZeroCall
call checkParseHexZeroCall math.equalI64
argument checkParseHexZeroCall left I64 parseHexZeroResult
argument checkParseHexZeroCall right I64 zeroSignedSm
run checkParseHexZeroCall
bind value parseHexZeroOk Bool checkParseHexZeroCall
branch if condition parseHexZeroOk target parseHexZeroHolds
branch else target smokeAssertionFailed
label parseHexZeroHolds

# absoluteSignedInt64(0) == 0
call absZeroCall absoluteSignedInt64
argument absZeroCall inputValue CSignedInt64 zeroSignedSm
run absZeroCall
bind value absZeroResult CSignedInt64 absZeroCall
call checkAbsZeroCall math.equalI64
argument checkAbsZeroCall left I64 absZeroResult
argument checkAbsZeroCall right I64 zeroSignedSm
run checkAbsZeroCall
bind value absZeroOk Bool checkAbsZeroCall
branch if condition absZeroOk target absZeroHolds
branch else target smokeAssertionFailed
label absZeroHolds

# absoluteSignedInt64(99) == 99 (positive identity)
call absPositiveCall absoluteSignedInt64
argument absPositiveCall inputValue CSignedInt64 ninetyNine
run absPositiveCall
bind value absPositiveResult CSignedInt64 absPositiveCall
call checkAbsPositiveCall math.equalI64
argument checkAbsPositiveCall left I64 absPositiveResult
argument checkAbsPositiveCall right I64 ninetyNine
run checkAbsPositiveCall
bind value absPositiveOk Bool checkAbsPositiveCall
branch if condition absPositiveOk target absPositiveHolds
branch else target smokeAssertionFailed
label absPositiveHolds

# minimum(5, 5) == 5 (reflexive)
call minSameCall minimumSignedInt64
argument minSameCall leftValue CSignedInt64 fiveSignedSm
argument minSameCall rightValue CSignedInt64 fiveSignedSm
run minSameCall
bind value minSameResult CSignedInt64 minSameCall
call checkMinSameCall math.equalI64
argument checkMinSameCall left I64 minSameResult
argument checkMinSameCall right I64 fiveSignedSm
run checkMinSameCall
bind value minSameOk Bool checkMinSameCall
branch if condition minSameOk target minSameHolds
branch else target smokeAssertionFailed
label minSameHolds

# maximum(-5, 5) == 5 (negative vs positive)
call maxSignCall maximumSignedInt64
argument maxSignCall leftValue CSignedInt64 negFiveSignedSm
argument maxSignCall rightValue CSignedInt64 fiveSignedSm
run maxSignCall
bind value maxSignResult CSignedInt64 maxSignCall
call checkMaxSignCall math.equalI64
argument checkMaxSignCall left I64 maxSignResult
argument checkMaxSignCall right I64 fiveSignedSm
run checkMaxSignCall
bind value maxSignOk Bool checkMaxSignCall
branch if condition maxSignOk target maxSignHolds
branch else target smokeAssertionFailed
label maxSignHolds

# power(2, 0) == 1 (zero exponent)
call powZeroExpCall powerSignedInt64
argument powZeroExpCall baseValue CSignedInt64 twoBaseValue
argument powZeroExpCall exponentValue CSignedInt64 zeroSignedSm
run powZeroExpCall
bind ok powZeroExpResult CSignedInt64 powZeroExpCall
call checkPowZeroExpCall math.equalI64
argument checkPowZeroExpCall left I64 powZeroExpResult
argument checkPowZeroExpCall right I64 oneSignedSm
run checkPowZeroExpCall
bind value powZeroExpOk Bool checkPowZeroExpCall
branch if condition powZeroExpOk target powZeroExpHolds
branch else target smokeAssertionFailed
label powZeroExpHolds

# power(1, 100) == 1 (one to any power)
call powOneBaseCall powerSignedInt64
argument powOneBaseCall baseValue CSignedInt64 oneSignedSm
argument powOneBaseCall exponentValue CSignedInt64 oneHundredSm
run powOneBaseCall
bind ok powOneBaseResult CSignedInt64 powOneBaseCall
call checkPowOneBaseCall math.equalI64
argument checkPowOneBaseCall left I64 powOneBaseResult
argument checkPowOneBaseCall right I64 oneSignedSm
run checkPowOneBaseCall
bind value powOneBaseOk Bool checkPowOneBaseCall
branch if condition powOneBaseOk target powOneBaseHolds
branch else target smokeAssertionFailed
label powOneBaseHolds

# gcd(7, 5) == 1 (coprime)
call gcdCoprimeCall greatestCommonDivisorSignedInt64
argument gcdCoprimeCall leftValue CSignedInt64 sevenInt
argument gcdCoprimeCall rightValue CSignedInt64 fiveSignedSm
run gcdCoprimeCall
bind value gcdCoprimeResult CSignedInt64 gcdCoprimeCall
call checkGcdCoprimeCall math.equalI64
argument checkGcdCoprimeCall left I64 gcdCoprimeResult
argument checkGcdCoprimeCall right I64 oneSignedSm
run checkGcdCoprimeCall
bind value gcdCoprimeOk Bool checkGcdCoprimeCall
branch if condition gcdCoprimeOk target gcdCoprimeHolds
branch else target smokeAssertionFailed
label gcdCoprimeHolds

# clamp(5, 0, 10) == 5 (already in range)
call clampInRangeCall clampSignedInt64ToInclusiveRange
argument clampInRangeCall inputValue CSignedInt64 fiveSignedSm
argument clampInRangeCall lowerBound CSignedInt64 zeroLowerBoundForClamp
argument clampInRangeCall upperBound CSignedInt64 tenUpperBoundForClamp
run clampInRangeCall
bind value clampInRangeResult CSignedInt64 clampInRangeCall
call checkClampInRangeCall math.equalI64
argument checkClampInRangeCall left I64 clampInRangeResult
argument checkClampInRangeCall right I64 fiveSignedSm
run checkClampInRangeCall
bind value clampInRangeOk Bool checkClampInRangeCall
branch if condition clampInRangeOk target clampInRangeHolds
branch else target smokeAssertionFailed
label clampInRangeHolds

# clamp(-5, 0, 10) == 0 (clamped to lower bound)
call clampBelowCall clampSignedInt64ToInclusiveRange
argument clampBelowCall inputValue CSignedInt64 negFiveSignedSm
argument clampBelowCall lowerBound CSignedInt64 zeroLowerBoundForClamp
argument clampBelowCall upperBound CSignedInt64 tenUpperBoundForClamp
run clampBelowCall
bind value clampBelowResult CSignedInt64 clampBelowCall
call checkClampBelowCall math.equalI64
argument checkClampBelowCall left I64 clampBelowResult
argument checkClampBelowCall right I64 zeroLowerBoundForClamp
run checkClampBelowCall
bind value clampBelowOk Bool checkClampBelowCall
branch if condition clampBelowOk target clampBelowHolds
branch else target smokeAssertionFailed
label clampBelowHolds

storage module immutable successMessageText CNullTerminatedByteString "OK"
call writeSuccessLineCall console.writeLine
argument writeSuccessLineCall console Console console
argument writeSuccessLineCall text CNullTerminatedByteString successMessageText
run writeSuccessLineCall
ignore ok source writeSuccessLineCall type CSignedInt32
bind error consoleWriteResultError CSignedInt32 writeSuccessLineCall
branch error source writeSuccessLineCall target consoleWriteFailedHandler
storage module immutable exitOkCode ExitCode 0
return ok exitOkCode

# Failure leg: surface the raw negative CSignedInt32 from
# console.writeLine as the cause attached to the typed
# MainError.ConsoleWriteFailed variant.
label consoleWriteFailedHandler
makeError consoleWriteFailedFailure MainError.ConsoleWriteFailed consoleWriteResultError
return error consoleWriteFailedFailure
label smokeAssertionFailed
makeError stdlibSmokeFailure MainError.StdlibSmokeAssertionFailed
return error stdlibSmokeFailure
