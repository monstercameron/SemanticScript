# ============================================================
# SEMANTICSCRIPT STDLIB TESTS: stdlib
# ============================================================
#
# Companion smoke + extended unit tests for std/stdlib/main.sem.
# Imports the stdlib module and asserts every exported numeric
# helper (parseDecimal / parseHex / abs / min / max / power / gcd /
# clamp) plus boundary cases.
#
# Pattern: std/main.sem ships pure-module operations only;
# std/main.test.sem carries every smoke / unit test for it.

project StdStdlibTest
target console
runtime AgentRuntime 0.1
entry console main

import stdlib standard.stdlib
error MainError
errorCase MainError StdlibSmokeAssertionFailed
errorCase MainError ConsoleWriteFailed

# section capability
# rationale: smoke-test main writes a single OK line to stdout.
capability stdoutWriteCapability console.stdout write

# ============================================================
# Smoke test
# ============================================================

operation main
input operation main console Console
output operation main Result ExitCode MainError
useCapability main stdoutWriteCapability
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Smoke-test the stdlib numeric ops."

label startMain

# parseDecimalCStringToSignedInt64("12345") == 12345
storage module immutable decimalSampleText String "12345"
storage module immutable expectedDecimalSample Int64 12345
call assertParseDecimalCall parseDecimalCStringToSignedInt64
argument assertParseDecimalCall inputText String decimalSampleText
run assertParseDecimalCall
bind value decimalParseResult Int64 assertParseDecimalCall
call checkParseDecimalCall math.equalInt64
argument checkParseDecimalCall left Int64 decimalParseResult
argument checkParseDecimalCall right Int64 expectedDecimalSample
run checkParseDecimalCall
bind value parseDecimalOk Bool checkParseDecimalCall
branch if condition parseDecimalOk target parseDecimalHolds
branch else target smokeAssertionFailed
label parseDecimalHolds

# parseDecimalCStringToSignedInt64("  -42") == -42
storage module immutable decimalNegativeSampleText String "  -42"
storage module immutable expectedDecimalNegativeSample Int64 -42
call assertParseDecimalNegativeCall parseDecimalCStringToSignedInt64
argument assertParseDecimalNegativeCall inputText String decimalNegativeSampleText
run assertParseDecimalNegativeCall
bind value decimalNegativeParseResult Int64 assertParseDecimalNegativeCall
call checkParseDecimalNegativeCall math.equalInt64
argument checkParseDecimalNegativeCall left Int64 decimalNegativeParseResult
argument checkParseDecimalNegativeCall right Int64 expectedDecimalNegativeSample
run checkParseDecimalNegativeCall
bind value parseDecimalNegativeOk Bool checkParseDecimalNegativeCall
branch if condition parseDecimalNegativeOk target parseDecimalNegativeHolds
branch else target smokeAssertionFailed
label parseDecimalNegativeHolds

# parseHexCStringToSignedInt64("0x1F") == 31
storage module immutable hexSampleText String "0x1F"
storage module immutable expectedHexSample Int64 31
call assertParseHexCall parseHexCStringToSignedInt64
argument assertParseHexCall inputText String hexSampleText
run assertParseHexCall
bind value hexParseResult Int64 assertParseHexCall
call checkParseHexCall math.equalInt64
argument checkParseHexCall left Int64 hexParseResult
argument checkParseHexCall right Int64 expectedHexSample
run checkParseHexCall
bind value parseHexOk Bool checkParseHexCall
branch if condition parseHexOk target parseHexHolds
branch else target smokeAssertionFailed
label parseHexHolds

# absoluteSignedInt64(-99) == 99
storage module immutable negativeNinetyNine Int64 -99
storage module immutable ninetyNine Int64 99
call assertAbsoluteCall absoluteSignedInt64
argument assertAbsoluteCall inputValue Int64 negativeNinetyNine
run assertAbsoluteCall
bind value absoluteResult Int64 assertAbsoluteCall
call checkAbsoluteCall math.equalInt64
argument checkAbsoluteCall left Int64 absoluteResult
argument checkAbsoluteCall right Int64 ninetyNine
run checkAbsoluteCall
bind value absoluteOk Bool checkAbsoluteCall
branch if condition absoluteOk target absoluteHolds
branch else target smokeAssertionFailed
label absoluteHolds

# minimumSignedInt64(7, 3) == 3
storage module immutable sevenInt Int64 7
storage module immutable threeInt Int64 3
call assertMinimumCall minimumSignedInt64
argument assertMinimumCall leftValue Int64 sevenInt
argument assertMinimumCall rightValue Int64 threeInt
run assertMinimumCall
bind value minimumResult Int64 assertMinimumCall
call checkMinimumCall math.equalInt64
argument checkMinimumCall left Int64 minimumResult
argument checkMinimumCall right Int64 threeInt
run checkMinimumCall
bind value minimumOk Bool checkMinimumCall
branch if condition minimumOk target minimumHolds
branch else target smokeAssertionFailed
label minimumHolds

# maximumSignedInt64(7, 3) == 7
call assertMaximumCall maximumSignedInt64
argument assertMaximumCall leftValue Int64 sevenInt
argument assertMaximumCall rightValue Int64 threeInt
run assertMaximumCall
bind value maximumResult Int64 assertMaximumCall
call checkMaximumCall math.equalInt64
argument checkMaximumCall left Int64 maximumResult
argument checkMaximumCall right Int64 sevenInt
run checkMaximumCall
bind value maximumOk Bool checkMaximumCall
branch if condition maximumOk target maximumHolds
branch else target smokeAssertionFailed
label maximumHolds

# powerSignedInt64(2, 10) == 1024
storage module immutable twoBaseValue Int64 2
storage module immutable tenExponentValue Int64 10
storage module immutable expectedTenTwentyFour Int64 1024
call assertPowerCall powerSignedInt64
argument assertPowerCall baseValue Int64 twoBaseValue
argument assertPowerCall exponentValue Int64 tenExponentValue
run assertPowerCall
bind ok powerResult Int64 assertPowerCall
call checkPowerCall math.equalInt64
argument checkPowerCall left Int64 powerResult
argument checkPowerCall right Int64 expectedTenTwentyFour
run checkPowerCall
bind value powerOk Bool checkPowerCall
branch if condition powerOk target powerHolds
branch else target smokeAssertionFailed
label powerHolds

# greatestCommonDivisorSignedInt64(54, 24) == 6
storage module immutable fiftyFourValue Int64 54
storage module immutable twentyFourValue Int64 24
storage module immutable expectedGcdSix Int64 6
call assertGcdCall greatestCommonDivisorSignedInt64
argument assertGcdCall leftValue Int64 fiftyFourValue
argument assertGcdCall rightValue Int64 twentyFourValue
run assertGcdCall
bind value gcdResult Int64 assertGcdCall
call checkGcdCall math.equalInt64
argument checkGcdCall left Int64 gcdResult
argument checkGcdCall right Int64 expectedGcdSix
run checkGcdCall
bind value gcdOk Bool checkGcdCall
branch if condition gcdOk target gcdHolds
branch else target smokeAssertionFailed
label gcdHolds

# clampSignedInt64ToInclusiveRange(50, 0, 10) == 10
storage module immutable fiftyValueForClamp Int64 50
storage module immutable zeroLowerBoundForClamp Int64 0
storage module immutable tenUpperBoundForClamp Int64 10
call assertClampCall clampSignedInt64ToInclusiveRange
argument assertClampCall inputValue Int64 fiftyValueForClamp
argument assertClampCall lowerBound Int64 zeroLowerBoundForClamp
argument assertClampCall upperBound Int64 tenUpperBoundForClamp
run assertClampCall
bind value clampResult Int64 assertClampCall
call checkClampCall math.equalInt64
argument checkClampCall left Int64 clampResult
argument checkClampCall right Int64 tenUpperBoundForClamp
run checkClampCall
bind value clampOk Bool checkClampCall
branch if condition clampOk target clampHolds
branch else target smokeAssertionFailed
label clampHolds

# ============================================================
# Extended unit tests: boundary cases for each existing op.
# ============================================================

storage module immutable zeroSignedSm Int64 0
storage module immutable oneSignedSm Int64 1
storage module immutable negFiveSignedSm Int64 -5
storage module immutable fiveSignedSm Int64 5
storage module immutable zeroStr String "0"
storage module immutable hexZeroStr String "0x0"
storage module immutable oneHundredSm Int64 100

# parseDecimal("0") == 0
call parseZeroCall parseDecimalCStringToSignedInt64
argument parseZeroCall inputText String zeroStr
run parseZeroCall
bind value parseZeroResult Int64 parseZeroCall
call checkParseZeroCall math.equalInt64
argument checkParseZeroCall left Int64 parseZeroResult
argument checkParseZeroCall right Int64 zeroSignedSm
run checkParseZeroCall
bind value parseZeroOk Bool checkParseZeroCall
branch if condition parseZeroOk target parseZeroHolds
branch else target smokeAssertionFailed
label parseZeroHolds

# parseHex("0x0") == 0
call parseHexZeroCall parseHexCStringToSignedInt64
argument parseHexZeroCall inputText String hexZeroStr
run parseHexZeroCall
bind value parseHexZeroResult Int64 parseHexZeroCall
call checkParseHexZeroCall math.equalInt64
argument checkParseHexZeroCall left Int64 parseHexZeroResult
argument checkParseHexZeroCall right Int64 zeroSignedSm
run checkParseHexZeroCall
bind value parseHexZeroOk Bool checkParseHexZeroCall
branch if condition parseHexZeroOk target parseHexZeroHolds
branch else target smokeAssertionFailed
label parseHexZeroHolds

# absoluteSignedInt64(0) == 0
call absZeroCall absoluteSignedInt64
argument absZeroCall inputValue Int64 zeroSignedSm
run absZeroCall
bind value absZeroResult Int64 absZeroCall
call checkAbsZeroCall math.equalInt64
argument checkAbsZeroCall left Int64 absZeroResult
argument checkAbsZeroCall right Int64 zeroSignedSm
run checkAbsZeroCall
bind value absZeroOk Bool checkAbsZeroCall
branch if condition absZeroOk target absZeroHolds
branch else target smokeAssertionFailed
label absZeroHolds

# absoluteSignedInt64(99) == 99 (positive identity)
call absPositiveCall absoluteSignedInt64
argument absPositiveCall inputValue Int64 ninetyNine
run absPositiveCall
bind value absPositiveResult Int64 absPositiveCall
call checkAbsPositiveCall math.equalInt64
argument checkAbsPositiveCall left Int64 absPositiveResult
argument checkAbsPositiveCall right Int64 ninetyNine
run checkAbsPositiveCall
bind value absPositiveOk Bool checkAbsPositiveCall
branch if condition absPositiveOk target absPositiveHolds
branch else target smokeAssertionFailed
label absPositiveHolds

# minimum(5, 5) == 5 (reflexive)
call minSameCall minimumSignedInt64
argument minSameCall leftValue Int64 fiveSignedSm
argument minSameCall rightValue Int64 fiveSignedSm
run minSameCall
bind value minSameResult Int64 minSameCall
call checkMinSameCall math.equalInt64
argument checkMinSameCall left Int64 minSameResult
argument checkMinSameCall right Int64 fiveSignedSm
run checkMinSameCall
bind value minSameOk Bool checkMinSameCall
branch if condition minSameOk target minSameHolds
branch else target smokeAssertionFailed
label minSameHolds

# maximum(-5, 5) == 5 (negative vs positive)
call maxSignCall maximumSignedInt64
argument maxSignCall leftValue Int64 negFiveSignedSm
argument maxSignCall rightValue Int64 fiveSignedSm
run maxSignCall
bind value maxSignResult Int64 maxSignCall
call checkMaxSignCall math.equalInt64
argument checkMaxSignCall left Int64 maxSignResult
argument checkMaxSignCall right Int64 fiveSignedSm
run checkMaxSignCall
bind value maxSignOk Bool checkMaxSignCall
branch if condition maxSignOk target maxSignHolds
branch else target smokeAssertionFailed
label maxSignHolds

# power(2, 0) == 1 (zero exponent)
call powZeroExpCall powerSignedInt64
argument powZeroExpCall baseValue Int64 twoBaseValue
argument powZeroExpCall exponentValue Int64 zeroSignedSm
run powZeroExpCall
bind ok powZeroExpResult Int64 powZeroExpCall
call checkPowZeroExpCall math.equalInt64
argument checkPowZeroExpCall left Int64 powZeroExpResult
argument checkPowZeroExpCall right Int64 oneSignedSm
run checkPowZeroExpCall
bind value powZeroExpOk Bool checkPowZeroExpCall
branch if condition powZeroExpOk target powZeroExpHolds
branch else target smokeAssertionFailed
label powZeroExpHolds

# power(1, 100) == 1 (one to any power)
call powOneBaseCall powerSignedInt64
argument powOneBaseCall baseValue Int64 oneSignedSm
argument powOneBaseCall exponentValue Int64 oneHundredSm
run powOneBaseCall
bind ok powOneBaseResult Int64 powOneBaseCall
call checkPowOneBaseCall math.equalInt64
argument checkPowOneBaseCall left Int64 powOneBaseResult
argument checkPowOneBaseCall right Int64 oneSignedSm
run checkPowOneBaseCall
bind value powOneBaseOk Bool checkPowOneBaseCall
branch if condition powOneBaseOk target powOneBaseHolds
branch else target smokeAssertionFailed
label powOneBaseHolds

# gcd(7, 5) == 1 (coprime)
call gcdCoprimeCall greatestCommonDivisorSignedInt64
argument gcdCoprimeCall leftValue Int64 sevenInt
argument gcdCoprimeCall rightValue Int64 fiveSignedSm
run gcdCoprimeCall
bind value gcdCoprimeResult Int64 gcdCoprimeCall
call checkGcdCoprimeCall math.equalInt64
argument checkGcdCoprimeCall left Int64 gcdCoprimeResult
argument checkGcdCoprimeCall right Int64 oneSignedSm
run checkGcdCoprimeCall
bind value gcdCoprimeOk Bool checkGcdCoprimeCall
branch if condition gcdCoprimeOk target gcdCoprimeHolds
branch else target smokeAssertionFailed
label gcdCoprimeHolds

# clamp(5, 0, 10) == 5 (already in range)
call clampInRangeCall clampSignedInt64ToInclusiveRange
argument clampInRangeCall inputValue Int64 fiveSignedSm
argument clampInRangeCall lowerBound Int64 zeroLowerBoundForClamp
argument clampInRangeCall upperBound Int64 tenUpperBoundForClamp
run clampInRangeCall
bind value clampInRangeResult Int64 clampInRangeCall
call checkClampInRangeCall math.equalInt64
argument checkClampInRangeCall left Int64 clampInRangeResult
argument checkClampInRangeCall right Int64 fiveSignedSm
run checkClampInRangeCall
bind value clampInRangeOk Bool checkClampInRangeCall
branch if condition clampInRangeOk target clampInRangeHolds
branch else target smokeAssertionFailed
label clampInRangeHolds

# clamp(-5, 0, 10) == 0 (clamped to lower bound)
call clampBelowCall clampSignedInt64ToInclusiveRange
argument clampBelowCall inputValue Int64 negFiveSignedSm
argument clampBelowCall lowerBound Int64 zeroLowerBoundForClamp
argument clampBelowCall upperBound Int64 tenUpperBoundForClamp
run clampBelowCall
bind value clampBelowResult Int64 clampBelowCall
call checkClampBelowCall math.equalInt64
argument checkClampBelowCall left Int64 clampBelowResult
argument checkClampBelowCall right Int64 zeroLowerBoundForClamp
run checkClampBelowCall
bind value clampBelowOk Bool checkClampBelowCall
branch if condition clampBelowOk target clampBelowHolds
branch else target smokeAssertionFailed
label clampBelowHolds

storage module immutable successMessageText String "OK"
call writeSuccessLineCall console.writeLine
argument writeSuccessLineCall text String successMessageText
run writeSuccessLineCall
ignore void source writeSuccessLineCall
bind error consoleWriteResultError Int32 writeSuccessLineCall
branch error source writeSuccessLineCall target consoleWriteFailedHandler
storage module immutable exitOkCode ExitCode 0
return ok exitOkCode

# Failure leg: surface the raw negative Int32 from
# console.writeLine as the cause attached to the typed
# MainError.ConsoleWriteFailed variant.
label consoleWriteFailedHandler
makeError consoleWriteFailedFailure MainError.ConsoleWriteFailed consoleWriteResultError
return error consoleWriteFailedFailure
label smokeAssertionFailed
makeError stdlibSmokeFailure MainError.StdlibSmokeAssertionFailed
return error stdlibSmokeFailure
