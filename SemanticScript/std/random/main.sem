# Normalize seed: 0 / negative -> 1 (MINSTD zero fixed point).
call detectSeedNeedsNormalizationCall math.lessThanOrEqualInt64
argument detectSeedNeedsNormalizationCall left Int64 randomSeed
argument detectSeedNeedsNormalizationCall right Int64 fallbackSeedValue
run detectSeedNeedsNormalizationCall
bind value seedNeedsNormalization Bool detectSeedNeedsNormalizationCall
# Initialize the working seed to the fallback (1), then overwrite
# with the caller's seed when normalization is NOT required. This
# yields a single set on each path and matches fallbackSeedValue
# without a separate label.
memory createDeterministicRandomState mutable normalizedRandomSeed Int64 1
branch if condition seedNeedsNormalization target encodeRandomStateBytes
set memory normalizedRandomSeed randomSeed
label encodeRandomStateBytes

