# ============================================================
# SEMANTICSCRIPT STANDARD LIBRARY TESTS: extended POSIX errno numbers
# ============================================================
#
# rationale: companion test file for std/errno_more/main.sem.
#   Imports the errno_more module and verifies a representative
#   subset of the extended errno-number constants.
#
# invariant: success prints "OK\n" and exits 0; any failed
#   assertion surfaces MainError.ErrnoMoreSmokeAssertionFailed.
#
# pattern: canonical main.test.sem form — same directory as
#   main.sem, import the module, project block local to the test,
#   entry console main. The implementation file
#   std/errno_more/main.sem carries no smoke main itself.

project StdErrnoMoreTest
target console
runtime AgentRuntime 0.1
entry console main

import errno_more standard.errno_more
error MainError
errorCase MainError ErrnoMoreSmokeAssertionFailed
errorCase MainError ConsoleWriteFailed

# section capability
# rationale: smoke-test main writes a single OK line to stdout.
capability stdoutWriteCapability console.stdout write

# ============================================================
# Smoke test
# ============================================================

operation main
input operation main console Console
output operation main Result ExitCode MainError
useCapability main stdoutWriteCapability
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Verify the extended errno constants."
invariant operation main "EAGAIN == 11, EROFS == 30, ETIMEDOUT == 110."

label startMain

storage module immutable eagainExpected Int32 11
call checkEagainCall math.equalInt64
argument checkEagainCall left Int64 tryAgainErrorNumber
argument checkEagainCall right Int64 eagainExpected
run checkEagainCall
bind value eagainOk Bool checkEagainCall
branch if condition eagainOk target eagainHolds
branch else target smokeAssertionFailed
label eagainHolds

storage module immutable erofsExpected Int32 30
call checkErofsCall math.equalInt64
argument checkErofsCall left Int64 readOnlyFileSystemErrorNumber
argument checkErofsCall right Int64 erofsExpected
run checkErofsCall
bind value erofsOk Bool checkErofsCall
branch if condition erofsOk target erofsHolds
branch else target smokeAssertionFailed
label erofsHolds

storage module immutable successMessageText String "OK"
call writeSuccessLineCall console.writeLine
argument writeSuccessLineCall console Console console
argument writeSuccessLineCall text String successMessageText
run writeSuccessLineCall
ignore ok source writeSuccessLineCall type Int32
bind error consoleWriteResultError Int32 writeSuccessLineCall
branch error source writeSuccessLineCall target consoleWriteFailedHandler
storage module immutable exitOkCode ExitCode 0
return ok exitOkCode

# Failure leg: surface the raw negative Int32 from
# console.writeLine as the cause attached to the typed
# MainError.ConsoleWriteFailed variant.
label consoleWriteFailedHandler
makeError consoleWriteFailedFailure MainError.ConsoleWriteFailed consoleWriteResultError
return error consoleWriteFailedFailure
label smokeAssertionFailed
makeError errnoMoreSmokeFailure MainError.ErrnoMoreSmokeAssertionFailed
return error errnoMoreSmokeFailure
