input operation areBytesSortedAscending byteBuffer String
input operation areBytesSortedAscending byteCount ByteCount
output operation areBytesSortedAscending Bool
memory areBytesSortedAscending heap no
async areBytesSortedAscending no
purpose operation areBytesSortedAscending "Returns true when every adjacent pair satisfies byteBuffer[i] <= byteBuffer[i+1]. Empty and single-element buffers are sorted."
invariant operation areBytesSortedAscending "Short-circuits on the first out-of-order pair; empty / single-element buffers return true."
guarantee areBytesSortedAscending "Total."
label startAreBytesSortedAscending
call detectSingleElementCall math.lessThanOrEqualInt64
argument detectSingleElementCall left Int64 byteCount
argument detectSingleElementCall right Int64 integerOneStepValue
run detectSingleElementCall
bind value hasAtMostOneElement Bool detectSingleElementCall
branch if condition hasAtMostOneElement target returnIsSortedTrue
memory areBytesSortedAscending mutable sortedCheckIndex Int64 0
call computeSortedCheckBoundCall math.subtractInt64
argument computeSortedCheckBoundCall left Int64 byteCount
argument computeSortedCheckBoundCall right Int64 integerOneStepValue
run computeSortedCheckBoundCall
bind value sortedCheckBound Int64 computeSortedCheckBoundCall
label sortedCheckLoop
call detectSortedCheckDoneCall math.greaterThanOrEqualInt64
argument detectSortedCheckDoneCall left Int64 sortedCheckIndex
argument detectSortedCheckDoneCall right Int64 sortedCheckBound
run detectSortedCheckDoneCall
bind value sortedCheckDone Bool detectSortedCheckDoneCall
branch if condition sortedCheckDone target returnIsSortedTrue
call loadSortedLeftCall pointer.loadByte
argument loadSortedLeftCall buffer OpaquePointer byteBuffer
argument loadSortedLeftCall offset ByteCount sortedCheckIndex
run loadSortedLeftCall
bind value sortedLeftRawByte Int8 loadSortedLeftCall
call computeSortedRightIndexCall math.addInt64
argument computeSortedRightIndexCall left Int64 sortedCheckIndex
argument computeSortedRightIndexCall right Int64 integerOneStepValue
run computeSortedRightIndexCall
bind value sortedRightIndex Int64 computeSortedRightIndexCall
call loadSortedRightCall pointer.loadByte
argument loadSortedRightCall buffer OpaquePointer byteBuffer
argument loadSortedRightCall offset ByteCount sortedRightIndex
run loadSortedRightCall
bind value sortedRightRawByte Int8 loadSortedRightCall
call shiftSortedLeftCall math.addInt64
argument shiftSortedLeftCall left Int64 sortedLeftRawByte
argument shiftSortedLeftCall right Int64 byteRoleAdjustmentValue
run shiftSortedLeftCall
bind value shiftedSortedLeft Int64 shiftSortedLeftCall
call normalizeSortedLeftCall math.moduloInt64
argument normalizeSortedLeftCall left Int64 shiftedSortedLeft
argument normalizeSortedLeftCall right Int64 byteRoleAdjustmentValue
run normalizeSortedLeftCall
bind value unsignedSortedLeft Int64 normalizeSortedLeftCall
call shiftSortedRightCall math.addInt64
argument shiftSortedRightCall left Int64 sortedRightRawByte
argument shiftSortedRightCall right Int64 byteRoleAdjustmentValue
run shiftSortedRightCall
bind value shiftedSortedRight Int64 shiftSortedRightCall
call normalizeSortedRightCall math.moduloInt64
argument normalizeSortedRightCall left Int64 shiftedSortedRight
argument normalizeSortedRightCall right Int64 byteRoleAdjustmentValue
run normalizeSortedRightCall
bind value unsignedSortedRight Int64 normalizeSortedRightCall
call detectSortedOutOfOrderCall math.greaterThanInt64
argument detectSortedOutOfOrderCall left Int64 unsignedSortedLeft
argument detectSortedOutOfOrderCall right Int64 unsignedSortedRight
run detectSortedOutOfOrderCall
bind value sortedOutOfOrder Bool detectSortedOutOfOrderCall
branch if condition sortedOutOfOrder target returnIsSortedFalse
call advanceSortedIndexCall math.addInt64
argument advanceSortedIndexCall left Int64 sortedCheckIndex
argument advanceSortedIndexCall right Int64 integerOneStepValue
run advanceSortedIndexCall
bind value nextSortedIndex Int64 advanceSortedIndexCall
set memory sortedCheckIndex nextSortedIndex
jump target sortedCheckLoop
label returnIsSortedTrue
storage module immutable isSortedTrueResult Bool true
return value isSortedTrueResult
label returnIsSortedFalse
storage module immutable isSortedFalseResult Bool false
return value isSortedFalseResult

