# SemanticScript standard-library canonical module: standard.sort.

module standard.sort
purpose module standard.sort "Canonical standard-library module for sort helpers."
moduleOwns standard.sort "The official import path `standard.sort` and this module's implementation body."
moduleDoesNotOwn standard.sort "App-specific wrappers, compatibility aliases, or generated build artifacts."
invariant module standard.sort "The standard module entry is this file; tests live beside it as `main.test.sem`."

exportConstant standard.sort sortModuleVersionText
storage module immutable sortModuleVersionText String "standard.sort 0.1"

# Canonical standard-library implementation body.
# ============================================================
# SEMANTICSCRIPT STANDARD LIBRARY: byte-buffer sort algorithms
# ============================================================
#
# rationale: in-place sort algorithms over byte buffers treated
#   as unsigned 0..255 values. Each byte loaded via pointer.loadByte
#   is normalized through (raw + 256) % 256 to undo i8 sign-extension.
#
# invariant: sort operations are total â€” they mutate byteCount
#   bytes in place and return byteCount. The Bool predicate
#   areBytesSortedAscending returns Bool directly.
#
# security: bounds enforcement is the caller's responsibility;
#   no capacity contract is encoded at this layer.
#
# timing: bubble sort O(n^2) worst case but O(n) on already-sorted /
#   nearly-sorted input via the per-pass no-swap early exit; insertion
#   sort O(n^2) worst case but O(n) on nearly-sorted input.

# Pure-module file: smoke + extended tests live in
# std/sort/main.test.sem.

domainLiteral integerOneStepValue Int64 1
domainLiteralTrust integerOneStepValue trustedStaticLiteral
domainLiteral integerZeroBoundaryForSort Int64 0
domainLiteralTrust integerZeroBoundaryForSort trustedStaticLiteral
domainLiteral byteRoleAdjustmentValue Int64 256
domainLiteralTrust byteRoleAdjustmentValue trustedStaticLiteral

# section sort.bubbleSort

operation sortBytesWithBubbleSortInPlace
input operation sortBytesWithBubbleSortInPlace byteBuffer OpaquePointer
input operation sortBytesWithBubbleSortInPlace byteCount ByteCount
output operation sortBytesWithBubbleSortInPlace ByteCount
memory sortBytesWithBubbleSortInPlace heap no
async sortBytesWithBubbleSortInPlace no
purpose operation sortBytesWithBubbleSortInPlace "In-place bubble sort of the first byteCount bytes of byteBuffer in non-decreasing order. Returns byteCount."
invariant operation sortBytesWithBubbleSortInPlace "After return, areBytesSortedAscending(byteBuffer, byteCount) == true."
warning sortBytesWithBubbleSortInPlace "O(byteCount^2) running time â€” not suitable for buffers larger than a few thousand bytes."
guarantee sortBytesWithBubbleSortInPlace "Total."
label startSortBytesWithBubbleSortInPlace
memory sortBytesWithBubbleSortInPlace mutable bubbleOuterIndex Int64 0
memory sortBytesWithBubbleSortInPlace mutable bubbleArrayLength Int64 0
# Per-pass swap flag: when a full inner pass performs no swaps the buffer
# is already sorted and the outer loop exits early, giving O(n) on
# already-sorted / nearly-sorted input instead of an unconditional O(n^2).
memory sortBytesWithBubbleSortInPlace mutable bubbleSwappedThisPass Int64 0
set memory bubbleArrayLength byteCount
label bubbleOuterHead
call detectBubbleOuterDoneCall math.greaterThanOrEqualInt64
argument detectBubbleOuterDoneCall left Int64 bubbleOuterIndex
argument detectBubbleOuterDoneCall right Int64 bubbleArrayLength
run detectBubbleOuterDoneCall
bind value bubbleOuterDone Bool detectBubbleOuterDoneCall
branch if condition bubbleOuterDone target bubbleSortComplete
set memory bubbleSwappedThisPass integerZeroBoundaryForSort
memory sortBytesWithBubbleSortInPlace mutable bubbleInnerIndex Int64 0
label bubbleInnerHead
call computeBubbleInnerLengthCall math.subtractInt64
argument computeBubbleInnerLengthCall left Int64 bubbleArrayLength
argument computeBubbleInnerLengthCall right Int64 bubbleOuterIndex
run computeBubbleInnerLengthCall
bind value bubbleInnerLength Int64 computeBubbleInnerLengthCall
call computeBubbleInnerBoundCall math.subtractInt64
argument computeBubbleInnerBoundCall left Int64 bubbleInnerLength
argument computeBubbleInnerBoundCall right Int64 integerOneStepValue
run computeBubbleInnerBoundCall
bind value bubbleInnerBound Int64 computeBubbleInnerBoundCall
call detectBubbleInnerDoneCall math.greaterThanOrEqualInt64
argument detectBubbleInnerDoneCall left Int64 bubbleInnerIndex
argument detectBubbleInnerDoneCall right Int64 bubbleInnerBound
run detectBubbleInnerDoneCall
bind value bubbleInnerDone Bool detectBubbleInnerDoneCall
branch if condition bubbleInnerDone target bubbleOuterAdvance
call loadBubbleLeftCall pointer.loadByte
argument loadBubbleLeftCall buffer OpaquePointer byteBuffer
argument loadBubbleLeftCall offset ByteCount bubbleInnerIndex
run loadBubbleLeftCall
bind value bubbleLeftRawByte Int8 loadBubbleLeftCall
call computeBubbleRightIndexCall math.addInt64
argument computeBubbleRightIndexCall left Int64 bubbleInnerIndex
argument computeBubbleRightIndexCall right Int64 integerOneStepValue
run computeBubbleRightIndexCall
bind value bubbleRightIndex Int64 computeBubbleRightIndexCall
call loadBubbleRightCall pointer.loadByte
argument loadBubbleRightCall buffer OpaquePointer byteBuffer
argument loadBubbleRightCall offset ByteCount bubbleRightIndex
run loadBubbleRightCall
bind value bubbleRightRawByte Int8 loadBubbleRightCall
call shiftBubbleLeftCall math.addInt64
argument shiftBubbleLeftCall left Int64 bubbleLeftRawByte
argument shiftBubbleLeftCall right Int64 byteRoleAdjustmentValue
run shiftBubbleLeftCall
bind value shiftedBubbleLeft Int64 shiftBubbleLeftCall
call normalizeBubbleLeftCall math.moduloInt64
argument normalizeBubbleLeftCall left Int64 shiftedBubbleLeft
argument normalizeBubbleLeftCall right Int64 byteRoleAdjustmentValue
run normalizeBubbleLeftCall
bind value unsignedBubbleLeft Int64 normalizeBubbleLeftCall
call shiftBubbleRightCall math.addInt64
argument shiftBubbleRightCall left Int64 bubbleRightRawByte
argument shiftBubbleRightCall right Int64 byteRoleAdjustmentValue
run shiftBubbleRightCall
bind value shiftedBubbleRight Int64 shiftBubbleRightCall
call normalizeBubbleRightCall math.moduloInt64
argument normalizeBubbleRightCall left Int64 shiftedBubbleRight
argument normalizeBubbleRightCall right Int64 byteRoleAdjustmentValue
run normalizeBubbleRightCall
bind value unsignedBubbleRight Int64 normalizeBubbleRightCall
call detectBubbleOutOfOrderCall math.greaterThanInt64
argument detectBubbleOutOfOrderCall left Int64 unsignedBubbleLeft
argument detectBubbleOutOfOrderCall right Int64 unsignedBubbleRight
run detectBubbleOutOfOrderCall
bind value bubbleOutOfOrder Bool detectBubbleOutOfOrderCall
branch if condition bubbleOutOfOrder target swapBubblePair
branch else target bubbleInnerAdvance
label swapBubblePair
call storeBubbleRightAtLeftCall pointer.storeByte
argument storeBubbleRightAtLeftCall buffer OpaquePointer byteBuffer
argument storeBubbleRightAtLeftCall offset ByteCount bubbleInnerIndex
argument storeBubbleRightAtLeftCall value Int64 bubbleRightRawByte
run storeBubbleRightAtLeftCall
call storeBubbleLeftAtRightCall pointer.storeByte
argument storeBubbleLeftAtRightCall buffer OpaquePointer byteBuffer
argument storeBubbleLeftAtRightCall offset ByteCount bubbleRightIndex
argument storeBubbleLeftAtRightCall value Int64 bubbleLeftRawByte
run storeBubbleLeftAtRightCall
set memory bubbleSwappedThisPass integerOneStepValue
jump target bubbleInnerAdvance
label bubbleInnerAdvance
call advanceBubbleInnerCall math.addInt64
argument advanceBubbleInnerCall left Int64 bubbleInnerIndex
argument advanceBubbleInnerCall right Int64 integerOneStepValue
run advanceBubbleInnerCall
bind value nextBubbleInner Int64 advanceBubbleInnerCall
set memory bubbleInnerIndex nextBubbleInner
jump target bubbleInnerHead
label bubbleOuterAdvance
# A pass with no swaps means the buffer is sorted; stop early.
call detectNoSwapsThisPassCall math.equalInt64
argument detectNoSwapsThisPassCall left Int64 bubbleSwappedThisPass
argument detectNoSwapsThisPassCall right Int64 integerZeroBoundaryForSort
run detectNoSwapsThisPassCall
bind value bubbleNoSwapsThisPass Bool detectNoSwapsThisPassCall
branch if condition bubbleNoSwapsThisPass target bubbleSortComplete
call advanceBubbleOuterCall math.addInt64
argument advanceBubbleOuterCall left Int64 bubbleOuterIndex
argument advanceBubbleOuterCall right Int64 integerOneStepValue
run advanceBubbleOuterCall
bind value nextBubbleOuter Int64 advanceBubbleOuterCall
set memory bubbleOuterIndex nextBubbleOuter
jump target bubbleOuterHead
label bubbleSortComplete
return value byteCount

# section sort.predicate

