# ============================================================
# SEMANTICSCRIPT STANDARD LIBRARY TESTS: byte-buffer sort algorithms
# ============================================================
#
# rationale: companion test file for std/sort/main.sem. Imports
#   the sort module and exercises every operation it exports â€”
#   bubble sort / insertion sort / sorted predicate â€” across the
#   happy path, the empty / single-byte trivial cases, and a
#   reverse-sorted input that needs an actual sort pass.
#
# invariant: success prints "OK\n" and exits 0; assertion failures
#   surface MainError.SortSmokeAssertionFailed; heap allocation
#   failure surfaces MainError.MemoryAllocationFailed.
#
# # pattern: this is the canonical main.test.sem form â€” same directory
#   as main.sem, importModule foo, project block local to the test,
#   entry console main. The implementation file std/sort/main.sem
#   carries no smoke main itself.

project StdSortTest
target console
runtime AgentRuntime 0.1
entry console main

import sort standard.sort
error MainError
errorCase MainError SortSmokeAssertionFailed
errorCase MainError ConsoleWriteFailed
errorCase MainError MemoryAllocationFailed

# section capability
# rationale: smoke-test main writes a single OK line to stdout.
capability stdoutWriteCapability console.stdout write
# Smoke-test main allocates and frees a working buffer via libc.
capability heapAllocationCapability heap allocate
capability heapFreeCapability heap free

# ============================================================
# Smoke test
# ============================================================

operation main
input operation main console Console
output operation main Result ExitCode MainError
useCapability main stdoutWriteCapability
useCapability main heapAllocationCapability
useCapability main heapFreeCapability
effect main allocate heap
effect main free heap
effect main write console.stdout
memory main heap yes
memoryAllocationSource main allocateBufferCall
async main no
purpose operation main "Allocate an 8-byte buffer, fill {5,2,8,1,9}, bubble-sort, verify sorted-ascending."
invariant operation main "Smoke fails closed: malloc failure surfaces MemoryAllocationFailed; out-of-order result surfaces SortSmokeAssertionFailed."

label startMain

storage module immutable allocationByteSize CByteCount 8
call allocateBufferCall c.malloc
argument allocateBufferCall size CByteCount allocationByteSize
run allocateBufferCall
bind value workBuffer COpaqueMemoryAddress allocateBufferCall
bind error allocationFailureError CSignedInt32 allocateBufferCall
branch error source allocateBufferCall target heapAllocationFailedHandler
defer releaseAllocateBufferCall c.free workBuffer

storage module immutable byteFiveValue CSignedInt32 5
storage module immutable byteTwoValue CSignedInt32 2
storage module immutable byteEightValue CSignedInt32 8
storage module immutable byteOneValue CSignedInt32 1
storage module immutable byteNineValue CSignedInt32 9
storage module immutable offsetZero CByteCount 0
storage module immutable offsetOne CByteCount 1
storage module immutable offsetTwo CByteCount 2
storage module immutable offsetThree CByteCount 3
storage module immutable offsetFour CByteCount 4
storage module immutable totalByteLength CByteCount 5

call storeByteAtOffsetZeroCall pointer.storeByte
argument storeByteAtOffsetZeroCall buffer COpaqueMemoryAddress workBuffer
argument storeByteAtOffsetZeroCall offset CByteCount offsetZero
argument storeByteAtOffsetZeroCall value CSignedInt64 byteFiveValue
run storeByteAtOffsetZeroCall
call storeByteAtOffsetOneCall pointer.storeByte
argument storeByteAtOffsetOneCall buffer COpaqueMemoryAddress workBuffer
argument storeByteAtOffsetOneCall offset CByteCount offsetOne
argument storeByteAtOffsetOneCall value CSignedInt64 byteTwoValue
run storeByteAtOffsetOneCall
call storeByteAtOffsetTwoCall pointer.storeByte
argument storeByteAtOffsetTwoCall buffer COpaqueMemoryAddress workBuffer
argument storeByteAtOffsetTwoCall offset CByteCount offsetTwo
argument storeByteAtOffsetTwoCall value CSignedInt64 byteEightValue
run storeByteAtOffsetTwoCall
call storeByteAtOffsetThreeCall pointer.storeByte
argument storeByteAtOffsetThreeCall buffer COpaqueMemoryAddress workBuffer
argument storeByteAtOffsetThreeCall offset CByteCount offsetThree
argument storeByteAtOffsetThreeCall value CSignedInt64 byteOneValue
run storeByteAtOffsetThreeCall
call storeByteAtOffsetFourCall pointer.storeByte
argument storeByteAtOffsetFourCall buffer COpaqueMemoryAddress workBuffer
argument storeByteAtOffsetFourCall offset CByteCount offsetFour
argument storeByteAtOffsetFourCall value CSignedInt64 byteNineValue
run storeByteAtOffsetFourCall

call runBubbleSortCall sortBytesWithBubbleSortInPlace
argument runBubbleSortCall byteBuffer COpaqueMemoryAddress workBuffer
argument runBubbleSortCall byteCount CByteCount totalByteLength
run runBubbleSortCall
ignore value source runBubbleSortCall type CByteCount

call checkSortedCall areBytesSortedAscending
argument checkSortedCall byteBuffer CNullTerminatedByteString workBuffer
argument checkSortedCall byteCount CByteCount totalByteLength
run checkSortedCall
bind value sortedAscendingResult Bool checkSortedCall
branch if condition sortedAscendingResult target sortedHolds
branch else target smokeAssertionFailed
label sortedHolds

# ============================================================
# Extended unit tests: insertion sort coverage + predicate
# boundary cases (empty buffer, single byte, reverse-sorted).
# Reuses workBuffer (already sorted by bubble sort above) plus
# fresh writes for the insertion-sort + reverse-sort scenarios.
# ============================================================

storage module immutable byteSevenValue CSignedInt32 7
storage module immutable byteThreeValue CSignedInt32 3
storage module immutable byteFourValue CSignedInt32 4
storage module immutable byteSixValue CSignedInt32 6
storage module immutable emptyCount CByteCount 0
storage module immutable oneCount CByteCount 1

# Predicate: empty buffer is trivially sorted (byteCount=0 returns true).
call sortedEmptyCall areBytesSortedAscending
argument sortedEmptyCall byteBuffer CNullTerminatedByteString workBuffer
argument sortedEmptyCall byteCount CByteCount emptyCount
run sortedEmptyCall
bind value sortedEmptyResult Bool sortedEmptyCall
branch if condition sortedEmptyResult target sortedEmptyHolds
branch else target smokeAssertionFailed
label sortedEmptyHolds

# Predicate: single-byte buffer is trivially sorted.
call sortedSingleCall areBytesSortedAscending
argument sortedSingleCall byteBuffer CNullTerminatedByteString workBuffer
argument sortedSingleCall byteCount CByteCount oneCount
run sortedSingleCall
bind value sortedSingleResult Bool sortedSingleCall
branch if condition sortedSingleResult target sortedSingleHolds
branch else target smokeAssertionFailed
label sortedSingleHolds

# Refill workBuffer with reverse-sorted {9,7,6,4,3} and verify the
# predicate correctly returns FALSE.
call refillReverseAtZeroCall pointer.storeByte
argument refillReverseAtZeroCall buffer COpaqueMemoryAddress workBuffer
argument refillReverseAtZeroCall offset CByteCount offsetZero
argument refillReverseAtZeroCall value CSignedInt64 byteNineValue
run refillReverseAtZeroCall
call refillReverseAtOneCall pointer.storeByte
argument refillReverseAtOneCall buffer COpaqueMemoryAddress workBuffer
argument refillReverseAtOneCall offset CByteCount offsetOne
argument refillReverseAtOneCall value CSignedInt64 byteSevenValue
run refillReverseAtOneCall
call refillReverseAtTwoCall pointer.storeByte
argument refillReverseAtTwoCall buffer COpaqueMemoryAddress workBuffer
argument refillReverseAtTwoCall offset CByteCount offsetTwo
argument refillReverseAtTwoCall value CSignedInt64 byteSixValue
run refillReverseAtTwoCall
call refillReverseAtThreeCall pointer.storeByte
argument refillReverseAtThreeCall buffer COpaqueMemoryAddress workBuffer
argument refillReverseAtThreeCall offset CByteCount offsetThree
argument refillReverseAtThreeCall value CSignedInt64 byteFourValue
run refillReverseAtThreeCall
call refillReverseAtFourCall pointer.storeByte
argument refillReverseAtFourCall buffer COpaqueMemoryAddress workBuffer
argument refillReverseAtFourCall offset CByteCount offsetFour
argument refillReverseAtFourCall value CSignedInt64 byteThreeValue
run refillReverseAtFourCall

# Predicate on reverse-sorted should return false.
call sortedReverseCall areBytesSortedAscending
argument sortedReverseCall byteBuffer CNullTerminatedByteString workBuffer
argument sortedReverseCall byteCount CByteCount totalByteLength
run sortedReverseCall
bind value sortedReverseResult Bool sortedReverseCall
branch if condition sortedReverseResult target smokeAssertionFailed
branch else target reverseDetected
# fell through: false as expected
label reverseDetected

# Now insertion-sort the reverse-sorted buffer and verify it becomes ascending.
call runInsertionSortCall sortBytesWithInsertionSortInPlace
argument runInsertionSortCall byteBuffer COpaqueMemoryAddress workBuffer
argument runInsertionSortCall byteCount CByteCount totalByteLength
run runInsertionSortCall
ignore value source runInsertionSortCall type CByteCount

call checkInsertionSortedCall areBytesSortedAscending
argument checkInsertionSortedCall byteBuffer CNullTerminatedByteString workBuffer
argument checkInsertionSortedCall byteCount CByteCount totalByteLength
run checkInsertionSortedCall
bind value insertionSortedResult Bool checkInsertionSortedCall
branch if condition insertionSortedResult target insertionSortedHolds
branch else target smokeAssertionFailed
label insertionSortedHolds

storage module immutable successMessageText CNullTerminatedByteString "OK"
call writeSuccessLineCall console.writeLine
argument writeSuccessLineCall console Console console
argument writeSuccessLineCall text CNullTerminatedByteString successMessageText
run writeSuccessLineCall
ignore ok source writeSuccessLineCall type CSignedInt32
bind error consoleWriteResultError CSignedInt32 writeSuccessLineCall
branch error source writeSuccessLineCall target consoleWriteFailedHandler
storage module immutable exitOkCode ExitCode 0
return ok exitOkCode

# Failure leg: surface the raw negative CSignedInt32 from
# console.writeLine as the cause attached to the typed
# MainError.ConsoleWriteFailed variant.
label consoleWriteFailedHandler
makeError consoleWriteFailedFailure MainError.ConsoleWriteFailed consoleWriteResultError
return error consoleWriteFailedFailure
label smokeAssertionFailed
makeError sortSmokeFailure MainError.SortSmokeAssertionFailed
return error sortSmokeFailure

# Heap-allocation failure leg: c.malloc returned NULL. We surface
# the raw negative status as the cause attached to the typed
# MainError.MemoryAllocationFailed variant.
label heapAllocationFailedHandler
makeError heapAllocationFailure MainError.MemoryAllocationFailed allocationFailureError
return error heapAllocationFailure
