# ============================================================
# SEMANTICSCRIPT STDLIB TESTS: compare
# ============================================================
#
# Companion smoke + extended unit tests for std/compare/main.sem.
# Imports the compare module and asserts every ordering / equality
# predicate plus reflexive / irreflexive / symmetry / tolerance
# property tests over CSignedInt64 and CFloat64 inputs.
#
# Pattern: std/main.sem ships pure-module operations only;
# std/main.test.sem carries every smoke / unit test for it.

project StdCompareTest
target console
runtime AgentRuntime 0.1
entry console main

import compare standard.compare
error MainError
errorCase MainError CompareSmokeAssertionFailed
errorCase MainError ConsoleWriteFailed

# section capability
# rationale: smoke-test main writes a single OK line to stdout.
capability stdoutWriteCapability console.stdout write

# ============================================================
# Smoke test
# ============================================================

operation main
input operation main console Console
output operation main Result ExitCode MainError
useCapability main stdoutWriteCapability
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Smoke-test the comparison ops. Prints OK and exits 0."
invariant operation main "All assertions pass."

label startMain
storage module immutable fiveInt CSignedInt64 5
storage module immutable tenInt CSignedInt64 10
storage module immutable tenIntCopy CSignedInt64 10

# compareSignedInt64Ordering(5, 10) == comparisonResultLessThan (-1)
call assertCompareLessThanCall compareSignedInt64Ordering
argument assertCompareLessThanCall leftValue CSignedInt64 fiveInt
argument assertCompareLessThanCall rightValue CSignedInt64 tenInt
run assertCompareLessThanCall
bind value compareLessResult CSignedInt32 assertCompareLessThanCall
storage module immutable expectedNegativeOne CSignedInt32 -1
call checkCompareLessCall math.equalI64
argument checkCompareLessCall left I64 compareLessResult
argument checkCompareLessCall right I64 expectedNegativeOne
run checkCompareLessCall
bind value compareLessOk Bool checkCompareLessCall
branch if condition compareLessOk target compareLessHolds
branch else target smokeAssertionFailed
label compareLessHolds

# isSignedInt64LeftLessThanRight(5, 10) == true
call assertIsLessThanCall isSignedInt64LeftLessThanRight
argument assertIsLessThanCall leftValue CSignedInt64 fiveInt
argument assertIsLessThanCall rightValue CSignedInt64 tenInt
run assertIsLessThanCall
bind value isLessResult Bool assertIsLessThanCall
branch if condition isLessResult target isLessHolds
branch else target smokeAssertionFailed
label isLessHolds

# areSignedInt64ValuesEqual(10, 10) == true
call assertEqualsCall areSignedInt64ValuesEqual
argument assertEqualsCall leftValue CSignedInt64 tenInt
argument assertEqualsCall rightValue CSignedInt64 tenIntCopy
run assertEqualsCall
bind value equalsResult Bool assertEqualsCall
branch if condition equalsResult target equalsHolds
branch else target smokeAssertionFailed
label equalsHolds

# isSignedInt64LeftGreaterThanOrEqualRight(10, 5) == true
call assertGreaterOrEqualCall isSignedInt64LeftGreaterThanOrEqualRight
argument assertGreaterOrEqualCall leftValue CSignedInt64 tenInt
argument assertGreaterOrEqualCall rightValue CSignedInt64 fiveInt
run assertGreaterOrEqualCall
bind value greaterOrEqualResult Bool assertGreaterOrEqualCall
branch if condition greaterOrEqualResult target greaterOrEqualHolds
branch else target smokeAssertionFailed
label greaterOrEqualHolds

# compareFloat64Ordering(1.0, 2.0) == comparisonResultLessThan
storage module immutable oneFloat CFloat64 1.0
storage module immutable twoFloat CFloat64 2.0
call assertCompareFloatCall compareFloat64Ordering
argument assertCompareFloatCall leftValue CFloat64 oneFloat
argument assertCompareFloatCall rightValue CFloat64 twoFloat
run assertCompareFloatCall
bind value compareFloatResult CSignedInt32 assertCompareFloatCall
call checkCompareFloatCall math.equalI64
argument checkCompareFloatCall left I64 compareFloatResult
argument checkCompareFloatCall right I64 expectedNegativeOne
run checkCompareFloatCall
bind value compareFloatOk Bool checkCompareFloatCall
branch if condition compareFloatOk target compareFloatHolds
branch else target smokeAssertionFailed
label compareFloatHolds

# areFloat64ValuesWithinTolerance(1.0, 1.05, 0.1) == true
storage module immutable smallTolerance CFloat64 0.1
storage module immutable slightlyLargerFloat CFloat64 1.05
call assertToleranceCall areFloat64ValuesWithinTolerance
argument assertToleranceCall leftValue CFloat64 oneFloat
argument assertToleranceCall rightValue CFloat64 slightlyLargerFloat
argument assertToleranceCall tolerance CFloat64 smallTolerance
run assertToleranceCall
bind value toleranceResult Bool assertToleranceCall
branch if condition toleranceResult target toleranceHolds
branch else target smokeAssertionFailed
label toleranceHolds

# ============================================================
# Extended unit tests: covers the 2 untested ops
# (isSignedInt64LeftLessThanOrEqualRight, isSignedInt64LeftGreaterThanRight)
# plus reflexive / irreflexive / inverse-ordering cases that the
# single-direction smoke above can't catch.
# ============================================================

storage module immutable expectedZero CSignedInt32 0
storage module immutable expectedPositiveOne CSignedInt32 1

# compareSignedInt64Ordering(10, 5) == comparisonResultGreaterThan (+1)
call cmpGreaterCall compareSignedInt64Ordering
argument cmpGreaterCall leftValue CSignedInt64 tenInt
argument cmpGreaterCall rightValue CSignedInt64 fiveInt
run cmpGreaterCall
bind value cmpGreaterResult CSignedInt32 cmpGreaterCall
call cmpGreaterCheckCall math.equalI64
argument cmpGreaterCheckCall left I64 cmpGreaterResult
argument cmpGreaterCheckCall right I64 expectedPositiveOne
run cmpGreaterCheckCall
bind value cmpGreaterOk Bool cmpGreaterCheckCall
branch if condition cmpGreaterOk target cmpGreaterHolds
branch else target smokeAssertionFailed
label cmpGreaterHolds

# compareSignedInt64Ordering(10, 10) == comparisonResultEqual (0)
call cmpEqCall compareSignedInt64Ordering
argument cmpEqCall leftValue CSignedInt64 tenInt
argument cmpEqCall rightValue CSignedInt64 tenIntCopy
run cmpEqCall
bind value cmpEqResult CSignedInt32 cmpEqCall
call cmpEqCheckCall math.equalI64
argument cmpEqCheckCall left I64 cmpEqResult
argument cmpEqCheckCall right I64 expectedZero
run cmpEqCheckCall
bind value cmpEqOk Bool cmpEqCheckCall
branch if condition cmpEqOk target cmpEqHolds
branch else target smokeAssertionFailed
label cmpEqHolds

# areSignedInt64ValuesEqual(5, 10) == false (inequality leg)
call notEqualCall areSignedInt64ValuesEqual
argument notEqualCall leftValue CSignedInt64 fiveInt
argument notEqualCall rightValue CSignedInt64 tenInt
run notEqualCall
bind value notEqualResult Bool notEqualCall
branch if condition notEqualResult target smokeAssertionFailed
branch else target notEqualHolds
label notEqualHolds

# isSignedInt64LeftLessThanOrEqualRight(5, 5) == true (reflexive)
call leReflexiveCall isSignedInt64LeftLessThanOrEqualRight
argument leReflexiveCall leftValue CSignedInt64 fiveInt
argument leReflexiveCall rightValue CSignedInt64 fiveInt
run leReflexiveCall
bind value leReflexiveResult Bool leReflexiveCall
branch if condition leReflexiveResult target leReflexiveHolds
branch else target smokeAssertionFailed
label leReflexiveHolds

# isSignedInt64LeftLessThanOrEqualRight(10, 5) == false
call leFalseCall isSignedInt64LeftLessThanOrEqualRight
argument leFalseCall leftValue CSignedInt64 tenInt
argument leFalseCall rightValue CSignedInt64 fiveInt
run leFalseCall
bind value leFalseResult Bool leFalseCall
branch if condition leFalseResult target smokeAssertionFailed
branch else target leFalseHolds
label leFalseHolds

# isSignedInt64LeftGreaterThanRight(10, 5) == true
call gtTrueCall isSignedInt64LeftGreaterThanRight
argument gtTrueCall leftValue CSignedInt64 tenInt
argument gtTrueCall rightValue CSignedInt64 fiveInt
run gtTrueCall
bind value gtTrueResult Bool gtTrueCall
branch if condition gtTrueResult target gtTrueHolds
branch else target smokeAssertionFailed
label gtTrueHolds

# isSignedInt64LeftGreaterThanRight(5, 5) == false (irreflexive)
call gtIrreflexiveCall isSignedInt64LeftGreaterThanRight
argument gtIrreflexiveCall leftValue CSignedInt64 fiveInt
argument gtIrreflexiveCall rightValue CSignedInt64 fiveInt
run gtIrreflexiveCall
bind value gtIrreflexiveResult Bool gtIrreflexiveCall
branch if condition gtIrreflexiveResult target smokeAssertionFailed
branch else target gtIrreflexiveHolds
label gtIrreflexiveHolds

# isSignedInt64LeftLessThanRight(10, 5) == false (false leg)
call ltFalseCall isSignedInt64LeftLessThanRight
argument ltFalseCall leftValue CSignedInt64 tenInt
argument ltFalseCall rightValue CSignedInt64 fiveInt
run ltFalseCall
bind value ltFalseResult Bool ltFalseCall
branch if condition ltFalseResult target smokeAssertionFailed
branch else target ltFalseHolds
label ltFalseHolds

# compareFloat64Ordering(2.0, 1.0) == greaterThan (inverse)
call cmpFloatGreaterCall compareFloat64Ordering
argument cmpFloatGreaterCall leftValue CFloat64 twoFloat
argument cmpFloatGreaterCall rightValue CFloat64 oneFloat
run cmpFloatGreaterCall
bind value cmpFloatGreaterResult CSignedInt32 cmpFloatGreaterCall
call cmpFloatGreaterCheckCall math.equalI64
argument cmpFloatGreaterCheckCall left I64 cmpFloatGreaterResult
argument cmpFloatGreaterCheckCall right I64 expectedPositiveOne
run cmpFloatGreaterCheckCall
bind value cmpFloatGreaterOk Bool cmpFloatGreaterCheckCall
branch if condition cmpFloatGreaterOk target cmpFloatGreaterHolds
branch else target smokeAssertionFailed
label cmpFloatGreaterHolds

# compareFloat64Ordering(1.0, 1.0) == equal
call cmpFloatEqCall compareFloat64Ordering
argument cmpFloatEqCall leftValue CFloat64 oneFloat
argument cmpFloatEqCall rightValue CFloat64 oneFloat
run cmpFloatEqCall
bind value cmpFloatEqResult CSignedInt32 cmpFloatEqCall
call cmpFloatEqCheckCall math.equalI64
argument cmpFloatEqCheckCall left I64 cmpFloatEqResult
argument cmpFloatEqCheckCall right I64 expectedZero
run cmpFloatEqCheckCall
bind value cmpFloatEqOk Bool cmpFloatEqCheckCall
branch if condition cmpFloatEqOk target cmpFloatEqHolds
branch else target smokeAssertionFailed
label cmpFloatEqHolds

# areFloat64ValuesWithinTolerance(1.0, 2.0, 0.1) == false (outside tolerance)
call tolFalseCall areFloat64ValuesWithinTolerance
argument tolFalseCall leftValue CFloat64 oneFloat
argument tolFalseCall rightValue CFloat64 twoFloat
argument tolFalseCall tolerance CFloat64 smallTolerance
run tolFalseCall
bind value tolFalseResult Bool tolFalseCall
branch if condition tolFalseResult target smokeAssertionFailed
branch else target tolFalseHolds
label tolFalseHolds

# Symmetry: withinTolerance(1.05, 1.0, 0.1) == true (reverse args)
call tolSymCall areFloat64ValuesWithinTolerance
argument tolSymCall leftValue CFloat64 slightlyLargerFloat
argument tolSymCall rightValue CFloat64 oneFloat
argument tolSymCall tolerance CFloat64 smallTolerance
run tolSymCall
bind value tolSymResult Bool tolSymCall
branch if condition tolSymResult target tolSymHolds
branch else target smokeAssertionFailed
label tolSymHolds

# Emit "OK\n" and exit 0.
storage module immutable successMessageText CNullTerminatedByteString "OK"
call writeSuccessLineCall console.writeLine
argument writeSuccessLineCall console Console console
argument writeSuccessLineCall text CNullTerminatedByteString successMessageText
run writeSuccessLineCall
ignore ok source writeSuccessLineCall type CSignedInt32
bind error consoleWriteResultError CSignedInt32 writeSuccessLineCall
branch error source writeSuccessLineCall target consoleWriteFailedHandler
storage module immutable exitOkCode ExitCode 0
return ok exitOkCode

# Failure leg: surface the raw negative CSignedInt32 from
# console.writeLine as the cause attached to the typed
# MainError.ConsoleWriteFailed variant.
label consoleWriteFailedHandler
makeError consoleWriteFailedFailure MainError.ConsoleWriteFailed consoleWriteResultError
return error consoleWriteFailedFailure
label smokeAssertionFailed
makeError compareSmokeFailure MainError.CompareSmokeAssertionFailed
return error compareSmokeFailure
