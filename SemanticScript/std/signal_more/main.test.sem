# ============================================================
# SEMANTICSCRIPT STANDARD LIBRARY TESTS: extended POSIX signals
# ============================================================
#
# rationale: companion test file for std/signal_more/main.sem.
#   Imports the signal_more module and verifies a representative
#   subset of the extended signal-number constants.
#
# invariant: success prints "OK\n" and exits 0; any failed
#   assertion surfaces MainError.SignalMoreSmokeAssertionFailed.
#
# pattern: canonical main.test.sem form — same directory as
#   main.sem, import the module, project block local to the test,
#   entry console main. The implementation file
#   std/signal_more/main.sem carries no smoke main itself.

project StdSignalMoreTest
target console
runtime AgentRuntime 0.1
entry console main

import signal_more standard.signal_more
error MainError
errorCase MainError SignalMoreSmokeAssertionFailed
errorCase MainError ConsoleWriteFailed

# section capability
# rationale: smoke-test main writes a single OK line to stdout.
capability stdoutWriteCapability console.stdout write

# ============================================================
# Smoke test
# ============================================================

operation main
input operation main console Console
output operation main Result ExitCode MainError
useCapability main stdoutWriteCapability
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Verify a representative subset of the extended signal numbers."
invariant operation main "SIGKILL == 9, SIGHUP == 1, SIGUSR1 == 10."

label startMain

storage module immutable nineExpected Int32 9
call checkKillCall math.equalInt64
argument checkKillCall left Int64 killSignalNumber
argument checkKillCall right Int64 nineExpected
run checkKillCall
bind value killOk Bool checkKillCall
branch if condition killOk target killHolds
branch else target smokeAssertionFailed
label killHolds

storage module immutable oneExpected Int32 1
call checkHangupCall math.equalInt64
argument checkHangupCall left Int64 hangupSignalNumber
argument checkHangupCall right Int64 oneExpected
run checkHangupCall
bind value hangupOk Bool checkHangupCall
branch if condition hangupOk target hangupHolds
branch else target smokeAssertionFailed
label hangupHolds

storage module immutable successMessageText String "OK"
call writeSuccessLineCall console.writeLine
argument writeSuccessLineCall console Console console
argument writeSuccessLineCall text String successMessageText
run writeSuccessLineCall
ignore ok source writeSuccessLineCall type Int32
bind error consoleWriteResultError Int32 writeSuccessLineCall
branch error source writeSuccessLineCall target consoleWriteFailedHandler
storage module immutable exitOkCode ExitCode 0
return ok exitOkCode

# Failure leg: surface the raw negative Int32 from
# console.writeLine as the cause attached to the typed
# MainError.ConsoleWriteFailed variant.
label consoleWriteFailedHandler
makeError consoleWriteFailedFailure MainError.ConsoleWriteFailed consoleWriteResultError
return error consoleWriteFailedFailure
label smokeAssertionFailed
makeError signalMoreSmokeFailure MainError.SignalMoreSmokeAssertionFailed
return error signalMoreSmokeFailure
