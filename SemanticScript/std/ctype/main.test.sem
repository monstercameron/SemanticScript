# ============================================================
# SEMANTICSCRIPT STDLIB TESTS: ctype
# ============================================================
#
# Companion smoke + extended unit tests for std/ctype/main.sem.
# Imports the ctype module and exercises every classifier and
# both case-mapping operations end-to-end, including boundary and
# off-by-one cases that are the most common <ctype.h> bugs.
#
# Pattern: std/main.sem ships pure-module operations only;
# std/main.test.sem carries every smoke / unit test for it.

project StdCtypeTest
target console
runtime AgentRuntime 0.1
entry console main

import ctype standard.ctype
error MainError
errorCase MainError CtypeSmokeAssertionFailed
errorCase MainError ConsoleWriteFailed

# section capability
# rationale: smoke-test main writes a single OK line to stdout.
capability stdoutWriteCapability console.stdout write

# ============================================================
# Smoke test
# ============================================================

operation main
input operation main console Console
output operation main Result ExitCode MainError
useCapability main stdoutWriteCapability
effect main write console.stdout
memory main heap no
memoryStackLimit main 1024
async main no
purpose operation main "Smoke-test every classifier and case mapper; print OK on success, returnError otherwise."
invariant operation main "Every predicate asserted is satisfied or the assertion-failure path runs."
label startMain

storage module immutable digit5Code CSignedInt32 53
storage module immutable lowerHCode CSignedInt32 104
storage module immutable upperHCode CSignedInt32 72
storage module immutable exclamationMarkCode CSignedInt32 33
storage module immutable upperFHexCode CSignedInt32 70
storage module immutable nullByteCode CSignedInt32 0
storage module immutable tabByteCode CSignedInt32 9
storage module immutable lineFeedByteCode CSignedInt32 10
storage module immutable spaceByteCode CSignedInt32 32

# isAsciiDecimalDigitCode('5') == true
call assertDigit5Call isAsciiDecimalDigitCode
argument assertDigit5Call characterCode CSignedInt32 digit5Code
run assertDigit5Call
bind value digit5IsDigit Bool assertDigit5Call
branch if condition digit5IsDigit target digit5Holds
branch else target smokeAssertionFailed
label digit5Holds

# isAsciiLetterCode('h') == true
call assertLetterHCall isAsciiLetterCode
argument assertLetterHCall characterCode CSignedInt32 lowerHCode
run assertLetterHCall
bind value lowerHIsLetter Bool assertLetterHCall
branch if condition lowerHIsLetter target letterHHolds
branch else target smokeAssertionFailed
label letterHHolds

# isAsciiLetterOrDigitCode('5') == true
call assertAlnumDigitCall isAsciiLetterOrDigitCode
argument assertAlnumDigitCall characterCode CSignedInt32 digit5Code
run assertAlnumDigitCall
bind value digit5IsAlnum Bool assertAlnumDigitCall
branch if condition digit5IsAlnum target alnumDigitHolds
branch else target smokeAssertionFailed
label alnumDigitHolds

# isAsciiLetterOrDigitCode('!') == false
call assertAlnumPunctCall isAsciiLetterOrDigitCode
argument assertAlnumPunctCall characterCode CSignedInt32 exclamationMarkCode
run assertAlnumPunctCall
bind value exclamationIsAlnum Bool assertAlnumPunctCall
branch if condition exclamationIsAlnum target smokeAssertionFailed

# isAsciiHexDigitCode('F') == true
call assertHexCall isAsciiHexDigitCode
argument assertHexCall characterCode CSignedInt32 upperFHexCode
run assertHexCall
bind value upperFIsHexDigit Bool assertHexCall
branch if condition upperFIsHexDigit target hexHolds
branch else target smokeAssertionFailed
label hexHolds

# isAsciiWhitespaceCode(' ') == true
call assertWhitespaceSpaceCall isAsciiWhitespaceCode
argument assertWhitespaceSpaceCall characterCode CSignedInt32 spaceByteCode
run assertWhitespaceSpaceCall
bind value spaceIsWhitespace Bool assertWhitespaceSpaceCall
branch if condition spaceIsWhitespace target whitespaceSpaceHolds
branch else target smokeAssertionFailed
label whitespaceSpaceHolds

# isAsciiBlankCode('\t') == true
call assertBlankTabCall isAsciiBlankCode
argument assertBlankTabCall characterCode CSignedInt32 tabByteCode
run assertBlankTabCall
bind value tabIsBlank Bool assertBlankTabCall
branch if condition tabIsBlank target blankTabHolds
branch else target smokeAssertionFailed
label blankTabHolds

# isAsciiBlankCode('\n') == false
call assertBlankLineFeedCall isAsciiBlankCode
argument assertBlankLineFeedCall characterCode CSignedInt32 lineFeedByteCode
run assertBlankLineFeedCall
bind value lineFeedIsBlank Bool assertBlankLineFeedCall
branch if condition lineFeedIsBlank target smokeAssertionFailed

# isAsciiControlCode(0) == true
call assertControlNullCall isAsciiControlCode
argument assertControlNullCall characterCode CSignedInt32 nullByteCode
run assertControlNullCall
bind value nullIsControl Bool assertControlNullCall
branch if condition nullIsControl target controlNullHolds
branch else target smokeAssertionFailed
label controlNullHolds

# isAsciiPrintableCode(' ') == true
call assertPrintableSpaceCall isAsciiPrintableCode
argument assertPrintableSpaceCall characterCode CSignedInt32 spaceByteCode
run assertPrintableSpaceCall
bind value spaceIsPrintable Bool assertPrintableSpaceCall
branch if condition spaceIsPrintable target printableSpaceHolds
branch else target smokeAssertionFailed
label printableSpaceHolds

# isAsciiGraphicalCode(' ') == false (space is not graphical)
call assertGraphicalSpaceCall isAsciiGraphicalCode
argument assertGraphicalSpaceCall characterCode CSignedInt32 spaceByteCode
run assertGraphicalSpaceCall
bind value spaceIsGraphical Bool assertGraphicalSpaceCall
branch if condition spaceIsGraphical target smokeAssertionFailed

# isAsciiPunctuationCode('!') == true
call assertPunctuationExclamationCall isAsciiPunctuationCode
argument assertPunctuationExclamationCall characterCode CSignedInt32 exclamationMarkCode
run assertPunctuationExclamationCall
bind value exclamationIsPunctuation Bool assertPunctuationExclamationCall
branch if condition exclamationIsPunctuation target punctuationExclamationHolds
branch else target smokeAssertionFailed
label punctuationExclamationHolds

# convertAsciiLetterCodeToUppercase('h') == 'H'
call assertToUpperCall convertAsciiLetterCodeToUppercase
argument assertToUpperCall characterCode CSignedInt32 lowerHCode
run assertToUpperCall
bind value upperConversionResult CSignedInt32 assertToUpperCall
call checkToUpperCall math.equalI64
argument checkToUpperCall left I64 upperConversionResult
argument checkToUpperCall right I64 upperHCode
run checkToUpperCall
bind value toUpperOk Bool checkToUpperCall
branch if condition toUpperOk target toUpperHolds
branch else target smokeAssertionFailed
label toUpperHolds

# convertAsciiLetterCodeToLowercase('H') == 'h'
call assertToLowerCall convertAsciiLetterCodeToLowercase
argument assertToLowerCall characterCode CSignedInt32 upperHCode
run assertToLowerCall
bind value lowerConversionResult CSignedInt32 assertToLowerCall
call checkToLowerCall math.equalI64
argument checkToLowerCall left I64 lowerConversionResult
argument checkToLowerCall right I64 lowerHCode
run checkToLowerCall
bind value toLowerOk Bool checkToLowerCall
branch if condition toLowerOk target toLowerHolds
branch else target smokeAssertionFailed
label toLowerHolds

# ============================================================
# Extended unit tests: coverage for the 2 untested ops
# (isAsciiLowercaseLetterCode, isAsciiUppercaseLetterCode) plus
# negative-case boundaries for each predicate (off-by-one is the
# most common ctype bug, so each range gets both an inside and
# outside check).
# ============================================================

storage module immutable lowerACode CSignedInt32 97
storage module immutable upperACode CSignedInt32 65
storage module immutable lowerFHexCode CSignedInt32 102
storage module immutable letterGNotHexCode CSignedInt32 71
storage module immutable digit0Code CSignedInt32 48
storage module immutable tildeCode CSignedInt32 126
storage module immutable deleteCode CSignedInt32 127

# isAsciiLowercaseLetterCode('a') == true
call lowerATrueCall isAsciiLowercaseLetterCode
argument lowerATrueCall characterCode CSignedInt32 lowerACode
run lowerATrueCall
bind value lowerATrueResult Bool lowerATrueCall
branch if condition lowerATrueResult target lowerATrueHolds
branch else target smokeAssertionFailed
label lowerATrueHolds

# isAsciiLowercaseLetterCode('A') == false
call lowerAFalseCall isAsciiLowercaseLetterCode
argument lowerAFalseCall characterCode CSignedInt32 upperACode
run lowerAFalseCall
bind value lowerAFalseResult Bool lowerAFalseCall
branch if condition lowerAFalseResult target smokeAssertionFailed
branch else target lowerAFalseHolds
label lowerAFalseHolds

# isAsciiUppercaseLetterCode('A') == true
call upperATrueCall isAsciiUppercaseLetterCode
argument upperATrueCall characterCode CSignedInt32 upperACode
run upperATrueCall
bind value upperATrueResult Bool upperATrueCall
branch if condition upperATrueResult target upperATrueHolds
branch else target smokeAssertionFailed
label upperATrueHolds

# isAsciiUppercaseLetterCode('a') == false
call upperAFalseCall isAsciiUppercaseLetterCode
argument upperAFalseCall characterCode CSignedInt32 lowerACode
run upperAFalseCall
bind value upperAFalseResult Bool upperAFalseCall
branch if condition upperAFalseResult target smokeAssertionFailed
branch else target upperAFalseHolds
label upperAFalseHolds

# isAsciiDecimalDigitCode('a') == false (letter outside digit range)
call digitNonCall isAsciiDecimalDigitCode
argument digitNonCall characterCode CSignedInt32 lowerACode
run digitNonCall
bind value digitNonResult Bool digitNonCall
branch if condition digitNonResult target smokeAssertionFailed
branch else target digitNonHolds
label digitNonHolds

# isAsciiDecimalDigitCode('0') == true (boundary)
call digitZeroCall isAsciiDecimalDigitCode
argument digitZeroCall characterCode CSignedInt32 digit0Code
run digitZeroCall
bind value digitZeroResult Bool digitZeroCall
branch if condition digitZeroResult target digitZeroHolds
branch else target smokeAssertionFailed
label digitZeroHolds

# isAsciiLetterCode('5') == false (digit not letter)
call letterNonCall isAsciiLetterCode
argument letterNonCall characterCode CSignedInt32 digit5Code
run letterNonCall
bind value letterNonResult Bool letterNonCall
branch if condition letterNonResult target smokeAssertionFailed
branch else target letterNonHolds
label letterNonHolds

# isAsciiHexDigitCode('f') == true (lowercase hex digit)
call hexLowerCall isAsciiHexDigitCode
argument hexLowerCall characterCode CSignedInt32 lowerFHexCode
run hexLowerCall
bind value hexLowerResult Bool hexLowerCall
branch if condition hexLowerResult target hexLowerHolds
branch else target smokeAssertionFailed
label hexLowerHolds

# isAsciiHexDigitCode('G') == false (just past F)
call hexGFalseCall isAsciiHexDigitCode
argument hexGFalseCall characterCode CSignedInt32 letterGNotHexCode
run hexGFalseCall
bind value hexGFalseResult Bool hexGFalseCall
branch if condition hexGFalseResult target smokeAssertionFailed
branch else target hexGFalseHolds
label hexGFalseHolds

# isAsciiControlCode(' ') == false (space is not control)
call controlSpaceCall isAsciiControlCode
argument controlSpaceCall characterCode CSignedInt32 spaceByteCode
run controlSpaceCall
bind value controlSpaceResult Bool controlSpaceCall
branch if condition controlSpaceResult target smokeAssertionFailed
branch else target controlSpaceHolds
label controlSpaceHolds

# isAsciiControlCode(127) == true (DEL is control)
call controlDelCall isAsciiControlCode
argument controlDelCall characterCode CSignedInt32 deleteCode
run controlDelCall
bind value controlDelResult Bool controlDelCall
branch if condition controlDelResult target controlDelHolds
branch else target smokeAssertionFailed
label controlDelHolds

# isAsciiPrintableCode(0) == false (NUL not printable)
call printNonCall isAsciiPrintableCode
argument printNonCall characterCode CSignedInt32 nullByteCode
run printNonCall
bind value printNonResult Bool printNonCall
branch if condition printNonResult target smokeAssertionFailed
branch else target printNonHolds
label printNonHolds

# isAsciiPrintableCode('~') == true (last printable)
call printTildeCall isAsciiPrintableCode
argument printTildeCall characterCode CSignedInt32 tildeCode
run printTildeCall
bind value printTildeResult Bool printTildeCall
branch if condition printTildeResult target printTildeHolds
branch else target smokeAssertionFailed
label printTildeHolds

# convertAsciiLetterCodeToUppercase('H') == 'H' (already upper, identity)
call upperIdCall convertAsciiLetterCodeToUppercase
argument upperIdCall characterCode CSignedInt32 upperHCode
run upperIdCall
bind value upperIdResult CSignedInt32 upperIdCall
call upperIdCheckCall math.equalI64
argument upperIdCheckCall left I64 upperIdResult
argument upperIdCheckCall right I64 upperHCode
run upperIdCheckCall
bind value upperIdOk Bool upperIdCheckCall
branch if condition upperIdOk target upperIdHolds
branch else target smokeAssertionFailed
label upperIdHolds

# convertAsciiLetterCodeToLowercase('5') == '5' (non-letter identity)
call lowerNonLetterCall convertAsciiLetterCodeToLowercase
argument lowerNonLetterCall characterCode CSignedInt32 digit5Code
run lowerNonLetterCall
bind value lowerNonLetterResult CSignedInt32 lowerNonLetterCall
call lowerNonLetterCheckCall math.equalI64
argument lowerNonLetterCheckCall left I64 lowerNonLetterResult
argument lowerNonLetterCheckCall right I64 digit5Code
run lowerNonLetterCheckCall
bind value lowerNonLetterOk Bool lowerNonLetterCheckCall
branch if condition lowerNonLetterOk target lowerNonLetterHolds
branch else target smokeAssertionFailed
label lowerNonLetterHolds

# Property: convertToUpper(convertToLower('H')) == 'H' (round-trip)
call propLowerCall convertAsciiLetterCodeToLowercase
argument propLowerCall characterCode CSignedInt32 upperHCode
run propLowerCall
bind value propLowerResult CSignedInt32 propLowerCall
call propUpperCall convertAsciiLetterCodeToUppercase
argument propUpperCall characterCode CSignedInt32 propLowerResult
run propUpperCall
bind value propUpperResult CSignedInt32 propUpperCall
call propRoundTripCheckCall math.equalI64
argument propRoundTripCheckCall left I64 propUpperResult
argument propRoundTripCheckCall right I64 upperHCode
run propRoundTripCheckCall
bind value propRoundTripOk Bool propRoundTripCheckCall
branch if condition propRoundTripOk target propRoundTripHolds
branch else target smokeAssertionFailed
label propRoundTripHolds

storage module immutable successMessageText CNullTerminatedByteString "OK"
call writeSuccessLineCall console.writeLine
argument writeSuccessLineCall console Console console
argument writeSuccessLineCall text CNullTerminatedByteString successMessageText
run writeSuccessLineCall
ignore ok source writeSuccessLineCall type CSignedInt32
bind error consoleWriteResultError CSignedInt32 writeSuccessLineCall
branch error source writeSuccessLineCall target consoleWriteFailedHandler
storage module immutable exitOkCode ExitCode 0
return ok exitOkCode

# Failure leg: surface the raw negative CSignedInt32 from
# console.writeLine as the cause attached to the typed
# MainError.ConsoleWriteFailed variant.
label consoleWriteFailedHandler
makeError consoleWriteFailedFailure MainError.ConsoleWriteFailed consoleWriteResultError
return error consoleWriteFailedFailure
label smokeAssertionFailed
makeError ctypeSmokeFailure MainError.CtypeSmokeAssertionFailed
return error ctypeSmokeFailure
