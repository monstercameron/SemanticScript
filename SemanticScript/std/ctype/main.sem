argument detectAboveDigitRangeCall right I64 asciiDigitNineCode
run detectAboveDigitRangeCall
bind value aboveDigitRange Bool detectAboveDigitRangeCall
branch if condition aboveDigitRange target returnNotDigit
storage module immutable isDigitTrue Bool true
return value isDigitTrue
label returnNotDigit
storage module immutable isDigitFalse Bool false
return value isDigitFalse

