# section ctype.control
# rationale: control / printable / graphical / punctuation classification.

operation isAsciiControlCode
input operation isAsciiControlCode characterCode Int32
output operation isAsciiControlCode Bool
memory isAsciiControlCode heap no
memory isAsciiControlCode stack max 1024
async isAsciiControlCode no
purpose operation isAsciiControlCode "Returns true for control characters (0x00..0x1F or 0x7F)."
invariant operation isAsciiControlCode "Holds iff 0 <= c <= 31 OR c == 127."
guarantee isAsciiControlCode "Total."
label startIsAsciiControlCode
# Floor guard: a negative input is outside the ASCII range and is not a
# control character. A 0xFF byte loaded via pointer.loadByte sign-extends
# to -1; without this floor, the `<= 31` low-range check below would
# satisfy -1 <= 31 and misclassify every negative byte as control, which
# also violates this operation's `0 <= c <= 31 OR c == 127` invariant.
storage module immutable asciiControlRangeFloor Int32 0
call detectBelowControlFloorCall math.lessThanInt64
argument detectBelowControlFloorCall left Int64 characterCode
argument detectBelowControlFloorCall right Int64 asciiControlRangeFloor
run detectBelowControlFloorCall
bind value characterBelowControlFloor Bool detectBelowControlFloorCall
branch if condition characterBelowControlFloor target returnIsControlFalse
call detectLowControlRangeCall math.lessThanOrEqualInt64
argument detectLowControlRangeCall left Int64 characterCode
argument detectLowControlRangeCall right Int64 asciiHighestControlCode
run detectLowControlRangeCall
bind value characterInLowControlRange Bool detectLowControlRangeCall
branch if condition characterInLowControlRange target returnIsControl
call detectEqualsDeleteCall math.equalInt64
argument detectEqualsDeleteCall left Int64 characterCode
argument detectEqualsDeleteCall right Int64 asciiDeleteCode
run detectEqualsDeleteCall
bind value characterEqualsDelete Bool detectEqualsDeleteCall
branch if condition characterEqualsDelete target returnIsControl
storage module immutable isControlFalse Bool false
label returnIsControlFalse
return value isControlFalse
label returnIsControl
storage module immutable isControlTrue Bool true
return value isControlTrue

