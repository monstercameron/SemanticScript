# ============================================================
# SEMANTICSCRIPT STDLIB TESTS: time
# ============================================================
#
# Companion smoke + extended unit tests for std/time/main.sem.
# Exercises the deterministic conversions and Gregorian leap-year
# predicate. The OS-time wrappers (readProcessCpuClockTicks,
# readCurrentUnixEpochSeconds) are invoked but not value-asserted
# (non-deterministic across runs); they exist to verify the
# capability + heap-slot plumbing still wires correctly across the
# importModule boundary.
#
# Pattern: std/main.sem ships pure-module operations only;
# std/main.test.sem carries every smoke / unit test for it.

project StdTimeTest
target console
runtime AgentRuntime 0.1
entry console main

import time standard.time
error MainError
errorCase MainError TimeSmokeAssertionFailed
errorCase MainError ConsoleWriteFailed

# section capability
# rationale: smoke-test main writes a single OK line to stdout
#   and also exercises the OS-time wrappers, so it needs the
#   clock + heap capabilities those wrappers require.
capability stdoutWriteCapability console.stdout write
capability clockCpuReadCapability clock.cpu read
capability clockRealTimeReadCapability clock.realTime read
capability heapAllocationCapability heap allocate
capability heapFreeCapability heap free

# ============================================================
# Smoke test
# ============================================================

operation main
input operation main console Console
output operation main Result ExitCode MainError
useCapability main stdoutWriteCapability
useCapability main clockCpuReadCapability
useCapability main clockRealTimeReadCapability
useCapability main heapAllocationCapability
useCapability main heapFreeCapability
effect main write console.stdout
effect main read clock.cpu
effect main read clock.realTime
effect main allocate heap
effect main free heap
memory main heap yes
memoryAllocationSource main exerciseUnixTimeCall
async main no
purpose operation main "Smoke-test the deterministic time helpers (conversions + leap-year). The clock readers are exercised but their values are not asserted (non-deterministic)."
invariant operation main "convertSecondsToWholeHours(3661) == 1; convertHoursToSeconds(2) == 7200; isGregorianLeapYear(2000) == true; isGregorianLeapYear(1900) == false; isGregorianLeapYear(2024) == true."

label startMain

# convertSecondsToWholeHours(3661) == 1
storage module immutable threeThousandSixHundredSixtyOne CSignedInt64 3661
storage module immutable oneHourCount CSignedInt64 1
call assertHoursCall convertSecondsToWholeHours
argument assertHoursCall secondCount CSignedInt64 threeThousandSixHundredSixtyOne
run assertHoursCall
bind value hoursResult CSignedInt64 assertHoursCall
call checkHoursCall math.equalI64
argument checkHoursCall left I64 hoursResult
argument checkHoursCall right I64 oneHourCount
run checkHoursCall
bind value hoursOk Bool checkHoursCall
branch if condition hoursOk target hoursHolds
branch else target smokeAssertionFailed
label hoursHolds

# convertHoursToSeconds(2) == 7200
storage module immutable twoHourCount CSignedInt64 2
storage module immutable sevenThousandTwoHundredValue CSignedInt64 7200
call assertHoursToSecondsCall convertHoursToSeconds
argument assertHoursToSecondsCall hourCount CSignedInt64 twoHourCount
run assertHoursToSecondsCall
bind value hoursToSecondsResult CSignedInt64 assertHoursToSecondsCall
call checkHoursToSecondsCall math.equalI64
argument checkHoursToSecondsCall left I64 hoursToSecondsResult
argument checkHoursToSecondsCall right I64 sevenThousandTwoHundredValue
run checkHoursToSecondsCall
bind value hoursToSecondsOk Bool checkHoursToSecondsCall
branch if condition hoursToSecondsOk target hoursToSecondsHolds
branch else target smokeAssertionFailed
label hoursToSecondsHolds

# isGregorianLeapYear(2000) == true
storage module immutable yearTwoThousand CSignedInt64 2000
call assertLeapYear2000Call isGregorianLeapYear
argument assertLeapYear2000Call candidateYear CSignedInt64 yearTwoThousand
run assertLeapYear2000Call
bind value leap2000Result Bool assertLeapYear2000Call
branch if condition leap2000Result target leap2000Holds
branch else target smokeAssertionFailed
label leap2000Holds

# isGregorianLeapYear(1900) == false
storage module immutable yearNineteenHundred CSignedInt64 1900
call assertLeapYear1900Call isGregorianLeapYear
argument assertLeapYear1900Call candidateYear CSignedInt64 yearNineteenHundred
run assertLeapYear1900Call
bind value leap1900Result Bool assertLeapYear1900Call
branch if condition leap1900Result target smokeAssertionFailed

# isGregorianLeapYear(2024) == true
storage module immutable yearTwoThousandTwentyFour CSignedInt64 2024
call assertLeapYear2024Call isGregorianLeapYear
argument assertLeapYear2024Call candidateYear CSignedInt64 yearTwoThousandTwentyFour
run assertLeapYear2024Call
bind value leap2024Result Bool assertLeapYear2024Call
branch if condition leap2024Result target leap2024Holds
branch else target smokeAssertionFailed
label leap2024Holds

# ============================================================
# Extended unit tests: coverage for the 3 ops the smoke previously
# omitted (convertSecondsToWholeMinutes, convertMinutesToSeconds,
# convertUnixEpochSecondsToDays) plus boundary leap-year cases.
# ============================================================

storage module immutable zeroSecondsValue CSignedInt64 0
storage module immutable oneTwentySeconds CSignedInt64 120
storage module immutable twoMinutes CSignedInt64 2
storage module immutable fiftyNineSeconds CSignedInt64 59
storage module immutable threeMinutes CSignedInt64 3
storage module immutable oneEightyValue CSignedInt64 180
storage module immutable oneFullDaySeconds CSignedInt64 86400
storage module immutable oneDayCount CSignedInt64 1
storage module immutable yearTwentyTwentyThree CSignedInt64 2023
storage module immutable yearTwoFourHundred CSignedInt64 2400

# convertSecondsToWholeMinutes(120) == 2
call minFromSecCall convertSecondsToWholeMinutes
argument minFromSecCall secondCount CSignedInt64 oneTwentySeconds
run minFromSecCall
bind value minFromSecResult CSignedInt64 minFromSecCall
call checkMinFromSecCall math.equalI64
argument checkMinFromSecCall left I64 minFromSecResult
argument checkMinFromSecCall right I64 twoMinutes
run checkMinFromSecCall
bind value minFromSecOk Bool checkMinFromSecCall
branch if condition minFromSecOk target minFromSecHolds
branch else target smokeAssertionFailed
label minFromSecHolds

# convertSecondsToWholeMinutes(59) == 0 (truncation boundary)
call minFromSecZeroCall convertSecondsToWholeMinutes
argument minFromSecZeroCall secondCount CSignedInt64 fiftyNineSeconds
run minFromSecZeroCall
bind value minFromSecZeroResult CSignedInt64 minFromSecZeroCall
call checkMinFromSecZeroCall math.equalI64
argument checkMinFromSecZeroCall left I64 minFromSecZeroResult
argument checkMinFromSecZeroCall right I64 zeroSecondsValue
run checkMinFromSecZeroCall
bind value minFromSecZeroOk Bool checkMinFromSecZeroCall
branch if condition minFromSecZeroOk target minFromSecZeroHolds
branch else target smokeAssertionFailed
label minFromSecZeroHolds

# convertMinutesToSeconds(3) == 180
call secFromMinCall convertMinutesToSeconds
argument secFromMinCall minuteCount CSignedInt64 threeMinutes
run secFromMinCall
bind value secFromMinResult CSignedInt64 secFromMinCall
call checkSecFromMinCall math.equalI64
argument checkSecFromMinCall left I64 secFromMinResult
argument checkSecFromMinCall right I64 oneEightyValue
run checkSecFromMinCall
bind value secFromMinOk Bool checkSecFromMinCall
branch if condition secFromMinOk target secFromMinHolds
branch else target smokeAssertionFailed
label secFromMinHolds

# convertMinutesToSeconds(0) == 0
call secFromZeroMinCall convertMinutesToSeconds
argument secFromZeroMinCall minuteCount CSignedInt64 zeroSecondsValue
run secFromZeroMinCall
bind value secFromZeroMinResult CSignedInt64 secFromZeroMinCall
call checkSecFromZeroMinCall math.equalI64
argument checkSecFromZeroMinCall left I64 secFromZeroMinResult
argument checkSecFromZeroMinCall right I64 zeroSecondsValue
run checkSecFromZeroMinCall
bind value secFromZeroMinOk Bool checkSecFromZeroMinCall
branch if condition secFromZeroMinOk target secFromZeroMinHolds
branch else target smokeAssertionFailed
label secFromZeroMinHolds

# convertUnixEpochSecondsToDays(86400) == 1
call daysCall convertUnixEpochSecondsToDays
argument daysCall unixEpochSeconds CSignedInt64 oneFullDaySeconds
run daysCall
bind value daysResult CSignedInt64 daysCall
call checkDaysCall math.equalI64
argument checkDaysCall left I64 daysResult
argument checkDaysCall right I64 oneDayCount
run checkDaysCall
bind value daysOk Bool checkDaysCall
branch if condition daysOk target daysHolds
branch else target smokeAssertionFailed
label daysHolds

# convertSecondsToWholeHours(0) == 0
call hoursZeroCall convertSecondsToWholeHours
argument hoursZeroCall secondCount CSignedInt64 zeroSecondsValue
run hoursZeroCall
bind value hoursZeroResult CSignedInt64 hoursZeroCall
call checkHoursZeroCall math.equalI64
argument checkHoursZeroCall left I64 hoursZeroResult
argument checkHoursZeroCall right I64 zeroSecondsValue
run checkHoursZeroCall
bind value hoursZeroOk Bool checkHoursZeroCall
branch if condition hoursZeroOk target hoursZeroHolds
branch else target smokeAssertionFailed
label hoursZeroHolds

# isGregorianLeapYear(2023) == false (typical non-leap)
call leap2023Call isGregorianLeapYear
argument leap2023Call candidateYear CSignedInt64 yearTwentyTwentyThree
run leap2023Call
bind value leap2023Result Bool leap2023Call
branch if condition leap2023Result target smokeAssertionFailed
branch else target leap2023Holds
label leap2023Holds

# isGregorianLeapYear(2400) == true (divisible by 400, the century leap rule)
call leap2400Call isGregorianLeapYear
argument leap2400Call candidateYear CSignedInt64 yearTwoFourHundred
run leap2400Call
bind value leap2400Result Bool leap2400Call
branch if condition leap2400Result target leap2400Holds
branch else target smokeAssertionFailed
label leap2400Holds

# Exercise the OS-time wrappers. We don't assert their values
# (non-deterministic across runs), but we DO branchIf on each
# returned value so the bind is "used" â€” the linter would otherwise
# flag the bind as dead. Either branch lands at the same label.
call exerciseCpuClockCall readProcessCpuClockTicks
run exerciseCpuClockCall
bind value cpuClockTicksObserved CSignedInt64 exerciseCpuClockCall
branch if condition cpuClockTicksObserved target cpuClockExercised
branch else target cpuClockExercised
label cpuClockExercised

call exerciseUnixTimeCall readCurrentUnixEpochSeconds
run exerciseUnixTimeCall
bind value unixEpochSecondsObserved CSignedInt64 exerciseUnixTimeCall
branch if condition unixEpochSecondsObserved target unixTimeExercised
branch else target unixTimeExercised
label unixTimeExercised

storage module immutable successMessageText CNullTerminatedByteString "OK"
call writeSuccessLineCall console.writeLine
argument writeSuccessLineCall console Console console
argument writeSuccessLineCall text CNullTerminatedByteString successMessageText
run writeSuccessLineCall
ignore ok source writeSuccessLineCall type CSignedInt32
bind error consoleWriteResultError CSignedInt32 writeSuccessLineCall
branch error source writeSuccessLineCall target consoleWriteFailedHandler
storage module immutable exitOkCode ExitCode 0
return ok exitOkCode

# Failure leg: surface the raw negative CSignedInt32 from
# console.writeLine as the cause attached to the typed
# MainError.ConsoleWriteFailed variant.
label consoleWriteFailedHandler
makeError consoleWriteFailedFailure MainError.ConsoleWriteFailed consoleWriteResultError
return error consoleWriteFailedFailure
label smokeAssertionFailed
makeError timeSmokeFailure MainError.TimeSmokeAssertionFailed
return error timeSmokeFailure
