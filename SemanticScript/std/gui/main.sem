# ============================================================
# SEMANTICSCRIPT STANDARD LIBRARY: declarative GUI namespace
# ============================================================
#
# Import this module with:
#
#   importModule gui standard.gui
#
# The `gui.*` call targets are compiler/runtime-owned intrinsics for the
# declarative Windows GUI target. This module owns the official
# standard-library import path, declarative row vocabulary, semantic handle
# aliases, event/control/layout token sets, handler ABI types, runtime target
# names, status codes, and reusable capability contracts for that intrinsic
# namespace.
#
# Compiler contract:
#   - parse the declarative rows;
#   - validate references, token membership, and handler signatures against
#     the names and closed sets below;
#   - lower valid declarations into runtime config IDs and gui.* calls.
#
# The compiler should not need to own GUI design semantics beyond the minimal
# mechanics above. This file is the human-readable contract layer.

module standard.gui
modulePurpose standard.gui "Standard-library namespace and contracts for declarative GUI application, window, control, event, and runtime-call intrinsics."
moduleOwns standard.gui "The official import path `standard.gui`, GUI declaration vocabulary, semantic GUI handle aliases, reusable GUI capabilities, closed GUI token sets, status-code names, and the compiler-owned `gui.*` intrinsic namespace contract."
moduleDoesNotOwn standard.gui "Application GUI graphs, event handler implementations, native Win32 runtime internals, platform message-loop internals, generated application configuration tables, or diagnostics text."
moduleInvariant standard.gui "The standard module entry is this file; new GUI modules import it as alias `gui` before using compiler-owned targets in the `gui.*` namespace."
moduleInvariant standard.gui "Parser and runtime implementations may mirror the numeric IDs below, but the vocabulary and user-facing semantics belong to `standard.gui`."

type GuiApplication COpaqueMemoryAddress
type GuiSession COpaqueMemoryAddress
type GuiEvent COpaqueMemoryAddress
type GuiWindow COpaqueMemoryAddress
type GuiControl COpaqueMemoryAddress
type GuiButton GuiControl
type GuiTextBox GuiControl
type GuiListBox GuiControl
type GuiCheckBox GuiControl
type GuiMenuItem GuiControl
type GuiStatusBar GuiControl
type GuiTextLabel GuiControl
type GuiWindowId CUnsignedInt32
type GuiControlId CUnsignedInt32
type GuiText CNullTerminatedByteString
type GuiApplicationTitle GuiText
type GuiWindowTitle GuiText
type GuiControlText GuiText
type GuiPlaceholderText GuiText
type GuiAccessibleName GuiText
type GuiListBoxItemText GuiText
type GuiIconGroupName CNullTerminatedByteString
type GuiPixels CSignedInt32
type GuiMinimumPixels GuiPixels
type GuiTabIndex CSignedInt32
type GuiKeyCode CSignedInt32
type GuiSelectedIndex CSignedInt32
type GuiEventDimensionPixels GuiPixels
type GuiHandlerStatus CSignedInt32
type GuiRuntimeStatusCode CSignedInt32
type GuiDeclarationVerb CNullTerminatedByteString
type GuiKeywordToken CNullTerminatedByteString
type GuiRuntimeTarget CNullTerminatedByteString

enum GuiTargetKind repr CSignedInt32
enumCase GuiTargetKind windowGuiTargetKind 1
enumCase GuiTargetKind controlGuiTargetKind 2

enum GuiWindowLayout repr CSignedInt32
enumCase GuiWindowLayout defaultGuiWindowLayout 0
enumCase GuiWindowLayout verticalStackGuiWindowLayout 1
enumCase GuiWindowLayout horizontalStackGuiWindowLayout 2
enumCase GuiWindowLayout gridGuiWindowLayout 3
enumCase GuiWindowLayout absoluteGuiWindowLayout 4

enum GuiControlKind repr CSignedInt32
enumCase GuiControlKind buttonGuiControlKind 1
enumCase GuiControlKind textBoxGuiControlKind 2
enumCase GuiControlKind listBoxGuiControlKind 3
enumCase GuiControlKind checkBoxGuiControlKind 4
enumCase GuiControlKind menuItemGuiControlKind 5
enumCase GuiControlKind statusBarGuiControlKind 6
enumCase GuiControlKind textLabelGuiControlKind 7

enum GuiListBoxSelectionMode repr CSignedInt32
enumCase GuiListBoxSelectionMode defaultGuiListBoxSelectionMode 0
enumCase GuiListBoxSelectionMode singleGuiListBoxSelectionMode 1
enumCase GuiListBoxSelectionMode multipleGuiListBoxSelectionMode 2

enum GuiEventKind repr CSignedInt32
enumCase GuiEventKind clickGuiEventKind 1
enumCase GuiEventKind valueChangedGuiEventKind 2
enumCase GuiEventKind selectionChangedGuiEventKind 3
enumCase GuiEventKind enterPressedGuiEventKind 4
enumCase GuiEventKind keyPressedGuiEventKind 5
enumCase GuiEventKind focusGainedGuiEventKind 6
enumCase GuiEventKind focusLostGuiEventKind 7
enumCase GuiEventKind closeRequestedGuiEventKind 8
enumCase GuiEventKind resizedGuiEventKind 9
enumCase GuiEventKind shownGuiEventKind 10
enumCase GuiEventKind hiddenGuiEventKind 11

enum GuiRuntimeStatus repr CSignedInt32
enumCase GuiRuntimeStatus okGuiRuntimeStatus 0
enumCase GuiRuntimeStatus configGuiRuntimeStatus 1
enumCase GuiRuntimeStatus runtimeUnavailableGuiRuntimeStatus 2
enumCase GuiRuntimeStatus allocationGuiRuntimeStatus 3
enumCase GuiRuntimeStatus platformGuiRuntimeStatus 4
enumCase GuiRuntimeStatus notFoundGuiRuntimeStatus 5
enumCase GuiRuntimeStatus wrongKindGuiRuntimeStatus 6
enumCase GuiRuntimeStatus handlerGuiRuntimeStatus 7
enumCase GuiRuntimeStatus unsupportedGuiRuntimeStatus 8
enumCase GuiRuntimeStatus threadGuiRuntimeStatus 9

