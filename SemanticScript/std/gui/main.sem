enum GuiEventKind repr CSignedInt32
enumCase GuiEventKind clickGuiEventKind 1
enumCase GuiEventKind valueChangedGuiEventKind 2
enumCase GuiEventKind selectionChangedGuiEventKind 3
enumCase GuiEventKind enterPressedGuiEventKind 4
enumCase GuiEventKind keyPressedGuiEventKind 5
enumCase GuiEventKind focusGainedGuiEventKind 6
enumCase GuiEventKind focusLostGuiEventKind 7
enumCase GuiEventKind closeRequestedGuiEventKind 8
enumCase GuiEventKind resizedGuiEventKind 9
enumCase GuiEventKind shownGuiEventKind 10
enumCase GuiEventKind hiddenGuiEventKind 11

enum GuiRuntimeStatus repr CSignedInt32
enumCase GuiRuntimeStatus okGuiRuntimeStatus 0
enumCase GuiRuntimeStatus configGuiRuntimeStatus 1
enumCase GuiRuntimeStatus runtimeUnavailableGuiRuntimeStatus 2
enumCase GuiRuntimeStatus allocationGuiRuntimeStatus 3
enumCase GuiRuntimeStatus platformGuiRuntimeStatus 4
enumCase GuiRuntimeStatus notFoundGuiRuntimeStatus 5
enumCase GuiRuntimeStatus wrongKindGuiRuntimeStatus 6
enumCase GuiRuntimeStatus handlerGuiRuntimeStatus 7
enumCase GuiRuntimeStatus unsupportedGuiRuntimeStatus 8
enumCase GuiRuntimeStatus threadGuiRuntimeStatus 9

