typeInvariant GuiApplication "Opaque application builder/runtime handle returned by gui.applicationCreate."
typeInvariant GuiSession "Opaque runtime session token passed to GUI event handlers and every gui.* call that touches live GUI state."
typeInvariant GuiEvent "Opaque runtime event token passed to GUI event handlers and event-reader calls."
typeInvariant GuiWindow "Opaque window builder/runtime handle returned by gui.windowCreate."
typeInvariant GuiControl "Common opaque control handle alias shared by GUI control kinds."
typeInvariant GuiButton "Opaque button control handle returned by gui.buttonCreate."
typeInvariant GuiTextBox "Opaque text-box control handle returned by gui.textBoxCreate."
typeInvariant GuiListBox "Opaque list-box control handle returned by gui.listBoxCreate."
typeInvariant GuiCheckBox "Opaque check-box control handle reserved for a future gui.checkBoxCreate function."
typeInvariant GuiMenuItem "Opaque menu-item control handle reserved for a future gui.menuItemCreate function."
typeInvariant GuiStatusBar "Opaque status-bar control handle reserved for a future gui.statusBarCreate function."
typeInvariant GuiTextLabel "Opaque static text-label control handle returned by gui.textLabelCreate."
typeInvariant GuiWindowId "Stable unsigned runtime window ID emitted into the native GUI config table."
typeInvariant GuiControlId "Stable unsigned runtime control ID emitted into the native GUI config table."
typeInvariant GuiText "Null-terminated UTF-8 text crossing the SemanticScript GUI boundary; the runtime converts at the platform boundary as needed."
typeInvariant GuiApplicationTitle "Application title text passed to gui.applicationCreate."
typeInvariant GuiWindowTitle "Window title text passed to gui.windowCreate."
typeInvariant GuiControlText "Visible control text passed to control creation functions such as gui.buttonCreate and gui.textLabelCreate."
typeInvariant GuiPlaceholderText "Placeholder text passed to gui.textBoxCreate."
typeInvariant GuiAccessibleName "Assistive-technology name reserved for future control accessibility functions."
typeInvariant GuiListBoxItemText "List-box item text passed to gui.listBoxAppendItem."
typeInvariant GuiIconGroupName "Name of an icon registry group reserved for future application icon functions."
typeInvariant GuiPixels "Positive pixel count used by window creation functions and event size readers."
typeInvariant GuiMinimumPixels "Positive minimum-size pixel count; must not exceed the matching initial window dimension."
typeInvariant GuiTabIndex "Non-negative tab order index scoped to one window."
typeInvariant GuiKeyCode "Platform-normalized key code read from a keyPressed GUI event."
typeInvariant GuiSelectedIndex "Zero-based list-box selected index; -1 means no selection."
typeInvariant GuiEventDimensionPixels "Window dimension read from a resized GUI event."
typeInvariant GuiHandlerStatus "GUI handlers return 0 for handled successfully; non-zero reports runtime-level event failure."
typeInvariant GuiRuntimeStatusCode "Runtime status code returned by gui.* calls that can fail."
typeInvariant GuiKeywordToken "Canonical text for a closed GUI token such as an event kind, layout, selection mode, or yes/no value."
typeInvariant GuiRuntimeTarget "Canonical dotted call target in the compiler/runtime-owned gui.* namespace."
typeInvariant GuiTargetKind "Closed runtime event target set: window or control."
typeInvariant GuiWindowLayout "Closed layout token set passed to gui.windowCreate."
typeInvariant GuiControlKind "Closed control-kind set for per-kind GUI control declarators."
typeInvariant GuiListBoxSelectionMode "Closed list-box selection mode set passed to gui.listBoxCreate."
typeInvariant GuiEventKind "Closed GUI event token set reserved for event registration functions."
typeInvariant GuiRuntimeStatus "Closed status-code set returned by the native GUI runtime."

capability guiTextBoxReader gui.control.textBox.text read
capability guiTextBoxWriter gui.control.textBox.text write
capability guiListBoxItemsReader gui.control.listBox.items read
capability guiListBoxWriter gui.control.listBox.items write
capability guiListBoxSelectionReader gui.control.listBox.selection read
capability guiTextLabelWriter gui.control.textLabel.text write
capability guiCheckBoxReader gui.control.checkBox.checked read
capability guiCheckBoxWriter gui.control.checkBox.checked write
capability guiWindowWriter gui.window write
capability guiEventReader gui.event read
capability guiEventCloseWriter gui.event.close write
capability guiControlEventWriter gui.control.event write

storage module immutable guiModuleVersionText CNullTerminatedByteString "standard.gui 0.1"
storage module immutable guiTargetRuntimeToken GuiKeywordToken "windowsGui"

# Closed token spellings used by GUI functions and event handlers.
storage module immutable yesGuiKeywordToken GuiKeywordToken "yes"
storage module immutable noGuiKeywordToken GuiKeywordToken "no"
storage module immutable verticalStackGuiKeywordToken GuiKeywordToken "verticalStack"
storage module immutable horizontalStackGuiKeywordToken GuiKeywordToken "horizontalStack"
storage module immutable gridGuiKeywordToken GuiKeywordToken "grid"
storage module immutable absoluteGuiKeywordToken GuiKeywordToken "absolute"
storage module immutable singleGuiKeywordToken GuiKeywordToken "single"
storage module immutable multipleGuiKeywordToken GuiKeywordToken "multiple"
storage module immutable clickGuiKeywordToken GuiKeywordToken "click"
storage module immutable valueChangedGuiKeywordToken GuiKeywordToken "valueChanged"
storage module immutable selectionChangedGuiKeywordToken GuiKeywordToken "selectionChanged"
storage module immutable enterPressedGuiKeywordToken GuiKeywordToken "enterPressed"
storage module immutable keyPressedGuiKeywordToken GuiKeywordToken "keyPressed"
storage module immutable focusGainedGuiKeywordToken GuiKeywordToken "focusGained"
storage module immutable focusLostGuiKeywordToken GuiKeywordToken "focusLost"
storage module immutable closeRequestedGuiKeywordToken GuiKeywordToken "closeRequested"
storage module immutable resizedGuiKeywordToken GuiKeywordToken "resized"
storage module immutable shownGuiKeywordToken GuiKeywordToken "shown"
storage module immutable hiddenGuiKeywordToken GuiKeywordToken "hidden"

# Runtime call target vocabulary. Construction calls create opaque handles.
# Operations that touch live GUI state require a GuiSession argument;
# event-reader operations require a GuiEvent argument.
storage module immutable guiApplicationCreateTarget GuiRuntimeTarget "gui.applicationCreate"
storage module immutable guiWindowCreateTarget GuiRuntimeTarget "gui.windowCreate"
storage module immutable guiTextLabelCreateTarget GuiRuntimeTarget "gui.textLabelCreate"
storage module immutable guiTextBoxCreateTarget GuiRuntimeTarget "gui.textBoxCreate"
storage module immutable guiButtonCreateTarget GuiRuntimeTarget "gui.buttonCreate"
storage module immutable guiListBoxCreateTarget GuiRuntimeTarget "gui.listBoxCreate"
storage module immutable guiWindowAddControlTarget GuiRuntimeTarget "gui.windowAddControl"
storage module immutable guiControlOnEventTarget GuiRuntimeTarget "gui.controlOnEvent"
storage module immutable guiApplicationSetMainWindowTarget GuiRuntimeTarget "gui.applicationSetMainWindow"
storage module immutable guiApplicationRunTarget GuiRuntimeTarget "gui.applicationRun"
storage module immutable guiTextBoxTextTarget GuiRuntimeTarget "gui.textBoxText"
storage module immutable guiTextBoxSetTextTarget GuiRuntimeTarget "gui.textBoxSetText"
storage module immutable guiListBoxSelectedIndexTarget GuiRuntimeTarget "gui.listBoxSelectedIndex"
storage module immutable guiListBoxAppendItemTarget GuiRuntimeTarget "gui.listBoxAppendItem"
storage module immutable guiListBoxClearTarget GuiRuntimeTarget "gui.listBoxClear"
storage module immutable guiTextLabelSetTextTarget GuiRuntimeTarget "gui.textLabelSetText"
storage module immutable guiWindowCloseTarget GuiRuntimeTarget "gui.windowClose"
storage module immutable guiEventKeyCodeTarget GuiRuntimeTarget "gui.eventKeyCode"
storage module immutable guiEventSelectedIndexTarget GuiRuntimeTarget "gui.eventSelectedIndex"
storage module immutable guiEventWindowWidthTarget GuiRuntimeTarget "gui.eventWindowWidth"
storage module immutable guiEventWindowHeightTarget GuiRuntimeTarget "gui.eventWindowHeight"
storage module immutable guiEventCancelCloseTarget GuiRuntimeTarget "gui.eventCancelClose"

storage module immutable guiHandlerSuccessStatus GuiHandlerStatus 0
storage module immutable guiHandlerFailureStatus GuiHandlerStatus 1
storage module immutable guiInvalidSelectedIndex GuiSelectedIndex -1
