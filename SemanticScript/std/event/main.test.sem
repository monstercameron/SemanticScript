# SEMANTICSCRIPT STANDARD LIBRARY TESTS: event module contracts
#
# This self-test intentionally avoids importing standard.event because the JIT
# path can still try to resolve native runtimeBinding externs from imported but
# uncalled operations. The executable app smoke test under apps/event-stream-smoke
# exercises event calls through start/await and inspect-IR link coverage.

project StandardEventSmoke
target console
runtime native 1
entry console main

module standard.event.test
purpose module standard.event.test "Keep a stdlib self-test placeholder for standard.event without importing native runtime bindings in JIT mode."
moduleOwns standard.event.test "A lightweight stdlib self-test placeholder that keeps the module's test-file convention present."
moduleDoesNotOwn standard.event.test "Native event runtime execution; app tests own that coverage."
invariant module standard.event.test "The test prints OK; standard.event native import coverage lives in compiler/app IR tests."

capability consoleStdoutWriter console.stdout write
purpose operation consoleStdoutWriter "Authority to write the standard event smoke result to stdout."

storage module immutable okText String "OK"
storage module immutable successExitCode ExitCode 0

operation main
input operation main console Console
output operation main ExitCode
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Print OK for the standard.event self-test placeholder."
invariant operation main "Do not import standard.event here until JIT unresolved-native extern handling is fixed."
useCapability main consoleStdoutWriter

call printOkCall console.writeLine
argument printOkCall text String okText
run printOkCall
ignore void source printOkCall
bind error printOkError Int32 printOkCall
branch error source printOkCall target printOkFailed
return value successExitCode
label printOkFailed
return value printOkError
