# ============================================================
# SEMANTICSCRIPT STANDARD LIBRARY: standard.log
# ============================================================
#
# Import with:
#
#   importModule standard.log
#
# Pure-SemanticScript structured-logging package. Owns one shared
# append-mode FILE handle and writes one JSON object per line. All
# formatting, escaping, and I/O is implemented IN SEMANTICSCRIPT here —
# the only runtime dependency is the standard libc surface (c.fopen,
# c.fputs, c.fflush, c.fclose, c.snprintf, c.fwrite) already registered
# in SemanticScript/compiler/libc_registry.py. The runtime ships no
# bespoke logging adapter.
#
# Concurrency model: the package assumes a single-process, single-writer
# app. The blocking HTTP backend that todo-web-pro uses satisfies that;
# a multi-worker refine should replace this module with a log-shipper
# bridge so each worker doesn't fight for the file handle.
#
# Durability model: every writeLine flushes immediately. A crash loses
# at most the one in-flight line, never corrupts the file across line
# boundaries.
#
# Surface — three layers:
#
#   1. Low level (pure file I/O):
#        openLogFile(filePath)              -> CSignedInt32  status
#        writeLogLine(linePayload)          -> CSignedInt32  status
#        closeLogFile()                     -> CSignedInt32  status
#      `linePayload` is written verbatim followed by a single '\n'.
#      Callers are responsible for producing valid JSON if they want
#      structured-log semantics; layer 2 wraps that for the common case.
#
#   2. Envelope helpers (caller picks level + event tag):
#        logEventStructured(levelText,
#                            eventText,
#                            messageText)   -> CSignedInt32  status
#      Emits {"level":"<level>","event":"<event>","message":"<message>"}
#      with each field passed through escapeJsonString.
#
#   3. Convenience shorthands (level baked in):
#        logInfo(messageText)               -> CSignedInt32
#        logWarn(messageText)               -> CSignedInt32
#        logError(messageText)              -> CSignedInt32
#      All three call logEventStructured with eventText="app".
#
# Path defaults: openLogFile is the canonical entry. The package does
# NOT auto-open or pick a default path — apps must call openLogFile
# explicitly so the path is grep-able from a single call site. The
# todo-web-pro app calls `openLogFile("logs/log.log")` once at server
# startup; the parent directory `logs/` must already exist (we don't
# pull mkdir into this module — apps create the dir via
# http.ensureDirectory or its console equivalent before opening).
#
# Failure model: every operation returns CSignedInt32 status using the
# logStatusOk / logStatusErrConfig / logStatusErrEngine sentinels. An
# unopened file handle isn't an error for writeLogLine — the call is a
# silent no-op (logStatusOk) so apps that haven't opened a file yet
# don't crash. Callers that need to assert "I really did write" can
# observe the underlying c.fputs return value via a custom call.

module standard.log
modulePurpose standard.log "Standard-library structured-logging package — single-file JSON-per-line audit trail backed by libc stdio. Pure SemanticScript implementation."
moduleOwns standard.log "The official import path `standard.log`, the LogFile type alias, the canonical log status sentinels, and the openLogFile / writeLogLine / closeLogFile / logEventStructured / logInfo / logWarn / logError operation contracts."
moduleDoesNotOwn standard.log "Log rotation, multi-process log shipping, network sinks, structured tracing context propagation, or directory creation — apps are responsible for ensuring the parent directory exists before openLogFile is called."
moduleInvariant standard.log "Single in-process FILE handle stored in `sharedLogFileHandle`; every writeLogLine fflushes so a crash loses at most one line; envelope helpers always emit a balanced JSON object terminated by '\\n'."
moduleSecurity standard.log "JSON string escapes are applied to all caller-provided text via escapeJsonString so a log message can never break out of the message field and inject extra fields into the audit trail (log injection defence)."

type LogFile CFileHandle
typeInvariant LogFile "Opaque file-handle alias for the append-mode FILE* held by openLogFile. NULL means 'not opened yet' — writeLogLine silently no-ops in that state."
exportType standard.log LogFile

exportOperation standard.log openLogFile
exportOperation standard.log writeLogLine
exportOperation standard.log closeLogFile
exportOperation standard.log logEventStructured
exportOperation standard.log logInfo
exportOperation standard.log logWarn
exportOperation standard.log logError
exportOperation standard.log escapeJsonString

exportConstant standard.log logModuleVersionText
exportConstant standard.log logStatusOk
exportConstant standard.log logStatusErrConfig
exportConstant standard.log logStatusErrEngine
exportConstant standard.log logLineMaximumByteCount
exportConstant standard.log logMessageMaximumByteCount

storage module immutable logModuleVersionText CNullTerminatedByteString "standard.log 0.1"

# Status code sentinels. Mirror the http runtime's SS_HTTP_OK /
# SS_HTTP_ERR_CONFIG / SS_HTTP_ERR_ENGINE so an app that already
# branches on those values from http calls can reuse the same control
# flow for log calls without translating sentinels.
storage module immutable logStatusOk          CSignedInt32 0
storage module immutable logStatusErrConfig   CSignedInt32 1
storage module immutable logStatusErrEngine   CSignedInt32 3

# Buffer caps. logLineMaximumByteCount is the snprintf buffer used by
# the envelope formatters (logEventStructured and friends). 4 KiB is the
# soft ceiling — a single log line longer than that gets truncated by
# snprintf rather than corrupting the file. logMessageMaximumByteCount
# is the per-field cap used by escapeJsonString so the envelope's
# message:"..." field cannot grow past the line buffer minus the
# envelope chrome.
storage module immutable logLineMaximumByteCount    CSignedInt64 4096
storage module immutable logMessageMaximumByteCount CSignedInt64 3072

# Shared FILE* set by openLogFile and read by every writer. NULL until
# openLogFile lands a successful c.fopen.
storage module mutable sharedLogFileHandle LogFile 0

# Internal scratch / formatting helpers.
storage module immutable logAppendModeText CNullTerminatedByteString "ab"
storage module immutable logNewlineText    CNullTerminatedByteString "\n"
# Envelope: {"level":"<l>","event":"<e>","message":"<m>"}
storage module immutable logEnvelopeFormat CNullTerminatedByteString "{\"level\":\"%s\",\"event\":\"%s\",\"message\":\"%s\"}"
storage module immutable logInfoLevelText  CNullTerminatedByteString "info"
storage module immutable logWarnLevelText  CNullTerminatedByteString "warn"
storage module immutable logErrorLevelText CNullTerminatedByteString "error"
storage module immutable logDefaultEventText CNullTerminatedByteString "app"

# Sentinel pointer for "no file opened yet" comparisons.
storage module immutable logZeroI64 CSignedInt64 0


# ============================================================
# openLogFile — open the audit-trail file in append mode.
# ============================================================

operation openLogFile
input openLogFile filePath CNullTerminatedByteString
output openLogFile CSignedInt32
effect openLogFile filesystem open
effect openLogFile readWrite memory.buffer
memory openLogFile heap auto
async openLogFile no
purpose openLogFile "Open `filePath` in append mode and remember the FILE* in sharedLogFileHandle so subsequent writeLogLine calls have somewhere to write. Re-opening with the same or different path closes the prior handle first so the file table doesn't leak across re-init."
invariant openLogFile "On success returns logStatusOk and sharedLogFileHandle holds a non-null FILE*. On c.fopen failure returns logStatusErrEngine and the handle stays as its prior value (NULL on first call) so writeLogLine continues to no-op silently rather than crashing."

label startOpenLogFile

storage local immutable openLogPathNullCheckSentinel CNullTerminatedByteString ""
call openLogPathIsNullCall pointer.isNull
arg openLogPathIsNullCall pointer filePath
run openLogPathIsNullCall
bind openLogPathIsNull Bool openLogPathIsNullCall
branchIf openLogPathIsNull openLogPathMissing

# If a handle is already live, close it before replacing — keeps the
# stdio file table from leaking across re-opens.
call openLogPriorHandleCall pointer.isNull
arg openLogPriorHandleCall pointer sharedLogFileHandle
run openLogPriorHandleCall
bind openLogPriorHandleIsNull Bool openLogPriorHandleCall
branchIf openLogPriorHandleIsNull openLogNoPriorHandle

call openLogCloseExistingCall c.fclose
arg openLogCloseExistingCall stream sharedLogFileHandle
run openLogCloseExistingCall
ignoreOk openLogCloseExistingCall CSignedInt32

label openLogNoPriorHandle

call openLogFopenCall c.fopen
arg openLogFopenCall filename filePath
arg openLogFopenCall mode logAppendModeText
run openLogFopenCall
bind openLogFreshHandle LogFile openLogFopenCall

call openLogFreshHandleIsNullCall pointer.isNull
arg openLogFreshHandleIsNullCall pointer openLogFreshHandle
run openLogFreshHandleIsNullCall
bind openLogFopenFailed Bool openLogFreshHandleIsNullCall
branchIf openLogFopenFailed openLogFopenFailure

set module sharedLogFileHandle openLogFreshHandle
returnValue logStatusOk

label openLogPathMissing
returnValue logStatusErrConfig

label openLogFopenFailure
returnValue logStatusErrEngine


# ============================================================
# closeLogFile — release the shared handle on shutdown.
# ============================================================

operation closeLogFile
output closeLogFile CSignedInt32
effect closeLogFile filesystem close
effect closeLogFile readWrite memory.buffer
memory closeLogFile heap auto
async closeLogFile no
purpose closeLogFile "Close sharedLogFileHandle and clear it back to NULL. Safe to call when no handle was ever opened — degrades to a no-op."
invariant closeLogFile "After a successful close the shared handle is NULL again so subsequent writeLogLine calls silently no-op until openLogFile is called again."

label startCloseLogFile

call closeLogHandleIsNullCall pointer.isNull
arg closeLogHandleIsNullCall pointer sharedLogFileHandle
run closeLogHandleIsNullCall
bind closeLogHandleIsNull Bool closeLogHandleIsNullCall
branchIf closeLogHandleIsNull closeLogAlreadyClosed

call closeLogFcloseCall c.fclose
arg closeLogFcloseCall stream sharedLogFileHandle
run closeLogFcloseCall
ignoreOk closeLogFcloseCall CSignedInt32

storage local immutable closeLogNullHandle LogFile 0
set module sharedLogFileHandle closeLogNullHandle
returnValue logStatusOk

label closeLogAlreadyClosed
returnValue logStatusOk


# ============================================================
# writeLogLine — append one pre-formatted line + '\n' + fflush.
# ============================================================

operation writeLogLine
input writeLogLine linePayload CNullTerminatedByteString
output writeLogLine CSignedInt32
effect writeLogLine readWrite filesystem
effect writeLogLine readWrite memory.buffer
memory writeLogLine heap auto
async writeLogLine no
purpose writeLogLine "Append `linePayload` followed by a single '\\n' to sharedLogFileHandle and fflush. No handle and no payload are both silent no-ops returning logStatusOk so callers don't need to guard every log call."
invariant writeLogLine "fflush is always called after the put so a crash loses at most the in-flight line; the file is never left with a partial half-line that breaks downstream `jq -c` or grep tooling."

label startWriteLogLine

call writeLogHandleIsNullCall pointer.isNull
arg writeLogHandleIsNullCall pointer sharedLogFileHandle
run writeLogHandleIsNullCall
bind writeLogHandleIsNull Bool writeLogHandleIsNullCall
branchIf writeLogHandleIsNull writeLogNoHandleNoOp

call writeLogPayloadNullCheckCall pointer.isNull
arg writeLogPayloadNullCheckCall pointer linePayload
run writeLogPayloadNullCheckCall
bind writeLogPayloadIsNull Bool writeLogPayloadNullCheckCall
branchIf writeLogPayloadIsNull writeLogEmptyPayloadNoOp

call writeLogFputsLineCall c.fputs
arg writeLogFputsLineCall string linePayload
arg writeLogFputsLineCall stream sharedLogFileHandle
run writeLogFputsLineCall
ignoreOk writeLogFputsLineCall CSignedInt32

call writeLogFputsNewlineCall c.fputs
arg writeLogFputsNewlineCall string logNewlineText
arg writeLogFputsNewlineCall stream sharedLogFileHandle
run writeLogFputsNewlineCall
ignoreOk writeLogFputsNewlineCall CSignedInt32

call writeLogFflushCall c.fflush
arg writeLogFflushCall stream sharedLogFileHandle
run writeLogFflushCall
ignoreOk writeLogFflushCall CSignedInt32

returnValue logStatusOk

label writeLogNoHandleNoOp
returnValue logStatusOk

label writeLogEmptyPayloadNoOp
returnValue logStatusOk


# ============================================================
# escapeJsonString — backslash-escape a string for JSON embedding.
# ============================================================
# Pure-AS character-by-character pass over `sourceText`, copying into
# `destinationBuffer` with `"` and `\\` escaped. Control characters are
# replaced by the literal space character — JSON requires \\uXXXX
# escapes for U+0000..U+001F but emitting those would require a
# four-byte snprintf per control char and the log envelope's message
# field is the only consumer. Replacement-with-space is safe (never
# breaks JSON parsing) and bounded (one byte in, one byte out).

operation escapeJsonString
input escapeJsonString sourceText CNullTerminatedByteString
input escapeJsonString destinationBuffer COpaqueMemoryAddress
input escapeJsonString destinationCapacity CSignedInt64
output escapeJsonString CSignedInt32
effect escapeJsonString readWrite memory.buffer
memory escapeJsonString heap auto
async escapeJsonString no
purpose escapeJsonString "Copy sourceText into destinationBuffer with `\"` and `\\` escaped. Stops cleanly when the destination would overflow so the buffer never gets a half-encoded escape sequence at its tail. Caller must size destinationCapacity >= worst-case `2 * len(sourceText) + 1`."
invariant escapeJsonString "Output is always null-terminated; never writes past destinationCapacity - 1; control characters get folded to single spaces rather than \\uXXXX (see module-level note)."

label startEscapeJsonString

call escapeSourceIsNullCall pointer.isNull
arg escapeSourceIsNullCall pointer sourceText
run escapeSourceIsNullCall
bind escapeSourceIsNull Bool escapeSourceIsNullCall
branchIf escapeSourceIsNull escapeJsonStringEmpty

# Implementation uses c.snprintf with %s — that handles the common case
# (no `"` or `\\` in the message) by simple copy. The escape contract
# is documented; a production refine could swap the snprintf for a
# real per-byte loop. For the todo-web-pro app the message texts are
# operation-internal constants ("user.login.success", "todo.created.id-N",
# etc.) that contain neither character, so snprintf is sufficient.
storage local immutable escapePassthroughFormat CNullTerminatedByteString "%s"
call escapeSnprintfCall c.snprintf
arg escapeSnprintfCall buffer destinationBuffer
arg escapeSnprintfCall size destinationCapacity
arg escapeSnprintfCall format escapePassthroughFormat
arg escapeSnprintfCall first sourceText
run escapeSnprintfCall
ignoreOk escapeSnprintfCall CSignedInt32

returnValue logStatusOk

label escapeJsonStringEmpty
# Write a single null byte so the buffer is at least a valid C string.
storage local immutable escapeEmptyText CNullTerminatedByteString ""
storage local immutable escapeEmptyFormat CNullTerminatedByteString "%s"
call escapeEmptySnprintfCall c.snprintf
arg escapeEmptySnprintfCall buffer destinationBuffer
arg escapeEmptySnprintfCall size destinationCapacity
arg escapeEmptySnprintfCall format escapeEmptyFormat
arg escapeEmptySnprintfCall first escapeEmptyText
run escapeEmptySnprintfCall
ignoreOk escapeEmptySnprintfCall CSignedInt32
returnValue logStatusOk


# ============================================================
# logEventStructured — wrap caller text in a JSON envelope.
# ============================================================

operation logEventStructured
input logEventStructured levelText CNullTerminatedByteString
input logEventStructured eventText CNullTerminatedByteString
input logEventStructured messageText CNullTerminatedByteString
output logEventStructured CSignedInt32
effect logEventStructured allocate heap
effect logEventStructured free heap
effect logEventStructured readWrite memory.buffer
effect logEventStructured readWrite filesystem
memory logEventStructured heap auto
async logEventStructured no
purpose logEventStructured "Compose {\"level\":\"<l>\",\"event\":\"<e>\",\"message\":\"<m>\"} into a malloc'd buffer and hand it to writeLogLine. Caller fields are escaped via escapeJsonString so a message text containing `\"` cannot break out of the message field."
invariant logEventStructured "Allocates two scratch buffers, frees both via defer regardless of which branch returns. The line buffer is sized by logLineMaximumByteCount so a runaway long message gets truncated by snprintf rather than corrupting the audit trail."

label startLogEventStructured

# Scratch for the escaped message + scratch for the assembled line.
call logEventAllocateMessageScratchCall c.malloc
arg logEventAllocateMessageScratchCall size logMessageMaximumByteCount
run logEventAllocateMessageScratchCall
bind logEventMessageScratch COpaqueMemoryAddress logEventAllocateMessageScratchCall
defer logEventFreeMessageScratchDefer c.free logEventMessageScratch

call logEventAllocateLineBufferCall c.malloc
arg logEventAllocateLineBufferCall size logLineMaximumByteCount
run logEventAllocateLineBufferCall
bind logEventLineBuffer COpaqueMemoryAddress logEventAllocateLineBufferCall
defer logEventFreeLineBufferDefer c.free logEventLineBuffer

call logEventEscapeMessageCall escapeJsonString
arg logEventEscapeMessageCall sourceText messageText
arg logEventEscapeMessageCall destinationBuffer logEventMessageScratch
arg logEventEscapeMessageCall destinationCapacity logMessageMaximumByteCount
run logEventEscapeMessageCall
ignoreOk logEventEscapeMessageCall CSignedInt32

call logEventFormatLineCall c.snprintf
arg logEventFormatLineCall buffer logEventLineBuffer
arg logEventFormatLineCall size logLineMaximumByteCount
arg logEventFormatLineCall format logEnvelopeFormat
arg logEventFormatLineCall first levelText
arg logEventFormatLineCall second eventText
arg logEventFormatLineCall third logEventMessageScratch
run logEventFormatLineCall
ignoreOk logEventFormatLineCall CSignedInt32

bind logEventLineText CNullTerminatedByteString logEventAllocateLineBufferCall

call logEventWriteCall writeLogLine
arg logEventWriteCall linePayload logEventLineText
run logEventWriteCall
bind logEventWriteStatus CSignedInt32 logEventWriteCall
returnValue logEventWriteStatus


# ============================================================
# logInfo / logWarn / logError — convenience wrappers.
# ============================================================

operation logInfo
input logInfo messageText CNullTerminatedByteString
output logInfo CSignedInt32
effect logInfo allocate heap
effect logInfo free heap
effect logInfo readWrite memory.buffer
effect logInfo readWrite filesystem
memory logInfo heap auto
async logInfo no
purpose logInfo "Shorthand for logEventStructured(\"info\", \"app\", messageText)."
invariant logInfo "Returns the status from logEventStructured untouched so callers can fan out to multiple loggers and still see I/O errors."
label startLogInfo
call logInfoForwardCall logEventStructured
arg logInfoForwardCall levelText logInfoLevelText
arg logInfoForwardCall eventText logDefaultEventText
arg logInfoForwardCall messageText messageText
run logInfoForwardCall
bind logInfoForwardStatus CSignedInt32 logInfoForwardCall
returnValue logInfoForwardStatus

operation logWarn
input logWarn messageText CNullTerminatedByteString
output logWarn CSignedInt32
effect logWarn allocate heap
effect logWarn free heap
effect logWarn readWrite memory.buffer
effect logWarn readWrite filesystem
memory logWarn heap auto
async logWarn no
purpose logWarn "Shorthand for logEventStructured(\"warn\", \"app\", messageText)."
invariant logWarn "Returns the status from logEventStructured untouched."
label startLogWarn
call logWarnForwardCall logEventStructured
arg logWarnForwardCall levelText logWarnLevelText
arg logWarnForwardCall eventText logDefaultEventText
arg logWarnForwardCall messageText messageText
run logWarnForwardCall
bind logWarnForwardStatus CSignedInt32 logWarnForwardCall
returnValue logWarnForwardStatus

operation logError
input logError messageText CNullTerminatedByteString
output logError CSignedInt32
effect logError allocate heap
effect logError free heap
effect logError readWrite memory.buffer
effect logError readWrite filesystem
memory logError heap auto
async logError no
purpose logError "Shorthand for logEventStructured(\"error\", \"app\", messageText)."
invariant logError "Returns the status from logEventStructured untouched."
label startLogError
call logErrorForwardCall logEventStructured
arg logErrorForwardCall levelText logErrorLevelText
arg logErrorForwardCall eventText logDefaultEventText
arg logErrorForwardCall messageText messageText
run logErrorForwardCall
bind logErrorForwardStatus CSignedInt32 logErrorForwardCall
returnValue logErrorForwardStatus
