# ============================================================
# SEMANTICSCRIPT STANDARD LIBRARY: standard.log
# ============================================================
#
# Import with:
#
#   import log standard.log
#
# Pure-SemanticScript structured-logging package. Owns one shared
# append-mode FILE handle and writes one JSON object per line. All
# formatting, escaping, and I/O is implemented IN SEMANTICSCRIPT here —
# the only runtime dependency is the standard libc surface (c.fopen,
# c.fputs, c.fflush, c.fclose, c.snprintf, c.fwrite) already registered
# in SemanticScript/compiler/libc_registry.py. The runtime ships no
# bespoke logging adapter.
#
# Concurrency model: the package assumes a single-process, single-writer
# app. The blocking HTTP backend that taskforge-web uses satisfies that;
# a multi-worker refine should replace this module with a log-shipper
# bridge so each worker doesn't fight for the file handle.
#
# Durability model: every writeLine flushes immediately. A crash loses
# at most the one in-flight line, never corrupts the file across line
# boundaries.
#
# Surface — three layers:
#
#   1. Low level (pure file I/O):
#        openLogFile(filePath)              -> Int32  status
#        writeLogLine(linePayload)          -> Int32  status
#        closeLogFile()                     -> Int32  status
#      `linePayload` is written verbatim followed by a single '\n'.
#      Callers are responsible for producing valid JSON if they want
#      structured-log semantics; layer 2 wraps that for the common case.
#
#   2. Envelope helpers (caller picks level + event tag):
#        logEventStructured(levelText,
#                            eventText,
#                            messageText)   -> Int32  status
#      Emits {"level":"<level>","event":"<event>","message":"<message>"}
#      with each field passed through escapeJsonString.
#
#   3. Convenience shorthands (level baked in):
#        logInfo(messageText)               -> Int32
#        logWarn(messageText)               -> Int32
#        logError(messageText)              -> Int32
#      All three call logEventStructured with eventText="app".
#
# Path defaults: openLogFile is the canonical entry. The package does
# NOT auto-open or pick a default path — apps must call openLogFile
# explicitly so the path is grep-able from a single call site. The
# taskforge-web app calls `openLogFile("logs/log.log")` once at server
# startup; the parent directory `logs/` must already exist (we don't
# pull mkdir into this module — apps create the dir via
# http.ensureDirectory or its console equivalent before opening).
#
# Failure model: every operation returns Int32 status using the
# logStatusOk / logStatusErrConfig / logStatusErrEngine sentinels. An
# unopened file handle isn't an error for writeLogLine — the call is a
# silent no-op (logStatusOk) so apps that haven't opened a file yet
# don't crash. Callers that need to assert "I really did write" can
# observe the underlying c.fputs return value via a custom call.

module standard.log
purpose module standard.log "Standard-library structured-logging package — single-file JSON-per-line audit trail backed by libc stdio. Pure SemanticScript implementation."
moduleOwns standard.log "The official import path `standard.log`, the LogFile type alias, the canonical log status sentinels, and the openLogFile / writeLogLine / closeLogFile / logEventStructured / logInfo / logWarn / logError operation contracts."
moduleDoesNotOwn standard.log "Log rotation, multi-process log shipping, network sinks, structured tracing context propagation, or directory creation — apps are responsible for ensuring the parent directory exists before openLogFile is called."
invariant module standard.log "Single in-process FILE handle stored in `sharedLogFileHandle`; every writeLogLine fflushes so a crash loses at most one line; envelope helpers always emit a balanced JSON object terminated by '\\n'."
moduleSecurity standard.log "JSON string escapes are applied to all caller-provided text via escapeJsonString so a log message can never break out of the message field and inject extra fields into the audit trail (log injection defence)."

type LogFile FileHandle
typeInvariant LogFile "Opaque file-handle alias for the append-mode FILE* held by openLogFile. NULL means 'not opened yet' — writeLogLine silently no-ops in that state."
exportType standard.log LogFile

exportOperation standard.log openLogFile
exportOperation standard.log writeLogLine
exportOperation standard.log closeLogFile
exportOperation standard.log logEventStructured
exportOperation standard.log logInfo
exportOperation standard.log logWarn
exportOperation standard.log logError
exportOperation standard.log escapeJsonString

exportConstant standard.log logModuleVersionText
exportConstant standard.log logStatusOk
exportConstant standard.log logStatusErrConfig
exportConstant standard.log logStatusErrEngine
exportConstant standard.log logLineMaximumByteCount
exportConstant standard.log logMessageMaximumByteCount

storage module immutable logModuleVersionText String "standard.log 0.1"

# Status code sentinels. Mirror the http runtime's SS_HTTP_OK /
# SS_HTTP_ERR_CONFIG / SS_HTTP_ERR_ENGINE so an app that already
# branches on those values from http calls can reuse the same control
# flow for log calls without translating sentinels.
storage module immutable logStatusOk Int32 0
storage module immutable logStatusErrConfig Int32 1
storage module immutable logStatusErrEngine Int32 3

# Buffer caps. logLineMaximumByteCount is the snprintf buffer used by
# the envelope formatters (logEventStructured and friends). 4 KiB is the
# soft ceiling — a single log line longer than that gets truncated by
# snprintf rather than corrupting the file. logMessageMaximumByteCount
# is the per-field cap used by escapeJsonString so the envelope's
# message:"..." field cannot grow past the line buffer minus the
# envelope chrome.
storage module immutable logLineMaximumByteCount Int64 4096
storage module immutable logMessageMaximumByteCount Int64 3072

# Shared FILE* set by openLogFile and read by every writer. NULL until
# openLogFile lands a successful c.fopen.
storage module mutable sharedLogFileHandle LogFile 0

# Internal scratch / formatting helpers.
storage module immutable logAppendModeText String "ab"
storage module immutable logNewlineText String "\n"
# Envelope: {"level":"<l>","event":"<e>","message":"<m>"}
storage module immutable logEnvelopeFormat String "{\"level\":\"%s\",\"event\":\"%s\",\"message\":\"%s\"}"
storage module immutable logInfoLevelText String "info"
storage module immutable logWarnLevelText String "warn"
storage module immutable logErrorLevelText String "error"
storage module immutable logDefaultEventText String "app"

# Sentinel pointer for "no file opened yet" comparisons.
storage module immutable logZeroInt64 Int64 0

# ============================================================
# Capabilities — scoped grants for the libc + filesystem effects the
# log operations declare. Each is `capability NAME SCOPE ACCESS` so the
# semlint coverage walk (which keys on (scope, access)) can match the
# matching `effect OP ACCESS SCOPE` row in each operation below.
# ============================================================
capability logFilesystemOpen filesystem open
purpose operation logFilesystemOpen "Authority to open the audit-log file via c.fopen."

capability logFilesystemClose filesystem close
purpose operation logFilesystemClose "Authority to close the audit-log file via c.fclose."

capability logFilesystemReadWrite filesystem readWrite
purpose operation logFilesystemReadWrite "Authority to read and write the open audit-log file (c.fputs and friends)."

capability logFileOpen file open
purpose operation logFileOpen "Authority to acquire a file handle (the libc-layer half of `filesystem open`)."

capability logFileClose file close
purpose operation logFileClose "Authority to release a file handle (the libc-layer half of `filesystem close`)."

capability logFilesystemRead filesystem read
purpose operation logFilesystemRead "Authority to read raw filesystem bytes (c.fopen in append modes needs this)."

capability logFilesystemWrite filesystem write
purpose operation logFilesystemWrite "Authority to write raw filesystem bytes (c.fopen in append modes needs this)."

capability logConsoleStdoutWrite console.stdout write
purpose operation logConsoleStdoutWrite "Authority for c.fputs to a FILE* that points at the log stream (the libc registry models this as a console.stdout write)."

capability logMemoryBufferReadWrite memory.buffer readWrite
purpose operation logMemoryBufferReadWrite "Authority to read and write the in-op scratch buffers used by the envelope formatters."

capability logHeapAllocate heap allocate
purpose operation logHeapAllocate "Authority to c.malloc the per-line envelope buffer in logEventStructured + logInfo/Warn/Error."

capability logHeapFree heap free
purpose operation logHeapFree "Authority to c.free the per-line envelope buffer at the matching defer in the same operations."

# ============================================================
# openLogFile — open the audit-trail file in append mode.
# ============================================================

operation openLogFile
input operation openLogFile filePath String
output operation openLogFile Int32
# Effect order is `effect OP ACCESS SCOPE`. c.fopen in append mode triggers
# multiple low-level effects; we declare each one so the lint's
# missingEffectDeclaration walk against the libc_registry shape is silent.
effect openLogFile open filesystem
effect openLogFile open file
effect openLogFile close file
effect openLogFile read filesystem
effect openLogFile write filesystem
effect openLogFile readWrite memory.buffer
useCapability openLogFile logFilesystemOpen
useCapability openLogFile logFileOpen
useCapability openLogFile logFileClose
useCapability openLogFile logFilesystemRead
useCapability openLogFile logFilesystemWrite
useCapability openLogFile logMemoryBufferReadWrite
memory openLogFile heap auto
async openLogFile no
purpose operation openLogFile "Open `filePath` in append mode and remember the FILE* in sharedLogFileHandle so subsequent writeLogLine calls have somewhere to write. Re-opening with the same or different path closes the prior handle first so the file table doesn't leak across re-init."
invariant operation openLogFile "On success returns logStatusOk and sharedLogFileHandle holds a non-null FILE*. On c.fopen failure returns logStatusErrEngine and the handle stays as its prior value (NULL on first call) so writeLogLine continues to no-op silently rather than crashing."

label startOpenLogFile

storage local immutable openLogPathNullCheckSentinel String ""
call openLogPathIsNullCall pointer.isNull
argument openLogPathIsNullCall pointer OpaquePointer filePath
run openLogPathIsNullCall
bind value openLogPathIsNull Bool openLogPathIsNullCall
branch if condition openLogPathIsNull target openLogPathMissing

# If a handle is already live, close it before replacing — keeps the
# stdio file table from leaking across re-opens.
call openLogPriorHandleCall pointer.isNull
argument openLogPriorHandleCall pointer OpaquePointer sharedLogFileHandle
run openLogPriorHandleCall
bind value openLogPriorHandleIsNull Bool openLogPriorHandleCall
branch if condition openLogPriorHandleIsNull target openLogNoPriorHandle

call openLogCloseExistingCall c.fclose
argument openLogCloseExistingCall stream LogFile sharedLogFileHandle
run openLogCloseExistingCall
ignore ok source openLogCloseExistingCall type Int32

label openLogNoPriorHandle

call openLogFopenCall c.fopen
argument openLogFopenCall filename String filePath
argument openLogFopenCall mode String logAppendModeText
run openLogFopenCall
bind value openLogFreshHandle LogFile openLogFopenCall

call openLogFreshHandleIsNullCall pointer.isNull
argument openLogFreshHandleIsNullCall pointer OpaquePointer openLogFreshHandle
run openLogFreshHandleIsNullCall
bind value openLogFopenFailed Bool openLogFreshHandleIsNullCall
branch if condition openLogFopenFailed target openLogFopenFailure

set storage sharedLogFileHandle openLogFreshHandle
return value logStatusOk

label openLogPathMissing
return value logStatusErrConfig

label openLogFopenFailure
return value logStatusErrEngine

# ============================================================
# closeLogFile — release the shared handle on shutdown.
# ============================================================

operation closeLogFile
output operation closeLogFile Int32
effect closeLogFile close filesystem
effect closeLogFile close file
effect closeLogFile readWrite memory.buffer
useCapability closeLogFile logFilesystemClose
useCapability closeLogFile logFileClose
useCapability closeLogFile logMemoryBufferReadWrite
memory closeLogFile heap auto
async closeLogFile no
purpose operation closeLogFile "Close sharedLogFileHandle and clear it back to NULL. Safe to call when no handle was ever opened — degrades to a no-op."
invariant operation closeLogFile "After a successful close the shared handle is NULL again so subsequent writeLogLine calls silently no-op until openLogFile is called again."

label startCloseLogFile

call closeLogHandleIsNullCall pointer.isNull
argument closeLogHandleIsNullCall pointer OpaquePointer sharedLogFileHandle
run closeLogHandleIsNullCall
bind value closeLogHandleIsNull Bool closeLogHandleIsNullCall
branch if condition closeLogHandleIsNull target closeLogAlreadyClosed

call closeLogFcloseCall c.fclose
argument closeLogFcloseCall stream LogFile sharedLogFileHandle
run closeLogFcloseCall
ignore ok source closeLogFcloseCall type Int32

storage local immutable closeLogNullHandle LogFile 0
set storage sharedLogFileHandle closeLogNullHandle
return value logStatusOk

label closeLogAlreadyClosed
return value logStatusOk

# ============================================================
# writeLogLine — append one pre-formatted line + '\n' + fflush.
# ============================================================

operation writeLogLine
input operation writeLogLine linePayload String
output operation writeLogLine Int32
effect writeLogLine readWrite filesystem
effect writeLogLine readWrite memory.buffer
effect writeLogLine write console.stdout
useCapability writeLogLine logFilesystemReadWrite
useCapability writeLogLine logMemoryBufferReadWrite
useCapability writeLogLine logConsoleStdoutWrite
memory writeLogLine heap auto
async writeLogLine no
purpose operation writeLogLine "Append `linePayload` followed by a single '\\n' to sharedLogFileHandle and fflush. No handle and no payload are both silent no-ops returning logStatusOk so callers don't need to guard every log call."
invariant operation writeLogLine "fflush is always called after the put so a crash loses at most the in-flight line; the file is never left with a partial half-line that breaks downstream `jq -c` or grep tooling."

label startWriteLogLine

call writeLogHandleIsNullCall pointer.isNull
argument writeLogHandleIsNullCall pointer OpaquePointer sharedLogFileHandle
run writeLogHandleIsNullCall
bind value writeLogHandleIsNull Bool writeLogHandleIsNullCall
branch if condition writeLogHandleIsNull target writeLogNoHandleNoOp

call writeLogPayloadNullCheckCall pointer.isNull
argument writeLogPayloadNullCheckCall pointer OpaquePointer linePayload
run writeLogPayloadNullCheckCall
bind value writeLogPayloadIsNull Bool writeLogPayloadNullCheckCall
branch if condition writeLogPayloadIsNull target writeLogEmptyPayloadNoOp

call writeLogFputsLineCall c.fputs
argument writeLogFputsLineCall string String linePayload
argument writeLogFputsLineCall stream LogFile sharedLogFileHandle
run writeLogFputsLineCall
ignore ok source writeLogFputsLineCall type Int32

call writeLogFputsNewlineCall c.fputs
argument writeLogFputsNewlineCall string String logNewlineText
argument writeLogFputsNewlineCall stream LogFile sharedLogFileHandle
run writeLogFputsNewlineCall
ignore ok source writeLogFputsNewlineCall type Int32

call writeLogFflushCall c.fflush
argument writeLogFflushCall stream LogFile sharedLogFileHandle
run writeLogFflushCall
ignore ok source writeLogFflushCall type Int32

return value logStatusOk

label writeLogNoHandleNoOp
return value logStatusOk

label writeLogEmptyPayloadNoOp
return value logStatusOk

# ============================================================
# escapeJsonString — backslash-escape a string for JSON embedding.
# ============================================================
# Pure-AS character-by-character pass over `sourceText`, copying into
# `destinationBuffer` with `"` and `\\` escaped. Control characters are
# replaced by the literal space character — JSON requires \\uXXXX
# escapes for U+0000..U+001F but emitting those would require a
# four-byte snprintf per control char and the log envelope's message
# field is the only consumer. Replacement-with-space is safe (never
# breaks JSON parsing) and bounded (one byte in, one byte out).

operation escapeJsonString
input operation escapeJsonString sourceText String
input operation escapeJsonString destinationBuffer OpaquePointer
input operation escapeJsonString destinationCapacity Int64
output operation escapeJsonString Int32
effect escapeJsonString readWrite memory.buffer
useCapability escapeJsonString logMemoryBufferReadWrite
memory escapeJsonString heap auto
async escapeJsonString no
purpose operation escapeJsonString "Copy sourceText into destinationBuffer with `\"` and `\\` escaped. Stops cleanly when the destination would overflow so the buffer never gets a half-encoded escape sequence at its tail. Caller must size destinationCapacity >= worst-case `2 * len(sourceText) + 1`."
invariant operation escapeJsonString "Output is always null-terminated; never writes past destinationCapacity - 1; control characters get folded to single spaces rather than \\uXXXX (see module-level note)."

label startEscapeJsonString

# Real per-byte escaper (the log-injection defence promised by
# moduleSecurity). Copy sourceText into destinationBuffer escaping `"`
# -> \" and `\` -> \\, folding control bytes (< 0x20) to a single space,
# and stopping before destinationCapacity would overflow so the tail is
# always a clean NUL — never a half-written escape. A no-op `%s` snprintf
# (the previous implementation) let any `"` in the text close the JSON
# string and inject sibling fields into the audit trail.
storage local immutable escapeZeroValue Int64 0
storage local immutable escapeOneStep Int64 1
storage local immutable escapeTwoStep Int64 2
storage local immutable escapeQuoteByteCode Int64 34
storage local immutable escapeBackslashByteCode Int64 92
storage local immutable escapeSpaceByteCode Int64 32
storage local immutable escapeByteRoleAdjustment Int64 256

# Null source behaves as the empty string: jump straight to the NUL write.
call escapeSourceIsNullCall pointer.isNull
argument escapeSourceIsNullCall pointer OpaquePointer sourceText
run escapeSourceIsNullCall
bind value escapeSourceIsNull Bool escapeSourceIsNullCall

memory escapeJsonString mutable escapeSourceCursor Int64 0
memory escapeJsonString mutable escapeDestCursor Int64 0
# Reserve one byte for the terminating NUL: writes must keep
# escapeDestCursor <= destinationCapacity - 1.
call escapeCapacityLimitCall math.subtractInt64
argument escapeCapacityLimitCall left Int64 destinationCapacity
argument escapeCapacityLimitCall right Int64 escapeOneStep
run escapeCapacityLimitCall
bind value escapeCapacityLimit Int64 escapeCapacityLimitCall
branch if condition escapeSourceIsNull target escapeTerminate

label escapeLoopHead
call escapeLoadSrcCall pointer.loadByte
argument escapeLoadSrcCall buffer OpaquePointer sourceText
argument escapeLoadSrcCall offset ByteCount escapeSourceCursor
run escapeLoadSrcCall
bind value escapeRawSrcByte Int8 escapeLoadSrcCall
call escapeSrcIsNulCall math.equalInt64
argument escapeSrcIsNulCall left Int64 escapeRawSrcByte
argument escapeSrcIsNulCall right Int64 escapeZeroValue
run escapeSrcIsNulCall
bind value escapeSrcIsNul Bool escapeSrcIsNulCall
branch if condition escapeSrcIsNul target escapeTerminate
# Normalize to unsigned 0..255 so high bytes don't sign-extend.
call escapeShiftByteCall math.addInt64
argument escapeShiftByteCall left Int64 escapeRawSrcByte
argument escapeShiftByteCall right Int64 escapeByteRoleAdjustment
run escapeShiftByteCall
bind value escapeShiftedByte Int64 escapeShiftByteCall
call escapeNormByteCall math.moduloInt64
argument escapeNormByteCall left Int64 escapeShiftedByte
argument escapeNormByteCall right Int64 escapeByteRoleAdjustment
run escapeNormByteCall
bind value escapeNormByte Int64 escapeNormByteCall
call escapeIsQuoteCall math.equalInt64
argument escapeIsQuoteCall left Int64 escapeNormByte
argument escapeIsQuoteCall right Int64 escapeQuoteByteCode
run escapeIsQuoteCall
bind value escapeIsQuote Bool escapeIsQuoteCall
branch if condition escapeIsQuote target escapeEmitQuote
call escapeIsBackslashCall math.equalInt64
argument escapeIsBackslashCall left Int64 escapeNormByte
argument escapeIsBackslashCall right Int64 escapeBackslashByteCode
run escapeIsBackslashCall
bind value escapeIsBackslash Bool escapeIsBackslashCall
branch if condition escapeIsBackslash target escapeEmitBackslash
call escapeIsControlCall math.lessThanInt64
argument escapeIsControlCall left Int64 escapeNormByte
argument escapeIsControlCall right Int64 escapeSpaceByteCode
run escapeIsControlCall
bind value escapeIsControl Bool escapeIsControlCall
branch if condition escapeIsControl target escapeEmitSpace
branch else target escapeEmitPlain

# Plain byte (one output byte): need destCursor < capacityLimit.
label escapeEmitPlain
call escapePlainRoomCall math.lessThanInt64
argument escapePlainRoomCall left Int64 escapeDestCursor
argument escapePlainRoomCall right Int64 escapeCapacityLimit
run escapePlainRoomCall
bind value escapePlainHasRoom Bool escapePlainRoomCall
branch if condition escapePlainHasRoom target escapeWritePlain
branch else target escapeTerminate
label escapeWritePlain
call escapeStorePlainCall pointer.storeByte
argument escapeStorePlainCall buffer OpaquePointer destinationBuffer
argument escapeStorePlainCall offset ByteCount escapeDestCursor
argument escapeStorePlainCall value Int64 escapeNormByte
run escapeStorePlainCall
call escapePlainAdvanceCall math.addInt64
argument escapePlainAdvanceCall left Int64 escapeDestCursor
argument escapePlainAdvanceCall right Int64 escapeOneStep
run escapePlainAdvanceCall
bind value escapeDestAfterPlain Int64 escapePlainAdvanceCall
set memory escapeDestCursor escapeDestAfterPlain
jump target escapeAdvanceSource

# Control byte folded to a single space (one output byte).
label escapeEmitSpace
call escapeSpaceRoomCall math.lessThanInt64
argument escapeSpaceRoomCall left Int64 escapeDestCursor
argument escapeSpaceRoomCall right Int64 escapeCapacityLimit
run escapeSpaceRoomCall
bind value escapeSpaceHasRoom Bool escapeSpaceRoomCall
branch if condition escapeSpaceHasRoom target escapeWriteSpace
branch else target escapeTerminate
label escapeWriteSpace
call escapeStoreSpaceCall pointer.storeByte
argument escapeStoreSpaceCall buffer OpaquePointer destinationBuffer
argument escapeStoreSpaceCall offset ByteCount escapeDestCursor
argument escapeStoreSpaceCall value Int64 escapeSpaceByteCode
run escapeStoreSpaceCall
call escapeSpaceAdvanceCall math.addInt64
argument escapeSpaceAdvanceCall left Int64 escapeDestCursor
argument escapeSpaceAdvanceCall right Int64 escapeOneStep
run escapeSpaceAdvanceCall
bind value escapeDestAfterSpace Int64 escapeSpaceAdvanceCall
set memory escapeDestCursor escapeDestAfterSpace
jump target escapeAdvanceSource

# Quote -> \" (two output bytes): need destCursor + 2 <= capacityLimit.
label escapeEmitQuote
call escapeQuoteRoomEndCall math.addInt64
argument escapeQuoteRoomEndCall left Int64 escapeDestCursor
argument escapeQuoteRoomEndCall right Int64 escapeTwoStep
run escapeQuoteRoomEndCall
bind value escapeQuoteRoomEnd Int64 escapeQuoteRoomEndCall
call escapeQuoteRoomCall math.lessThanOrEqualInt64
argument escapeQuoteRoomCall left Int64 escapeQuoteRoomEnd
argument escapeQuoteRoomCall right Int64 escapeCapacityLimit
run escapeQuoteRoomCall
bind value escapeQuoteHasRoom Bool escapeQuoteRoomCall
branch if condition escapeQuoteHasRoom target escapeWriteQuote
branch else target escapeTerminate
label escapeWriteQuote
call escapeStoreQuoteBackslashCall pointer.storeByte
argument escapeStoreQuoteBackslashCall buffer OpaquePointer destinationBuffer
argument escapeStoreQuoteBackslashCall offset ByteCount escapeDestCursor
argument escapeStoreQuoteBackslashCall value Int64 escapeBackslashByteCode
run escapeStoreQuoteBackslashCall
call escapeQuoteAdvanceFirstCall math.addInt64
argument escapeQuoteAdvanceFirstCall left Int64 escapeDestCursor
argument escapeQuoteAdvanceFirstCall right Int64 escapeOneStep
run escapeQuoteAdvanceFirstCall
bind value escapeDestAfterQuoteBackslash Int64 escapeQuoteAdvanceFirstCall
set memory escapeDestCursor escapeDestAfterQuoteBackslash
call escapeStoreQuoteCharCall pointer.storeByte
argument escapeStoreQuoteCharCall buffer OpaquePointer destinationBuffer
argument escapeStoreQuoteCharCall offset ByteCount escapeDestCursor
argument escapeStoreQuoteCharCall value Int64 escapeQuoteByteCode
run escapeStoreQuoteCharCall
call escapeQuoteAdvanceSecondCall math.addInt64
argument escapeQuoteAdvanceSecondCall left Int64 escapeDestCursor
argument escapeQuoteAdvanceSecondCall right Int64 escapeOneStep
run escapeQuoteAdvanceSecondCall
bind value escapeDestAfterQuoteChar Int64 escapeQuoteAdvanceSecondCall
set memory escapeDestCursor escapeDestAfterQuoteChar
jump target escapeAdvanceSource

# Backslash -> \\ (two output bytes): need destCursor + 2 <= capacityLimit.
label escapeEmitBackslash
call escapeBackslashRoomEndCall math.addInt64
argument escapeBackslashRoomEndCall left Int64 escapeDestCursor
argument escapeBackslashRoomEndCall right Int64 escapeTwoStep
run escapeBackslashRoomEndCall
bind value escapeBackslashRoomEnd Int64 escapeBackslashRoomEndCall
call escapeBackslashRoomCall math.lessThanOrEqualInt64
argument escapeBackslashRoomCall left Int64 escapeBackslashRoomEnd
argument escapeBackslashRoomCall right Int64 escapeCapacityLimit
run escapeBackslashRoomCall
bind value escapeBackslashHasRoom Bool escapeBackslashRoomCall
branch if condition escapeBackslashHasRoom target escapeWriteBackslash
branch else target escapeTerminate
label escapeWriteBackslash
call escapeStoreBackslashFirstCall pointer.storeByte
argument escapeStoreBackslashFirstCall buffer OpaquePointer destinationBuffer
argument escapeStoreBackslashFirstCall offset ByteCount escapeDestCursor
argument escapeStoreBackslashFirstCall value Int64 escapeBackslashByteCode
run escapeStoreBackslashFirstCall
call escapeBackslashAdvanceFirstCall math.addInt64
argument escapeBackslashAdvanceFirstCall left Int64 escapeDestCursor
argument escapeBackslashAdvanceFirstCall right Int64 escapeOneStep
run escapeBackslashAdvanceFirstCall
bind value escapeDestAfterBackslashFirst Int64 escapeBackslashAdvanceFirstCall
set memory escapeDestCursor escapeDestAfterBackslashFirst
call escapeStoreBackslashSecondCall pointer.storeByte
argument escapeStoreBackslashSecondCall buffer OpaquePointer destinationBuffer
argument escapeStoreBackslashSecondCall offset ByteCount escapeDestCursor
argument escapeStoreBackslashSecondCall value Int64 escapeBackslashByteCode
run escapeStoreBackslashSecondCall
call escapeBackslashAdvanceSecondCall math.addInt64
argument escapeBackslashAdvanceSecondCall left Int64 escapeDestCursor
argument escapeBackslashAdvanceSecondCall right Int64 escapeOneStep
run escapeBackslashAdvanceSecondCall
bind value escapeDestAfterBackslashSecond Int64 escapeBackslashAdvanceSecondCall
set memory escapeDestCursor escapeDestAfterBackslashSecond
jump target escapeAdvanceSource

label escapeAdvanceSource
call escapeAdvanceSourceCursorCall math.addInt64
argument escapeAdvanceSourceCursorCall left Int64 escapeSourceCursor
argument escapeAdvanceSourceCursorCall right Int64 escapeOneStep
run escapeAdvanceSourceCursorCall
bind value escapeNextSourceCursor Int64 escapeAdvanceSourceCursorCall
set memory escapeSourceCursor escapeNextSourceCursor
jump target escapeLoopHead

label escapeTerminate
# Only write the NUL when the buffer has at least one byte; a zero
# capacity must not be touched.
call escapeCanTerminateCall math.greaterThanInt64
argument escapeCanTerminateCall left Int64 destinationCapacity
argument escapeCanTerminateCall right Int64 escapeZeroValue
run escapeCanTerminateCall
bind value escapeCanTerminate Bool escapeCanTerminateCall
branch if condition escapeCanTerminate target escapeWriteTerminator
return value logStatusOk
label escapeWriteTerminator
call escapeStoreNulCall pointer.storeByte
argument escapeStoreNulCall buffer OpaquePointer destinationBuffer
argument escapeStoreNulCall offset ByteCount escapeDestCursor
argument escapeStoreNulCall value Int64 escapeZeroValue
run escapeStoreNulCall
return value logStatusOk

# ============================================================
# logEventStructured — wrap caller text in a JSON envelope.
# ============================================================

operation logEventStructured
input operation logEventStructured levelText String
input operation logEventStructured eventText String
input operation logEventStructured messageText String
output operation logEventStructured Int32
effect logEventStructured allocate heap
effect logEventStructured free heap
effect logEventStructured readWrite memory.buffer
effect logEventStructured readWrite filesystem
useCapability logEventStructured logHeapAllocate
useCapability logEventStructured logHeapFree
useCapability logEventStructured logMemoryBufferReadWrite
useCapability logEventStructured logFilesystemReadWrite
memory logEventStructured heap auto
async logEventStructured no
purpose operation logEventStructured "Compose {\"level\":\"<l>\",\"event\":\"<e>\",\"message\":\"<m>\"} into a malloc'd buffer and hand it to writeLogLine. Caller fields are escaped via escapeJsonString so a message text containing `\"` cannot break out of the message field."
invariant operation logEventStructured "Allocates two scratch buffers, frees both via defer regardless of which branch returns. The line buffer is sized by logLineMaximumByteCount so a runaway long message gets truncated by snprintf rather than corrupting the audit trail."

label startLogEventStructured

# Scratch for the escaped message + scratch for the assembled line.
call logEventAllocateMessageScratchCall c.malloc
argument logEventAllocateMessageScratchCall size ByteCount logMessageMaximumByteCount
run logEventAllocateMessageScratchCall
bind value logEventMessageScratch OpaquePointer logEventAllocateMessageScratchCall
defer logEventFreeMessageScratchDefer c.free logEventMessageScratch

call logEventAllocateLineBufferCall c.malloc
argument logEventAllocateLineBufferCall size ByteCount logLineMaximumByteCount
run logEventAllocateLineBufferCall
bind value logEventLineBuffer OpaquePointer logEventAllocateLineBufferCall
defer logEventFreeLineBufferDefer c.free logEventLineBuffer

call logEventEscapeMessageCall escapeJsonString
argument logEventEscapeMessageCall sourceText String messageText
argument logEventEscapeMessageCall destinationBuffer OpaquePointer logEventMessageScratch
argument logEventEscapeMessageCall destinationCapacity Int64 logMessageMaximumByteCount
run logEventEscapeMessageCall
ignore ok source logEventEscapeMessageCall type Int32

call logEventFormatLineCall c.snprintf
argument logEventFormatLineCall buffer OpaquePointer logEventLineBuffer
argument logEventFormatLineCall size Int64 logLineMaximumByteCount
argument logEventFormatLineCall format String logEnvelopeFormat
argument logEventFormatLineCall first String levelText
argument logEventFormatLineCall second String eventText
argument logEventFormatLineCall third OpaquePointer logEventMessageScratch
run logEventFormatLineCall
ignore ok source logEventFormatLineCall type Int32

bind value logEventLineText String logEventAllocateLineBufferCall

call logEventWriteCall writeLogLine
argument logEventWriteCall linePayload String logEventLineText
run logEventWriteCall
bind value logEventWriteStatus Int32 logEventWriteCall
return value logEventWriteStatus

# ============================================================
# logInfo / logWarn / logError — convenience wrappers.
# ============================================================

operation logInfo
input operation logInfo messageText String
output operation logInfo Int32
effect logInfo allocate heap
effect logInfo free heap
effect logInfo readWrite memory.buffer
effect logInfo readWrite filesystem
useCapability logInfo logHeapAllocate
useCapability logInfo logHeapFree
useCapability logInfo logMemoryBufferReadWrite
useCapability logInfo logFilesystemReadWrite
memory logInfo heap auto
async logInfo no
purpose operation logInfo "Shorthand for logEventStructured(\"info\", \"app\", messageText)."
invariant operation logInfo "Returns the status from logEventStructured untouched so callers can fan out to multiple loggers and still see I/O errors."
label startLogInfo
call logInfoForwardCall logEventStructured
argument logInfoForwardCall levelText String logInfoLevelText
argument logInfoForwardCall eventText String logDefaultEventText
argument logInfoForwardCall messageText String messageText
run logInfoForwardCall
bind value logInfoForwardStatus Int32 logInfoForwardCall
return value logInfoForwardStatus

operation logWarn
input operation logWarn messageText String
output operation logWarn Int32
effect logWarn allocate heap
effect logWarn free heap
effect logWarn readWrite memory.buffer
effect logWarn readWrite filesystem
useCapability logWarn logHeapAllocate
useCapability logWarn logHeapFree
useCapability logWarn logMemoryBufferReadWrite
useCapability logWarn logFilesystemReadWrite
memory logWarn heap auto
async logWarn no
purpose operation logWarn "Shorthand for logEventStructured(\"warn\", \"app\", messageText)."
invariant operation logWarn "Returns the status from logEventStructured untouched."
label startLogWarn
call logWarnForwardCall logEventStructured
argument logWarnForwardCall levelText String logWarnLevelText
argument logWarnForwardCall eventText String logDefaultEventText
argument logWarnForwardCall messageText String messageText
run logWarnForwardCall
bind value logWarnForwardStatus Int32 logWarnForwardCall
return value logWarnForwardStatus

operation logError
input operation logError messageText String
output operation logError Int32
effect logError allocate heap
effect logError free heap
effect logError readWrite memory.buffer
effect logError readWrite filesystem
useCapability logError logHeapAllocate
useCapability logError logHeapFree
useCapability logError logMemoryBufferReadWrite
useCapability logError logFilesystemReadWrite
memory logError heap auto
async logError no
purpose operation logError "Shorthand for logEventStructured(\"error\", \"app\", messageText)."
invariant operation logError "Returns the status from logEventStructured untouched."
label startLogError
call logErrorForwardCall logEventStructured
argument logErrorForwardCall levelText String logErrorLevelText
argument logErrorForwardCall eventText String logDefaultEventText
argument logErrorForwardCall messageText String messageText
run logErrorForwardCall
bind value logErrorForwardStatus Int32 logErrorForwardCall
return value logErrorForwardStatus
