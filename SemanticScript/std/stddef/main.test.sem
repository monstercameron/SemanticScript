# ============================================================
# SEMANTICSCRIPT STANDARD LIBRARY TESTS: <stddef.h>-style type sizing
# ============================================================
#
# rationale: companion test file for std/stddef/main.sem. Imports
#   the stddef module and verifies the canonical byte-size literals
#   for opaque pointer, int32, and float64 against the target ABI.
#
# invariant: success prints "OK\n" and exits 0; any failed
#   assertion surfaces MainError.StddefSmokeAssertionFailed.
#
# # pattern: this is the canonical main.test.sem form â€” same
#   directory as main.sem, importModule foo, project block local
#   to the test, entry console main. The implementation file
#   std/stddef/main.sem carries no smoke main itself.

project StdStddefTest
target console
runtime AgentRuntime 0.1
entry console main

import stddef standard.stddef
error MainError
errorCase MainError StddefSmokeAssertionFailed
errorCase MainError ConsoleWriteFailed

# section capability
# rationale: smoke-test main writes a single OK line to stdout.
capability stdoutWriteCapability console.stdout write

# ============================================================
# Smoke test
# ============================================================

operation main
input operation main console Console
output operation main Result ExitCode MainError
useCapability main stdoutWriteCapability
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Verify the stddef sizes resolve to expected ABI values."
invariant operation main "Pointer is 8 bytes; int32 is 4; int64 is 8; double is 8."

label startMain

# byteSizeOfOpaquePointer == 8
storage module immutable eightExpected CSignedInt64 8
call checkPointerSizeCall math.equalI64
argument checkPointerSizeCall left I64 byteSizeOfOpaquePointer
argument checkPointerSizeCall right I64 eightExpected
run checkPointerSizeCall
bind value pointerSizeOk Bool checkPointerSizeCall
branch if condition pointerSizeOk target pointerSizeHolds
branch else target smokeAssertionFailed
label pointerSizeHolds

# byteSizeOfSignedInt32 == 4
storage module immutable fourExpected CSignedInt64 4
call checkInt32SizeCall math.equalI64
argument checkInt32SizeCall left I64 byteSizeOfSignedInt32
argument checkInt32SizeCall right I64 fourExpected
run checkInt32SizeCall
bind value int32SizeOk Bool checkInt32SizeCall
branch if condition int32SizeOk target int32SizeHolds
branch else target smokeAssertionFailed
label int32SizeHolds

# byteSizeOfFloat64 == 8
call checkFloat64SizeCall math.equalI64
argument checkFloat64SizeCall left I64 byteSizeOfFloat64
argument checkFloat64SizeCall right I64 eightExpected
run checkFloat64SizeCall
bind value float64SizeOk Bool checkFloat64SizeCall
branch if condition float64SizeOk target float64SizeHolds
branch else target smokeAssertionFailed
label float64SizeHolds

storage module immutable successMessageText CNullTerminatedByteString "OK"
call writeSuccessLineCall console.writeLine
argument writeSuccessLineCall console Console console
argument writeSuccessLineCall text CNullTerminatedByteString successMessageText
run writeSuccessLineCall
ignore ok source writeSuccessLineCall type CSignedInt32
bind error consoleWriteResultError CSignedInt32 writeSuccessLineCall
branch error source writeSuccessLineCall target consoleWriteFailedHandler
storage module immutable exitOkCode ExitCode 0
return ok exitOkCode

# Failure leg: surface the raw negative CSignedInt32 from
# console.writeLine as the cause attached to the typed
# MainError.ConsoleWriteFailed variant.
label consoleWriteFailedHandler
makeError consoleWriteFailedFailure MainError.ConsoleWriteFailed consoleWriteResultError
return error consoleWriteFailedFailure
label smokeAssertionFailed
makeError stddefSmokeFailure MainError.StddefSmokeAssertionFailed
return error stddefSmokeFailure
