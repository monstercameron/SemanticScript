index 87d32dd..6afddd3 100644
--- a/semanticscript/compiler/refined/codegen.py
+++ b/semanticscript/compiler/refined/codegen.py
@@ -409,6 +409,30 @@ _AARCH64_RESTORER = [
 ]
 
 
+# D-189: Darwin calls a signal's handler through the trampoline its sigaction names (sa_tramp), as
+# tramp(handler, infostyle, signal, siginfo, ucontext, token); the trampoline calls the handler and returns to the
+# interrupted code with sigreturn(ucontext, infostyle, token), as libSystem's _sigtramp does
+_DARWIN_TRAMPOLINE = [
+    ".text",
+    ".p2align 4",
+    ".globl refined_signal_restorer",
+    "refined_signal_restorer:",
+    "  mov x19, x4",
+    "  mov x20, x1",
+    "  mov x21, x5",
+    "  mov x9, x0",
+    "  mov x0, x2",
+    "  mov x1, x3",
+    "  mov x2, x4",
+    "  blr x9",
+    "  mov x0, x19",
+    "  mov x1, x20",
+    "  mov x2, x21",
+    "  mov x16, #184",
+    "  svc #0x80",
+    "  brk #0",
+]
+
 class _Callbacks:
     """The runtime functions compiled code calls, declared when first used. In a program that implements the runtime
     (D-124) a callback its `abi c` operations define is that operation, so the runtime calls itself directly."""
@@ -2460,9 +2484,12 @@ class OpGen:
             return b.bitcast(self.be.function_for(mod, op, None, 0), PTR), None, None
         if name == "signalRestorer":
             arch = self.be.linux_arch()
-            if not arch:
+            if self.be.darwin():
+                self.be.module.asm_parts["restorer"] = _macho(_DARWIN_TRAMPOLINE)  # D-189
+            elif not arch:
                 return ir.Constant(PTR, None), None, None
-            self.be.module.asm_parts["restorer"] = _AARCH64_RESTORER if arch == "aarch64" else _X86_64_RESTORER
+            else:
+                self.be.module.asm_parts["restorer"] = _AARCH64_RESTORER if arch == "aarch64" else _X86_64_RESTORER
             fn = self.be.module.globals.get("refined_signal_restorer") or                 ir.Function(self.be.module, ir.FunctionType(ir.VoidType(), []), name="refined_signal_restorer")
             return b.bitcast(fn, PTR), None, None
         if name == "cLibrary":
