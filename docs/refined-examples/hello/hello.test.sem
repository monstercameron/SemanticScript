# Tests for the `hello` module. Run with:
#   python semanticscript/compiler/refined test docs/refined-examples/hello

greetingTest is test
greetingTest purpose "Running main prints the greeting and exits with code zero"
greetingTest verifies main printsGreeting
greetingTest typeParam none
greetingTest input none
greetingTest output none
greetingTest outputOwner none
greetingTest raises none
greetingTest effect write console.stdout
greetingTest uses stdoutWriter
greetingTest memory heap false
greetingTest async false
greetingTest maxRecursion none
greetingTest label begin loopKind none
greetingTest label begin within none
greetingTest let expectedCode immutable ExitCode 0
greetingTest at begin do runMain
greetingTest at begin do expectZero
greetingTest at begin return ok none

runMain is call
runMain in greetingTest
runMain invokes main
runMain arg none
runMain out mainCode ExitCode
runMain ownedBy none
runMain cleanedBy none
runMain borrows none
runMain catch none

expectZero is call
expectZero in greetingTest
expectZero invokes test.assertEqualExitCode
expectZero arg expected ExitCode expectedCode copy
expectZero arg actual ExitCode mainCode copy
expectZero out none
expectZero ownedBy none
expectZero cleanedBy none
expectZero borrows none
expectZero catch none
