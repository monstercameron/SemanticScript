addOrderLine label unknownLine within none
addOrderLine label finished loopKind none
addOrderLine label finished within none
addOrderLine let maxDepth Int64 4 immutable
addOrderLine let one Int64 1 immutable
addOrderLine let isBundle Bool false mutable
addOrderLine let yes Bool true immutable
addOrderLine at begin do deeper
addOrderLine at begin branch if tooDeepNow goto deepLine else goto countParts
addOrderLine at countParts do countComponents
addOrderLine at countParts goto scanParts
addOrderLine at scanParts branch ifNext components bind component Component goto checkPart else goto afterParts
addOrderLine at checkPart do readBundle
addOrderLine at checkPart do sameBundle
addOrderLine at checkPart branch if isPart goto expandPart else goto scanParts
addOrderLine at expandPart set isBundle yes
addOrderLine at expandPart do readPart
addOrderLine at expandPart do readCount
addOrderLine at expandPart do multiplyCount
addOrderLine at expandPart do nextDepth
addOrderLine at expandPart do expandChild
addOrderLine at expandPart branch ifError expandChild goto partFailed else goto scanParts
addOrderLine at partFailed return error partError
addOrderLine at afterParts branch if isBundle goto finished else goto leaf
addOrderLine at leaf do findLeaf
addOrderLine at leaf branch ifError findLeaf goto unknownLine else goto pricedLeaf
addOrderLine at pricedLeaf do readLeafUnit
addOrderLine at pricedLeaf do readLeafCategory
addOrderLine at pricedLeaf do makeLeafItem
addOrderLine at pricedLeaf do appendLeafItem
addOrderLine at pricedLeaf do multiplyGross
addOrderLine at pricedLeaf do readCategoryTotal
addOrderLine at pricedLeaf branch ifError readCategoryTotal goto firstOfCategory else goto addToCategory
addOrderLine at firstOfCategory do putFirst
addOrderLine at firstOfCategory goto finished
addOrderLine at addToCategory do sumCategory
addOrderLine at addToCategory do putSum
addOrderLine at addToCategory goto finished
addOrderLine at deepLine do makeTooDeep
addOrderLine at deepLine return error deepError
addOrderLine at unknownLine do makeUnknown
addOrderLine at unknownLine return error unknownError
addOrderLine at finished return ok none

