main at begin do makeDeadline
main at begin do makeLines
main at begin do makeSeen
main at begin do makeTotals
main at begin goto fill
main at fill branch ifNext order bind row OrderLine goto addRow else goto price
main at addRow do readSku
main at addRow do readQuantity
main at addRow do checkNew
main at addRow branch if isNew goto expandRow else goto duplicateLine
main at expandRow do addLines
main at expandRow branch ifError addLines goto lineFailed else goto fill
main at price start listTask into none
main at price start discountTask into none
main at price join listTask
main at price branch ifError listTask goto stopDiscount else goto joinDiscount
main at joinDiscount join discountTask
main at joinDiscount branch ifError discountTask goto discountFailed else goto printTotals
main at stopDiscount cancel discountTask
main at stopDiscount join discountTask
main at stopDiscount branch ifError discountTask goto bothFailed else goto listFailed
main at bothFailed do noteBoth
main at bothFailed branch ifError noteBoth goto listFailed else goto listFailed
main at printTotals do printList
main at printTotals branch ifError printList goto outputFailed else goto printSecond
main at printSecond do printDiscount
main at printSecond branch ifError printDiscount goto outputFailed else goto categories
main at categories do countCategories
main at categories goto listCategories
main at listCategories branch ifNext categoryTotals bind category String goto printCategory else goto reserve
main at printCategory do readSubtotal
main at printCategory branch ifError readSubtotal goto listCategories else goto writeCategory
main at writeCategory do writeName
main at writeCategory branch ifError writeName goto outputFailed else goto writeCategory2
main at writeCategory2 do writeEquals
main at writeCategory2 branch ifError writeEquals goto outputFailed else goto writeCategory3
main at writeCategory3 do writeSubtotal
main at writeCategory3 branch ifError writeSubtotal goto outputFailed else goto listCategories
main at reserve do askRoom
main at reserve branch ifError askRoom goto noRoom else goto compose
main at compose do listDigits
main at compose do discountDigits
main at compose do joinListLabel
main at compose do joinDiscountLabel
main at compose do joinDiscountDigits
main at compose do lineBytes
main at compose do removeOld
main at compose branch ifError removeOld goto checkOld else goto createNew
main at checkOld match removeError fs.FileError
main at checkOld case fs.FileError.notFound bind none none goto createNew
main at checkOld case fs.FileError.denied bind none none goto fileFailed
main at checkOld case fs.FileError.exists bind none none goto fileFailed
main at checkOld case fs.FileError.tooLarge bind none none goto fileFailed
main at checkOld case fs.FileError.timedOut bind none none goto fileFailed
main at checkOld case fs.FileError.cancelled bind none none goto fileFailed
main at checkOld case fs.FileError.busy bind none none goto fileFailed
main at checkOld case fs.FileError.failed bind removeCode Int32 goto fileFailed
main at createNew do openReport
main at createNew branch ifError openReport goto fileFailed else goto opened
main at opened start writeReport into none
main at opened join writeReport
main at opened branch ifError writeReport goto closeAfterFailure else goto closeWritten
main at closeWritten do closeReport
main at closeWritten branch ifError closeReport goto fileFailed else goto readBack
main at closeAfterFailure do closeFailedReport
main at closeAfterFailure branch ifError closeFailedReport goto fileFailed else goto fileFailed
main at readBack start readReport into none
main at readBack join readReport
main at readBack branch ifError readReport goto readFailed else goto decode
main at decode do decodeReport
main at decode branch ifError decodeReport goto fileFailed else goto verifyReport
main at verifyReport do findDiscount
main at verifyReport branch if holdsDiscount goto showReport else goto fileFailed
main at showReport do printReport
main at showReport branch ifError printReport goto outputFailed else goto finished
main at finished return ok okCode
main at listFailed match listError pricing.PricingError
main at listFailed case pricing.PricingError.negativeQuantity bind listSku Int64 goto badLine
main at listFailed case pricing.PricingError.emptyOrder bind none none goto noLines
main at discountFailed match discountError pricing.PricingError
main at discountFailed case pricing.PricingError.negativeQuantity bind discountSku Int64 goto badLine
main at discountFailed case pricing.PricingError.emptyOrder bind none none goto noLines
main at readFailed match readError fs.FileError
main at readFailed case fs.FileError.notFound bind none none goto fileFailed
main at readFailed case fs.FileError.denied bind none none goto fileFailed
main at readFailed case fs.FileError.exists bind none none goto fileFailed
main at readFailed case fs.FileError.tooLarge bind none none goto fileFailed
main at readFailed case fs.FileError.timedOut bind none none goto fileFailed
main at readFailed case fs.FileError.cancelled bind none none goto fileFailed
main at readFailed case fs.FileError.busy bind none none goto fileFailed
main at readFailed case fs.FileError.failed bind osCode Int32 goto fileFailed
main at badLine return ok badLineCode
main at noLines return ok emptyCode
main at fileFailed return ok fileCode
main at outputFailed return ok outputCode
main at noRoom return ok noRoomCode
main at unknownProduct return ok unknownCode
main at duplicateLine return ok duplicateCode
main at nestedTooDeep return ok deepCode
main at lineFailed match lineError OrderError
main at lineFailed case OrderError.unknownProduct bind unknownSku Int64 goto unknownProduct
main at lineFailed case OrderError.tooDeep bind deepSku Int64 goto nestedTooDeep

