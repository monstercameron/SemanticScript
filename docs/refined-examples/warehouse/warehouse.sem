main let waitMs Int64 5000 immutable
main let readLimit Int64 256 immutable
main let okCode ExitCode 0 immutable
main let badLineCode ExitCode 2 immutable
main let emptyCode ExitCode 3 immutable
main let fileCode ExitCode 4 immutable
main let outputCode ExitCode 5 immutable
main let noRoomCode ExitCode 6 immutable
