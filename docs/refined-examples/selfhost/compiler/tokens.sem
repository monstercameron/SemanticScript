# Refined syntax (docs/language-refinement.md). Checks clean; its tests run with
#   python semanticscript/compiler/refined test docs/refined-examples/selfhost
# The next piece of a compiler front end, written to exercise what the other two
# examples do not: an instantiated generic list, a mutable loan, an operation
# that raises, `return error`, an error payload, `match` / `case`, and an
# optional value.
# Check: python semanticscript/compiler/refined check docs/refined-examples/selfhost

tokens is module
tokens purpose "Split source text into a list of tokens"
tokens path compiler.tokens
tokens imports compiler.lexer
tokens imports standard.list
tokens imports standard.option
tokens imports standard.string
tokens imports standard.byte
tokens imports standard.math
tokens imports standard.compare
tokens imports standard.test
tokens exports tokenize
tokens exports firstKind

LexError is enum
LexError purpose "Why tokenizing stopped"
LexError typeParameter none
LexError variant unexpectedByte Int64

TokenList is typeInstance
TokenList purpose "A growable list of tokens"
TokenList instantiates list.List lexer.Token

TokenKindOption is typeInstance
TokenKindOption purpose "A token kind, or nothing"
TokenKindOption instantiates option.Option lexer.TokenKind

# ---------------------------------------------------------------- tokenize

tokenize is operation
tokenize purpose "Split source text into word tokens separated by spaces"
tokenize invariant emptyGivesNoTokens "Empty source text gives an empty list"
tokenize invariant stopsAtBadByte "A byte that is neither a letter nor a space gives unexpectedByte carrying its offset"
tokenize typeParameter none
tokenize input source String borrowed
tokenize input resultRegion Region borrowed
tokenize output TokenList
tokenize outputOwnedBy resultRegion
tokenize raises LexError
tokenize effect none
tokenize uses none
tokenize memoryHeap true
tokenize async false
tokenize maxRecursion none
tokenize label begin loopKind none
tokenize label begin within none
tokenize label scan loopKind while
tokenize label scan within none
tokenize label scan maxIterations sourceLength
tokenize label peek loopKind none
tokenize label peek within scan
tokenize label classify loopKind none
tokenize label classify within scan
tokenize label letterTest loopKind none
tokenize label letterTest within scan
tokenize label word loopKind none
tokenize label word within scan
tokenize label skip loopKind none
tokenize label skip within scan
tokenize label reject loopKind none
tokenize label reject within none
tokenize label finished loopKind none
tokenize label finished within none
tokenize let one Int64 1 immutable
tokenize let position Int64 0 mutable
tokenize at begin do measureSource
tokenize at begin do makeList
tokenize at begin goto scan
tokenize at scan do atEndCheck
tokenize at scan branch if atEnd goto finished else goto peek
tokenize at peek do readByte
tokenize at peek branch ifError readByte goto finished else goto classify
tokenize at classify do spaceCheck
tokenize at classify branch if isSpace goto skip else goto letterTest
tokenize at letterTest do letterCheck
tokenize at letterTest branch if isLetter goto word else goto reject
# Every pass consumes at least one byte, so the loop returns to `scan` at most
# sourceLength times.
tokenize at word do scanOneWord
tokenize at word do appendToken
tokenize at word do readWordLength
tokenize at word do advancePastWord
tokenize at word set position afterWord
tokenize at word goto scan
tokenize at skip do advanceOne
tokenize at skip set position afterSpace
tokenize at skip goto scan
tokenize at reject do makeUnexpectedByte
tokenize at reject return error lexError
tokenize at finished return ok tokens

measureSource is call
measureSource in tokenize
measureSource invokes string.byteLength
measureSource argument text String source lend
measureSource result sourceLength Int64
measureSource ownedBy none
measureSource cleanedBy none
measureSource borrows none
measureSource catch none

makeList is call
makeList in tokenize
makeList invokes TokenList.new
makeList argument region Region resultRegion lend
makeList result tokens TokenList
makeList ownedBy resultRegion
makeList cleanedBy none
makeList borrows none
makeList catch none

atEndCheck is call
atEndCheck in tokenize
atEndCheck invokes compare.greaterOrEqualInt64
atEndCheck argument left Int64 position copy
atEndCheck argument right Int64 sourceLength copy
atEndCheck result atEnd Bool
atEndCheck ownedBy none
atEndCheck cleanedBy none
atEndCheck borrows none
atEndCheck catch none

readByte is call
readByte in tokenize
readByte invokes string.byteAt
readByte argument text String source lend
readByte argument index Int64 position copy
readByte result currentByte Byte
readByte ownedBy none
readByte cleanedBy none
readByte borrows none
readByte catch readByteError string.StringIndexError

spaceCheck is call
spaceCheck in tokenize
spaceCheck invokes byte.isSpace
spaceCheck argument value Byte currentByte copy
spaceCheck result isSpace Bool
spaceCheck ownedBy none
spaceCheck cleanedBy none
spaceCheck borrows none
spaceCheck catch none

letterCheck is call
letterCheck in tokenize
letterCheck invokes byte.isLetter
letterCheck argument value Byte currentByte copy
letterCheck result isLetter Bool
letterCheck ownedBy none
letterCheck cleanedBy none
letterCheck borrows none
letterCheck catch none

scanOneWord is call
scanOneWord in tokenize
scanOneWord invokes lexer.scanWord
scanOneWord argument source String source lend
scanOneWord argument start Int64 position copy
scanOneWord result wordToken lexer.Token
scanOneWord ownedBy none
scanOneWord cleanedBy none
scanOneWord borrows none
scanOneWord catch none

appendToken is call
appendToken in tokenize
appendToken invokes TokenList.append
appendToken argument list TokenList tokens lendMutable
appendToken argument item lexer.Token wordToken copy
appendToken result none
appendToken ownedBy none
appendToken cleanedBy none
appendToken borrows none
appendToken catch none

readWordLength is call
readWordLength in tokenize
readWordLength invokes lexer.Token.length
readWordLength argument record lexer.Token wordToken copy
readWordLength result wordLength Int64
readWordLength ownedBy none
readWordLength cleanedBy none
readWordLength borrows none
readWordLength catch none

advancePastWord is call
advancePastWord in tokenize
advancePastWord invokes math.addInt64
advancePastWord argument left Int64 position copy
advancePastWord argument right Int64 wordLength copy
advancePastWord result afterWord Int64
advancePastWord ownedBy none
advancePastWord cleanedBy none
advancePastWord borrows none
advancePastWord catch none

advanceOne is call
advanceOne in tokenize
advanceOne invokes math.addInt64
advanceOne argument left Int64 position copy
advanceOne argument right Int64 one copy
advanceOne result afterSpace Int64
advanceOne ownedBy none
advanceOne cleanedBy none
advanceOne borrows none
advanceOne catch none

makeUnexpectedByte is call
makeUnexpectedByte in tokenize
makeUnexpectedByte invokes LexError.unexpectedByte
makeUnexpectedByte argument payload Int64 position copy
makeUnexpectedByte result lexError LexError
makeUnexpectedByte ownedBy none
makeUnexpectedByte cleanedBy none
makeUnexpectedByte borrows none
makeUnexpectedByte catch none

# ---------------------------------------------------------------- firstKind

firstKind is operation
firstKind purpose "Report the kind of the first token in a source text, if there is one"
firstKind invariant badSourceGivesAbsent "Source text that fails to tokenize gives absent"
firstKind typeParameter none
firstKind input source String borrowed
firstKind output TokenKindOption
firstKind outputOwnedBy none
firstKind raises none
firstKind effect none
firstKind uses none
firstKind memoryHeap true
firstKind async false
firstKind maxRecursion none
firstKind label begin loopKind none
firstKind label begin within none
firstKind label failed loopKind none
firstKind label failed within none
firstKind label first loopKind none
firstKind label first within none
firstKind label found loopKind none
firstKind label found within none
firstKind label missing loopKind none
firstKind label missing within none
firstKind let zero Int64 0 immutable
firstKind at begin do runTokenize
firstKind at begin branch ifError runTokenize goto failed else goto first
firstKind at failed match tokenizeError LexError
firstKind at failed case LexError.unexpectedByte bind badOffset Int64 goto missing
firstKind at first do getFirst
firstKind at first branch ifError getFirst goto missing else goto found
firstKind at found do readKind
firstKind at found do wrapKind
firstKind at found return ok presentKind
firstKind at missing do makeAbsent
firstKind at missing return ok absentKind

scratch is region
scratch in firstKind
scratch strategy arena
scratch maxBytes 65536
scratch released atReturn

runTokenize is call
runTokenize in firstKind
runTokenize invokes tokenize
runTokenize argument source String source lend
runTokenize argument resultRegion Region scratch lend
runTokenize result tokens TokenList
runTokenize ownedBy scratch
runTokenize cleanedBy none
runTokenize borrows none
runTokenize catch tokenizeError LexError

getFirst is call
getFirst in firstKind
getFirst invokes TokenList.get
getFirst argument list TokenList tokens lend
getFirst argument index Int64 zero copy
getFirst result firstToken lexer.Token
getFirst ownedBy none
getFirst cleanedBy none
getFirst borrows none
getFirst catch firstMissing list.IndexOutOfRange

readKind is call
readKind in firstKind
readKind invokes lexer.Token.kind
readKind argument record lexer.Token firstToken copy
readKind result firstTokenKind lexer.TokenKind
readKind ownedBy none
readKind cleanedBy none
readKind borrows none
readKind catch none

wrapKind is call
wrapKind in firstKind
wrapKind invokes TokenKindOption.present
wrapKind argument payload lexer.TokenKind firstTokenKind copy
wrapKind result presentKind TokenKindOption
wrapKind ownedBy none
wrapKind cleanedBy none
wrapKind borrows none
wrapKind catch none

makeAbsent is call
makeAbsent in firstKind
makeAbsent invokes TokenKindOption.absent
makeAbsent argument none
makeAbsent result absentKind TokenKindOption
makeAbsent ownedBy none
makeAbsent cleanedBy none
makeAbsent borrows none
makeAbsent catch none
