# ---------------------------------------------------------------- tokenize

tokenize is operation
tokenize purpose "Split source text into tokens, each located by line and column"
tokenize invariant kindsAndPositions "Identifiers, integers, quoted text, punctuation, and newlines become tokens in source order, each with its kind, the line and column of its first character, and its length in bytes"
tokenize invariant spacesSeparate "Spaces, tabs, and carriage returns separate tokens and produce none"
tokenize invariant endsWithEndOfInput "The last token is endOfInput, at the position just past the source"
tokenize invariant columnsCountCharacters "A column counts characters, so a multi-byte UTF-8 character in quoted text moves the tokens after it one column, not one per byte"
tokenize invariant rejectsInvalidByte "A byte that begins no token is an invalidByte error at its line and column"
tokenize invariant rejectsUnterminatedText "Quoted text with no closing quote before the end of its line is an unterminatedText error at the opening quote"
tokenize invariant rejectsHugeInteger "An integer that does not fit Int64 is an integerTooLarge error at its first digit"
tokenize typeParameter none
tokenize input source String borrowed
tokenize input resultRegion Region borrowed
tokenize output Tokens
tokenize outputOwnedBy resultRegion
tokenize raises LexError
tokenize effect none
tokenize uses none
tokenize memoryHeap true
tokenize async false
tokenize maxRecursion none
tokenize label begin loopKind none
tokenize label begin within none
tokenize label scan loopKind while
tokenize label scan within none
tokenize label scan maxIterations sourceLength
tokenize label peek loopKind none
tokenize label peek within scan
tokenize label newlineTest loopKind none
tokenize label newlineTest within scan
tokenize label newlineToken loopKind none
tokenize label newlineToken within scan
tokenize label newlineDone loopKind none
tokenize label newlineDone within scan
tokenize label spaceTest loopKind none
tokenize label spaceTest within scan
tokenize label skipSpace loopKind none
tokenize label skipSpace within scan
tokenize label spaceDone loopKind none
tokenize label spaceDone within scan
tokenize label identifierTest loopKind none
tokenize label identifierTest within scan
tokenize label identifierToken loopKind none
tokenize label identifierToken within scan
tokenize label digitTest loopKind none
tokenize label digitTest within scan
tokenize label integerToken loopKind none
tokenize label integerToken within scan
tokenize label integerParse loopKind none
tokenize label integerParse within scan
tokenize label integerReady loopKind none
tokenize label integerReady within scan
tokenize label quoteTest loopKind none
tokenize label quoteTest within scan
tokenize label textToken loopKind none
tokenize label textToken within scan
tokenize label textReady loopKind none
tokenize label textReady within scan
tokenize label punctuationTest loopKind none
tokenize label punctuationTest within scan
tokenize label punctuationToken loopKind none
tokenize label punctuationToken within scan
tokenize label punctuationDone loopKind none
tokenize label punctuationDone within scan
tokenize label tooLarge loopKind none
tokenize label tooLarge within none
tokenize label textFailed loopKind none
tokenize label textFailed within none
tokenize label invalid loopKind none
tokenize label invalid within none
tokenize label finished loopKind none
tokenize label finished within none
tokenize let zero Int64 0 immutable
tokenize let one Int64 1 immutable
tokenize let newlineByte Byte 10 immutable
tokenize let quoteByte Byte 34 immutable
tokenize let identifierRule ByteRule isIdentifierByte immutable
tokenize let digitRule ByteRule isDigitByte immutable
tokenize let position string.Position unset mutable
tokenize at begin do measureSource
tokenize at begin do makeList
tokenize at begin do makeStart
tokenize at begin set position startPosition
# Every pass steps past at least one character, so the loop returns to
# `scan` at most sourceLength times.
tokenize at begin goto scan
tokenize at scan do readOffset
tokenize at scan do atEndCheck
tokenize at scan branch if atEnd goto finished else goto peek
tokenize at peek do readByte
tokenize at peek branch ifError readByte goto finished else goto newlineTest
tokenize at newlineTest do newlineCheck
tokenize at newlineTest branch if isNewline goto newlineToken else goto spaceTest
tokenize at newlineToken do makeNewlineKind
tokenize at newlineToken do makeNewlineToken
tokenize at newlineToken do appendNewline
tokenize at newlineToken do stepNewline
tokenize at newlineToken branch ifError stepNewline goto finished else goto newlineDone
tokenize at newlineDone set position afterNewline
tokenize at newlineDone goto scan
tokenize at spaceTest do spaceCheck
tokenize at spaceTest branch if isSpace goto skipSpace else goto identifierTest
tokenize at skipSpace do stepSpace
tokenize at skipSpace branch ifError stepSpace goto finished else goto spaceDone
tokenize at spaceDone set position afterSpace
tokenize at spaceDone goto scan
tokenize at identifierTest do identifierStartCheck
tokenize at identifierTest branch if startsIdentifier goto identifierToken else goto digitTest
tokenize at identifierToken do scanIdentifier
tokenize at identifierToken do readIdentifierEnd
tokenize at identifierToken do measureIdentifier
tokenize at identifierToken do makeIdentifierKind
tokenize at identifierToken do makeIdentifierToken
tokenize at identifierToken do appendIdentifier
tokenize at identifierToken set position identifierEnd
tokenize at identifierToken goto scan
tokenize at digitTest do digitCheck
tokenize at digitTest branch if isDigit goto integerToken else goto quoteTest
tokenize at integerToken do scanInteger
tokenize at integerToken do readIntegerEnd
tokenize at integerToken do measureInteger
tokenize at integerToken do cutDigits
tokenize at integerToken branch ifError cutDigits goto finished else goto integerParse
# The text is all digits, so the only way parsing fails is a number too
# large for Int64.
tokenize at integerParse do parseDigits
tokenize at integerParse branch ifError parseDigits goto tooLarge else goto integerReady
tokenize at integerReady do makeIntegerKind
tokenize at integerReady do makeIntegerToken
tokenize at integerReady do appendInteger
tokenize at integerReady set position integerEnd
tokenize at integerReady goto scan
tokenize at quoteTest do quoteCheck
tokenize at quoteTest branch if isQuote goto textToken else goto punctuationTest
tokenize at textToken do scanQuoted
tokenize at textToken branch ifError scanQuoted goto textFailed else goto textReady
tokenize at textReady do readTextEnd
tokenize at textReady do measureText
tokenize at textReady do makeTextKind
tokenize at textReady do makeTextToken
tokenize at textReady do appendText
tokenize at textReady set position textEnd
tokenize at textReady goto scan
tokenize at punctuationTest do punctuationCheck
tokenize at punctuationTest branch if isPunctuation goto punctuationToken else goto invalid
tokenize at punctuationToken do makePunctuationKind
tokenize at punctuationToken do makePunctuationToken
tokenize at punctuationToken do appendPunctuation
tokenize at punctuationToken do stepPunctuation
tokenize at punctuationToken branch ifError stepPunctuation goto finished else goto punctuationDone
tokenize at punctuationDone set position afterPunctuation
tokenize at punctuationDone goto scan
tokenize at tooLarge do makeTooLarge
tokenize at tooLarge return error tooLargeError
tokenize at textFailed return error textError
tokenize at invalid do makeInvalid
tokenize at invalid return error invalidError
tokenize at finished do makeEndKind
tokenize at finished do makeEndToken
tokenize at finished do appendEnd
tokenize at finished return ok tokens

