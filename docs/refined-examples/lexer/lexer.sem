applyRule in scanRun
applyRule invokesReference rule
applyRule argument value Byte currentByte copy
applyRule result accepted Bool
applyRule ownedBy none
applyRule cleanedBy none
applyRule borrows none
applyRule catch none

stepOver is call
stepOver in scanRun
stepOver invokes string.advancePosition
stepOver argument text String source lend
stepOver argument position string.Position position copy
stepOver result nextPosition string.Position
stepOver ownedBy none
stepOver cleanedBy none
stepOver borrows none
stepOver catch stepError string.StringIndexError

scanText is operation
scanText purpose "Step past quoted text that starts at a quote, through its closing quote"
scanText invariant none
scanText typeParameter none
scanText input source String borrowed
scanText input start string.Position copied
scanText output string.Position
scanText outputOwnedBy none
scanText raises LexError
scanText effect none
scanText uses none
scanText memoryHeap false
scanText async false
scanText maxRecursion none
scanText label begin loopKind none
scanText label begin within none
scanText label opened loopKind none
scanText label opened within none
scanText label advance loopKind while
scanText label advance within none
scanText label advance maxIterations sourceLength
scanText label fetch loopKind none
scanText label fetch within advance
scanText label quoteTest loopKind none
scanText label quoteTest within advance
scanText label newlineTest loopKind none
scanText label newlineTest within advance
scanText label step loopKind none
scanText label step within advance
scanText label moved loopKind none
scanText label moved within advance
scanText label closeQuote loopKind none
scanText label closeQuote within none
scanText label closed loopKind none
scanText label closed within none
scanText label unterminated loopKind none
scanText label unterminated within none
scanText let quoteByte Byte 34 immutable
scanText let newlineByte Byte 10 immutable
scanText let position string.Position unset mutable
scanText at begin do measureSource
scanText at begin do stepQuote
scanText at begin branch ifError stepQuote goto unterminated else goto opened
scanText at opened set position afterQuote
scanText at opened goto advance
scanText at advance do readOffset
scanText at advance do atEndCheck
scanText at advance branch if atEnd goto unterminated else goto fetch
scanText at fetch do readByte
scanText at fetch branch ifError readByte goto unterminated else goto quoteTest
scanText at quoteTest do quoteCheck
scanText at quoteTest branch if isQuote goto closeQuote else goto newlineTest
scanText at newlineTest do newlineCheck
scanText at newlineTest branch if isNewline goto unterminated else goto step
# `advancePosition` steps over a whole UTF-8 character, so text may hold
# any character and the column after it is still right.
scanText at step do stepOver
scanText at step branch ifError stepOver goto unterminated else goto moved
scanText at moved set position nextPosition
scanText at moved goto advance
scanText at closeQuote do stepClose
scanText at closeQuote branch ifError stepClose goto unterminated else goto closed
scanText at closed return ok afterClose
scanText at unterminated do makeUnterminated
scanText at unterminated return error unterminatedError

