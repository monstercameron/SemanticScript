# ---------------------------------------------------------------- scanning one token

scanRun is operation
scanRun purpose "Step past every character from a position on that a rule accepts"
scanRun invariant none
scanRun typeParameter none
scanRun input source String borrowed
scanRun input start string.Position copied
scanRun input rule ByteRule copied
scanRun output string.Position
scanRun outputOwnedBy none
scanRun raises none
scanRun effect none
scanRun uses none
scanRun memoryHeap false
scanRun async false
scanRun maxRecursion none
scanRun label begin loopKind none
scanRun label begin within none
scanRun label advance loopKind while
scanRun label advance within none
scanRun label advance maxIterations sourceLength
scanRun label fetch loopKind none
scanRun label fetch within advance
scanRun label judge loopKind none
scanRun label judge within advance
scanRun label step loopKind none
scanRun label step within advance
scanRun label moved loopKind none
scanRun label moved within advance
scanRun label finish loopKind none
scanRun label finish within none
scanRun let position string.Position start mutable
scanRun at begin do measureSource
# Each pass steps past at least one byte, so the loop returns to `advance`
# at most sourceLength times.
scanRun at begin goto advance
scanRun at advance do readOffset
scanRun at advance do atEndCheck
scanRun at advance branch if atEnd goto finish else goto fetch
scanRun at fetch do readByte
scanRun at fetch branch ifError readByte goto finish else goto judge
scanRun at judge do applyRule
scanRun at judge branch if accepted goto step else goto finish
scanRun at step do stepOver
scanRun at step branch ifError stepOver goto finish else goto moved
scanRun at moved set position nextPosition
scanRun at moved goto advance
scanRun at finish return ok position

