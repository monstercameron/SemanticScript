# Tests for lexer.sem: every invariant of `tokenize` and `writeListing` is
# verified by a test below. Most tokenize a short source, list the tokens with
# `writeListing`, and compare the listing with the expected text, so one string
# shows each token's position, kind, and text at a glance.

tokenizeTest is test
tokenizeTest purpose "Two lines of identifiers, an integer, punctuation, quoted text, a CRLF and a tab list as expected"
tokenizeTest verifies tokenize kindsAndPositions
tokenizeTest verifies tokenize spacesSeparate
tokenizeTest verifies tokenize endsWithEndOfInput
tokenizeTest verifies writeListing oneLinePerToken
tokenizeTest typeParameter none
tokenizeTest input none
tokenizeTest output none
tokenizeTest outputOwnedBy none
tokenizeTest raises none
tokenizeTest effect none
tokenizeTest uses none
tokenizeTest memoryHeap true
tokenizeTest async false
tokenizeTest maxRecursion none
tokenizeTest label begin loopKind none
tokenizeTest label begin within none
tokenizeTest label render loopKind none
tokenizeTest label render within none
tokenizeTest label decode loopKind none
tokenizeTest label decode within none
tokenizeTest label compare loopKind none
tokenizeTest label compare within none
tokenizeTest label refused loopKind none
tokenizeTest label refused within none
tokenizeTest let source String "count = 42\x0d\n\tsay(\"hi\")\n" immutable
tokenizeTest let expected String "1:1 identifier count\n1:7 punctuation =\n1:9 integer 42\n1:12 newline\n2:2 identifier say\n2:5 punctuation (\n2:6 text \"hi\"\n2:10 punctuation )\n2:11 newline\n3:1 endOfInput\n" immutable
tokenizeTest let refusedText String "the source was refused or could not be listed" immutable
tokenizeTest at begin do makeTokens
tokenizeTest at begin branch ifError makeTokens goto refused else goto render
tokenizeTest at render do newListing
tokenizeTest at render do writeTokens
tokenizeTest at render branch ifError writeTokens goto refused else goto decode
tokenizeTest at decode do readListing
tokenizeTest at decode branch ifError readListing goto refused else goto compare
tokenizeTest at compare do expectListing
tokenizeTest at compare return ok none
tokenizeTest at refused do failRefused
tokenizeTest at refused return ok none

store is region
store in tokenizeTest
store strategy arena
store maxBytes 65536
store released atReturn

makeTokens is call
makeTokens in tokenizeTest
makeTokens invokes tokenize
makeTokens argument source String source lend
makeTokens argument resultRegion Region store lend
makeTokens result tokens Tokens
makeTokens ownedBy store
makeTokens cleanedBy none
makeTokens borrows none
makeTokens catch lexError LexError

newListing is call
newListing in tokenizeTest
newListing invokes buffer.new
newListing argument region Region store lend
newListing result listing buffer.ByteBuffer
newListing ownedBy store
newListing cleanedBy none
newListing borrows none
newListing catch none

writeTokens is call
writeTokens in tokenizeTest
writeTokens invokes writeListing
writeTokens argument source String source lend
writeTokens argument tokens Tokens tokens lend
writeTokens argument listing buffer.ByteBuffer listing lendMutable
writeTokens result none
writeTokens ownedBy none
writeTokens cleanedBy none
writeTokens borrows none
writeTokens catch listingError string.StringIndexError

readListing is call
readListing in tokenizeTest
readListing invokes buffer.toString
readListing argument buffer buffer.ByteBuffer listing lend
readListing argument region Region store lend
readListing result listed String
readListing ownedBy store
readListing cleanedBy none
readListing borrows none
readListing catch decodeError string.Utf8Error

expectListing is call
expectListing in tokenizeTest
expectListing invokes test.assertEqualString
expectListing argument expected String expected lend
expectListing argument actual String listed lend
expectListing result none
expectListing ownedBy none
expectListing cleanedBy none
expectListing borrows none
expectListing catch none

failRefused is call
failRefused in tokenizeTest
failRefused invokes test.fail
failRefused argument message String refusedText lend
failRefused result none
failRefused ownedBy none
failRefused cleanedBy none
failRefused borrows none
failRefused catch none

