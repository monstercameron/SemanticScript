# ---------------------------------------------------------------- main

main is operation
main purpose "Tokenize the source file named by the first argument, write its token list, and print a summary"
main invariant none
main typeParameter none
main input none
main output ExitCode
main outputOwnedBy none
main raises none
main effect read process.arguments
main effect write console.stdout
main effect write console.stderr
main effect read fs.files
main effect write fs.files
main uses argumentReader
main uses stdoutWriter
main uses stderrWriter
main uses lexerFiles
main memoryHeap true
main async true
main maxRecursion none
main label begin loopKind none
main label begin within none
main label usage loopKind none
main label usage within none
main label usageDone loopKind none
main label usageDone within none
main label readPath loopKind none
main label readPath within none
main label readSource loopKind none
main label readSource within none
main label decode loopKind none
main label decode within none
main label notText loopKind none
main label notText within none
main label reportNotText loopKind none
main label reportNotText within none
main label lex loopKind none
main label lex within none
main label lexFailed loopKind none
main label lexFailed within none
main label invalidByte loopKind none
main label invalidByte within none
main label describeBad loopKind none
main label describeBad within none
main label unterminated loopKind none
main label unterminated within none
main label tooLarge loopKind none
main label tooLarge within none
main label lexDone loopKind none
main label lexDone within none
main label render loopKind none
main label render within none
main label save loopKind none
main label save within none
main label summarize loopKind none
main label summarize within none
main label describe loopKind none
main label describe within none
main label printSummary loopKind none
main label printSummary within none
main label finished loopKind none
main label finished within none
main label readFailed loopKind none
main label readFailed within none
main label writeFailed loopKind none
main label writeFailed within none
main label fileDone loopKind none
main label fileDone within none
main label outputFailed loopKind none
main label outputFailed within none
main let usageText String "usage: refined run <project> -- <source file>" immutable
main let tokensSuffix String ".tokens" immutable
main let notTextText String ": not UTF-8 text; the first bad byte is at offset " immutable
main let invalidByteText String "a byte that begins no token: " immutable
main let unterminatedText String "quoted text is not closed before the end of its line" immutable
main let tooLargeText String "an integer too large for Int64" immutable
main let readFailedText String ": cannot read the source file" immutable
main let writeFailedText String ": cannot write the token list" immutable
main let countLead String ": " immutable
main let tokensWord String " tokens, end of input at " immutable
main let writtenWord String ", written to " immutable
main let colon Byte 58 immutable
main let firstIndex Int64 0 immutable
main let one Int64 1 immutable
main let readLimit Int64 65536 immutable
main let waitMs Int64 5000 immutable
main let okCode ExitCode 0 immutable
main let usageCode ExitCode 2 immutable
main let lexCode ExitCode 3 immutable
main let fileCode ExitCode 4 immutable
main let outputCode ExitCode 5 immutable
main at begin do makeDeadline
main at begin do countArguments
main at begin do checkCount
main at begin branch if noPath goto usage else goto readPath
main at usage do writeUsage
main at usage branch ifError writeUsage goto usageDone else goto usageDone
main at usageDone return ok usageCode
main at readPath do readArgument
main at readPath branch ifError readArgument goto usage else goto readSource
# The path is computed, so `lexerFiles`'s scope is checked when the file is
# opened; a path outside `lexer-*` stops the program there (D-38).
main at readSource start readTask into none
main at readSource join readTask
main at readSource branch ifError readTask goto readFailed else goto decode
main at decode do decodeSource
main at decode branch ifError decodeSource goto notText else goto lex
main at notText match decodeError string.Utf8Error
main at notText case string.Utf8Error.invalidAt bind badOffset Int64 goto reportNotText
main at reportNotText do badOffsetDigits
main at reportNotText do joinNotTextPath
main at reportNotText do joinNotTextOffset
main at reportNotText do writeNotText
main at reportNotText branch ifError writeNotText goto lexDone else goto lexDone
main at lex do tokenizeSource
main at lex branch ifError tokenizeSource goto lexFailed else goto render
main at lexFailed match lexError lexer.LexError
main at lexFailed case lexer.LexError.invalidByte bind badAt string.Position goto invalidByte
main at lexFailed case lexer.LexError.unterminatedText bind openAt string.Position goto unterminated
main at lexFailed case lexer.LexError.integerTooLarge bind digitsAt string.Position goto tooLarge
main at invalidByte do readBadOffset
main at invalidByte do readBadByte
main at invalidByte branch ifError readBadByte goto lexDone else goto describeBad
main at describeBad do badByteValue
main at describeBad do badByteDigits
main at describeBad do joinBadByte
main at describeBad do reportInvalid
main at describeBad branch ifError reportInvalid goto lexDone else goto lexDone
main at unterminated do reportUnterminated
main at unterminated branch ifError reportUnterminated goto lexDone else goto lexDone
main at tooLarge do reportTooLarge
main at tooLarge branch ifError reportTooLarge goto lexDone else goto lexDone
main at lexDone return ok lexCode
main at render do newListing
main at render do writeTokens
main at render branch ifError writeTokens goto outputFailed else goto save
main at save do makeOutputPath
main at save do listingBytes
main at save start writeTask into none
main at save join writeTask
main at save branch ifError writeTask goto writeFailed else goto summarize
# The list always ends with endOfInput, so it is never empty and `readLast`
# cannot fail; its error branch is still stated.
main at summarize do countTokens
main at summarize do lastIndex
main at summarize do readLast
main at summarize branch ifError readLast goto outputFailed else goto describe
main at describe do readEnd
main at describe do readEndLine
main at describe do readEndColumn
main at describe do newSummary
main at describe do putSourcePath
main at describe do putCountLead
main at describe do putCount
main at describe do putTokensWord
main at describe do putEndLine
main at describe do putEndColon
main at describe do putEndColumn
main at describe do putWrittenWord
main at describe do putOutputPath
main at describe do finishSummary
main at describe branch ifError finishSummary goto outputFailed else goto printSummary
main at printSummary do printIt
main at printSummary branch ifError printIt goto outputFailed else goto finished
main at finished return ok okCode
main at readFailed do joinReadFailed
main at readFailed do writeReadFailed
main at readFailed branch ifError writeReadFailed goto fileDone else goto fileDone
main at writeFailed do joinWriteFailed
main at writeFailed do writeWriteFailed
main at writeFailed branch ifError writeWriteFailed goto fileDone else goto fileDone
main at fileDone return ok fileCode
main at outputFailed return ok outputCode

