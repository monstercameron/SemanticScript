# The lexer example's entry module: the command line, files, and messages.
#
# Exit codes: 0 done, 2 no source path was given, 3 the source is not valid
# (not UTF-8, or a byte that begins no token), 4 a file could not be read or
# written, 5 standard output failed.
#
# An invalid source is reported on standard error as `path:line:column: why`,
# the shape a compiler's diagnostics take.

lexfile is module
lexfile purpose "Read a source file named on the command line, tokenize it, and write the token list"
lexfile path lexfile
lexfile imports standard.console
lexfile imports standard.process
lexfile imports standard.fs
lexfile imports standard.string
lexfile imports standard.buffer
lexfile imports standard.convert
lexfile imports standard.list
lexfile imports standard.compare
lexfile imports standard.math
lexfile imports standard.time
lexfile imports lexer
lexfile exports main

stdoutWriter is capability
stdoutWriter purpose "Authority to print the summary on standard output"
stdoutWriter grants write console.stdout none

stderrWriter is capability
stderrWriter purpose "Authority to report problems on standard error"
stderrWriter grants write console.stderr none

argumentReader is capability
argumentReader purpose "Authority to read the source path from the command line"
argumentReader grants read process.arguments none

lexerFiles is capability
lexerFiles purpose "Authority to read and write files in the working directory whose names start with lexer-"
lexerFiles grants read fs.files "lexer-*"
lexerFiles grants write fs.files "lexer-*"

# ---------------------------------------------------------------- reporting

reportAt is operation
reportAt purpose "Write `path:line:column: message` on standard error"
reportAt invariant none
reportAt typeParameter none
reportAt input path String borrowed
reportAt input at string.Position copied
reportAt input message String borrowed
reportAt output none
reportAt outputOwnedBy none
reportAt raises console.WriteError
reportAt effect write console.stderr
reportAt uses stderrWriter
reportAt memoryHeap true
reportAt async false
reportAt maxRecursion none
reportAt label begin loopKind none
reportAt label begin within none
reportAt label located loopKind none
reportAt label located within none
reportAt label plain loopKind none
reportAt label plain within none
reportAt label locatedFailed loopKind none
reportAt label locatedFailed within none
reportAt label plainFailed loopKind none
reportAt label plainFailed within none
reportAt label done loopKind none
reportAt label done within none
reportAt let colon Byte 58 immutable
reportAt let separator String ": " immutable
reportAt at begin do makeText
reportAt at begin do putPath
reportAt at begin do putFirstColon
reportAt at begin do readLine
reportAt at begin do putLine
reportAt at begin do putSecondColon
reportAt at begin do readColumn
reportAt at begin do putColumn
reportAt at begin do putSeparator
reportAt at begin do putMessage
reportAt at begin do finishText
reportAt at begin branch ifError finishText goto plain else goto located
reportAt at located do writeLocated
reportAt at located branch ifError writeLocated goto locatedFailed else goto done
# A path from the command line need not be UTF-8; the message alone still is.
reportAt at plain do writePlain
reportAt at plain branch ifError writePlain goto plainFailed else goto done
reportAt at locatedFailed return error locatedError
reportAt at plainFailed return error plainError
reportAt at done return ok none

scratch is region
scratch in reportAt
scratch strategy arena
scratch maxBytes 65536
scratch released atReturn

