# stage0: the first stage of a SemanticScript compiler written in SemanticScript.
#
#     cd docs/refined-examples/stage0
#     refined run . -- samples/hello build/hello gcc \
#         ../../../semanticscript/compiler/refined/native_runtime.c [-lshell32]
#
# It reads the project directory named by the first argument: its build.sem
# names the modules (`includesModule`, in order) and the entry
# (`<module>.main`). It reads each module's file, `<module>.sem` in the
# project directory, and puts their texts one after another, after a module of
# its own, `string`, which declares the standard library's string.Position
# record. It tokenizes that program text (lexer), groups the tokens into rows
# of words (syntax), groups the rows into entities (model), checks module by
# module that the program is in the stage0 subset (subset), writes it as C
# (emitc) to the second argument with `.c` added, and runs the C compiler named
# by the third argument (gcc when there is none) to build the second argument
# as an executable. Every argument after the compiler's name is passed to it
# after the C file: the runtime of refined executables (native_runtime.c),
# which the C file is linked with, and any flags the platform needs (on
# Windows, `-lshell32` for the runtime's command line).
#
# A diagnostic names the file the word is in and the line within that file:
# each file's text starts at a known offset and line of the program text.
#
# Authority (build.sem, and the capabilities below): read the command line;
# read files under the working directory; write files under `build/`; run a C
# compiler named exactly `cc`, `gcc`, or `clang`. Paths come from the command
# line, so their scopes are checked when the files are opened (D-38); a path
# outside them stops the program before the file is touched.
#
# Exit codes: 0 built; 1 the program is refused, with a diagnostic
# `path:line:column: message (word)` on standard error; 2 usage; 3 a file could
# not be read or written, or a source is not UTF-8; 4 the C compiler could not
# be run or failed; 5 standard output failed.
#
# This module is generated from tools/stage0.dsl by tools/build.py.

stage0 is module
stage0 purpose "Compile a SemanticScript project in the stage0 subset to C and build it with the C compiler"
stage0 path stage0
stage0 imports standard.console
stage0 imports standard.process
stage0 imports standard.fs
stage0 imports standard.string
stage0 imports standard.buffer
stage0 imports standard.list
stage0 imports standard.compare
stage0 imports standard.math
stage0 imports standard.convert
stage0 imports standard.time
stage0 imports lexer
stage0 imports syntax
stage0 imports model
stage0 imports emitc
stage0 exports main

argumentReader is capability
argumentReader purpose "Authority to read the project path, output name, and compiler name"
argumentReader grants read process.arguments none

stdoutWriter is capability
stdoutWriter purpose "Authority to report what was built on standard output"
stdoutWriter grants write console.stdout none

stderrWriter is capability
stderrWriter purpose "Authority to report diagnostics and problems on standard error"
stderrWriter grants write console.stderr none

sourceFiles is capability
sourceFiles purpose "Authority to read a project's files under the working directory"
sourceFiles grants read fs.files "./"

buildFiles is capability
buildFiles purpose "Authority to write the C file under build/ and to make that directory"
buildFiles grants write fs.files "build/"

cCompilers is capability
cCompilers purpose "Authority to run a C compiler named exactly cc, gcc, or clang"
cCompilers grants spawn process.programs "cc"
cCompilers grants spawn process.programs "gcc"
cCompilers grants spawn process.programs "clang"

# The standard library's string.Position, declared for stage0 as a module of its own that comes first in every program
libraryText is constant
libraryText purpose "The standard library's records programs use, as a module stage0 puts before the program's own"
libraryText type String
libraryText value "string is module\nstring purpose \"The records of the standard library's string module, as stage0 declares them\"\nstring path string\nstring imports none\nstring exports Position\n\nPosition is record\nPosition purpose \"A place in a text: a byte offset, and the line and column it is on\"\nPosition typeParameter none\nPosition field offset Int64\nPosition field line Int64\nPosition field column Int64\n"

SourceFile is record
SourceFile purpose "A file of the program text: its path, the offset its text starts at, and the line it starts on"
SourceFile typeParameter none
SourceFile field path String
SourceFile field start Int64
SourceFile field line Int64

SourceFiles is typeInstance
SourceFiles purpose "The files of a program, in the order their texts follow one another"
SourceFiles in none
SourceFiles instantiates list.List SourceFile

Texts is typeInstance
Texts purpose "Names or paths, in order"
Texts in none
Texts instantiates list.List String

FileProblem is enum
FileProblem purpose "Why a module's file could not be used, with its position in the list of paths"
FileProblem typeParameter none
FileProblem variant unreadable Int64
FileProblem variant notText Int64

