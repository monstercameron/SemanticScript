# stage0: the first stage of a SemanticScript compiler written in SemanticScript.
#
#     cd docs/refined-examples/stage0
#     refined run . -- samples/hello/hello.sem build/hello [cc|gcc|clang]
#
# It reads the module file named by the first argument, tokenizes it (lexer),
# groups the tokens into rows of words (syntax), groups the rows into entities
# (model), checks that the module is in the stage0 subset (subset), writes it
# as C (emitc) to the second argument with `.c` added, and runs the C compiler
# named by the third argument (gcc when there is none) to build the second
# argument as an executable.
#
# Authority (build.sem, and the capabilities below): read the command line;
# read files under the working directory; write files under `build/`; run a C
# compiler named exactly `cc`, `gcc`, or `clang`. Paths come from the command
# line, so their scopes are checked when the files are opened (D-38); a path
# outside them stops the program before the file is touched.
#
# Exit codes: 0 built; 1 the source is refused, with a diagnostic
# `path:line:column: message (word)` on standard error; 2 usage; 3 a file could
# not be read or written, or the source is not UTF-8; 4 the C compiler could not
# be run or failed; 5 standard output failed.

stage0 is module
stage0 purpose "Compile a SemanticScript module in the stage0 subset to C and build it with the C compiler"
stage0 path stage0
stage0 imports standard.console
stage0 imports standard.process
stage0 imports standard.fs
stage0 imports standard.string
stage0 imports standard.buffer
stage0 imports standard.compare
stage0 imports standard.convert
stage0 imports standard.time
stage0 imports lexer
stage0 imports syntax
stage0 imports model
stage0 imports subset
stage0 imports emitc
stage0 exports main

argumentReader is capability
argumentReader purpose "Authority to read the source path, output name, and compiler name"
argumentReader grants read process.arguments none

stdoutWriter is capability
stdoutWriter purpose "Authority to report what was built on standard output"
stdoutWriter grants write console.stdout none

stderrWriter is capability
stderrWriter purpose "Authority to report diagnostics and problems on standard error"
stderrWriter grants write console.stderr none

sourceFiles is capability
sourceFiles purpose "Authority to read source files under the working directory"
sourceFiles grants read fs.files "./"

buildFiles is capability
buildFiles purpose "Authority to write the C file under build/ and to make that directory"
buildFiles grants write fs.files "build/"

cCompilers is capability
cCompilers purpose "Authority to run a C compiler named exactly cc, gcc, or clang"
cCompilers grants spawn process.programs "cc"
cCompilers grants spawn process.programs "gcc"
cCompilers grants spawn process.programs "clang"

reportRejection is operation
reportRejection purpose "Write a rejection on standard error as `path:line:column: message (word)`"
reportRejection invariant none
reportRejection typeParameter none
reportRejection input path String borrowed
reportRejection input source String borrowed
reportRejection input rejection syntax.Rejection copied
reportRejection output none
reportRejection outputOwnedBy none
reportRejection raises console.WriteError
reportRejection effect write console.stderr
reportRejection uses stderrWriter
reportRejection memoryHeap true
reportRejection async false
reportRejection maxRecursion none
reportRejection label begin loopKind none
reportRejection label begin within none
reportRejection label locate loopKind none
reportRejection label locate within none
reportRejection label plain loopKind none
reportRejection label plain within none
reportRejection label done loopKind none
reportRejection label done within none
reportRejection label locatedFailed loopKind none
reportRejection label locatedFailed within none
reportRejection label plainFailed loopKind none
reportRejection label plainFailed within none
reportRejection let colon Byte 58 immutable
reportRejection at begin do describe
reportRejection at begin do newText
reportRejection at begin do putPath
reportRejection at begin do putColon
reportRejection at begin do putDescription
reportRejection at begin do finishText
reportRejection at begin branch ifError finishText goto plain else goto locate
reportRejection at locate do writeLocated
reportRejection at locate branch ifError writeLocated goto locatedFailed else goto done
reportRejection at plain do writePlain
reportRejection at plain branch ifError writePlain goto plainFailed else goto done
reportRejection at done return ok none
reportRejection at locatedFailed return error locatedError
reportRejection at plainFailed return error plainError

