modelTest at foundstdoutWriter do expectFirststdoutWriter
modelTest at foundstdoutWriter do countOfstdoutWriter
modelTest at foundstdoutWriter do expectCountstdoutWriter
modelTest at foundstdoutWriter do findmain
modelTest at foundstdoutWriter branch ifError findmain goto refused else goto foundmain
modelTest at foundmain do readmain
modelTest at foundmain do kindOfmain
modelTest at foundmain do expectKindmain
modelTest at foundmain do firstOfmain
modelTest at foundmain do expectFirstmain
modelTest at foundmain do countOfmain
