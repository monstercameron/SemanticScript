# ---------------------------------------------------------------- the whole program

emitProgram is operation
emitProgram purpose "Write a checked stage0 program as one C file: the prelude, then main"
emitProgram invariant writesC "Writes the prelude, then `int main(void)` declaring every value, failure flag, and loop counter, setting constants and then lets, and every label of main as a C label followed by its steps, in source order"
emitProgram invariant countsLoopPasses "A jump to a bounded loop header from inside the loop counts a pass, which traps past the bound; a jump from outside resets the count"
emitProgram typeParameter none
emitProgram input source String borrowed
emitProgram input values subset.Values borrowed
emitProgram input calls subset.Calls borrowed
emitProgram input labels subset.Labels borrowed
emitProgram input steps subset.Steps borrowed
emitProgram input buffer buffer.ByteBuffer borrowedMutable
