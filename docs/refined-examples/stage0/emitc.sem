prelude is constant
prelude purpose "The runtime every emitted program starts with"
prelude type String
prelude value "/* Generated by stage0, the first SemanticScript compiler written in SemanticScript. Link it with the runtime of\n   refined executables, semanticscript/compiler/refined/native_runtime.c, which writes output, traps, keeps\n   regions, and runs the host library, as it does for `refined build --kind executable`. */\n#include <stdbool.h>\n#include <stdint.h>\n#include <string.h>\n\nvoid refined_start(int argc, char **argv);\nvoid refined_trap(const char *p, int64_t n);\nint32_t refined_write(int32_t fd, const char *p, int64_t n, int32_t newline);\nint32_t refined_write_int(int32_t fd, int64_t v, int32_t newline);\nvoid *refined_region_new(int64_t capacity, const char *label, int64_t label_len);\nvoid *refined_region_alloc(void *handle, int64_t size);\nvoid refined_region_free(void *handle);\nvoid *refined_format_int(int64_t v, void *region, int64_t *out_len);\nint64_t refined_find(const char *h, int64_t hn, const char *nd, int64_t nn);\nint32_t refined_bytes_equal(const char *a, int64_t an, const char *b, int64_t bn);\nint32_t refined_parse_int(const char *p, int64_t n, int64_t *out);\nint32_t refined_host(const char *name, int64_t n, int64_t *args, int64_t *results, int64_t *payload);\n\n/* text: a pointer and a length in bytes, as the LLVM backend's {i8*, i64} */\ntypedef struct { const char *p; int64_t n; } ss_string;\n#define SS_TEXT(s) ((ss_string){ (s), (int64_t)(sizeof(s) - 1) })\n#define SS_STATIC(s) { (s), (int64_t)(sizeof(s) - 1) }\ntypedef void ss_region;\n\nstatic void ss_trap(const char *what) {\n  refined_trap(what, (int64_t)strlen(what));\n}\n\nstatic bool ss_write(ss_string text) {\n  return refined_write(1, text.p, text.n, 0) != 0;\n}\n\nstatic bool ss_write_line(ss_string text) {\n  return refined_write(1, text.p, text.n, 1) != 0;\n}\n\nstatic bool ss_write_integer_line(int64_t value) {\n  return refined_write_int(1, value, 1) != 0;\n}\n\nstatic bool ss_write_error(ss_string text) {\n  return refined_write(2, text.p, text.n, 1) != 0;\n}\n\nstatic bool ss_is_letter(uint8_t v) {\n  return (v >= 'a' && v <= 'z') || (v >= 'A' && v <= 'Z');\n}\n\nstatic bool ss_is_digit(uint8_t v) {\n  return v >= '0' && v <= '9';\n}\n\nstatic bool ss_is_letter_or_digit(uint8_t v) {\n  return ss_is_letter(v) || ss_is_digit(v);\n}\n\nstatic bool ss_is_space(uint8_t v) {\n  return v == 32 || v == 9 || v == 10 || v == 13;\n}\n\nstatic int64_t ss_add(int64_t left, int64_t right) {\n  int64_t out;\n  if (__builtin_add_overflow(left, right, &out)) ss_trap(\"math.addInt64 overflowed Int64\");\n  return out;\n}\n\nstatic int64_t ss_subtract(int64_t left, int64_t right) {\n  int64_t out;\n  if (__builtin_sub_overflow(left, right, &out)) ss_trap(\"math.subtractInt64 overflowed Int64\");\n  return out;\n}\n\nstatic int64_t ss_multiply(int64_t left, int64_t right) {\n  int64_t out;\n  if (__builtin_mul_overflow(left, right, &out)) ss_trap(\"math.multiplyInt64 overflowed Int64\");\n  return out;\n}\n\nstatic int64_t ss_divide(int64_t left, int64_t right) {\n  if (right == 0) ss_trap(\"math.divideInt64 divided by zero\");\n  if (left == INT64_MIN && right == -1) ss_trap(\"math.divideInt64 overflowed Int64\");\n  return left / right;\n}\n\nstatic int64_t ss_remainder(int64_t left, int64_t right) {\n  if (right == 0) ss_trap(\"math.remainderInt64 divided by zero\");\n  if (left == INT64_MIN && right == -1) ss_trap(\"math.remainderInt64 overflowed Int64\");\n  return left % right;\n}\n\nstatic int64_t ss_negate(int64_t value) {\n  if (value == INT64_MIN) ss_trap(\"math.negateInt64 overflowed Int64\");\n  return -value;\n}\n\nstatic int64_t ss_absolute(int64_t value) {\n  if (value == INT64_MIN) ss_trap(\"math.absoluteInt64 overflowed Int64\");\n  return value < 0 ? -value : value;\n}\n\nstatic int ss_exit_code(int64_t value) {\n  if (value < 0 || value > 255) ss_trap(\"convert.int64ToExitCode was given a value outside 0 to 255\");\n  return (int)value;\n}\n\nstatic uint8_t ss_to_byte(int64_t value) {\n  if (value < 0 || value > 255) ss_trap(\"convert.int64ToByte was given a value outside 0 to 255\");\n  return (uint8_t)value;\n}\n\nstatic void ss_pass(int64_t *passes, int64_t bound, const char *label) {\n  *passes += 1;\n  if (*passes > bound) ss_trap(\"a loop returned to its header more often than its maxIterations\");\n  (void)label;\n}\n\nstatic void ss_deeper(int64_t *depth, int64_t bound, const char *name) {\n  *depth += 1;\n  if (*depth > bound) ss_trap(\"an operation called itself deeper than its maxRecursion\");\n  (void)name;\n}\n\n/* regions are the runtime's: every allocation is counted against maxBytes as the LLVM backend counts it */\nstatic ss_region *ss_region_new(int64_t capacity, const char *label) {\n  return refined_region_new(capacity, label, (int64_t)strlen(label));\n}\n\nstatic void *ss_alloc(ss_region *r, int64_t size) {\n  return refined_region_alloc(r, size);\n}\n\nstatic void ss_region_free(ss_region *r) {\n  refined_region_free(r);\n}\n\n/* text */\nstatic ss_string ss_relocate(ss_string text, ss_region *r) {\n  char *p = ss_alloc(r, text.n);\n  if (text.n) memcpy(p, text.p, (size_t)text.n);\n  return (ss_string){ p, text.n };\n}\n\nstatic ss_string ss_concat(ss_string left, ss_string right, ss_region *r) {\n  char *p = ss_alloc(r, left.n + right.n);\n  if (left.n) memcpy(p, left.p, (size_t)left.n);\n  if (right.n) memcpy(p + left.n, right.p, (size_t)right.n);\n  return (ss_string){ p, left.n + right.n };\n}\n\nstatic ss_string ss_from_int64(int64_t value, ss_region *r) {\n  int64_t n = 0;\n  const char *p = refined_format_int(value, r, &n);\n  return (ss_string){ p, n };\n}\n\nstatic bool ss_equals(ss_string left, ss_string right) {\n  return refined_bytes_equal(left.p, left.n, right.p, right.n) != 0;\n}\n\nstatic bool ss_starts_with(ss_string text, ss_string prefix) {\n  return text.n >= prefix.n && refined_bytes_equal(text.p, prefix.n, prefix.p, prefix.n) != 0;\n}\n\nstatic bool ss_to_int64(int64_t *out, ss_string text) {\n  return refined_parse_int(text.p, text.n, out) != 0;\n}\n\nstatic ss_string ss_to_bytes(ss_string text) {\n  return text;\n}\n\nstatic int64_t ss_byte_length(ss_string text) {\n  return text.n;\n}\n\nstatic bool ss_splits(ss_string text, int64_t at) {\n  return at >= 0 && at < text.n && ((unsigned char)text.p[at] & 0xC0) == 0x80;\n}\n\n/* string.slice: a view of whole characters inside the text, or the failure flag */\nstatic bool ss_slice(ss_string *out, ss_string text, int64_t start, int64_t length) {\n  if (start < 0 || length < 0 || start > text.n || length > text.n - start) return true;\n  if (ss_splits(text, start) || ss_splits(text, start + length)) return true;\n  *out = (ss_string){ text.p + start, length };\n  return false;\n}\n\nstatic bool ss_byte_at(uint8_t *out, ss_string text, int64_t index) {\n  if (index < 0 || index >= text.n) return true;\n  *out = (uint8_t)text.p[index];\n  return false;\n}\n\nstatic uint8_t ss_byte_at_or_trap(ss_string text, int64_t index) {\n  if (index < 0 || index >= text.n) ss_trap(\"string.byteAtOrTrap read a byte outside its text\");\n  return (uint8_t)text.p[index];\n}\n\nstatic bool ss_find(int64_t *out, ss_string text, ss_string needle) {\n  int64_t at = refined_find(text.p, text.n, needle.p, needle.n);\n  if (at < 0) return true;\n  *out = at;\n  return false;\n}\n\n/* lists: a header {length, capacity, data, region, identity} in the list's region, as the LLVM backend's, and a\n   data block that starts at four items and doubles */\ntypedef struct { int64_t length, capacity; void *data; ss_region *region; int64_t identity; } ss_list;\nstatic int64_t ss_lists;\n\nstatic ss_list *ss_list_new(ss_region *r) {\n  ss_list *list = ss_alloc(r, (int64_t)sizeof(ss_list));\n  memset(list, 0, sizeof(ss_list));\n  list->region = r;\n  ss_lists += 1;\n  list->identity = ss_lists;\n  return list;\n}\n\nstatic void *ss_list_slot(ss_list *list, int64_t size) {\n  if (list->length == list->capacity) {\n    int64_t capacity = list->capacity == 0 ? 4 : list->capacity * 2;\n    char *fresh = ss_alloc(list->region, capacity * size);\n    if (list->length) memcpy(fresh, list->data, (size_t)(list->length * size));\n    list->data = fresh;\n    list->capacity = capacity;\n  }\n  list->length += 1;\n  return (char *)list->data + (list->length - 1) * size;\n}\n\nstatic bool ss_list_outside(ss_list *list, int64_t index) {\n  return index < 0 || index >= list->length;\n}\n\nstatic void ss_list_trap(void) {\n  ss_trap(\"a list was read at a position outside it\");\n}\n\n"

