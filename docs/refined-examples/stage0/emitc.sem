prelude is constant
prelude purpose "The runtime every emitted program starts with: console output and checked arithmetic"
prelude type String
prelude value "/* Generated by stage0, the first SemanticScript compiler written in SemanticScript. */\n#include <stdbool.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n#ifdef _WIN32\n#include <fcntl.h>\n#include <io.h>\n#endif\n\nstatic void ss_start(void) {\n#ifdef _WIN32\n  _setmode(_fileno(stdout), _O_BINARY);\n#endif\n}\n\nstatic void ss_trap(const char *what) {\n  fflush(stdout);\n  fprintf(stderr, \"trap: %s\\n\", what);\n  exit(70);\n}\n\nstatic bool ss_write(const char *text) {\n  return fputs(text, stdout) == EOF;\n}\n\nstatic bool ss_write_line(const char *text) {\n  return fputs(text, stdout) == EOF || fputc('\\n', stdout) == EOF;\n}\n\nstatic bool ss_write_integer_line(int64_t value) {\n  char digits[24];\n  int at = 23;\n  uint64_t rest = value < 0 ? (uint64_t)0 - (uint64_t)value : (uint64_t)value;\n  digits[at] = '\\0';\n  do {\n    at -= 1;\n    digits[at] = (char)('0' + rest % 10);\n    rest /= 10;\n  } while (rest != 0);\n  if (value < 0) {\n    at -= 1;\n    digits[at] = '-';\n  }\n  return ss_write_line(digits + at);\n}\n\nstatic int64_t ss_add(int64_t left, int64_t right) {\n  int64_t out;\n  if (__builtin_add_overflow(left, right, &out)) ss_trap(\"math.addInt64 overflowed Int64\");\n  return out;\n}\n\nstatic int64_t ss_subtract(int64_t left, int64_t right) {\n  int64_t out;\n  if (__builtin_sub_overflow(left, right, &out)) ss_trap(\"math.subtractInt64 overflowed Int64\");\n  return out;\n}\n\nstatic int64_t ss_multiply(int64_t left, int64_t right) {\n  int64_t out;\n  if (__builtin_mul_overflow(left, right, &out)) ss_trap(\"math.multiplyInt64 overflowed Int64\");\n  return out;\n}\n\nstatic int64_t ss_divide(int64_t left, int64_t right) {\n  if (right == 0) ss_trap(\"math.divideInt64 divided by zero\");\n  if (left == INT64_MIN && right == -1) ss_trap(\"math.divideInt64 overflowed Int64\");\n  return left / right;\n}\n\nstatic int64_t ss_remainder(int64_t left, int64_t right) {\n  if (right == 0) ss_trap(\"math.remainderInt64 divided by zero\");\n  if (left == INT64_MIN && right == -1) ss_trap(\"math.remainderInt64 overflowed Int64\");\n  return left % right;\n}\n\nstatic int64_t ss_negate(int64_t value) {\n  if (value == INT64_MIN) ss_trap(\"math.negateInt64 overflowed Int64\");\n  return -value;\n}\n\nstatic int64_t ss_absolute(int64_t value) {\n  if (value == INT64_MIN) ss_trap(\"math.absoluteInt64 overflowed Int64\");\n  return value < 0 ? -value : value;\n}\n\nstatic int ss_exit_code(int64_t value) {\n  if (value < 0 || value > 255) ss_trap(\"convert.int64ToExitCode was given a value outside 0 to 255\");\n  return (int)value;\n}\n\nstatic void ss_pass(int64_t *passes, int64_t bound, const char *label) {\n  *passes += 1;\n  if (*passes > bound) {\n    fflush(stdout);\n    fprintf(stderr, \"trap: loop `%s` returned to its header more often than its maxIterations\\n\", label);\n    exit(70);\n  }\n}\n\n"

