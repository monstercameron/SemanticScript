# ---------------------------------------------------------------- one operation as a C function
putLocals is operation
putLocals purpose "Declare an operation's values, failure flags, loop counters and positions, and regions, then set its lets"
putLocals invariant none
putLocals typeParameter none
putLocals input buffer buffer.ByteBuffer borrowedMutable
putLocals input source String borrowed
putLocals input types subset.Types borrowed
putLocals input op subset.OpInfo copied
putLocals input values subset.Values borrowed
putLocals input calls subset.Calls borrowed
putLocals input labels subset.Labels borrowed
putLocals output none
putLocals outputOwnedBy none
putLocals raises syntax.Rejection
putLocals effect none
putLocals uses none
putLocals memoryHeap false
putLocals async false
putLocals maxRecursion none
putLocals label begin loopKind none
putLocals label begin within none
putLocals label eachValue loopKind forEach
putLocals label eachValue within none
putLocals label eachValue maxIterations valueCount
putLocals label eachValue over values
putLocals label readValue loopKind none
putLocals label readValue within eachValue
