putMapHelpers let keyBody String "(int64_t m, int64_t i) {\n  int64_t a[2] = { m, i };\n  int64_t o[2] = {0, 0};\n  int64_t e = 0;\n  (void)SS_HOST(\"map.Map.keyAt|1,1|2\", a, o, &e);\n  return (ss_string){ (const char *)(intptr_t)o[0], o[1] };\n}\n\n" immutable
