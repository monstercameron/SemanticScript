putMapHelpers let getArrays String "];\n  int64_t e = 0;\n  memset(o, 0, sizeof o);\n  if (SS_HOST(\"map.Map.get|1,2|" immutable
putMapHelpers let getCall String "\", a, o, &e) != 0) return true;\n  if (out) *out = " immutable
putMapHelpers let resultsName String "o" immutable
putMapHelpers let zero Int64 0 immutable
putMapHelpers let getEnd String ";\n  return false;\n}\n\nstatic bool mc_" immutable
