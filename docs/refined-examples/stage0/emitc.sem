emitProgram label sameLabelFailed within none
emitProgram label putOneStepFailed loopKind none
emitProgram label putOneStepFailed within none
emitProgram let mainOpen String "int main(void) {\n  ss_start();\n" immutable
emitProgram let startText String "  goto l_begin;\n" immutable
emitProgram let labelPrefix String "l_" immutable
emitProgram let labelEnd String ":;\n" immutable
emitProgram let mainClose String "}\n" immutable
emitProgram let constantOrigin Int64 1 immutable
emitProgram let letOrigin Int64 2 immutable
emitProgram let yes Bool true immutable
emitProgram let started Bool false mutable
emitProgram let previous syntax.Word anchor mutable
emitProgram at begin do putPrelude
emitProgram at begin do putMainOpen
emitProgram at begin do declareValues
emitProgram at begin branch ifError declareValues goto declareValuesFailed else goto flags
emitProgram at flags do declareFlags
emitProgram at flags branch ifError declareFlags goto declareFlagsFailed else goto counters
emitProgram at counters do declareCounters
emitProgram at counters branch ifError declareCounters goto declareCountersFailed else goto constants
emitProgram at constants do setConstants
emitProgram at constants branch ifError setConstants goto setConstantsFailed else goto lets
emitProgram at lets do setLets
emitProgram at lets branch ifError setLets goto setLetsFailed else goto start
emitProgram at start do putStart
emitProgram at start do countSteps
emitProgram at start goto eachStep
emitProgram at eachStep branch ifNext steps bind step subset.Step goto readStep else goto finish
emitProgram at readStep do readLabel
emitProgram at readStep branch if started goto compareLabel else goto newLabel
emitProgram at compareLabel do sameLabel
emitProgram at compareLabel branch ifError sameLabel goto sameLabelFailed else goto labelCompared
emitProgram at labelCompared branch if sameBlock goto writeStep else goto newLabel
emitProgram at newLabel do putLabelPrefix
emitProgram at newLabel do putLabelName
emitProgram at newLabel do putLabelEnd
emitProgram at newLabel set started yes
emitProgram at newLabel set previous label
emitProgram at newLabel goto writeStep
