# A stage0 sample: text. It slices a word out of a sentence, reads a byte,
# joins texts and a number in a region, compares texts, finds a word (and
# branches when a word is missing), and reads constants of several types. It
# exits with code 0:
#
#   brown
#   byte: 113
#   length: 19
#   quick brown fox 42
#   equal: true
#   fox at 16
#   no cat
#   limit: 3
strings is module
strings purpose "Slice, search, join, and compare text"
strings path strings
strings imports standard.console
strings imports standard.string
strings imports standard.convert
strings exports main

stdoutWriter is capability
stdoutWriter purpose "Authority to write lines to standard output"
stdoutWriter grants write console.stdout none

sentence is constant
sentence purpose "The text the sample reads"
sentence type String
sentence value "the quick brown fox"

limit is constant
limit purpose "A whole number"
limit type Int64
limit value 3

verbose is constant
verbose purpose "Whether the sample prints its limit"
verbose type Bool
verbose value true

main is operation
main purpose "Read and build text, printing what is found"
main invariant none
main typeParameter none
main input none
main output ExitCode
main outputOwnedBy none
main raises none
main effect write console.stdout
main uses stdoutWriter
main memoryHeap true
main async false
main maxRecursion none
main label begin loopKind none
main label begin within none
main label cutBrownDone loopKind none
main label cutBrownDone within none
main label printBrownDone loopKind none
main label printBrownDone within none
main label readByteDone loopKind none
main label readByteDone within none
main label writeByteLeadDone loopKind none
main label writeByteLeadDone within none
main label printByteDone loopKind none
main label printByteDone within none
main label writeLengthLeadDone loopKind none
main label writeLengthLeadDone within none
main label printLengthDone loopKind none
main label printLengthDone within none
main label cutTailDone loopKind none
main label cutTailDone within none
main label printJoinedDone loopKind none
main label printJoinedDone within none
main label writeEqualLeadDone loopKind none
main label writeEqualLeadDone within none
main label printTrue loopKind none
main label printTrue within none
main label writeTrueDone loopKind none
main label writeTrueDone within none
main label printFalse loopKind none
main label printFalse within none
main label writeFalseDone loopKind none
main label writeFalseDone within none
main label findFox loopKind none
main label findFox within none
main label findItDone loopKind none
main label findItDone within none
main label writeFoxLeadDone loopKind none
main label writeFoxLeadDone within none
main label printFoxDone loopKind none
main label printFoxDone within none
main label findCatDone loopKind none
main label findCatDone within none
main label printCatDone loopKind none
main label printCatDone within none
main label noCat loopKind none
main label noCat within none
main label writeNoCatDone loopKind none
main label writeNoCatDone within none
main label constants loopKind none
main label constants within none
main label printLimit loopKind none
main label printLimit within none
main label writeLimitLeadDone loopKind none
main label writeLimitLeadDone within none
main label printLimitValueDone loopKind none
main label printLimitValueDone within none
main label done loopKind none
main label done within none
main label failed loopKind none
main label failed within none
main let okCode ExitCode 0 immutable
main let failCode ExitCode 1 immutable
main let ten Int64 10 immutable
main let five Int64 5 immutable
main let four Int64 4 immutable
main let byteText String "byte: " immutable
main let lengthText String "length: " immutable
main let fifteen Int64 15 immutable
main let space String " " immutable
main let fortyTwo Int64 42 immutable
main let brownText String "brown" immutable
main let equalText String "equal: " immutable
main let trueText String "true" immutable
main let falseText String "false" immutable
main let fox String "fox" immutable
main let foxText String "fox at " immutable
main let cat String "cat" immutable
main let noCatText String "no cat" immutable
main let limitText String "limit: " immutable
main at begin do cutBrown
main at begin branch ifError cutBrown goto failed else goto cutBrownDone
main at cutBrownDone do printBrown
main at cutBrownDone branch ifError printBrown goto printBrownDone else goto printBrownDone
main at printBrownDone do readByte
main at printBrownDone branch ifError readByte goto failed else goto readByteDone
main at readByteDone do widen
main at readByteDone do writeByteLead
main at readByteDone branch ifError writeByteLead goto writeByteLeadDone else goto writeByteLeadDone
main at writeByteLeadDone do printByte
main at writeByteLeadDone branch ifError printByte goto printByteDone else goto printByteDone
main at printByteDone do measure
main at printByteDone do writeLengthLead
main at printByteDone branch ifError writeLengthLead goto writeLengthLeadDone else goto writeLengthLeadDone
main at writeLengthLeadDone do printLength
main at writeLengthLeadDone branch ifError printLength goto printLengthDone else goto printLengthDone
main at printLengthDone do cutTail
main at printLengthDone branch ifError cutTail goto failed else goto cutTailDone
main at cutTailDone do joinSpace
main at cutTailDone do numberText
main at cutTailDone do joinNumber
main at cutTailDone do printJoined
main at cutTailDone branch ifError printJoined goto printJoinedDone else goto printJoinedDone
main at printJoinedDone do compareTexts
main at printJoinedDone do writeEqualLead
main at printJoinedDone branch ifError writeEqualLead goto writeEqualLeadDone else goto writeEqualLeadDone
main at writeEqualLeadDone branch if same goto printTrue else goto printFalse
main at printTrue do writeTrue
main at printTrue branch ifError writeTrue goto writeTrueDone else goto writeTrueDone
main at writeTrueDone goto findFox
main at printFalse do writeFalse
main at printFalse branch ifError writeFalse goto writeFalseDone else goto writeFalseDone
main at writeFalseDone goto findFox
main at findFox do findIt
main at findFox branch ifError findIt goto failed else goto findItDone
main at findItDone do writeFoxLead
main at findItDone branch ifError writeFoxLead goto writeFoxLeadDone else goto writeFoxLeadDone
main at writeFoxLeadDone do printFox
main at writeFoxLeadDone branch ifError printFox goto printFoxDone else goto printFoxDone
main at printFoxDone do findCat
main at printFoxDone branch ifError findCat goto noCat else goto findCatDone
main at findCatDone do printCat
main at findCatDone branch ifError printCat goto printCatDone else goto printCatDone
main at printCatDone goto constants
main at noCat do writeNoCat
main at noCat branch ifError writeNoCat goto writeNoCatDone else goto writeNoCatDone
main at writeNoCatDone goto constants
main at constants branch if verbose goto printLimit else goto done
main at printLimit do writeLimitLead
main at printLimit branch ifError writeLimitLead goto writeLimitLeadDone else goto writeLimitLeadDone
main at writeLimitLeadDone do printLimitValue
main at writeLimitLeadDone branch ifError printLimitValue goto printLimitValueDone else goto printLimitValueDone
main at printLimitValueDone goto done
main at done return ok okCode
main at failed return ok failCode

scratch is region
scratch in main
scratch strategy arena
scratch maxBytes 65536
scratch released atReturn

cutBrown is call
cutBrown in main
cutBrown invokes string.slice
cutBrown argument text String sentence lend
cutBrown argument start Int64 ten copy
cutBrown argument length Int64 five copy
cutBrown result brown String
cutBrown ownedBy none
cutBrown cleanedBy none
cutBrown borrows sentence
cutBrown catch cutBrownError string.StringIndexError
cutBrown suppresses none

printBrown is call
printBrown rationale "The failure has nowhere to be reported, so it is discarded"
printBrown in main
printBrown invokes console.writeLine
printBrown argument text String brown lend
printBrown result none
printBrown ownedBy none
printBrown cleanedBy none
printBrown borrows none
printBrown catch printBrownError console.WriteError
printBrown suppresses console.WriteError.failed

