# A stage0 sample of two modules: `app` uses the record, enum, and
# operations of `shapes`, which build.sem includes before it, by their
# qualified names (`shapes.Rectangle.new`, `shapes.area`, `shapes.Kind`),
# widens a square with `shapes.Rectangle.with`, and declares a record `Label`
# and a constant `sides` of its own whose names shapes also uses. It exits
# with code 0:
#
#   area: 12
#   oblong
#   area: 25
#   square
#   area: 35
#   oblong
#   app label: app (width 3)
#   shapes label: shapes
#   app sides: 3
#   shapes sides: 4
app is module
app purpose "Measure rectangles with the shapes module, and keep names of its own"
app path app
app imports standard.console
app imports standard.string
app imports shapes
app exports main

stdoutWriter is capability
stdoutWriter purpose "Authority to write lines to standard output"
stdoutWriter grants write console.stdout none

Label is record
Label purpose "A name the app gives something, with a width of its own"
Label typeParameter none
Label field text String
Label field width Int64

sides is constant
sides purpose "How many sides the app's own shape, a triangle, has"
sides type Int64
sides value 3

report is operation
report purpose "Print a label and a number on one line; a failed write is discarded"
report invariant none
report typeParameter none
report input label String borrowed
report input value Int64 copied
report output none
report outputOwnedBy none
report raises none
report effect write console.stdout
report uses stdoutWriter
report memoryHeap false
report async false
report maxRecursion none
report label begin loopKind none
report label begin within none
report label writeLabelDone loopKind none
report label writeLabelDone within none
report label writeValueDone loopKind none
report label writeValueDone within none
report let none
report at begin do writeLabel
report at begin branch ifError writeLabel goto writeLabelDone else goto writeLabelDone
report at writeLabelDone do writeValue
report at writeLabelDone branch ifError writeValue goto writeValueDone else goto writeValueDone
report at writeValueDone return ok none

writeLabel is call
writeLabel rationale "The failure has nowhere to be reported, so it is discarded"
writeLabel in report
writeLabel invokes console.write
writeLabel argument text String label lend
writeLabel result none
writeLabel ownedBy none
writeLabel cleanedBy none
writeLabel borrows none
writeLabel catch writeLabelError console.WriteError
writeLabel suppresses console.WriteError.failed

writeValue is call
writeValue rationale "The failure has nowhere to be reported, so it is discarded"
writeValue in report
writeValue invokes console.writeIntegerLine
writeValue argument value Int64 value copy
writeValue result none
writeValue ownedBy none
writeValue cleanedBy none
writeValue borrows none
writeValue catch writeValueError console.WriteError
writeValue suppresses console.WriteError.failed

measure is operation
measure purpose "Print a rectangle's area and kind"
measure invariant none
measure typeParameter none
measure input shape shapes.Rectangle copied
measure output none
measure outputOwnedBy none
measure raises none
measure effect write console.stdout
measure uses stdoutWriter
measure memoryHeap false
measure async false
measure maxRecursion none
measure label begin loopKind none
measure label begin within none
measure label square loopKind none
measure label square within none
measure label writeSquareDone loopKind none
measure label writeSquareDone within none
measure label oblong loopKind none
measure label oblong within none
measure label writeOblongDone loopKind none
measure label writeOblongDone within none
measure let areaText String "area: " immutable
measure let squareText String "square" immutable
measure let oblongText String "oblong" immutable
measure at begin do readArea
measure at begin do reportArea
measure at begin do readKind
measure at begin match kind shapes.Kind
measure at begin case shapes.Kind.square bind none none goto square
measure at begin case shapes.Kind.oblong bind none none goto oblong
measure at square do writeSquare
measure at square branch ifError writeSquare goto writeSquareDone else goto writeSquareDone
measure at writeSquareDone return ok none
measure at oblong do writeOblong
measure at oblong branch ifError writeOblong goto writeOblongDone else goto writeOblongDone
measure at writeOblongDone return ok none

readArea is call
readArea in measure
readArea invokes shapes.area
readArea argument shape shapes.Rectangle shape copy
readArea result shapeArea Int64
readArea ownedBy none
readArea cleanedBy none
readArea borrows none
readArea catch none
readArea suppresses none

reportArea is call
reportArea in measure
reportArea invokes report
reportArea argument label String areaText lend
reportArea argument value Int64 shapeArea copy
reportArea result none
reportArea ownedBy none
reportArea cleanedBy none
reportArea borrows none
reportArea catch none
reportArea suppresses none

readKind is call
readKind in measure
readKind invokes shapes.kindOf
readKind argument shape shapes.Rectangle shape copy
readKind result kind shapes.Kind
readKind ownedBy none
readKind cleanedBy none
readKind borrows none
readKind catch none
readKind suppresses none

writeSquare is call
writeSquare rationale "The failure has nowhere to be reported, so it is discarded"
writeSquare in measure
writeSquare invokes console.writeLine
writeSquare argument text String squareText lend
writeSquare result none
writeSquare ownedBy none
writeSquare cleanedBy none
writeSquare borrows none
writeSquare catch writeSquareError console.WriteError
writeSquare suppresses console.WriteError.failed

writeOblong is call
writeOblong rationale "The failure has nowhere to be reported, so it is discarded"
writeOblong in measure
writeOblong invokes console.writeLine
writeOblong argument text String oblongText lend
writeOblong result none
writeOblong ownedBy none
writeOblong cleanedBy none
writeOblong borrows none
writeOblong catch writeOblongError console.WriteError
writeOblong suppresses console.WriteError.failed

main is operation
main purpose "Measure two rectangles and print labels and constants of both modules"
main invariant none
main typeParameter none
main input none
main output ExitCode
main outputOwnedBy none
main raises none
main effect write console.stdout
main uses stdoutWriter
main memoryHeap true
main async false
main maxRecursion none
main label begin loopKind none
main label begin within none
main label writeAppLeadDone loopKind none
main label writeAppLeadDone within none
main label writeAppTextDone loopKind none
main label writeAppTextDone within none
main label writeAppOpenDone loopKind none
main label writeAppOpenDone within none
main label writeAppWidthDone loopKind none
main label writeAppWidthDone within none
main label writeAppCloseDone loopKind none
main label writeAppCloseDone within none
main label writeShapesLeadDone loopKind none
main label writeShapesLeadDone within none
main label writeShapesTextDone loopKind none
main label writeShapesTextDone within none
main let seven Int64 7 immutable
main let okCode ExitCode 0 immutable
main let three Int64 3 immutable
main let four Int64 4 immutable
main let five Int64 5 immutable
main let appName String "app" immutable
main let appLead String "app label: " immutable
main let widthOpen String " (width " immutable
main let close String ")" immutable
main let shapesName String "shapes" immutable
main let shapesLead String "shapes label: " immutable
main let appSidesText String "app sides: " immutable
main let shapesSidesText String "shapes sides: " immutable
main at begin do makeOblong
main at begin do measureOblong
main at begin do makeSquare
main at begin do measureSquare
main at begin do widenSquare
main at begin do measureWide
main at begin do makeAppLabel
main at begin do readAppText
main at begin do readAppWidth
main at begin do writeAppLead
main at begin branch ifError writeAppLead goto writeAppLeadDone else goto writeAppLeadDone
main at writeAppLeadDone do writeAppText
main at writeAppLeadDone branch ifError writeAppText goto writeAppTextDone else goto writeAppTextDone
main at writeAppTextDone do writeAppOpen
main at writeAppTextDone branch ifError writeAppOpen goto writeAppOpenDone else goto writeAppOpenDone
main at writeAppOpenDone do widthText
main at writeAppOpenDone do writeAppWidth
main at writeAppOpenDone branch ifError writeAppWidth goto writeAppWidthDone else goto writeAppWidthDone
main at writeAppWidthDone do writeAppClose
main at writeAppWidthDone branch ifError writeAppClose goto writeAppCloseDone else goto writeAppCloseDone
main at writeAppCloseDone do makeShapesLabel
main at writeAppCloseDone do readShapesText
main at writeAppCloseDone do writeShapesLead
main at writeAppCloseDone branch ifError writeShapesLead goto writeShapesLeadDone else goto writeShapesLeadDone
main at writeShapesLeadDone do writeShapesText
main at writeShapesLeadDone branch ifError writeShapesText goto writeShapesTextDone else goto writeShapesTextDone
main at writeShapesTextDone do reportAppSides
main at writeShapesTextDone do readShapesSides
main at writeShapesTextDone do reportShapesSides
main at writeShapesTextDone return ok okCode

store is region
store in main
store strategy arena
store maxBytes 65536
store released atReturn

