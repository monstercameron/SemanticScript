# A stage0 sample of two modules from the audit: `shop` uses the map of
# records `stock` declares, by qualified names.
shop is module
shop purpose "Use the stock module's map by qualified names"
shop path shop
shop imports standard.console
shop imports standard.map
shop imports stock
shop exports main

stdoutWriter is capability
stdoutWriter purpose "Authority to write lines to standard output"
stdoutWriter grants write console.stdout none

main is operation
main purpose "Restock and take items, then list every item"
main invariant none
main typeParameter none
main input none
main output ExitCode
main outputOwnedBy none
main raises none
main effect write console.stdout
main uses stdoutWriter
main memoryHeap true
main async false
main maxRecursion none
main label begin loopKind none
main label begin within none
main label writeNailsLeadDone loopKind none
main label writeNailsLeadDone within none
main label writeNailsDone loopKind none
main label writeNailsDone within none
main label writeTapeLeadDone loopKind none
main label writeTapeLeadDone within none
main label writeTapeDone loopKind none
main label writeTapeDone within none
main label eachKey loopKind forEach
main label eachKey within none
main label eachKey maxIterations keyCount
main label eachKey over counts
main label printKey loopKind none
main label printKey within eachKey
main label readItemDone loopKind none
main label readItemDone within eachKey
main label writeKeyDone loopKind none
main label writeKeyDone within eachKey
main label writeColonDone loopKind none
main label writeColonDone within eachKey
main label writeCountDone loopKind none
main label writeCountDone within eachKey
main label writeShelfLeadDone loopKind none
main label writeShelfLeadDone within eachKey
main label writeShelfDone loopKind none
main label writeShelfDone within eachKey
main label keysDone loopKind none
main label keysDone within none
main label sayGlue loopKind none
main label sayGlue within none
main label writeGlueDone loopKind none
main label writeGlueDone within none
main label done loopKind none
main label done within none
main let okCode ExitCode 0 immutable
main let nails String "nails" immutable
main let forty Int64 40 immutable
main let screws String "screws" immutable
main let twelve Int64 12 immutable
main let five Int64 5 immutable
main let glue String "glue" immutable
main let one Int64 1 immutable
main let nine Int64 9 immutable
main let nailsText String "nails left: " immutable
main let tape String "tape" immutable
main let tapeText String "tape left: " immutable
main let colon String ": " immutable
main let shelfText String "  shelf " immutable
main let glueText String "glue is stocked" immutable
main at begin do makeCounts
main at begin do r1
main at begin do r2
main at begin do r3
main at begin do r4
main at begin do t1
main at begin do writeNailsLead
main at begin branch ifError writeNailsLead goto writeNailsLeadDone else goto writeNailsLeadDone
main at writeNailsLeadDone do writeNails
main at writeNailsLeadDone branch ifError writeNails goto writeNailsDone else goto writeNailsDone
main at writeNailsDone do t2
main at writeNailsDone do writeTapeLead
main at writeNailsDone branch ifError writeTapeLead goto writeTapeLeadDone else goto writeTapeLeadDone
main at writeTapeLeadDone do writeTape
main at writeTapeLeadDone branch ifError writeTape goto writeTapeDone else goto writeTapeDone
main at writeTapeDone do countKeys
main at writeTapeDone goto eachKey
main at eachKey branch ifNext counts bind key String goto printKey else goto keysDone
main at printKey do readItem
main at printKey branch ifError readItem goto eachKey else goto readItemDone
main at readItemDone do readCount
main at readItemDone do readShelf
main at readItemDone do writeKey
main at readItemDone branch ifError writeKey goto writeKeyDone else goto writeKeyDone
main at writeKeyDone do writeColon
main at writeKeyDone branch ifError writeColon goto writeColonDone else goto writeColonDone
main at writeColonDone do writeCount
main at writeColonDone branch ifError writeCount goto writeCountDone else goto writeCountDone
main at writeCountDone do writeShelfLead
main at writeCountDone branch ifError writeShelfLead goto writeShelfLeadDone else goto writeShelfLeadDone
main at writeShelfLeadDone do writeShelf
main at writeShelfLeadDone branch ifError writeShelf goto writeShelfDone else goto writeShelfDone
main at writeShelfDone goto eachKey
main at keysDone do hasGlue
main at keysDone branch if glueThere goto sayGlue else goto done
main at sayGlue do writeGlue
main at sayGlue branch ifError writeGlue goto writeGlueDone else goto writeGlueDone
main at writeGlueDone goto done
main at done return ok okCode

store is region
store in main
store strategy arena
store maxBytes 1048576
store released atReturn

makeCounts is call
makeCounts in main
makeCounts invokes stock.Counts.new
makeCounts argument region Region store lend
makeCounts result counts stock.Counts
makeCounts ownedBy store
makeCounts cleanedBy none
makeCounts borrows none
makeCounts catch none
makeCounts suppresses none

r1 is call
r1 in main
r1 invokes stock.restock
r1 argument counts stock.Counts counts lendMutable
r1 argument name String nails lend
r1 argument amount Int64 forty copy
r1 result none
r1 ownedBy none
r1 cleanedBy none
r1 borrows none
r1 catch none
r1 suppresses none

