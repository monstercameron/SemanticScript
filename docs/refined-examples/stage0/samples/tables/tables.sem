# A stage0 sample: tables as fixed arrays. A table of planets (text, a
# number, and an enum cell) is read with `forEach`, with `rowAt` (whose
# failure past the last row it branches on), and with `length`. It exits
# with code 0:
#
#   Mercury 0
#   Venus 0
#   Earth 1
#   Mars 2
#   moons: 3
#   rows: 4
#   rocky: Venus
#   no row 5
tables is module
tables purpose "Read a table of planets by forEach, rowAt, and length"
tables path tables
tables imports standard.console
tables imports standard.math
tables imports standard.list
tables exports main

stdoutWriter is capability
stdoutWriter purpose "Authority to write lines to standard output"
stdoutWriter grants write console.stdout none

Kind is enum
Kind purpose "What a planet is made of"
Kind typeParameter none
Kind variant rocky none
Kind variant gas none

Planet is record
Planet purpose "A planet's name, how many moons it has, and what it is made of"
Planet typeParameter none
Planet field name String
Planet field moons Int64
Planet field kind Kind

planets is table
planets purpose "The inner planets, nearest the sun first"
planets rowType Planet
planets row mercury 1
planets row venus 2
planets row earth 3
planets row mars 4
planets cell mercury name "Mercury"
planets cell mercury moons 0
planets cell mercury kind Kind.rocky
planets cell venus name "Venus"
planets cell venus moons 0
planets cell venus kind Kind.rocky
planets cell earth name "Earth"
planets cell earth moons 1
planets cell earth kind Kind.rocky
planets cell mars name "Mars"
planets cell mars moons 2
planets cell mars kind Kind.rocky

main is operation
main purpose "Print each planet and its moons, the total, the row count, one row by number, and a row past the end"
main invariant none
main typeParameter none
main input none
main output ExitCode
main outputOwnedBy none
main raises none
main effect write console.stdout
main uses stdoutWriter
main memoryHeap false
main async false
main maxRecursion none
main label begin loopKind none
main label begin within none
main label eachPlanet loopKind forEach
main label eachPlanet within none
main label eachPlanet maxIterations rowCount
main label eachPlanet over planets
main label printPlanet loopKind none
main label printPlanet within eachPlanet
main label writeNameDone loopKind none
main label writeNameDone within eachPlanet
main label writeSpaceDone loopKind none
main label writeSpaceDone within eachPlanet
main label writeMoonsDone loopKind none
main label writeMoonsDone within eachPlanet
main label summed loopKind none
main label summed within none
main label writeTotalLeadDone loopKind none
main label writeTotalLeadDone within none
main label writeTotalDone loopKind none
main label writeTotalDone within none
main label writeRowsLeadDone loopKind none
main label writeRowsLeadDone within none
main label writeRowsDone loopKind none
main label writeRowsDone within none
main label readSecondDone loopKind none
main label readSecondDone within none
main label rocky loopKind none
main label rocky within none
main label writeRockyDone loopKind none
main label writeRockyDone within none
main label writeSecondDone loopKind none
main label writeSecondDone within none
main label gas loopKind none
main label gas within none
main label writeGasDone loopKind none
main label writeGasDone within none
main label past loopKind none
main label past within none
main label readPastDone loopKind none
main label readPastDone within none
main label writePastDone loopKind none
main label writePastDone within none
main label noRow loopKind none
main label noRow within none
main label writeNoRowDone loopKind none
main label writeNoRowDone within none
main label missing loopKind none
main label missing within none
main let total Int64 0 mutable
main let okCode ExitCode 0 immutable
main let space String " " immutable
main let totalText String "moons: " immutable
main let rowsText String "rows: " immutable
main let two Int64 2 immutable
main let rockyText String "rocky: " immutable
main let gasText String "gas" immutable
main let five Int64 5 immutable
main let noRowText String "no row 5" immutable
main at begin do countRows
main at begin goto eachPlanet
main at eachPlanet branch ifNext planets bind planet Planet goto printPlanet else goto summed
main at printPlanet do readName
main at printPlanet do readMoons
main at printPlanet do writeName
main at printPlanet branch ifError writeName goto writeNameDone else goto writeNameDone
main at writeNameDone do writeSpace
main at writeNameDone branch ifError writeSpace goto writeSpaceDone else goto writeSpaceDone
main at writeSpaceDone do writeMoons
main at writeSpaceDone branch ifError writeMoons goto writeMoonsDone else goto writeMoonsDone
main at writeMoonsDone do addMoons
main at writeMoonsDone set total nextTotal
main at writeMoonsDone goto eachPlanet
main at summed do writeTotalLead
main at summed branch ifError writeTotalLead goto writeTotalLeadDone else goto writeTotalLeadDone
main at writeTotalLeadDone do writeTotal
main at writeTotalLeadDone branch ifError writeTotal goto writeTotalDone else goto writeTotalDone
main at writeTotalDone do writeRowsLead
main at writeTotalDone branch ifError writeRowsLead goto writeRowsLeadDone else goto writeRowsLeadDone
main at writeRowsLeadDone do writeRows
main at writeRowsLeadDone branch ifError writeRows goto writeRowsDone else goto writeRowsDone
main at writeRowsDone do readSecond
main at writeRowsDone branch ifError readSecond goto missing else goto readSecondDone
main at readSecondDone do readSecondName
main at readSecondDone do readSecondKind
main at readSecondDone match secondKind Kind
main at readSecondDone case Kind.rocky bind none none goto rocky
main at readSecondDone case Kind.gas bind none none goto gas
main at rocky do writeRocky
main at rocky branch ifError writeRocky goto writeRockyDone else goto writeRockyDone
main at writeRockyDone do writeSecond
main at writeRockyDone branch ifError writeSecond goto writeSecondDone else goto writeSecondDone
main at writeSecondDone goto past
main at gas do writeGas
main at gas branch ifError writeGas goto writeGasDone else goto writeGasDone
main at writeGasDone goto past
main at past do readPast
main at past branch ifError readPast goto noRow else goto readPastDone
main at readPastDone do readPastName
main at readPastDone do writePast
main at readPastDone branch ifError writePast goto writePastDone else goto writePastDone
main at writePastDone return ok okCode
main at noRow do writeNoRow
main at noRow branch ifError writeNoRow goto writeNoRowDone else goto writeNoRowDone
main at writeNoRowDone return ok okCode
main at missing return ok okCode

countRows is call
countRows in main
countRows invokes planets.length
countRows argument none
countRows result rowCount Int64
countRows ownedBy none
countRows cleanedBy none
countRows borrows none
countRows catch none
countRows suppresses none

readName is call
readName in main
readName invokes Planet.name
readName argument record Planet planet lend
readName result name String
readName ownedBy none
readName cleanedBy none
readName borrows planet
readName catch none
readName suppresses none

readMoons is call
readMoons in main
readMoons invokes Planet.moons
readMoons argument record Planet planet lend
readMoons result moons Int64
readMoons ownedBy none
readMoons cleanedBy none
readMoons borrows none
readMoons catch none
readMoons suppresses none

writeName is call
writeName rationale "The failure has nowhere to be reported, so it is discarded"
writeName in main
writeName invokes console.write
writeName argument text String name lend
writeName result none
writeName ownedBy none
writeName cleanedBy none
writeName borrows none
writeName catch writeNameError console.WriteError
writeName suppresses console.WriteError.failed

