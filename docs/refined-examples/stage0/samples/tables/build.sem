# A stage0 sample program (docs/refined-examples/stage0/samples). Run it with
# `refined run`, or compile it with stage0 and run what stage0 builds.

tables is project
tables purpose "Read a table of planets by forEach, rowAt, and length; a stage0 sample both runs agree on"
tables target console
tables version "0.1.0"
tables language refined 1
tables standardLibrary 1
tables allows write console.stdout none
tables requires none
tables includesModule tables
tables entry tables.main
