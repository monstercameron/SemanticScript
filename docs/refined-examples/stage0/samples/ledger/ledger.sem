# A stage0 sample from the audit: transactions held in enums applied to an
# account record, with an error enum the program raises and branches on.
ledger is module
ledger purpose "Apply transactions held in enums to an account record, with an error enum"
ledger path ledger
ledger imports standard.console
ledger imports standard.math
ledger imports standard.compare
ledger imports standard.list
ledger imports standard.string
ledger exports main

stdoutWriter is capability
stdoutWriter purpose "Authority to write lines to standard output"
stdoutWriter grants write console.stdout none

Account is record
Account purpose "An account's owner and balance"
Account typeParameter none
Account field owner String
Account field balance Int64

Move is enum
Move purpose "A transaction"
Move typeParameter none
Move variant deposit Int64
Move variant withdraw Int64
Move variant fee none
Move variant rename String

LedgerError is enum
LedgerError purpose "Why a transaction was refused"
LedgerError typeParameter none
LedgerError variant overdrawn Int64
LedgerError variant negative Int64

Moves is typeInstance
Moves purpose "A list of transactions"
Moves in none
Moves instantiates list.List Move

apply is operation
apply purpose "Apply one transaction to a balance"
apply invariant none
apply typeParameter none
apply input balance Int64 copied
apply input move Move borrowed
apply output Int64
apply outputOwnedBy none
apply raises LedgerError
apply effect none
apply uses none
apply memoryHeap false
apply async false
apply maxRecursion none
apply label begin loopKind none
apply label begin within none
apply label onDeposit loopKind none
apply label onDeposit within none
apply label addIt loopKind none
apply label addIt within none
apply label badAmount loopKind none
apply label badAmount within none
apply label onWithdraw loopKind none
apply label onWithdraw within none
apply label keep loopKind none
apply label keep within none
apply label overdrawn loopKind none
apply label overdrawn within none
apply label onFee loopKind none
apply label onFee within none
apply label onRename loopKind none
apply label onRename within none
apply let feeAmount Int64 3 immutable
apply let zero Int64 0 immutable
apply at begin match move Move
apply at begin case Move.deposit bind amount Int64 goto onDeposit
apply at begin case Move.withdraw bind amount2 Int64 goto onWithdraw
apply at begin case Move.fee bind none none goto onFee
apply at begin case Move.rename bind newName String goto onRename
apply at onDeposit do negCheck
apply at onDeposit branch if isNeg goto badAmount else goto addIt
apply at addIt do plus
apply at addIt return ok added
apply at badAmount do makeNeg
apply at badAmount return error negError
apply at onWithdraw do minus
apply at onWithdraw do overCheck
apply at onWithdraw branch if over goto overdrawn else goto keep
apply at keep return ok left
apply at overdrawn do makeOver
apply at overdrawn return error overError
apply at onFee do charge
apply at onFee return ok charged
apply at onRename return ok balance

negCheck is call
negCheck in apply
negCheck invokes compare.lessThanInt64
negCheck argument left Int64 amount copy
negCheck argument right Int64 zero copy
negCheck result isNeg Bool
negCheck ownedBy none
negCheck cleanedBy none
negCheck borrows none
negCheck catch none
negCheck suppresses none

plus is call
plus in apply
plus invokes math.addInt64
plus argument left Int64 balance copy
plus argument right Int64 amount copy
plus result added Int64
plus ownedBy none
plus cleanedBy none
plus borrows none
plus catch none
plus suppresses none

makeNeg is call
makeNeg in apply
makeNeg invokes LedgerError.negative
makeNeg argument payload Int64 amount copy
makeNeg result negError LedgerError
makeNeg ownedBy none
makeNeg cleanedBy none
makeNeg borrows none
makeNeg catch none
makeNeg suppresses none

minus is call
minus in apply
minus invokes math.subtractInt64
minus argument left Int64 balance copy
minus argument right Int64 amount2 copy
minus result left Int64
minus ownedBy none
minus cleanedBy none
minus borrows none
minus catch none
minus suppresses none

overCheck is call
overCheck in apply
overCheck invokes compare.lessThanInt64
overCheck argument left Int64 left copy
overCheck argument right Int64 zero copy
overCheck result over Bool
overCheck ownedBy none
overCheck cleanedBy none
overCheck borrows none
overCheck catch none
overCheck suppresses none

makeOver is call
makeOver in apply
makeOver invokes LedgerError.overdrawn
makeOver argument payload Int64 left copy
makeOver result overError LedgerError
makeOver ownedBy none
makeOver cleanedBy none
makeOver borrows none
makeOver catch none
makeOver suppresses none

charge is call
charge in apply
charge invokes math.subtractInt64
charge argument left Int64 balance copy
charge argument right Int64 feeAmount copy
charge result charged Int64
charge ownedBy none
charge cleanedBy none
charge borrows none
charge catch none
charge suppresses none

main is operation
main purpose "Run a list of transactions and print the balance after each"
main invariant none
main typeParameter none
main input none
main output ExitCode
main outputOwnedBy none
main raises none
main effect write console.stdout
main uses stdoutWriter
main memoryHeap true
main async false
main maxRecursion none
main label begin loopKind none
main label begin within none
main label each loopKind forEach
main label each within none
main label each maxIterations moveCount
main label each over moves
main label applyOne loopKind none
main label applyOne within each
main label accepted loopKind none
main label accepted within each
main label writeLeadDone loopKind none
main label writeLeadDone within each
main label writeBalanceDone loopKind none
main label writeBalanceDone within each
main label refusedOne loopKind none
main label refusedOne within each
main label onOverdrawn loopKind none
main label onOverdrawn within each
main label writeOverDone loopKind none
main label writeOverDone within each
main label writeByDone loopKind none
main label writeByDone within each
main label onNegative loopKind none
main label onNegative within each
main label writeNegDone loopKind none
main label writeNegDone within each
main label writeAmountDone loopKind none
main label writeAmountDone within each
main label done loopKind none
main label done within none
main label writeOwnerDone loopKind none
main label writeOwnerDone within none
main label writeRefusedLeadDone loopKind none
main label writeRefusedLeadDone within none
main label writeRefusedDone loopKind none
main label writeRefusedDone within none
main label failing loopKind none
main label failing within none
main label fine loopKind none
main label fine within none
main let balance Int64 0 mutable
main let refused Int64 0 mutable
main let doneCode ExitCode 0 immutable
main let failCode ExitCode 9 immutable
main let fifty Int64 50 immutable
main let twenty Int64 20 immutable
main let hundred Int64 100 immutable
main let minusFive Int64 -5 immutable
main let bob String "Bob" immutable
main let seven Int64 7 immutable
main let alice String "Alice" immutable
main let zero Int64 0 immutable
main let balanceText String "balance " immutable
main let one Int64 1 immutable
main let overText String "overdrawn to " immutable
main let negText String "negative deposit " immutable
main let endText String " done" immutable
main let refusedText String "refused: " immutable
main at begin do makeMoves
main at begin do m1
main at begin do a1
main at begin do m2
main at begin do a2
main at begin do m3
main at begin do a3
main at begin do m4
main at begin do a4
main at begin do m5
main at begin do a5
main at begin do m6
main at begin do a6
main at begin do m7
main at begin do a7
main at begin do countMoves
main at begin do makeAccount
main at begin goto each
main at each branch ifNext moves bind move Move goto applyOne else goto done
main at applyOne do applying
main at applyOne branch ifError applying goto refusedOne else goto accepted
main at accepted set balance after
main at accepted do writeLead
main at accepted branch ifError writeLead goto writeLeadDone else goto writeLeadDone
main at writeLeadDone do writeBalance
main at writeLeadDone branch ifError writeBalance goto writeBalanceDone else goto writeBalanceDone
main at writeBalanceDone goto each
main at refusedOne do bumpRefused
main at refusedOne set refused nextRefused
main at refusedOne match problem LedgerError
main at refusedOne case LedgerError.overdrawn bind by Int64 goto onOverdrawn
main at refusedOne case LedgerError.negative bind amount Int64 goto onNegative
main at onOverdrawn do writeOver
main at onOverdrawn branch ifError writeOver goto writeOverDone else goto writeOverDone
main at writeOverDone do writeBy
main at writeOverDone branch ifError writeBy goto writeByDone else goto writeByDone
main at writeByDone goto each
main at onNegative do writeNeg
main at onNegative branch ifError writeNeg goto writeNegDone else goto writeNegDone
main at writeNegDone do writeAmount
main at writeNegDone branch ifError writeAmount goto writeAmountDone else goto writeAmountDone
main at writeAmountDone goto each
main at done do readOwner
main at done do greet
main at done do writeOwner
main at done branch ifError writeOwner goto writeOwnerDone else goto writeOwnerDone
main at writeOwnerDone do writeRefusedLead
main at writeOwnerDone branch ifError writeRefusedLead goto writeRefusedLeadDone else goto writeRefusedLeadDone
main at writeRefusedLeadDone do writeRefused
main at writeRefusedLeadDone branch ifError writeRefused goto writeRefusedDone else goto writeRefusedDone
main at writeRefusedDone do checkRefused
main at writeRefusedDone branch if tooMany goto failing else goto fine
main at failing return ok failCode
main at fine return ok doneCode

scratch is region
scratch in main
scratch strategy arena
scratch maxBytes 1048576
scratch released atReturn

makeMoves is call
makeMoves in main
makeMoves invokes Moves.new
makeMoves argument region Region scratch lend
makeMoves result moves Moves
makeMoves ownedBy scratch
makeMoves cleanedBy none
makeMoves borrows none
makeMoves catch none
makeMoves suppresses none

