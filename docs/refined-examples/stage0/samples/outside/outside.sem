# A source stage0 refuses: an alias is outside the stage0 subset. stage0
# reports where and why, and exits with code 1:
#
#   samples/outside/outside.sem:12:11: this entity kind is outside the stage0 subset (alias)

outside is module
outside purpose "Hold an alias, which the stage0 subset does not compile"
outside path outside
outside imports none
outside exports none

Meters is alias
Meters purpose "A distance in meters, as a whole number"
Meters typeParameter none
Meters aliasOf Int64
Meters indexes none
