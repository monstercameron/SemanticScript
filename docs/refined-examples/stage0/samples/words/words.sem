# A stage0 sample from the audit: words split with byte tests, a reversed
# sentence built in a buffer, and numbers parsed from text.
words is module
words purpose "Split a sentence into words with byte tests, build a reversed sentence in a buffer, and parse numbers"
words path words
words imports standard.console
words imports standard.math
words imports standard.compare
words imports standard.list
words imports standard.string
words imports standard.byte
words imports standard.buffer
words imports standard.convert
words exports main

stdoutWriter is capability
stdoutWriter purpose "Authority to write lines to standard output"
stdoutWriter grants write console.stdout none

Texts is typeInstance
Texts purpose "The words of a sentence, in order"
Texts in none
Texts instantiates list.List String

splitWords is operation
splitWords purpose "The words of a text, split at spaces"
splitWords invariant none
splitWords typeParameter none
splitWords input text String borrowed
splitWords input region Region borrowed
splitWords output Texts
splitWords outputOwnedBy region
splitWords raises none
splitWords effect none
splitWords uses none
splitWords memoryHeap true
splitWords async false
splitWords maxRecursion none
splitWords label begin loopKind none
splitWords label begin within none
splitWords label scan loopKind while
splitWords label scan within none
splitWords label scan maxIterations length
splitWords label readOne loopKind none
splitWords label readOne within scan
splitWords label onSpace loopKind none
splitWords label onSpace within scan
splitWords label closeWord loopKind none
splitWords label closeWord within scan
splitWords label cutDone loopKind none
splitWords label cutDone within scan
splitWords label onOther loopKind none
splitWords label onOther within scan
splitWords label openWord loopKind none
splitWords label openWord within scan
splitWords label advance loopKind none
splitWords label advance within scan
splitWords label finish loopKind none
splitWords label finish within none
splitWords label lastWord loopKind none
splitWords label lastWord within none
splitWords label cutLastDone loopKind none
splitWords label cutLastDone within none
splitWords label done loopKind none
splitWords label done within none
splitWords let index Int64 0 mutable
splitWords let start Int64 0 mutable
splitWords let inWord Bool false mutable
splitWords let yes Bool true immutable
splitWords let no Bool false immutable
splitWords let empty String "" immutable
splitWords let one Int64 1 immutable
splitWords at begin do makeList
splitWords at begin do measure
splitWords at begin goto scan
splitWords at scan do endCheck
splitWords at scan branch if atEnd goto finish else goto readOne
splitWords at readOne do fetch
splitWords at readOne do spaceCheck
splitWords at readOne branch if isSpace goto onSpace else goto onOther
splitWords at onSpace branch if inWord goto closeWord else goto advance
splitWords at closeWord do wordLength
splitWords at closeWord do cut
splitWords at closeWord branch ifError cut goto advance else goto cutDone
splitWords at cutDone do copyWord
splitWords at cutDone do keep
splitWords at cutDone set inWord no
splitWords at cutDone goto advance
splitWords at onOther branch if inWord goto advance else goto openWord
splitWords at openWord set start index
splitWords at openWord set inWord yes
splitWords at openWord goto advance
splitWords at advance do step
splitWords at advance set index nextIndex
splitWords at advance goto scan
splitWords at finish branch if inWord goto lastWord else goto done
splitWords at lastWord do lastLength
splitWords at lastWord do cutLast
splitWords at lastWord branch ifError cutLast goto done else goto cutLastDone
splitWords at cutLastDone do copyLast
splitWords at cutLastDone do keepLast
splitWords at cutLastDone goto done
splitWords at done return ok found

