main label sumX over points
main label addX loopKind none
main label addX within sumX
main label summedX loopKind none
main label summedX within none
main let sum Int64 0 mutable
main let xTotal Int64 0 mutable
main let okCode ExitCode 0 immutable
main let three Int64 3 immutable
main let one Int64 1 immutable
main let four Int64 4 immutable
main let five Int64 5 immutable
main let sumText String "sum: " immutable
main let countText String "count: " immutable
main let two Int64 2 immutable
main let thirdText String "third: " immutable
main let nine Int64 9 immutable
main let missingText String "item at 9: " immutable
main let noItemText String "no item at 9" immutable
main let alpha String "alpha" immutable
main let beta String "beta" immutable
main let gamma String "gamma" immutable
main let pointsText String "points: " immutable
main let xText String "x total: " immutable
main let six Int64 6 immutable
main let evensText String "evens: " immutable
main at begin do makeNumbers
main at begin do addThree
main at begin do addOne
main at begin do addFour
main at begin do addOneAgain
main at begin do addFive
main at begin do countNumbers
main at begin goto sumNumbers
main at sumNumbers branch ifNext numbers bind number Int64 goto addNumber else goto summed
main at addNumber do addIt
main at addNumber set sum nextSum
main at addNumber goto sumNumbers
main at summed do reportSum
main at summed do reportCount
main at summed do readThird
main at summed do reportThird
main at summed do readMissing
main at summed branch ifError readMissing goto noItem else goto readMissingDone
main at readMissingDone do reportMissing
main at readMissingDone goto fillNames
main at noItem do writeNoItem
main at noItem branch ifError writeNoItem goto writeNoItemDone else goto writeNoItemDone
main at writeNoItemDone goto fillNames
main at fillNames do makeNames
main at fillNames do addAlpha
main at fillNames do addBeta
main at fillNames do addGamma
main at fillNames do countNames
main at fillNames goto printNames
main at printNames branch ifNext names bind name String goto printName else goto fillPoints
main at printName do writeName
main at printName branch ifError writeName goto writeNameDone else goto writeNameDone
main at writeNameDone goto printNames
main at fillPoints do makePoints
main at fillPoints do makeFirst
main at fillPoints do addFirst
main at fillPoints do makeSecond
main at fillPoints do addSecond
main at fillPoints do makeThird
main at fillPoints do addThird
main at fillPoints do countPoints
main at fillPoints do reportPoints
main at fillPoints goto sumX
main at sumX branch ifNext points bind point Point goto addX else goto summedX
main at addX do readX
main at addX do addXValue
main at addX set xTotal nextX
main at addX goto sumX
main at summedX do reportX
main at summedX do makeEvens
main at summedX do countEvens
main at summedX do reportEvens
main at summedX return ok okCode

