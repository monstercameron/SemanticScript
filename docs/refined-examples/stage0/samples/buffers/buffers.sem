# A stage0 sample: the host library. It builds a line in a byte buffer
# (text, a number, and a byte), turns it back into text, parses a number out
# of text, classifies bytes, and turns text into bytes and back, all through
# the runtime's `refined_host` and inline targets, as an executable built by
# `refined build` does. It exits with code 0:
#
#   total: 42!
#   length: 10
#   parsed: 1234
#   not a number
#   digit, letter
#   round trip: abc
buffers is module
buffers purpose "Build text in a byte buffer, parse numbers, and classify bytes"
buffers path buffers
buffers imports standard.console
buffers imports standard.buffer
buffers imports standard.string
buffers imports standard.byte
buffers imports standard.logic
buffers exports main

stdoutWriter is capability
stdoutWriter purpose "Authority to write lines to standard output"
stdoutWriter grants write console.stdout none

main is operation
main purpose "Build a line in a buffer, then parse, classify, and convert text"
main invariant none
main typeParameter none
main input none
main output ExitCode
main outputOwnedBy none
main raises none
main effect write console.stdout
main uses stdoutWriter
main memoryHeap true
main async false
main maxRecursion none
main label begin loopKind none
main label begin within none
main label readBackDone loopKind none
main label readBackDone within none
main label printTextDone loopKind none
main label printTextDone within none
main label writeLengthLeadDone loopKind none
main label writeLengthLeadDone within none
main label printLengthDone loopKind none
main label printLengthDone within none
main label parseDone loopKind none
main label parseDone within none
main label writeParsedLeadDone loopKind none
main label writeParsedLeadDone within none
main label printParsedDone loopKind none
main label printParsedDone within none
main label parseBadDone loopKind none
main label parseBadDone within none
main label printNotParsedDone loopKind none
main label printNotParsedDone within none
main label notNumber loopKind none
main label notNumber within none
main label writeNotNumberDone loopKind none
main label writeNotNumberDone within none
main label classify loopKind none
main label classify within none
main label readDigitDone loopKind none
main label readDigitDone within none
main label readLetterDone loopKind none
main label readLetterDone within none
main label printBoth loopKind none
main label printBoth within none
main label writeBothDone loopKind none
main label writeBothDone within none
main label fromBytesDone loopKind none
main label fromBytesDone within none
main label writeRoundLeadDone loopKind none
main label writeRoundLeadDone within none
main label writeRoundDone loopKind none
main label writeRoundDone within none
main label failed loopKind none
main label failed within none
main let okCode ExitCode 0 immutable
main let failCode ExitCode 1 immutable
main let totalText String "total: " immutable
main let fortyTwo Int64 42 immutable
main let bang Byte 33 immutable
main let lengthText String "length: " immutable
main let digits String "1234" immutable
main let parsedText String "parsed: " immutable
main let word String "12a" immutable
main let notNumberText String "not a number" immutable
main let zero Int64 0 immutable
main let two Int64 2 immutable
main let bothText String "digit, letter" immutable
main let abc String "abc" immutable
main let roundText String "round trip: " immutable
main at begin do makeBuffer
main at begin do addText
main at begin do addNumber
main at begin do addMark
main at begin do readBack
main at begin branch ifError readBack goto failed else goto readBackDone
main at readBackDone do printText
main at readBackDone branch ifError printText goto printTextDone else goto printTextDone
main at printTextDone do measure
main at printTextDone do writeLengthLead
main at printTextDone branch ifError writeLengthLead goto writeLengthLeadDone else goto writeLengthLeadDone
main at writeLengthLeadDone do printLength
main at writeLengthLeadDone branch ifError printLength goto printLengthDone else goto printLengthDone
main at printLengthDone do parse
main at printLengthDone branch ifError parse goto failed else goto parseDone
main at parseDone do writeParsedLead
main at parseDone branch ifError writeParsedLead goto writeParsedLeadDone else goto writeParsedLeadDone
main at writeParsedLeadDone do printParsed
main at writeParsedLeadDone branch ifError printParsed goto printParsedDone else goto printParsedDone
main at printParsedDone do parseBad
main at printParsedDone branch ifError parseBad goto notNumber else goto parseBadDone
main at parseBadDone do printNotParsed
main at parseBadDone branch ifError printNotParsed goto printNotParsedDone else goto printNotParsedDone
main at printNotParsedDone goto classify
main at notNumber do writeNotNumber
main at notNumber branch ifError writeNotNumber goto writeNotNumberDone else goto writeNotNumberDone
main at writeNotNumberDone goto classify
main at classify do readDigit
main at classify branch ifError readDigit goto failed else goto readDigitDone
main at readDigitDone do digitCheck
main at readDigitDone do readLetter
main at readDigitDone branch ifError readLetter goto failed else goto readLetterDone
main at readLetterDone do letterCheck
main at readLetterDone do bothCheck
main at readLetterDone branch if both goto printBoth else goto failed
main at printBoth do writeBoth
main at printBoth branch ifError writeBoth goto writeBothDone else goto writeBothDone
main at writeBothDone do toBytes
main at writeBothDone do fromBytes
main at writeBothDone branch ifError fromBytes goto failed else goto fromBytesDone
main at fromBytesDone do writeRoundLead
main at fromBytesDone branch ifError writeRoundLead goto writeRoundLeadDone else goto writeRoundLeadDone
main at writeRoundLeadDone do writeRound
main at writeRoundLeadDone branch ifError writeRound goto writeRoundDone else goto writeRoundDone
main at writeRoundDone return ok okCode
main at failed return ok failCode

scratch is region
scratch in main
scratch strategy arena
scratch maxBytes 65536
scratch released atReturn

makeBuffer is call
makeBuffer in main
makeBuffer invokes buffer.new
makeBuffer argument region Region scratch lend
makeBuffer result line buffer.ByteBuffer
makeBuffer ownedBy scratch
makeBuffer cleanedBy none
makeBuffer borrows none
makeBuffer catch none
makeBuffer suppresses none

