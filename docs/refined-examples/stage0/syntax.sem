rejectionMessage let shortRowText String "a row has a subject, a predicate, and a payload" immutable
rejectionMessage let outsideSourceText String "a word lies outside the source" immutable
rejectionMessage let unsupportedKindText String "this entity kind is outside the stage0 subset" immutable
rejectionMessage let strayRowText String "this row's subject is not the entity above it" immutable
rejectionMessage let duplicateNameText String "this name is already declared" immutable
rejectionMessage let badMainText String "main takes no input, gives an ExitCode, and raises nothing" immutable
rejectionMessage let noMainText String "the module has no main operation" immutable
rejectionMessage let unsupportedPredicateText String "this predicate is outside the stage0 subset here" immutable
rejectionMessage let unsupportedPayloadText String "this payload is outside the stage0 subset" immutable
rejectionMessage let unsupportedTypeText String "this type is outside the stage0 subset" immutable
rejectionMessage let badLiteralText String "this literal does not fit its type" immutable
rejectionMessage let unsupportedEscapeText String "stage0 does not read \\x escapes in text" immutable
rejectionMessage let unknownValueText String "no value has this name" immutable
rejectionMessage let wrongTypeText String "this value has another type" immutable
rejectionMessage let unsupportedTargetText String "this call target is outside the stage0 subset" immutable
rejectionMessage let wrongArgumentText String "this argument does not match the target's slot, type, or mode" immutable
rejectionMessage let argumentCountText String "the call passes the wrong number of arguments" immutable
rejectionMessage let unknownLabelText String "no label has this name" immutable
rejectionMessage let unknownCallText String "no call in this operation has this name" immutable
rejectionMessage let unsupportedStepText String "this step is outside the stage0 subset" immutable
rejectionMessage let notMutableText String "this value is immutable" immutable
rejectionMessage let splitBlockText String "this label's steps are not together" immutable
rejectionMessage let unsupportedLoopText String "stage0 compiles forEach loops over lists only" immutable
rejectionMessage let notFailingText String "this call cannot fail, so there is no error to branch on" immutable
rejectionMessage let lostNameText String "stage0 lost track of a name it had checked; this is a fault in stage0" immutable
rejectionMessage let typeOrderText String "a record or enum holds only types declared above it" immutable
rejectionMessage let unknownVariantText String "this variant is not one of the matched enum's" immutable
rejectionMessage let unknownOwnerText String "no operation of this module has this name" immutable
rejectionMessage let invalidCharacterText String "no word begins with this character" immutable
rejectionMessage let unterminatedTextText String "quoted text is not closed before the end of its line" immutable
rejectionMessage let integerTooLargeText String "this integer is too large for Int64" immutable
rejectionMessage at begin match rejection Rejection
rejectionMessage at begin case Rejection.strayMark bind strayMarkWord Word goto strayMarkCase
rejectionMessage at begin case Rejection.gluedWords bind gluedWordsWord Word goto gluedWordsCase
rejectionMessage at begin case Rejection.danglingDot bind danglingDotWord Word goto danglingDotCase
rejectionMessage at begin case Rejection.shortRow bind shortRowWord Word goto shortRowCase
rejectionMessage at begin case Rejection.outsideSource bind outsideSourceWord Word goto outsideSourceCase
