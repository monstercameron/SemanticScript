groupRows label minusFailed within none
groupRows label dangling loopKind none
groupRows label dangling within none
groupRows label danglingFailed loopKind none
groupRows label danglingFailed within none
groupRows let zero Int64 0 immutable
groupRows let one Int64 1 immutable
groupRows let dotByte Byte 46 immutable
groupRows let minusByte Byte 45 immutable
groupRows let yes Bool true immutable
groupRows let no Bool false immutable
groupRows let open Bool false mutable
groupRows let dotted Bool false mutable
groupRows let openIsName Bool false mutable
groupRows let minus Bool false mutable
groupRows let openKind WordKind unset mutable
groupRows let openStart string.Position unset mutable
groupRows let openOffset Int64 0 mutable
groupRows let openEnd Int64 0 mutable
groupRows let minusStart string.Position unset mutable
groupRows let minusEnd Int64 0 mutable
groupRows let rowFirst Int64 0 mutable
groupRows at begin do countTokens
groupRows at begin do makeNameKind
groupRows at begin do makeTextKind
groupRows at begin do makeOrigin
groupRows at begin set openKind nameKind
groupRows at begin set openStart origin
groupRows at begin set minusStart origin
groupRows at begin goto visit
groupRows at visit branch ifNext tokens bind token lexer.Token goto readToken else goto finished
groupRows at readToken do readKind
groupRows at readToken do readStart
groupRows at readToken do readLength
groupRows at readToken do readOffset
groupRows at readToken do findEnd
groupRows at readToken do touchCheck
groupRows at readToken do glueCheck
groupRows at readToken branch if minus goto afterMinus else goto classify
groupRows at afterMinus match tokenKind lexer.TokenKind
groupRows at afterMinus case lexer.TokenKind.identifier bind none none goto minusStray
groupRows at afterMinus case lexer.TokenKind.integer bind negativeDigits Int64 goto negative
groupRows at afterMinus case lexer.TokenKind.text bind none none goto minusStray
groupRows at afterMinus case lexer.TokenKind.punctuation bind markAfterMinus Byte goto minusStray
groupRows at afterMinus case lexer.TokenKind.newline bind none none goto minusStray
groupRows at afterMinus case lexer.TokenKind.endOfInput bind none none goto minusStray
groupRows at negative do minusTouchCheck
groupRows at negative branch if minusTouching goto negativeWord else goto minusStray
groupRows at negativeWord do negate
groupRows at negativeWord do makeNegativeKind
groupRows at negativeWord do findSignOffset
groupRows at negativeWord set openKind negativeKind
groupRows at negativeWord set openIsName no
groupRows at negativeWord set openStart minusStart
groupRows at negativeWord set openOffset signOffset
groupRows at negativeWord set openEnd tokenEnd
groupRows at negativeWord set open yes
groupRows at negativeWord set minus no
groupRows at negativeWord goto visit
groupRows at classify match tokenKind lexer.TokenKind
groupRows at classify case lexer.TokenKind.identifier bind none none goto identifierCase
groupRows at classify case lexer.TokenKind.integer bind number Int64 goto integerCase
groupRows at classify case lexer.TokenKind.text bind none none goto textCase
groupRows at classify case lexer.TokenKind.punctuation bind mark Byte goto punctuationCase
groupRows at classify case lexer.TokenKind.newline bind none none goto lineEnd
groupRows at classify case lexer.TokenKind.endOfInput bind none none goto lineEnd
groupRows at identifierCase branch if dotted goto extendName else goto identifierFresh
groupRows at extendName branch if touching goto extendNameWord else goto dangling
groupRows at extendNameWord set openEnd tokenEnd
groupRows at extendNameWord set dotted no
groupRows at extendNameWord goto visit
groupRows at identifierFresh branch if glued goto gluedAt else goto identifierStart
groupRows at identifierStart do flushBeforeName
groupRows at identifierStart set openKind nameKind
groupRows at identifierStart set openIsName yes
groupRows at identifierStart set openStart tokenStart
groupRows at identifierStart set openOffset tokenOffset
groupRows at identifierStart set openEnd tokenEnd
groupRows at identifierStart set open yes
groupRows at identifierStart goto visit
groupRows at integerCase branch if glued goto gluedAt else goto integerStart
groupRows at integerStart do flushBeforeInteger
groupRows at integerStart do makeIntegerKind
groupRows at integerStart set openKind integerKind
groupRows at integerStart set openIsName no
groupRows at integerStart set openStart tokenStart
groupRows at integerStart set openOffset tokenOffset
groupRows at integerStart set openEnd tokenEnd
groupRows at integerStart set open yes
groupRows at integerStart goto visit
groupRows at textCase branch if glued goto gluedAt else goto textStart
groupRows at textStart do flushBeforeText
groupRows at textStart set openKind textKind
groupRows at textStart set openIsName no
groupRows at textStart set openStart tokenStart
groupRows at textStart set openOffset tokenOffset
groupRows at textStart set openEnd tokenEnd
groupRows at textStart set open yes
groupRows at textStart goto visit
groupRows at punctuationCase do dotCheck
groupRows at punctuationCase branch if isDot goto dotCase else goto minusTest
groupRows at dotCase do joinCheck
groupRows at dotCase do undottedCheck
groupRows at dotCase do dotAllowed
groupRows at dotCase branch if canDot goto dotJoin else goto strayAt
groupRows at dotJoin set dotted yes
groupRows at dotJoin set openEnd tokenEnd
groupRows at dotJoin goto visit
groupRows at minusTest do minusCheck
groupRows at minusTest branch if isMinus goto minusCase else goto strayAt
groupRows at minusCase branch if glued goto gluedAt else goto minusOpen
groupRows at minusOpen do flushBeforeMinus
groupRows at minusOpen set open no
groupRows at minusOpen set openIsName no
groupRows at minusOpen set minus yes
groupRows at minusOpen set minusStart tokenStart
groupRows at minusOpen set minusEnd tokenEnd
groupRows at minusOpen goto visit
groupRows at lineEnd branch if dotted goto dangling else goto lineFlush
groupRows at lineFlush do flushAtLineEnd
groupRows at lineFlush do closeThisRow
groupRows at lineFlush branch ifError closeThisRow goto closeFailed else goto rowClosed
groupRows at rowClosed set rowFirst nextFirst
groupRows at rowClosed set open no
groupRows at rowClosed set openIsName no
groupRows at rowClosed goto visit
groupRows at finished return ok none
groupRows at closeFailed return error closeError
groupRows at gluedAt do makeGluedWord
groupRows at gluedAt goto gluedFailed
groupRows at gluedFailed do makeGluedFailed
groupRows at gluedFailed return error gluedFailedError
groupRows at strayAt do makeStrayWord
groupRows at strayAt goto strayFailed
groupRows at strayFailed do makeStrayFailed
groupRows at strayFailed return error strayFailedError
groupRows at minusStray do makeMinusWord
groupRows at minusStray goto minusFailed
groupRows at minusFailed do makeMinusFailed
groupRows at minusFailed return error minusFailedError
groupRows at dangling do measureDangling
groupRows at dangling do makeDanglingWord
groupRows at dangling goto danglingFailed
groupRows at danglingFailed do makeDanglingFailed
groupRows at danglingFailed return error danglingFailedError

