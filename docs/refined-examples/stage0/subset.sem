checkStep at yesKnown do noCheck
checkStep at yesKnown branch ifError noCheck goto noCheckFailed else goto noKnown
checkStep at noKnown do ifCheck
checkStep at noKnown branch ifError ifCheck goto ifCheckFailed else goto ifChecked
checkStep at ifChecked branch if onValue goto branchOnValue else goto ifErrorStep
checkStep at branchOnValue do findCondition
checkStep at branchOnValue branch ifError findCondition goto findConditionFailed else goto conditionFound
checkStep at conditionFound do conditionCode
checkStep at conditionFound do boolCheck
checkStep at conditionFound branch if isBool goto makeBranchIf else goto conditionWrongType
checkStep at makeBranchIf do makeIfVerb
checkStep at makeBranchIf do makeIf
checkStep at makeBranchIf return ok ifDone
checkStep at ifErrorStep do ifErrorCheck
checkStep at ifErrorStep branch ifError ifErrorCheck goto ifErrorCheckFailed else goto ifErrorChecked
checkStep at ifErrorChecked branch if onError goto branchOnError else goto badBranch
checkStep at branchOnError do findFailing
checkStep at branchOnError branch ifError findFailing goto findFailingFailed else goto failingFound
checkStep at failingFound do readRaises
checkStep at failingFound branch if canFail goto makeBranchIfError else goto cannotFail
checkStep at makeBranchIfError do makeIfErrorVerb
checkStep at makeBranchIfError do makeIfError
checkStep at makeBranchIfError return ok ifErrorDone
checkStep at returnStep do returnShape
