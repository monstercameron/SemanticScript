# Tests for emitc.sem: every invariant of `emitProgram` is verified below, on
# the squares sample (samples/squares/squares.sem), whose C is searched for its
# signature, constant, call, jumps, return, and C main, on a copy that calls a
# target outside the subset, which is refused at the target, and on an entry
# the program does not have, which is refused at its module.

emitTest is test
emitTest purpose "The squares sample is written as C: the prelude, its constant, a function for main with its locals, labels, and jumps that count and reset the loop passes, and a C main; a source outside the subset is refused"
emitTest verifies emitProgram writesC
emitTest verifies emitProgram countsLoopPasses
emitTest verifies emitProgram refusesOutsideSubset
emitTest typeParameter none
emitTest input none
emitTest output none
emitTest outputOwnedBy none
emitTest raises none
emitTest effect none
emitTest uses none
emitTest memoryHeap true
emitTest async false
emitTest maxRecursion none
emitTest label begin loopKind none
emitTest label begin within none
emitTest label lexXDone loopKind none
emitTest label lexXDone within none
emitTest label groupXDone loopKind none
emitTest label groupXDone within none
emitTest label modelXDone loopKind none
emitTest label modelXDone within none
emitTest label emitDone loopKind none
emitTest label emitDone within none
emitTest label readCDone loopKind none
emitTest label readCDone within none
emitTest label findMainWrapperDone loopKind none
emitTest label findMainWrapperDone within none
emitTest label findSignatureDone loopKind none
emitTest label findSignatureDone within none
emitTest label findConstantTextDone loopKind none
emitTest label findConstantTextDone within none
emitTest label findConstantReadDone loopKind none
emitTest label findConstantReadDone within none
emitTest label findPassTextDone loopKind none
emitTest label findPassTextDone within none
emitTest label findResetTextDone loopKind none
emitTest label findResetTextDone within none
emitTest label findCallTextDone loopKind none
emitTest label findCallTextDone within none
emitTest label findReturnTextDone loopKind none
emitTest label findReturnTextDone within none
emitTest label lexYDone loopKind none
emitTest label lexYDone within none
emitTest label groupYDone loopKind none
emitTest label groupYDone within none
emitTest label modelYDone loopKind none
emitTest label modelYDone within none
emitTest label badRefused loopKind none
emitTest label badRefused within none
emitTest label otherRefused loopKind none
emitTest label otherRefused within none
emitTest label refused loopKind none
emitTest label refused within none
emitTest let source String "# A stage0 sample: an arithmetic loop. It prints the squares of 1 to `limit`\n# (1, 4, 9, 16, 25), one per line, from a `while` loop bounded by the module\n# constant `limit`, and exits with code 0.\n\nsquares is module\nsquares purpose \"Print the squares of the whole numbers from 1 to a limit\"\nsquares path squares\nsquares imports standard.console\nsquares imports standard.math\nsquares imports standard.compare\nsquares exports main\n\nstdoutWriter is capability\nstdoutWriter purpose \"Authority to write lines to standard output\"\nstdoutWriter grants write console.stdout none\n\nlimit is constant\nlimit purpose \"The last number whose square is printed\"\nlimit type Int64\nlimit value 5\n\nmain is operation\nmain purpose \"Print the square of each whole number from 1 to the limit\"\nmain invariant none\nmain typeParameter none\nmain input none\nmain output ExitCode\nmain outputOwnedBy none\nmain raises none\nmain effect write console.stdout\nmain uses stdoutWriter\nmain memoryHeap false\nmain async false\nmain maxRecursion none\nmain label begin loopKind none\nmain label begin within none\nmain label nextSquare note \"Each pass prints one square; the loop returns to its header once per number\"\nmain label nextSquare loopKind while\nmain label nextSquare within none\nmain label nextSquare maxIterations limit\nmain label printSquare loopKind none\nmain label printSquare within nextSquare\nmain label advance loopKind none\nmain label advance within nextSquare\nmain label finished loopKind none\nmain label finished within none\nmain label failed loopKind none\nmain label failed within none\nmain let number Int64 1 mutable\nmain let one Int64 1 immutable\nmain let okCode ExitCode 0 immutable\nmain let failCode ExitCode 1 immutable\nmain at begin goto nextSquare\nmain at nextSquare do pastLimitCheck\nmain at nextSquare branch if pastLimit goto finished else goto printSquare\nmain at printSquare do square\nmain at printSquare do printIt\nmain at printSquare branch ifError printIt goto failed else goto advance\nmain at advance do addOne\nmain at advance set number nextNumber\nmain at advance goto nextSquare\nmain at finished return ok okCode\nmain at failed return ok failCode\n\npastLimitCheck is call\npastLimitCheck in main\npastLimitCheck invokes compare.greaterThanInt64\npastLimitCheck argument left Int64 number copy\npastLimitCheck argument right Int64 limit copy\npastLimitCheck result pastLimit Bool\npastLimitCheck ownedBy none\npastLimitCheck cleanedBy none\npastLimitCheck borrows none\npastLimitCheck catch none\npastLimitCheck suppresses none\n\nsquare is call\nsquare in main\nsquare invokes math.multiplyInt64\nsquare argument left Int64 number copy\nsquare argument right Int64 number copy\nsquare result squared Int64\nsquare ownedBy none\nsquare cleanedBy none\nsquare borrows none\nsquare catch none\nsquare suppresses none\n\nprintIt is call\nprintIt in main\nprintIt invokes console.writeIntegerLine\nprintIt argument value Int64 squared copy\nprintIt result none\nprintIt ownedBy none\nprintIt cleanedBy none\nprintIt borrows none\nprintIt catch printError console.WriteError\nprintIt suppresses none\n\naddOne is call\naddOne in main\naddOne invokes math.addInt64\naddOne argument left Int64 number copy\naddOne argument right Int64 one copy\naddOne result nextNumber Int64\naddOne ownedBy none\naddOne cleanedBy none\naddOne borrows none\naddOne catch none\naddOne suppresses none\n" immutable
emitTest let badSource String "# A stage0 sample: an arithmetic loop. It prints the squares of 1 to `limit`\n# (1, 4, 9, 16, 25), one per line, from a `while` loop bounded by the module\n# constant `limit`, and exits with code 0.\n\nsquares is module\nsquares purpose \"Print the squares of the whole numbers from 1 to a limit\"\nsquares path squares\nsquares imports standard.console\nsquares imports standard.math\nsquares imports standard.compare\nsquares exports main\n\nstdoutWriter is capability\nstdoutWriter purpose \"Authority to write lines to standard output\"\nstdoutWriter grants write console.stdout none\n\nlimit is constant\nlimit purpose \"The last number whose square is printed\"\nlimit type Int64\nlimit value 5\n\nmain is operation\nmain purpose \"Print the square of each whole number from 1 to the limit\"\nmain invariant none\nmain typeParameter none\nmain input none\nmain output ExitCode\nmain outputOwnedBy none\nmain raises none\nmain effect write console.stdout\nmain uses stdoutWriter\nmain memoryHeap false\nmain async false\nmain maxRecursion none\nmain label begin loopKind none\nmain label begin within none\nmain label nextSquare note \"Each pass prints one square; the loop returns to its header once per number\"\nmain label nextSquare loopKind while\nmain label nextSquare within none\nmain label nextSquare maxIterations limit\nmain label printSquare loopKind none\nmain label printSquare within nextSquare\nmain label advance loopKind none\nmain label advance within nextSquare\nmain label finished loopKind none\nmain label finished within none\nmain label failed loopKind none\nmain label failed within none\nmain let number Int64 1 mutable\nmain let one Int64 1 immutable\nmain let okCode ExitCode 0 immutable\nmain let failCode ExitCode 1 immutable\nmain at begin goto nextSquare\nmain at nextSquare do pastLimitCheck\nmain at nextSquare branch if pastLimit goto finished else goto printSquare\nmain at printSquare do square\nmain at printSquare do printIt\nmain at printSquare branch ifError printIt goto failed else goto advance\nmain at advance do addOne\nmain at advance set number nextNumber\nmain at advance goto nextSquare\nmain at finished return ok okCode\nmain at failed return ok failCode\n\npastLimitCheck is call\npastLimitCheck in main\npastLimitCheck invokes compare.greaterThanInt64\npastLimitCheck argument left Int64 number copy\npastLimitCheck argument right Int64 limit copy\npastLimitCheck result pastLimit Bool\npastLimitCheck ownedBy none\npastLimitCheck cleanedBy none\npastLimitCheck borrows none\npastLimitCheck catch none\npastLimitCheck suppresses none\n\nsquare is call\nsquare in main\nsquare invokes math.wrappingMultiplyInt64\nsquare argument left Int64 number copy\nsquare argument right Int64 number copy\nsquare result squared Int64\nsquare ownedBy none\nsquare cleanedBy none\nsquare borrows none\nsquare catch none\nsquare suppresses none\n\nprintIt is call\nprintIt in main\nprintIt invokes console.writeIntegerLine\nprintIt argument value Int64 squared copy\nprintIt result none\nprintIt ownedBy none\nprintIt cleanedBy none\nprintIt borrows none\nprintIt catch printError console.WriteError\nprintIt suppresses none\n\naddOne is call\naddOne in main\naddOne invokes math.addInt64\naddOne argument left Int64 number copy\naddOne argument right Int64 one copy\naddOne result nextNumber Int64\naddOne ownedBy none\naddOne cleanedBy none\naddOne borrows none\naddOne catch none\naddOne suppresses none\n" immutable
emitTest let badExpected String "79:16: this call target is outside the stage0 subset (math.wrappingMultiplyInt64)" immutable
emitTest let noEntryExpected String "5:1: the module has no main operation (squares)" immutable
emitTest let refusedText String "the front end refused the source or a step failed" immutable
emitTest let mainWrapper String "int32_t refined_program_main(void) {\n  return o_squares_main();\n}\n" immutable
emitTest let signature String "static int o_squares_main(void) {\n" immutable
emitTest let constantText String "static const int64_t k_squares_limit = 5;\n" immutable
emitTest let constantRead String "  int64_t v_limit = k_squares_limit;\n" immutable
emitTest let passText String "{ ss_pass(&n_nextSquare, v_limit, \"nextSquare\"); goto l_nextSquare; }" immutable
emitTest let resetText String "{ n_nextSquare = 0; goto l_nextSquare; }" immutable
emitTest let callText String "  f_printIt = ss_write_integer_line(v_squared);\n" immutable
emitTest let returnText String "  { int ss_result = v_okCode; return ss_result; }\n" immutable
emitTest let entry String "squares.main" immutable
emitTest let otherEntry String "squares.start" immutable
