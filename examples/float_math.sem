# float_math — Float64 arithmetic + console.writeFloatLine (README ss10.6).
# Expected output: 4
# 1.5 + 2.5 == 4.0. Exercises math.addFloat64 and the float writer.
# (todos WS3-011, WS3-013)

FloatMath is project
FloatMath module examplesFloatMath
FloatMath target console
FloatMath entry main

examplesFloatMath is module
examplesFloatMath path examples.floatMath
examplesFloatMath exports main
examplesFloatMath purpose "Add two Float64 values and print the sum"
examplesFloatMath invariant "main is the only entry operation"

ExitCode is alias
ExitCode for Int32
ExitCode purpose "Process exit status"

stdoutWriter is capability
stdoutWriter grants write console.stdout
stdoutWriter purpose "Allow controlled writes to standard output"

main is operation
main out ExitCode
main effect write console.stdout
main uses stdoutWriter
main memory heap no
main async no
main purpose "Compute 1.5 + 2.5 and print it"
main invariant "Writes exactly one float line: 4"
main let leftValue immutable Float64 1.5
main let rightValue immutable Float64 2.5
main let harnessName immutable String "float_math"
main let harnessExpected immutable Float64 4.0
main let zeroFloatGuard immutable Float64 0.0
main let noopName immutable String "float_math: real result (not the no-op 0.0)"
main do sumCall
main do writeSum
main do noopZeroCmp
main do noopCheck
main do harnessReport
main return harnessSummaryCode

sumCall is call
sumCall in main
sumCall invokes math.addFloat64
sumCall arg left Float64 leftValue
sumCall arg right Float64 rightValue
sumCall out total Float64

writeSum is call
writeSum in main
writeSum invokes test.assertEqualFloat64
writeSum arg name String harnessName
writeSum arg expected Float64 harnessExpected
writeSum arg actual Float64 total


noopZeroCmp is call
noopZeroCmp in main
noopZeroCmp invokes math.equalFloat64
noopZeroCmp arg left Float64 total
noopZeroCmp arg right Float64 zeroFloatGuard
noopZeroCmp out noopIsZero Bool

noopCheck is call
noopCheck in main
noopCheck invokes test.assertFalse
noopCheck arg name String noopName
noopCheck arg value Bool noopIsZero

harnessReport is call
harnessReport in main
harnessReport invokes test.summary
harnessReport out harnessSummaryCode ExitCode