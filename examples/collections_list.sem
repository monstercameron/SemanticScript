# collections_list — the collections runtime (R-061): a growable Int64 list with
# create / append / get / length / release lowered to real heap memory. The list
# is a stable handle over a [count, capacity, data] header whose data buffer is
# realloc-grown on append, so the handle never dangles. This exercises:
#   * growth: 6 appends past the initial capacity (4) force a realloc to 8;
#   * indexing: get(i) reads the i-th element back (not a constant);
#   * bounds-safety: an out-of-bounds get is a recoverable ListError (the `err`
#     path), never an out-of-bounds load / crash.
# Expected output: 5 PASS lines then  ---- 5 passed, 0 failed ----

CollectionsList is project
CollectionsList module examplesCollectionsList
CollectionsList target console
CollectionsList entry main

examplesCollectionsList is module
examplesCollectionsList path examples.collectionsList
examplesCollectionsList exports main
examplesCollectionsList purpose "Build a growable list and assert its runtime behavior"
examplesCollectionsList invariant "Growth, indexing, and out-of-bounds safety all hold"

ExitCode is alias
ExitCode for Int32
ExitCode purpose "Process exit status"

ListHandle is alias
ListHandle for OpaquePointer
ListHandle purpose "An opaque growable-list handle"

ListError is error
ListError purpose "An out-of-bounds or allocation list failure"

stdoutWriter is capability
stdoutWriter grants write console.stdout
stdoutWriter purpose "Allow controlled writes to standard output"

main is operation
main out ExitCode
main effect write console.stdout
main uses stdoutWriter
main async no
main purpose "Append six values (forcing growth), read them back, and probe out-of-bounds"
main invariant "All five assertions hold"
main let v10 immutable Int64 10
main let v20 immutable Int64 20
main let v30 immutable Int64 30
main let v40 immutable Int64 40
main let v50 immutable Int64 50
main let v60 immutable Int64 60
main let idx0 immutable Int64 0
main let idx5 immutable Int64 5
main let idxOob immutable Int64 99
main let expectLen immutable Int64 6
main let oneMark immutable Int64 1
main let oobFlag mutable Int64 0
main let tnLen immutable String "list length is 6 after six appends (growth past capacity 4)"
main let tnGet0 immutable String "get(0) returns the first appended value 10"
main let tnGet5 immutable String "get(5) returns the sixth appended value 60"
main let tnDiff immutable String "distinct indices return distinct values (real indexing)"
main let tnOob immutable String "an out-of-bounds get is caught as a ListError, not a crash"
main do mk
main do app0
main do app1
main do app2
main do app3
main do app4
main do app5
main do lenCall
main do get0
main do get5
main do getOob
main branch ifError getOob goto oobCaught
main goto afterOob
main at oobCaught set oobFlag oneMark
main at afterOob do checkLen
main do checkGet0
main do checkGet5
main do checkDiff
main do checkOob
main do rel
main do harnessReport
main return harnessSummaryCode

mk is call
mk in main
mk invokes list.create
mk out theList ListHandle

app0 is call
app0 in main
app0 invokes list.append
app0 arg list ListHandle theList
app0 arg value Int64 v10

