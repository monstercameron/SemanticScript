# convert_int_float — explicit Int64 -> Float64 conversion via convert.toFloat64
# (README §10.6/§33.5). The float is produced by a real conversion instruction
# (sitofp), not a Float64 literal, so it fails under a no-op lowering.
#
# Correctness observation: Int64 42 converted to Float64 prints as 42.
# Expected output: 42

ConvertIntFloat is project
ConvertIntFloat module examplesConvertIntFloat
ConvertIntFloat target console
ConvertIntFloat entry main

examplesConvertIntFloat is module
examplesConvertIntFloat path examples.convertIntFloat
examplesConvertIntFloat exports main
examplesConvertIntFloat purpose "Convert an Int64 to Float64 and print it"
examplesConvertIntFloat invariant "42 (Int64) converts to 42.0 (Float64)"

ExitCode is alias
ExitCode for Int32
ExitCode purpose "Process exit status"

stdoutWriter is capability
stdoutWriter grants write console.stdout
stdoutWriter purpose "Allow controlled writes to standard output"

main is operation
main out ExitCode
main effect write console.stdout
main uses stdoutWriter
main memory heap no
main async no
main purpose "Convert Int64 42 to Float64 and print it"
main invariant "Writes exactly one float line: 42"
main let intVal immutable Int64 42
main let harnessName immutable String "convert_int_float"
main let harnessExpected immutable Float64 42.0
main let zeroFloatGuard immutable Float64 0.0
main let noopName immutable String "convert_int_float: real result (not the no-op 0.0)"
main do widenToFloat
main do printFloat
main do noopZeroCmp
main do noopCheck
main do harnessReport
main return harnessSummaryCode

widenToFloat is call
widenToFloat in main
widenToFloat invokes convert.toFloat64
widenToFloat arg inputValue Int64 intVal
widenToFloat out floatVal Float64

printFloat is call
printFloat in main
printFloat invokes test.assertEqualFloat64
printFloat arg name String harnessName
printFloat arg expected Float64 harnessExpected
printFloat arg actual Float64 floatVal


noopZeroCmp is call
noopZeroCmp in main
noopZeroCmp invokes math.equalFloat64
noopZeroCmp arg left Float64 floatVal
noopZeroCmp arg right Float64 zeroFloatGuard
noopZeroCmp out noopIsZero Bool

noopCheck is call
noopCheck in main
noopCheck invokes test.assertFalse
noopCheck arg name String noopName
noopCheck arg value Bool noopIsZero

harnessReport is call
harnessReport in main
harnessReport invokes test.summary
harnessReport out harnessSummaryCode ExitCode
