# record_box_value -- (repurposed from generic_container_arity (no generics runtime)) build a record and read a field back (Record.new / Record.field,
# lowered to LLVM insert/extractvalue, README s10). The printed value is read
# from the constructed record, not a constant.
#
# Correctness observation: build Box{itemCount=3, capacity=8}; read itemCount.
# Expected output: 3

RecordBoxValue is project
RecordBoxValue module examplesRecordBoxValue
RecordBoxValue target console
RecordBoxValue entry main

examplesRecordBoxValue is module
examplesRecordBoxValue path examples.recordBoxValue
examplesRecordBoxValue exports main
examplesRecordBoxValue purpose "Build a Box record and read its itemCount field"
examplesRecordBoxValue invariant "Prints the itemCount field of the built record"

ExitCode is alias
ExitCode for Int32
ExitCode purpose "Process exit status"

stdoutWriter is capability
stdoutWriter grants write console.stdout
stdoutWriter purpose "Allow controlled writes to standard output"

Box is record
Box field itemCount Int64
Box field capacity Int64
Box purpose "A two-field record"

main is operation
main out ExitCode
main effect write console.stdout
main uses stdoutWriter
main memory heap no
main async no
main purpose "Build Box and print its itemCount field"
main invariant "Writes exactly one integer line: 3"
main let firstInput immutable Int64 3
main let secondInput immutable Int64 8
main let harnessName immutable String "record_box_value"
main let harnessExpected immutable Int64 3
main let noopDecoy immutable Int64 0
main let noopName immutable String "record_box_value: real result (not the no-op 0)"
main do buildRec
main do readField
main do writeField
main do noopCheck
main do harnessReport
main return harnessSummaryCode

buildRec is call
buildRec in main
buildRec invokes Box.new
buildRec arg itemCount Int64 firstInput
buildRec arg capacity Int64 secondInput
buildRec out built Box

readField is call
readField in main
readField invokes Box.itemCount
readField arg record Box built
readField out fieldOut Int64

writeField is call
writeField in main
writeField invokes test.assertEqualInt64
writeField arg name String harnessName
writeField arg expected Int64 harnessExpected
writeField arg actual Int64 fieldOut


noopCheck is call
noopCheck in main
noopCheck invokes test.assertNotEqualInt64
noopCheck arg name String noopName
noopCheck arg expected Int64 noopDecoy
noopCheck arg actual Int64 fieldOut

harnessReport is call
harnessReport in main
harnessReport invokes test.summary
harnessReport out harnessSummaryCode ExitCode