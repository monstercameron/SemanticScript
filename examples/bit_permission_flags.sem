# bit_permission_flags -- OR-composed permission mask and disjoint AND. Load-bearing: POSITIVE and NEGATIVE assertions (false-cases,
# inequalities, edge cases) stress the language in both directions via the
# standard.test harness. Exit 0 iff every assertion holds.
# Expected output: 2 PASS lines then  ---- 2 passed, 0 failed ----

BitPermissionFlags is project
BitPermissionFlags module examplesBitPermissionFlags
BitPermissionFlags target console
BitPermissionFlags entry main

examplesBitPermissionFlags is module
examplesBitPermissionFlags path examples.bitPermissionFlags
examplesBitPermissionFlags exports main
examplesBitPermissionFlags purpose "OR-composed permission mask and disjoint AND"
examplesBitPermissionFlags invariant "Positive and negative assertions both hold"

ExitCode is alias
ExitCode for Int32
ExitCode purpose "Process exit status"

stdoutWriter is capability
stdoutWriter grants write console.stdout
stdoutWriter purpose "Allow controlled writes to standard output"

main is operation
main out ExitCode
main effect write console.stdout
main uses stdoutWriter
main memory heap no
main async no
main purpose "OR-composed permission mask and disjoint AND"
main invariant "All assertions hold"
main let readBit immutable Int64 4
main let writeBit immutable Int64 2
main let execBit immutable Int64 1
main let expMask immutable Int64 7
main let expZero immutable Int64 0
main let tn0 immutable String "read|write|exec == 7"
main let tn1 immutable String "read & write == 0 (disjoint bits)"
main let noopDecoy immutable Int64 0
main let noopName immutable String "bit_permission_flags: real result (not the no-op 0)"
main do orRW
main do orX
main do andRW
main do check0
main do check1
main do noopCheck
main do harnessReport
main return harnessSummaryCode

orRW is call
orRW in main
orRW invokes math.bitOrInt64
orRW arg left Int64 readBit
orRW arg right Int64 writeBit
orRW out rw Int64

orX is call
orX in main
orX invokes math.bitOrInt64
orX arg left Int64 rw
orX arg right Int64 execBit
orX out mask Int64

andRW is call
andRW in main
andRW invokes math.bitAndInt64
andRW arg left Int64 readBit
andRW arg right Int64 writeBit
andRW out rwAnd Int64

check0 is call
check0 in main
check0 invokes test.assertEqualInt64
check0 arg name String tn0
check0 arg expected Int64 expMask
check0 arg actual Int64 mask

check1 is call
check1 in main
check1 invokes test.assertEqualInt64
check1 arg name String tn1
check1 arg expected Int64 expZero
check1 arg actual Int64 rwAnd

noopCheck is call
noopCheck in main
noopCheck invokes test.assertNotEqualInt64
noopCheck arg name String noopName
noopCheck arg expected Int64 noopDecoy
noopCheck arg actual Int64 mask

harnessReport is call
harnessReport in main
harnessReport invokes test.summary
harnessReport out harnessSummaryCode ExitCode
