# record_query_fields — (repurposed from database_prepared_statement: semanticscript has no
# SQL runtime). Build a record with two fields and read one back (README §10).
# The printed value is read from the record, not a constant.
#
# Correctness observation: build Query{queryId=7, rowLimit=25}; print rowLimit.
# Expected output: 25

RecordQueryFields is project
RecordQueryFields module examplesRecordQueryFields
RecordQueryFields target console
RecordQueryFields entry main

examplesRecordQueryFields is module
examplesRecordQueryFields path examples.recordQueryFields
examplesRecordQueryFields exports main
examplesRecordQueryFields purpose "Build a Query record and read its rowLimit field"
examplesRecordQueryFields invariant "Prints the rowLimit field of the built record"

ExitCode is alias
ExitCode for Int32
ExitCode purpose "Process exit status"

stdoutWriter is capability
stdoutWriter grants write console.stdout
stdoutWriter purpose "Allow controlled writes to standard output"

Query is record
Query field queryId Int64
Query field rowLimit Int64
Query purpose "A query id with a row limit"

main is operation
main out ExitCode
main effect write console.stdout
main uses stdoutWriter
main memory heap no
main async no
main purpose "Build Query{7, 25} and print its rowLimit"
main invariant "Writes exactly one integer line: 25"
main let idValue immutable Int64 7
main let limitValue immutable Int64 25
main let harnessName immutable String "record_query_fields"
main let harnessExpected immutable Int64 25
main let noopDecoy immutable Int64 0
main let noopName immutable String "record_query_fields: real result (not the no-op 0)"
main do buildQuery
main do readLimit
main do writeLimit
main do noopCheck
main do harnessReport
main return harnessSummaryCode

buildQuery is call
buildQuery in main
buildQuery invokes Query.new
buildQuery arg queryId Int64 idValue
buildQuery arg rowLimit Int64 limitValue
buildQuery out query Query

readLimit is call
readLimit in main
readLimit invokes Query.rowLimit
readLimit arg record Query query
readLimit out limitOut Int64

writeLimit is call
writeLimit in main
writeLimit invokes test.assertEqualInt64
writeLimit arg name String harnessName
writeLimit arg expected Int64 harnessExpected
writeLimit arg actual Int64 limitOut


noopCheck is call
noopCheck in main
noopCheck invokes test.assertNotEqualInt64
noopCheck arg name String noopName
noopCheck arg expected Int64 noopDecoy
noopCheck arg actual Int64 limitOut

harnessReport is call
harnessReport in main
harnessReport invokes test.summary
harnessReport out harnessSummaryCode ExitCode