# ifvalue -- branch on a value comparison with ifValue, converging the arms to a single asserted `outcome`
# via the standard.test harness (README s13/s35). Prints PASS/FAIL + a summary;
# exit 0 iff the assertion holds.
# Expected output:
#   PASS  ifvalue  (expected 1, actual 1)
#   ---- 1 passed, 0 failed ----

Ifvalue is project
Ifvalue module examplesIfvalue
Ifvalue target console
Ifvalue entry main

examplesIfvalue is module
examplesIfvalue path examples.ifvalue
examplesIfvalue exports main
examplesIfvalue purpose "branch on a value comparison with ifValue"
examplesIfvalue invariant "Self-checking via the test harness"

ExitCode is alias
ExitCode for Int32
ExitCode purpose "Process exit status"

stdoutWriter is capability
stdoutWriter grants write console.stdout
stdoutWriter purpose "Allow controlled writes to standard output"

main is operation
main out ExitCode
main effect write console.stdout
main uses stdoutWriter
main memory heap no
main async no
main purpose "branch on a value comparison with ifValue and assert the outcome"
main invariant "Asserts the converged outcome via the harness"
main let harnessName immutable String "ifvalue"
main let harnessExpected immutable Int64 1
main let outcome mutable Int64 0
main let oneMark immutable Int64 1
main let leftVal immutable Int64 5
main let rightVal immutable Int64 5
main let noopDecoy immutable Int64 0
main let noopName immutable String "ifvalue: real result (not the no-op 0)"
main branch ifValue leftVal equals rightVal goto bothEqual
main goto afterCheck
main at bothEqual set outcome oneMark
main at afterCheck do checkResult
main do noopCheck
main do harnessReport
main return harnessSummaryCode



checkResult is call
checkResult in main
checkResult invokes test.assertEqualInt64
checkResult arg name String harnessName
checkResult arg expected Int64 harnessExpected
checkResult arg actual Int64 outcome

noopCheck is call
noopCheck in main
noopCheck invokes test.assertNotEqualInt64
noopCheck arg name String noopName
noopCheck arg expected Int64 noopDecoy
noopCheck arg actual Int64 outcome

harnessReport is call
harnessReport in main
harnessReport invokes test.summary
harnessReport out harnessSummaryCode ExitCode
