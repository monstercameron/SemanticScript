# http_server_demo — a real HTTP server (WS3-017). Binds a socket on
# 127.0.0.1:18080 and serves `GET /` with a 200 text/plain body via the
# self-contained SemanticScript HTTP runtime (sem_http_runtime.c, h2o optional/off)
# behind the ss_http_serve_static seam. `ss_http_server_run` blocks until a
# signal, so this is NOT a run_examples harness example — test_http_server.py
# starts it, probes it with an HTTP client, and tears it down.

HttpServerDemo is project
HttpServerDemo module fix
HttpServerDemo target console
HttpServerDemo entry main

fix is module
fix path fix.mod
fix exports main
fix purpose "Host the HTTP server demo entry"
fix invariant "Exposes main, which binds the socket and serves until terminated"

httpServeStatic is operation
httpServeStatic in host String
httpServeStatic in port Int32
httpServeStatic in path String
httpServeStatic out Int32
httpServeStatic body runtimeBinding ss_http_serve_static
httpServeStatic purpose "Serve GET <path> on host:port with a fixed 200 body; blocks until signal"
httpServeStatic suppress SS5000 because "http server seam; the typed home is std/standard.http.sem"

main is operation
main out Int32
main async no
main purpose "Stand up the HTTP server on 127.0.0.1:18080"
main invariant "Blocks serving until terminated"
main let host immutable String "127.0.0.1"
main let port immutable Int32 18080
main let routePath immutable String "/"
main let okCode immutable Int32 0
main do serveCall
main return okCode

serveCall is call
serveCall in main
serveCall invokes httpServeStatic
serveCall arg host String host
serveCall arg port Int32 port
serveCall arg path String routePath
serveCall discards "the server blocks until terminated; its return status is unreachable"
