# asset_embed — compile-time asset embedding via literalSource (README ss30.3.2).
# The banner text is read from a file at compile time and printed. (todos WS1-084)
# NOTE: literalSource paths resolve relative to the working directory.
#
# Correctness observation: the printed text comes from the embedded asset file,
# not an inline String literal, so it fails if literalSource embedding is a no-op.
# Expected output: EAV banner asset

AssetEmbed is project
AssetEmbed module examplesAssetEmbed
AssetEmbed target console
AssetEmbed entry main

examplesAssetEmbed is module
examplesAssetEmbed path examples.assetEmbed
examplesAssetEmbed exports main
examplesAssetEmbed purpose "Embed and print a compile-time asset"
examplesAssetEmbed invariant "The banner is embedded from the asset file"

ExitCode is alias
ExitCode for Int32
ExitCode purpose "Process exit status"

stdoutWriter is capability
stdoutWriter grants write console.stdout
stdoutWriter purpose "Allow controlled writes to standard output"

bannerText is storage
bannerText scope module
bannerText type String
bannerText mutability immutable
bannerText literalSource "assets/banner.txt"
bannerText literalEncoding utf8
bannerText literalDigest sha256 144de1874137c5789e54f1ea25a0b89670326576c5e691ed99c54cb05f71b2d6
bannerText purpose "Banner text embedded from an asset file at compile time"

main is operation
main out ExitCode
main effect write console.stdout
main uses stdoutWriter
main memory heap no
main async no
main purpose "Print the embedded banner asset"
main invariant "Writes the banner asset content"
main let harnessName immutable String "asset_embed"
main let harnessExpected immutable String "EAV banner asset"
main let emptyGuard immutable String ""
main let noopName immutable String "asset_embed: real result (not the empty string)"
main do writeBanner
main do noopCheck
main do harnessReport
main return harnessSummaryCode

writeBanner is call
writeBanner in main
writeBanner invokes test.assertEqualText
writeBanner arg name String harnessName
writeBanner arg expected String harnessExpected
writeBanner arg actual String bannerText


noopCheck is call
noopCheck in main
noopCheck invokes test.assertNotEqualText
noopCheck arg name String noopName
noopCheck arg expected String emptyGuard
noopCheck arg actual String bannerText

harnessReport is call
harnessReport in main
harnessReport invokes test.summary
harnessReport out harnessSummaryCode ExitCode