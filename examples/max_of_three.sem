# max_of_three — (repurposed from fifo_queue_unlink: semanticscript has no queue runtime).
# Pick the maximum of three integers with nested math.maxInt64 calls (README
# §10.6). The result is computed, not a constant.
#
# Correctness observation: max(max(4, 9), 2) = 9.
# Expected output: 9

MaxOfThree is project
MaxOfThree module examplesMaxOfThree
MaxOfThree target console
MaxOfThree entry main

examplesMaxOfThree is module
examplesMaxOfThree path examples.maxOfThree
examplesMaxOfThree exports main
examplesMaxOfThree purpose "Compute the maximum of three integers"
examplesMaxOfThree invariant "Result is the largest of the three inputs"

ExitCode is alias
ExitCode for Int32
ExitCode purpose "Process exit status"

stdoutWriter is capability
stdoutWriter grants write console.stdout
stdoutWriter purpose "Allow controlled writes to standard output"

main is operation
main out ExitCode
main effect write console.stdout
main uses stdoutWriter
main memory heap no
main async no
main purpose "Compute max(4,9,2) and print it"
main invariant "Writes exactly one integer line: 9"
main let firstValue immutable Int64 4
main let secondValue immutable Int64 9
main let thirdValue immutable Int64 2
main let harnessName immutable String "max_of_three"
main let harnessExpected immutable Int64 9
main let noopDecoy immutable Int64 0
main let noopName immutable String "max_of_three: real result (not the no-op 0)"
main do maxFirstTwo
main do maxAll
main do writeResult
main do noopCheck
main do harnessReport
main return harnessSummaryCode

maxFirstTwo is call
maxFirstTwo in main
maxFirstTwo invokes math.maxInt64
maxFirstTwo arg left Int64 firstValue
maxFirstTwo arg right Int64 secondValue
maxFirstTwo out partialMax Int64

maxAll is call
maxAll in main
maxAll invokes math.maxInt64
maxAll arg left Int64 partialMax
maxAll arg right Int64 thirdValue
maxAll out largest Int64

writeResult is call
writeResult in main
writeResult invokes test.assertEqualInt64
writeResult arg name String harnessName
writeResult arg expected Int64 harnessExpected
writeResult arg actual Int64 largest


noopCheck is call
noopCheck in main
noopCheck invokes test.assertNotEqualInt64
noopCheck arg name String noopName
noopCheck arg expected Int64 noopDecoy
noopCheck arg actual Int64 largest

harnessReport is call
harnessReport in main
harnessReport invokes test.summary
harnessReport out harnessSummaryCode ExitCode