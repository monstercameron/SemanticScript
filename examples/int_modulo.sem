# int_modulo -- integer modulo with a nonzero and a zero remainder. Load-bearing: POSITIVE and NEGATIVE assertions (false-cases,
# inequalities, edge cases) stress the language in both directions via the
# standard.test harness. Exit 0 iff every assertion holds.
# Expected output: 3 PASS lines then  ---- 3 passed, 0 failed ----

IntModulo is project
IntModulo module examplesIntModulo
IntModulo target console
IntModulo entry main

examplesIntModulo is module
examplesIntModulo path examples.intModulo
examplesIntModulo exports main
examplesIntModulo purpose "integer modulo with a nonzero and a zero remainder"
examplesIntModulo invariant "Positive and negative assertions both hold"

ExitCode is alias
ExitCode for Int32
ExitCode purpose "Process exit status"

stdoutWriter is capability
stdoutWriter grants write console.stdout
stdoutWriter purpose "Allow controlled writes to standard output"

main is operation
main out ExitCode
main effect write console.stdout
main uses stdoutWriter
main memory heap no
main async no
main purpose "integer modulo with a nonzero and a zero remainder"
main invariant "All assertions hold"
main let aVal immutable Int64 17
main let bVal immutable Int64 5
main let cVal immutable Int64 20
main let expTwo immutable Int64 2
main let expZero immutable Int64 0
main let tn0 immutable String "17 % 5 == 2"
main let tn1 immutable String "20 % 5 == 0"
main let tn2 immutable String "17%5 differs from 20%5"
main do m1
main do m2
main do check0
main do check1
main do check2
main do harnessReport
main return harnessSummaryCode

m1 is call
m1 in main
m1 invokes math.moduloInt64
m1 arg left Int64 aVal
m1 arg right Int64 bVal
m1 out r1 Int64

m2 is call
m2 in main
m2 invokes math.moduloInt64
m2 arg left Int64 cVal
m2 arg right Int64 bVal
m2 out r2 Int64

check0 is call
check0 in main
check0 invokes test.assertEqualInt64
check0 arg name String tn0
check0 arg expected Int64 expTwo
check0 arg actual Int64 r1

check1 is call
check1 in main
check1 invokes test.assertEqualInt64
check1 arg name String tn1
check1 arg expected Int64 expZero
check1 arg actual Int64 r2

check2 is call
check2 in main
check2 invokes test.assertNotEqualInt64
check2 arg name String tn2
check2 arg expected Int64 r1
check2 arg actual Int64 r2

harnessReport is call
harnessReport in main
harnessReport invokes test.summary
harnessReport out harnessSummaryCode ExitCode
