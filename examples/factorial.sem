# factorial — direct recursion (README ss33.3), stress-tested with positive AND
# negative assertions via the standard.test harness: factorial(5)==120,
# factorial(4)==24 (a second input, not a constant), and factorial(5) != factorial(4).
# Expected output: 3 PASS lines then  ---- 3 passed, 0 failed ----

Factorial is project
Factorial module examplesFactorial
Factorial target console
Factorial entry main

examplesFactorial is module
examplesFactorial path examples.factorial
examplesFactorial exports main
examplesFactorial purpose "Compute factorials by recursion and assert them"
examplesFactorial invariant "factorial(n) terminates at n <= 1"

ExitCode is alias
ExitCode for Int32
ExitCode purpose "Process exit status"

stdoutWriter is capability
stdoutWriter grants write console.stdout
stdoutWriter purpose "Allow controlled writes to standard output"

factorial is operation
factorial in n Int64
factorial out Int64
factorial memory heap no
factorial async no
factorial purpose "Return n! for non-negative n via recursion"
factorial invariant "Recurses on n-1 until the n <= 1 base case"
factorial let one immutable Int64 1
factorial do baseCheck
factorial branch if isBase goto base
factorial do decCall
factorial do recCall
factorial do mulCall
factorial return product
factorial at base return one

baseCheck is call
baseCheck in factorial
baseCheck invokes math.lessThanOrEqualInt64
baseCheck arg left Int64 n
baseCheck arg right Int64 one
baseCheck out isBase Bool

decCall is call
decCall in factorial
decCall invokes math.subtractInt64
decCall arg left Int64 n
decCall arg right Int64 one
decCall out nMinusOne Int64

recCall is call
recCall in factorial
recCall invokes factorial
recCall arg n Int64 nMinusOne
recCall out subFactorial Int64

mulCall is call
mulCall in factorial
mulCall invokes math.multiplyInt64
mulCall arg left Int64 n
mulCall arg right Int64 subFactorial
mulCall out product Int64

main is operation
main out ExitCode
main effect write console.stdout
main uses stdoutWriter
main memory heap no
main async no
main purpose "Assert factorial(5), factorial(4), and that they differ"
main invariant "All assertions hold"
main let five immutable Int64 5
main let four immutable Int64 4
main let exp120 immutable Int64 120
main let exp24 immutable Int64 24
main let tn1 immutable String "factorial(5) == 120"
main let tn2 immutable String "factorial(4) == 24"
main let tn3 immutable String "factorial(5) differs from factorial(4)"
main do call5
main do call4
main do check1
main do check2
main do check3
main do harnessReport
main return harnessSummaryCode

call5 is call
call5 in main
call5 invokes factorial
call5 arg n Int64 five
call5 out ans5 Int64

call4 is call
call4 in main
call4 invokes factorial
call4 arg n Int64 four
call4 out ans4 Int64

check1 is call
check1 in main
check1 invokes test.assertEqualInt64
check1 arg name String tn1
check1 arg expected Int64 exp120
check1 arg actual Int64 ans5

check2 is call
check2 in main
check2 invokes test.assertEqualInt64
check2 arg name String tn2
check2 arg expected Int64 exp24
check2 arg actual Int64 ans4

check3 is call
check3 in main
check3 invokes test.assertNotEqualInt64
check3 arg name String tn3
check3 arg expected Int64 ans5
check3 arg actual Int64 ans4

harnessReport is call
harnessReport in main
harnessReport invokes test.summary
harnessReport out harnessSummaryCode ExitCode
