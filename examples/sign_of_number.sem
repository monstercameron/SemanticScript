# sign_of_number -- signum for negative, positive and zero. Load-bearing: POSITIVE and NEGATIVE assertions (false-cases,
# inequalities, edge cases) stress the language in both directions via the
# standard.test harness. Exit 0 iff every assertion holds.
# Expected output: 3 PASS lines then  ---- 3 passed, 0 failed ----

SignOfNumber is project
SignOfNumber module examplesSignOfNumber
SignOfNumber target console
SignOfNumber entry main

examplesSignOfNumber is module
examplesSignOfNumber path examples.signOfNumber
examplesSignOfNumber exports main
examplesSignOfNumber purpose "signum for negative, positive and zero"
examplesSignOfNumber invariant "Positive and negative assertions both hold"

ExitCode is alias
ExitCode for Int32
ExitCode purpose "Process exit status"

stdoutWriter is capability
stdoutWriter grants write console.stdout
stdoutWriter purpose "Allow controlled writes to standard output"

main is operation
main out ExitCode
main effect write console.stdout
main uses stdoutWriter
main memory heap no
main async no
main purpose "signum for negative, positive and zero"
main invariant "All assertions hold"
main let neg immutable Int64 -7
main let pos immutable Int64 7
main let zeroV immutable Int64 0
main let expNeg immutable Int64 -1
main let expPos immutable Int64 1
main let expZero immutable Int64 0
main let tn0 immutable String "sign(-7) == -1"
main let tn1 immutable String "sign(7) == 1"
main let tn2 immutable String "sign(0) == 0"
main let noopDecoy immutable Int64 0
main let noopName immutable String "sign_of_number: real result (not the no-op 0)"
main do s1
main do s2
main do s3
main do check0
main do check1
main do check2
main do noopCheck
main do harnessReport
main return harnessSummaryCode

s1 is call
s1 in main
s1 invokes math.signInt64
s1 arg value Int64 neg
s1 out signNeg Int64

s2 is call
s2 in main
s2 invokes math.signInt64
s2 arg value Int64 pos
s2 out signPos Int64

s3 is call
s3 in main
s3 invokes math.signInt64
s3 arg value Int64 zeroV
s3 out signZero Int64

check0 is call
check0 in main
check0 invokes test.assertEqualInt64
check0 arg name String tn0
check0 arg expected Int64 expNeg
check0 arg actual Int64 signNeg

check1 is call
check1 in main
check1 invokes test.assertEqualInt64
check1 arg name String tn1
check1 arg expected Int64 expPos
check1 arg actual Int64 signPos

check2 is call
check2 in main
check2 invokes test.assertEqualInt64
check2 arg name String tn2
check2 arg expected Int64 expZero
check2 arg actual Int64 signZero

noopCheck is call
noopCheck in main
noopCheck invokes test.assertNotEqualInt64
noopCheck arg name String noopName
noopCheck arg expected Int64 noopDecoy
noopCheck arg actual Int64 signNeg

harnessReport is call
harnessReport in main
harnessReport invokes test.summary
harnessReport out harnessSummaryCode ExitCode
