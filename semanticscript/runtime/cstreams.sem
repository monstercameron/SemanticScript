# stdio for the runtime's C library, written in SemanticScript (D-160): FILE streams buffered as glibc
# buffers them, the printf and scanf families, and the files stdio names.
#
# This module is generated from tools/cstreams.dsl by tools/build.py.

cstreams is module
cstreams purpose "stdio for the runtime's C library: FILE streams buffered as glibc buffers them, the printf and scanf families, and the files stdio names (D-160)"
cstreams path cstreams
cstreams imports standard.machine
cstreams imports standard.system
cstreams imports standard.string
cstreams imports standard.math
cstreams imports standard.compare
