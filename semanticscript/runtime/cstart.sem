# What a C program linked with the runtime's C library has done before main (D-161), written in
# SemanticScript.
#
# This module is generated from tools/cstart.dsl by tools/build.py.

cstart is module
cstart purpose "What a C program linked with the runtime's C library has done before main: the process's stack kept, the stack protector's canary, and the standard streams' data symbols (D-161)"
cstart path cstart
cstart imports standard.machine
cstart imports standard.system
cstart imports standard.test
cstart imports kernel
cstart imports heap
cstart imports clibrary
cstart exports none

memoryAccess is capability
memoryAccess purpose "Authority to keep what the process started with and fill the canary"
memoryAccess grants use machine.memory none

systemCalls is capability
systemCalls purpose "Authority to set the thread pointer and read random bytes"
systemCalls grants use system.calls none

# D-161: `refined build semanticscript/runtime --kind clibrary` writes the C library as an object a C program links
# instead of glibc on Linux. Its `_start` (the compiler's few instructions) calls `refined_c_prepare` with the stack the
# kernel gave (argc, argv, envp), then the program's init arrays, then `main(argc, argv, envp)`, then `exit`. The code
# gcc compiles reads the stack protector's canary at %fs:0x28 on x86_64, so the thread pointer is set to a block of
# the library's own that points at itself, with a random canary at 0x28; on AArch64 the canary is the data symbol
# `__stack_chk_guard`, filled from getrandom. machine.state byte 2352 holds the block's address.
blockAt is constant
blockAt purpose "Where the thread block's address is kept, in machine.state"
blockAt type Int64
blockAt value 2352

prepareProgram is operation
prepareProgram purpose "Make the process ready for a C program's main: keep argc, argv, and envp; set up the stack protector's canary; point stdin, stdout, and stderr at their FILE blocks"
prepareProgram invariant readiesProgram "\"After it, argv and envp are what the stack held and the data symbols point at the FILE blocks\""
prepareProgram typeParameter none
prepareProgram input stack machine.Address copied
prepareProgram output none
prepareProgram outputOwnedBy none
prepareProgram raises none
prepareProgram effect use machine.memory
prepareProgram effect use system.calls
prepareProgram uses memoryAccess
prepareProgram uses systemCalls
prepareProgram memoryHeap false
prepareProgram async false
prepareProgram maxRecursion none
prepareProgram abi c "refined_c_prepare"
