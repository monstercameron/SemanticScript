# ---------------------------------------------------------------- fs targets: paths
fsExists is operation
fsExists purpose "fs.exists: whether a path names something, links followed; an empty path names nothing"
fsExists invariant findsPath "\"Gives 1 for a file or directory that is there, otherwise 0\""
fsExists typeParameter none
fsExists input shape machine.Address copied
fsExists input args machine.Address copied
fsExists input results machine.Address copied
fsExists output none
fsExists outputOwnedBy none
fsExists raises none
fsExists effect use machine.memory
fsExists effect use system.calls
fsExists uses memoryAccess
fsExists uses systemCalls
fsExists memoryHeap false
fsExists async false
fsExists maxRecursion none
fsExists label begin loopKind none
fsExists label begin within none
fsExists label giveNo loopKind none
fsExists label giveNo within none
fsExists label probe loopKind none
fsExists label probe within none
fsExists label probeLinux loopKind none
fsExists label probeLinux within none
fsExists label giveYesLinux loopKind none
fsExists label giveYesLinux within none
fsExists label probeWindows loopKind none
fsExists label probeWindows within none
fsExists label giveYes loopKind none
fsExists label giveYes within none
fsExists label sharingCheck loopKind none
fsExists label sharingCheck within none
fsExists label attributes loopKind none
fsExists label attributes within none
fsExists label giveYesAttributes loopKind none
fsExists label giveYesAttributes within none
fsExists let yes Bool true immutable
fsExists let zero Int64 0 immutable
fsExists let one Int64 1 immutable
fsExists let noAccess Int32 0 immutable
fsExists let sharingViolation Int32 32 immutable
fsExists let minusOne32 Int32 -1 immutable
fsExists at begin do readPath
fsExists at begin do readBytes
fsExists at begin do emptyCheck
fsExists at begin branch if empty goto giveNo else goto probe
fsExists at giveNo do storeNo
fsExists at giveNo return ok none
fsExists at probe do osCheck
fsExists at probe branch if onLinux goto probeLinux else goto probeWindows
fsExists at probeLinux do statIt
fsExists at probeLinux do statFailed
fsExists at probeLinux branch if missingLinux goto giveNo else goto giveYesLinux
fsExists at giveYesLinux do storeYesLinux
fsExists at giveYesLinux return ok none
fsExists at probeWindows do openIt
fsExists at probeWindows do invalidCheck
fsExists at probeWindows branch if invalid goto sharingCheck else goto giveYes
fsExists at giveYes do closeIt
fsExists at giveYes do storeYes
fsExists at giveYes return ok none
fsExists at sharingCheck do readCode
fsExists at sharingCheck do sharing
fsExists at sharingCheck branch if isSharing goto attributes else goto giveNo
fsExists at attributes do regularCheck
fsExists at attributes do wideName
fsExists at attributes do readAttributes
fsExists at attributes do giveName
fsExists at attributes do missingCheck
fsExists at attributes branch if missing goto giveNo else goto giveYesAttributes
fsExists at giveYesAttributes do storeYesAttributes
fsExists at giveYesAttributes return ok none

