# Regions (refined_region_new, _alloc, _remaining, _free): chunks of memory from VirtualAlloc,
# handed out by bumping, sixteen bytes aligned and zeroed, and given back all at once. A
# request past a region's capacity traps with the message `refined run` gives.
#
# This module is generated from tools/regions.dsl by tools/build.py.

regions is module
regions purpose "Regions: memory taken from the operating system in chunks, handed out by bumping, and returned all at once"
regions path regions
regions imports standard.machine
regions imports standard.system
regions imports standard.string
regions imports standard.math
regions imports standard.compare
regions imports standard.convert
regions imports standard.bits
regions imports standard.logic
regions imports standard.test
regions imports numbers
regions imports frames
regions exports newRegion
regions exports allocate
regions exports remaining
regions exports release
regions exports formatInteger

memoryAccess is capability
memoryAccess purpose "Authority to keep regions and their chunks in memory"
memoryAccess grants use machine.memory none

systemCalls is capability
systemCalls purpose "Authority to take memory from the operating system and give it back, and to end the process on a trap"
systemCalls grants use system.calls none

# A chunk is memory from VirtualAlloc: at 0 the next chunk of its region, 8 its size, 16 how many of its bytes are
# used, its own 32 bytes included; what it hands out starts at 32 and is zeroed. A region's header lives in its
# first chunk, after the chunk's own: at 0 its capacity, 8 the bytes asked of it (as `refined run` counts them),
# 16 the chunk being filled, 24 the address and 32 the length of its label, 40 how many chunks it has.
# A region's chunks of the standard size go back to a list of free chunks, zeroed, when it is released.
# machine.state bytes 128 to 191 belong to this module: 128 the first free chunk, 136 how many are free, 144 to
# 175 a number's digits.
chunkBytes is constant
chunkBytes purpose "The standard size of a chunk: VirtualAlloc's granularity"
chunkBytes type Int64
chunkBytes value 65536

chunkHead is constant
chunkHead purpose "The bytes at the start of a chunk that describe it"
chunkHead type Int64
chunkHead value 32

regionHead is constant
regionHead purpose "The bytes of a region's header, in its first chunk"
regionHead type Int64
regionHead value 64

keptChunks is constant
keptChunks purpose "How many free chunks are kept for the next regions"
keptChunks type Int64
keptChunks value 64

freeAt is constant
freeAt purpose "Where the first free chunk is kept, in machine.state"
freeAt type Int64
freeAt value 128

freeCountAt is constant
freeCountAt purpose "Where the number of free chunks is kept, in machine.state"
freeCountAt type Int64
freeCountAt value 136

digitsAt is constant
digitsAt purpose "Where a number's digits are put together, in machine.state"
digitsAt type Int64
digitsAt value 144

