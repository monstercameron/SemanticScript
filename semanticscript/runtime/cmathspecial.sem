# Special math functions of math.h in SemanticScript (generated from tools/cmathspecial.dsl by tools/build.py).

cmathspecial is module
cmathspecial purpose "The special functions of math.h in SemanticScript: sinh, cosh, tanh, asinh, acosh, atanh, erf, erfc, tgamma, and lgamma, for double and float, as glibc gives them in the C locale (D-153)"
cmathspecial path cmathspecial
cmathspecial imports standard.machine
cmathspecial imports standard.math
cmathspecial imports standard.compare
cmathspecial imports standard.convert
cmathspecial imports standard.bits
cmathspecial imports standard.logic
cmathspecial imports standard.test
cmathspecial imports kernel
cmathspecial imports clibrary
cmathspecial exports none

memoryAccess is capability
memoryAccess purpose "Authority to read and write the module's cells in machine.state"
memoryAccess grants use machine.memory none

# The cells of machine.state that belong to this module, bytes 24576 to 24831: 24576 the low half of the
# double-double a routine last gave, 24584 the power of two an exp left out of its result, 24592 the sign lgamma
# last gave as an int (what glibc keeps in `signgam`, which a C library cannot export as a data symbol here), 24600
# the sign lgamma's core left for its callers.
lowAt is constant
lowAt purpose "Where the low half of a double-double result is kept, in machine.state"
lowAt type Int64
lowAt value 24576

scaleAt is constant
scaleAt purpose "Where the power of two an exp leaves out of its result is kept, in machine.state"
scaleAt type Int64
scaleAt value 24584

signAt is constant
signAt purpose "Where the sign lgamma last gave, an int, is kept, in machine.state"
signAt type Int64
signAt value 24592

signWorkAt is constant
signWorkAt purpose "Where the sign the gamma core found is kept, in machine.state"
signWorkAt type Int64
signWorkAt value 24600

