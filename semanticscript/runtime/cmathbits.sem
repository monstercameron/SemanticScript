# ---------------------------------------------------------------- the floating-point environment (fenv.h)
#
# The hardware's own state, through machine.loadFloatControl and machine.storeFloatControl: on x86_64 MXCSR in the
# low 32 bits (flags IE 1, DE 2, ZE 4, OE 8, UE 16, PE 32; rounding control in bits 13 and 14), on AArch64 FPCR in
# the low and FPSR in the high 32 bits (flags IOC 1, DZC 2, OFC 4, UFC 8, IXC 16 in FPSR; RMode in FPCR bits 22
# and 23). glibc's FE_ constants are the target's own: x86_64 invalid 1, divide by zero 4, overflow 8, underflow 16,
# inexact 32 (FE_ALL_EXCEPT 0x3d: the denormal flag is not one of them), rounding to nearest 0, downward 0x400, upward
# 0x800, toward zero 0xc00; AArch64 1, 2, 4, 8, 16 (all 0x1f), and nearest 0, upward 0x400000, downward 0x800000,
# toward zero 0xc00000. Only the SSE state is mirrored on x86_64 (what compiled floating-point code uses); the x87
# status of fenv_t is written as a fresh x87 would have it and never read back.
flagConstant is operation
flagConstant purpose "The target's FE_ constant of a flag: 0 invalid, 1 divide by zero, 2 overflow, 3 underflow, 4 inexact"
flagConstant invariant none
flagConstant typeParameter none
flagConstant input kind Int64 copied
flagConstant output Int64
flagConstant outputOwnedBy none
flagConstant raises none
flagConstant effect use system.calls
flagConstant uses systemCalls
flagConstant memoryHeap false
flagConstant async false
flagConstant maxRecursion none
flagConstant label begin loopKind none
flagConstant label begin within none
flagConstant label arm loopKind none
flagConstant label arm within none
flagConstant label x86 loopKind none
flagConstant label x86 within none
flagConstant label invalid loopKind none
flagConstant label invalid within none
flagConstant label others loopKind none
flagConstant label others within none
flagConstant let one Int64 1 immutable
flagConstant let zero Int64 0 immutable
flagConstant at begin do readOnArm
flagConstant at begin branch if onArm goto arm else goto x86
flagConstant at arm do findArmCode1
flagConstant at arm return ok armCode
flagConstant at x86 do findCheck11
flagConstant at x86 branch if check1 goto invalid else goto others
flagConstant at invalid do findInvalidCode1
flagConstant at invalid return ok invalidCode
flagConstant at others do x86CodeStep1
flagConstant at others do findX86Code1
flagConstant at others return ok x86Code

