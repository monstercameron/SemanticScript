# Tests of the `values` module; generated from tools/values.dsl by tools/build.py. They run under
# `refined test`, where machine and system targets work in the JIT's own process.

valuesTest is test
valuesTest purpose "Values are held and given back with what they hold; arrays keep their items in order; objects keep their keys in first-put order, their last values, and find them by their bytes"
valuesTest verifies newValue startsHeld
valuesTest verifies retain countsHolder
valuesTest verifies release givesBackLast
valuesTest verifies appendItem appendsLast
valuesTest verifies findField findsKey
valuesTest verifies putField putsKey
valuesTest verifies decodeAt decodesStrictly
valuesTest typeParameter none
valuesTest input none
valuesTest output none
valuesTest outputOwnedBy none
valuesTest raises none
valuesTest effect use machine.memory
valuesTest effect use system.calls
valuesTest uses memoryAccess
valuesTest uses systemCalls
valuesTest memoryHeap false
valuesTest async false
valuesTest maxRecursion none
valuesTest label begin loopKind none
valuesTest label begin within none
valuesTest label eachItem loopKind while
valuesTest label eachItem within none
valuesTest label eachItem maxIterations hundred
valuesTest label addItem loopKind none
