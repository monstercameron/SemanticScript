# Tests of the `loader` module; generated from tools/loader.dsl by tools/build.py. They run under
# `refined test`, where machine and system targets work in the JIT's own process.

hashTest is test
hashTest purpose "The GNU and System V hashes of names are the ones linkers write"
hashTest verifies gnuHash hashesLikeGnu
hashTest verifies elfHash hashesLikeElf
hashTest typeParameter none
hashTest input none
hashTest output none
hashTest outputOwnedBy none
hashTest raises none
hashTest effect use machine.memory
hashTest uses memoryAccess
hashTest memoryHeap false
hashTest async false
hashTest maxRecursion none
hashTest label begin loopKind none
hashTest label begin within none
hashTest let printfName String "printf" immutable
hashTest let strlenName String "strlen" immutable
hashTest let six Int64 6 immutable
hashTest let printfGnuValue Int64 359345080 immutable
hashTest let zero Int64 0 immutable
hashTest let emptyGnuValue Int64 5381 immutable
hashTest let printfElfValue Int64 125371814 immutable
hashTest let strlenGnuValue Int64 479443869 immutable
hashTest let strlenElfValue Int64 128684734 immutable
hashTest at begin do findPrintf
hashTest at begin do gnuPrintf
hashTest at begin do expectGnuPrintf
hashTest at begin do gnuEmpty
hashTest at begin do expectGnuEmpty
hashTest at begin do elfPrintf
hashTest at begin do expectElfPrintf
hashTest at begin do findStrlen
hashTest at begin do gnuStrlen
hashTest at begin do expectGnuStrlen
hashTest at begin do elfStrlen
hashTest at begin do expectElfStrlen
hashTest at begin return ok none

