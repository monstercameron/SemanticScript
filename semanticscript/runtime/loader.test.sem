scopeTest label done loopKind none
scopeTest label done within none
scopeTest let strlenName String "strlen" immutable
scopeTest let missingPath String "/semanticscript/surely/missing/libnothing.so" immutable
scopeTest let six Int64 6 immutable
scopeTest let one Int64 1 immutable
