tokenTest is test
tokenTest purpose "wcstok skips leading delimiters, cuts at the next one, keeps its place in the cell it is given, and gives the address 0 when no token is left"
tokenTest verifies wcstok cutsTokens
tokenTest typeParameter none
tokenTest input none
tokenTest output none
tokenTest outputOwnedBy none
tokenTest raises none
tokenTest effect use machine.memory
tokenTest effect use system.calls
tokenTest uses memoryAccess
tokenTest uses systemCalls
tokenTest memoryHeap false
tokenTest async false
tokenTest maxRecursion none
tokenTest label begin loopKind none
tokenTest label begin within none
tokenTest let text1 String ",;" immutable
tokenTest let eight Int64 8 immutable
tokenTest let text2 String ",,a,b;;cc,," immutable
tokenTest let text3 String "a" immutable
tokenTest let sixteen Int64 16 immutable
tokenTest let text4 String "b" immutable
tokenTest let n28 Int64 28 immutable
tokenTest let text5 String "cc" immutable
tokenTest let text6 String ",;," immutable
tokenTest let text7 String "" immutable
tokenTest let text8 String "word" immutable
tokenTest let text9 String "word" immutable
tokenTest at begin do readNowhere
tokenTest at begin do readDelimiters
tokenTest at begin do readSave
tokenTest at begin do readText
