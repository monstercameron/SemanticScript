# threads.h for the runtime's C library, written in SemanticScript (D-166): C11 threads on Linux's own
# threads, mutexes, condition variables, thread-specific storage, and call_once.
#
# This module is generated from tools/cthreads.dsl by tools/build.py.

cthreads is module
cthreads purpose "threads.h for the runtime's C library: C11 threads on Linux's own threads (clone), mutexes, condition variables, thread-specific storage, and call_once, on futexes (D-166)"
cthreads path cthreads
cthreads imports standard.machine
cthreads imports standard.system
cthreads imports standard.math
