expectNumber outputOwnedBy none
expectNumber raises none
expectNumber effect use machine.memory
expectNumber uses memoryAccess
expectNumber memoryHeap false
expectNumber async false
expectNumber maxRecursion none
expectNumber label begin loopKind none
expectNumber label begin within none
expectNumber let none
expectNumber at begin do readValue
expectNumber at begin do sameCheck
expectNumber at begin do expectValue
expectNumber at begin do readLength
expectNumber at begin do expectLength
expectNumber at begin return ok none

