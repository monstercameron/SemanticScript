# Tests of the `bignum` module; generated from tools/bignum.dsl by tools/build.py. They run under
# `refined test`, where machine and system targets work in the JIT's own process.

# Tests keep their numbers in the last 4 KiB of machine.state, from byte 61440 (two numbers of 1,608 bytes).
expectNumber is operation
expectNumber purpose "A number's lowest 64 bits and its length are what is expected"
expectNumber invariant none
expectNumber typeParameter none
expectNumber input number machine.Address copied
expectNumber input value UInt64 copied
expectNumber input limbs Int64 copied
