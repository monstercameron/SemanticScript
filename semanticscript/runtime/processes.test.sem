# Tests of the `processes` module; generated from tools/processes.dsl by tools/build.py. They run under
# `refined test`, where machine and system targets work in the JIT's own process.

# Tests build a call's shape and slots in the last 4 KiB of machine.state: the shape from byte 61440, the
# arguments from 61952 (eight slots), the results from 62016, the payload at 62080.
testShape is operation
testShape purpose "Make the tests' shape from the slot counts of up to six parameters (0 for none) and give it"
testShape invariant none
testShape typeParameter none
testShape input first Int64 copied
testShape input second Int64 copied
testShape input third Int64 copied
testShape input fourth Int64 copied
testShape input fifth Int64 copied
testShape input sixth Int64 copied
testShape output machine.Address
testShape outputOwnedBy none
testShape raises none
testShape effect use machine.memory
testShape uses memoryAccess
testShape memoryHeap false
testShape async false
testShape maxRecursion none
testShape label begin loopKind none
testShape label begin within none
testShape label eachParam loopKind while
testShape label eachParam within none
testShape label eachParam maxIterations six
testShape label readCount loopKind none
testShape label readCount within eachParam
testShape label place loopKind none
testShape label place within eachParam
testShape label finish loopKind none
testShape label finish within none
testShape let at Int64 0 mutable
