# The process's entry point. An executable linked with this runtime has no C start-up code:
# the operating system calls refined_entry, which sets the stack floor, runs the program's
# entry operation, and ends the process with its exit code.
#
# This module is generated from tools/start.dsl by tools/build.py.

start is module
start purpose "The process's entry point: set the stack floor, run the program, and exit with its code"
start path start
start imports standard.machine
start imports standard.system
start imports standard.math
start exports none

memoryAccess is capability
memoryAccess purpose "Authority to find the stack and keep its floor in machine.state"
memoryAccess grants use machine.memory none

systemCalls is capability
systemCalls purpose "Authority to end the process with the program's exit code"
systemCalls grants use system.calls none

# The stack floor is in machine.state at byte 88 (frames' part of it). An executable's main thread has a stack of
# 256 MiB (native.py links it so); a recursive operation traps when its frame lies more than 248 MiB below the
# entry's, which leaves 8 MiB for the runtime and the operating system, as the C runtime's entry does.
floorAt is constant
floorAt purpose "Where the stack floor is kept, in machine.state"
floorAt type Int64
floorAt value 88

stackBudget is constant
stackBudget purpose "How far below the entry's frame the stack floor is: 256 MiB less 8 MiB"
stackBudget type Int64
stackBudget value 260046848

entry is operation
entry purpose "Start the process: set the stack floor, run the program's entry operation, and end the process with its exit code: refined_entry"
entry invariant none
entry typeParameter none
entry input none
entry output none
entry outputOwnedBy none
entry raises none
entry effect use machine.memory
entry effect use system.calls
entry uses memoryAccess
entry uses systemCalls
entry memoryHeap false
entry async false
entry maxRecursion none
entry abi c "refined_entry"
entry label begin loopKind none
entry label begin within none
entry let none
entry at begin do findHere
entry at begin do hereValue
entry at begin do findFloor
entry at begin do findState
entry at begin do findFloorSlot
entry at begin do storeFloor
entry at begin do run
entry at begin do exit
entry at begin return ok none

