memoryAccess is capability
memoryAccess purpose "Authority to keep whether an interrupt came in machine.state and read a call's slots"
memoryAccess grants use machine.memory none

systemCalls is capability
systemCalls purpose "Authority to install the interrupt handler, wake the scheduler, and end the process on a second interrupt"
systemCalls grants use system.calls none

# D-147: as `refined run` handles SIGINT for a program that reads `signal`: the first interrupt sets a flag the
# program reads (`signal.interrupted`) and ends a `signal.waitForInterrupt`, the second ends the process with exit
# code 130. A program that calls a signal target installs the handler before its entry runs (native.py calls
# `refined_signals_start` first, as the JIT installs its handler before it runs the program): on Windows a console
# control handler (SetConsoleCtrlHandler) for CTRL_C_EVENT only, as Python maps CTRL+C alone to SIGINT, called on a
# thread the system makes; on Linux an rt_sigaction handler for SIGINT, with SA_RESTART so reads and writes go on,
# and SA_RESTORER, its return through the runtime's rt_sigreturn trampoline. The handler counts a change in the
# scheduler's generation, so a task waiting for the interrupt goes on, and on Windows sets an event the scheduler's
# sleep also waits on (an interrupt cuts a Linux sleep short by itself, as the signal ends `poll`).
# machine.state bytes 1216 to 1247 belong to this module: 1216 whether an interrupt came, 1224 whether the handler
# is installed, 1232 the Windows event the scheduler waits on (tasks reads it there).
interruptedAt is constant
interruptedAt purpose "Where whether an interrupt came is kept, in machine.state"
interruptedAt type Int64
interruptedAt value 1216

installedAt is constant
installedAt purpose "Where whether the handler is installed is kept, in machine.state"
installedAt type Int64
installedAt value 1224

eventAt is constant
eventAt purpose "Where the Windows event an interrupt sets is kept, in machine.state"
eventAt type Int64
eventAt value 1232

generationAt is constant
generationAt purpose "Where the scheduler's generation is kept, in machine.state (the tasks module's)"
generationAt type Int64
generationAt value 472

timedOut is constant
timedOut purpose "signal.SignalError.timedOut, numbered from 1"
timedOut type Int32
timedOut value 1

cancelledError is constant
cancelledError purpose "signal.SignalError.cancelled, numbered from 1"
cancelledError type Int32
cancelledError value 2

