# The host library of a standalone executable: refined_host, which compiled code calls for every
# host target with a key `<target>|<slots per parameter>|<result slots>`, and the targets this
# runtime implements (the hostTargets table): byte buffers, maps (insertion order, text keys and
# values copied into the map's region), sets, string.fromBytes, and log lines, each as host.py
# and the C runtime do them.
#
# This module is generated from tools/host.dsl by tools/build.py.

host is module
host purpose "The host library of a standalone executable: refined_host and its targets (byte buffers, maps, sets, string.fromBytes, log lines)"
host path host
host imports standard.machine
host imports standard.system
host imports standard.string
host imports standard.math
host imports standard.compare
host imports standard.convert
host imports standard.bits
host imports standard.logic
host imports standard.list
host imports standard.test
host imports memory
host imports numbers
host imports output
host imports frames
host imports heap
host imports tables
host imports handles
host imports regions
host imports slots
host imports tasks
host imports files
host imports processes
host imports hashes
host exports hostCall
host exports utf8InvalidAt

memoryAccess is capability
memoryAccess purpose "Authority to read a host call's slots and keep the host's objects and call shapes in memory"
memoryAccess grants use machine.memory none

systemCalls is capability
systemCalls purpose "Authority to take memory for the host's objects, write log lines, and end the process on a trap"
systemCalls grants use system.calls none

# Compiled code calls every host target through refined_host with a key `<target>|<slots per parameter>|<result
# slots>`, its arguments' 64-bit slots, room for the result's slots, and a slot for an error's payload (codegen's
# host_call). The key is a constant of the program, so its address names it: its shape (the target's number in
# hostTargets, how many slots each parameter takes and where they start, how many result slots) is worked out once
# and kept by that address. A target gives 0, or an error's variant numbered from 1 with its payload stored.
# machine.state bytes 320 to 383 belong to this module: 320 the address of the table of shapes, 328 how many
# entries it has (a power of two, 0 before the first), 336 how many are taken, 344 to 359 a text key's copy, 360 a
# byte being appended, 368 to 383 unused; bytes 7936 to 8191 the digits of a number being appended.
# A shape is a heap block of shapeBytes: at 0 the key's address, 8 its length, 16 the target's number, 24 how many
# parameters, 32 how many result slots, from 40 each parameter's slot count, from 232 each parameter's first slot.
shapesAt is constant
shapesAt purpose "Where the address of the table of shapes is kept, in machine.state"
shapesAt type Int64
shapesAt value 320

shapesCapacityAt is constant
shapesCapacityAt purpose "Where the number of entries of the table of shapes is kept, in machine.state"
shapesCapacityAt type Int64
shapesCapacityAt value 328

shapesCountAt is constant
shapesCountAt purpose "Where the number of shapes kept is kept, in machine.state"
shapesCountAt type Int64
shapesCountAt value 336

keyCopyAt is constant
keyCopyAt purpose "Where a text key's copy in a collection's region is put together, in machine.state"
keyCopyAt type Int64
keyCopyAt value 344

byteAt is constant
byteAt purpose "Where a byte being appended to a buffer is put, in machine.state"
byteAt type Int64
byteAt value 360

digitsAt is constant
digitsAt purpose "Where the digits of a number being appended to a buffer are put, in machine.state"
digitsAt type Int64
digitsAt value 7936

shapeBytes is constant
shapeBytes purpose "The bytes of a shape"
shapeBytes type Int64
shapeBytes value 424

mostParameters is constant
mostParameters purpose "How many parameters a host call may have"
mostParameters type Int64
mostParameters value 24

kindBuffer is constant
kindBuffer purpose "The kind of a byte buffer's handle"
kindBuffer type Int64
kindBuffer value 3

kindMap is constant
kindMap purpose "The kind of a map's handle"
kindMap type Int64
kindMap value 4

kindSet is constant
kindSet purpose "The kind of a set's handle"
kindSet type Int64
kindSet value 5

utf8Invalid is constant
utf8Invalid purpose "string.Utf8Error.invalidAt, numbered from 1"
utf8Invalid type Int32
utf8Invalid value 1

keyMissing is constant
keyMissing purpose "map.KeyMissing.missing, numbered from 1"
keyMissing type Int32
keyMissing value 1

logFailed is constant
logFailed purpose "log.LogError.failed, numbered from 1"
logFailed type Int32
logFailed value 1

HostTarget is record
HostTarget purpose "A host target this runtime implements: its name, and the parameter a capability's scope limits (D-38), or -1"
