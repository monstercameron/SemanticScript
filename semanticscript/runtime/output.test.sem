# Tests of the `output` module; generated from tools/output.dsl by tools/build.py. They run under
# `refined test`, where machine and system targets work in the JIT's own process.

standardHandleTest is test
standardHandleTest purpose "Stream 2 is standard error and every other stream standard output"
standardHandleTest verifies standardHandle namesStream
standardHandleTest typeParameter none
standardHandleTest input none
standardHandleTest output none
standardHandleTest outputOwnedBy none
standardHandleTest raises none
standardHandleTest effect use machine.memory
standardHandleTest effect use system.calls
standardHandleTest uses memoryAccess
standardHandleTest uses systemCalls
standardHandleTest memoryHeap false
standardHandleTest async false
standardHandleTest maxRecursion none
standardHandleTest label begin loopKind none
standardHandleTest label begin within none
standardHandleTest label linuxHandles loopKind none
standardHandleTest label linuxHandles within none
standardHandleTest label windowsHandles loopKind none
standardHandleTest label windowsHandles within none
standardHandleTest let two Int32 2 immutable
standardHandleTest let one Int32 1 immutable
standardHandleTest let twoFd Int64 2 immutable
standardHandleTest let oneFd Int64 1 immutable
standardHandleTest let stdError Int32 -12 immutable
standardHandleTest let stdOutput Int32 -11 immutable
standardHandleTest at begin do findError
standardHandleTest at begin do findOutput
standardHandleTest at begin do osCheck
standardHandleTest at begin branch if onLinux goto linuxHandles else goto windowsHandles
standardHandleTest at linuxHandles do errorDescriptor
standardHandleTest at linuxHandles do expectErrorFd
standardHandleTest at linuxHandles do outputDescriptor
standardHandleTest at linuxHandles do expectOutputFd
standardHandleTest at linuxHandles return ok none
standardHandleTest at windowsHandles do findSystemError
standardHandleTest at windowsHandles do sameError
standardHandleTest at windowsHandles do expectError
standardHandleTest at windowsHandles do findSystemOutput
standardHandleTest at windowsHandles do sameOutput
standardHandleTest at windowsHandles do expectOutput
standardHandleTest at windowsHandles return ok none

