# Tests of the `tasks` module; generated from tools/tasks.dsl by tools/build.py. They run under
# `refined test`, where machine and system targets work in the JIT's own process.

# Tests build a call's shape and slots in the last 4 KiB of machine.state: the shape from byte 61440, the
# arguments from 61952, the results from 62016, the payload at 62080. They run on the main program's task: nothing
# here starts a fiber.
prepareShape is operation
prepareShape purpose "Make the tests' shape: a number of parameters, each of one slot but the one at a position, which has two"
prepareShape invariant none
prepareShape typeParameter none
prepareShape input params Int64 copied
prepareShape input wide Int64 copied
prepareShape output machine.Address
prepareShape outputOwnedBy none
prepareShape raises none
prepareShape effect use machine.memory
prepareShape uses memoryAccess
prepareShape memoryHeap false
prepareShape async false
prepareShape maxRecursion none
prepareShape label begin loopKind none
prepareShape label begin within none
prepareShape label eachParam loopKind while
prepareShape label eachParam within none
prepareShape label eachParam maxIterations params
prepareShape label setParam loopKind none
prepareShape label setParam within eachParam
prepareShape label twoSlots loopKind none
prepareShape label twoSlots within eachParam
prepareShape label oneSlot loopKind none
prepareShape label oneSlot within eachParam
prepareShape label advance loopKind none
prepareShape label advance within eachParam
prepareShape label finish loopKind none
prepareShape label finish within none
prepareShape let at Int64 0 mutable
prepareShape let start Int64 0 mutable
prepareShape let shapeAt Int64 61440 immutable
prepareShape let twentyFour Int64 24 immutable
prepareShape let two Int64 2 immutable
prepareShape let one Int64 1 immutable
prepareShape at begin do findState
prepareShape at begin do findShape
prepareShape at begin do storeParams
prepareShape at begin goto eachParam
prepareShape at eachParam do doneCheck
prepareShape at eachParam branch if done goto finish else goto setParam
prepareShape at setParam do wideCheck
prepareShape at setParam branch if isWide goto twoSlots else goto oneSlot
prepareShape at twoSlots do storeTwo
prepareShape at twoSlots goto advance
prepareShape at oneSlot do storeOne
prepareShape at oneSlot goto advance
prepareShape at advance do readCount
prepareShape at advance do moveStart
prepareShape at advance set start nextStart
prepareShape at advance do nextParam
prepareShape at advance set at after
prepareShape at advance goto eachParam
prepareShape at finish return ok shape

