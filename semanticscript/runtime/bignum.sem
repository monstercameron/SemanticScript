bignum exports compareNumbers
bignum exports addNumber
bignum exports subtractNumber
bignum exports multiplySmall
bignum exports addSmall
bignum exports shiftLeft
bignum exports shiftRightOne
bignum exports bitLength
bignum exports multiplyPowerOfTen
bignum exports lowLimbs

memoryAccess is capability
memoryAccess purpose "Authority to keep numbers in memory by address"
memoryAccess grants use machine.memory none

systemCalls is capability
systemCalls purpose "Authority to end the process when a number would not fit"
systemCalls grants use system.calls none

# A number is a block of numberBytes: at 0 how many 32-bit limbs it uses (0 for zero; the highest used limb is
# never 0), then the limbs from the lowest, each in 8 bytes as a UInt64 below 2^32, so a limb times a limb plus a
# carry fits in 64 bits. The caller gives the block; nothing here allocates.
limbCapacity is constant
limbCapacity purpose "How many limbs a number holds"
limbCapacity type Int64
limbCapacity value 200

numberBytes is constant
numberBytes purpose "The bytes of a number's block: its length and its limbs"
numberBytes type Int64
numberBytes value 1608

limbMask is constant
limbMask purpose "The bits of one limb"
limbMask type UInt64
limbMask value 4294967295

