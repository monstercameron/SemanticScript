# Tests of the `tables` module; generated from tools/tables.dsl by tools/build.py. They run under
# `refined test`, where machine and system targets work in the JIT's own process.

# Tests keep their table in the last 4 KiB of machine.state (from byte 61440), which the runtime's own state never
# reaches, and their keys after it, from byte 61568.
putNumber is operation
putNumber purpose "Insert a one-slot key into the test table unless it is there, and give its row"
putNumber invariant none
putNumber typeParameter none
putNumber input table machine.Address copied
putNumber input number Int64 copied
putNumber output Int64
putNumber outputOwnedBy none
putNumber raises none
putNumber effect use machine.memory
putNumber effect use system.calls
putNumber uses memoryAccess
putNumber uses systemCalls
putNumber memoryHeap false
putNumber async false
putNumber maxRecursion none
putNumber label begin loopKind none
putNumber label begin within none
putNumber label add loopKind none
putNumber label add within none
putNumber label known loopKind none
putNumber label known within none
putNumber let keyScratch Int64 61568 immutable
putNumber let zero Int64 0 immutable
putNumber let one Int64 1 immutable
