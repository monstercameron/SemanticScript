frontAt type Int64
frontAt value 26896

endCellAt is constant
endCellAt purpose "Where strtof reads the end of its number into, in machine.state"
endCellAt type Int64
endCellAt value 26904

wordsAt is constant
wordsAt purpose "Where rand's 31 words are kept, in machine.state"
wordsAt type Int64
wordsAt value 26912

lconvAt is constant
