# Tests of the `numbers` module; generated from tools/numbers.dsl by tools/build.py. They run under
# `refined test`, where machine and system targets work in the JIT's own process.

# Tests write in the last 4 KiB of machine.state (from byte 61440), which the runtime's own state never reaches.
expectDecimal is operation
expectDecimal purpose "Format a number in the tests' scratch bytes and compare the text with what is expected"
expectDecimal invariant none
expectDecimal typeParameter none
expectDecimal input value Int64 copied
expectDecimal input expected String borrowed
expectDecimal output none
expectDecimal outputOwnedBy none
expectDecimal raises none
expectDecimal effect use machine.memory
expectDecimal uses memoryAccess
expectDecimal memoryHeap false
expectDecimal async false
expectDecimal maxRecursion none
expectDecimal label begin loopKind none
expectDecimal label begin within none
expectDecimal let scratchAt Int64 61440 immutable
expectDecimal at begin do findState
expectDecimal at begin do findScratch
expectDecimal at begin do format
expectDecimal at begin do viewText
expectDecimal at begin do expectText
expectDecimal at begin return ok none

