memoryAccess is capability
memoryAccess purpose "Authority to read the text to write and to keep the count written in machine.state"
memoryAccess grants use machine.memory none

systemCalls is capability
systemCalls purpose "Authority to call the operating system's GetStdHandle, WriteFile, and GetLastError"
systemCalls grants use system.calls none

# machine.state bytes 0 to 63 belong to this module: 0 the count WriteFile wrote (a DWORD), 16 to 47 the digits
# and line end of a number being written.
writtenAt is constant
writtenAt purpose "Where WriteFile puts the count of bytes it wrote, in machine.state"
writtenAt type Int64
writtenAt value 0

digitsAt is constant
digitsAt purpose "Where a number's text is put together before it is written, in machine.state"
digitsAt type Int64
digitsAt value 16

