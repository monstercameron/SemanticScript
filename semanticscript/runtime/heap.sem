# Memory from the process heap (HeapAlloc, HeapReAlloc, HeapFree) for what grows and is given back
# piece by piece: the runtime's host objects, its tables, and the messages of its traps. Traps whose
# message is put together from parts end here too.
#
# This module is generated from tools/heap.dsl by tools/build.py.

heap is module
heap purpose "Memory that grows and is given back piece by piece, from the process heap, and traps whose message is put together from parts"
heap path heap
heap imports standard.machine
heap imports standard.system
heap imports standard.string
heap imports standard.math
heap imports standard.compare
heap imports standard.convert
heap imports standard.logic
heap imports standard.test
heap imports kernel
heap imports numbers
heap imports frames
heap exports take
heap exports resize
heap exports give
heap exports joinMessage
heap exports numbersMessage
heap exports startThreads
heap exports threaded

memoryAccess is capability
memoryAccess purpose "Authority to keep the process heap's handle in machine.state and to put a trap's message together"
memoryAccess grants use machine.memory none

systemCalls is capability
systemCalls purpose "Authority to take memory from the process heap, give it back, and end the process on a trap"
systemCalls grants use system.calls none

# machine.state bytes 192 to 255 belong to this module: 192 the process heap's handle (0 until it is first asked
# for), 200 to 231 a number's digits; on Linux, bytes 896 to 991: from 896 the first free block of each of nine
# sizes (16 bytes to 4 KiB), 976 the chunk small blocks are cut from and 984 how many of its bytes are left.
# D-140: Linux has no process heap, so the runtime keeps its own: a block has 32 bytes before it (0 how many bytes
# it holds, 8 how many bytes its mapping has, 0 for a small block, 16 how many bytes are in use); a small block of
# up to 4 KiB with its header is cut from a 64 KiB chunk of an anonymous mmap and goes back to the free list of
# its size; a larger one is a mapping of its own, unmapped when it is given back.
heapAt is constant
heapAt purpose "Where the process heap's handle is kept, in machine.state"
heapAt type Int64
heapAt value 192

digitsAt is constant
digitsAt purpose "Where a number's digits are put together for a trap's message, in machine.state"
digitsAt type Int64
digitsAt value 200

zeroMemory is constant
zeroMemory purpose "HEAP_ZERO_MEMORY: what HeapAlloc and HeapReAlloc hand out is zeroed"
zeroMemory type Int32
zeroMemory value 8

freeListsAt is constant
freeListsAt purpose "Where the first free block of each size is kept on Linux, in machine.state"
freeListsAt type Int64
freeListsAt value 896

chunkAt is constant
chunkAt purpose "Where the chunk small blocks are cut from is kept on Linux, in machine.state"
chunkAt type Int64
chunkAt value 976

chunkLeftAt is constant
chunkLeftAt purpose "Where how many bytes of that chunk are left is kept, in machine.state"
chunkLeftAt type Int64
chunkLeftAt value 984

blockHead is constant
blockHead purpose "The bytes before a block on Linux"
blockHead type Int64
blockHead value 32

largestSmall is constant
largestSmall purpose "The largest small block on Linux, its header included"
largestSmall type Int64
largestSmall value 4096

chunkSize is constant
chunkSize purpose "The bytes of a chunk small blocks are cut from on Linux"
chunkSize type Int64
chunkSize value 65536

pageBytes is constant
pageBytes purpose "The bytes of a page"
pageBytes type Int64
pageBytes value 4096

