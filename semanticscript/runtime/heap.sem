heap imports numbers
heap imports frames
heap exports take
heap exports resize
heap exports give
heap exports joinMessage
heap exports numbersMessage

memoryAccess is capability
memoryAccess purpose "Authority to keep the process heap's handle in machine.state and to put a trap's message together"
memoryAccess grants use machine.memory none

systemCalls is capability
systemCalls purpose "Authority to take memory from the process heap, give it back, and end the process on a trap"
systemCalls grants use system.calls none

# machine.state bytes 192 to 255 belong to this module: 192 the process heap's handle (0 until it is first asked
# for), 200 to 231 a number's digits.
heapAt is constant
heapAt purpose "Where the process heap's handle is kept, in machine.state"
heapAt type Int64
heapAt value 192

digitsAt is constant
digitsAt purpose "Where a number's digits are put together for a trap's message, in machine.state"
digitsAt type Int64
digitsAt value 200

zeroMemory is constant
zeroMemory purpose "HEAP_ZERO_MEMORY: what HeapAlloc and HeapReAlloc hand out is zeroed"
zeroMemory type Int32
zeroMemory value 8

