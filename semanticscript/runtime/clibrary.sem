classBits at begin do negativeCheck
classBits at begin branch if negative goto giveNoClass else goto tabCheck
classBits at tabCheck do belowTab
classBits at tabCheck branch if control1 goto giveControl else goto isTab
classBits at isTab do tabSame
classBits at isTab branch if tabbed goto giveTab else goto spaces
classBits at giveTab return ok tabBits
classBits at spaces do belowShift
classBits at spaces branch if whiteControl goto giveWhite else goto controls
classBits at giveWhite return ok whiteBits
classBits at controls do belowSpace
classBits at controls branch if control2 goto giveControl else goto spaceCheck
classBits at spaceCheck do spaceSame
classBits at spaceCheck branch if spaced goto giveSpace else goto punctuation1
classBits at giveSpace return ok spaceBits
classBits at punctuation1 do belowDigits
classBits at punctuation1 branch if punct1 goto givePunctuation else goto digits
classBits at digits do belowColon
classBits at digits branch if digit goto giveDigit else goto punctuation2
classBits at giveDigit return ok digitBits
classBits at punctuation2 do belowCapitals
classBits at punctuation2 branch if punct2 goto givePunctuation else goto upperHex
classBits at upperHex do belowG
classBits at upperHex branch if upperHexDigit goto giveUpperHex else goto upper
classBits at giveUpperHex return ok upperHexBits
classBits at upper do belowBracket
classBits at upper branch if upperLetter goto giveUpper else goto punctuation3
classBits at giveUpper return ok upperBits
classBits at punctuation3 do belowSmall
classBits at punctuation3 branch if punct3 goto givePunctuation else goto lowerHex
classBits at lowerHex do belowSmallG
classBits at lowerHex branch if lowerHexDigit goto giveLowerHex else goto lower
classBits at giveLowerHex return ok lowerHexBits
classBits at lower do belowBrace
classBits at lower branch if lowerLetter goto giveLower else goto punctuation4
classBits at giveLower return ok lowerBits
classBits at punctuation4 do belowDelete
classBits at punctuation4 branch if punct4 goto givePunctuation else goto deleteCheck
classBits at deleteCheck do deleteSame
classBits at deleteCheck branch if deleted goto giveControl else goto giveNoClass
classBits at givePunctuation return ok punctuation
classBits at giveControl return ok control
classBits at giveNoClass return ok noClass

