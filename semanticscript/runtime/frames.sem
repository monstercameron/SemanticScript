# The shadow call stack every compiled operation pushes and pops, the depth counters of
# recursive operations and the stack floor, and traps: refined_trap writes `trap: <message>`
# and the call stack to standard error exactly as `refined run` does, then ends the process
# with exit code 70.
#
# This module is generated from tools/frames.dsl by tools/build.py.

frames is module
frames purpose "The call stack a trap prints, recursion depth and the stack floor, and traps"
frames path frames
frames imports standard.machine
frames imports standard.system
frames imports standard.string
frames imports standard.math
frames imports standard.compare
frames imports standard.convert
frames imports standard.logic
frames imports standard.test
frames imports kernel
frames imports memory
frames imports numbers
frames imports output
frames exports pushFrame
frames exports popFrame
frames exports report
frames exports holdResource
frames exports letGoResource

memoryAccess is capability
memoryAccess purpose "Authority to keep the call stack and the depth counters in memory"
memoryAccess grants use machine.memory none

systemCalls is capability
systemCalls purpose "Authority to write a trap's report, take memory for the call stack, and end the process"
systemCalls grants use system.calls none

# machine.state bytes 64 to 127 belong to this module: 64 the address of the call stack's table, 72 how many
# frames are on it, 80 how many the table holds, 88 the stack floor (set by `start`), 96 to 127 the digits of a
# count being written; bytes 8192 to 40959 are the depth counters of 4096 recursive operations (the main
# program's: a task's are in a heap block of the same size, whose address the tasks module puts at 392 while the
# task runs); bytes 384 to 447: 384 not 0 while a task runs, 392 the address of the running task's depth counters
# (0 for the main program's), 400 the address of the table of resources a trap releases (D-51), 408 how many it
# holds, 416 how many it has room for. A resource is 16 bytes: its kind (1 an open file, 2 a running child
# process), then the operating system's handle.
framesAt is constant
framesAt purpose "Where the address of the call stack's table is kept, in machine.state"
framesAt type Int64
framesAt value 64

countAt is constant
countAt purpose "Where the number of frames on the call stack is kept, in machine.state"
countAt type Int64
countAt value 72

capacityAt is constant
capacityAt purpose "Where the number of frames the table holds is kept, in machine.state"
capacityAt type Int64
capacityAt value 80

floorAt is constant
floorAt purpose "Where the stack floor is kept, in machine.state: an address below which a recursive operation traps, or 0"
floorAt type Int64
floorAt value 88

digitsAt is constant
digitsAt purpose "Where a count's digits are put together, in machine.state"
digitsAt type Int64
digitsAt value 96

depthsAt is constant
depthsAt purpose "Where the depth counters start, in machine.state: one Int64 per recursive operation, by the number the compiler gives it"
depthsAt type Int64
depthsAt value 8192

depthCount is constant
depthCount purpose "How many recursive operations have a depth counter"
depthCount type Int64
depthCount value 4096

inTaskAt is constant
inTaskAt purpose "Where whether a task is running is kept, in machine.state: not 0 while one is"
inTaskAt type Int64
inTaskAt value 384

depthTableAt is constant
depthTableAt purpose "Where the address of the running task's depth counters is kept, in machine.state: 0 for the main program's"
depthTableAt type Int64
depthTableAt value 392

resourcesAt is constant
resourcesAt purpose "Where the address of the table of resources a trap releases is kept, in machine.state"
resourcesAt type Int64
resourcesAt value 400

resourceCountAt is constant
resourceCountAt purpose "Where the number of resources held is kept, in machine.state"
resourceCountAt type Int64
resourceCountAt value 408

resourceCapacityAt is constant
resourceCapacityAt purpose "Where the number of resources the table has room for is kept, in machine.state"
resourceCapacityAt type Int64
resourceCapacityAt value 416

frameBytes is constant
frameBytes purpose "The size of a frame in the table: the address of the operation's name, then the name's length"
frameBytes type Int64
frameBytes value 16

firstCapacity is constant
firstCapacity purpose "How many frames the table holds when it is first made; it doubles when full"
firstCapacity type Int64
firstCapacity value 4096

shownRuns is constant
shownRuns purpose "How many lines of the call stack a trap prints before saying how many more there are"
shownRuns type Int64
shownRuns value 12

