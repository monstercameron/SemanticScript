ffiBind at begin do builtInCheck
ffiBind at begin branch if isBuiltIn goto bindBuiltIn else goto loadedCheck
ffiBind at bindBuiltIn do lookUpIt
ffiBind at bindBuiltIn do builtInValue
ffiBind at bindBuiltIn set address builtInAddress
ffiBind at bindBuiltIn goto found
ffiBind at loadedCheck do loadedSame
ffiBind at loadedCheck branch if isLoaded goto bindLoaded else goto bindWindows
ffiBind at bindLoaded do symbolIt
ffiBind at bindLoaded do loadedValue
ffiBind at bindLoaded set address loadedAddress
ffiBind at bindLoaded goto found
ffiBind at bindWindows do copyName
ffiBind at bindWindows do findIt
ffiBind at bindWindows do giveName
ffiBind at bindWindows do functionValue
ffiBind at bindWindows set address windowsAddress
ffiBind at bindWindows goto found
ffiBind at found do missingCheck
ffiBind at found branch if missing goto refuse else goto give
ffiBind at refuse do status
ffiBind at refuse return ok status1
ffiBind at give do storeAddress
ffiBind at give return ok ok

