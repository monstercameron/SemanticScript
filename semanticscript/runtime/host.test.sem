# Tests of the `host` module; generated from tools/host.dsl by tools/build.py. They run under
# `refined test`, where machine and system targets work in the JIT's own process.

# Tests keep a call's slots in the last 4 KiB of machine.state: its arguments from byte 61440, its results from
# 61568, its error's payload at 61632, and bytes to read from 61696. Each key is a constant of the test, so its
# address names it as a compiled program's keys do.
slotAt is operation
slotAt purpose "The address of a slot of the tests' scratch: arguments from 0, results from 16, the payload at 24, bytes from 32"
slotAt invariant none
slotAt typeParameter none
slotAt input slot Int64 copied
slotAt output machine.Address
slotAt outputOwnedBy none
slotAt raises none
slotAt effect use machine.memory
slotAt uses memoryAccess
slotAt memoryHeap false
slotAt async false
slotAt maxRecursion none
slotAt label begin loopKind none
slotAt label begin within none
slotAt let eight Int64 8 immutable
slotAt let scratchAt Int64 61440 immutable
slotAt at begin do findState
slotAt at begin do slotBytes
slotAt at begin do startOf
slotAt at begin do findSlot
slotAt at begin return ok place

