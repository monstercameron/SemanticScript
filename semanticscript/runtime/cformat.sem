flagHash type Int64
flagHash value 8

flagZero is constant
flagZero purpose "The `0` flag"
flagZero type Int64
flagZero value 16

overflowError is constant
overflowError purpose "EOVERFLOW: the text written passes INT_MAX bytes"
overflowError type Int32
