# Text for the operating system: UTF-8 to UTF-16 and back, lower case as Python's normcase gives it,
# text put together piece by piece, and text in byte order.
#
# This module is generated from tools/wide.dsl by tools/build.py.

wide is module
wide purpose "Text for the operating system: UTF-8 to UTF-16 and back, lower case as Python's normcase, text put together piece by piece, and text in order"
wide path wide
wide imports standard.machine
wide imports standard.system
wide imports standard.string
wide imports standard.math
wide imports standard.compare
wide imports standard.convert
wide imports standard.logic
wide imports standard.test
wide imports heap
wide exports widen
wide exports narrow
wide exports wideUnits
wide exports lowercase
wide exports builderNew
wide exports builderAdd
wide exports builderAddByte
wide exports builderText
wide exports builderLength
wide exports textOrder

memoryAccess is capability
memoryAccess purpose "Authority to read and write text in memory"
memoryAccess grants use machine.memory none

systemCalls is capability
systemCalls purpose "Authority to convert text with MultiByteToWideChar, WideCharToMultiByte, and LCMapStringEx, and take memory for it"
systemCalls grants use system.calls none

# The operating system's names (paths, the environment, command lines) are UTF-16; the program's text is UTF-8.
# Both conversions are kernel32's (code page 65001), and lower case is LCMapStringEx with the invariant locale,
# which is what Python's os.path.normcase uses on Windows.
# machine.state bytes 640 to 703 belong to this module: 640 the invariant locale's name, the empty text (always 0).
# A builder (a heap block of 24 bytes): 0 the address of its bytes (a heap block), 8 how many, 16 how many the
# block holds.
localeAt is constant
localeAt purpose "Where the invariant locale's name, the empty UTF-16 text, is, in machine.state"
localeAt type Int64
localeAt value 640

utf8 is constant
utf8 purpose "The UTF-8 code page"
utf8 type Int32
utf8 value 65001

lowercaseFlag is constant
lowercaseFlag purpose "LCMAP_LOWERCASE"
lowercaseFlag type Int32
lowercaseFlag value 256

