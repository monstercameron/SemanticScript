# standard.log.semsig — structured-logging contract (README ss26/ss27,
# X-043). The append-only JSON-per-line audit log runtime is backed by
# ss_log_* native bindings. This records the typed surface the ported
# apps/taskforge-web invokes (server start, auth, todo-mutation audit records).

logSig is semsig
logSig version "1.0"
logSig generatedBy "semanticscript 0.1"
logSig describes standard.log

openLogFile is intrinsic
openLogFile target log.openLogFile
openLogFile arg filePath String
openLogFile out status Int32
openLogFile purpose "Open (append-mode) the structured-log file at a confined relative path; returns 0 on success"

logInfo is intrinsic
logInfo target log.logInfo
logInfo arg messageText String
logInfo out status Int32
logInfo purpose "Append one INFO-level structured-log record"

logWarn is intrinsic
logWarn target log.logWarn
logWarn arg messageText String
logWarn out status Int32
logWarn purpose "Append one WARN-level structured-log record"
