# standard.net.semsig — generated signature sidecar (README ss26, ss27).
# R-062: socket/network-client lowering is runtime-backed. The low-level
# net.connect/send/receive/close surface is backed by ss_net sockets, and the
# high-level net.fetchText surface is backed by the same runtime's HTTP client.

netSig is semsig
netSig version "1.0"
netSig generatedBy "semanticscript 0.1"
netSig describes standard.net

NetEndpoint is alias
NetEndpoint for String
NetEndpoint purpose "A host:port endpoint string for a network connection"

NetSocket is alias
NetSocket for OpaquePointer
NetSocket purpose "An opaque connected-socket handle, released by netClose"

NetError is error
NetError purpose "Represent connect/send/receive/close failures"

netConnect is intrinsic
netConnect target net.connect
netConnect arg endpoint NetEndpoint
netConnect out socket NetSocket
netConnect catch NetError
netConnect owns socket cleanedBy net.close
netConnect async yes
netConnect purpose "Open a client connection to an endpoint (capability-gated network effect)"

netSend is intrinsic
netSend target net.send
netSend arg socket NetSocket
netSend arg payload String
netSend out sent Int64
netSend catch NetError
netSend purpose "Send bytes over a connected socket"

netReceive is intrinsic
netReceive target net.receive
netReceive arg socket NetSocket
netReceive out received String
netReceive catch NetError
netReceive owns received cleanedBy net.freeTextBody
netReceive async yes
netReceive purpose "Receive bytes from a connected socket"

netClose is intrinsic
netClose target net.close
netClose arg socket NetSocket
netClose out closed Int32
netClose purpose "Close a connected socket"

# ---- high-level HTTP client surface (net.fetchText) ----
# The async outbound text-fetch client the ported apps/taskforge-api-client
# uses. The current native client is HTTP-only; HTTPS/TLS must reject at check
# time until a TLS backend is added.

Url is alias
Url for String
Url purpose "An absolute http:// URL to fetch with the current native client"

HttpClientBodyText is alias
HttpClientBodyText for String
HttpClientBodyText purpose "A heap-owned response body copy, released by net.freeTextBody"

NetworkTimeoutMilliseconds is alias
NetworkTimeoutMilliseconds for Int64
NetworkTimeoutMilliseconds purpose "A per-request timeout budget in milliseconds"

ResponseBodyLimitBytes is alias
ResponseBodyLimitBytes for Int64
ResponseBodyLimitBytes purpose "The maximum response body size accepted, in bytes"

HttpRedirectLimit is alias
HttpRedirectLimit for Int64
HttpRedirectLimit purpose "The maximum number of redirects followed"

HttpRequestPolicy is record
HttpRequestPolicy field timeoutMillis NetworkTimeoutMilliseconds
HttpRequestPolicy field maxBodyBytes ResponseBodyLimitBytes
HttpRequestPolicy field redirectLimit HttpRedirectLimit
HttpRequestPolicy purpose "Per-request transport policy (timeout, body limit, redirect limit)"

HttpGetRequest is record
HttpGetRequest field url Url
HttpGetRequest field policy HttpRequestPolicy
HttpGetRequest purpose "An outbound GET request: a URL plus its transport policy"

HttpTextResponse is record
HttpTextResponse field body HttpClientBodyText
HttpTextResponse purpose "A fetched text response carrying the heap-owned body copy"

fetchText is intrinsic
fetchText target net.fetchText
fetchText arg request HttpGetRequest
fetchText out response HttpTextResponse
fetchText async yes
fetchText purpose "Fetch an HTTP URL and return its text response"

freeTextBody is intrinsic
freeTextBody target net.freeTextBody
freeTextBody arg body HttpClientBodyText
freeTextBody out freed Int32
freeTextBody purpose "Release a response body copy returned by net.fetchText"
