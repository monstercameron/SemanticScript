# standard.sqlite.semsig — generated signature sidecar (README ss26).
# Header entity + intrinsic signatures (target/arg/out/catch/async/owns).
# (todos WS3-050/051/052)

sqliteSig is semsig
sqliteSig version "1.0"
sqliteSig generatedBy "semanticscript 0.1"
sqliteSig describes standard.sqlite

SqlText is alias
SqlText for String
SqlText typeTrust validated
SqlText purpose "A SQL statement string that is intended for sqlite.* interpreter calls"

SqliteDatabase is alias
SqliteDatabase for Int64
SqliteDatabase purpose "Opaque sqlite database handle"

SqliteStatement is alias
SqliteStatement for Int64
SqliteStatement purpose "Opaque sqlite prepared-statement handle"

SqliteStepResult is alias
SqliteStepResult for Int32
SqliteStepResult purpose "Raw sqlite3_step status code"

SqliteOpenMode is enum
SqliteOpenMode variant readOnly
SqliteOpenMode variant readWrite
SqliteOpenMode variant readWriteCreate
SqliteOpenMode repr readOnly 1
SqliteOpenMode repr readWrite 2
SqliteOpenMode repr readWriteCreate 6
SqliteOpenMode purpose "SQLite open flags: read-only, read-write, or read-write-create"

openDatabase is intrinsic
openDatabase target sqlite.openDatabase
openDatabase arg path String
openDatabase arg mode SqliteOpenMode
openDatabase out SqliteDatabase
openDatabase catch SqliteDatabaseOpenFailure
openDatabase async no
openDatabase owns SqliteDatabase
openDatabase cleanedBy sqlite.closeDatabase
openDatabase purpose "Open (or create) a sqlite database handle"

closeDatabase is intrinsic
closeDatabase target sqlite.closeDatabase
closeDatabase arg database SqliteDatabase
closeDatabase catch SqliteDatabaseCloseFailure
closeDatabase async no
closeDatabase purpose "Close a sqlite database handle opened by sqlite.openDatabase"
