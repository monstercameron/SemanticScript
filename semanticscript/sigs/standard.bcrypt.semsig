# standard.bcrypt.semsig — password-hashing + CSPRNG contract
# (README ss26/ss27, X-043). The bcrypt runtime is backed by the vendored
# third_party/bcrypt implementation plus the native_platform CSPRNG. This
# records the typed surface the ported apps/taskforge-web invokes
# (register/login auth + session-token minting), so app code type-resolves
# against the ss_bcrypt_*/ss_random_*/ss_base64url_* native bindings.

bcryptSig is semsig
bcryptSig version "1.0"
bcryptSig generatedBy "semanticscript 0.1"
bcryptSig describes standard.bcrypt

BcryptCost is alias
BcryptCost for Int32
BcryptCost purpose "The bcrypt cost factor (work exponent); 12 is the recommended default"

hashPassword is intrinsic
hashPassword target bcrypt.hashPassword
hashPassword arg plaintext String
hashPassword arg cost Int32
hashPassword arg outBuffer OpaquePointer
hashPassword arg outCapacity Int32
hashPassword out status Int32
hashPassword purpose "Hash a plaintext password into a 60-char $2b$ bcrypt string; returns 0 on success"

verifyPassword is intrinsic
verifyPassword target bcrypt.verifyPassword
verifyPassword arg plaintext String
verifyPassword arg expectedHash String
verifyPassword out result Int32
verifyPassword purpose "Constant-time verify of a plaintext password against a stored bcrypt hash"

randomBytes is intrinsic
randomBytes target bcrypt.randomBytes
randomBytes arg outBuffer OpaquePointer
randomBytes arg byteCount Int32
randomBytes out status Int32
randomBytes purpose "Fill a buffer with bytes from the platform CSPRNG; returns 0 on success"

base64UrlEncode is intrinsic
base64UrlEncode target bcrypt.base64UrlEncode
base64UrlEncode arg inputBuffer OpaquePointer
base64UrlEncode arg inputCount Int32
base64UrlEncode arg outputBuffer OpaquePointer
base64UrlEncode arg outputCapacity Int32
base64UrlEncode arg outputLengthOut OpaquePointer
base64UrlEncode out status Int32
base64UrlEncode purpose "base64url-encode bytes (no padding) into a caller buffer, writing the length out"
