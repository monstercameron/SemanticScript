{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SemanticScript",
  "scopeName": "source.semanticscript",
  "comment": "Generated by `refined grammar --textmate` from semanticscript/compiler/refined/shapes.py.",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#entity"
    },
    {
      "include": "#step"
    },
    {
      "include": "#label"
    },
    {
      "include": "#fact"
    },
    {
      "include": "#string"
    },
    {
      "include": "#literal"
    },
    {
      "include": "#word"
    },
    {
      "include": "#type"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.semanticscript",
      "match": "(?:^|(?<=[ \\t]))#.*$"
    },
    "string": {
      "name": "string.quoted.double.semanticscript",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.semanticscript",
          "match": "\\\\(?:[\"\\\\nt]|x[0-9A-Fa-f]{2})"
        }
      ]
    },
    "entity": {
      "match": "^([A-Za-z][A-Za-z0-9]*)[ \\t]+(is)[ \\t]+(operationInstance|operationType|typeInstance|capability|operation|taskGroup|cleanup|project|module|record|region|alias|table|call|enum|task|test)\\b",
      "captures": {
        "1": {
          "name": "entity.name.semanticscript"
        },
        "2": {
          "name": "keyword.other.semanticscript"
        },
        "3": {
          "name": "storage.type.semanticscript"
        }
      }
    },
    "step": {
      "match": "^([a-z][A-Za-z0-9]*)[ \\t]+(at)[ \\t]+([a-z][A-Za-z0-9]*)[ \\t]+(awaitSlot|branch|cancel|return|defer|match|start|case|goto|join|set|do)\\b",
      "captures": {
        "1": {
          "name": "variable.other.subject.semanticscript"
        },
        "2": {
          "name": "keyword.other.semanticscript"
        },
        "3": {
          "name": "entity.name.label.semanticscript"
        },
        "4": {
          "name": "keyword.control.semanticscript"
        }
      }
    },
    "label": {
      "match": "^([a-z][A-Za-z0-9]*)[ \\t]+(label)[ \\t]+([a-z][A-Za-z0-9]*)[ \\t]+(maxIterations|rationale|loopKind|counter|purpose|within|note|over|risk|todo)\\b",
      "captures": {
        "1": {
          "name": "variable.other.subject.semanticscript"
        },
        "2": {
          "name": "keyword.other.semanticscript"
        },
        "3": {
          "name": "entity.name.label.semanticscript"
        },
        "4": {
          "name": "keyword.other.semanticscript"
        }
      }
    },
    "fact": {
      "match": "^([A-Za-z][A-Za-z0-9]*)[ \\t]+(invokesReference|standardLibrary|includesModule|outputOwnedBy|typeParameter|instantiates|maxRecursion|deprecated|memoryHeap|suppresses|cleanedBy|invariant|rationale|argument|language|maxBytes|maxTasks|released|requires|strategy|verifies|aliasOf|borrows|exports|imports|indexes|invokes|onError|ownedBy|purpose|rowType|variant|version|allows|cleans|effect|grants|output|raises|result|target|async|catch|entry|field|input|label|cell|note|path|risk|runs|todo|uses|let|row|at|in)\\b",
      "captures": {
        "1": {
          "name": "variable.other.subject.semanticscript"
        },
        "2": {
          "name": "keyword.other.semanticscript"
        }
      }
    },
    "literal": {
      "patterns": [
        {
          "name": "constant.language.semanticscript",
          "match": "\\b(?:unbounded|caller|static|begin|false|unset|none|true)\\b"
        },
        {
          "name": "constant.numeric.semanticscript",
          "match": "(?<![A-Za-z0-9.])-?[0-9]+(?:\\.[0-9]+)?\\b"
        }
      ]
    },
    "word": {
      "name": "keyword.operator.semanticscript",
      "match": "(?<![A-Za-z0-9.])(?:borrowedMutable|atProcessExit|concurrency|lendMutable|immutable|readWrite|atReturn|borrowed|security|suppress|connect|console|counted|doWhile|failure|forEach|forever|ifError|library|mutable|refined|copied|ifNext|listen|memory|timing|arena|error|owned|plain|spawn|while|write|bind|copy|data|else|give|goto|into|lend|load|read|trap|any|if|ok)\\b"
    },
    "type": {
      "name": "entity.name.type.semanticscript",
      "match": "\\b(?:[a-z][A-Za-z0-9]*\\.)?[A-Z][A-Za-z0-9]*(?:\\.[a-z][A-Za-z0-9]*)?\\b"
    }
  }
}
