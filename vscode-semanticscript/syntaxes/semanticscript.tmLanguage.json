{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SemanticScript",
  "scopeName": "source.semanticscript",
  "patterns": [
    {
      "include": "#htmlBody"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#declarationVerbs"
    },
    {
      "include": "#contextVerbs"
    },
    {
      "include": "#actionVerbs"
    },
    {
      "include": "#controlVerbs"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#primitiveTargets"
    },
    {
      "include": "#generatedTargets"
    },
    {
      "include": "#domainTargets"
    },
    {
      "include": "#errorVariants"
    },
    {
      "include": "#schemaValues"
    },
    {
      "include": "#qualifiedNames"
    },
    {
      "include": "#types"
    },
    {
      "include": "#symbols"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.semanticscript",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.semanticscript",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.semanticscript",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "htmlBody": {
      "patterns": [
        {
          "name": "meta.embedded.block.html.semanticscript",
          "begin": "^(\\s*)(htmlBody)\\b.*$",
          "beginCaptures": {
            "2": {
              "name": "keyword.context.semanticscript"
            }
          },
          "end": "^(?=\\S)",
          "patterns": [
            {
              "include": "#htmlArgHoles"
            },
            {
              "name": "constant.other.html-doctype.semanticscript",
              "match": "<!doctype\\s+html>"
            },
            {
              "name": "entity.name.tag.html.semanticscript",
              "match": "</?\\s*([A-Za-z][A-Za-z0-9:-]*)\\b"
            },
            {
              "name": "entity.other.attribute-name.html.semanticscript",
              "match": "\\b([A-Za-z_:][A-Za-z0-9_:.:-]*)\\s*="
            },
            {
              "name": "string.quoted.double.html.semanticscript",
              "begin": "\"",
              "end": "\"",
              "patterns": [
                {
                  "include": "#htmlArgHoles"
                }
              ]
            }
          ]
        }
      ]
    },
    "htmlArgHoles": {
      "patterns": [
        {
          "name": "variable.other.html-arg.semanticscript",
          "match": "\\{\\s*(htmlArg)\\.([A-Za-z_][A-Za-z0-9_]*)\\s*\\}",
          "captures": {
            "1": {
              "name": "entity.name.namespace.semanticscript"
            },
            "2": {
              "name": "variable.parameter.html-arg.semanticscript"
            }
          }
        }
      ]
    },
    "declarationVerbs": {
      "patterns": [
        {
          "name": "keyword.declaration.semanticscript",
          "match": "^(\\s*)(section|project|target|runtime|entry|module|mode|buildProject|modulePath|languageVersion|projectVersion|projectLicense|sourceRoot|registerModule|mainFile|mainOperation|testPattern|testRoot|dependencySource|dependencyFetch|dependencyCache|dependencyLock|dependencyIntegrity|targetRuntime|buildProfile|runtimeChecks|optLevel|persistLlvmIr|emitLlvmIr|llvmIrOutput|emitOptimizedLlvmIr|optimizedLlvmIrOutput|buildDir|buildRoot|buildFolderName|cpuBaseline|cpuTune|cpuFeature|cpuFeatureCheck|nativeOutput|nativeHttpHost|nativeHttpPort|formatterSetting|linterSetting|docsOutput|comptimeOperation|moduleFolder|modulePurpose|moduleOwns|moduleDoesNotOwn|moduleDependency|moduleWarning|moduleInvariant|moduleSecurity|moduleObservability|exportType|exportError|exportOperation|exportCapability|exportConstant|version|publisher|description|copyright|productName|internalName|originalFilename|trademark|comments|metadata|dependency|dependencyEffect|dependencyExports|dependencyFunction|dependencyFunctionInput|dependencyFunctionOutput|dependencyFunctionEffect|dependencyFunctionAsync|importModule|importOperation|importType|importError|importCapability|importConstant|type|typeParameter|typeInvariant|typeRepresentation|typeTrust|typeMemory|typeLayout|typeLiteralEncoding|typeLiteralTerminator|record|recordLayout|recordAlign|field|fieldDefault|fieldInvariant|enum|enumCase|error|errorCase|operation|webServer|serverHost|serverPort|route|routeTimeout|routeMiddleware|routeTimeoutOptOut|routeMiddlewareOptOut|guiApplication|guiApplicationTitle|guiApplicationIcon|guiApplicationMainWindow|guiApplicationOnExit|guiWindow|guiWindowApplication|guiWindowTitle|guiWindowWidth|guiWindowHeight|guiWindowMinimumWidth|guiWindowMinimumHeight|guiWindowLayout|guiWindowResizable|guiWindowEvent|guiButton|guiTextBox|guiListBox|guiCheckBox|guiMenuItem|guiStatusBar|guiTextLabel|guiControlWindow|guiControlEnabled|guiControlVisible|guiControlTabIndex|guiControlAccessibleName|guiControlEvent|guiButtonText|guiButtonIsDefault|guiTextBoxPlaceholder|guiTextBoxMaxLength|guiListBoxSelectionMode|guiCheckBoxChecked|guiTextLabelText|storage|sharedState|domainLiteral|literal|listLiteral|htmlTemplate|jsonCodec|policy|errorPolicy|validator|codec|schema|unknownFields|resource|resourceKey|resourceValue|resourceKind|adapter|boundary|mapper|retryPolicy|timeoutBudget|capability|authority|mutex|shared|channel|listType|arrayType|sliceType|smallListType|mapType|interval|workerPool|work|const|var|testCovers)\\b"
        }
      ]
    },
    "contextVerbs": {
      "patterns": [
        {
          "name": "keyword.context.semanticscript",
          "match": "^(\\s*)(input|output|effect|memory|memoryHeap|memoryArena|memoryAllocationSource|memoryStackLimit|async|operationBody|purpose|invariant|warning|precondition|failure|guarantee|security|timing|observability|pinsNullBodyFailurePath|responseBodyForwarder|htmlArg|htmlBody|rationale|dependencyPath|dependencyFailure|intrinsicName|runtimeBinding|runtimeBindingPrecondition|runtimeBindingFailure|recordConstructor|recordConstructorFailure|recordBuildFailure|jsonCodecStrict|jsonCodecUnknownFields|jsonCodecDecodeTarget|jsonCodecEncodeTarget|jsonCodecRequiredField|jsonCodecInput|jsonCodecOutput|jsonCodecDecodeFailure|jsonCodecEncodeFailure|jsonCodecLimit|trustBoundary|trustBoundaryKind|trustBoundaryInput|trustBoundaryOutput|trustBoundaryValidator|trustBoundarySource|domainLiteralSource|domainLiteralTrust|domainLiteralValidation|literalBytes|literalDigest|literalPreview|literalSource|literalTrust|sharedStateOwner|sharedStateGuard|guardTokenSource|guardTokenOwner|guardTokenProtects|guardTokenRelease|listAllocator|arrayLength|smallListInlineCapacity|smallListSpillAllocator|mapKey|mapValue|mapAllocator|listLiteralLength|listLiteralIndexBase|listLiteralIndexPolicy|listLiteralItem|collectionOperation|collectionOperationArg|collectionOperationOutput|collectionOperationFailure|collectionOperationEffect|collectionOperationAllocation|collectionOperationMutation|collectionOperationIndexPolicy|collectionOperationLengthSource|collectionOperationBorrowSource|collectionOperationCapacitySource|collectionOperationSpillAllocator|collectionOperationSpillFailure|retryMaxAttempts|retryInitialDelay|retryMaximumDelay|retryJitter|group|groupPurpose|groupInput|groupOutput|groupError|groupFailure|groupTiming|deferLogSink|deferRunOn|deferOrder|deferFailurePolicy|deferConsumes|deferAwaitLogSink|deferAwaitTimeout|deferWhenExitLogSink|workArg)\\b"
        }
      ]
    },
    "actionVerbs": {
      "patterns": [
        {
          "name": "keyword.action.semanticscript",
          "match": "^(\\s*)(set|call|arg|run|start|await|bind|bindOk|bindError|ignoreOk|ignoreValue|declareFailure|makeError|new|fieldGet|fieldSet|recordBuilder|recordSet|recordCopy|recordBuild|read|timeout|cancelOn|defer|deferLog|deferAwaitLog|deferWhenExitLog|select|selectCase|runSelect|taskGroup|startInGroup|awaitGroup|bindGroupError|send|receive|lock|unlock|useRetry|useCapability|startInterval|awaitIntervalTick|submitWork|awaitWork)\\b"
        }
      ]
    },
    "controlVerbs": {
      "patterns": [
        {
          "name": "keyword.control.semanticscript",
          "match": "^(\\s*)(label|branch|branchIf|branchIfError|branchSelected|branchIfGroupError|branchIfChannelClosed|returnOk|returnError|returnValue)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.semanticscript",
          "match": "\\b-?\\d+\\b"
        }
      ]
    },
    "primitiveTargets": {
      "patterns": [
        {
          "name": "entity.name.function.primitive-target.semanticscript",
          "match": "\\b(?:c\\.[A-Za-z_][A-Za-z0-9_]*|pointer\\.(?:loadByte|storeByte|offset|difference|isNull)|console\\.writeLine|console\\.writeIntegerLine|console\\.writeInteger|console\\.writeFloatLine|scheduler\\.sleep|retryPolicy\\.delayForAttempt|metrics\\.computeIncrementI64|http\\.(?:responseText|responseBytes|responseSseEvent|responseHeader|requestMethod|requestPath|requestHeader|requestQueryParam|requestBodyText|requestBodyBytes|requestBodyLength|multipartPartText|multipartPartBytes|multipartPartLength|multipartPartFilename|multipartPartContentType)|gui\\.(?:textBoxText|textBoxSetText|listBoxSelectedIndex|listBoxAppendItem|listBoxClear|windowClose|eventKeyCode|eventSelectedIndex|eventWindowWidth|eventWindowHeight)|math\\.(?:addI64|subtractI64|multiplyI64|divideI64|moduloI64|equalI64|notEqualI64|lessThanI64|lessThanOrEqualI64|greaterThanI64|greaterThanOrEqualI64|addF64|subtractF64|multiplyF64|divideF64|equalF64|notEqualF64|lessThanF64|lessThanOrEqualF64|greaterThanF64|greaterThanOrEqualF64|intToFloat|floatToInt|convertSignedInt64ToFloat64|convertFloat64ToSignedInt64|convertSignedInt32ToSignedInt64|convertSignedInt64ToSignedInt32|signExtendCSignedInt32ToCSignedInt64|truncateCSignedInt64ToCSignedInt32|equalCSignedInt32|notEqualCSignedInt32|lessThanCSignedInt32|lessThanOrEqualCSignedInt32|greaterThanCSignedInt32|greaterThanOrEqualCSignedInt32|greaterThanOrEqualCByteCount|checkedMultiplyI64|subI64|mulI64|divI64|modI64|eqI64|neI64|ltI64|leI64|gtI64|geI64))\\b"
        }
      ]
    },
    "domainTargets": {
      "patterns": [
        {
          "name": "entity.name.function.domain-target.semanticscript",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\.(?:add|addPositiveStep|subtract|subtractStep|subtractPositiveStep|multiply|multiplyByStep|multiplyByCounter|divide|modulo|moduloBy|equal|notEqual|lessThan|lessThanOrEqual|greaterThan|greaterThanOrEqual|square|checkedMultiply|checkedMultiplyByCounter|checkedMultiplyByStep|length|append|get|set|slice|insert|update|remove)\\b"
        }
      ]
    },
    "generatedTargets": {
      "patterns": [
        {
          "name": "entity.name.function.generated-target.semanticscript",
          "match": "\\b(?:json\\.(?:decode|encode)\\.[A-Z][A-Za-z0-9_]*|html\\.hydrate\\.[A-Z][A-Za-z0-9_]*)\\b"
        }
      ]
    },
    "errorVariants": {
      "patterns": [
        {
          "name": "constant.language.error-variant.semanticscript",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\.[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "schemaValues": {
      "patterns": [
        {
          "name": "constant.language.schema-value.semanticscript",
          "match": "\\b(?:true|false|yes|no|capturedOutputReplay|local|module|process|sharedState|immutable|mutable|read|write|log|sourceTape|runtimeBinding|recordConstructor|intrinsic|externalDependency|codecDecode|codecEncode|collectionOperation|success|error|decode|encode|github|http|as|dev|prod|auto|windowsGui|verticalStack|horizontalStack|grid|absolute|single|multiple|click|valueChanged|selectionChanged|enterPressed|keyPressed|focusGained|focusLost|closeRequested|resized|shown|hidden|reject|ignore|keep|none|maximumBytes|sha256|utf8|nullByte|validatedRuntimeValue|trustedStaticLiteral|trustedUtf8Literal|trustedExternalCNullTerminatedUtf8Source|trustedInternal|trustedSessionContext|trustedStaticAsset|rawPointerToValidatedCString|rawUtf8ToValidatedText|row|column|packed|heap|inPlace|boundsChecked|denseZeroIndexed|all|immutableUpdate|borrowedView|zeroBasedChecked|zeroBasedCheckedRange|contiguousUniqueAscending|arena\\.request|arena\\.process|arena\\.static|returnOk|returnError|reverseRegistration|logAndSuppress|protectedBy|ownedBy)\\b"
        }
      ]
    },
    "qualifiedNames": {
      "patterns": [
        {
          "name": "entity.name.namespace.semanticscript",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)+\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.semanticscript",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "symbols": {
      "patterns": [
        {
          "name": "variable.other.semanticscript",
          "match": "\\b[a-z][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
