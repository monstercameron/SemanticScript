{
  "name": "semanticscript-vscode",
  "displayName": "SemanticScript",
  "description": "Highlighting, snippets, and check-on-save diagnostics for SemanticScript, driven by the refined compiler.",
  "version": "0.4.0",
  "publisher": "semanticscript-local",
  "icon": "icons/semanticscript-extension.png",
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/monstercameron/SemanticScript.git",
    "directory": "vscode-semanticscript"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "semanticscript",
    "language",
    "syntax",
    "vscode-extension"
  ],
  "activationEvents": [
    "onLanguage:semanticscript"
  ],
  "main": "./extension.js",
  "scripts": {
    "check": "node --check extension.js && npm run check:json",
    "check:json": "node -e \"const fs = require('fs'); ['package.json', 'language-configuration.json', 'syntaxes/semanticscript.tm-language.json', 'snippets/semanticscript.code-snippets', 'icons/semanticscript-icon-theme.json'].forEach((file) => JSON.parse(fs.readFileSync(file, 'utf8')));\"",
    "package:vsix": "npm run check && vsce package",
    "vscode:prepublish": "npm run check"
  },
  "devDependencies": {
    "@vscode/vsce": "4.1.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "semanticscript",
        "aliases": [
          "SemanticScript",
          "semanticscript"
        ],
        "extensions": [
          ".sem"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/semanticscript-file-light.svg",
          "dark": "./icons/semanticscript-file-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "semanticscript",
        "scopeName": "source.semanticscript",
        "path": "./syntaxes/semanticscript.tm-language.json"
      }
    ],
    "snippets": [
      {
        "language": "semanticscript",
        "path": "./snippets/semanticscript.code-snippets"
      }
    ],
    "iconThemes": [
      {
        "id": "semanticscript-icons",
        "label": "SemanticScript Icons",
        "path": "./icons/semanticscript-icon-theme.json"
      }
    ],
    "commands": [
      {
        "command": "semanticscript.check",
        "title": "SemanticScript: Check Project",
        "icon": "$(checklist)"
      },
      {
        "command": "semanticscript.run",
        "title": "SemanticScript: Run Project",
        "icon": "$(play)"
      },
      {
        "command": "semanticscript.test",
        "title": "SemanticScript: Test Project",
        "icon": "$(beaker)"
      }
    ],
    "configuration": {
      "title": "SemanticScript",
      "properties": {
        "semanticScript.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run `refined check` on the file's project when a file is opened or saved."
        },
        "semanticScript.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python executable that runs the refined compiler."
        },
        "semanticScript.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the refined compiler directory (semanticscript/compiler/refined). Leave empty to find it in the workspace."
        }
      }
    }
  }
}
