{
  "Operation": {
    "prefix": "operation",
    "description": "An operation with every header row, one block, and a return",
    "body": [
      "${1:name} is operation",
      "${1:name} purpose \"${2:Why this operation exists}\"",
      "${1:name} invariant ${3:none}",
      "${1:name} typeParam none",
      "${1:name} input ${4:none}",
      "${1:name} output ${5:none}",
      "${1:name} outputOwner none",
      "${1:name} raises none",
      "${1:name} effect none",
      "${1:name} uses none",
      "${1:name} memory heap false",
      "${1:name} async false",
      "${1:name} maxRecursion none",
      "${1:name} label begin loopKind none",
      "${1:name} label begin within none",
      "${1:name} at begin return ok none",
      "$0"
    ]
  },
  "Call": {
    "prefix": "call",
    "description": "A call entity with every row",
    "body": [
      "${1:name} is call",
      "${1:name} in ${2:operation}",
      "${1:name} invokes ${3:target}",
      "${1:name} arg ${4:none}",
      "${1:name} out ${5:none}",
      "${1:name} ownedBy none",
      "${1:name} cleanedBy none",
      "${1:name} borrows none",
      "${1:name} catch ${6:none}",
      "$0"
    ]
  },
  "Test": {
    "prefix": "test",
    "description": "A test that verifies one invariant",
    "body": [
      "${1:name} is test",
      "${1:name} purpose \"${2:What this test shows}\"",
      "${1:name} verifies ${3:operation} ${4:invariantId}",
      "${1:name} typeParam none",
      "${1:name} input none",
      "${1:name} output none",
      "${1:name} outputOwner none",
      "${1:name} raises none",
      "${1:name} effect none",
      "${1:name} uses none",
      "${1:name} memory heap false",
      "${1:name} async false",
      "${1:name} maxRecursion none",
      "${1:name} label begin loopKind none",
      "${1:name} label begin within none",
      "${1:name} at begin return ok none",
      "$0"
    ]
  }
}
