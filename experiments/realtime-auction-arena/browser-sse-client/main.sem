# ===== static asset handler =====
operation staticAssetHandler
input operation staticAssetHandler request HttpRequest
input operation staticAssetHandler response HttpResponse
output operation staticAssetHandler Int32
effect staticAssetHandler read http.request.header
effect staticAssetHandler read filesystem
effect staticAssetHandler write http.response
useCapability staticAssetHandler httpRequestReader
useCapability staticAssetHandler httpResponseWriter
useCapability staticAssetHandler filesystemReadCapability
memory staticAssetHandler arena request
async staticAssetHandler no
purpose operation staticAssetHandler "GET /assets/:filename - serve a file from the assets directory; the runtime refuses path traversal and sniffs the content type."

label startStaticAssetHandler
call readAssetFilenameCall http.requestPathParam
argument readAssetFilenameCall request HttpRequest request
argument readAssetFilenameCall name String assetFilenameParam
run readAssetFilenameCall
bind value assetFilename String readAssetFilenameCall
call assetFilenameMissingCall pointer.isNull
argument assetFilenameMissingCall ptr OpaquePointer assetFilename
run assetFilenameMissingCall
bind value assetFilenameMissing Bool assetFilenameMissingCall
branch if condition assetFilenameMissing target staticAssetMissing
call writeAssetFileCall http.responseFile
argument writeAssetFileCall response HttpResponse response
argument writeAssetFileCall status Int32 httpStatusOk
argument writeAssetFileCall rootDirectory String assetsDirectoryPath
argument writeAssetFileCall requestedPath String assetFilename
run writeAssetFileCall
bind value writeAssetFileStatus Int32 writeAssetFileCall
storage local immutable assetWriteOkValue Int32 0
call assetWriteOkCall math.equalInt32
argument assetWriteOkCall left Int32 writeAssetFileStatus
argument assetWriteOkCall right Int32 assetWriteOkValue
run assetWriteOkCall
bind value assetWriteOk Bool assetWriteOkCall
branch if condition assetWriteOk target staticAssetServed
branch else target staticAssetMissing

label staticAssetServed
return value writeAssetFileStatus

label staticAssetMissing
call writeAssetMissingCall http.responseText
argument writeAssetMissingCall response HttpResponse response
argument writeAssetMissingCall status Int32 httpStatusOk
argument writeAssetMissingCall body HttpTextBody assetMissingBody
argument writeAssetMissingCall contentType HttpContentType plainTextContentType
run writeAssetMissingCall
bind value writeAssetMissingStatus Int32 writeAssetMissingCall
return value writeAssetMissingStatus

