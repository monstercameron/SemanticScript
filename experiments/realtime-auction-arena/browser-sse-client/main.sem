# ===== 404 =====
html template NotFoundPageTemplate
html body template NotFoundPageTemplate
  <!doctype html>
  <html lang="en" class="h-full">
  <head>
  {headFragment}
  </head>
  <body class="min-h-full bg-floor-bg text-ink antialiased">
  <div class="mx-auto max-w-2xl px-4 py-20 text-center">
  {topBarFragment}
  <h2 class="mt-10 text-3xl font-bold text-ink">Not found</h2>
  <p class="mt-3 text-muted">{messageText}</p>
  <a href="/" class="mt-6 inline-flex rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-floor-bg">Back to lobby</a>
  </div>
  </body>
  </html>

