# ===== API fetch probe (validates standard.http outbound client) =====
operation probeApiHandler
input operation probeApiHandler request HttpRequest
input operation probeApiHandler response HttpResponse
output operation probeApiHandler Int32
effect probeApiHandler read http.client
effect probeApiHandler write http.response
useCapability probeApiHandler httpClientCaller
useCapability probeApiHandler httpResponseWriter
memory probeApiHandler heap yes
async probeApiHandler no
purpose operation probeApiHandler "GET /probe-api - proves the outbound HTTP client by fetching the API server /healthz and echoing the body."

label startProbeApiHandler
call probeFetchCall http.clientGet
argument probeFetchCall host String apiHostText
argument probeFetchCall port Int32 apiPortNumber
argument probeFetchCall path String healthzPathText
argument probeFetchCall headerLine String emptyHeaderText
run probeFetchCall
bind value probeBody HttpClientResponseBody probeFetchCall
call probeBodyMissingCall pointer.isNull
argument probeBodyMissingCall ptr OpaquePointer probeBody
run probeBodyMissingCall
bind value probeBodyMissing Bool probeBodyMissingCall
branch if condition probeBodyMissing target probeFailed
call writeProbeCall http.responseText
argument writeProbeCall response HttpResponse response
argument writeProbeCall status Int32 httpStatusOk
argument writeProbeCall body HttpClientResponseBody probeBody
argument writeProbeCall contentType HttpContentType jsonContentType
run writeProbeCall
bind value writeProbeStatus Int32 writeProbeCall
return value writeProbeStatus

label probeFailed
call writeProbeFailedCall http.responseText
argument writeProbeFailedCall response HttpResponse response
argument writeProbeFailedCall status Int32 httpStatusNotReady
argument writeProbeFailedCall body HttpTextBody probeFailedBody
argument writeProbeFailedCall contentType HttpContentType plainTextContentType
run writeProbeFailedCall
bind value writeProbeFailedStatus Int32 writeProbeFailedCall
return value writeProbeFailedStatus

# ===== Lobby page =====
html template LobbyPageTemplate
html body template LobbyPageTemplate
  <!doctype html>
  <html lang="en" class="h-full">
  <head>
  {headFragment}
  </head>
  <body class="min-h-full bg-floor-bg text-ink antialiased">
  <div class="mx-auto max-w-6xl px-4 py-6">
  {topBarFragment}
  <p class="mb-4 text-xs text-muted">Live API status (fetched over standard.http): <span class="font-mono text-accent">{apiStatusText}</span></p>
  {lobbySectionFragment}
  </div>
  </body>
  </html>

