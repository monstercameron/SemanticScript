# ===== Floor page =====
html template FloorPageTemplate
html body template FloorPageTemplate
  <!doctype html>
  <html lang="en" class="h-full">
  <head>
  {headFragment}
  </head>
  <body class="min-h-full bg-floor-bg text-ink antialiased">
  <div class="mx-auto max-w-6xl px-4 py-6">
  {topBarFragment}
  {stageFragment}
  {bidFormFragment}
  {feedSectionFragment}
  {chatPanelFragment}
  </div>
  <script src="/assets/floor.js" defer></script>
  </body>
  </html>

