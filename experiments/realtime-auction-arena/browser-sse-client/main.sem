# Lobby grid: one aggregate row whose single column is the whole grid HTML.
storage module immutable sqlLobbyGrid SqlText
sql body sqlLobbyGrid
  SELECT COALESCE(group_concat(printf('<a class="block rounded-xl border border-floor-edge bg-floor-panel p-4 transition hover:-translate-y-0.5 hover:border-accent/50" href="/floor/%s"><div class="mb-2 flex items-center justify-between"><span class="status-chip text-xs font-semibold uppercase tracking-wide" data-status="%s">%s</span><span class="font-mono text-xs text-muted">%s</span></div><h3 class="text-lg font-semibold text-ink">%s</h3><p class="mt-2 font-mono text-2xl font-bold text-accent">$%.2f</p></a>', auction_id, CASE status WHEN 1 THEN 'draft' WHEN 2 THEN 'running' WHEN 3 THEN 'closed' ELSE 'cancelled' END, CASE status WHEN 1 THEN 'draft' WHEN 2 THEN 'running' WHEN 3 THEN 'closed' ELSE 'cancelled' END, auction_id, replace(replace(replace(title, '&', '&amp;'), '<', '&lt;'), '>', '&gt;'), current_bid_minor / 100.0), ''), '<p class="text-muted">No auctions are open right now.</p>') FROM (SELECT auction_id, status, title, current_bid_minor FROM auctions ORDER BY created_at DESC LIMIT 50)

# Floor scalars: one row of pre-formatted display strings for one auction.
storage module immutable sqlFloorScalars SqlText
sql body sqlFloorScalars
  SELECT CASE status WHEN 1 THEN 'draft' WHEN 2 THEN 'running' WHEN 3 THEN 'closed' ELSE 'cancelled' END, replace(replace(replace(title, '&', '&amp;'), '<', '&lt;'), '>', '&gt;'), replace(replace(replace(description, '&', '&amp;'), '<', '&lt;'), '>', '&gt;'), printf('$%.2f', current_bid_minor / 100.0), COALESCE(NULLIF(current_winner_user_id, ''), 'No bids yet'), printf('$%.2f', (current_bid_minor + minimum_increment_minor) / 100.0), closes_at FROM auctions WHERE auction_id = ? LIMIT 1

# Floor feed: newest 40 events as one HTML string.
storage module immutable sqlFloorFeed SqlText
sql body sqlFloorFeed
  SELECT COALESCE(group_concat(printf('<li class="feed-item flex items-start gap-3 border-l-2 border-floor-edge py-2 pl-3 text-sm"><div><strong class="block text-ink">%s</strong><span class="text-xs text-muted">#%d</span></div></li>', replace(replace(replace(event_type, '&', '&amp;'), '<', '&lt;'), '>', '&gt;'), sequence), ''), '<li class="text-muted">No events yet.</li>') FROM (SELECT event_type, sequence FROM auction_events WHERE auction_id = ? ORDER BY sequence DESC LIMIT 40)

# Floor chat: newest 40 messages as one HTML string.
storage module immutable sqlFloorChat SqlText
sql body sqlFloorChat
  SELECT COALESCE(group_concat(printf('<article class="chat-msg rounded-lg bg-floor-raised px-3 py-2 text-sm"><strong class="block text-xs text-muted">%s</strong><p class="text-ink">%s</p></article>', replace(replace(replace(author_user_id, '&', '&amp;'), '<', '&lt;'), '>', '&gt;'), CASE status WHEN 2 THEN 'Message removed' ELSE replace(replace(replace(body_text, '&', '&amp;'), '<', '&lt;'), '>', '&gt;') END), ''), '<p class="text-muted">No messages yet.</p>') FROM (SELECT author_user_id, body_text, status, created_at FROM chat_messages WHERE auction_id = ? ORDER BY created_at DESC LIMIT 40)

