module app.realtime_auction_arena.server.middleware
purpose module app.realtime_auction_arena.server.middleware "Cross-cutting middleware, request policy, and observability contracts for the server scaffold."
moduleOwns app.realtime_auction_arena.server.middleware "Request id, API versioning, envelope, log, audit, metrics, redaction, idempotency, body limit, and content-type policy declarations."
moduleDoesNotOwn app.realtime_auction_arena.server.middleware "Native dispatcher fallback behavior or durable request-log writes."
invariant module app.realtime_auction_arena.server.middleware "Request logs and audit records must redact raw Authorization, refresh tokens, and password fields."

record RequestIdContract
field RequestIdContract header String
field RequestIdContract acceptedCharacters String
field RequestIdContract maxBytes I64
field RequestIdContract missingFallback String
field RequestIdContract propagationRule String
field RequestIdContract generationRuntimeGap String

record ApiEnvelopeContract
field ApiEnvelopeContract apiVersion String
field ApiEnvelopeContract successShape String
field ApiEnvelopeContract errorShape String
field ApiEnvelopeContract errorCodeRule String
field ApiEnvelopeContract dynamicBodyRuntimeGap String

record ApiVersionContract
field ApiVersionContract currentVersion String
field ApiVersionContract routePrefix String
field ApiVersionContract responseHeader String
field ApiVersionContract unsupportedVersionErrorCode String
field ApiVersionContract compatibilityRule String

record ContentTypeContract
field ContentTypeContract writeRouteMethods String
field ContentTypeContract requiredMediaType String
field ContentTypeContract acceptedMediaTypePrefix String
field ContentTypeContract missingOrInvalidStatus I64
field ContentTypeContract missingOrInvalidErrorCode String
field ContentTypeContract runtimeGap String

record SecurityLimitContract
field SecurityLimitContract maxJsonBodyBytes I64
field SecurityLimitContract maxRouteParamBytes I64
field SecurityLimitContract maxChatMessageBytes I64
field SecurityLimitContract maxTitleBytes I64
field SecurityLimitContract maxDescriptionBytes I64
field SecurityLimitContract oversizedStatus I64
field SecurityLimitContract oversizedErrorCode String

record IdempotencyContract
field IdempotencyContract header String
field IdempotencyContract requiredMethods String
field IdempotencyContract requiredRouteScope String
field IdempotencyContract keyMaxBytes I64
field IdempotencyContract requestHashRule String
field IdempotencyContract replayRule String
field IdempotencyContract conflictErrorCode String
field IdempotencyContract runtimeGap String

record LogContract
field LogContract requestStartFields String
field LogContract requestFinishFields String
field LogContract redactedFields String
field LogContract eventNames String
field LogContract runtimeStatus String

record AuditContract
field AuditContract durableTable String
field AuditContract requiredFields String
field AuditContract actionNames String
field AuditContract redactionRule String
field AuditContract runtimeGap String

record MetricsContract
field MetricsContract endpoint String
field MetricsContract contentType String
field MetricsContract bootstrapSeries String
field MetricsContract plannedSeries String
field MetricsContract labelRule String
field MetricsContract runtimeGap String

record MiddlewareContract
field MiddlewareContract requestId RequestIdContract
field MiddlewareContract apiVersion ApiVersionContract
field MiddlewareContract envelope ApiEnvelopeContract
field MiddlewareContract contentType ContentTypeContract
field MiddlewareContract limits SecurityLimitContract
field MiddlewareContract idempotency IdempotencyContract
field MiddlewareContract logs LogContract
field MiddlewareContract audit AuditContract
field MiddlewareContract metrics MetricsContract

storage module immutable middlewareContract MiddlewareContract
jsonBody middlewareContract
  {
      "requestId": {
          "header": "X-Request-Id",
          "acceptedCharacters": "ASCII letters, digits, dot, underscore, hyphen",
          "maxBytes": 128,
          "missingFallback": "req_runtime_header_unavailable",
          "propagationRule": "reflect a valid incoming request id as X-Request-Id and include the same value in every JSON envelope",
          "generationRuntimeGap": "secure random id generation plus dynamic envelope substitution still belong in route/runtime wiring"
      },
      "apiVersion": {
          "currentVersion": "v1",
          "routePrefix": "/api/v1",
          "responseHeader": "X-Api-Version",
          "unsupportedVersionErrorCode": "not_found",
          "compatibilityRule": "new breaking API behavior must use a new route prefix and envelope apiVersion"
      },
      "envelope": {
          "apiVersion": "v1",
          "successShape": "apiVersion, requestId, ok=true, data, error=null",
          "errorShape": "apiVersion, requestId, ok=false, data=null, error={code,message,details}",
          "errorCodeRule": "code is stable snake_case; message is public-safe; details is an object and may be empty",
          "dynamicBodyRuntimeGap": "static JsonText bodies validate shape; per-request requestId substitution waits on string builder/runtime helper work"
      },
      "contentType": {
          "writeRouteMethods": "POST, PUT, PATCH",
          "requiredMediaType": "application/json",
          "acceptedMediaTypePrefix": "application/json",
          "missingOrInvalidStatus": 415,
          "missingOrInvalidErrorCode": "unsupported_media_type",
          "runtimeGap": "login currently parses JSON without strict content-type rejection; route-level middleware branching is still needed"
      },
      "limits": {
          "maxJsonBodyBytes": 65536,
          "maxRouteParamBytes": 128,
          "maxChatMessageBytes": 1000,
          "maxTitleBytes": 160,
          "maxDescriptionBytes": 4000,
          "oversizedStatus": 413,
          "oversizedErrorCode": "payload_too_large"
      },
      "idempotency": {
          "header": "Idempotency-Key",
          "requiredMethods": "POST, PUT, PATCH, DELETE command routes except auth login",
          "requiredRouteScope": "method plus canonical route pattern plus authenticated actor",
          "keyMaxBytes": 128,
          "requestHashRule": "store a hash of the canonical JSON request body with the scoped key",
          "replayRule": "same scoped key and same request hash returns the original status and envelope; same key with a different hash returns idempotency_conflict",
          "conflictErrorCode": "idempotency_conflict",
          "runtimeGap": "requires SQLite idempotency_keys lookup/write inside the same transaction as command state changes"
      },
      "logs": {
          "requestStartFields": "requestId, method, path, routePattern, actorId",
          "requestFinishFields": "requestId, routePattern, status, actorId, durationMs, errorCode",
          "redactedFields": "authorization, cookie, refreshToken, password, passwordHash",
          "eventNames": "http.request.start, http.request.finish",
          "runtimeStatus": "header stamping is executable; JSON structured stdout and durable request_log insert need string builder/time/sqlite composition"
      },
      "audit": {
          "durableTable": "audit_events",
          "requiredFields": "auditEventId, requestId, actorUserId, action, outcome, payloadJson, createdAt",
          "actionNames": "auth.login.accepted, auth.login.rejected, auth.refresh.accepted, auth.refresh.rejected, auth.logout, auction.create, bid.place, chat.message",
          "redactionRule": "payloadJson never stores raw credentials, bearer tokens, refresh tokens, cookies, or password hashes",
          "runtimeGap": "audit rows require SQLite transaction helper and route-level actor context"
      },
      "metrics": {
          "endpoint": "GET /metrics",
          "contentType": "text/plain; charset=utf-8",
          "bootstrapSeries": "auction_server_bootstrap_info, auction_server_runtime_gap",
          "plannedSeries": "http_requests_total, http_request_duration_ms, auth_attempts_total, auction_commands_total, auction_events_total, idempotency_replays_total",
          "labelRule": "labels use bounded route patterns and stable codes, never raw paths, ids, usernames, tokens, or request bodies",
          "runtimeGap": "live counters and histograms need shared state plus monotonic time support"
      }
  }

operation getMiddlewareContract
output operation getMiddlewareContract MiddlewareContract
memory getMiddlewareContract heap no
async getMiddlewareContract no
purpose operation getMiddlewareContract "Return the static middleware contract."
return value middlewareContract
