module app.realtime_auction_arena.server.runtime_constants
purpose module app.realtime_auction_arena.server.runtime_constants "Runtime constants for the Realtime Auction Arena executable server."
moduleOwns app.realtime_auction_arena.server.runtime_constants "HTTP status codes, content negotiation strings, JSON field names, seeded principal literals, buffer sizes, bind indexes, and event/audit codes."
moduleDoesNotOwn app.realtime_auction_arena.server.runtime_constants "Route handler control flow, SQL text, static wire-envelope bodies, or mutable auth/database state."
invariant module app.realtime_auction_arena.server.runtime_constants "Constants in this module are imported by executable handlers so main.sem can stay focused on route flow."
import json standard.json
import jwt standard.jwt
