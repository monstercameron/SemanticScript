module app.realtime_auction_arena.server.tests.sql_queries
purpose module app.realtime_auction_arena.server.tests.sql_queries "Unit coverage contract for server/src/sql_queries.sem."
moduleOwns app.realtime_auction_arena.server.tests.sql_queries "Executable SQLite statement grouping coverage for command, replay, idempotency, audit, and chat SQL text."
moduleDoesNotOwn app.realtime_auction_arena.server.tests.sql_queries "Schema DDL or route handler control flow."
invariant module app.realtime_auction_arena.server.tests.sql_queries "SQL text moved out of main.sem must continue to be exercised by the live E2E SQLite command path."

storage module immutable sqlQueriesUnitTestPlanSummary String "server/src/sql_queries.sem coverage: idempotency lookup/insert, auction create/list/snapshot/start, bid insert/update/read, event insert/replay with after-cursor limit, accepted audit insert, audit replay with created_at plus audit_event_id cursor tiebreak, and chat create/delete/report persistence plus auction-event replay ordering SQL; transaction control SQL is owned by persistence.sem helpers."

operation getSqlQueriesUnitTestPlan
output operation getSqlQueriesUnitTestPlan String
memory getSqlQueriesUnitTestPlan heap no
async getSqlQueriesUnitTestPlan no
purpose operation getSqlQueriesUnitTestPlan "Return the SQL query constants coverage plan."
return value sqlQueriesUnitTestPlanSummary
