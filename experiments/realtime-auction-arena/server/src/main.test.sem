module app.realtime_auction_arena.server.tests.main
purpose module app.realtime_auction_arena.server.tests.main "Unit coverage contract for server/src/main.sem."
moduleOwns app.realtime_auction_arena.server.tests.main "Route shell, common headers, JSON writer, body limit, request context, and executable API smoke expectations."
moduleDoesNotOwn app.realtime_auction_arena.server.tests.main "Auction business rules or durable persistence."
invariant module app.realtime_auction_arena.server.tests.main "Every executable JSON route must be covered by the Python API smoke harness and a static unit-plan row."

storage module immutable serverMainUnitTestPlanSummary String "server/src/main.sem coverage: webServer route registration, request middleware wiring, health, readiness, metrics, API index, auctions list, bcrypt-backed demo login, refresh, logout, bearer session success/failure, imported runtime constants, imported SQL text, imported static wire envelopes, and route-local dynamic JsonText runtime edges."

operation getServerMainUnitTestPlan
output operation getServerMainUnitTestPlan String
memory getServerMainUnitTestPlan heap no
async getServerMainUnitTestPlan no
purpose operation getServerMainUnitTestPlan "Return the server main unit coverage plan."
return value serverMainUnitTestPlanSummary
