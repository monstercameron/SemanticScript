module app.realtime_auction_arena.server.audit_context
purpose module app.realtime_auction_arena.server.audit_context "Executable authenticated audit-query context for Realtime Auction Arena."
moduleOwns app.realtime_auction_arena.server.audit_context "Bounded audit_events replay handler, audit cursor parsing, and audit query response shape."
moduleDoesNotOwn app.realtime_auction_arena.server.audit_context "Route registration, command audit insertion, request-log insertion, mutable auth/session state, database lifecycle, or long-lived stream fanout."
invariant module app.realtime_auction_arena.server.audit_context "Audit reads are authenticated, bounded, ordered by durable created_at plus audit_event_id, and redact no additional data beyond what insert helpers already persisted."

import http standard.http
import sqlite_std standard.sqlite
import json standard.json
import jwt standard.jwt
import stdlib standard.stdlib
