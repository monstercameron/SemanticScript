module app.realtime_auction_arena.server.persistence
purpose module app.realtime_auction_arena.server.persistence "SQLite schema, migration, readiness, and transaction contract for Realtime Auction Arena persistence."
moduleOwns app.realtime_auction_arena.server.persistence "Schema version, migration ledger, durable table list, indexes, idempotency contract, rate-limit storage, transaction boundaries, readiness probes, seed data contracts, and executable schema text artifacts."
moduleDoesNotOwn app.realtime_auction_arena.server.persistence "Auction validation, auth cryptography, request parsing, SSE broadcasting, or native SQLite runtime internals."
invariant module app.realtime_auction_arena.server.persistence "Command writes must persist domain state, append replay events, store scoped idempotency results, update rate-limit state when applicable, write audit rows, and finish request logs in one transaction before any broadcast occurs."
invariant module app.realtime_auction_arena.server.persistence "Schema readiness is false until migrations are applied, foreign keys are enabled, required indexes exist, seed rows are present, and the current schema version matches the server contract."
moduleWarning app.realtime_auction_arena.server.persistence "Runtime integration remains in main.sem; this module owns only the durable schema and persistence contracts."

import sqlite standard.sqlite

record PersistencePlan
field PersistencePlan schemaVersion Int64
field PersistencePlan databasePathEnv String
field PersistencePlan migrationTables String
field PersistencePlan identityTables String
field PersistencePlan auctionTables String
field PersistencePlan observabilityTables String
field PersistencePlan uniqueness String
field PersistencePlan indexes String
field PersistencePlan transactionRule String
field PersistencePlan readinessRule String
field PersistencePlan cleanupRule String
field PersistencePlan requestLogRule String
field PersistencePlan rateLimitRule String
field PersistencePlan rejectedBidRule String
field PersistencePlan seedRule String
field PersistencePlan schemaArtifactRule String

record PersistenceReadinessPlan
field PersistenceReadinessPlan checks String
field PersistenceReadinessPlan failureMode String
field PersistenceReadinessPlan startupIntegration String

record PersistenceTransactionPlan
field PersistenceTransactionPlan beginMode String
field PersistenceTransactionPlan commandWriteOrder String
field PersistenceTransactionPlan idempotencyRule String
field PersistenceTransactionPlan rollbackRule String
field PersistenceTransactionPlan broadcastRule String

storage module immutable persistencePlan PersistencePlan
jsonBody persistencePlan
  {
      "schemaVersion": 1,
      "databasePathEnv": "AUCTION_ARENA_DB",
      "migrationTables": "schema_versions, schema_migrations",
      "identityTables": "users, password_credentials, refresh_tokens, revoked_jwts",
      "auctionTables": "auctions, bids, auction_events, chat_messages",
      "observabilityTables": "audit_events, request_log, idempotency_keys, rate_limit_buckets",
      "uniqueness": "users.username_norm, password_credentials.user_id, refresh_tokens.token_hash, refresh_tokens.replaced_by_refresh_token_id, revoked_jwts.jti, auctions.auction_id, bids.bid_id, auction_events(auction_id,sequence), chat_messages.message_id, audit_events.audit_event_id, request_log.request_id, idempotency_keys(scope,key,actor_user_id,auction_id), rate_limit_buckets(bucket_key,window_start)",
      "indexes": "users(role,status), refresh_tokens(user_id,expires_at,revoked_at), refresh_tokens(replaced_by_refresh_token_id), revoked_jwts(expires_at), auctions(status,closes_at), auctions(seller_user_id,status), bids(auction_id,created_at), bids(bidder_user_id,created_at), rejected bids by auction/reason/time, auction_events(auction_id,sequence), auction_events(created_at,event_id), chat_messages(auction_id,created_at), audit_events(request_id), audit_events(actor_user_id,created_at), audit_events(auction_id,created_at), audit_events(action,outcome,created_at), audit_events(bid_id,created_at), request_log(route_pattern,status,started_at), request_log(actor_user_id,started_at), request_log(auction_id,started_at), request_log(error_code,started_at), idempotency_keys(expires_at), idempotency_keys(scope,actor_user_id,auction_id,expires_at), rate_limit_buckets(reset_at), rate_limit_buckets(actor_user_id,scope,reset_at)",
      "transactionRule": "Every mutating API command runs BEGIN IMMEDIATE, checks idempotency by scope/key/actor_user_id/auction_id and non-expired request_hash, validates actor/rate-limit/domain state, writes state/event/audit/request/idempotency rows, commits, then broadcasts persisted events by sequence.",
      "readinessRule": "Startup readiness opens AUCTION_ARENA_DB, enables foreign_keys, applies schema_migrations in order, verifies schema_versions.current_version == 1, checks all required tables/indexes, verifies seed users and password_credentials, and prepares SELECT 1 against users, auctions, auction_events, idempotency_keys, request_log, and rate_limit_buckets.",
      "cleanupRule": "A scheduled maintenance transaction deletes expired idempotency_keys/rate_limit_buckets, purges expired revoked_jwts after access-token TTL, and marks expired refresh_tokens unusable without deleting audit history.",
      "requestLogRule": "request_log stores request_id, method, path, route_pattern, status, actor, auction_id, idempotency_key, duration_ms, byte counts, hashed client metadata, stable error_code, started_at, and finished_at.",
      "rateLimitRule": "rate_limit_buckets stores one row per bucket_key/window_start with scope, actor_user_id, route_pattern, count, denied_count, limit_count, reset_at, and updated_at for login, bid, and chat limiters.",
      "rejectedBidRule": "Rejected bids use bids.status = 2 with reject_reason > 0, bidder_user_id as actor, amount_minor, auction_revision, expected_revision, request_id, idempotency_key, response_status, error_code, and created_at.",
      "seedRule": "Schema seed data creates schema_versions, schema_migrations, demo auctioneer/bidder/admin users, a disabled demo user, and matching password_credentials rows used by the executable login path.",
      "schemaArtifactRule": "sqliteSchemaV1 is loaded from server/sql/schema.sql so the runtime schema artifact and persistence contract stay in one source of truth."
  }

storage module immutable persistenceReadinessPlan PersistenceReadinessPlan
jsonBody persistenceReadinessPlan
  {
      "checks": "database open, PRAGMA foreign_keys=ON, PRAGMA journal_mode=WAL, PRAGMA busy_timeout, schema version, migration ledger, seed rows, table list, index list, read probes, write probe inside rolled-back transaction",
      "failureMode": "Return /readyz ok=false with database=schema_not_ready and keep /healthz independent.",
      "startupIntegration": "server_context should call persistence startup before route registration reports ready; route handlers should read the cached readiness result."
  }

storage module immutable persistenceTransactionPlan PersistenceTransactionPlan
jsonBody persistenceTransactionPlan
  {
      "beginMode": "BEGIN IMMEDIATE",
      "commandWriteOrder": "request_log start, rate_limit_buckets upsert, scoped idempotency_keys lookup, domain row writes including rejected bids when applicable, auction_events append for replayable outcomes, audit_events append, idempotency_keys response upsert, request_log finish",
      "idempotencyRule": "Same scope/key/actor_user_id/auction_id with unexpired request_hash returns stored response_json and response_status without reapplying writes; same scope/key/actor_user_id/auction_id with a different request_hash returns idempotency_conflict. canonical_request_hash fields are reserved for canonical JSON hashing without breaking the current raw-body hash path.",
      "rollbackRule": "Any validation, constraint, serialization, or broadcast-preparation failure rolls back the transaction and writes only a best-effort request_log failure when the runtime can safely do so.",
      "broadcastRule": "SSE and Win32 polling observe only committed auction_events ordered by auction_id and sequence."
  }

literal sqliteSchemaV1 SqlText
literalSource sqliteSchemaV1 "sql/schema.sql"
literalBytes sqliteSchemaV1 11038
literalTrust sqliteSchemaV1 trustedStaticAsset

storage module immutable sqliteReadinessProbeV1 SqlText
sql body sqliteReadinessProbeV1
  PRAGMA foreign_keys;
  SELECT current_version FROM schema_versions WHERE singleton_id = 1;
  SELECT version FROM schema_migrations WHERE version = 1;
  SELECT 1 FROM users WHERE user_id = 'user_auctioneer_001' LIMIT 1;
  SELECT 1 FROM password_credentials WHERE user_id = 'user_auctioneer_001' LIMIT 1;
  SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'request_log' LIMIT 1;
  SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'rate_limit_buckets' LIMIT 1;
  SELECT 1 FROM sqlite_master WHERE type = 'index' AND name = 'idx_bids_rejected_reason' LIMIT 1;
  SELECT 1 FROM sqlite_master WHERE type = 'index' AND name = 'idx_audit_action_outcome_time' LIMIT 1;
  SELECT 1 FROM sqlite_master WHERE type = 'index' AND name = 'idx_idempotency_scope_actor_auction_expiry' LIMIT 1;
  SELECT 1 FROM users LIMIT 1;
  SELECT 1 FROM auctions LIMIT 1;
  SELECT 1 FROM auction_events LIMIT 1;
  SELECT 1 FROM idempotency_keys LIMIT 1;
  SELECT 1 FROM request_log LIMIT 1;

operation getPersistencePlan
output operation getPersistencePlan PersistencePlan
memory getPersistencePlan heap no
async getPersistencePlan no
purpose operation getPersistencePlan "Return the static persistence plan."
return value persistencePlan

operation getPersistenceReadinessPlan
output operation getPersistenceReadinessPlan PersistenceReadinessPlan
memory getPersistenceReadinessPlan heap no
async getPersistenceReadinessPlan no
purpose operation getPersistenceReadinessPlan "Return the database startup/readiness plan."
return value persistenceReadinessPlan

operation getPersistenceTransactionPlan
output operation getPersistenceTransactionPlan PersistenceTransactionPlan
memory getPersistenceTransactionPlan heap no
async getPersistenceTransactionPlan no
purpose operation getPersistenceTransactionPlan "Return the durable command transaction plan."
return value persistenceTransactionPlan

operation getSqliteSchemaV1
output operation getSqliteSchemaV1 SqlText
memory getSqliteSchemaV1 heap no
async getSqliteSchemaV1 no
purpose operation getSqliteSchemaV1 "Return the schema initialization SQL as an executable artifact for the migration runner."
return value sqliteSchemaV1

operation getSqliteReadinessProbeV1
output operation getSqliteReadinessProbeV1 SqlText
memory getSqliteReadinessProbeV1 heap no
async getSqliteReadinessProbeV1 no
purpose operation getSqliteReadinessProbeV1 "Return the readiness probe SQL contract used by main.sem once startup SQLite wiring lands."
return value sqliteReadinessProbeV1
