module app.realtime_auction_arena.server.routes
purpose module app.realtime_auction_arena.server.routes "Route catalog and API compatibility contract for Realtime Auction Arena."
moduleOwns app.realtime_auction_arena.server.routes "Versioned route declarations, method/path metadata, authorization policy labels, idempotency requirements, executable route status, and future dynamic route notes."
moduleDoesNotOwn app.realtime_auction_arena.server.routes "Native dispatcher implementation or route handler behavior."
invariant module app.realtime_auction_arena.server.routes "Public JSON APIs are versioned under /api/v1; future /api/v2 routes must not change v1 response envelopes incompatibly."

record RouteContract
field RouteContract method String
field RouteContract path String
field RouteContract handler String
field RouteContract authPolicy String
field RouteContract requiredScopes String
field RouteContract requiredPathParams String
field RouteContract revisionRequirement String
field RouteContract rejectionCodes String
field RouteContract idempotencyRequired Bool
field RouteContract runtimeStatus String

record RouteCatalog
field RouteCatalog browserShell RouteContract
field RouteCatalog health RouteContract
field RouteCatalog ready RouteContract
field RouteCatalog metrics RouteContract
field RouteCatalog apiIndex RouteContract
field RouteCatalog login RouteContract
field RouteCatalog refresh RouteContract
field RouteCatalog logout RouteContract
field RouteCatalog session RouteContract
field RouteCatalog auctionsList RouteContract
field RouteCatalog auctionsCreate RouteContract
field RouteCatalog auctionSnapshot RouteContract
field RouteCatalog auctionStart RouteContract
field RouteCatalog auctionExtend RouteContract
field RouteCatalog auctionClose RouteContract
field RouteCatalog auctionBid RouteContract
field RouteCatalog auctionEvents RouteContract
field RouteCatalog auctionAudit RouteContract
field RouteCatalog chatCreate RouteContract
field RouteCatalog chatDelete RouteContract
field RouteCatalog chatReport RouteContract

record AuctionCommandRouteDetail
field AuctionCommandRouteDetail routeKey String
field AuctionCommandRouteDetail commandKind String
field AuctionCommandRouteDetail actorPolicy String
field AuctionCommandRouteDetail bodySchema String
field AuctionCommandRouteDetail transactionWrites String
field AuctionCommandRouteDetail emittedEvents String
field AuctionCommandRouteDetail successStatus String
field AuctionCommandRouteDetail idempotencyBehavior String
field AuctionCommandRouteDetail runtimeStatus String

record EventStreamRouteDetail
field EventStreamRouteDetail routeKey String
field EventStreamRouteDetail authPolicy String
field EventStreamRouteDetail replayInputs String
field EventStreamRouteDetail replayOrdering String
field EventStreamRouteDetail liveStreamRule String
field EventStreamRouteDetail heartbeatRule String
field EventStreamRouteDetail heartbeatMillis I64
field EventStreamRouteDetail backpressureRule String
field EventStreamRouteDetail subscriberQueueLimit I64
field EventStreamRouteDetail metricsRule String
field EventStreamRouteDetail runtimeStatus String

record ChatRouteDetail
field ChatRouteDetail routeKey String
field ChatRouteDetail actorPolicy String
field ChatRouteDetail bodySchema String
field ChatRouteDetail idempotencyBehavior String
field ChatRouteDetail persistenceRule String
field ChatRouteDetail emittedEvents String
field ChatRouteDetail revisionRule String
field ChatRouteDetail runtimeStatus String

record RouteEnterpriseBehavior
field RouteEnterpriseBehavior extend AuctionCommandRouteDetail
field RouteEnterpriseBehavior close AuctionCommandRouteDetail
field RouteEnterpriseBehavior events EventStreamRouteDetail
field RouteEnterpriseBehavior chatCreate ChatRouteDetail
field RouteEnterpriseBehavior chatDelete ChatRouteDetail
field RouteEnterpriseBehavior chatReport ChatRouteDetail
field RouteEnterpriseBehavior audit RouteContract
field RouteEnterpriseBehavior executableStatusSummary String

storage module immutable routeCatalog RouteCatalog
jsonBody routeCatalog
  {
      "browserShell": { "method": "GET", "path": "/", "handler": "browserShellHandler", "authPolicy": "public", "requiredScopes": "none", "requiredPathParams": "none", "revisionRequirement": "none", "rejectionCodes": "not_found until browser asset handler is registered", "idempotencyRequired": false, "runtimeStatus": "planned_browser_shell; not registered in current native server" },
      "health": { "method": "GET", "path": "/healthz", "handler": "healthHandler", "authPolicy": "public", "requiredScopes": "none", "requiredPathParams": "none", "revisionRequirement": "none", "rejectionCodes": "none", "idempotencyRequired": false, "runtimeStatus": "executable" },
      "ready": { "method": "GET", "path": "/readyz", "handler": "readyHandler", "authPolicy": "public", "requiredScopes": "none", "requiredPathParams": "none", "revisionRequirement": "none", "rejectionCodes": "none", "idempotencyRequired": false, "runtimeStatus": "executable" },
      "metrics": { "method": "GET", "path": "/metrics", "handler": "metricsHandler", "authPolicy": "admin", "requiredScopes": "metrics:read", "requiredPathParams": "none", "revisionRequirement": "none", "rejectionCodes": "unauthorized, insufficient_role", "idempotencyRequired": false, "runtimeStatus": "registered executable route protected by seeded admin role plus metrics:read scope" },
      "apiIndex": { "method": "GET", "path": "/api/v1", "handler": "apiIndexHandler", "authPolicy": "public", "requiredScopes": "none", "requiredPathParams": "none", "revisionRequirement": "none", "rejectionCodes": "none", "idempotencyRequired": false, "runtimeStatus": "executable" },
      "login": { "method": "POST", "path": "/api/v1/auth/login", "handler": "authLoginHandler", "authPolicy": "anonymous", "requiredScopes": "none", "requiredPathParams": "none", "revisionRequirement": "none", "rejectionCodes": "invalid_credentials, payload_too_large, invalid_json", "idempotencyRequired": false, "runtimeStatus": "executable_demo_auth" },
      "refresh": { "method": "POST", "path": "/api/v1/auth/refresh", "handler": "authRefreshHandler", "authPolicy": "refresh_token", "requiredScopes": "none", "requiredPathParams": "none", "revisionRequirement": "none", "rejectionCodes": "unauthorized, invalid_refresh_token", "idempotencyRequired": false, "runtimeStatus": "executable_demo_auth" },
      "logout": { "method": "POST", "path": "/api/v1/auth/logout", "handler": "authLogoutHandler", "authPolicy": "authenticated", "requiredScopes": "none", "requiredPathParams": "none", "revisionRequirement": "none", "rejectionCodes": "unauthorized", "idempotencyRequired": false, "runtimeStatus": "executable_demo_auth" },
      "session": { "method": "GET", "path": "/api/v1/session", "handler": "sessionHandler", "authPolicy": "authenticated", "requiredScopes": "none", "requiredPathParams": "none", "revisionRequirement": "none", "rejectionCodes": "unauthorized", "idempotencyRequired": false, "runtimeStatus": "executable_demo_auth" },
      "auctionsList": { "method": "GET", "path": "/api/v1/auctions", "handler": "auctionsListHandler", "authPolicy": "viewer", "requiredScopes": "auctions:read", "requiredPathParams": "none", "revisionRequirement": "none", "rejectionCodes": "unauthorized, forbidden", "idempotencyRequired": false, "runtimeStatus": "executable_sqlite" },
      "auctionsCreate": { "method": "POST", "path": "/api/v1/auctions", "handler": "auctionsCreateHandler", "authPolicy": "admin_or_auctioneer", "requiredScopes": "auctions:write", "requiredPathParams": "none", "revisionRequirement": "none; creates revision 0", "rejectionCodes": "unauthorized, forbidden, missing_idempotency_key, idempotency_conflict, validation_failed, auction_policy_rejected", "idempotencyRequired": true, "runtimeStatus": "executable_sqlite_idempotent" },
      "auctionSnapshot": { "method": "GET", "path": "/api/v1/auctions/:auctionId", "handler": "auctionSnapshotHandler", "authPolicy": "viewer", "requiredScopes": "auctions:read or bids:read", "requiredPathParams": "auctionId", "revisionRequirement": "none; returns current revision", "rejectionCodes": "unauthorized, forbidden, invalid_route_param, auction_not_found", "idempotencyRequired": false, "runtimeStatus": "executable_sqlite" },
      "auctionStart": { "method": "POST", "path": "/api/v1/auctions/:auctionId/start", "handler": "auctionStartHandler", "authPolicy": "admin_or_auctioneer", "requiredScopes": "auctions:write", "requiredPathParams": "auctionId", "revisionRequirement": "expectedRevision required and must match current revision", "rejectionCodes": "unauthorized, forbidden, invalid_route_param, missing_idempotency_key, missing_expected_revision, stale_revision, auction_not_found, lifecycle_rejected", "idempotencyRequired": true, "runtimeStatus": "executable_sqlite_idempotent" },
      "auctionExtend": { "method": "POST", "path": "/api/v1/auctions/:auctionId/extend", "handler": "auctionExtendHandler", "authPolicy": "admin_or_auctioneer", "requiredScopes": "auctions:write", "requiredPathParams": "auctionId", "revisionRequirement": "expectedRevision required and must match current revision", "rejectionCodes": "unauthorized, forbidden, invalid_route_param, missing_idempotency_key, missing_expected_revision, stale_revision, auction_not_found, lifecycle_rejected, extension_out_of_bounds", "idempotencyRequired": true, "runtimeStatus": "executable_sqlite_idempotent" },
      "auctionClose": { "method": "POST", "path": "/api/v1/auctions/:auctionId/close", "handler": "auctionCloseHandler", "authPolicy": "admin_or_auctioneer", "requiredScopes": "auctions:write", "requiredPathParams": "auctionId", "revisionRequirement": "expectedRevision required and must match current revision", "rejectionCodes": "unauthorized, forbidden, invalid_route_param, missing_idempotency_key, missing_expected_revision, stale_revision, auction_not_found, lifecycle_rejected", "idempotencyRequired": true, "runtimeStatus": "executable_sqlite_idempotent" },
      "auctionBid": { "method": "POST", "path": "/api/v1/auctions/:auctionId/bids", "handler": "auctionBidHandler", "authPolicy": "bidder", "requiredScopes": "bids:write", "requiredPathParams": "auctionId", "revisionRequirement": "expectedRevision required unless policy allows stale revisions", "rejectionCodes": "unauthorized, forbidden, invalid_route_param, missing_idempotency_key, missing_expected_revision, stale_revision, auction_missing, auction_not_running, actor_not_bidder, amount_too_low, amount_too_high, same_bidder_in_a_row", "idempotencyRequired": true, "runtimeStatus": "executable_sqlite_idempotent_demo_bidder" },
      "auctionEvents": { "method": "GET", "path": "/api/v1/auctions/:auctionId/events", "handler": "auctionEventsHandler", "authPolicy": "seeded_viewer", "requiredScopes": "auctioneer demo scopes or bidder demo scopes; future production policy is auctions:read or bids:read", "requiredPathParams": "auctionId", "revisionRequirement": "none; uses event sequence cursor", "rejectionCodes": "unauthorized, forbidden_later, invalid_route_param, auction_not_found, replay_cursor_invalid", "idempotencyRequired": false, "runtimeStatus": "executable_authenticated_json_replay_and_accept_text_event_stream_sse_replay_not_live_fanout" },
      "auctionAudit": { "method": "GET", "path": "/api/v1/auctions/:auctionId/audit", "handler": "auctionAuditHandler", "authPolicy": "admin", "requiredScopes": "audit:read", "requiredPathParams": "auctionId", "revisionRequirement": "none; executable audit reads use an opaque createdAtUtcMillis:auditEventId cursor with legacy ?after compatibility", "rejectionCodes": "unauthorized, forbidden, invalid_route_param, auction_not_found, validation_failed", "idempotencyRequired": false, "runtimeStatus": "registered executable bounded audit replay protected by seeded admin role and audit:read scope; authenticated non-admin callers receive insufficient_role" },
      "chatCreate": { "method": "POST", "path": "/api/v1/auctions/:auctionId/chat/messages", "handler": "chatCreateHandler", "authPolicy": "bidder", "requiredScopes": "chat:write", "requiredPathParams": "auctionId", "revisionRequirement": "none; chat does not change auction revision", "rejectionCodes": "unauthorized, forbidden, invalid_route_param, missing_idempotency_key, validation_failed, rate_limited", "idempotencyRequired": true, "runtimeStatus": "executable_sqlite_idempotent_demo_bidder" },
      "chatDelete": { "method": "DELETE", "path": "/api/v1/auctions/:auctionId/chat/messages/:messageId", "handler": "chatDeleteHandler", "authPolicy": "admin_or_auctioneer", "requiredScopes": "chat:moderate", "requiredPathParams": "auctionId,messageId", "revisionRequirement": "none; chat moderation does not change auction revision", "rejectionCodes": "unauthorized, forbidden, invalid_route_param, missing_idempotency_key, idempotency_conflict, message_not_found", "idempotencyRequired": true, "runtimeStatus": "executable_sqlite_idempotent_demo_auctioneer" },
      "chatReport": { "method": "POST", "path": "/api/v1/auctions/:auctionId/chat/messages/:messageId/report", "handler": "chatReportHandler", "authPolicy": "bidder", "requiredScopes": "chat:write", "requiredPathParams": "auctionId,messageId", "revisionRequirement": "none; chat report does not change auction revision", "rejectionCodes": "unauthorized, forbidden, invalid_route_param, unsupported_media_type, payload_too_large, missing_idempotency_key, idempotency_conflict, message_not_found", "idempotencyRequired": true, "runtimeStatus": "executable_sqlite_idempotent_demo_bidder" }
  }

storage module immutable routeEnterpriseBehavior RouteEnterpriseBehavior
jsonBody routeEnterpriseBehavior
  {
      "extend": {
          "routeKey": "auctionExtend",
          "commandKind": "ExtendAuctionCommand",
          "actorPolicy": "admin_or_auctioneer with auctions:write",
          "bodySchema": "expectedRevision, extensionMillis, reason; extensionMillis must be positive and no larger than configured max manual extension",
          "transactionWrites": "BEGIN IMMEDIATE, idempotency lookup, load running auction by auctionId and revision, update closes_at/revision/event_sequence, append auction.extended, append audit_events, cache idempotent response, COMMIT",
          "emittedEvents": "auction.extended with previousClosesAtUtcMillis, newClosesAtUtcMillis, extensionMillis, reason",
          "successStatus": "200 OK",
          "idempotencyBehavior": "same scoped key and same request hash replays original envelope; different hash returns idempotency_conflict",
          "runtimeStatus": "executable_sqlite_idempotent"
      },
      "close": {
          "routeKey": "auctionClose",
          "commandKind": "CloseAuctionCommand",
          "actorPolicy": "admin_or_auctioneer with auctions:write",
          "bodySchema": "expectedRevision, reason; reason is manual_close, timer_expired, or admin_cancel where policy allows",
          "transactionWrites": "BEGIN IMMEDIATE, idempotency lookup, load running auction by auctionId and revision, set status closed, set closed_at, increment revision/event_sequence, append auction.closed, append audit_events, cache idempotent response, COMMIT",
          "emittedEvents": "auction.closed with finalBid, winnerUserId, closedAtUtcMillis, reason",
          "successStatus": "200 OK",
          "idempotencyBehavior": "same scoped key and same request hash replays original envelope; different hash returns idempotency_conflict",
          "runtimeStatus": "executable_sqlite_idempotent"
      },
      "events": {
          "routeKey": "auctionEvents",
          "authPolicy": "viewer with auctions:read or bids:read",
          "replayInputs": "Last-Event-ID header or ?after event sequence cursor; Last-Event-ID wins when both are present; ?limit bounds JSON replay to 1..200 rows",
          "replayOrdering": "SELECT committed auction_events for auctionId where sequence is greater than cursor, ordered by sequence ASC; executable JSON rows include eventTypeCode plus stable eventType text before any future live subscription",
          "liveStreamRule": "after replay, attach to per-auction fanout and write text/event-stream frames with id set to eventId and event type set to persisted event type",
          "heartbeatRule": "send heartbeat comments every 15000 ms without consuming event sequence",
          "heartbeatMillis": 15000,
          "backpressureRule": "bounded subscriber queue of 256 events; overflow closes only that subscriber and increments metrics",
          "subscriberQueueLimit": 256,
          "metricsRule": "metrics expose active_sse_clients during SSE replay and slow-client drops when stream writes fail; per-client queue overflow metrics remain live-fanout work",
          "runtimeStatus": "bounded authenticated JSON replay with Last-Event-ID/?after/?limit and eventType text is executable; Accept: text/event-stream emits id/event/data frames plus heartbeat and disconnect checks; long-lived live fanout and per-client queues remain runtime integration work"
      },
      "chatCreate": {
          "routeKey": "chatCreate",
          "actorPolicy": "bidder with chat:write",
          "bodySchema": "text; text must be valid UTF-8 and <= maxChatMessageBytes after byte counting",
          "idempotencyBehavior": "scope by auctionId, actorUserId, route, and Idempotency-Key",
          "persistenceRule": "insert chat_messages row and chat.message.created auction_events row in one transaction",
          "emittedEvents": "chat.message.created",
          "revisionRule": "does not change AuctionState.revision but consumes auction event sequence",
          "runtimeStatus": "executable SQLite handler persists chat_messages and chat.message.created, leaves auction revision unchanged, and participates in bounded JSON and opt-in SSE replay"
      },
      "chatDelete": {
          "routeKey": "chatDelete",
          "actorPolicy": "admin_or_auctioneer with chat:moderate",
          "bodySchema": "optional reason",
          "idempotencyBehavior": "DELETE requires Idempotency-Key; repeated delete for an already deleted message returns existing deleted state",
          "persistenceRule": "mark chat_messages status deleted, append chat.message.deleted, append audit_events",
          "emittedEvents": "chat.message.deleted",
          "revisionRule": "does not change AuctionState.revision but consumes auction event sequence",
          "runtimeStatus": "executable SQLite handler marks deleted_at/status, appends chat.message.deleted once, writes audit/request/idempotency rows, and replays the deleted state"
      },
      "chatReport": {
          "routeKey": "chatReport",
          "actorPolicy": "bidder with chat:write",
          "bodySchema": "reason, clientNonce",
          "idempotencyBehavior": "scope by auctionId, messageId, reporterUserId, and Idempotency-Key/clientNonce",
          "persistenceRule": "append moderation/report state and chat.message.reported event without rewriting original message text",
          "emittedEvents": "chat.message.reported",
          "revisionRule": "does not change AuctionState.revision but consumes auction event sequence",
          "runtimeStatus": "executable SQLite handler marks reported_at/status, appends chat.message.reported once, writes audit/request/idempotency rows, and replays the reported state"
      },
      "audit": { "method": "GET", "path": "/api/v1/auctions/:auctionId/audit", "handler": "auctionAuditHandler", "authPolicy": "admin", "requiredScopes": "audit:read", "requiredPathParams": "auctionId", "revisionRequirement": "none; opaque createdAtUtcMillis:auditEventId cursor", "rejectionCodes": "unauthorized, forbidden, invalid_route_param, auction_not_found, validation_failed", "idempotencyRequired": false, "runtimeStatus": "registered executable bounded audit replay protected by seeded admin role and audit:read scope; authenticated non-admin callers receive insufficient_role" },
      "executableStatusSummary": "Current executable status: health, production-config-gated readiness, admin-protected metrics, API index, demo auth, typed JWT claim checks, revoked_jwts denylist checks, authenticated SQLite auction list/snapshot/create/start/extend/close/bid/chat create/delete/report, seeded role/scope checks for registered auctioneer/admin commands plus bidder bid/chat writes, idempotency replay/conflict, lifecycle rejection envelopes, request logs with non-zero duration normalization, rate limits, bounded JSON event replay with cursor pagination, opt-in SSE replay frames with heartbeat, and admin-protected bounded audit replay with opaque cursor pagination. Enterprise contracts still require long-lived live SSE fanout and durable multi-session auth."
  }

operation getRouteCatalog
output operation getRouteCatalog RouteCatalog
memory getRouteCatalog heap no
async getRouteCatalog no
purpose operation getRouteCatalog "Return the static route catalog for docs/tests."
return value routeCatalog

operation getRouteEnterpriseBehavior
output operation getRouteEnterpriseBehavior RouteEnterpriseBehavior
memory getRouteEnterpriseBehavior heap no
async getRouteEnterpriseBehavior no
purpose operation getRouteEnterpriseBehavior "Return target enterprise route behavior that is not fully executable yet."
return value routeEnterpriseBehavior
