module app.realtime_auction_arena.server.server_context
purpose module app.realtime_auction_arena.server.server_context "Server shell context for the Realtime Auction Arena native HTTP API."
moduleOwns app.realtime_auction_arena.server.server_context "Process-local database readiness, metrics counters, liveness/readiness/index handlers, request context middleware, and shell error handlers."
moduleDoesNotOwn app.realtime_auction_arena.server.server_context "Native webServer route registration, auth/session command behavior, auction command behavior, chat command behavior, or static wire envelope bodies."
invariant module app.realtime_auction_arena.server.server_context "Shell handlers stay public and keep stable names so main.sem can later route to this context without changing route declarations."

import http standard.http
import sqlite_std standard.sqlite
import runtime app.realtime_auction_arena.server.runtime_constants
import helpers app.realtime_auction_arena.server.http_helpers
import observability_context app.realtime_auction_arena.server.observability_context

typeLiteralEncoding SqlText utf8

importOperation metricsHttpRequestsTotalValue observability_context metricsHttpRequestsTotalValue
importOperation metricsAuthLoginAcceptedTotalValue observability_context metricsAuthLoginAcceptedTotalValue
importOperation metricsAuthLoginRejectedTotalValue observability_context metricsAuthLoginRejectedTotalValue
importOperation metricsAuctionCommandsAcceptedTotalValue observability_context metricsAuctionCommandsAcceptedTotalValue
importOperation metricsAuctionCommandsRejectedTotalValue observability_context metricsAuctionCommandsRejectedTotalValue
importOperation metricsBidAcceptedTotalValue observability_context metricsBidAcceptedTotalValue
importOperation metricsRateLimitHitsTotalValue observability_context metricsRateLimitHitsTotalValue
importOperation metricsActiveSseClientsValue observability_context metricsActiveSseClientsValue
importOperation metricsSseSlowClientDropsTotalValue observability_context metricsSseSlowClientDropsTotalValue
importOperation incrementHttpRequestsTotal observability_context incrementHttpRequestsTotal

