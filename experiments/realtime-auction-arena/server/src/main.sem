webServer realtimeAuctionArenaServer
purpose operation realtimeAuctionArenaServer "Serve the Realtime Auction Arena HTTP API skeleton through the current native HTTP/1.1 adapter."
serverHost realtimeAuctionArenaServer "127.0.0.1"
serverPort realtimeAuctionArenaServer 18083
route realtimeAuctionArenaServer GET "/healthz" healthHandler
route realtimeAuctionArenaServer GET "/readyz" readyHandler
route realtimeAuctionArenaServer GET "/metrics" metricsHandler
route realtimeAuctionArenaServer GET "/api/v1" apiIndexHandler
route realtimeAuctionArenaServer POST "/api/v1/auth/login" authLoginHandler
route realtimeAuctionArenaServer POST "/api/v1/auth/refresh" authRefreshHandler
route realtimeAuctionArenaServer POST "/api/v1/auth/logout" authLogoutHandler
route realtimeAuctionArenaServer GET "/api/v1/session" sessionHandler
route realtimeAuctionArenaServer GET "/api/v1/auctions" auctionsListHandler
route realtimeAuctionArenaServer POST "/api/v1/auctions" auctionsCreateHandler
route realtimeAuctionArenaServer GET "/api/v1/not-found" apiNotFoundHandler

timeoutBudget requestTimeoutBudget DurationMilliseconds 2000
purpose operation requestTimeoutBudget "Document the desired per-route timeout; the current blocking adapter parses this as metadata only."
routeTimeout realtimeAuctionArenaServer "/healthz" requestTimeoutBudget
routeTimeout realtimeAuctionArenaServer "/readyz" requestTimeoutBudget
routeTimeout realtimeAuctionArenaServer "/metrics" requestTimeoutBudget
routeTimeout realtimeAuctionArenaServer "/api/v1" requestTimeoutBudget
routeTimeout realtimeAuctionArenaServer "/api/v1/auth/login" requestTimeoutBudget
routeTimeout realtimeAuctionArenaServer "/api/v1/auth/refresh" requestTimeoutBudget
routeTimeout realtimeAuctionArenaServer "/api/v1/auth/logout" requestTimeoutBudget
routeTimeout realtimeAuctionArenaServer "/api/v1/session" requestTimeoutBudget
routeTimeout realtimeAuctionArenaServer "/api/v1/auctions" requestTimeoutBudget
routeTimeout realtimeAuctionArenaServer "/api/v1/not-found" requestTimeoutBudget

