module app.realtime_auction_arena.server
purpose module app.realtime_auction_arena.server "Versioned native HTTP API for the Realtime Auction Arena server demo."
moduleOwns app.realtime_auction_arena.server "Native webServer declaration, health/readiness/metrics routes, API envelope response helpers, executable demo auth, route middleware, and parse-oriented placeholders for the broader versioned API surface."
moduleDoesNotOwn app.realtime_auction_arena.server "Auction rule evaluation, durable persistence implementation, production secret management, browser client assets, or Win32 auctioneer UI."
invariant module app.realtime_auction_arena.server "Every JSON route response includes apiVersion and requestId in the envelope body shape; dynamic auction route contracts remain documented until their handlers are registered in this server."

import http standard.http
import json standard.json
import jwt standard.jwt
import responses app.realtime_auction_arena.server.responses

