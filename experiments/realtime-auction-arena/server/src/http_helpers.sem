bind value contentTypeMissing Bool contentTypeMissingCall
branch if condition contentTypeMissing target contentTypeRejected
call jsonPrefixCompareCall c.strncmp
argument jsonPrefixCompareCall left CNullTerminatedByteString requestContentType
argument jsonPrefixCompareCall right CNullTerminatedByteString runtime.applicationJsonContentTypePrefix
argument jsonPrefixCompareCall count CSignedInt64 runtime.applicationJsonContentTypePrefixLength
run jsonPrefixCompareCall
bind value jsonPrefixCompareResult CSignedInt32 jsonPrefixCompareCall
call jsonPrefixMatchesCall math.equalCSignedInt32
argument jsonPrefixMatchesCall left CSignedInt32 jsonPrefixCompareResult
argument jsonPrefixMatchesCall right CSignedInt32 runtime.authSuccessCode
