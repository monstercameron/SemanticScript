argument jsonPrefixMatchesCall left Int32 jsonPrefixCompareResult
argument jsonPrefixMatchesCall right Int32 runtime.authSuccessCode
run jsonPrefixMatchesCall
bind value jsonPrefixMatches Bool jsonPrefixMatchesCall
branch if condition jsonPrefixMatches target contentTypeAccepted
