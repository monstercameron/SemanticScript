argument contentTypeHeaderCall request HttpRequest request
argument contentTypeHeaderCall name CNullTerminatedByteString runtime.contentTypeHeaderName
run contentTypeHeaderCall
bind value requestContentType CNullTerminatedByteString contentTypeHeaderCall
call contentTypeMissingCall pointer.isNull
argument contentTypeMissingCall ptr COpaqueMemoryAddress requestContentType
