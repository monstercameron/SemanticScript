invariant operation writeJsonEnvelope "The supplied body is app-owned JSON wire text: either a static envelope, serialized JsonText, or a persisted idempotency replay body."
label startWriteJsonEnvelope
call commonHeadersCall addCommonHeaders
argument commonHeadersCall response HttpResponse response
run commonHeadersCall
call responseCall http.responseText
argument responseCall response HttpResponse response
argument responseCall status Int32 status
argument responseCall body String responseBody
argument responseCall contentType HttpContentType runtime.jsonContentType
run responseCall
bind value responseStatus Int32 responseCall
return value responseStatus

