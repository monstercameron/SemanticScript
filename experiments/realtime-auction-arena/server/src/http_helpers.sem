useCapability requestContentTypeIsJson memoryBufferReadWriteCapability
purpose operation requestContentTypeIsJson "Return true when a write request declares an application/json content type."
invariant operation requestContentTypeIsJson "A charset suffix is accepted by prefix comparison; missing or different content types fail closed."
label startRequestContentTypeIsJson
call contentTypeHeaderCall http.requestHeader
argument contentTypeHeaderCall request HttpRequest request
argument contentTypeHeaderCall name String runtime.contentTypeHeaderName
run contentTypeHeaderCall
bind value requestContentType String contentTypeHeaderCall
call contentTypeMissingCall pointer.isNull
argument contentTypeMissingCall ptr OpaquePointer requestContentType
run contentTypeMissingCall
bind value contentTypeMissing Bool contentTypeMissingCall
branch if condition contentTypeMissing target contentTypeRejected
call jsonPrefixCompareCall c.strncmp
argument jsonPrefixCompareCall left String requestContentType
argument jsonPrefixCompareCall right String runtime.applicationJsonContentTypePrefix
argument jsonPrefixCompareCall count Int64 runtime.applicationJsonContentTypePrefixLength
run jsonPrefixCompareCall
bind value jsonPrefixCompareResult Int32 jsonPrefixCompareCall
