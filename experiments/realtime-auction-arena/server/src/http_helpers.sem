module app.realtime_auction_arena.server.http_helpers
purpose module app.realtime_auction_arena.server.http_helpers "Shared HTTP response and request helper operations for the Realtime Auction Arena executable server."
moduleOwns app.realtime_auction_arena.server.http_helpers "Common API headers, JSON envelope writing, static envelope writers, JSON content-type checks, and repeated success-envelope JSON seeding."
moduleDoesNotOwn app.realtime_auction_arena.server.http_helpers "Route dispatch, mutable context state, SQLite command behavior, or auction business rules."
invariant module app.realtime_auction_arena.server.http_helpers "Helpers must remain route-agnostic and must not own business decisions or process-local mutable state."

import http standard.http
import json standard.json
import bcrypt standard.bcrypt
import runtime app.realtime_auction_arena.server.runtime_constants
import wire app.realtime_auction_arena.server.wire_envelopes

capability httpRequestReader http.request read
purpose operation httpRequestReader "Authority to inspect request headers in route-agnostic helper operations."
capability httpResponseWriter http.response write
purpose operation httpResponseWriter "Authority to write shared HTTP response headers and bodies."
capability memoryBufferReadWriteCapability memory.buffer readWrite
purpose operation memoryBufferReadWriteCapability "Authority to read request header memory and write helper-owned request-id scratch buffers."
capability heapAllocCapability heap allocate
purpose operation heapAllocCapability "Authority to allocate process-local request-id generation buffers."
capability jsonDocumentWriteCapability json.document.tree write
purpose operation jsonDocumentWriteCapability "Authority to seed JSON envelope fields in caller-owned response documents."
capability jsonDocumentReadCapability json.document.tree read
purpose operation jsonDocumentReadCapability "Authority to inspect JSON command object field counts."
capability requestIdRandomCapability bcrypt.hash compute
purpose operation requestIdRandomCapability "Authority to generate random request ids with the existing CSPRNG-backed bcrypt namespace."

