module app.realtime_auction_arena.server.event_context
purpose module app.realtime_auction_arena.server.event_context "Executable event replay context for Realtime Auction Arena."
moduleOwns app.realtime_auction_arena.server.event_context "Auction event type name mapping and authenticated bounded JSON replay handler."
moduleDoesNotOwn app.realtime_auction_arena.server.event_context "Route registration, mutable auth/session state, database handle lifecycle, command persistence, long-lived SSE fanout, or shared HTTP envelope helpers."
invariant module app.realtime_auction_arena.server.event_context "Replay returns committed auction_events rows ordered by per-auction sequence and maps persisted event type codes to stable event type names."

import http standard.http
