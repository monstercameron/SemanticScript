module app.realtime_auction_arena.server.auction_events
purpose module app.realtime_auction_arena.server.auction_events "Auction event, SSE replay, and schema compatibility contract declarations."
moduleOwns app.realtime_auction_arena.server.auction_events "Event type registry, replay ordering rule, SSE runtime gap notes, and schema version policy."
moduleDoesNotOwn app.realtime_auction_arena.server.auction_events "Auction rule engine or native long-lived SSE implementation."
invariant module app.realtime_auction_arena.server.auction_events "Every persisted auction event carries schemaVersion and a monotonically increasing per-auction sequence; replay happens before live subscription."

record EventContract
field EventContract schemaVersion I64
field EventContract eventTypes String
field EventContract sequenceRule String
field EventContract replayRule String
field EventContract heartbeatRule String
field EventContract disconnectRule String
field EventContract backpressureRule String
field EventContract sseTransportStatus String
field EventContract executableNow String
field EventContract requiredRuntimeApis String

storage module immutable auctionEventContract EventContract
jsonBody auctionEventContract
  {
      "schemaVersion": 1,
      "eventTypes": "auction.created, auction.started, auction.extended, auction.closed, bid.accepted, bid.rejected, chat.message.created, chat.message.deleted, chat.message.reported",
      "sequenceRule": "sequence increments by one per auction event, including chat events, and is unique with auction_id",
      "replayRule": "GET /api/v1/auctions/:auctionId/events replays persisted events with sequence greater than Last-Event-ID or ?after before attaching the live subscriber; Last-Event-ID wins when both are present",
      "heartbeatRule": "live SSE sends a comment heartbeat at least every 15000 ms and never consumes an auction event sequence",
      "disconnectRule": "client disconnect closes the subscriber handle, removes it from the auction fanout set, and does not affect persisted event order",
      "backpressureRule": "each subscriber has a bounded outbound queue of 256 events; overflow closes that subscriber with retry hint instead of blocking persistence or other subscribers",
      "sseTransportStatus": "current native http.responseSseEvent formats one event and closes; long-lived sseOpen/sseWriteEvent/sseHeartbeat/sseClose/sseIsConnected APIs are still required",
      "executableNow": "schemaVersion, event type registry, route path, replay ordering rule, heartbeat/disconnect/backpressure constants are parseable contract data",
      "requiredRuntimeApis": "native long-lived SSE open/write/heartbeat/close/isConnected, cancellable per-subscriber queues, persistence replay cursor query"
  }

operation getAuctionEventContract
output operation getAuctionEventContract EventContract
memory getAuctionEventContract heap no
async getAuctionEventContract no
purpose operation getAuctionEventContract "Return the static auction event contract."
return value auctionEventContract
