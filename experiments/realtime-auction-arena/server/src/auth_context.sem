module app.realtime_auction_arena.server.auth_context
purpose module app.realtime_auction_arena.server.auth_context "Executable authentication context for the Realtime Auction Arena server."
moduleOwns app.realtime_auction_arena.server.auth_context "Process-local demo auth state, auth login rate-limit SQL, JWT secret resolution, bearer authorization helpers, and auth route handlers."
moduleDoesNotOwn app.realtime_auction_arena.server.auth_context "Route registration, non-auth auction command handlers, database bootstrap ownership, static auth contract declarations, shared response envelopes, or native cryptographic primitives."
invariant module app.realtime_auction_arena.server.auth_context "Auth state mutations stay behind unchanged operation names so the main route shell can bind handlers from this context after cleanup."

import http standard.http
import sqlite_std standard.sqlite
import json standard.json
import jwt standard.jwt
import bcrypt standard.bcrypt
import stdlib standard.stdlib
