storage module immutable authLoginRateLimitWindowMillis Int64 60000
storage module immutable authLoginRateLimitCount Int64 10
storage module immutable sqlDeleteExpiredAuthRateLimitBuckets SqlText
sql body sqlDeleteExpiredAuthRateLimitBuckets
  DELETE FROM rate_limit_buckets WHERE reset_at <= ?
storage module immutable sqlUpsertLoginRateLimit SqlText
sql body sqlUpsertLoginRateLimit
  INSERT INTO rate_limit_buckets(bucket_key, scope, actor_user_id, route_pattern, window_start, window_ms, count, denied_count, limit_count, reset_at, updated_at) VALUES (?, 'auth.login', '', '/api/v1/auth/login', ?, 60000, 1, 0, 10, ?, ?) ON CONFLICT(bucket_key, window_start) DO UPDATE SET count = count + 1, updated_at = excluded.updated_at RETURNING count
storage module immutable sqlInsertAuthAuditEvent SqlText
sql body sqlInsertAuthAuditEvent
  INSERT INTO audit_events(audit_event_id, schema_version, actor_user_id, actor_role, request_id, action, outcome, error_code, payload_json, created_at) VALUES ('aud_' || lower(hex(randomblob(8))), 1, ?, ?, ?, ?, ?, ?, ?, ?)
storage module immutable sqlSelectAuthUserEnabled SqlText
sql body sqlSelectAuthUserEnabled
  SELECT disabled, status FROM users WHERE user_id = ? LIMIT 1
storage module immutable sqlInsertRefreshTokenRow SqlText
sql body sqlInsertRefreshTokenRow
  INSERT INTO refresh_tokens(refresh_token_id, user_id, token_hash, issued_at, expires_at, created_by_request_id, user_agent_hash, ip_address_hash) VALUES ('rt_' || lower(hex(randomblob(8))), ?, ?, ?, ?, ?, 'redacted', 'redacted')
storage module immutable sqlRevokeRefreshTokenRow SqlText
sql body sqlRevokeRefreshTokenRow
  UPDATE refresh_tokens SET revoked_at = ?, revoked_by_request_id = ? WHERE token_hash = ? AND revoked_at = 0
storage module immutable sqlRotatePreviousRefreshTokenRow SqlText
sql body sqlRotatePreviousRefreshTokenRow
  UPDATE refresh_tokens SET revoked_at = ?, replaced_by_refresh_token_id = (SELECT refresh_token_id FROM refresh_tokens WHERE token_hash = ? LIMIT 1), revoked_by_request_id = ? WHERE token_hash = ? AND revoked_at = 0
storage module immutable sqlDeleteExpiredRevokedJwts SqlText
sql body sqlDeleteExpiredRevokedJwts
  DELETE FROM revoked_jwts WHERE expires_at <= ?
storage module immutable sqlInsertRevokedJwt SqlText
sql body sqlInsertRevokedJwt
  INSERT OR REPLACE INTO revoked_jwts(jti, user_id, expires_at, revoked_at, request_id) VALUES (?, ?, ?, ?, ?)
storage module immutable sqlSelectRevokedJwt SqlText
sql body sqlSelectRevokedJwt
  SELECT 1 FROM revoked_jwts WHERE jti = ? AND expires_at > ? LIMIT 1

