module app.realtime_auction_arena.server.observability_context
purpose module app.realtime_auction_arena.server.observability_context "Metrics counters, audit-event persistence, and request-log persistence for the executable server."
moduleOwns app.realtime_auction_arena.server.observability_context "Process-local metrics counters and SQLite-backed audit_events/request_log insert helpers."
moduleDoesNotOwn app.realtime_auction_arena.server.observability_context "Route dispatch, domain validation, auth decisions, SQL statement text, runtime constants, or HTTP response writing."
invariant module app.realtime_auction_arena.server.observability_context "Durable observability helpers bind only redacted caller-provided values and shared runtime constants; raw credentials, bearer tokens, IP addresses, user agents, and request bodies are not persisted here."

import sqlite_std standard.sqlite
import runtime app.realtime_auction_arena.server.runtime_constants
import sql app.realtime_auction_arena.server.sql_queries

