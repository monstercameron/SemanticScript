module app.realtime_auction_arena.server.tests.auction_supervisor
purpose module app.realtime_auction_arena.server.tests.auction_supervisor "Unit coverage contract for server/src/auction_supervisor.sem."
moduleOwns app.realtime_auction_arena.server.tests.auction_supervisor "Supervisor command loop, fake-time, ordering, cancellation, channel, and backpressure coverage."
moduleDoesNotOwn app.realtime_auction_arena.server.tests.auction_supervisor "The async runtime primitives themselves."
invariant module app.realtime_auction_arena.server.tests.auction_supervisor "Async runtime gaps must remain named until executable supervisor tests can run."

record AuctionSupervisorTestPlan
field AuctionSupervisorTestPlan parseableNow String
field AuctionSupervisorTestPlan commandQueueBackpressure String
field AuctionSupervisorTestPlan subscriberQueueBackpressure String
field AuctionSupervisorTestPlan deterministicOrdering String
field AuctionSupervisorTestPlan timerCancellation String
field AuctionSupervisorTestPlan shutdownDrain String
field AuctionSupervisorTestPlan requiredRuntimeApis String

storage module immutable auctionSupervisorUnitTestPlan AuctionSupervisorTestPlan
jsonBody auctionSupervisorUnitTestPlan
  {
      "parseableNow": "contract constants and this test plan parse without async runtime support",
      "commandQueueBackpressure": "when the 1024 item command queue is full, submit returns queue_full and does not enqueue or reorder commands",
      "subscriberQueueBackpressure": "when a 256 item subscriber queue is full, only that subscriber is closed and the auction command loop continues",
      "deterministicOrdering": "bids, close commands, and timerExpired are processed in monotonic receive order with a stable event sequence",
      "timerCancellation": "auction extension cancels the previous close timer and enqueues only the replacement timerExpired command",
      "shutdownDrain": "shutdown rejects new commands, drains already accepted commands, resolves replies, and closes subscriber queues",
      "requiredRuntimeApis": "executable assertions require bounded channels, trySend, async select, fake clock, cancelable timers, and task cancellation"
  }

operation getAuctionSupervisorUnitTestPlan
output operation getAuctionSupervisorUnitTestPlan AuctionSupervisorTestPlan
memory getAuctionSupervisorUnitTestPlan heap no
async getAuctionSupervisorUnitTestPlan no
purpose operation getAuctionSupervisorUnitTestPlan "Return the auction-supervisor unit coverage plan."
return value auctionSupervisorUnitTestPlan
