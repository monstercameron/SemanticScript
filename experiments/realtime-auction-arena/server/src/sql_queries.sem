exportConstant app.realtime_auction_arena.server.sql_queries sqlInsertChatRateBucket

storage module immutable sqlBeginTransaction CNullTerminatedByteString "BEGIN IMMEDIATE"
storage module immutable sqlCommitTransaction CNullTerminatedByteString "COMMIT"
storage module immutable sqlRollbackTransaction CNullTerminatedByteString "ROLLBACK"
storage module immutable sqlSelectIdempotency CNullTerminatedByteString "SELECT request_hash, response_json, response_status FROM idempotency_keys WHERE scope = ? AND key = ? AND actor_user_id = ? AND auction_id = ? AND expires_at > ? LIMIT 1"
storage module immutable sqlInsertIdempotency CNullTerminatedByteString "INSERT OR REPLACE INTO idempotency_keys(scope, key, request_hash, actor_user_id, auction_id, response_status, response_json, created_at, expires_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)"
storage module immutable sqlInsertAuction CNullTerminatedByteString "INSERT INTO auctions(auction_id, seller_user_id, created_by_user_id, status, title, description, starting_bid_minor, minimum_increment_minor, max_bid_minor, anti_sniping_window_ms, anti_sniping_extension_ms, current_bid_minor, revision, event_sequence, created_at, starts_at, closes_at, updated_at) VALUES ('auc_' || lower(hex(randomblob(8))), ?, ?, 1, ?, ?, ?, ?, ?, ?, ?, ?, 0, 1, ?, ?, ?, ?)"
storage module immutable sqlSelectAuctionByRowId CNullTerminatedByteString "SELECT auction_id, title, description, status, starting_bid_minor, minimum_increment_minor, max_bid_minor, anti_sniping_window_ms, anti_sniping_extension_ms, current_bid_minor, revision, event_sequence, starts_at, closes_at, accepted_bid_count FROM auctions WHERE rowid = ? LIMIT 1"
storage module immutable sqlSelectAuctionsList CNullTerminatedByteString "SELECT auction_id, title, status, current_bid_minor, revision, event_sequence, closes_at, accepted_bid_count FROM auctions ORDER BY created_at DESC LIMIT 100"
storage module immutable sqlSelectAuctionSnapshot CNullTerminatedByteString "SELECT auction_id, title, description, status, starting_bid_minor, minimum_increment_minor, max_bid_minor, anti_sniping_window_ms, anti_sniping_extension_ms, current_bid_minor, revision, event_sequence, starts_at, closes_at, accepted_bid_count, last_bidder_user_id FROM auctions WHERE auction_id = ? LIMIT 1"
storage module immutable sqlUpdateAuctionStart CNullTerminatedByteString "UPDATE auctions SET status = 2, revision = revision + 1, event_sequence = event_sequence + 1, updated_at = ? WHERE auction_id = ? AND status = 1 AND revision = ?"
storage module immutable sqlSelectAuctionCommandState CNullTerminatedByteString "SELECT status, current_bid_minor, minimum_increment_minor, max_bid_minor, revision, event_sequence, last_bidder_user_id FROM auctions WHERE auction_id = ? LIMIT 1"
storage module immutable sqlSelectAuctionLifecycleState CNullTerminatedByteString "SELECT status, current_bid_minor, revision, event_sequence, closes_at, last_bidder_user_id FROM auctions WHERE auction_id = ? LIMIT 1"
storage module immutable sqlUpdateAuctionExtend CNullTerminatedByteString "UPDATE auctions SET closes_at = ?, revision = revision + 1, event_sequence = event_sequence + 1, updated_at = ? WHERE auction_id = ? AND status = 2 AND revision = ?"
storage module immutable sqlUpdateAuctionClose CNullTerminatedByteString "UPDATE auctions SET status = 3, closed_at = ?, revision = revision + 1, event_sequence = event_sequence + 1, updated_at = ? WHERE auction_id = ? AND status = 2 AND revision = ?"
storage module immutable sqlInsertBidAccepted CNullTerminatedByteString "INSERT INTO bids(bid_id, auction_id, bidder_user_id, amount_minor, status, reject_reason, expected_revision, has_expected_revision, request_id, idempotency_key, created_at) VALUES ('bid_' || lower(hex(randomblob(8))), ?, ?, ?, 1, 0, ?, 1, ?, ?, ?)"
storage module immutable sqlInsertBidRejected CNullTerminatedByteString "INSERT INTO bids(bid_id, auction_id, bidder_user_id, amount_minor, status, reject_reason, auction_revision, expected_revision, has_expected_revision, request_id, idempotency_key, response_status, error_code, created_at) VALUES ('bid_' || lower(hex(randomblob(8))), ?, ?, ?, 2, ?, ?, ?, 1, ?, ?, ?, ?, ?)"
storage module immutable sqlSelectBidByRowId CNullTerminatedByteString "SELECT bid_id FROM bids WHERE rowid = ? LIMIT 1"
storage module immutable sqlUpdateAuctionAfterBid CNullTerminatedByteString "UPDATE auctions SET current_bid_minor = ?, current_winner_user_id = ?, last_bid_id = ?, last_bidder_user_id = ?, accepted_bid_count = accepted_bid_count + 1, revision = revision + 1, event_sequence = event_sequence + 1, updated_at = ? WHERE auction_id = ? AND status = 2 AND revision = ?"
storage module immutable sqlIncrementRejectedBidCount CNullTerminatedByteString "UPDATE auctions SET rejected_bid_count = rejected_bid_count + 1, updated_at = ? WHERE auction_id = ?"
storage module immutable sqlInsertAuctionEvent CNullTerminatedByteString "INSERT INTO auction_events(event_id, auction_id, sequence, auction_revision, schema_version, event_type, actor_user_id, request_id, idempotency_key, bid_id, payload_json, created_at) VALUES ('evt_' || lower(hex(randomblob(8))), ?, ?, ?, 1, ?, ?, ?, ?, ?, ?, ?)"
storage module immutable sqlSelectAuctionEvents CNullTerminatedByteString "SELECT sequence, auction_revision, event_type, payload_json, created_at FROM auction_events WHERE auction_id = ? ORDER BY sequence ASC LIMIT 200"
storage module immutable sqlSelectAuctionEventsAfter CNullTerminatedByteString "SELECT sequence, auction_revision, event_type, payload_json, created_at FROM auction_events WHERE auction_id = ? AND sequence > ? ORDER BY sequence ASC LIMIT ?"
storage module immutable sqlInsertAuditEvent CNullTerminatedByteString "INSERT INTO audit_events(audit_event_id, schema_version, actor_user_id, actor_role, request_id, idempotency_key, action, command_kind, auction_id, bid_id, outcome, error_code, payload_json, created_at) VALUES ('aud_' || lower(hex(randomblob(8))), 1, ?, ?, ?, ?, ?, ?, ?, ?, ?, '', ?, ?)"
storage module immutable sqlInsertAuditEventWithError CNullTerminatedByteString "INSERT INTO audit_events(audit_event_id, schema_version, actor_user_id, actor_role, request_id, idempotency_key, action, command_kind, auction_id, bid_id, outcome, error_code, payload_json, created_at) VALUES ('aud_' || lower(hex(randomblob(8))), 1, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)"
storage module immutable sqlInsertRequestLog CNullTerminatedByteString "INSERT INTO request_log(request_id, method, path, route_pattern, status, actor_user_id, actor_role, duration_ms, auction_id, idempotency_key, ip_address_hash, user_agent_hash, request_bytes, response_bytes, error_code, started_at, finished_at) VALUES ('req_' || lower(hex(randomblob(8))), ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)"
storage module immutable sqlInsertRateLimitBucket CNullTerminatedByteString "INSERT OR REPLACE INTO rate_limit_buckets(bucket_key, scope, actor_user_id, route_pattern, window_start, window_ms, count, denied_count, limit_count, reset_at, updated_at) VALUES (?, ?, ?, ?, 0, ?, ?, ?, ?, ?, ?)"
storage module immutable sqlSelectAuctionSequenceForChat CNullTerminatedByteString "SELECT revision, event_sequence FROM auctions WHERE auction_id = ? LIMIT 1"
storage module immutable sqlAdvanceAuctionEventSequenceForChat CNullTerminatedByteString "UPDATE auctions SET event_sequence = event_sequence + 1, updated_at = ? WHERE auction_id = ?"
storage module immutable sqlInsertChatMessage CNullTerminatedByteString "INSERT INTO chat_messages(message_id, auction_id, author_user_id, status, body_text, request_id, created_at) VALUES ('msg_' || lower(hex(randomblob(8))), ?, ?, 1, ?, ?, ?)"
storage module immutable sqlSelectChatMessageByRowId CNullTerminatedByteString "SELECT message_id FROM chat_messages WHERE rowid = ? LIMIT 1"
storage module immutable sqlSelectChatMessageForModeration CNullTerminatedByteString "SELECT status, author_user_id, deleted_at, reported_at FROM chat_messages WHERE auction_id = ? AND message_id = ? LIMIT 1"
storage module immutable sqlMarkChatMessageDeleted CNullTerminatedByteString "UPDATE chat_messages SET status = 2, deleted_at = ? WHERE auction_id = ? AND message_id = ? AND status <> 2"
storage module immutable sqlMarkChatMessageReported CNullTerminatedByteString "UPDATE chat_messages SET status = 3, reported_at = ? WHERE auction_id = ? AND message_id = ? AND reported_at = 0"
storage module immutable sqlInsertChatAuctionEvent CNullTerminatedByteString "INSERT INTO auction_events(event_id, auction_id, sequence, auction_revision, schema_version, event_type, actor_user_id, request_id, idempotency_key, bid_id, chat_message_id, payload_json, created_at) SELECT 'evt_' || lower(hex(randomblob(8))), ?1, CASE WHEN ?2 IS NULL THEN event_sequence ELSE event_sequence END, CASE WHEN ?3 IS NULL THEN revision ELSE revision END, 1, ?4, ?5, ?6, ?7, '', CASE WHEN ?8 IS NULL THEN (SELECT message_id FROM chat_messages WHERE rowid = last_insert_rowid()) ELSE (SELECT message_id FROM chat_messages WHERE rowid = last_insert_rowid()) END, ?9, ?10 FROM auctions WHERE auction_id = ?1"
storage module immutable sqlSelectChatRateActiveCount CNullTerminatedByteString "SELECT COALESCE(SUM(count), 0) FROM rate_limit_buckets WHERE scope = ? AND actor_user_id = ? AND route_pattern = ? AND reset_at > ?"
storage module immutable sqlInsertChatRateBucket CNullTerminatedByteString "INSERT INTO rate_limit_buckets(bucket_key, scope, actor_user_id, route_pattern, window_start, window_ms, count, denied_count, limit_count, reset_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, 1, 0, ?, ?, ?)"
