# Realtime Auction Arena auction command/read context.
#
# This module owns auction command behavior after the bounded-context split.
# Shared auth, observability, database, and HTTP helper calls remain by their
# existing operation names.

module app.realtime_auction_arena.server.auction_context
purpose module app.realtime_auction_arena.server.auction_context "Executable auction command and read HTTP context for the Realtime Auction Arena server."
moduleOwns app.realtime_auction_arena.server.auction_context "Auction list, create, snapshot, start, extend, close, bid, and rejected-bid persistence handler flow."
moduleDoesNotOwn app.realtime_auction_arena.server.auction_context "Authentication token parsing, request-id stamping, shared envelope writers, route registration, schema ownership, chat, or SSE fanout."
invariant module app.realtime_auction_arena.server.auction_context "Auction command handlers keep stable operation names and helper call boundaries so route-shell wiring stays ABI-only."

import http standard.http
import sqlite_std standard.sqlite
import json standard.json
import jwt standard.jwt
import runtime app.realtime_auction_arena.server.runtime_constants
import sql app.realtime_auction_arena.server.sql_queries
import tx app.realtime_auction_arena.server.persistence_tx
import helpers app.realtime_auction_arena.server.http_helpers
import domain app.realtime_auction_arena.server.auction_domain
import wire app.realtime_auction_arena.server.wire_envelopes
import auth_context app.realtime_auction_arena.server.auth_context
import server_context app.realtime_auction_arena.server.server_context
import observability_context app.realtime_auction_arena.server.observability_context

importOperation requestHasValidBearerToken auth_context requestHasValidBearerToken
importOperation requestHasAuctioneerBearerToken auth_context requestHasAuctioneerBearerToken
importOperation requestHasBidderBearerToken auth_context requestHasBidderBearerToken
