storage module immutable healthEnvelopeJson JsonText
jsonBody healthEnvelopeJson
  {
      "apiVersion": "v1",
      "requestId": "req_runtime_header_unavailable",
      "ok": true,
      "data": {
          "status": "ok",
          "service": "realtime-auction-arena"
      },
      "error": null
  }

storage module immutable readyEnvelopeJson JsonText
jsonBody readyEnvelopeJson
  {
      "apiVersion": "v1",
      "requestId": "req_runtime_header_unavailable",
      "ok": true,
      "data": {
          "ready": true,
          "database": "schema_plan_declared",
          "runtime": "native_http_exact_routes"
      },
      "error": null
  }

storage module immutable apiIndexEnvelopeJson JsonText
jsonBody apiIndexEnvelopeJson
  {
      "apiVersion": "v1",
      "requestId": "req_runtime_header_unavailable",
      "ok": true,
      "data": {
          "routes": [
              "POST /api/v1/auth/login",
              "POST /api/v1/auth/refresh",
              "POST /api/v1/auth/logout",
              "GET /api/v1/session",
              "GET /api/v1/auctions",
              "POST /api/v1/auctions",
              "GET /api/v1/auctions/:auctionId",
              "POST /api/v1/auctions/:auctionId/bids",
              "GET /api/v1/auctions/:auctionId/events"
          ]
      },
      "error": null
  }

storage module immutable authLoginSuccessEnvelopeJson JsonText
jsonBody authLoginSuccessEnvelopeJson
  {
      "apiVersion": "v1",
      "requestId": "req_runtime_header_unavailable",
      "ok": true,
      "data": {
          "tokenType": "Bearer",
          "accessToken": "hs256.jwt.token",
          "expiresInSeconds": 900,
          "refreshToken": "dynamic_opaque_refresh_token"
      },
      "error": null
  }

storage module immutable payloadTooLargeEnvelopeJson JsonText
jsonBody payloadTooLargeEnvelopeJson
  {
      "apiVersion": "v1",
      "requestId": "req_runtime_header_unavailable",
      "ok": false,
      "data": null,
      "error": {
          "code": "payload_too_large",
          "message": "Request body exceeds the 65536 byte limit",
          "details": {}
      }
  }

