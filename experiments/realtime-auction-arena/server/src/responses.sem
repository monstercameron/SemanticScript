jsonBody unsupportedMediaTypeEnvelopeJson
  {
      "apiVersion": "v1",
      "requestId": "req_runtime_header_unavailable",
      "ok": false,
      "data": null,
      "error": {
          "code": "unsupported_media_type",
          "message": "JSON write routes require Content-Type application/json",
          "details": {
              "contentType": "application/json"
          }
      }
  }

