module app.realtime_auction_arena.server.responses
purpose module app.realtime_auction_arena.server.responses "Compile-time-validated JSON response envelopes for the Realtime Auction Arena server scaffold."
moduleOwns app.realtime_auction_arena.server.responses "Static API envelope bodies used by executable registered-route handlers."
moduleDoesNotOwn app.realtime_auction_arena.server.responses "HTTP route dispatch, response header writing, dynamic JSON builders, or request-specific request-id substitution."
invariant module app.realtime_auction_arena.server.responses "Every exported body is declared as JsonText and validated with jsonBody rather than embedded as an escaped byte string in route code."

import json standard.json
import http standard.http

