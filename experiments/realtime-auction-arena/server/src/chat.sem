module app.realtime_auction_arena.server.chat
purpose module app.realtime_auction_arena.server.chat "Auction floor chat API and replay contract declarations."
moduleOwns app.realtime_auction_arena.server.chat "Chat route policies, moderation event names, body size limits, and replay ordering rule."
moduleDoesNotOwn app.realtime_auction_arena.server.chat "Browser text rendering or native SSE transport implementation."
invariant module app.realtime_auction_arena.server.chat "Chat events do not change AuctionState.revision but do consume auction event sequence numbers for replay ordering."

exportConstant app.realtime_auction_arena.server.chat chatMaxMessageBytes
exportConstant app.realtime_auction_arena.server.chat chatRateLimitWindowMillis
exportConstant app.realtime_auction_arena.server.chat chatRateLimitWindowCount
exportOperation app.realtime_auction_arena.server.chat getChatContract
exportOperation app.realtime_auction_arena.server.chat chatActorCanPost
exportOperation app.realtime_auction_arena.server.chat chatActorCanReport
exportOperation app.realtime_auction_arena.server.chat chatActorCanModerate
exportOperation app.realtime_auction_arena.server.chat chatMessageByteLengthAccepted
exportOperation app.realtime_auction_arena.server.chat chatRateLimitAllowsNextMessage
exportOperation app.realtime_auction_arena.server.chat chatRevisionUnchanged
exportOperation app.realtime_auction_arena.server.chat chatNextEventSequence

storage module immutable chatMinMessageBytes Int64 1
storage module immutable chatMaxMessageBytes Int64 1000
storage module immutable chatRateLimitWindowMillis Int64 10000
storage module immutable chatRateLimitWindowCount Int64 5
storage module immutable chatBidderRoleCode Int64 10
storage module immutable chatAuctioneerRoleCode Int64 20
storage module immutable chatAdminRoleCode Int64 30
storage module immutable chatSequenceIncrement Int64 1

record ChatContract
field ChatContract postRoute String
field ChatContract deleteRoute String
field ChatContract reportRoute String
field ChatContract maxMessageBytes Int64
field ChatContract rateLimitRule String
field ChatContract postRole String
field ChatContract reportRole String
field ChatContract moderationRole String
field ChatContract sanitizationRule String
field ChatContract persistenceRule String
field ChatContract moderationRule String
field ChatContract reportRule String
field ChatContract replayRule String
field ChatContract auditRule String
field ChatContract eventTypes String
field ChatContract runtimeStatus String
field ChatContract executableNow String
field ChatContract requiredRuntimeApis String

storage module immutable chatContract ChatContract
jsonBody chatContract
  {
      "postRoute": "POST /api/v1/auctions/:auctionId/chat/messages",
      "deleteRoute": "DELETE /api/v1/auctions/:auctionId/chat/messages/:messageId",
      "reportRoute": "POST /api/v1/auctions/:auctionId/chat/messages/:messageId/report",
      "maxMessageBytes": 1000,
      "rateLimitRule": "bidder chat create accepts at most 5 messages per 10000 ms window per actor and auction; denied attempts return rate_limited before persistence",
      "postRole": "bidder",
      "reportRole": "bidder",
      "moderationRole": "admin_or_auctioneer",
      "sanitizationRule": "request text is stored as text, never HTML; every JSON response and replay payload must be serialized through the JSON writer so <, >, &, quotes, backslash, and control characters cannot break envelope structure or browser text rendering",
      "persistenceRule": "chat create inserts chat_messages plus chat.message.created; delete marks chat_messages deleted and appends audit_events plus chat.message.deleted; report marks reported_at and appends audit_events plus chat.message.reported",
      "moderationRule": "delete is idempotent by messageId and emits chat.message.deleted exactly once for a visible message; repeated delete returns the existing deleted status",
      "reportRule": "report records reporter userId in audit_events, stores the request JSON reason in the report audit payload, marks reportedAtUtcMillis on the message, and repeated reports return the reported state without duplicating replay events",
      "replayRule": "chat create, delete, and report events are persisted in auction_events and replay through the auction SSE stream using the same per-auction sequence",
      "auditRule": "delete and report write audit_events with actor userId, requestId, outcome, and messageId before SSE broadcast",
      "eventTypes": "chat.message.created, chat.message.deleted, chat.message.reported",
      "runtimeStatus": "chat create, delete, and report are executable with JSON body parsing where required, SQLite persistence, idempotency, audit rows, event persistence, dynamic auction route params, and bounded JSON/SSE replay; long-lived live SSE fanout remains contract work",
      "executableNow": "POST chat create, DELETE chat message, and POST chat report routes enforce seeded role checks, idempotency, durable chat state, audit rows, event ordering, and replay through auction events",
      "requiredRuntimeApis": "long-lived SSE fanout"
  }

operation getChatContract
output operation getChatContract ChatContract
memory getChatContract heap no
async getChatContract no
purpose operation getChatContract "Return the static chat contract."
return value chatContract

operation chatActorCanPost
input operation chatActorCanPost actorRole Int64
output operation chatActorCanPost Bool
memory chatActorCanPost heap no
async chatActorCanPost no
purpose operation chatActorCanPost "Return true only for the bidder role allowed to post chat messages."
label startChatActorCanPost
call bidderRoleMatchCall math.equalInt64
argument bidderRoleMatchCall left Int64 actorRole
argument bidderRoleMatchCall right Int64 chatBidderRoleCode
run bidderRoleMatchCall
bind value bidderRoleMatches Bool bidderRoleMatchCall
return value bidderRoleMatches

operation chatActorCanReport
input operation chatActorCanReport actorRole Int64
output operation chatActorCanReport Bool
memory chatActorCanReport heap no
async chatActorCanReport no
purpose operation chatActorCanReport "Return true only for the bidder role allowed to report chat messages."
label startChatActorCanReport
call reportRoleCall chatActorCanPost
argument reportRoleCall actorRole Int64 actorRole
run reportRoleCall
bind value reportRoleAccepted Bool reportRoleCall
return value reportRoleAccepted

operation chatActorCanModerate
input operation chatActorCanModerate actorRole Int64
output operation chatActorCanModerate Bool
memory chatActorCanModerate heap no
async chatActorCanModerate no
purpose operation chatActorCanModerate "Return true for auctioneer or admin roles allowed to delete chat messages."
label startChatActorCanModerate
call auctioneerRoleMatchCall math.equalInt64
argument auctioneerRoleMatchCall left Int64 actorRole
argument auctioneerRoleMatchCall right Int64 chatAuctioneerRoleCode
run auctioneerRoleMatchCall
bind value auctioneerRoleMatches Bool auctioneerRoleMatchCall
branch if condition auctioneerRoleMatches target chatModerationAccepted
call adminRoleMatchCall math.equalInt64
argument adminRoleMatchCall left Int64 actorRole
argument adminRoleMatchCall right Int64 chatAdminRoleCode
run adminRoleMatchCall
bind value adminRoleMatches Bool adminRoleMatchCall
branch if condition adminRoleMatches target chatModerationAccepted
return value false
label chatModerationAccepted
return value true

operation chatMessageByteLengthAccepted
input operation chatMessageByteLengthAccepted byteLength Int64
output operation chatMessageByteLengthAccepted Bool
memory chatMessageByteLengthAccepted heap no
async chatMessageByteLengthAccepted no
purpose operation chatMessageByteLengthAccepted "Return true when a chat message body is non-empty and at or below the 1000-byte limit."
label startChatMessageByteLengthAccepted
call minLengthCall math.greaterThanOrEqualInt64
argument minLengthCall left Int64 byteLength
argument minLengthCall right Int64 chatMinMessageBytes
run minLengthCall
bind value minLengthAccepted Bool minLengthCall
branch if condition minLengthAccepted target chatLengthCheckMax
return value false
label chatLengthCheckMax
call maxLengthCall math.lessThanOrEqualInt64
argument maxLengthCall left Int64 byteLength
argument maxLengthCall right Int64 chatMaxMessageBytes
run maxLengthCall
bind value maxLengthAccepted Bool maxLengthCall
return value maxLengthAccepted

operation chatRateLimitAllowsNextMessage
input operation chatRateLimitAllowsNextMessage currentWindowCount Int64
output operation chatRateLimitAllowsNextMessage Bool
memory chatRateLimitAllowsNextMessage heap no
async chatRateLimitAllowsNextMessage no
purpose operation chatRateLimitAllowsNextMessage "Return true when adding one more chat message would remain under the per-window actor limit."
label startChatRateLimitAllowsNextMessage
call rateLimitAvailableCall math.lessThanInt64
argument rateLimitAvailableCall left Int64 currentWindowCount
argument rateLimitAvailableCall right Int64 chatRateLimitWindowCount
run rateLimitAvailableCall
bind value rateLimitAvailable Bool rateLimitAvailableCall
return value rateLimitAvailable

operation chatRevisionUnchanged
input operation chatRevisionUnchanged beforeRevision Int64
input operation chatRevisionUnchanged afterRevision Int64
output operation chatRevisionUnchanged Bool
memory chatRevisionUnchanged heap no
async chatRevisionUnchanged no
purpose operation chatRevisionUnchanged "Return true when chat persistence leaves the auction revision unchanged."
label startChatRevisionUnchanged
call revisionEqualCall math.equalInt64
argument revisionEqualCall left Int64 beforeRevision
argument revisionEqualCall right Int64 afterRevision
run revisionEqualCall
bind value revisionUnchanged Bool revisionEqualCall
return value revisionUnchanged

operation chatNextEventSequence
input operation chatNextEventSequence currentSequence Int64
output operation chatNextEventSequence Int64
memory chatNextEventSequence heap no
async chatNextEventSequence no
purpose operation chatNextEventSequence "Return the next auction event sequence consumed by a chat create/delete/report event."
label startChatNextEventSequence
call nextSequenceCall math.addInt64
argument nextSequenceCall left Int64 currentSequence
argument nextSequenceCall right Int64 chatSequenceIncrement
run nextSequenceCall
bind value nextSequence Int64 nextSequenceCall
return value nextSequence
