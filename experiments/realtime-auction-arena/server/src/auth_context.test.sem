module app.realtime_auction_arena.server.tests.auth_context
purpose module app.realtime_auction_arena.server.tests.auth_context "Unit coverage contract for server/src/auth_context.sem."
moduleOwns app.realtime_auction_arena.server.tests.auth_context "Executable auth context coverage for JWT secret resolution, login audit/rate-limit persistence, bearer authorization helpers, and auth route handlers."
moduleDoesNotOwn app.realtime_auction_arena.server.tests.auth_context "Native bcrypt/JWT primitives, SQLite adapter internals, or cross-context database bootstrap behavior."
invariant module app.realtime_auction_arena.server.tests.auth_context "Auth context tests must cover moved operation names while main.sem keeps stable route-registration names."

storage module immutable authContextUnitTestPlanSummary String "server/src/auth_context.sem coverage: resolveJwtSigningSecret env/default behavior; insertAuthAuditEvent bind/step failure paths; authUserIsEnabled disabled/status lookup; refresh_tokens insert/revoke/rotation helpers; revoked_jwts cleanup/insert/lookup helpers; consumeLoginRateLimit cleanup/upsert/select and denied/unavailable branches; requestHasValidBearerToken bearer prefix, HS256 verify, aud/exp/jti claim checks, current-token, active-session, denylist, and enabled-user checks; viewer, auctioneer/admin, bidder, admin, service, and chat moderator role/scope helpers; authLoginHandler JSON/content-length/password/disabled-user/rate-limit/audit/token issue and durable refresh row paths; authRefreshHandler enabled-user, durable refresh row rotation, audit, and replay rejection paths; authLogoutHandler valid-refresh revocation, revoked_jwts insert, and logout audit; sessionHandler bearer validation, split wrong_audience/expired_token failures, runtime timestamp bounds, denylist, enabled-user check, session audit, bidder/admin/auctioneer session envelopes, and unauthorized fallback."

operation getAuthContextUnitTestPlan
output operation getAuthContextUnitTestPlan String
memory getAuthContextUnitTestPlan heap no
async getAuthContextUnitTestPlan no
purpose operation getAuthContextUnitTestPlan "Return the executable auth context unit coverage plan."
return value authContextUnitTestPlanSummary
