module app.realtime_auction_arena.server.chat_context
purpose module app.realtime_auction_arena.server.chat_context "HTTP chat command handlers extracted from the native server shell."
moduleOwns app.realtime_auction_arena.server.chat_context "Chat create/delete/report HTTP handler flow, JSON parsing, SQLite command persistence, and route-local chat error mapping."
moduleDoesNotOwn app.realtime_auction_arena.server.chat_context "Native route registration, auth/session verification helpers, process-local database handle ownership, metrics storage, shared HTTP envelopes, SQL text, or chat domain policy helpers."
invariant module app.realtime_auction_arena.server.chat_context "Chat create persists chat messages and auction-event replay without changing auction revision; delete/report guard routes enforce idempotency and auth before returning public envelopes."

import http standard.http
import sqlite_std standard.sqlite
import json standard.json
import jwt standard.jwt
import runtime app.realtime_auction_arena.server.runtime_constants
import sql app.realtime_auction_arena.server.sql_queries
import helpers app.realtime_auction_arena.server.http_helpers

capability httpRequestReader http.request read
purpose operation httpRequestReader "Authority to inspect incoming chat request path, headers, and bounded bodies."
capability httpResponseWriter http.response write
purpose operation httpResponseWriter "Authority to write native HTTP chat responses."
capability heapAllocCapability heap allocate
purpose operation heapAllocCapability "Authority to allocate per-request chat JSON scratch buffers."
capability heapFreeCapability heap free
purpose operation heapFreeCapability "Authority to release per-request chat JSON scratch buffers."
capability memoryBufferReadWriteCapability memory.buffer readWrite
purpose operation memoryBufferReadWriteCapability "Authority to read chat request text and compare idempotency replay hashes."
capability jsonDocumentReadCapability json.document.tree read
purpose operation jsonDocumentReadCapability "Authority to read parsed chat command JSON."
capability jsonDocumentWriteCapability json.document.tree write
purpose operation jsonDocumentWriteCapability "Authority to build chat command response JSON."
capability sqliteDatabaseReadWriter database readWrite
purpose operation sqliteDatabaseReadWriter "Authority to read and write SQLite chat command state."
capability jwtTokenSigner jwt.hs256 signVerify
purpose operation jwtTokenSigner "Authority to use shared bearer-token auth helpers for chat command policy checks."

