  {
      "create": {
          "method": "POST",
          "path": "/api/v1/auctions",
          "commandKind": "createAuction",
          "requiredPathParams": "none",
          "requiredRolePolicy": "admin or auctioneer",
          "requiredScopes": "auctions:write",
          "idempotencyKey": "required in Idempotency-Key header; repeated key with identical request returns cached response",
          "expectedRevision": "not accepted on create; created auction revision is 0",
          "requestBody": "title, description, startingBid, minimumIncrement, maxBidAmount, startsAtUtcMillis, closesAtUtcMillis, antiSnipingWindowMillis, antiSnipingExtensionMillis",
          "successStatus": "201 Created",
          "rejectionCodes": "unauthorized, forbidden, missing_idempotency_key, idempotency_conflict, invalid_json, validation_failed, auction_policy_rejected",
          "revisionRule": "no existing revision check; insert starts at revision 0",
          "eventRule": "persist auction.created with sequence 1 in same transaction",
          "runtimeStatus": "executable SQLite transaction with strict body parsing, idempotency replay/conflict, audit/request logs, and auction.created event persistence"
      },
      "snapshot": {
          "method": "GET",
          "path": "/api/v1/auctions/:auctionId",
          "commandKind": "snapshot",
          "requiredPathParams": "auctionId non-empty and under route-param byte limit",
          "requiredRolePolicy": "authenticated viewer, bidder, auctioneer, or admin",
          "requiredScopes": "auctions:read or bids:read",
          "idempotencyKey": "not required",
          "expectedRevision": "not required; optional If-None-Match may use revision for cache validation later",
          "requestBody": "none",
          "successStatus": "200 OK",
          "rejectionCodes": "unauthorized, forbidden, invalid_route_param, auction_not_found",
          "revisionRule": "snapshot returns current revision without changing it",
          "eventRule": "no event emitted",
          "runtimeStatus": "executable authenticated SQLite snapshot handler with native dynamic route params"
      },
      "start": {
          "method": "POST",
          "path": "/api/v1/auctions/:auctionId/start",
          "commandKind": "startAuction",
          "requiredPathParams": "auctionId non-empty and under route-param byte limit",
          "requiredRolePolicy": "admin or auctioneer",
          "requiredScopes": "auctions:write",
          "idempotencyKey": "required in Idempotency-Key header",
          "expectedRevision": "required in request body or If-Match; must equal current auction revision",
          "requestBody": "expectedRevision",
          "successStatus": "200 OK",
          "rejectionCodes": "unauthorized, forbidden, invalid_route_param, missing_idempotency_key, missing_expected_revision, stale_revision, auction_not_found, lifecycle_rejected",
          "revisionRule": "draft to running increments revision by one",
          "eventRule": "persist auction.started after state update in same transaction",
          "runtimeStatus": "executable SQLite transaction with strict body parsing, idempotency replay/conflict, audit/request logs, and auction.started event persistence"
      },
      "extend": {
          "method": "POST",
