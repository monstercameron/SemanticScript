exportOperation app.realtime_auction_arena.server.auction_domain shouldExtendForAntiSniping
exportOperation app.realtime_auction_arena.server.auction_domain computeAntiSnipingCloseTime
exportOperation app.realtime_auction_arena.server.auction_domain selectWinnerAfterBid
exportOperation app.realtime_auction_arena.server.auction_domain nextRevisionAfterAcceptedCommand
exportOperation app.realtime_auction_arena.server.auction_domain nextEventSequence

