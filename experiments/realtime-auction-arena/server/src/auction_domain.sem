argument commandIsBidCall left CSignedInt32 commandKind
argument commandIsBidCall right CSignedInt32 placeBidCommandKindCode
run commandIsBidCall
bind value commandIsBid Bool commandIsBidCall
branch if condition commandIsBid target validateBidCommandActor

call commandIsCreateCall math.equalCSignedInt32
argument commandIsCreateCall left CSignedInt32 commandKind
argument commandIsCreateCall right CSignedInt32 createAuctionCommandKindCode
run commandIsCreateCall
bind value commandIsCreate Bool commandIsCreateCall
branch if condition commandIsCreate target validateAuctioneerCommandActor

call commandIsStartCall math.equalCSignedInt32
argument commandIsStartCall left CSignedInt32 commandKind
argument commandIsStartCall right CSignedInt32 startAuctionCommandKindCode
run commandIsStartCall
bind value commandIsStart Bool commandIsStartCall
branch if condition commandIsStart target validateAuctioneerCommandActor

call commandIsExtendCall math.equalCSignedInt32
argument commandIsExtendCall left CSignedInt32 commandKind
argument commandIsExtendCall right CSignedInt32 extendAuctionCommandKindCode
run commandIsExtendCall
bind value commandIsExtend Bool commandIsExtendCall
branch if condition commandIsExtend target validateAuctioneerCommandActor

call commandIsCloseCall math.equalCSignedInt32
argument commandIsCloseCall left CSignedInt32 commandKind
argument commandIsCloseCall right CSignedInt32 closeAuctionCommandKindCode
run commandIsCloseCall
bind value commandIsClose Bool commandIsCloseCall
branch if condition commandIsClose target validateAuctioneerCommandActor
return value commandRejectUnsupportedCommandCode

label validateBidCommandActor
call actorIsBidderForCommandCall math.equalCSignedInt32
argument actorIsBidderForCommandCall left CSignedInt32 actorRole
argument actorIsBidderForCommandCall right CSignedInt32 bidderUserRoleCode
run actorIsBidderForCommandCall
bind value actorIsBidderForCommand Bool actorIsBidderForCommandCall
branch if condition actorIsBidderForCommand target acceptAuctionCommandActor
return value commandRejectForbiddenCode

label validateAuctioneerCommandActor
call actorIsAuctioneerCall math.equalCSignedInt32
argument actorIsAuctioneerCall left CSignedInt32 actorRole
argument actorIsAuctioneerCall right CSignedInt32 auctioneerUserRoleCode
run actorIsAuctioneerCall
bind value actorIsAuctioneer Bool actorIsAuctioneerCall
branch if condition actorIsAuctioneer target acceptAuctionCommandActor
call actorIsAdminCall math.equalCSignedInt32
argument actorIsAdminCall left CSignedInt32 actorRole
argument actorIsAdminCall right CSignedInt32 adminUserRoleCode
run actorIsAdminCall
bind value actorIsAdmin Bool actorIsAdminCall
branch if condition actorIsAdmin target acceptAuctionCommandActor
return value commandRejectForbiddenCode

label acceptAuctionCommandActor
return value commandRejectNoneCode

operation validateAuctionPolicy
input operation validateAuctionPolicy minimumIncrement CSignedInt64
input operation validateAuctionPolicy startingBid CSignedInt64
input operation validateAuctionPolicy maxBidAmount CSignedInt64
input operation validateAuctionPolicy antiSnipingWindowMillis CSignedInt64
input operation validateAuctionPolicy antiSnipingExtensionMillis CSignedInt64
input operation validateAuctionPolicy titleBytes CSignedInt64
input operation validateAuctionPolicy maxTitleBytes CSignedInt64
input operation validateAuctionPolicy descriptionBytes CSignedInt64
input operation validateAuctionPolicy maxDescriptionBytes CSignedInt64
output operation validateAuctionPolicy CSignedInt64
memory validateAuctionPolicy heap no
async validateAuctionPolicy no
purpose operation validateAuctionPolicy "Return the first stable policy rejection code, or zero when the policy is acceptable."
invariant operation validateAuctionPolicy "Minimum increment must be positive."
invariant operation validateAuctionPolicy "Max bid amount must be greater than starting bid."
invariant operation validateAuctionPolicy "Anti-sniping window and extension durations must be non-negative and no larger than the module-level bounds."
invariant operation validateAuctionPolicy "Title and description byte lengths must not exceed their configured maxima."

label startValidateAuctionPolicy
call minimumIncrementPositiveCall math.greaterThanI64
argument minimumIncrementPositiveCall left I64 minimumIncrement
argument minimumIncrementPositiveCall right I64 zeroSignedInt64
run minimumIncrementPositiveCall
bind value minimumIncrementPositive Bool minimumIncrementPositiveCall
branch if condition minimumIncrementPositive target checkMaxBid
return value auctionPolicyRejectMinimumIncrementNotPositiveCode

label checkMaxBid
call maxBidAboveStartingCall math.greaterThanI64
argument maxBidAboveStartingCall left I64 maxBidAmount
argument maxBidAboveStartingCall right I64 startingBid
run maxBidAboveStartingCall
bind value maxBidAboveStarting Bool maxBidAboveStartingCall
branch if condition maxBidAboveStarting target checkAntiSnipingWindowNonNegative
return value auctionPolicyRejectMaxBidNotAboveStartingBidCode

label checkAntiSnipingWindowNonNegative
call windowNegativeCall math.lessThanI64
argument windowNegativeCall left I64 antiSnipingWindowMillis
argument windowNegativeCall right I64 zeroSignedInt64
run windowNegativeCall
bind value windowNegative Bool windowNegativeCall
branch if condition windowNegative target rejectAntiSnipingWindow
call windowTooLargeCall math.greaterThanI64
argument windowTooLargeCall left I64 antiSnipingWindowMillis
argument windowTooLargeCall right I64 maxAntiSnipingWindowMillis
run windowTooLargeCall
bind value windowTooLarge Bool windowTooLargeCall
branch if condition windowTooLarge target rejectAntiSnipingWindow
jump target checkAntiSnipingExtensionNonNegative

label rejectAntiSnipingWindow
return value auctionPolicyRejectAntiSnipingWindowOutOfBoundsCode

label checkAntiSnipingExtensionNonNegative
call extensionNegativeCall math.lessThanI64
argument extensionNegativeCall left I64 antiSnipingExtensionMillis
argument extensionNegativeCall right I64 zeroSignedInt64
run extensionNegativeCall
bind value extensionNegative Bool extensionNegativeCall
branch if condition extensionNegative target rejectAntiSnipingExtension
call extensionTooLargeCall math.greaterThanI64
argument extensionTooLargeCall left I64 antiSnipingExtensionMillis
argument extensionTooLargeCall right I64 maxAntiSnipingExtensionMillis
run extensionTooLargeCall
bind value extensionTooLarge Bool extensionTooLargeCall
branch if condition extensionTooLarge target rejectAntiSnipingExtension
jump target checkTitleBytes

label rejectAntiSnipingExtension
return value auctionPolicyRejectAntiSnipingExtensionOutOfBoundsCode

label checkTitleBytes
call titleTooLongCall math.greaterThanI64
argument titleTooLongCall left I64 titleBytes
argument titleTooLongCall right I64 maxTitleBytes
run titleTooLongCall
bind value titleTooLong Bool titleTooLongCall
branch if condition titleTooLong target rejectTitleTooLong
jump target checkDescriptionBytes

label rejectTitleTooLong
return value auctionPolicyRejectTitleTooLongCode

label checkDescriptionBytes
call descriptionTooLongCall math.greaterThanI64
argument descriptionTooLongCall left I64 descriptionBytes
argument descriptionTooLongCall right I64 maxDescriptionBytes
run descriptionTooLongCall
bind value descriptionTooLong Bool descriptionTooLongCall
branch if condition descriptionTooLong target rejectDescriptionTooLong
return value auctionPolicyRejectNoneCode

label rejectDescriptionTooLong
return value auctionPolicyRejectDescriptionTooLongCode

operation validateLifecycleTransition
input operation validateLifecycleTransition currentStatus CSignedInt32
input operation validateLifecycleTransition nextStatus CSignedInt32
output operation validateLifecycleTransition CSignedInt64
memory validateLifecycleTransition heap no
async validateLifecycleTransition no
purpose operation validateLifecycleTransition "Validate one auction lifecycle transition using stable status repr codes."
invariant operation validateLifecycleTransition "Draft can become running."
invariant operation validateLifecycleTransition "Running can become closed or cancelled."
invariant operation validateLifecycleTransition "Closed and cancelled are terminal."

label startValidateLifecycleTransition
call currentDraftCall math.equalCSignedInt32
argument currentDraftCall left CSignedInt32 currentStatus
argument currentDraftCall right CSignedInt32 draftAuctionStatusCode
run currentDraftCall
bind value currentIsDraft Bool currentDraftCall
branch if condition currentIsDraft target validateDraftTransition

call currentRunningCall math.equalCSignedInt32
argument currentRunningCall left CSignedInt32 currentStatus
argument currentRunningCall right CSignedInt32 runningAuctionStatusCode
run currentRunningCall
bind value currentIsRunning Bool currentRunningCall
branch if condition currentIsRunning target validateRunningTransition

call currentClosedCall math.equalCSignedInt32
argument currentClosedCall left CSignedInt32 currentStatus
argument currentClosedCall right CSignedInt32 closedAuctionStatusCode
run currentClosedCall
bind value currentIsClosed Bool currentClosedCall
branch if condition currentIsClosed target rejectTerminalLifecycle

call currentCancelledCall math.equalCSignedInt32
argument currentCancelledCall left CSignedInt32 currentStatus
argument currentCancelledCall right CSignedInt32 cancelledAuctionStatusCode
run currentCancelledCall
bind value currentIsCancelled Bool currentCancelledCall
branch if condition currentIsCancelled target rejectTerminalLifecycle
return value lifecycleRejectUnsupportedTransitionCode

label validateDraftTransition
call nextRunningFromDraftCall math.equalCSignedInt32
argument nextRunningFromDraftCall left CSignedInt32 nextStatus
argument nextRunningFromDraftCall right CSignedInt32 runningAuctionStatusCode
run nextRunningFromDraftCall
bind value nextIsRunningFromDraft Bool nextRunningFromDraftCall
branch if condition nextIsRunningFromDraft target acceptLifecycleTransition
return value lifecycleRejectDraftOnlyStartsCode

label validateRunningTransition
call nextClosedFromRunningCall math.equalCSignedInt32
argument nextClosedFromRunningCall left CSignedInt32 nextStatus
argument nextClosedFromRunningCall right CSignedInt32 closedAuctionStatusCode
run nextClosedFromRunningCall
bind value nextIsClosedFromRunning Bool nextClosedFromRunningCall
branch if condition nextIsClosedFromRunning target acceptLifecycleTransition
call nextCancelledFromRunningCall math.equalCSignedInt32
argument nextCancelledFromRunningCall left CSignedInt32 nextStatus
argument nextCancelledFromRunningCall right CSignedInt32 cancelledAuctionStatusCode
run nextCancelledFromRunningCall
bind value nextIsCancelledFromRunning Bool nextCancelledFromRunningCall
branch if condition nextIsCancelledFromRunning target acceptLifecycleTransition
return value lifecycleRejectRunningOnlyClosesOrCancelsCode

label rejectTerminalLifecycle
return value lifecycleRejectTerminalStateCode

label acceptLifecycleTransition
return value lifecycleRejectNoneCode

operation validateBid
input operation validateBid auctionExists Bool
input operation validateBid auctionStatus CSignedInt32
input operation validateBid actorRole CSignedInt32
input operation validateBid amount CSignedInt64
input operation validateBid currentBid CSignedInt64
input operation validateBid minimumIncrement CSignedInt64
input operation validateBid maxBidAmount CSignedInt64
input operation validateBid bidderUserId String
input operation validateBid lastBidderUserId String
input operation validateBid expectedRevision CSignedInt64
input operation validateBid currentRevision CSignedInt64
input operation validateBid hasExpectedRevision Bool
input operation validateBid allowStaleExpectedRevision Bool
output operation validateBid CSignedInt64
memory validateBid heap no
async validateBid no
purpose operation validateBid "Return the first stable bid rejection code, or zero when the bid can be accepted."
invariant operation validateBid "Checks are ordered to keep API errors deterministic and audit-friendly."
warning validateBid "TODO(runtime): string equality for bidder ids currently depends on the compiler lowering String enum-like comparisons; replace with a standard.string equality helper when available."

label startValidateBid
branch if condition auctionExists target checkAuctionRunning
return value bidRejectAuctionMissingCode

label checkAuctionRunning
call auctionRunningCall math.equalCSignedInt32
argument auctionRunningCall left CSignedInt32 auctionStatus
argument auctionRunningCall right CSignedInt32 runningAuctionStatusCode
run auctionRunningCall
bind value auctionRunning Bool auctionRunningCall
branch if condition auctionRunning target checkActorBidder
return value bidRejectAuctionNotRunningCode

label checkActorBidder
call actorBidderCall math.equalCSignedInt32
argument actorBidderCall left CSignedInt32 actorRole
argument actorBidderCall right CSignedInt32 bidderUserRoleCode
run actorBidderCall
bind value actorBidder Bool actorBidderCall
branch if condition actorBidder target checkAmountLow
return value bidRejectActorNotBidderCode

label checkAmountLow
call minimumAcceptedAmountCall math.addI64
argument minimumAcceptedAmountCall left I64 currentBid
argument minimumAcceptedAmountCall right I64 minimumIncrement
run minimumAcceptedAmountCall
bind value minimumAcceptedAmount CSignedInt64 minimumAcceptedAmountCall
call amountMeetsMinimumCall math.greaterThanOrEqualI64
argument amountMeetsMinimumCall left I64 amount
argument amountMeetsMinimumCall right I64 minimumAcceptedAmount
run amountMeetsMinimumCall
bind value amountMeetsMinimum Bool amountMeetsMinimumCall
branch if condition amountMeetsMinimum target checkAmountHigh
return value bidRejectAmountTooLowCode

label checkAmountHigh
call amountTooHighCall math.greaterThanI64
argument amountTooHighCall left I64 amount
argument amountTooHighCall right I64 maxBidAmount
run amountTooHighCall
bind value amountTooHigh Bool amountTooHighCall
branch if condition amountTooHigh target rejectAmountTooHigh
jump target checkSameBidder

label rejectAmountTooHigh
return value bidRejectAmountTooHighCode

label checkSameBidder
call sameBidderCall math.equalString
argument sameBidderCall left String bidderUserId
argument sameBidderCall right String lastBidderUserId
run sameBidderCall
bind value sameBidder Bool sameBidderCall
branch if condition sameBidder target rejectSameBidder
jump target checkExpectedRevisionPresence

label rejectSameBidder
return value bidRejectSameBidderInARowCode

label checkExpectedRevisionPresence
branch if condition hasExpectedRevision target checkExpectedRevisionPolicy
return value bidRejectNoneCode

label checkExpectedRevisionPolicy
branch if condition allowStaleExpectedRevision target acceptBidWithPolicy
call revisionMatchesCall math.equalI64
argument revisionMatchesCall left I64 expectedRevision
argument revisionMatchesCall right I64 currentRevision
run revisionMatchesCall
bind value revisionMatches Bool revisionMatchesCall
branch if condition revisionMatches target acceptBidWithPolicy
return value bidRejectStaleRevisionCode

label acceptBidWithPolicy
return value bidRejectNoneCode

operation shouldExtendForAntiSniping
input operation shouldExtendForAntiSniping nowUtcMillis CSignedInt64
input operation shouldExtendForAntiSniping closesAtUtcMillis CSignedInt64
input operation shouldExtendForAntiSniping antiSnipingWindowMillis CSignedInt64
output operation shouldExtendForAntiSniping Bool
memory shouldExtendForAntiSniping heap no
async shouldExtendForAntiSniping no
purpose operation shouldExtendForAntiSniping "Return true when a bid arrives inside the configured anti-sniping window before close."
invariant operation shouldExtendForAntiSniping "A zero anti-sniping window never extends the auction."

label startShouldExtendForAntiSniping
call windowPositiveCall math.greaterThanI64
argument windowPositiveCall left I64 antiSnipingWindowMillis
