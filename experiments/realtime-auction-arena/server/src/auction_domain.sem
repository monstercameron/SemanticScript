record AuctionApiCommandContract
field AuctionApiCommandContract method String
field AuctionApiCommandContract path String
field AuctionApiCommandContract commandKind String
field AuctionApiCommandContract requiredPathParams String
field AuctionApiCommandContract requiredRolePolicy String
field AuctionApiCommandContract requiredScopes String
field AuctionApiCommandContract idempotencyKey String
field AuctionApiCommandContract expectedRevision String
field AuctionApiCommandContract requestBody String
field AuctionApiCommandContract successStatus String
field AuctionApiCommandContract rejectionCodes String
field AuctionApiCommandContract revisionRule String
field AuctionApiCommandContract eventRule String
field AuctionApiCommandContract runtimeStatus String

record AuctionApiContract
field AuctionApiContract create AuctionApiCommandContract
field AuctionApiContract snapshot AuctionApiCommandContract
field AuctionApiContract start AuctionApiCommandContract
field AuctionApiContract extend AuctionApiCommandContract
field AuctionApiContract close AuctionApiCommandContract
field AuctionApiContract bid AuctionApiCommandContract

storage module immutable auctionApiContract AuctionApiContract
jsonBody auctionApiContract
  {
      "create": {
          "method": "POST",
          "path": "/api/v1/auctions",
          "commandKind": "createAuction",
          "requiredPathParams": "none",
          "requiredRolePolicy": "admin or auctioneer",
          "requiredScopes": "auctions:write",
          "idempotencyKey": "required in Idempotency-Key header; repeated key with identical request returns cached response",
          "expectedRevision": "not accepted on create; created auction revision is 0",
          "requestBody": "title, description, startingBid, minimumIncrement, maxBidAmount, startsAtUtcMillis, closesAtUtcMillis, antiSnipingWindowMillis, antiSnipingExtensionMillis",
          "successStatus": "201 Created",
          "rejectionCodes": "unauthorized, forbidden, missing_idempotency_key, idempotency_conflict, invalid_json, validation_failed, auction_policy_rejected",
          "revisionRule": "no existing revision check; insert starts at revision 0",
          "eventRule": "persist auction.created with sequence 1 in same transaction",
          "runtimeStatus": "blocked by persistence transaction and create handler integration; exact POST /api/v1/auctions currently fails closed"
      },
      "snapshot": {
          "method": "GET",
          "path": "/api/v1/auctions/:auctionId",
          "commandKind": "snapshot",
          "requiredPathParams": "auctionId non-empty and under route-param byte limit",
          "requiredRolePolicy": "authenticated viewer, bidder, auctioneer, or admin",
          "requiredScopes": "auctions:read or bids:read",
          "idempotencyKey": "not required",
          "expectedRevision": "not required; optional If-None-Match may use revision for cache validation later",
          "requestBody": "none",
          "successStatus": "200 OK",
          "rejectionCodes": "unauthorized, forbidden, invalid_route_param, auction_not_found",
          "revisionRule": "snapshot returns current revision without changing it",
          "eventRule": "no event emitted",
          "runtimeStatus": "blocked by persistence read handler integration; native dynamic route params are available"
      },
      "start": {
          "method": "POST",
          "path": "/api/v1/auctions/:auctionId/start",
          "commandKind": "startAuction",
          "requiredPathParams": "auctionId non-empty and under route-param byte limit",
          "requiredRolePolicy": "admin or auctioneer",
          "requiredScopes": "auctions:write",
          "idempotencyKey": "required in Idempotency-Key header",
          "expectedRevision": "required in request body or If-Match; must equal current auction revision",
          "requestBody": "expectedRevision",
          "successStatus": "200 OK",
          "rejectionCodes": "unauthorized, forbidden, invalid_route_param, missing_idempotency_key, missing_expected_revision, stale_revision, auction_not_found, lifecycle_rejected",
          "revisionRule": "draft to running increments revision by one",
          "eventRule": "persist auction.started after state update in same transaction",
          "runtimeStatus": "blocked by persistence transaction and command handler integration; native dynamic route params are available"
      },
      "extend": {
          "method": "POST",
          "path": "/api/v1/auctions/:auctionId/extend",
          "commandKind": "extendAuction",
          "requiredPathParams": "auctionId non-empty and under route-param byte limit",
          "requiredRolePolicy": "admin or auctioneer",
          "requiredScopes": "auctions:write",
          "idempotencyKey": "required in Idempotency-Key header",
          "expectedRevision": "required in request body or If-Match; must equal current auction revision",
          "requestBody": "expectedRevision, extendByMillis",
          "successStatus": "200 OK",
          "rejectionCodes": "unauthorized, forbidden, invalid_route_param, missing_idempotency_key, missing_expected_revision, stale_revision, auction_not_found, lifecycle_rejected, extension_out_of_bounds",
          "revisionRule": "running extension increments revision by one",
          "eventRule": "persist auction.extended with previous and new close times",
          "runtimeStatus": "blocked by persistence transaction and command handler integration; native dynamic route params are available"
      },
      "close": {
          "method": "POST",
