          "requiredRolePolicy": "admin or auctioneer",
          "requiredScopes": "auctions:write",
          "idempotencyKey": "required in Idempotency-Key header",
          "expectedRevision": "required in request body or If-Match; must equal current auction revision",
          "requestBody": "expectedRevision",
          "successStatus": "200 OK",
          "rejectionCodes": "unauthorized, forbidden, invalid_route_param, missing_idempotency_key, missing_expected_revision, stale_revision, auction_not_found, lifecycle_rejected",
          "revisionRule": "running to closed increments revision by one and freezes winner",
          "eventRule": "persist auction.closed after state update in same transaction",
