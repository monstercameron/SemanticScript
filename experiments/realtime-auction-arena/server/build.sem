record BuildProject
field BuildProject id String
field BuildProject name String
field BuildProject modulePath String
field BuildProject languageVersion String
field BuildProject projectVersion String
field BuildProject license String
field BuildProject sourceRoot String
field BuildProject testPattern String
field BuildProject testRoot String

record BuildModule
field BuildModule moduleName String
field BuildModule sourcePath String
field BuildModule mainFile String

record BuildModules
field BuildModules main BuildModule
field BuildModules runtime_constants BuildModule
field BuildModules sql_queries BuildModule
field BuildModules wire_envelopes BuildModule

record BuildTarget
field BuildTarget runtime String
field BuildTarget nativeRuntime String
field BuildTarget nativeRuntimeVersion I64
field BuildTarget profile String
field BuildTarget optLevel I64
field BuildTarget runtimeChecks String
field BuildTarget persistLlvmIr String
field BuildTarget emitLlvmIr String
field BuildTarget emitOptimizedLlvmIr Bool
field BuildTarget buildFolderName String
field BuildTarget cpuBaseline String
field BuildTarget cpuTune String
field BuildTarget cpuFeatureCheck String
field BuildTarget nativeHttpHost String
field BuildTarget nativeHttpPort I64
field BuildTarget formatterLineWidth I64
field BuildTarget linterMaxTier String
field BuildTarget docsOutput String
field BuildTarget nativeOutput String
field BuildTarget comptimeOperation String

record BuildMetadata
field BuildMetadata apiVersion String
field BuildMetadata runtimeContract String
field BuildMetadata scaffoldScope String

record BuildVersionInfo
field BuildVersionInfo version String
field BuildVersionInfo publisher String
field BuildVersionInfo description String
field BuildVersionInfo copyright String
field BuildVersionInfo productName String
field BuildVersionInfo internalName String
field BuildVersionInfo originalFilename String
field BuildVersionInfo comments String
field BuildVersionInfo metadata BuildMetadata

record BuildStringConstant
field BuildStringConstant type String
field BuildStringConstant value String

record BuildI64Constant
field BuildI64Constant type String
field BuildI64Constant value I64

record BuildConstants
field BuildConstants apiVersion BuildStringConstant
field BuildConstants fallbackRequestId BuildStringConstant
field BuildConstants maxJsonBodyBytes BuildI64Constant
field BuildConstants bcryptPasswordMaxBytes BuildI64Constant
field BuildConstants nativeHttpHost BuildStringConstant
field BuildConstants nativeHttpPort BuildI64Constant
field BuildConstants databasePath BuildStringConstant
field BuildConstants executableRoutes BuildStringConstant
field BuildConstants demoAuctioneerUsername BuildStringConstant
field BuildConstants demoAuctioneerUserId BuildStringConstant
field BuildConstants demoBidderUsername BuildStringConstant
field BuildConstants demoBidderUserId BuildStringConstant
field BuildConstants auctioneerRoleCode BuildI64Constant
field BuildConstants bidderRoleCode BuildI64Constant
field BuildConstants idempotencyTtlMillis BuildI64Constant
field BuildConstants runtimeConstantsModule BuildStringConstant
field BuildConstants sqlQueriesModule BuildStringConstant
field BuildConstants wireEnvelopesModule BuildStringConstant

record BuildPlan
field BuildPlan project BuildProject
field BuildPlan modules BuildModules
field BuildPlan mainModule String
field BuildPlan target BuildTarget
field BuildPlan versionInfo BuildVersionInfo
field BuildPlan constants BuildConstants

storage module immutable realtimeAuctionArenaServerBuildPlan BuildPlan
jsonBody realtimeAuctionArenaServerBuildPlan
  {
      "project": {
          "name": "RealtimeAuctionArenaServer",
          "id": "realtimeAuctionArenaServer",
          "modulePath": "github.com/monstercameron/SemanticScript/experiments/realtime-auction-arena/server",
          "languageVersion": "1.0",
          "projectVersion": "0.1.0",
          "license": "MIT",
          "sourceRoot": "src",
          "testPattern": "*.test.sem",
          "testRoot": "."
      },
      "modules": {
          "main": {
              "moduleName": "app.realtime_auction_arena.server",
              "sourcePath": "src",
              "mainFile": "main.sem"
          },
          "runtime_constants": {
              "moduleName": "app.realtime_auction_arena.server.runtime_constants",
              "sourcePath": "src/runtime_constants.sem",
              "mainFile": "runtime_constants.sem"
          },
          "sql_queries": {
              "moduleName": "app.realtime_auction_arena.server.sql_queries",
              "sourcePath": "src/sql_queries.sem",
              "mainFile": "sql_queries.sem"
          },
          "wire_envelopes": {
              "moduleName": "app.realtime_auction_arena.server.wire_envelopes",
              "sourcePath": "src/wire_envelopes.sem",
              "mainFile": "wire_envelopes.sem"
          }
      },
      "mainModule": "main",
      "target": {
          "runtime": "webServer",
          "nativeRuntime": "native",
          "nativeRuntimeVersion": 1,
          "profile": "dev",
          "optLevel": 2,
          "runtimeChecks": "panic",
          "persistLlvmIr": "yes",
          "emitLlvmIr": "auto",
          "emitOptimizedLlvmIr": false,
          "buildFolderName": "build",
          "cpuBaseline": "generic",
          "cpuTune": "generic",
          "cpuFeatureCheck": "auto",
          "nativeHttpHost": "127.0.0.1",
          "nativeHttpPort": 18083,
          "formatterLineWidth": 100,
          "linterMaxTier": "T4",
          "docsOutput": "docs",
          "nativeOutput": "realtime_auction_arena_server.exe",
          "comptimeOperation": "configureRealtimeAuctionArenaServerBuild"
      },
      "versionInfo": {
          "version": "0.1.0.0",
          "publisher": "Earl Cameron",
          "description": "Realtime Auction Arena server API/auth/persistence scaffold.",
          "copyright": "Copyright (c) 2026 Earl Cameron. Licensed under the project LICENSE.",
          "productName": "Realtime Auction Arena Server",
          "internalName": "realtime_auction_arena_server",
          "originalFilename": "realtime_auction_arena_server.exe",
          "comments": "Built from experiments/realtime-auction-arena/server/src/main.sem by the SemanticScript reference compiler.",
          "metadata": {
              "apiVersion": "v1",
              "runtimeContract": "native webServer registered routes",
              "scaffoldScope": "health|readiness|metrics|api-envelope|demo-auth|body-limit|content-type-contract|idempotency-contract|observability-contract|persistence-schema-plan"
          }
      },
      "constants": {
          "apiVersion": { "type": "String", "value": "v1" },
          "fallbackRequestId": { "type": "String", "value": "req_runtime_header_unavailable" },
          "maxJsonBodyBytes": { "type": "I64", "value": 65536 },
          "bcryptPasswordMaxBytes": { "type": "I64", "value": 72 },
          "nativeHttpHost": { "type": "String", "value": "127.0.0.1" },
          "nativeHttpPort": { "type": "I64", "value": 18083 },
          "databasePath": { "type": "String", "value": "auction_arena.sqlite3" },
          "executableRoutes": { "type": "String", "value": "healthz,readyz,metrics,apiIndex,authLogin,authRefresh,authLogout,session,auctionsList,auctionsCreate,auctionSnapshot,auctionStart,auctionBid,auctionEvents,apiNotFound" },
          "demoAuctioneerUsername": { "type": "String", "value": "auctioneer" },
          "demoAuctioneerUserId": { "type": "String", "value": "user_auctioneer_001" },
          "demoBidderUsername": { "type": "String", "value": "bidder" },
          "demoBidderUserId": { "type": "String", "value": "user_bidder_demo" },
          "auctioneerRoleCode": { "type": "I64", "value": 20 },
          "bidderRoleCode": { "type": "I64", "value": 10 },
          "idempotencyTtlMillis": { "type": "I64", "value": 86400000 },
          "runtimeConstantsModule": { "type": "String", "value": "app.realtime_auction_arena.server.runtime_constants" },
          "sqlQueriesModule": { "type": "String", "value": "app.realtime_auction_arena.server.sql_queries" },
          "wireEnvelopesModule": { "type": "String", "value": "app.realtime_auction_arena.server.wire_envelopes" }
      }
  }

