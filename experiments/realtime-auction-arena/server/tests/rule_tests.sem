# Parse-oriented rule tests for the Realtime Auction Arena domain scaffold.
#
# These tests are shaped like executable SemanticScript smoke tests. They use
# primitive scalar values so math intrinsic boundaries stay explicit.

project RealtimeAuctionArenaRuleTests
target console
runtime AgentRuntime 1.0
entry console main

import domain app.realtime_auction_arena.server.auction_domain

error MainError
errorCase MainError RuleAssertionFailed
errorCase MainError ConsoleWriteFailed

capability stdoutWriteCapability console.stdout write
purpose operation stdoutWriteCapability "Authority to print a single OK line when parse/run promotion becomes available."

storage module immutable okText String "OK"
storage module immutable exitOk ExitCode 0

storage module immutable draftStatusCode Int32 1
storage module immutable runningStatusCode Int32 2
storage module immutable closedStatusCode Int32 3
storage module immutable bidderRoleCode Int32 10
storage module immutable auctioneerRoleCode Int32 20
storage module immutable bidderOneUserId String "u1"
storage module immutable bidderZeroUserId String "u0"
storage module immutable assertionOkStatus Int32 0
storage module immutable createAuctionCommandKindCode Int32 1
storage module immutable startAuctionCommandKindCode Int32 2
storage module immutable placeBidCommandKindCode Int32 6

operation requireSignedInt64ValuesEqual
input operation requireSignedInt64ValuesEqual leftValue Int64
input operation requireSignedInt64ValuesEqual rightValue Int64
output operation requireSignedInt64ValuesEqual Bool
memory requireSignedInt64ValuesEqual heap no
async requireSignedInt64ValuesEqual no
purpose operation requireSignedInt64ValuesEqual "Return true when two signed 64-bit values match."
label startRequireSignedInt64ValuesEqual
call equalCall math.equalInt64
argument equalCall left Int64 leftValue
argument equalCall right Int64 rightValue
run equalCall
bind value valuesEqual Bool equalCall
return value valuesEqual

operation requireConditionTrue
input operation requireConditionTrue conditionValue Bool
output operation requireConditionTrue Bool
memory requireConditionTrue heap no
async requireConditionTrue no
purpose operation requireConditionTrue "Return the supplied condition as an explicit Bool assertion value."
label startRequireConditionTrue
return value conditionValue

operation main
input operation main console Console
output operation main Result ExitCode MainError
useCapability main stdoutWriteCapability
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Smoke-test deterministic rule helper contracts for policy, lifecycle, bid rejection, anti-sniping, winner selection, and monotonic counters."
invariant operation main "Every expected reject code has a direct assertion row so TODO coverage remains visible to parent orchestration."
warning main "TODO(runtime): promote this from parse-oriented contract smoke to compiled/run test once the experiment has a build tape that resolves sibling src modules."

label startMain

# Policy reject codes: 1 minimum increment, 2 max bid, 3 window, 4 extension, 5 title, 6 description, 0 accepted.
call policyMinimumIncrementCall domain.validateAuctionPolicy
argument policyMinimumIncrementCall minimumIncrement Int64 0
argument policyMinimumIncrementCall startingBid Int64 100
argument policyMinimumIncrementCall maxBidAmount Int64 1000
argument policyMinimumIncrementCall antiSnipingWindowMillis Int64 60000
argument policyMinimumIncrementCall antiSnipingExtensionMillis Int64 60000
argument policyMinimumIncrementCall titleBytes Int64 10
argument policyMinimumIncrementCall maxTitleBytes Int64 120
argument policyMinimumIncrementCall descriptionBytes Int64 20
argument policyMinimumIncrementCall maxDescriptionBytes Int64 2048
run policyMinimumIncrementCall
bind value policyMinimumIncrementReason Int64 policyMinimumIncrementCall
call assertPolicyMinimumIncrementCall requireSignedInt64ValuesEqual
argument assertPolicyMinimumIncrementCall leftValue Int64 policyMinimumIncrementReason
argument assertPolicyMinimumIncrementCall rightValue Int64 1
run assertPolicyMinimumIncrementCall
bind value assertPolicyMinimumIncrementPassed Bool assertPolicyMinimumIncrementCall
branch if condition assertPolicyMinimumIncrementPassed target afterAssertPolicyMinimumIncrement
jump target ruleAssertionFailed
label afterAssertPolicyMinimumIncrement

