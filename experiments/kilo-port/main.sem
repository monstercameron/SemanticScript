call remainderCall math.moduloInt64
argument remainderCall left Int64 oneBasedColumn
argument remainderCall right Int64 kiloTabStop
run remainderCall
bind value tabRemainder Int64 remainderCall
call onStopCall math.equalInt64
argument onStopCall left Int64 tabRemainder
argument onStopCall right Int64 zeroInt64
run onStopCall
bind value startsOnTabStop Bool onStopCall
branch if condition startsOnTabStop target returnFullTabWidth
call widthCall math.subtractInt64
argument widthCall left Int64 kiloTabStop
argument widthCall right Int64 tabRemainder
run widthCall
bind value partialTabWidth Int64 widthCall
return value partialTabWidth
label returnFullTabWidth
return value kiloTabStop

