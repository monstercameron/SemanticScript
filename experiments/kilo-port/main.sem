argument freeLengthsAfterLineFailCall ptr OpaquePointer rowLengths
run freeLengthsAfterLineFailCall
ignore void source freeLengthsAfterLineFailCall
label allocationAfterRowsFailed
call freeRowsAfterFailCall c.free
argument freeRowsAfterFailCall ptr OpaquePointer rowsBuffer
run freeRowsAfterFailCall
ignore void source freeRowsAfterFailCall
label allocationFailed
storage local immutable allocationFailedText String "Kilo port allocation failed.\n"
call allocFailedCall c.printf
argument allocFailedCall format String allocationFailedText
run allocFailedCall
ignore value source allocFailedCall type Int32
return value failureExitCode

label quitProgram
call clearQuitCall clearScreen
run clearQuitCall
ignore value source clearQuitCall type Int32
call showQuitCall showCursor
run showQuitCall
ignore value source showQuitCall type Int32
call disableRawCall c.terminalDisableRaw
run disableRawCall
ignore value source disableRawCall type Int32
call goodbyeCall c.printf
argument goodbyeCall format String goodbyeText
run goodbyeCall
ignore value source goodbyeCall type Int32
call freeSearchCall c.free
argument freeSearchCall ptr OpaquePointer searchBuffer
run freeSearchCall
ignore void source freeSearchCall
call freeLineCall c.free
argument freeLineCall ptr OpaquePointer lineBuffer
run freeLineCall
ignore void source freeLineCall
call freeLengthsCall c.free
argument freeLengthsCall ptr OpaquePointer rowLengths
run freeLengthsCall
ignore void source freeLengthsCall
call freeRowsCall c.free
argument freeRowsCall ptr OpaquePointer rowsBuffer
run freeRowsCall
ignore void source freeRowsCall
return value successExitCode
