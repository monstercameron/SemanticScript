label startIsJavaScriptIdentifierByte
call alnumCall c.isalnum
argument alnumCall character Int32 byteValue
run alnumCall
bind value alnumStatus Int32 alnumCall
call alnumBoolCall math.notEqualInt32
argument alnumBoolCall left Int32 alnumStatus
argument alnumBoolCall right Int32 zeroInt32
run alnumBoolCall
bind value isAlnum Bool alnumBoolCall
branch if condition isAlnum target returnIdentifierTrue
call underscoreCall math.equalInt32
argument underscoreCall left Int32 byteValue
argument underscoreCall right Int32 underscoreByte
run underscoreCall
bind value isUnderscore Bool underscoreCall
branch if condition isUnderscore target returnIdentifierTrue
call dollarCall math.equalInt32
argument dollarCall left Int32 byteValue
argument dollarCall right Int32 dollarByte
run dollarCall
bind value isDollar Bool dollarCall
branch if condition isDollar target returnIdentifierTrue
storage local immutable identifierFalse Bool false
return value identifierFalse
label returnIdentifierTrue
storage local immutable identifierTrue Bool true
return value identifierTrue

