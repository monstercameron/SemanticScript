# SemanticScript port of antirez/kilo.
# Optional upstream source can be cloned in experiments/kilo-port/upstream-kilo.
# Platform terminal behavior comes from the generic native_terminal runtime;
# editor behavior stays in this SemanticScript module.
module app.kiloport
purpose module app.kiloport "Kilo-style terminal editor ported to executable SemanticScript."
moduleOwns app.kiloport "Editor row storage, file load/save, ANSI terminal rendering, keyboard handling, search, and mutation flow."
moduleDoesNotOwn app.kiloport "SemanticScript compiler/runtime terminal primitives or the upstream Kilo C source."
invariant module app.kiloport "The edited file path comes from argv[1] when present, then KILO_FILE, otherwise kilo.txt."

exportType app.kiloport KiloKeyCode
exportType app.kiloport SaveFileStatus
exportOperation app.kiloport main

type KiloKeyCode Int32

enum SaveFileStatus repr Int32
enumCase SaveFileStatus SaveSucceeded 0
enumCase SaveFileStatus SaveOpenFailed 1
enumCase SaveFileStatus SaveWriteFailed 2
enumCase SaveFileStatus SaveCloseFailed 3

