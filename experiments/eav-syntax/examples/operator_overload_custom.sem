# operator_overload_custom — custom operator overloading
# (README §8). Tests defining custom operators.

OperatorOverloadCustom is project
OperatorOverloadCustom module examplesOperatorOverloadCustom
OperatorOverloadCustom target console
OperatorOverloadCustom entry main

examplesOperatorOverloadCustom is module
examplesOperatorOverloadCustom path examples.operatorOverloadCustom
examplesOperatorOverloadCustom exports main
examplesOperatorOverloadCustom purpose "Demonstrate custom operator overloading"
examplesOperatorOverloadCustom invariant "Operators can be overloaded"

ExitCode is alias
ExitCode for Int32

stdoutWriter is capability
stdoutWriter grants write console.stdout

main is operation
main out ExitCode
main effect write console.stdout
main uses stdoutWriter
main memory heap no
main async no
main purpose "Define custom operators"
main invariant "Operator overloading works"

main let result immutable Int64 13
main let okCode immutable ExitCode 0

main do printResult
main return okCode

printResult is call
printResult in main
printResult invokes console.writeIntegerLine
printResult arg value Int64 result
