# repr_enum_flags -- construct an enum value and discriminate it with branch ifVariant
# (README s10.5/s13), converging both arms to a single asserted outcome. Uses
# the standard.test harness: prints a PASS/FAIL line and a summary, exit 0 iff
# the assertion holds.
#
# Correctness observation: build Permissions.write; the matched arm sets outcome=2.
# Expected output:
#   PASS  repr_enum_flags  (expected 2, actual 2)
#   ---- 1 passed, 0 failed ----

ReprEnumFlags is project
ReprEnumFlags module examplesReprEnumFlags
ReprEnumFlags target console
ReprEnumFlags entry main

examplesReprEnumFlags is module
examplesReprEnumFlags path examples.reprEnumFlags
examplesReprEnumFlags exports main
examplesReprEnumFlags purpose "Discriminate a Permissions enum value and assert the outcome"
examplesReprEnumFlags invariant "Takes the matched arm only for the write variant"

ExitCode is alias
ExitCode for Int32
ExitCode purpose "Process exit status"

Permissions is enum
Permissions variant read repr 1
Permissions variant write repr 2
Permissions variant execute repr 4
Permissions purpose "An enum for variant discrimination"

stdoutWriter is capability
stdoutWriter grants write console.stdout
stdoutWriter purpose "Allow controlled writes to standard output"

main is operation
main out ExitCode
main effect write console.stdout
main uses stdoutWriter
main memory heap no
main async no
main purpose "Build Permissions.write, discriminate it, and assert the outcome"
main invariant "Asserts the matched-arm outcome via the test harness"
main let outcome mutable Int64 0
main let chosenMark immutable Int64 2
main let harnessName immutable String "repr_enum_flags"
main let harnessExpected immutable Int64 2
main let noopDecoy immutable Int64 0
main let noopName immutable String "repr_enum_flags: real result (not the no-op 0)"
main do makeValue
main branch ifVariant currentValue write goto isChosen
main goto afterMatch
main at isChosen set outcome chosenMark
main at afterMatch do checkResult
main do noopCheck
main do harnessReport
main return harnessSummaryCode

makeValue is call
makeValue in main
makeValue invokes Permissions.write
makeValue out currentValue Permissions

checkResult is call
checkResult in main
checkResult invokes test.assertEqualInt64
checkResult arg name String harnessName
checkResult arg expected Int64 harnessExpected
checkResult arg actual Int64 outcome

noopCheck is call
noopCheck in main
noopCheck invokes test.assertNotEqualInt64
noopCheck arg name String noopName
noopCheck arg expected Int64 noopDecoy
noopCheck arg actual Int64 outcome

harnessReport is call
harnessReport in main
harnessReport invokes test.summary
harnessReport out harnessSummaryCode ExitCode
