# variadic_arguments_pack — variadic function arguments and packing
# (README §8). Tests variable-length argument lists.

VariadicArgumentsPack is project
VariadicArgumentsPack module examplesVariadicArgumentsPack
VariadicArgumentsPack target console
VariadicArgumentsPack entry main

examplesVariadicArgumentsPack is module
examplesVariadicArgumentsPack path examples.variadicArgumentsPack
examplesVariadicArgumentsPack exports main
examplesVariadicArgumentsPack purpose "Demonstrate variadic arguments"
examplesVariadicArgumentsPack invariant "Variadic packing works"

ExitCode is alias
ExitCode for Int32

stdoutWriter is capability
stdoutWriter grants write console.stdout

main is operation
main out ExitCode
main effect write console.stdout
main uses stdoutWriter
main memory heap no
main async no
main purpose "Use variadic arguments"
main invariant "Variadic args work"

main let count immutable Int64 3
main let okCode immutable ExitCode 0

main do printCount
main return okCode

printCount is call
printCount in main
printCount invokes console.writeIntegerLine
printCount arg value Int64 count
