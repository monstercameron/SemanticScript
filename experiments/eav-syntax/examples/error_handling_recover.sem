# error_handling_recover -- recover from a fallible call via ifError (README s9/s18), converging the ok/err arms to a single
# asserted `outcome` via the standard.test harness. The write succeeds, so the
# no-error arm runs and outcome = 7.
# Expected output (the fallible write prints its banner first):
#   attempting recoverable write
#   PASS  error_handling_recover  (expected 7, actual 7)
#   ---- 1 passed, 0 failed ----

ErrorHandlingRecover is project
ErrorHandlingRecover module examplesErrorHandlingRecover
ErrorHandlingRecover target console
ErrorHandlingRecover entry main

examplesErrorHandlingRecover is module
examplesErrorHandlingRecover path examples.errorHandlingRecover
examplesErrorHandlingRecover exports main
examplesErrorHandlingRecover purpose "recover from a fallible call via ifError"
examplesErrorHandlingRecover invariant "Self-checking via the test harness"

ExitCode is alias
ExitCode for Int32
ExitCode purpose "Process exit status"

stdoutWriter is capability
stdoutWriter grants write console.stdout
stdoutWriter purpose "Allow controlled writes to standard output"

ConsoleWriteError is error
ConsoleWriteError purpose "Represent failures from console output operations"

ConsoleWriteFailed is errorCase
ConsoleWriteFailed of ConsoleWriteError
ConsoleWriteFailed payload Int32
ConsoleWriteFailed purpose "A failed stdout write with a status payload"

main is operation
main out ExitCode
main effect write console.stdout
main uses stdoutWriter
main memory heap no
main async no
main purpose "recover from a fallible call via ifError and assert the converged outcome"
main invariant "Asserts the ok-arm outcome via the harness"
main let outcome mutable Int64 99
main let okMark immutable Int64 7
main let bannerText immutable String "attempting recoverable write"
main let harnessName immutable String "error_handling_recover"
main let harnessExpected immutable Int64 7
main let noopDecoy immutable Int64 0
main let noopName immutable String "error_handling_recover: real result (not the no-op 0)"
main do writeOk
main branch ifError writeOk goto afterCheck
main set outcome okMark
main at afterCheck do checkResult
main do noopCheck
main do harnessReport
main return harnessSummaryCode

writeOk is call
writeOk in main
writeOk invokes console.writeLine
writeOk arg text String bannerText
writeOk catch writeError ConsoleWriteError

checkResult is call
checkResult in main
checkResult invokes test.assertEqualInt64
checkResult arg name String harnessName
checkResult arg expected Int64 harnessExpected
checkResult arg actual Int64 outcome

noopCheck is call
noopCheck in main
noopCheck invokes test.assertNotEqualInt64
noopCheck arg name String noopName
noopCheck arg expected Int64 noopDecoy
noopCheck arg actual Int64 outcome

harnessReport is call
harnessReport in main
harnessReport invokes test.summary
harnessReport out harnessSummaryCode ExitCode
