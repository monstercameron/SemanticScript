# convert_demo — explicit numeric conversion (README ss33.5). Widen an Int32 to
# Int64 (sext) and print it. (todos WS1-095, WS3-014)

ConvertDemo is project
ConvertDemo module examplesConvertDemo
ConvertDemo target console
ConvertDemo entry main

examplesConvertDemo is module
examplesConvertDemo path examples.convertDemo
examplesConvertDemo exports main
examplesConvertDemo purpose "Widen an Int32 to Int64 and print it"
examplesConvertDemo invariant "main is the only entry operation"

ExitCode is alias
ExitCode for Int32
ExitCode purpose "Process exit status"

stdoutWriter is capability
stdoutWriter grants write console.stdout
stdoutWriter purpose "Allow controlled writes to standard output"

main is operation
main out ExitCode
main effect write console.stdout
main uses stdoutWriter
main memory heap no
main async no
main purpose "Widen 200 (Int32) to Int64 and print it"
main invariant "Writes exactly one integer line: 200"
main let smallValue immutable Int32 200
main let okCode immutable ExitCode 0
main do widen
main do writeWide
main return okCode

widen is call
widen in main
widen invokes convert.toInt64
widen arg inputValue Int32 smallValue
widen out wideValue Int64

writeWide is call
writeWide in main
writeWide invokes console.writeIntegerLine
writeWide arg value Int64 wideValue
