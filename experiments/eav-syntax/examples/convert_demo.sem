# convert_demo — explicit numeric conversion (README ss33.5). Widen an Int32 to
# Expected output: 200
# Int64 (sext) and print it. (todos WS1-095, WS3-014)

ConvertDemo is project
ConvertDemo module examplesConvertDemo
ConvertDemo target console
ConvertDemo entry main

examplesConvertDemo is module
examplesConvertDemo path examples.convertDemo
examplesConvertDemo exports main
examplesConvertDemo purpose "Widen an Int32 to Int64 and print it"
examplesConvertDemo invariant "main is the only entry operation"

ExitCode is alias
ExitCode for Int32
ExitCode purpose "Process exit status"

stdoutWriter is capability
stdoutWriter grants write console.stdout
stdoutWriter purpose "Allow controlled writes to standard output"

main is operation
main out ExitCode
main effect write console.stdout
main uses stdoutWriter
main memory heap no
main async no
main purpose "Widen 200 (Int32) to Int64 and print it"
main invariant "Writes exactly one integer line: 200"
main let smallValue immutable Int32 200
main let harnessName immutable String "convert_demo"
main let harnessExpected immutable Int64 200
main let noopDecoy immutable Int64 0
main let noopName immutable String "convert_demo: real result (not the no-op 0)"
main do widen
main do writeWide
main do noopCheck
main do harnessReport
main return harnessSummaryCode

widen is call
widen in main
widen invokes convert.toInt64
widen arg inputValue Int32 smallValue
widen out wideValue Int64

writeWide is call
writeWide in main
writeWide invokes test.assertEqualInt64
writeWide arg name String harnessName
writeWide arg expected Int64 harnessExpected
writeWide arg actual Int64 wideValue


noopCheck is call
noopCheck in main
noopCheck invokes test.assertNotEqualInt64
noopCheck arg name String noopName
noopCheck arg expected Int64 noopDecoy
noopCheck arg actual Int64 wideValue

harnessReport is call
harnessReport in main
harnessReport invokes test.summary
harnessReport out harnessSummaryCode ExitCode