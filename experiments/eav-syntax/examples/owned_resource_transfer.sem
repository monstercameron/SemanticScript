# owned_resource_transfer — transfer of owned resources
# (README §14). Tests moving ownership of resources.

OwnedResourceTransfer is project
OwnedResourceTransfer module examplesOwnedResourceTransfer
OwnedResourceTransfer target console
OwnedResourceTransfer entry main

examplesOwnedResourceTransfer is module
examplesOwnedResourceTransfer path examples.ownedResourceTransfer
examplesOwnedResourceTransfer exports main
examplesOwnedResourceTransfer purpose "Demonstrate owned resource transfer"
examplesOwnedResourceTransfer invariant "Ownership transfers are correct"

ExitCode is alias
ExitCode for Int32

stdoutWriter is capability
stdoutWriter grants write console.stdout

main is operation
main out ExitCode
main effect write console.stdout
main uses stdoutWriter
main memory heap no
main async no
main purpose "Transfer owned resources"
main invariant "Resource ownership is well-defined"

main let owned immutable Int64 123
main let okCode immutable ExitCode 0

main do printOwned
main return okCode

printOwned is call
printOwned in main
printOwned invokes console.writeIntegerLine
printOwned arg value Int64 owned
