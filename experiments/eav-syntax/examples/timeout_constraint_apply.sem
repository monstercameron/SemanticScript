# timeout_constraint_apply — timeout constraint on calls
# (README §15). Tests applying timeouts to operations.

TimeoutConstraintApply is project
TimeoutConstraintApply module examplesTimeoutConstraintApply
TimeoutConstraintApply target console
TimeoutConstraintApply entry main

examplesTimeoutConstraintApply is module
examplesTimeoutConstraintApply path examples.timeoutConstraintApply
examplesTimeoutConstraintApply exports main
examplesTimeoutConstraintApply purpose "Demonstrate timeout constraint"
examplesTimeoutConstraintApply invariant "Timeouts are enforced"

ExitCode is alias
ExitCode for Int32

stdoutWriter is capability
stdoutWriter grants write console.stdout

main is operation
main out ExitCode
main effect write console.stdout
main uses stdoutWriter
main memory heap no
main async no
main purpose "Apply timeout constraint"
main invariant "Timeout works"

main let deadline immutable Int64 5000
main let okCode immutable ExitCode 0

main do printDeadline
main return okCode

printDeadline is call
printDeadline in main
printDeadline invokes console.writeIntegerLine
printDeadline arg value Int64 deadline
