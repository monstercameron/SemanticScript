# lifetime_borrow_conflict — lifetime borrow conflict detection
# (README §14). Tests detecting conflicting borrows.

LifetimeBorrowConflict is project
LifetimeBorrowConflict module examplesLifetimeBorrowConflict
LifetimeBorrowConflict target console
LifetimeBorrowConflict entry main

examplesLifetimeBorrowConflict is module
examplesLifetimeBorrowConflict path examples.lifetimeBorrowConflict
examplesLifetimeBorrowConflict exports main
examplesLifetimeBorrowConflict purpose "Demonstrate lifetime borrow conflict detection"
examplesLifetimeBorrowConflict invariant "Borrow conflicts are prevented"

ExitCode is alias
ExitCode for Int32

main is operation
main out ExitCode
main memory heap no
main async no
main purpose "Detect borrow conflicts"
main invariant "Conflict detection works"

main let code immutable ExitCode 0
main return code
