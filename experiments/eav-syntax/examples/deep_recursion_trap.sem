# deep_recursion_trap — deep recursion stack overflow (negative test)
# (README §9). Tests that stack overflow traps on deep recursion.

DeepRecursionTrap is project
DeepRecursionTrap module examplesDeepRecursionTrap
DeepRecursionTrap target console
DeepRecursionTrap entry main

examplesDeepRecursionTrap is module
examplesDeepRecursionTrap path examples.deepRecursionTrap
examplesDeepRecursionTrap exports main
examplesDeepRecursionTrap purpose "Demonstrate stack overflow trap on deep recursion"
examplesDeepRecursionTrap invariant "Stack depth is bounded"

ExitCode is alias
ExitCode for Int32

stdoutWriter is capability
stdoutWriter grants write console.stdout

countDown is operation
countDown in n Int64
countDown out Int64
countDown async no

countDown let one immutable Int64 1
countDown do checkZero
countDown return result

checkZero is call
checkZero in countDown
checkZero invokes math.lessThanOrEqualInt64
checkZero arg left Int64 n
checkZero arg right Int64 one
checkZero out isZero Bool

main is operation
main out ExitCode
main effect write console.stdout
main uses stdoutWriter
main memory heap no
main async no
main purpose "Trigger stack overflow with deep recursion"
main invariant "Stack overflow is trapped"

main let deepLimit immutable Int64 1000000
main let okCode immutable ExitCode 0

main do recurse
main return okCode

recurse is call
recurse in main
recurse invokes countDown
recurse arg n Int64 deepLimit
