# enum_lifecycle_states -- construct an enum value and discriminate it with branch ifVariant
# (README s10.5/s13), converging both arms to a single asserted outcome. Uses
# the standard.test harness: prints a PASS/FAIL line and a summary, exit 0 iff
# the assertion holds.
#
# Correctness observation: build State.deleted; the matched arm sets outcome=3.
# Expected output:
#   PASS  enum_lifecycle_states  (expected 3, actual 3)
#   ---- 1 passed, 0 failed ----

EnumLifecycleStates is project
EnumLifecycleStates module examplesEnumLifecycleStates
EnumLifecycleStates target console
EnumLifecycleStates entry main

examplesEnumLifecycleStates is module
examplesEnumLifecycleStates path examples.enumLifecycleStates
examplesEnumLifecycleStates exports main
examplesEnumLifecycleStates purpose "Discriminate a State enum value and assert the outcome"
examplesEnumLifecycleStates invariant "Takes the matched arm only for the deleted variant"

ExitCode is alias
ExitCode for Int32
ExitCode purpose "Process exit status"

State is enum
State variant created
State variant listed
State variant deleted
State purpose "An enum for variant discrimination"

stdoutWriter is capability
stdoutWriter grants write console.stdout
stdoutWriter purpose "Allow controlled writes to standard output"

main is operation
main out ExitCode
main effect write console.stdout
main uses stdoutWriter
main memory heap no
main async no
main purpose "Build State.deleted, discriminate it, and assert the outcome"
main invariant "Asserts the matched-arm outcome via the test harness"
main let outcome mutable Int64 0
main let chosenMark immutable Int64 3
main let harnessName immutable String "enum_lifecycle_states"
main let harnessExpected immutable Int64 3
main let noopDecoy immutable Int64 0
main let noopName immutable String "enum_lifecycle_states: real result (not the no-op 0)"
main do makeValue
main branch ifVariant currentValue deleted goto isChosen
main goto afterMatch
main at isChosen set outcome chosenMark
main at afterMatch do checkResult
main do noopCheck
main do harnessReport
main return harnessSummaryCode

makeValue is call
makeValue in main
makeValue invokes State.deleted
makeValue out currentValue State

checkResult is call
checkResult in main
checkResult invokes test.assertEqualInt64
checkResult arg name String harnessName
checkResult arg expected Int64 harnessExpected
checkResult arg actual Int64 outcome

noopCheck is call
noopCheck in main
noopCheck invokes test.assertNotEqualInt64
noopCheck arg name String noopName
noopCheck arg expected Int64 noopDecoy
noopCheck arg actual Int64 outcome

harnessReport is call
harnessReport in main
harnessReport invokes test.summary
harnessReport out harnessSummaryCode ExitCode
