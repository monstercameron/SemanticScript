# record_named_fields -- (repurposed from named_parameter_binding (no named params)) build a record and read a field back (Record.new / Record.field,
# lowered to LLVM insert/extractvalue, README s10). The printed value is read
# from the constructed record, not a constant.
#
# Correctness observation: build Named{alpha=4, beta=16}; read beta.
# Expected output: 16

RecordNamedFields is project
RecordNamedFields module examplesRecordNamedFields
RecordNamedFields target console
RecordNamedFields entry main

examplesRecordNamedFields is module
examplesRecordNamedFields path examples.recordNamedFields
examplesRecordNamedFields exports main
examplesRecordNamedFields purpose "Build a Named record and read its beta field"
examplesRecordNamedFields invariant "Prints the beta field of the built record"

ExitCode is alias
ExitCode for Int32
ExitCode purpose "Process exit status"

stdoutWriter is capability
stdoutWriter grants write console.stdout
stdoutWriter purpose "Allow controlled writes to standard output"

Named is record
Named field alpha Int64
Named field beta Int64
Named purpose "A two-field record"

main is operation
main out ExitCode
main effect write console.stdout
main uses stdoutWriter
main memory heap no
main async no
main purpose "Build Named and print its beta field"
main invariant "Writes exactly one integer line: 16"
main let firstInput immutable Int64 4
main let secondInput immutable Int64 16
main let okCode immutable ExitCode 0
main let harnessName immutable String "record_named_fields"
main let harnessExpected immutable Int64 16
main let noopDecoy immutable Int64 0
main let noopName immutable String "record_named_fields: real result (not the no-op 0)"
main do buildRec
main do readField
main do writeField
main do noopCheck
main do harnessReport
main return harnessSummaryCode

buildRec is call
buildRec in main
buildRec invokes Named.new
buildRec arg alpha Int64 firstInput
buildRec arg beta Int64 secondInput
buildRec out built Named

readField is call
readField in main
readField invokes Named.beta
readField arg record Named built
readField out fieldOut Int64

writeField is call
writeField in main
writeField invokes test.assertEqualInt64
writeField arg name String harnessName
writeField arg expected Int64 harnessExpected
writeField arg actual Int64 fieldOut


noopCheck is call
noopCheck in main
noopCheck invokes test.assertNotEqualInt64
noopCheck arg name String noopName
noopCheck arg expected Int64 noopDecoy
noopCheck arg actual Int64 fieldOut

harnessReport is call
harnessReport in main
harnessReport invokes test.summary
harnessReport out harnessSummaryCode ExitCode