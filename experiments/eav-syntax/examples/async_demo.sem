# async_demo — async task on the single-thread backend (README ss13):
# Expected output: 42
# `start` runs eagerly, `ifReady` is always taken, the pending path never runs.
# Doubles 21 -> 42 in a task and prints it. (todos WS1-107, WS1-065, WS3-003)

AsyncDemo is project
AsyncDemo module examplesAsyncDemo
AsyncDemo target console
AsyncDemo entry main

examplesAsyncDemo is module
examplesAsyncDemo path examples.asyncDemo
examplesAsyncDemo exports main
examplesAsyncDemo purpose "Start a task, poll it ready, and print its result"
examplesAsyncDemo invariant "On the single-thread backend the task completes at start"

ExitCode is alias
ExitCode for Int32
ExitCode purpose "Process exit status"

stdoutWriter is capability
stdoutWriter grants write console.stdout
stdoutWriter purpose "Allow controlled writes to standard output"

doubleIt is operation
doubleIt in n Int64
doubleIt out Int64
doubleIt memory heap no
doubleIt async no
doubleIt purpose "Return n doubled"
doubleIt invariant "Result is exactly 2*n"
doubleIt let two immutable Int64 2
doubleIt do mulCall
doubleIt return doubled

mulCall is call
mulCall in doubleIt
mulCall invokes math.multiplyInt64
mulCall arg left Int64 n
mulCall arg right Int64 two
mulCall out doubled Int64

main is operation
main out ExitCode
main effect write console.stdout
main uses stdoutWriter
main memory heap no
main async yes
main purpose "Start the double task, await readiness, print the result"
main invariant "Prints 42; the pending branch is unreachable on single-thread"
main let seed immutable Int64 21
main let okCode immutable ExitCode 0
main let harnessName immutable String "async_demo"
main let harnessExpected immutable Int64 42
main let noopDecoy immutable Int64 0
main let noopName immutable String "async_demo: real result (not the no-op 0)"
main start computeTask
main poll computeTask
main branch ifReady computeTask goto useResult
main return okCode
main at useResult do writeResult
main do noopCheck
main do harnessReport
main return harnessSummaryCode

computeTask is task
computeTask in main
computeTask invokes doubleIt
computeTask arg n Int64 seed
computeTask out answer Int64

writeResult is call
writeResult in main
writeResult invokes test.assertEqualInt64
writeResult arg name String harnessName
writeResult arg expected Int64 harnessExpected
writeResult arg actual Int64 answer


noopCheck is call
noopCheck in main
noopCheck invokes test.assertNotEqualInt64
noopCheck arg name String noopName
noopCheck arg expected Int64 noopDecoy
noopCheck arg actual Int64 answer

harnessReport is call
harnessReport in main
harnessReport invokes test.summary
harnessReport out harnessSummaryCode ExitCode