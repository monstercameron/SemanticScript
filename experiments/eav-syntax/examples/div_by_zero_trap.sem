# div_by_zero_trap — division by zero must trap (negative test)
# (README §10.6 / §33.5). A program that divides by zero should fail with exit code != 0.
# This is a negative test case (X-201) for the math exception handling.

DivByZeroTrap is project
DivByZeroTrap module examplesDivByZeroTrap
DivByZeroTrap target console
DivByZeroTrap entry main

examplesDivByZeroTrap is module
examplesDivByZeroTrap path examples.divByZeroTrap
examplesDivByZeroTrap exports main
examplesDivByZeroTrap purpose "Demonstrate that division by zero traps"
examplesDivByZeroTrap invariant "main performs a div-by-zero trap"

ExitCode is alias
ExitCode for Int32

stdoutWriter is capability
stdoutWriter grants write console.stdout

main is operation
main out ExitCode
main effect write console.stdout
main uses stdoutWriter
main memory heap no
main async no
main purpose "Perform a division by zero, which should trap"
main invariant "This operation should never complete normally"

main let dividend immutable Int64 42
main let divisor immutable Int64 0
main do divideCall
main return failureCode

divideCall is call
divideCall in main
divideCall invokes math.divideInt64
divideCall arg left Int64 dividend
divideCall arg right Int64 divisor
divideCall out result Int64

failureCode is let
failureCode immutable ExitCode 1
