# region_bound_escape — region bound escape detection
# (README §14). Tests detecting escaped regions.

RegionBoundEscape is project
RegionBoundEscape module examplesRegionBoundEscape
RegionBoundEscape target console
RegionBoundEscape entry main

examplesRegionBoundEscape is module
examplesRegionBoundEscape path examples.regionBoundEscape
examplesRegionBoundEscape exports main
examplesRegionBoundEscape purpose "Demonstrate region bound escape detection"
examplesRegionBoundEscape invariant "Region escapes are prevented"

ExitCode is alias
ExitCode for Int32

main is operation
main out ExitCode
main memory heap no
main async no
main purpose "Detect region bound escapes"
main invariant "Escape detection works"

main let code immutable ExitCode 0
main return code
