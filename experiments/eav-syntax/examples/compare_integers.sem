# compare_integers -- integer comparisons in both directions. Load-bearing: POSITIVE and NEGATIVE assertions (false-cases,
# inequalities, edge cases) stress the language in both directions via the
# standard.test harness. Exit 0 iff every assertion holds.
# Expected output: 3 PASS lines then  ---- 3 passed, 0 failed ----

CompareIntegers is project
CompareIntegers module examplesCompareIntegers
CompareIntegers target console
CompareIntegers entry main

examplesCompareIntegers is module
examplesCompareIntegers path examples.compareIntegers
examplesCompareIntegers exports main
examplesCompareIntegers purpose "integer comparisons in both directions"
examplesCompareIntegers invariant "Positive and negative assertions both hold"

ExitCode is alias
ExitCode for Int32
ExitCode purpose "Process exit status"

stdoutWriter is capability
stdoutWriter grants write console.stdout
stdoutWriter purpose "Allow controlled writes to standard output"

main is operation
main out ExitCode
main effect write console.stdout
main uses stdoutWriter
main memory heap no
main async no
main purpose "integer comparisons in both directions"
main invariant "All assertions hold"
main let aVal immutable Int64 10
main let bVal immutable Int64 20
main let tn0 immutable String "less: 10 < 20"
main let tn1 immutable String "less: 20 < 10 is false"
main let tn2 immutable String "equal: 10 == 10"
main do ltTrueCall
main do ltFalseCall
main do eqCall
main do check0
main do check1
main do check2
main do harnessReport
main return harnessSummaryCode

ltTrueCall is call
ltTrueCall in main
ltTrueCall invokes math.lessThanInt64
ltTrueCall arg left Int64 aVal
ltTrueCall arg right Int64 bVal
ltTrueCall out ltTrue Bool

ltFalseCall is call
ltFalseCall in main
ltFalseCall invokes math.lessThanInt64
ltFalseCall arg left Int64 bVal
ltFalseCall arg right Int64 aVal
ltFalseCall out ltFalse Bool

eqCall is call
eqCall in main
eqCall invokes math.equalInt64
eqCall arg left Int64 aVal
eqCall arg right Int64 aVal
eqCall out eqSame Bool

check0 is call
check0 in main
check0 invokes test.assertTrue
check0 arg name String tn0
check0 arg value Bool ltTrue

check1 is call
check1 in main
check1 invokes test.assertFalse
check1 arg name String tn1
check1 arg value Bool ltFalse

check2 is call
check2 in main
check2 invokes test.assertTrue
check2 arg name String tn2
check2 arg value Bool eqSame

harnessReport is call
harnessReport in main
harnessReport invokes test.summary
harnessReport out harnessSummaryCode ExitCode
