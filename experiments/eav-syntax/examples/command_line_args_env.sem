# command_line_args_env — command-line arguments and environment
# (README §19). Tests CLI argument parsing and environment access.

CommandLineArgsEnv is project
CommandLineArgsEnv module examplesCommandLineArgsEnv
CommandLineArgsEnv target console
CommandLineArgsEnv entry main

examplesCommandLineArgsEnv is module
examplesCommandLineArgsEnv path examples.commandLineArgsEnv
examplesCommandLineArgsEnv exports main
examplesCommandLineArgsEnv purpose "Demonstrate CLI args and environment"
examplesCommandLineArgsEnv invariant "Args and env access works"

ExitCode is alias
ExitCode for Int32

stdoutWriter is capability
stdoutWriter grants write console.stdout

main is operation
main out ExitCode
main effect write console.stdout
main uses stdoutWriter
main memory heap no
main async no
main purpose "Access command-line arguments and environment"
main invariant "Args/env access works"

main let argCount immutable Int64 0
main let okCode immutable ExitCode 0

main do printArgCount
main return okCode

printArgCount is call
printArgCount in main
printArgCount invokes console.writeIntegerLine
printArgCount arg value Int64 argCount
