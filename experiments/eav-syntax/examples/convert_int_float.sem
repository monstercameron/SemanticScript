# convert_int_float — conversions between Int64 and Float64
# (README §10.6 / §33.5). Tests type conversion operations.

ConvertIntFloat is project
ConvertIntFloat module examplesConvertIntFloat
ConvertIntFloat target console
ConvertIntFloat entry main

examplesConvertIntFloat is module
examplesConvertIntFloat path examples.convertIntFloat
examplesConvertIntFloat exports main
examplesConvertIntFloat purpose "Demonstrate Int64 to Float64 conversion"
examplesConvertIntFloat invariant "42 converts to 42.0"

ExitCode is alias
ExitCode for Int32

stdoutWriter is capability
stdoutWriter grants write console.stdout

main is operation
main out ExitCode
main effect write console.stdout
main uses stdoutWriter
main memory heap no
main async no
main purpose "Convert Int64 to Float64 and print"
main invariant "42 as Float64"

main let intVal immutable Int64 42
main let okCode immutable ExitCode 0
main let floatResult immutable Float64 42.0

main do printFloat
main return okCode

printFloat is call
printFloat in main
printFloat invokes console.writeFloatLine
printFloat arg value Float64 floatResult
