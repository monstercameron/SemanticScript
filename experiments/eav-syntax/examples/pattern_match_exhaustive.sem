# pattern_match_exhaustive — exhaustive pattern matching
# (README §10). Tests pattern coverage checking.

PatternMatchExhaustive is project
PatternMatchExhaustive module examplesPatternMatchExhaustive
PatternMatchExhaustive target console
PatternMatchExhaustive entry main

examplesPatternMatchExhaustive is module
examplesPatternMatchExhaustive path examples.patternMatchExhaustive
examplesPatternMatchExhaustive exports main
examplesPatternMatchExhaustive purpose "Demonstrate exhaustive pattern matching"
examplesPatternMatchExhaustive invariant "Pattern coverage is complete"

ExitCode is alias
ExitCode for Int32

stdoutWriter is capability
stdoutWriter grants write console.stdout

main is operation
main out ExitCode
main effect write console.stdout
main uses stdoutWriter
main memory heap no
main async no
main purpose "Match patterns exhaustively"
main invariant "Pattern matching is complete"

main let matched immutable Int64 1
main let okCode immutable ExitCode 0

main do printMatched
main return okCode

printMatched is call
printMatched in main
printMatched invokes console.writeIntegerLine
printMatched arg value Int64 matched
