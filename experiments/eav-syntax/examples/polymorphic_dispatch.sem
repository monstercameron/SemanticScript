# polymorphic_dispatch — polymorphic function dispatch
# (README §8). Tests dispatching based on type.

PolymorphicDispatch is project
PolymorphicDispatch module examplesPolymorphicDispatch
PolymorphicDispatch target console
PolymorphicDispatch entry main

examplesPolymorphicDispatch is module
examplesPolymorphicDispatch path examples.polymorphicDispatch
examplesPolymorphicDispatch exports main
examplesPolymorphicDispatch purpose "Demonstrate polymorphic dispatch"
examplesPolymorphicDispatch invariant "Type-based dispatch is well-formed"

ExitCode is alias
ExitCode for Int32

stdoutWriter is capability
stdoutWriter grants write console.stdout

main is operation
main out ExitCode
main effect write console.stdout
main uses stdoutWriter
main memory heap no
main async no
main purpose "Use polymorphic dispatch by type"
main invariant "Polymorphism works"

main let intValue immutable Int64 7
main let okCode immutable ExitCode 0

main do printValue
main return okCode

printValue is call
printValue in main
printValue invokes console.writeIntegerLine
printValue arg value Int64 intValue
