# string_concat_unicode -- (repurposed: unicode_normalization (no normalization runtime)). Real string.concat (README s30.2.2).
# Expected output: unicode

StringConcatUnicode is project
StringConcatUnicode module examplesStringConcatUnicode
StringConcatUnicode target console
StringConcatUnicode entry main

examplesStringConcatUnicode is module
examplesStringConcatUnicode path examples.stringConcatUnicode
examplesStringConcatUnicode exports main
examplesStringConcatUnicode purpose "Compute stringConcatUnicode at runtime"
examplesStringConcatUnicode invariant "Result is computed at runtime"

ExitCode is alias
ExitCode for Int32
ExitCode purpose "Process exit status"

stdoutWriter is capability
stdoutWriter grants write console.stdout
stdoutWriter purpose "Allow controlled writes to standard output"

main is operation
main out ExitCode
main effect write console.stdout
main uses stdoutWriter
main memory heap no
main async no
main purpose "Concatenate two strings and print"
main invariant "Writes exactly one line: unicode"
main let partOne immutable String "uni"
main let partTwo immutable String "code"
main let okCode immutable ExitCode 0
main let harnessName immutable String "string_concat_unicode"
main let harnessExpected immutable String "unicode"
main let emptyGuard immutable String ""
main let noopName immutable String "string_concat_unicode: real result (not the empty string)"
main do calc
main do writeResult
main do noopCheck
main do harnessReport
main return harnessSummaryCode

calc is call
calc in main
calc invokes string.concat
calc arg left String partOne
calc arg right String partTwo
calc out outValue String

writeResult is call
writeResult in main
writeResult invokes test.assertEqualText
writeResult arg name String harnessName
writeResult arg expected String harnessExpected
writeResult arg actual String outValue


noopCheck is call
noopCheck in main
noopCheck invokes test.assertNotEqualText
noopCheck arg name String noopName
noopCheck arg expected String emptyGuard
noopCheck arg actual String outValue

harnessReport is call
harnessReport in main
harnessReport invokes test.summary
harnessReport out harnessSummaryCode ExitCode