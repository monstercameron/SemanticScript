main do saveOnQuitSucceededCall
main branch if saveOnQuitSucceeded goto useSavedExitMessage
main set exitMessage quitSaveFailedText
main goto clearAndExitProgram
main at useSavedExitMessage set exitMessage goodbyeText
main goto clearAndExitProgram
main at clearAndExitProgram do showCursorOnQuitCall
main do clearScreenOnQuitCall
main do goodbyeCall
main do freeDoneCall
main do freeTitlesCall
main do freeEditCall
main return successfulExitCode

