main branch if editIsEmpty goto ignoreEmptyEdit
main do selectedExistingForCommitCall
main branch if selectedExistingForCommit goto commitExistingEdit
main do capacityForAppendCheckCall
main branch if appendWouldOverflow goto listFullOnCommit
main do appendTodoCall
main set todoCount incrementedTodoCount
main set statusMessage savedText
main goto persistTodosThenLoop
main at commitExistingEdit do commitExistingEditCall
main set statusMessage savedText
main goto persistTodosThenLoop
main at ignoreEmptyEdit set screenMode ListMode
main set editLength zeroValue
main set statusMessage emptyIgnoredText
main goto replLoop
main at listFullOnCommit set screenMode ListMode
main set editLength zeroValue
main set statusMessage listFullText
main goto replLoop
main at toggleSelectedTodo do selectedExistingForToggleCall
main branch if selectedExistingForToggle goto toggleExistingTodo
main set statusMessage noTodoText
main goto replLoop
main at toggleExistingTodo do toggleSelectedTodoCall
main set statusMessage toggledText
main goto persistTodosThenLoop
main at deleteSelectedTodo do selectedExistingForDeleteCall
main branch if selectedExistingForDelete goto deleteExistingTodo
main set statusMessage noTodoText
main goto replLoop
main at deleteExistingTodo do deleteSelectedTodoCall
main set todoCount decrementedTodoCount
main do selectionPastCountCheckCall
main branch if selectionPastCount goto clampSelectionAfterDelete
main goto deleteStatusAndPersist
main at clampSelectionAfterDelete do countIsZeroCheckCall
main branch if countIsZero goto setSelectionZeroAfterDelete
main do lastIndexAfterDeleteCall
main set selectedIndex lastIndexAfterDelete
main goto deleteStatusAndPersist
main at setSelectionZeroAfterDelete set selectedIndex zeroValue
main goto deleteStatusAndPersist
main at deleteStatusAndPersist do clampTopAfterDeleteCall
main set topIndex clampedTopAfterDelete
main set statusMessage deletedText
main goto persistTodosThenLoop
main at persistTodosThenLoop set screenMode ListMode
main set editLength zeroValue
main do saveTodosAfterChangeCall
main do saveAfterChangeSucceededCall
main branch if saveAfterChangeSucceeded goto replLoop
main set statusMessage saveFailedText
main goto replLoop
main at doneArrayAllocationFailed do allocationFailedDoneCall
main return failExitCode
main at titlesArrayAllocationFailed do allocationFailedTitlesCall
main do freeDoneAfterTitlesFailureCall
main return failExitCode
main at editBufferAllocationFailed do allocationFailedEditCall
main do freeDoneAfterEditFailureCall
main do freeTitlesAfterEditFailureCall
main return failExitCode
main at lineBufferAllocationFailed do allocationFailedLineCall
main do freeDoneAfterLineFailureCall
main do freeTitlesAfterLineFailureCall
main do freeEditAfterLineFailureCall
main return failExitCode
