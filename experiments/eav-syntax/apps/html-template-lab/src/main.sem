# html-template-lab — EAV port (apps/html-template-lab, semsc v0.1 §16 showcase).
#
# Renders the COMPLETE todo dashboard HTML document via an `htmlTemplate` island
# with `{{hole}}` substitution through `html.render` (X-011 runtime): the literal
# segments are interleaved with the auto-escaped hole values. This is the §16
# html-template form (not a single string.concat) — it JIT-runs and builds to a
# native exe, printing the full hydrated document. (X-040)


appHtmlTemplateLab is module
appHtmlTemplateLab path apps.htmlTemplateLab
appHtmlTemplateLab exports main
appHtmlTemplateLab purpose "Render the full todo dashboard HTML document"
appHtmlTemplateLab invariant "All dynamic holes are HTML-escaped by html.render"

ExitCode is alias
ExitCode for Int32

stdoutWriter is capability
stdoutWriter grants write console.stdout
stdoutWriter purpose "Allow controlled writes to standard output"

dashboardPage is htmlTemplate
dashboardPage body html
    <!doctype html>
    <html lang="en"><head><title>{{pageTitle}}</title></head>
    <body><main class="todo-shell"><h1>{{pageTitle}}</h1>
    <ol class="todo-list">
    <li class="{{firstClass}}"><span class="todo-title">{{firstTitle}}</span><span class="todo-status">{{firstStatus}}</span></li>
    <li class="{{secondClass}}"><span class="todo-title">{{secondTitle}}</span><span class="todo-status">{{secondStatus}}</span></li>
    </ol></main></body></html>

main is operation
main out ExitCode
main effect write console.stdout
main uses stdoutWriter
main async no
main memory heap no
main purpose "Hydrate the dashboard template and print the rendered HTML"
main invariant "Writes the complete escaped HTML document"
main let pageTitle immutable String "TaskForge <Today>"
main let firstClass immutable String "todo done"
main let firstTitle immutable String "Buy <milk> & eggs"
main let firstStatus immutable String "done"
main let secondClass immutable String "todo open"
main let secondTitle immutable String "Ship the report"
main let secondStatus immutable String "open"
main let okCode immutable ExitCode 0
main do renderDashboard
main do writeDashboard
main return okCode

renderDashboard is call
renderDashboard in main
renderDashboard invokes html.render
renderDashboard arg template HtmlTemplate dashboardPage
renderDashboard arg pageTitle String pageTitle
renderDashboard arg firstClass String firstClass
renderDashboard arg firstTitle String firstTitle
renderDashboard arg firstStatus String firstStatus
renderDashboard arg secondClass String secondClass
renderDashboard arg secondTitle String secondTitle
renderDashboard arg secondStatus String secondStatus
renderDashboard out dashboardHtml String

writeDashboard is call
writeDashboard in main
writeDashboard invokes console.writeLine
writeDashboard arg text String dashboardHtml
