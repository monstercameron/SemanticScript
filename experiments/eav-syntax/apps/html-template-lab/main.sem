# html-template-lab — EAV port (apps/html-template-lab, originally semsc v0.1).
#
# Renders a todo dashboard list item to the console. Dynamic task text is escaped
# through standard.html `escapeText` (the runtime's HTML escaper) and assembled
# with string.concat — the running form of §16 HTML rendering (X-040). Compose
# this with std/standard.html.sem; compiles to a native exe and JIT-runs.

HtmlTemplateLab is project
HtmlTemplateLab module appHtmlTemplateLab
HtmlTemplateLab target console
HtmlTemplateLab entry main

appHtmlTemplateLab is module
appHtmlTemplateLab path apps.htmlTemplateLab
appHtmlTemplateLab exports main
appHtmlTemplateLab purpose "Render and print one escaped todo list item as HTML"
appHtmlTemplateLab invariant "The dynamic task title is HTML-escaped before composition"

ExitCode is alias
ExitCode for Int32

stdoutWriter is capability
stdoutWriter grants write console.stdout
stdoutWriter purpose "Allow controlled writes to standard output"

main is operation
main out ExitCode
main effect write console.stdout
main uses stdoutWriter
main async no
main memory heap no
main purpose "Escape a task title and print it inside an HTML list item"
main invariant "The printed HTML contains the escaped, not raw, title"
main let rawTitle immutable String "Buy <milk> & eggs"
main let openTag immutable String "<li class=\"task\">"
main let closeTag immutable String "</li>"
main let okCode immutable ExitCode 0
main do escapeTitle
main do composeOpen
main do composeFull
main do writeItem
main return okCode

escapeTitle is call
escapeTitle in main
escapeTitle invokes escapeText
escapeTitle arg text String rawTitle
escapeTitle out safeTitle String

composeOpen is call
composeOpen in main
composeOpen invokes string.concat
composeOpen arg left String openTag
composeOpen arg right String safeTitle
composeOpen out openPlusTitle String

composeFull is call
composeFull in main
composeFull invokes string.concat
composeFull arg left String openPlusTitle
composeFull arg right String closeTag
composeFull out itemHtml String

writeItem is call
writeItem in main
writeItem invokes console.writeLine
writeItem arg text String itemHtml
