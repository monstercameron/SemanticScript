label slotScanLoop
call slotScanAtEndCall math.greaterThanOrEqualI64
arg slotScanAtEndCall left slotScanCursor
arg slotScanAtEndCall right bufferEndOffset
run slotScanAtEndCall
bind slotScanAtEnd Bool slotScanAtEndCall
