project TodoWeb
target webServer
runtime native 1
module app.todo_web

webServer todoWebServer
purpose todoWebServer "Serve the Todo Web HTTP interface on localhost with a single hello route"
serverHost todoWebServer "127.0.0.1"
serverPort todoWebServer 18080
route todoWebServer GET "/" helloTodoWebHandler

operation helloTodoWebHandler
input helloTodoWebHandler request HttpRequest
input helloTodoWebHandler response HttpResponse
output helloTodoWebHandler CSignedInt32
effect helloTodoWebHandler write http.response
memory helloTodoWebHandler arena request
async helloTodoWebHandler no
purpose helloTodoWebHandler "Return a plain hello response for the Todo Web root route"
invariant helloTodoWebHandler "Every successful request writes exactly one text response"

label startHelloTodoWebHandler

const helloStatusCode CSignedInt32 200
const helloBody CNullTerminatedByteString "hello from todo web\n"

call writeHelloResponseCall http.responseText
arg writeHelloResponseCall response response
arg writeHelloResponseCall status helloStatusCode
arg writeHelloResponseCall body helloBody
run writeHelloResponseCall
bind writeHelloResponseStatus CSignedInt32 writeHelloResponseCall
returnValue writeHelloResponseStatus
