storage local immutable oneFlag CSignedInt64 1
storage local immutable normalMarkerText CNullTerminatedByteString " "
storage local immutable selectedMarkerText CNullTerminatedByteString ">"
storage local immutable openStatusText CNullTerminatedByteString "[ ]"
storage local immutable doneStatusText CNullTerminatedByteString "[x]"
storage local immutable emptyTitleText CNullTerminatedByteString "(empty slot)"
