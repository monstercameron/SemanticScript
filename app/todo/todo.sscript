branchIf slotIsDone setDoneStatus
branch printSlotLine
label setDoneStatus
set local statusText doneStatusText
branch printSlotLine
label printSlotLine
call printfSlotCall c.printf
arg printfSlotCall format todoFormatText
arg printfSlotCall marker markerText
arg printfSlotCall slot slotNumber
arg printfSlotCall status statusText
arg printfSlotCall title titleBuffer
run printfSlotCall
ignoreValue printfSlotCall CSignedInt32
returnValue printSucceededCode

