# Simple terminal todo app for the current SemanticScript compiler.
# Run from app/todo so todos.json lives beside todo.exe.
project TodoTuiApp
target console
runtime AgentRuntime 0.1
entry console main

type CAllocationError CSignedInt32
type CFileOpenError CSignedInt32

error MainError
errorCase MainError StartupAllocationFailed CAllocationError

operation readTuiKey
output readTuiKey CSignedInt32
effect readTuiKey read console.stdin
authority readTuiKey console.stdin read
memoryHeap readTuiKey no
async readTuiKey no
purpose readTuiKey "Read one no-echo console key and normalize Windows extended arrow key sequences."
invariant readTuiKey "Arrow keys return stable app-local key codes; ordinary keys return their raw byte."
label startReadTuiKey
storage local immutable extendedZeroPrefix CSignedInt32 0
storage local immutable extendedArrowPrefix CSignedInt32 224
storage local immutable rawArrowUpByte CSignedInt32 72
storage local immutable rawArrowDownByte CSignedInt32 80
storage local immutable rawArrowLeftByte CSignedInt32 75
storage local immutable rawArrowRightByte CSignedInt32 77
storage local immutable normalizedArrowUp CSignedInt32 1001
storage local immutable normalizedArrowDown CSignedInt32 1002
storage local immutable normalizedArrowLeft CSignedInt32 1003
storage local immutable normalizedArrowRight CSignedInt32 1004
call firstKeyCall c.consoleGetch
run firstKeyCall
bind firstKeyCode CSignedInt32 firstKeyCall
call zeroPrefixCheckCall math.equalI64
arg zeroPrefixCheckCall left firstKeyCode
arg zeroPrefixCheckCall right extendedZeroPrefix
run zeroPrefixCheckCall
bind isZeroPrefix Bool zeroPrefixCheckCall
branchIf isZeroPrefix readExtendedTuiKey
call arrowPrefixCheckCall math.equalI64
arg arrowPrefixCheckCall left firstKeyCode
arg arrowPrefixCheckCall right extendedArrowPrefix
run arrowPrefixCheckCall
bind isArrowPrefix Bool arrowPrefixCheckCall
branchIf isArrowPrefix readExtendedTuiKey
returnValue firstKeyCode
label readExtendedTuiKey
call secondKeyCall c.consoleGetch
run secondKeyCall
bind secondKeyCode CSignedInt32 secondKeyCall
call upArrowCheckCall math.equalI64
arg upArrowCheckCall left secondKeyCode
arg upArrowCheckCall right rawArrowUpByte
run upArrowCheckCall
bind isUpArrow Bool upArrowCheckCall
branchIf isUpArrow returnArrowUpKey
call downArrowCheckCall math.equalI64
arg downArrowCheckCall left secondKeyCode
arg downArrowCheckCall right rawArrowDownByte
run downArrowCheckCall
bind isDownArrow Bool downArrowCheckCall
branchIf isDownArrow returnArrowDownKey
call leftArrowCheckCall math.equalI64
arg leftArrowCheckCall left secondKeyCode
arg leftArrowCheckCall right rawArrowLeftByte
run leftArrowCheckCall
bind isLeftArrow Bool leftArrowCheckCall
branchIf isLeftArrow returnArrowLeftKey
call rightArrowCheckCall math.equalI64
arg rightArrowCheckCall left secondKeyCode
arg rightArrowCheckCall right rawArrowRightByte
run rightArrowCheckCall
bind isRightArrow Bool rightArrowCheckCall
branchIf isRightArrow returnArrowRightKey
returnValue secondKeyCode
label returnArrowUpKey
returnValue normalizedArrowUp
label returnArrowDownKey
returnValue normalizedArrowDown
label returnArrowLeftKey
returnValue normalizedArrowLeft
label returnArrowRightKey
returnValue normalizedArrowRight

operation readLineIntoBuffer
input readLineIntoBuffer targetBuffer COpaqueMemoryAddress
input readLineIntoBuffer bufferCapacity CSignedInt64
output readLineIntoBuffer Result CSignedInt64 Void
effect readLineIntoBuffer read console.stdin
effect readLineIntoBuffer write memory.buffer
authority readLineIntoBuffer console.stdin read
authority readLineIntoBuffer memory.buffer write
memoryHeap readLineIntoBuffer no
async readLineIntoBuffer no
purpose readLineIntoBuffer "Read one stdin line into targetBuffer, bounded by bufferCapacity."
invariant readLineIntoBuffer "The target buffer is always null-terminated before returning."
label startReadLineIntoBuffer
storage local immutable zeroIndex CSignedInt64 0
storage local immutable oneStep CSignedInt64 1
storage local immutable newlineByteForLine CSignedInt32 10
storage local immutable carriageReturnByteForLine CSignedInt32 13
storage local immutable eofByte CSignedInt32 -1
storage local immutable nulByte CSignedInt32 0
storage local mutable writeIndex CSignedInt64 zeroIndex
storage local mutable currentByte CSignedInt32 nulByte
call maxWritableIndexCall math.subtractI64
arg maxWritableIndexCall left bufferCapacity
arg maxWritableIndexCall right oneStep
run maxWritableIndexCall
bind maxWritableIndex CSignedInt64 maxWritableIndexCall
label skipLeadingLineTerminators
call firstReadCall c.getchar
run firstReadCall
bind firstReadByte CSignedInt32 firstReadCall
set local currentByte firstReadByte
call firstNewlineCheckCall math.equalI64
arg firstNewlineCheckCall left currentByte
arg firstNewlineCheckCall right newlineByteForLine
run firstNewlineCheckCall
bind firstIsNewline Bool firstNewlineCheckCall
branchIf firstIsNewline skipLeadingLineTerminators
call firstCarriageReturnCheckCall math.equalI64
arg firstCarriageReturnCheckCall left currentByte
arg firstCarriageReturnCheckCall right carriageReturnByteForLine
run firstCarriageReturnCheckCall
bind firstIsCarriageReturn Bool firstCarriageReturnCheckCall
branchIf firstIsCarriageReturn skipLeadingLineTerminators
branch storeCurrentByteIfNeeded
label readRemainingBytes
call nextReadCall c.getchar
run nextReadCall
bind nextReadByte CSignedInt32 nextReadCall
set local currentByte nextReadByte
label storeCurrentByteIfNeeded
call eofCheckCall math.equalI64
arg eofCheckCall left currentByte
arg eofCheckCall right eofByte
run eofCheckCall
bind isEof Bool eofCheckCall
branchIf isEof finishLineRead
call newlineCheckCall math.equalI64
arg newlineCheckCall left currentByte
arg newlineCheckCall right newlineByteForLine
run newlineCheckCall
bind isNewline Bool newlineCheckCall
branchIf isNewline finishLineRead
call carriageReturnCheckCall math.equalI64
arg carriageReturnCheckCall left currentByte
arg carriageReturnCheckCall right carriageReturnByteForLine
run carriageReturnCheckCall
bind isCarriageReturn Bool carriageReturnCheckCall
branchIf isCarriageReturn finishLineRead
call capacityCheckCall math.greaterThanOrEqualI64
arg capacityCheckCall left writeIndex
arg capacityCheckCall right maxWritableIndex
run capacityCheckCall
bind bufferFull Bool capacityCheckCall
branchIf bufferFull finishLineRead
call storeByteCall pointer.storeByte
arg storeByteCall buffer targetBuffer
arg storeByteCall offset writeIndex
arg storeByteCall value currentByte
run storeByteCall
call incrementIndexCall math.addI64
arg incrementIndexCall left writeIndex
arg incrementIndexCall right oneStep
run incrementIndexCall
bind nextWriteIndex CSignedInt64 incrementIndexCall
set local writeIndex nextWriteIndex
branch readRemainingBytes
label finishLineRead
call terminateBufferCall pointer.storeByte
arg terminateBufferCall buffer targetBuffer
arg terminateBufferCall offset writeIndex
arg terminateBufferCall value nulByte
run terminateBufferCall
returnOk writeIndex

