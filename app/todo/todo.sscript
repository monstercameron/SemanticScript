label loadTodosSkipped

label replLoop
call renderScreenCall renderScreen
arg renderScreenCall slotOneActive slotOneActive
arg renderScreenCall slotOneDone slotOneDone
arg renderScreenCall slotOneTitleBuffer slotOneTitleBuffer
arg renderScreenCall slotTwoActive slotTwoActive
arg renderScreenCall slotTwoDone slotTwoDone
arg renderScreenCall slotTwoTitleBuffer slotTwoTitleBuffer
arg renderScreenCall slotThreeActive slotThreeActive
arg renderScreenCall slotThreeDone slotThreeDone
arg renderScreenCall slotThreeTitleBuffer slotThreeTitleBuffer
arg renderScreenCall selectedSlot selectedSlot
arg renderScreenCall screenMode screenMode
arg renderScreenCall selectedAction selectedAction
arg renderScreenCall statusText statusMessage
run renderScreenCall
ignoreValue renderScreenCall CSignedInt32
call readKeyCall readTuiKey
run readKeyCall
bind pressedKey CSignedInt32 readKeyCall
call listModeCheckCall math.equalI64
arg listModeCheckCall left screenMode
arg listModeCheckCall right zeroValue
run listModeCheckCall
bind isListMode Bool listModeCheckCall
branchIf isListMode handleListKey
branch handleActionKey

label handleListKey
call listUpKeyCheckCall math.equalI64
arg listUpKeyCheckCall left pressedKey
arg listUpKeyCheckCall right keyArrowUp
run listUpKeyCheckCall
bind listUpPressed Bool listUpKeyCheckCall
branchIf listUpPressed moveSelectedSlotUp
call listDownKeyCheckCall math.equalI64
arg listDownKeyCheckCall left pressedKey
arg listDownKeyCheckCall right keyArrowDown
run listDownKeyCheckCall
bind listDownPressed Bool listDownKeyCheckCall
branchIf listDownPressed moveSelectedSlotDown
call listEnterKeyCheckCall math.equalI64
arg listEnterKeyCheckCall left pressedKey
arg listEnterKeyCheckCall right keyEnter
run listEnterKeyCheckCall
bind listEnterPressed Bool listEnterKeyCheckCall
branchIf listEnterPressed openActionsForSelectedSlot
call listRightKeyCheckCall math.equalI64
arg listRightKeyCheckCall left pressedKey
arg listRightKeyCheckCall right keyArrowRight
run listRightKeyCheckCall
bind listRightPressed Bool listRightKeyCheckCall
branchIf listRightPressed openActionsForSelectedSlot
call listEscapeKeyCheckCall math.equalI64
arg listEscapeKeyCheckCall left pressedKey
arg listEscapeKeyCheckCall right keyEscape
run listEscapeKeyCheckCall
bind listEscapePressed Bool listEscapeKeyCheckCall
branchIf listEscapePressed quitProgram
set local statusMessage ignoredKeyText
branch replLoop

label moveSelectedSlotUp
call selectedSlotIsOneForUpCall math.equalI64
arg selectedSlotIsOneForUpCall left selectedSlot
arg selectedSlotIsOneForUpCall right oneValue
run selectedSlotIsOneForUpCall
bind selectedSlotIsOneForUp Bool selectedSlotIsOneForUpCall
branchIf selectedSlotIsOneForUp wrapSelectedSlotToThree
call decrementSelectedSlotCall math.subtractI64
arg decrementSelectedSlotCall left selectedSlot
arg decrementSelectedSlotCall right oneValue
run decrementSelectedSlotCall
bind previousSelectedSlot CSignedInt64 decrementSelectedSlotCall
set local selectedSlot previousSelectedSlot
set local statusMessage readyStatusText
branch replLoop
label wrapSelectedSlotToThree
set local selectedSlot threeValue
set local statusMessage readyStatusText
branch replLoop

label moveSelectedSlotDown
call selectedSlotIsThreeForDownCall math.equalI64
arg selectedSlotIsThreeForDownCall left selectedSlot
arg selectedSlotIsThreeForDownCall right threeValue
run selectedSlotIsThreeForDownCall
bind selectedSlotIsThreeForDown Bool selectedSlotIsThreeForDownCall
branchIf selectedSlotIsThreeForDown wrapSelectedSlotToOne
call incrementSelectedSlotCall math.addI64
arg incrementSelectedSlotCall left selectedSlot
arg incrementSelectedSlotCall right oneValue
run incrementSelectedSlotCall
bind nextSelectedSlot CSignedInt64 incrementSelectedSlotCall
set local selectedSlot nextSelectedSlot
set local statusMessage readyStatusText
branch replLoop
label wrapSelectedSlotToOne
set local selectedSlot oneValue
set local statusMessage readyStatusText
branch replLoop

label openActionsForSelectedSlot
set local screenMode oneValue
set local selectedAction oneValue
set local statusMessage chooseActionText
branch replLoop

label handleActionKey
call actionUpKeyCheckCall math.equalI64
arg actionUpKeyCheckCall left pressedKey
arg actionUpKeyCheckCall right keyArrowUp
run actionUpKeyCheckCall
bind actionUpPressed Bool actionUpKeyCheckCall
branchIf actionUpPressed moveSelectedActionUp
call actionDownKeyCheckCall math.equalI64
arg actionDownKeyCheckCall left pressedKey
arg actionDownKeyCheckCall right keyArrowDown
run actionDownKeyCheckCall
bind actionDownPressed Bool actionDownKeyCheckCall
branchIf actionDownPressed moveSelectedActionDown
call actionEscapeKeyCheckCall math.equalI64
arg actionEscapeKeyCheckCall left pressedKey
arg actionEscapeKeyCheckCall right keyEscape
run actionEscapeKeyCheckCall
bind actionEscapePressed Bool actionEscapeKeyCheckCall
branchIf actionEscapePressed closeActionMenu
call actionLeftKeyCheckCall math.equalI64
arg actionLeftKeyCheckCall left pressedKey
arg actionLeftKeyCheckCall right keyArrowLeft
run actionLeftKeyCheckCall
bind actionLeftPressed Bool actionLeftKeyCheckCall
branchIf actionLeftPressed closeActionMenu
call actionEnterKeyCheckCall math.equalI64
arg actionEnterKeyCheckCall left pressedKey
arg actionEnterKeyCheckCall right keyEnter
run actionEnterKeyCheckCall
bind actionEnterPressed Bool actionEnterKeyCheckCall
branchIf actionEnterPressed executeSelectedAction
call actionRightKeyCheckCall math.equalI64
arg actionRightKeyCheckCall left pressedKey
arg actionRightKeyCheckCall right keyArrowRight
run actionRightKeyCheckCall
bind actionRightPressed Bool actionRightKeyCheckCall
branchIf actionRightPressed executeSelectedAction
set local statusMessage ignoredKeyText
branch replLoop

label moveSelectedActionUp
call selectedActionIsOneForUpCall math.equalI64
arg selectedActionIsOneForUpCall left selectedAction
arg selectedActionIsOneForUpCall right oneValue
run selectedActionIsOneForUpCall
bind selectedActionIsOneForUp Bool selectedActionIsOneForUpCall
branchIf selectedActionIsOneForUp wrapSelectedActionToFour
call decrementSelectedActionCall math.subtractI64
arg decrementSelectedActionCall left selectedAction
arg decrementSelectedActionCall right oneValue
run decrementSelectedActionCall
bind previousSelectedAction CSignedInt64 decrementSelectedActionCall
set local selectedAction previousSelectedAction
set local statusMessage chooseActionText
branch replLoop
label wrapSelectedActionToFour
set local selectedAction fourValue
set local statusMessage chooseActionText
branch replLoop

label moveSelectedActionDown
call selectedActionIsFourForDownCall math.equalI64
arg selectedActionIsFourForDownCall left selectedAction
arg selectedActionIsFourForDownCall right fourValue
run selectedActionIsFourForDownCall
bind selectedActionIsFourForDown Bool selectedActionIsFourForDownCall
branchIf selectedActionIsFourForDown wrapSelectedActionToOne
call incrementSelectedActionCall math.addI64
arg incrementSelectedActionCall left selectedAction
arg incrementSelectedActionCall right oneValue
run incrementSelectedActionCall
bind nextSelectedAction CSignedInt64 incrementSelectedActionCall
set local selectedAction nextSelectedAction
set local statusMessage chooseActionText
branch replLoop
label wrapSelectedActionToOne
set local selectedAction oneValue
set local statusMessage chooseActionText
branch replLoop

label executeSelectedAction
call addActionCheckCall math.equalI64
arg addActionCheckCall left selectedAction
arg addActionCheckCall right oneValue
run addActionCheckCall
bind addActionSelected Bool addActionCheckCall
branchIf addActionSelected addSelectedTodo
call toggleActionCheckCall math.equalI64
arg toggleActionCheckCall left selectedAction
arg toggleActionCheckCall right twoValue
run toggleActionCheckCall
bind toggleActionSelected Bool toggleActionCheckCall
branchIf toggleActionSelected toggleSelectedTodo
call deleteActionCheckCall math.equalI64
arg deleteActionCheckCall left selectedAction
arg deleteActionCheckCall right threeValue
run deleteActionCheckCall
bind deleteActionSelected Bool deleteActionCheckCall
branchIf deleteActionSelected deleteSelectedTodo
branch closeActionMenu

label closeActionMenu
set local screenMode zeroValue
set local selectedAction oneValue
set local statusMessage readyStatusText
branch replLoop

label addSelectedTodo
call addSelectedOneCheckCall math.equalI64
arg addSelectedOneCheckCall left selectedSlot
arg addSelectedOneCheckCall right oneValue
run addSelectedOneCheckCall
bind addSlotOneSelected Bool addSelectedOneCheckCall
branchIf addSlotOneSelected addTodoSlotOne
call addSelectedTwoCheckCall math.equalI64
arg addSelectedTwoCheckCall left selectedSlot
arg addSelectedTwoCheckCall right twoValue
run addSelectedTwoCheckCall
bind addSlotTwoSelected Bool addSelectedTwoCheckCall
branchIf addSlotTwoSelected addTodoSlotTwo
branch addTodoSlotThree

label addTodoSlotOne
call titlePromptOneCall c.printf
arg titlePromptOneCall format titlePromptText
run titlePromptOneCall
ignoreValue titlePromptOneCall CSignedInt32
call readSlotOneTitleCall readLineIntoBuffer
arg readSlotOneTitleCall targetBuffer slotOneTitleBuffer
arg readSlotOneTitleCall bufferCapacity titleBufferCapacity
run readSlotOneTitleCall
ignoreOk readSlotOneTitleCall CSignedInt64
set local slotOneActive oneValue
set local slotOneDone zeroValue
set local statusMessage addedOneText
branch persistTodosThenLoop
label addTodoSlotTwo
call titlePromptTwoCall c.printf
arg titlePromptTwoCall format titlePromptText
run titlePromptTwoCall
ignoreValue titlePromptTwoCall CSignedInt32
call readSlotTwoTitleCall readLineIntoBuffer
arg readSlotTwoTitleCall targetBuffer slotTwoTitleBuffer
arg readSlotTwoTitleCall bufferCapacity titleBufferCapacity
run readSlotTwoTitleCall
ignoreOk readSlotTwoTitleCall CSignedInt64
set local slotTwoActive oneValue
set local slotTwoDone zeroValue
set local statusMessage addedTwoText
branch persistTodosThenLoop
label addTodoSlotThree
call titlePromptThreeCall c.printf
arg titlePromptThreeCall format titlePromptText
run titlePromptThreeCall
ignoreValue titlePromptThreeCall CSignedInt32
call readSlotThreeTitleCall readLineIntoBuffer
arg readSlotThreeTitleCall targetBuffer slotThreeTitleBuffer
arg readSlotThreeTitleCall bufferCapacity titleBufferCapacity
run readSlotThreeTitleCall
ignoreOk readSlotThreeTitleCall CSignedInt64
set local slotThreeActive oneValue
set local slotThreeDone zeroValue
set local statusMessage addedThreeText
branch persistTodosThenLoop

label toggleSelectedTodo
call toggleSelectedOneCheckCall math.equalI64
arg toggleSelectedOneCheckCall left selectedSlot
arg toggleSelectedOneCheckCall right oneValue
run toggleSelectedOneCheckCall
bind toggleSlotOneSelected Bool toggleSelectedOneCheckCall
branchIf toggleSlotOneSelected toggleSlotOne
call toggleSelectedTwoCheckCall math.equalI64
arg toggleSelectedTwoCheckCall left selectedSlot
arg toggleSelectedTwoCheckCall right twoValue
run toggleSelectedTwoCheckCall
bind toggleSlotTwoSelected Bool toggleSelectedTwoCheckCall
branchIf toggleSlotTwoSelected toggleSlotTwo
branch toggleSlotThree
label toggleSlotOne
call toggleSlotOneActiveCheckCall math.equalI64
arg toggleSlotOneActiveCheckCall left slotOneActive
arg toggleSlotOneActiveCheckCall right oneValue
run toggleSlotOneActiveCheckCall
bind canToggleSlotOne Bool toggleSlotOneActiveCheckCall
branchIf canToggleSlotOne toggleSlotOneState
branch missingTodoForToggle
label toggleSlotOneState
call slotOneDoneIsZeroCall math.equalI64
arg slotOneDoneIsZeroCall left slotOneDone
arg slotOneDoneIsZeroCall right zeroValue
run slotOneDoneIsZeroCall
bind slotOneDoneIsZero Bool slotOneDoneIsZeroCall
branchIf slotOneDoneIsZero setSlotOneDone
set local slotOneDone zeroValue
branch toggledTodo
label setSlotOneDone
set local slotOneDone oneValue
branch toggledTodo
label toggleSlotTwo
call toggleSlotTwoActiveCheckCall math.equalI64
arg toggleSlotTwoActiveCheckCall left slotTwoActive
arg toggleSlotTwoActiveCheckCall right oneValue
run toggleSlotTwoActiveCheckCall
bind canToggleSlotTwo Bool toggleSlotTwoActiveCheckCall
branchIf canToggleSlotTwo toggleSlotTwoState
branch missingTodoForToggle
label toggleSlotTwoState
call slotTwoDoneIsZeroCall math.equalI64
arg slotTwoDoneIsZeroCall left slotTwoDone
arg slotTwoDoneIsZeroCall right zeroValue
run slotTwoDoneIsZeroCall
bind slotTwoDoneIsZero Bool slotTwoDoneIsZeroCall
branchIf slotTwoDoneIsZero setSlotTwoDone
set local slotTwoDone zeroValue
branch toggledTodo
