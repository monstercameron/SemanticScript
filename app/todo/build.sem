# Todo TUI project build tape.
# This is the project-layout lab for the future SemanticScript project model.
# Current semsc.py can compile this build tape because importModule inlines
# main.sem after the project/runtime/metadata rows. Rich project-mode parsing of
# build.sem is tracked in the root TODO.

buildProject todoTui
project TodoTuiApp
modulePath todoTui github.com/monstercameron/SemanticScript/app/todo
languageVersion todoTui "1.0"
projectVersion todoTui "1.0.0"
projectLicense todoTui MIT

sourceRoot todoTui "."
registerModule todoTui app.todo "."
mainFile todoTui "main.sem"
mainOperation todoTui main
testPattern todoTui "*.test.sem"
testRoot todoTui "."

target console
# rationale: `runtime native 1` is the SemanticScript-canonical contract for
# native console executables, same as todo-web / http-api-gauntlet. The earlier
# `AgentRuntime 0.1` was an exploratory placeholder before the native adapter
# solidified; switching to `native 1` aligns this sample with the rest of the
# repo and with the runtime the compiler actually lowers to.
runtime native 1
entry console main

# Project metadata embedded directly into build/todo.exe at --emit-exe time. On
# Windows the compiler generates a transient VERSIONINFO resource that the
# linker bakes into the PE's resource section, visible via File Explorer
# Properties, PowerShell `(Get-Item todo.exe).VersionInfo`, and version.dll.
version "1.0.0.0"
publisher "Earl Cameron"
description "SemanticScript Todo TUI - keyboard-driven console todo app with JSON persistence."
copyright "Copyright (c) 2026 Earl Cameron. Licensed under the project LICENSE."
productName "Todo TUI"
internalName "todo"
originalFilename "todo.exe"
comments "Built from app/todo/main.sem by the SemanticScript reference compiler."
metadata "BuildSource" "app/todo/main.sem"
metadata "RuntimeContract" "native 1"

# === Icon registry ===
# The icon group below is lowered to a Windows VERSIONINFO ICON resource at
# `--emit-exe` time. The compiler walks every iconImage that belongs to the
# `applicationPrimary` group, filters to `platform any|windows`, packs the
# PNG files into a transient .ico (PNG-encoded ICONDIRENTRY entries — Vista+
# supported, preserves alpha channel), and llvm-rc embeds the resource into
# the PE's resource section. The icon then appears in Explorer thumbnails,
# the taskbar, Alt-Tab, and the Properties dialog without any sidecar files.
# Each fact about each image has its own row so a future linter rule can
# validate every property independently — see SS44xx range for the
# style-discipline diagnostics.

iconRoleDefinition applicationPrimary   "Primary application icon — Explorer file view, taskbar, Start tile, Alt-Tab thumbnail."
iconRoleDefinition applicationSecondary "Secondary application icon — notification badge, tray, secondary windows."
iconRoleDefinition documentType         "Icon shown by file managers for files of a registered document type."

icon         todoPrimaryIcon
iconRole     todoPrimaryIcon applicationPrimary
iconPurpose  todoPrimaryIcon "Stylized 'T' on a teal rounded-square background. Every Windows shell surface (Explorer list, taskbar, Start tile, Alt-Tab) reads this same icon group at the matching pixel size."

iconImage         todoPrimaryAt16
iconImageGroup    todoPrimaryAt16 todoPrimaryIcon
iconImagePath     todoPrimaryAt16 "assets/icons/icon-16.png"
iconImageFormat   todoPrimaryAt16 png
iconImageWidth    todoPrimaryAt16 16
iconImageHeight   todoPrimaryAt16 16
iconImageScale    todoPrimaryAt16 1
iconImageDepth    todoPrimaryAt16 bits32
iconImagePlatform todoPrimaryAt16 any
iconImagePurpose  todoPrimaryAt16 "Smallest cell — Explorer details column, system tray, 16px hicolor theme on Linux."

iconImage         todoPrimaryAt32
iconImageGroup    todoPrimaryAt32 todoPrimaryIcon
iconImagePath     todoPrimaryAt32 "assets/icons/icon-32.png"
iconImageFormat   todoPrimaryAt32 png
iconImageWidth    todoPrimaryAt32 32
iconImageHeight   todoPrimaryAt32 32
iconImageScale    todoPrimaryAt32 1
iconImageDepth    todoPrimaryAt32 bits32
iconImagePlatform todoPrimaryAt32 any
iconImagePurpose  todoPrimaryAt32 "Taskbar at 100% DPI, Alt-Tab thumbnail row, medium Explorer view."

iconImage         todoPrimaryAt48
iconImageGroup    todoPrimaryAt48 todoPrimaryIcon
iconImagePath     todoPrimaryAt48 "assets/icons/icon-48.png"
iconImageFormat   todoPrimaryAt48 png
iconImageWidth    todoPrimaryAt48 48
iconImageHeight   todoPrimaryAt48 48
iconImageScale    todoPrimaryAt48 1
iconImageDepth    todoPrimaryAt48 bits32
iconImagePlatform todoPrimaryAt48 any
iconImagePurpose  todoPrimaryAt48 "Windows large-icon Explorer view; required for Shell shell32 compatibility."

iconImage         todoPrimaryAt256
iconImageGroup    todoPrimaryAt256 todoPrimaryIcon
iconImagePath     todoPrimaryAt256 "assets/icons/icon-256.png"
iconImageFormat   todoPrimaryAt256 png
iconImageWidth    todoPrimaryAt256 256
iconImageHeight   todoPrimaryAt256 256
iconImageScale    todoPrimaryAt256 1
iconImageDepth    todoPrimaryAt256 bits32
iconImagePlatform todoPrimaryAt256 any
iconImagePurpose  todoPrimaryAt256 "Windows Extra Large Icons view, taskbar at 200% DPI, Properties dialog preview, Linux 256x256 hicolor."

targetRuntime todoTui nativeExe
buildProfile todoTui dev
optLevel todoTui 2
runtimeChecks todoTui panic
persistLlvmIr todoTui yes
emitLlvmIr todoTui auto
emitOptimizedLlvmIr todoTui no
buildFolderName todoTui build
formatterSetting todoTui lineWidth 100
linterSetting todoTui maxTier T4
docsOutput todoTui "docs"
# Basenames resolve into the compiler-managed build directory, so this emits
# app/todo/build/todo.exe while keeping the source-level executable name stable.
nativeOutput todoTui "todo.exe"
# keepResources controls whether the intermediate Windows resource files
# (`.rc` / `.res` / `.ico`) are written to disk during the build. Default
# is `no` — the resource bytes survive only inside todo.exe's PE resource
# section. Set to `yes` to retain them under `<build_dir>/resources/` for
# debugging, or override the directory with `resourcesDir todoTui "path"`.
# CLI flags `--keep-resources` and `--resource-dir PATH` override these
# values per-invocation.
keepResources todoTui no

# Future comptime hook. Reserved for 2.0; not executed by the current compiler.
comptimeOperation todoTui configureTodoTuiBuild

# Current compiler bridge: inline the executable module registered above. The
# module source owns its imports and export contract; build.sem only registers
# where the project modules live and selects the executable entry point.
importModule app.todo
