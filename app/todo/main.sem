arg loadTodosCall lineBufferCapacity lineBufferCapacity
run loadTodosCall
bind loadedTodoCount CSignedInt64 loadTodosCall
set local todoCount loadedTodoCount
call freeLineBufferCall c.free
arg freeLineBufferCall ptr lineBuffer
run freeLineBufferCall
ignoreValue freeLineBufferCall Void
set local statusMessage loadedStatusText
call hideCursorOnStartCall hideCursor
run hideCursorOnStartCall
ignoreValue hideCursorOnStartCall CSignedInt32
branch replLoop

label replLoop
call renderScreenCall renderScreen
arg renderScreenCall doneArray doneArray
arg renderScreenCall titlesBuffer titlesArray
arg renderScreenCall todoCount todoCount
arg renderScreenCall selectedIndex selectedIndex
arg renderScreenCall topIndex topIndex
arg renderScreenCall screenMode screenMode
arg renderScreenCall editBuffer editBuffer
