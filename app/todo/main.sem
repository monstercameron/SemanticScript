branch deleteStatusAndPersist
label clampSelectionAfterDelete
call countIsZeroCheckCall math.equalI64
arg countIsZeroCheckCall left todoCount
arg countIsZeroCheckCall right zeroValue
run countIsZeroCheckCall
bind countIsZero Bool countIsZeroCheckCall
branchIf countIsZero setSelectionZeroAfterDelete
call lastIndexAfterDeleteCall math.subtractI64
arg lastIndexAfterDeleteCall left todoCount
arg lastIndexAfterDeleteCall right oneValue
run lastIndexAfterDeleteCall
bind lastIndexAfterDelete CSignedInt64 lastIndexAfterDeleteCall
set local selectedIndex lastIndexAfterDelete
branch deleteStatusAndPersist
label setSelectionZeroAfterDelete
set local selectedIndex zeroValue
branch deleteStatusAndPersist
label deleteStatusAndPersist
call clampTopAfterDeleteCall clampTopIndex
arg clampTopAfterDeleteCall selectedIndex selectedIndex
arg clampTopAfterDeleteCall topIndex topIndex
arg clampTopAfterDeleteCall visibleRows visibleRows
run clampTopAfterDeleteCall
bind clampedTopAfterDelete CSignedInt64 clampTopAfterDeleteCall
set local topIndex clampedTopAfterDelete
set local statusMessage deletedText
branch persistTodosThenLoop

label persistTodosThenLoop
set local screenMode ListMode
set local editLength zeroValue
call saveTodosAfterChangeCall saveTodosToJson
arg saveTodosAfterChangeCall doneArray doneArray
arg saveTodosAfterChangeCall titlesBuffer titlesArray
arg saveTodosAfterChangeCall todoCount todoCount
arg saveTodosAfterChangeCall titleCapacity titleCapacity
run saveTodosAfterChangeCall
bind saveAfterChangeStatus SaveTodosStatus saveTodosAfterChangeCall
call saveAfterChangeSucceededCall SaveTodosStatus.equal
arg saveAfterChangeSucceededCall left saveAfterChangeStatus
arg saveAfterChangeSucceededCall right SaveSucceeded
run saveAfterChangeSucceededCall
bind saveAfterChangeSucceeded Bool saveAfterChangeSucceededCall
branchIf saveAfterChangeSucceeded replLoop
set local statusMessage saveFailedText
branch replLoop

label doneArrayAllocationFailed
call allocationFailedDoneCall c.puts
arg allocationFailedDoneCall text allocationFailedText
run allocationFailedDoneCall
ignoreValue allocationFailedDoneCall CSignedInt32
makeError doneArrayAllocationFailure MainError.StartupAllocationFailed allocateDoneArrayError
returnError doneArrayAllocationFailure
label titlesArrayAllocationFailed
call allocationFailedTitlesCall c.puts
arg allocationFailedTitlesCall text allocationFailedText
run allocationFailedTitlesCall
ignoreValue allocationFailedTitlesCall CSignedInt32
call freeDoneAfterTitlesFailureCall c.free
arg freeDoneAfterTitlesFailureCall ptr doneArray
run freeDoneAfterTitlesFailureCall
ignoreValue freeDoneAfterTitlesFailureCall Void
makeError titlesArrayAllocationFailure MainError.StartupAllocationFailed allocateTitlesArrayError
returnError titlesArrayAllocationFailure
label editBufferAllocationFailed
call allocationFailedEditCall c.puts
arg allocationFailedEditCall text allocationFailedText
run allocationFailedEditCall
ignoreValue allocationFailedEditCall CSignedInt32
call freeDoneAfterEditFailureCall c.free
