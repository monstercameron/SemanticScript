# Heap-array terminal todo app for the current SemanticScript compiler.
# build.sem owns project identity, runtime target, executable metadata, and
# the module registry. This file owns the app module contract, imports,
# exports, and executable source. Run from app/todo/build so todos.json lives
# beside todo.exe.
module app.todo
modulePurpose app.todo "Keyboard-driven console todo app with heap-backed todo storage and JSON persistence."
moduleOwns app.todo "Terminal TUI lifecycle, keyboard handling, in-memory todo arrays, todos.json load/save, and process-local app state."
moduleDoesNotOwn app.todo "Reusable standard library abstractions, native console primitive implementation, or cross-project package management."
moduleWarning app.todo "This module is intentionally monolithic while the project-layout model is being prototyped; future refactors can split TUI, persistence, and domain operations into folder modules."
moduleInvariant app.todo "main.sem is the default executable entry selected by build.sem, and todo.exe must be run from app/todo/build so todos.json resolves beside the executable."

# Explicit public surface carried from the module contract. Exports are not
# inferred; every symbol below is declared in this module source.
exportType app.todo CAllocationError
exportType app.todo TuiKeyCode
exportType app.todo SaveTodosStatus
exportType app.todo ScreenMode
exportError app.todo MainError

exportOperation app.todo main
exportOperation app.todo readTuiKey
exportOperation app.todo renderScreen
exportOperation app.todo loadTodosFromJson
exportOperation app.todo saveTodosToJson

exportConstant app.todo tuiKeyArrowUp
exportConstant app.todo tuiKeyArrowDown
exportConstant app.todo tuiKeyArrowLeft
exportConstant app.todo tuiKeyArrowRight

type CAllocationError CSignedInt32
type TuiKeyCode CSignedInt32
typeInvariant TuiKeyCode "Raw console bytes returned by c.consoleGetch occupy values 0..255; readTuiKey-normalized SemanticScript TUI keys (arrow keys, future special keys) occupy values strictly greater than 255 so the two domains never collide. See tuiKeyArrow{Up,Down,Left,Right} for the current normalized assignments."

enum SaveTodosStatus repr CSignedInt32
enumCase SaveTodosStatus SaveSucceeded 0
enumCase SaveTodosStatus SaveOpenFailed 1
enumCase SaveTodosStatus SaveWriteFailed 2
enumCase SaveTodosStatus SaveCloseFailed 3

enum ScreenMode repr CSignedInt64
enumCase ScreenMode ListMode 0
enumCase ScreenMode EditMode 1

# rationale: Operation bodies compare these enum values via the compiler's
# built-in `EnumName.equal` domain method (e.g. `SaveTodosStatus.equal`,
# `ScreenMode.equal`). The compiler resolves each call to the matching
# math.equal* primitive based on the enum's declared `repr`, so the source
# expresses the enum identity, not the underlying integer width. Changing
# an enum's `repr` only requires re-running the compiler — no call site
# rewrite needed.

error MainError
errorCase MainError StartupAllocationFailed CAllocationError

# rationale: TUI key codes live above 0xFF (256) so a normalized key never
# collides with a raw byte returned by c.consoleGetch. readTuiKey produces
# these codes; main consumes them. Declaring them once here removes the
# producer/consumer drift hazard that two parallel local declarations carry.
storage module immutable tuiKeyArrowUp TuiKeyCode 1001
storage module immutable tuiKeyArrowDown TuiKeyCode 1002
storage module immutable tuiKeyArrowLeft TuiKeyCode 1003
storage module immutable tuiKeyArrowRight TuiKeyCode 1004

# rationale: ASCII byte sentinels used by the bounded JSON tokenizer
# (copyFixedTodoJsonTitleAtOffset, parseJsonFlagAtOffset, writeJsonEscapedStringBuffer)
# and by the C-string buffer helpers. Codepoints map to characters as:
#   0  = NUL (C-string terminator)
#   27 = ESC (ANSI control sequence introducer used by clearScreen/hideCursor/showCursor)
#   34 = double-quote (JSON string delimiter)
#   49 = digit '1' (parseJsonFlagAtOffset uses this as the truthy flag)
#   92 = backslash (JSON escape lead)
#   93 = `]` (closing bracket of the JSON array, end-of-data sentinel)
#   10 = LF (newline; line-terminator in todos.json and reader stop byte)
#   13 = CR (carriage return; reader stop byte on CRLF line endings)
storage module immutable nulByte CSignedInt32 0
storage module immutable escapeByte CSignedInt32 27
storage module immutable quoteByte CSignedInt32 34
storage module immutable oneAsciiByte CSignedInt32 49
storage module immutable backslashByte CSignedInt32 92
storage module immutable closeBracketByte CSignedInt32 93
storage module immutable newlineByte CSignedInt32 10
storage module immutable carriageReturnByte CSignedInt32 13

# rationale: Console-op scalar conventions shared by clearScreen, hideCursor,
# showCursor, renderTodoRow, and renderScreen. successCode 0 is the
# documented "handler returned cleanly" status (see optimization-guide
# Return Contracts). flushAllStreams 0 is the libc `c.fflush(NULL)` sentinel
# that flushes every open stream; passed as CSignedInt64 because c.fflush's
# stream argument lowers as a pointer-width integer.
storage module immutable successCode CSignedInt32 0
storage module immutable flushAllStreams CSignedInt64 0

operation readTuiKey
output readTuiKey TuiKeyCode
effect readTuiKey read console.stdin
authority readTuiKey console.stdin read
memoryHeap readTuiKey no
async readTuiKey no
purpose readTuiKey "Read one no-echo console key and normalize Windows extended arrow key sequences."
invariant readTuiKey "Arrow keys return stable app-local key codes; ordinary keys return their raw byte."
label startReadTuiKey
# rationale: Windows console scan codes returned by _getch after the
# extendedZeroPrefix (0x00) or extendedArrowPrefix (0xE0) lead byte. The byte
# values 72/80/75/77 happen to be ASCII letters 'H','P','K','M' by accident —
# they are NOT characters here, they are scan codes for arrow keys in the
# Windows IBM PC keyboard scan-code table. Keep them local to readTuiKey
# because they are an OS-input contract, not a SemanticScript-level constant.
storage local immutable extendedZeroPrefix CSignedInt32 0
storage local immutable extendedArrowPrefix CSignedInt32 224
storage local immutable rawArrowUpByte CSignedInt32 72
storage local immutable rawArrowDownByte CSignedInt32 80
storage local immutable rawArrowLeftByte CSignedInt32 75
storage local immutable rawArrowRightByte CSignedInt32 77
call firstKeyCall c.consoleGetch
run firstKeyCall
bind firstKeyCode CSignedInt32 firstKeyCall
call zeroPrefixCheckCall math.equalCSignedInt32
arg zeroPrefixCheckCall left firstKeyCode
arg zeroPrefixCheckCall right extendedZeroPrefix
run zeroPrefixCheckCall
bind isZeroPrefix Bool zeroPrefixCheckCall
branchIf isZeroPrefix readExtendedTuiKey
call arrowPrefixCheckCall math.equalCSignedInt32
arg arrowPrefixCheckCall left firstKeyCode
arg arrowPrefixCheckCall right extendedArrowPrefix
run arrowPrefixCheckCall
bind isArrowPrefix Bool arrowPrefixCheckCall
branchIf isArrowPrefix readExtendedTuiKey
returnValue firstKeyCode
label readExtendedTuiKey
call secondKeyCall c.consoleGetch
run secondKeyCall
bind secondKeyCode CSignedInt32 secondKeyCall
call upArrowCheckCall math.equalCSignedInt32
arg upArrowCheckCall left secondKeyCode
arg upArrowCheckCall right rawArrowUpByte
run upArrowCheckCall
bind isUpArrow Bool upArrowCheckCall
branchIf isUpArrow returnArrowUpKey
call downArrowCheckCall math.equalCSignedInt32
arg downArrowCheckCall left secondKeyCode
arg downArrowCheckCall right rawArrowDownByte
run downArrowCheckCall
bind isDownArrow Bool downArrowCheckCall
branchIf isDownArrow returnArrowDownKey
call leftArrowCheckCall math.equalCSignedInt32
arg leftArrowCheckCall left secondKeyCode
arg leftArrowCheckCall right rawArrowLeftByte
run leftArrowCheckCall
bind isLeftArrow Bool leftArrowCheckCall
branchIf isLeftArrow returnArrowLeftKey
call rightArrowCheckCall math.equalCSignedInt32
arg rightArrowCheckCall left secondKeyCode
arg rightArrowCheckCall right rawArrowRightByte
run rightArrowCheckCall
bind isRightArrow Bool rightArrowCheckCall
branchIf isRightArrow returnArrowRightKey
returnValue secondKeyCode
label returnArrowUpKey
returnValue tuiKeyArrowUp
label returnArrowDownKey
returnValue tuiKeyArrowDown
label returnArrowLeftKey
returnValue tuiKeyArrowLeft
label returnArrowRightKey
returnValue tuiKeyArrowRight

operation clearScreen
output clearScreen CSignedInt32
effect clearScreen write console.stdout
authority clearScreen console.stdout write
memoryHeap clearScreen no
async clearScreen no
purpose clearScreen "Clear the terminal and move the cursor home while the TUI owns the screen."
invariant clearScreen "Only ANSI terminal state is changed; todo storage is untouched."
label startClearScreen
storage local immutable clearCode CNullTerminatedByteString "[2J"
storage local immutable homeCode CNullTerminatedByteString "[H"
call clearEscapeCall c.putchar
arg clearEscapeCall character escapeByte
run clearEscapeCall
ignoreValue clearEscapeCall CSignedInt32
call clearCodeCall c.printf
arg clearCodeCall format clearCode
run clearCodeCall
ignoreValue clearCodeCall CSignedInt32
call homeEscapeCall c.putchar
arg homeEscapeCall character escapeByte
run homeEscapeCall
ignoreValue homeEscapeCall CSignedInt32
call homeCodeCall c.printf
arg homeCodeCall format homeCode
run homeCodeCall
ignoreValue homeCodeCall CSignedInt32
call flushCall c.fflush
arg flushCall stream flushAllStreams
run flushCall
ignoreValue flushCall CSignedInt32
returnValue successCode

