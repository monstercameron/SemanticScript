arg hideEscapeCall character escapeByte
run hideEscapeCall
ignoreValue hideEscapeCall CSignedInt32
call hideCodeCall c.printf
arg hideCodeCall format hideCursorCode
run hideCodeCall
ignoreValue hideCodeCall CSignedInt32
call flushCall c.fflush
arg flushCall stream flushAllStreams
run flushCall
ignoreValue flushCall CSignedInt32
returnValue successCode

operation showCursor
output showCursor CSignedInt32
effect showCursor write console.stdout
authority showCursor console.stdout write
memoryHeap showCursor no
async showCursor no
purpose showCursor "Restore the native terminal caret before returning to the shell."
invariant showCursor "Only ANSI cursor visibility is changed; todo storage is untouched."
label startShowCursor
storage local immutable showCursorCode CNullTerminatedByteString "[?25h"
call showEscapeCall c.putchar
arg showEscapeCall character escapeByte
run showEscapeCall
ignoreValue showEscapeCall CSignedInt32
call showCodeCall c.printf
arg showCodeCall format showCursorCode
run showCodeCall
ignoreValue showCodeCall CSignedInt32
call flushCall c.fflush
arg flushCall stream flushAllStreams
run flushCall
ignoreValue flushCall CSignedInt32
