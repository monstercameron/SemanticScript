run freeTitlesAfterEditFailureCall
ignoreValue freeTitlesAfterEditFailureCall Void
makeError editBufferAllocationFailure MainError.StartupAllocationFailed allocateEditBufferError
returnError editBufferAllocationFailure
label lineBufferAllocationFailed
call allocationFailedLineCall c.puts
