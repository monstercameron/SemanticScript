returnValue statusIsNegative

operation writeJsonEscapedStringBuffer
input writeJsonEscapedStringBuffer fileHandle CFileHandle
input writeJsonEscapedStringBuffer titleBuffer COpaqueMemoryAddress
output writeJsonEscapedStringBuffer SaveTodosStatus
effect writeJsonEscapedStringBuffer read memory.buffer
effect writeJsonEscapedStringBuffer write filesystem
authority writeJsonEscapedStringBuffer memory.buffer read
authority writeJsonEscapedStringBuffer filesystem write
memoryHeap writeJsonEscapedStringBuffer no
async writeJsonEscapedStringBuffer no
purpose writeJsonEscapedStringBuffer "Write a title buffer as JSON string content with quote and backslash escaped."
invariant writeJsonEscapedStringBuffer "The loop reads until NUL and writes each source byte once, escaping quote and backslash before the byte reaches JSON."
label startWriteJsonEscapedStringBuffer
storage local immutable zeroIndex CSignedInt64 0
storage local immutable oneStep CSignedInt64 1
storage local immutable rawCharacterFormatText CNullTerminatedByteString "%c"
storage local immutable escapedQuoteText CNullTerminatedByteString "\\\""
storage local immutable escapedBackslashText CNullTerminatedByteString "\\\\"
storage local mutable readIndex CSignedInt64 zeroIndex
label writeJsonEscapedLoop
call loadTitleByteCall pointer.loadByte
arg loadTitleByteCall buffer titleBuffer
arg loadTitleByteCall offset readIndex
run loadTitleByteCall
bind titleByte CSignedInt32 loadTitleByteCall
call nulCheckCall math.equalCSignedInt32
arg nulCheckCall left titleByte
arg nulCheckCall right nulByte
run nulCheckCall
bind titleByteIsNul Bool nulCheckCall
branchIf titleByteIsNul finishWriteJsonEscaped
call quoteCheckCall math.equalCSignedInt32
arg quoteCheckCall left titleByte
arg quoteCheckCall right quoteByte
run quoteCheckCall
bind titleByteIsQuote Bool quoteCheckCall
branchIf titleByteIsQuote writeEscapedQuote
call backslashCheckCall math.equalCSignedInt32
arg backslashCheckCall left titleByte
arg backslashCheckCall right backslashByte
run backslashCheckCall
bind titleByteIsBackslash Bool backslashCheckCall
branchIf titleByteIsBackslash writeEscapedBackslash
call writeRawCharacterCall c.fprintf
arg writeRawCharacterCall stream fileHandle
arg writeRawCharacterCall format rawCharacterFormatText
arg writeRawCharacterCall character titleByte
run writeRawCharacterCall
bind rawCharacterWriteResult CSignedInt32 writeRawCharacterCall
call rawCharacterWriteFailedCall isNegativeStatus
arg rawCharacterWriteFailedCall statusCode rawCharacterWriteResult
run rawCharacterWriteFailedCall
bind rawCharacterWriteFailed Bool rawCharacterWriteFailedCall
branchIf rawCharacterWriteFailed returnJsonWriteFailed
branch advanceJsonEscapedLoop
label writeEscapedQuote
call writeEscapedQuoteCall c.fprintf
arg writeEscapedQuoteCall stream fileHandle
arg writeEscapedQuoteCall format escapedQuoteText
run writeEscapedQuoteCall
bind escapedQuoteWriteResult CSignedInt32 writeEscapedQuoteCall
call escapedQuoteWriteFailedCall isNegativeStatus
arg escapedQuoteWriteFailedCall statusCode escapedQuoteWriteResult
run escapedQuoteWriteFailedCall
bind escapedQuoteWriteFailed Bool escapedQuoteWriteFailedCall
branchIf escapedQuoteWriteFailed returnJsonWriteFailed
branch advanceJsonEscapedLoop
label writeEscapedBackslash
call writeEscapedBackslashCall c.fprintf
arg writeEscapedBackslashCall stream fileHandle
arg writeEscapedBackslashCall format escapedBackslashText
run writeEscapedBackslashCall
bind escapedBackslashWriteResult CSignedInt32 writeEscapedBackslashCall
call escapedBackslashWriteFailedCall isNegativeStatus
arg escapedBackslashWriteFailedCall statusCode escapedBackslashWriteResult
run escapedBackslashWriteFailedCall
bind escapedBackslashWriteFailed Bool escapedBackslashWriteFailedCall
branchIf escapedBackslashWriteFailed returnJsonWriteFailed
branch advanceJsonEscapedLoop
label advanceJsonEscapedLoop
call advanceReadIndexCall math.addI64
arg advanceReadIndexCall left readIndex
arg advanceReadIndexCall right oneStep
run advanceReadIndexCall
bind nextReadIndex CSignedInt64 advanceReadIndexCall
set local readIndex nextReadIndex
branch writeJsonEscapedLoop
label finishWriteJsonEscaped
returnValue SaveSucceeded
label returnJsonWriteFailed
returnValue SaveWriteFailed

operation saveTodosToJson
input saveTodosToJson doneArray COpaqueMemoryAddress
input saveTodosToJson titlesBuffer COpaqueMemoryAddress
input saveTodosToJson todoCount CSignedInt64
input saveTodosToJson titleCapacity CSignedInt64
output saveTodosToJson SaveTodosStatus
effect saveTodosToJson read memory.buffer
effect saveTodosToJson write filesystem
effect saveTodosToJson open file
effect saveTodosToJson close file
authority saveTodosToJson memory.buffer read
authority saveTodosToJson filesystem write
authority saveTodosToJson file open
authority saveTodosToJson file close
memoryHeap saveTodosToJson no
async saveTodosToJson no
purpose saveTodosToJson "Persist the active todo array as a JSON array."
invariant saveTodosToJson "The save loop writes each active todo index once from zero up to todoCount, title bytes pass through JSON escaping, and write failure takes precedence if close also fails."
label startSaveTodosToJson
storage local immutable zeroValue CSignedInt64 0
storage local immutable oneValue CSignedInt64 1
storage local immutable dataFilePath CNullTerminatedByteString "todos.json"
storage local immutable writeMode CNullTerminatedByteString "w"
storage local immutable openArrayText CNullTerminatedByteString "[\n"
storage local immutable closeArrayText CNullTerminatedByteString "]\n"
storage local immutable itemPrefixFormatText CNullTerminatedByteString "{\"active\":1,\"done\":%d,\"title\":\""
storage local immutable itemSuffixText CNullTerminatedByteString "\"}\n"
storage local immutable itemCommaSuffixText CNullTerminatedByteString "\"},\n"
storage local mutable saveIndex CSignedInt64 zeroValue
call openCall c.fopen
arg openCall filename dataFilePath
arg openCall mode writeMode
run openCall
bind fileHandle CFileHandle openCall
call fileNullCheckCall pointer.isNull
arg fileNullCheckCall pointer fileHandle
run fileNullCheckCall
bind fileIsNull Bool fileNullCheckCall
branchIf fileIsNull saveSkipped
call openArrayCall c.fprintf
arg openArrayCall stream fileHandle
arg openArrayCall format openArrayText
run openArrayCall
bind openArrayResult CSignedInt32 openArrayCall
call openArrayFailedCall isNegativeStatus
arg openArrayFailedCall statusCode openArrayResult
run openArrayFailedCall
bind openArrayFailed Bool openArrayFailedCall
branchIf openArrayFailed closeAfterWriteFailed
label saveLoop
call saveDoneCheckCall math.greaterThanOrEqualI64
arg saveDoneCheckCall left saveIndex
arg saveDoneCheckCall right todoCount
run saveDoneCheckCall
bind saveDone Bool saveDoneCheckCall
branchIf saveDone finishSave
call doneLoadCall pointer.loadByte
arg doneLoadCall buffer doneArray
arg doneLoadCall offset saveIndex
run doneLoadCall
bind doneValue CSignedInt32 doneLoadCall
call titlePointerCall getTitlePointerAt
arg titlePointerCall titlesBuffer titlesBuffer
arg titlePointerCall todoIndex saveIndex
arg titlePointerCall titleCapacity titleCapacity
run titlePointerCall
bind titlePointer COpaqueMemoryAddress titlePointerCall
call nextIndexCall math.addI64
arg nextIndexCall left saveIndex
arg nextIndexCall right oneValue
run nextIndexCall
bind nextSaveIndex CSignedInt64 nextIndexCall
call lastItemCheckCall math.equalI64
arg lastItemCheckCall left nextSaveIndex
arg lastItemCheckCall right todoCount
run lastItemCheckCall
bind isLastItem Bool lastItemCheckCall
call writeItemPrefixCall c.fprintf
arg writeItemPrefixCall stream fileHandle
arg writeItemPrefixCall format itemPrefixFormatText
arg writeItemPrefixCall done doneValue
run writeItemPrefixCall
bind itemPrefixWriteResult CSignedInt32 writeItemPrefixCall
call itemPrefixWriteFailedCall isNegativeStatus
arg itemPrefixWriteFailedCall statusCode itemPrefixWriteResult
run itemPrefixWriteFailedCall
bind itemPrefixWriteFailed Bool itemPrefixWriteFailedCall
branchIf itemPrefixWriteFailed closeAfterWriteFailed
call writeTitleCall writeJsonEscapedStringBuffer
arg writeTitleCall fileHandle fileHandle
arg writeTitleCall titleBuffer titlePointer
run writeTitleCall
bind titleWriteStatus SaveTodosStatus writeTitleCall
call titleWriteSuccessCall SaveTodosStatus.equal
arg titleWriteSuccessCall left titleWriteStatus
arg titleWriteSuccessCall right SaveSucceeded
run titleWriteSuccessCall
bind titleWriteSucceeded Bool titleWriteSuccessCall
branchIf titleWriteSucceeded continueAfterTitleWrite
branch closeAfterWriteFailed
label continueAfterTitleWrite
branchIf isLastItem writeLastItemSuffix
call writeItemCommaSuffixCall c.fprintf
arg writeItemCommaSuffixCall stream fileHandle
arg writeItemCommaSuffixCall format itemCommaSuffixText
run writeItemCommaSuffixCall
bind commaSuffixWriteResult CSignedInt32 writeItemCommaSuffixCall
call commaSuffixWriteFailedCall isNegativeStatus
arg commaSuffixWriteFailedCall statusCode commaSuffixWriteResult
run commaSuffixWriteFailedCall
bind commaSuffixWriteFailed Bool commaSuffixWriteFailedCall
branchIf commaSuffixWriteFailed closeAfterWriteFailed
set local saveIndex nextSaveIndex
branch saveLoop
label writeLastItemSuffix
call writeItemSuffixCall c.fprintf
arg writeItemSuffixCall stream fileHandle
arg writeItemSuffixCall format itemSuffixText
run writeItemSuffixCall
bind itemSuffixWriteResult CSignedInt32 writeItemSuffixCall
call itemSuffixWriteFailedCall isNegativeStatus
arg itemSuffixWriteFailedCall statusCode itemSuffixWriteResult
run itemSuffixWriteFailedCall
bind itemSuffixWriteFailed Bool itemSuffixWriteFailedCall
branchIf itemSuffixWriteFailed closeAfterWriteFailed
set local saveIndex nextSaveIndex
branch saveLoop
label finishSave
call closeArrayCall c.fprintf
arg closeArrayCall stream fileHandle
arg closeArrayCall format closeArrayText
run closeArrayCall
bind closeArrayWriteResult CSignedInt32 closeArrayCall
call closeArrayWriteFailedCall isNegativeStatus
arg closeArrayWriteFailedCall statusCode closeArrayWriteResult
run closeArrayWriteFailedCall
bind closeArrayWriteFailed Bool closeArrayWriteFailedCall
branchIf closeArrayWriteFailed closeAfterWriteFailed
call closeCall c.fclose
arg closeCall stream fileHandle
run closeCall
bind closeResult CSignedInt32 closeCall
call closeFailedCall isNegativeStatus
arg closeFailedCall statusCode closeResult
run closeFailedCall
bind closeFailed Bool closeFailedCall
branchIf closeFailed returnSaveCloseFailed
returnValue SaveSucceeded
label closeAfterWriteFailed
call closeAfterWriteFailedCall c.fclose
arg closeAfterWriteFailedCall stream fileHandle
run closeAfterWriteFailedCall
ignoreValue closeAfterWriteFailedCall CSignedInt32
returnValue SaveWriteFailed
label returnSaveCloseFailed
returnValue SaveCloseFailed
label saveSkipped
returnValue SaveOpenFailed

operation loadTodosFromJson
input loadTodosFromJson doneArray COpaqueMemoryAddress
input loadTodosFromJson titlesBuffer COpaqueMemoryAddress
input loadTodosFromJson todoCapacity CSignedInt64
input loadTodosFromJson titleCapacity CSignedInt64
input loadTodosFromJson lineBuffer COpaqueMemoryAddress
input loadTodosFromJson lineBufferCapacity CSignedInt32
output loadTodosFromJson CSignedInt64
effect loadTodosFromJson read filesystem
effect loadTodosFromJson open file
effect loadTodosFromJson close file
effect loadTodosFromJson read memory.buffer
effect loadTodosFromJson write memory.buffer
authority loadTodosFromJson filesystem read
authority loadTodosFromJson file open
authority loadTodosFromJson file close
authority loadTodosFromJson memory.buffer read
authority loadTodosFromJson memory.buffer write
memoryHeap loadTodosFromJson no
async loadTodosFromJson no
purpose loadTodosFromJson "Load active todo objects from todos.json into the heap-backed arrays."
invariant loadTodosFromJson "The load loop never appends more than todoCapacity active todos and accepts only the exact object key order emitted by saveTodosToJson."
invariant loadTodosFromJson "activeValueOffset, doneValueOffset, and titleValueOffset are coupled to saveTodosToJson's itemPrefixFormatText. Any edit to that format string must update all three offsets in lockstep or this loader will silently parse the wrong byte positions."
warning loadTodosFromJson "Malformed lines are skipped or truncated by fixed-offset parsing; this is not a general JSON decoder."
label startLoadTodosFromJson
storage local immutable zeroValue CSignedInt64 0
storage local immutable oneValue CSignedInt64 1
storage local immutable oneFlag CSignedInt32 1
storage local immutable dataFilePath CNullTerminatedByteString "todos.json"
storage local immutable readMode CNullTerminatedByteString "r"
# rationale: Offsets count bytes into the line written by saveTodosToJson's
# itemPrefixFormatText `{"active":1,"done":%d,"title":"`.
#   {"active":   = 10 bytes → activeValueOffset points at the active digit
#   ,"done":     = 9 bytes  → doneValueOffset = 10 + 9 = 19
#   ,"title":"   = 11 bytes → titleValueOffset = 19 + 11 = 30
# Any edit to itemPrefixFormatText must update these three offsets in lockstep.
storage local immutable activeValueOffset CSignedInt64 10
storage local immutable doneValueOffset CSignedInt64 19
storage local immutable titleValueOffset CSignedInt64 30
storage local mutable loadedCount CSignedInt64 zeroValue
call openCall c.fopen
arg openCall filename dataFilePath
arg openCall mode readMode
run openCall
bind fileHandle CFileHandle openCall
call fileNullCheckCall pointer.isNull
arg fileNullCheckCall pointer fileHandle
run fileNullCheckCall
bind fileIsNull Bool fileNullCheckCall
branchIf fileIsNull loadSkipped
# rationale: Consume and discard the opening `[\n` line emitted by
# saveTodosToJson's openArrayText. The result is intentionally ignored:
# an empty or malformed file makes the next c.fgets in loadLoop return
# NULL, which the readReturnedNull check below detects and branches to
# finishLoad. There is no separate diagnostic for a missing `[` because
# the loader is best-effort by design (see warning on loadTodosFromJson).
call readOpenArrayCall c.fgets
arg readOpenArrayCall string lineBuffer
arg readOpenArrayCall count lineBufferCapacity
arg readOpenArrayCall stream fileHandle
run readOpenArrayCall
ignoreValue readOpenArrayCall CNullTerminatedByteString
label loadLoop
call capacityCheckCall math.greaterThanOrEqualI64
arg capacityCheckCall left loadedCount
arg capacityCheckCall right todoCapacity
run capacityCheckCall
bind capacityReached Bool capacityCheckCall
branchIf capacityReached finishLoad
call readLineCall c.fgets
arg readLineCall string lineBuffer
arg readLineCall count lineBufferCapacity
arg readLineCall stream fileHandle
run readLineCall
bind lineReadResult CNullTerminatedByteString readLineCall
call readNullCheckCall pointer.isNull
arg readNullCheckCall pointer lineReadResult
run readNullCheckCall
bind readReturnedNull Bool readNullCheckCall
branchIf readReturnedNull finishLoad
call firstByteCall pointer.loadByte
arg firstByteCall buffer lineBuffer
arg firstByteCall offset zeroValue
run firstByteCall
bind firstByte CSignedInt32 firstByteCall
call closeBracketCheckCall math.equalCSignedInt32
arg closeBracketCheckCall left firstByte
arg closeBracketCheckCall right closeBracketByte
run closeBracketCheckCall
bind lineIsCloseBracket Bool closeBracketCheckCall
branchIf lineIsCloseBracket finishLoad
call activeParseCall parseJsonFlagAtOffset
arg activeParseCall sourceLine lineBuffer
arg activeParseCall valueOffset activeValueOffset
run activeParseCall
bind activeValue CSignedInt32 activeParseCall
call activeCheckCall math.equalCSignedInt32
arg activeCheckCall left activeValue
arg activeCheckCall right oneFlag
run activeCheckCall
bind lineIsActive Bool activeCheckCall
branchIf lineIsActive appendLoadedTodo
branch loadLoop
label appendLoadedTodo
call doneParseCall parseJsonFlagAtOffset
arg doneParseCall sourceLine lineBuffer
arg doneParseCall valueOffset doneValueOffset
run doneParseCall
bind doneValue CSignedInt32 doneParseCall
call storeDoneCall pointer.storeByte
arg storeDoneCall buffer doneArray
arg storeDoneCall offset loadedCount
arg storeDoneCall value doneValue
run storeDoneCall
call titlePointerCall getTitlePointerAt
arg titlePointerCall titlesBuffer titlesBuffer
arg titlePointerCall todoIndex loadedCount
arg titlePointerCall titleCapacity titleCapacity
run titlePointerCall
bind titlePointer COpaqueMemoryAddress titlePointerCall
call copyTitleCall copyFixedTodoJsonTitleAtOffset
arg copyTitleCall sourceLine lineBuffer
arg copyTitleCall titleBuffer titlePointer
arg copyTitleCall valueOffset titleValueOffset
arg copyTitleCall titleBufferCapacity titleCapacity
run copyTitleCall
ignoreValue copyTitleCall CSignedInt64
call incrementLoadedCall math.addI64
arg incrementLoadedCall left loadedCount
arg incrementLoadedCall right oneValue
run incrementLoadedCall
bind nextLoadedCount CSignedInt64 incrementLoadedCall
set local loadedCount nextLoadedCount
branch loadLoop
label finishLoad
call closeCall c.fclose
arg closeCall stream fileHandle
run closeCall
ignoreValue closeCall CSignedInt32
returnValue loadedCount
label loadSkipped
returnValue zeroValue

operation appendTodoFromEditBuffer
input appendTodoFromEditBuffer doneArray COpaqueMemoryAddress
input appendTodoFromEditBuffer titlesBuffer COpaqueMemoryAddress
input appendTodoFromEditBuffer editBuffer COpaqueMemoryAddress
input appendTodoFromEditBuffer todoCount CSignedInt64
input appendTodoFromEditBuffer titleCapacity CSignedInt64
output appendTodoFromEditBuffer CSignedInt64
effect appendTodoFromEditBuffer read memory.buffer
effect appendTodoFromEditBuffer write memory.buffer
authority appendTodoFromEditBuffer memory.buffer read
authority appendTodoFromEditBuffer memory.buffer write
memoryHeap appendTodoFromEditBuffer no
async appendTodoFromEditBuffer no
purpose appendTodoFromEditBuffer "Append the edit buffer as a new unfinished todo."
precondition appendTodoFromEditBuffer "todoCount < todoCapacity (caller must have verified the active todo array has room before calling)."
invariant appendTodoFromEditBuffer "This operation writes exactly one title slot and one done byte, then returns todoCount plus one."
label startAppendTodoFromEditBuffer
storage local immutable zeroValue CSignedInt64 0
storage local immutable oneValue CSignedInt64 1
call appendTitlePointerCall getTitlePointerAt
arg appendTitlePointerCall titlesBuffer titlesBuffer
arg appendTitlePointerCall todoIndex todoCount
arg appendTitlePointerCall titleCapacity titleCapacity
run appendTitlePointerCall
bind appendTitlePointer COpaqueMemoryAddress appendTitlePointerCall
call copyNewTitleCall copyStringBuffer
arg copyNewTitleCall sourceBuffer editBuffer
arg copyNewTitleCall targetBuffer appendTitlePointer
arg copyNewTitleCall targetBufferCapacity titleCapacity
run copyNewTitleCall
ignoreValue copyNewTitleCall CSignedInt64
call storeNewDoneCall pointer.storeByte
arg storeNewDoneCall buffer doneArray
arg storeNewDoneCall offset todoCount
arg storeNewDoneCall value zeroValue
run storeNewDoneCall
call incrementTodoCountCall math.addI64
arg incrementTodoCountCall left todoCount
arg incrementTodoCountCall right oneValue
run incrementTodoCountCall
bind incrementedTodoCount CSignedInt64 incrementTodoCountCall
