project AdvancedTodoWeb
target webServer
runtime native 1
module app.todo_web_advanced

webServer advancedTodoWebServer
purpose advancedTodoWebServer "Exercise native HTTP route, method, request, and response edges for a Todo API demo"
serverHost advancedTodoWebServer "127.0.0.1"
serverPort advancedTodoWebServer 18081
route advancedTodoWebServer GET "/" homeHandler
route advancedTodoWebServer GET "/health" healthHandler
route advancedTodoWebServer GET "/todos" listTodosHandler
route advancedTodoWebServer POST "/todos" createTodoHandler
route advancedTodoWebServer OPTIONS "/todos" optionsTodosHandler
route advancedTodoWebServer GET "/todos/1" showTodoOneHandler
route advancedTodoWebServer PUT "/todos/1" updateTodoOneHandler
route advancedTodoWebServer DELETE "/todos/1" deleteTodoOneHandler
route advancedTodoWebServer GET "/debug/method" methodEchoHandler
route advancedTodoWebServer GET "/debug/path" pathEchoHandler
route advancedTodoWebServer GET "/debug/header" headerEchoHandler
route advancedTodoWebServer GET "/debug/query" queryEchoHandler
route advancedTodoWebServer POST "/debug/body" bodyEchoHandler

timeoutBudget requestTimeoutBudget DurationMilliseconds 2000
purpose requestTimeoutBudget "Document the timeout budget for each demo route path once route timeout enforcement is wired"
# invariant: Route metadata is currently path-scoped; /todos and /todos/1 cover every method variant declared on those paths.
routeTimeout advancedTodoWebServer "/" requestTimeoutBudget
routeTimeout advancedTodoWebServer "/health" requestTimeoutBudget
routeTimeout advancedTodoWebServer "/todos" requestTimeoutBudget
routeTimeout advancedTodoWebServer "/todos/1" requestTimeoutBudget
routeTimeout advancedTodoWebServer "/debug/method" requestTimeoutBudget
routeTimeout advancedTodoWebServer "/debug/path" requestTimeoutBudget
routeTimeout advancedTodoWebServer "/debug/header" requestTimeoutBudget
routeTimeout advancedTodoWebServer "/debug/query" requestTimeoutBudget
routeTimeout advancedTodoWebServer "/debug/body" requestTimeoutBudget
routeMiddleware advancedTodoWebServer "/" requestLogMiddleware
routeMiddleware advancedTodoWebServer "/health" requestLogMiddleware
routeMiddleware advancedTodoWebServer "/todos" requestLogMiddleware
routeMiddleware advancedTodoWebServer "/todos/1" requestLogMiddleware
routeMiddleware advancedTodoWebServer "/debug/method" requestLogMiddleware
routeMiddleware advancedTodoWebServer "/debug/path" requestLogMiddleware
routeMiddleware advancedTodoWebServer "/debug/header" requestLogMiddleware
routeMiddleware advancedTodoWebServer "/debug/query" requestLogMiddleware
routeMiddleware advancedTodoWebServer "/debug/body" requestLogMiddleware

capability httpRequestReader http.request read
purpose httpRequestReader "Authority to inspect HTTP request method and path values"
# invariant: Capability paths are hierarchical: http.request read authorizes http.request.method and http.request.path reads.
capability httpResponseWriter http.response write
purpose httpResponseWriter "Authority to write HTTP response status and body values"

const okStatus CSignedInt32 200
const createdStatus CSignedInt32 201
const badRequestStatus CSignedInt32 400

operation writeTextResponse
input writeTextResponse response HttpResponse
input writeTextResponse status CSignedInt32
input writeTextResponse body CNullTerminatedByteString
output writeTextResponse CSignedInt32
effect writeTextResponse write http.response
memory writeTextResponse arena request
async writeTextResponse no
useCapability writeTextResponse httpResponseWriter
purpose writeTextResponse "Write a plain text HTTP response through the native runtime adapter"
invariant writeTextResponse "The response body pointer remains valid until the runtime sends the response"
responseBodyForwarder writeTextResponse body

label startWriteTextResponse

call writeTextResponseCall http.responseText
arg writeTextResponseCall response response
arg writeTextResponseCall status status
arg writeTextResponseCall body body
run writeTextResponseCall
bind writeTextResponseStatus CSignedInt32 writeTextResponseCall
returnValue writeTextResponseStatus

operation homeHandler
input homeHandler request HttpRequest
input homeHandler response HttpResponse
output homeHandler CSignedInt32
effect homeHandler write http.response
memory homeHandler arena request
async homeHandler no
useCapability homeHandler httpResponseWriter
purpose homeHandler "Return an index of advanced Todo Web demo routes"
invariant homeHandler "The body lists every route family that the edge smoke test exercises"
observability homeHandler "This route is used by the smoke test as a server readiness check"

label startHomeHandler

const homeBody CNullTerminatedByteString "advanced todo web\nroutes: /health /todos /todos/1 /debug/method /debug/path /debug/header /debug/query /debug/body\n"
call homeResponseCall writeTextResponse
arg homeResponseCall response response
arg homeResponseCall status okStatus
arg homeResponseCall body homeBody
run homeResponseCall
bind homeResponseStatus CSignedInt32 homeResponseCall
returnValue homeResponseStatus

operation healthHandler
input healthHandler request HttpRequest
input healthHandler response HttpResponse
output healthHandler CSignedInt32
effect healthHandler write http.response
memory healthHandler arena request
async healthHandler no
useCapability healthHandler httpResponseWriter
purpose healthHandler "Return a minimal health response"
invariant healthHandler "The health body stays short and static for readiness polling"

label startHealthHandler

const healthBody CNullTerminatedByteString "ok\n"
call healthResponseCall writeTextResponse
arg healthResponseCall response response
arg healthResponseCall status okStatus
arg healthResponseCall body healthBody
run healthResponseCall
bind healthResponseStatus CSignedInt32 healthResponseCall
returnValue healthResponseStatus

operation listTodosHandler
input listTodosHandler request HttpRequest
input listTodosHandler response HttpResponse
output listTodosHandler CSignedInt32
effect listTodosHandler write http.response
memory listTodosHandler arena request
async listTodosHandler no
useCapability listTodosHandler httpResponseWriter
purpose listTodosHandler "Return the static demo todo list"
invariant listTodosHandler "The body names implemented and missing APIs instead of pretending state is dynamic"
warning listTodosHandler "The list is static until request storage and JSON decoding APIs are added"

label startListTodosHandler

const todoListBody CNullTerminatedByteString "todos\n1. wire native webserver [done]\n2. read request body at /debug/body [done]\n3. add path params [missing]\n"
call todoListResponseCall writeTextResponse
arg todoListResponseCall response response
arg todoListResponseCall status okStatus
arg todoListResponseCall body todoListBody
run todoListResponseCall
bind todoListResponseStatus CSignedInt32 todoListResponseCall
returnValue todoListResponseStatus

operation createTodoHandler
input createTodoHandler request HttpRequest
input createTodoHandler response HttpResponse
output createTodoHandler CSignedInt32
effect createTodoHandler write http.response
memory createTodoHandler arena request
async createTodoHandler no
useCapability createTodoHandler httpResponseWriter
purpose createTodoHandler "Exercise POST dispatch while documenting missing persistent storage"
invariant createTodoHandler "The handler must not claim to persist the request body"
warning createTodoHandler "Use /debug/body for request body echo; this route stays a storage placeholder"

label startCreateTodoHandler

const createTodoBody CNullTerminatedByteString "created todo placeholder; storage api missing\n"
call createTodoResponseCall writeTextResponse
arg createTodoResponseCall response response
arg createTodoResponseCall status createdStatus
arg createTodoResponseCall body createTodoBody
run createTodoResponseCall
bind createTodoResponseStatus CSignedInt32 createTodoResponseCall
returnValue createTodoResponseStatus

operation optionsTodosHandler
input optionsTodosHandler request HttpRequest
input optionsTodosHandler response HttpResponse
output optionsTodosHandler CSignedInt32
effect optionsTodosHandler write http.response
memory optionsTodosHandler arena request
async optionsTodosHandler no
useCapability optionsTodosHandler httpResponseWriter
purpose optionsTodosHandler "Exercise a non-GET metadata-style route for Todo collection capabilities"
invariant optionsTodosHandler "The body names the missing responseHeader API"
invariant optionsTodosHandler "The native runtime emits an Allow response header for this route"
warning optionsTodosHandler "Full CORS preflight response helpers are still future work"

label startOptionsTodosHandler

const allowHeaderName CNullTerminatedByteString "Allow"
const allowHeaderValue CNullTerminatedByteString "GET, POST, OPTIONS"
call allowHeaderCall http.responseHeader
arg allowHeaderCall response response
arg allowHeaderCall name allowHeaderName
arg allowHeaderCall value allowHeaderValue
run allowHeaderCall
ignoreValue allowHeaderCall CSignedInt32

const optionsTodosBody CNullTerminatedByteString "allow: GET,POST,OPTIONS\nheader: Allow\n"
call optionsTodosResponseCall writeTextResponse
arg optionsTodosResponseCall response response
arg optionsTodosResponseCall status okStatus
arg optionsTodosResponseCall body optionsTodosBody
run optionsTodosResponseCall
bind optionsTodosResponseStatus CSignedInt32 optionsTodosResponseCall
returnValue optionsTodosResponseStatus

operation showTodoOneHandler
input showTodoOneHandler request HttpRequest
input showTodoOneHandler response HttpResponse
output showTodoOneHandler CSignedInt32
effect showTodoOneHandler write http.response
memory showTodoOneHandler arena request
async showTodoOneHandler no
useCapability showTodoOneHandler httpResponseWriter
purpose showTodoOneHandler "Return a fixed todo item through an exact route"
invariant showTodoOneHandler "The route remains exact until path parameters are implemented"
warning showTodoOneHandler "This should become /todos/:todoId after path parameters are implemented"

label startShowTodoOneHandler

const showTodoOneBody CNullTerminatedByteString "todo 1: wire native webserver\n"
call showTodoOneResponseCall writeTextResponse
arg showTodoOneResponseCall response response
arg showTodoOneResponseCall status okStatus
arg showTodoOneResponseCall body showTodoOneBody
run showTodoOneResponseCall
bind showTodoOneResponseStatus CSignedInt32 showTodoOneResponseCall
returnValue showTodoOneResponseStatus

operation updateTodoOneHandler
input updateTodoOneHandler request HttpRequest
input updateTodoOneHandler response HttpResponse
output updateTodoOneHandler CSignedInt32
effect updateTodoOneHandler write http.response
memory updateTodoOneHandler arena request
async updateTodoOneHandler no
useCapability updateTodoOneHandler httpResponseWriter
purpose updateTodoOneHandler "Exercise PUT dispatch while documenting missing request storage"
invariant updateTodoOneHandler "The handler returns a placeholder and does not mutate state"
warning updateTodoOneHandler "Cannot update state until storage and JSON decoding are available"

label startUpdateTodoOneHandler

const updateTodoOneBody CNullTerminatedByteString "updated todo placeholder; storage api missing\n"
call updateTodoOneResponseCall writeTextResponse
arg updateTodoOneResponseCall response response
arg updateTodoOneResponseCall status okStatus
arg updateTodoOneResponseCall body updateTodoOneBody
run updateTodoOneResponseCall
bind updateTodoOneResponseStatus CSignedInt32 updateTodoOneResponseCall
returnValue updateTodoOneResponseStatus

operation deleteTodoOneHandler
input deleteTodoOneHandler request HttpRequest
input deleteTodoOneHandler response HttpResponse
output deleteTodoOneHandler CSignedInt32
effect deleteTodoOneHandler write http.response
memory deleteTodoOneHandler arena request
async deleteTodoOneHandler no
useCapability deleteTodoOneHandler httpResponseWriter
purpose deleteTodoOneHandler "Exercise DELETE dispatch and document missing persistent todo storage"
invariant deleteTodoOneHandler "The handler returns a placeholder and does not mutate state"
warning deleteTodoOneHandler "No persistent state changes happen yet"

