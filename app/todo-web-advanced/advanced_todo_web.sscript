const deleteTodoOneBody CNullTerminatedByteString "deleted todo placeholder; storage api missing\n"
call deleteTodoOneResponseCall writeTextResponse
arg deleteTodoOneResponseCall response response
arg deleteTodoOneResponseCall status okStatus
arg deleteTodoOneResponseCall body deleteTodoOneBody
run deleteTodoOneResponseCall
bind deleteTodoOneResponseStatus CSignedInt32 deleteTodoOneResponseCall
returnValue deleteTodoOneResponseStatus

operation methodEchoHandler
input methodEchoHandler request HttpRequest
input methodEchoHandler response HttpResponse
output methodEchoHandler CSignedInt32
effect methodEchoHandler read http.request.method
effect methodEchoHandler write http.response
memory methodEchoHandler arena request
async methodEchoHandler no
useCapability methodEchoHandler httpRequestReader
useCapability methodEchoHandler httpResponseWriter
purpose methodEchoHandler "Return the runtime-provided request method string"
invariant methodEchoHandler "The response body is the request method pointer supplied by the runtime"

label startMethodEchoHandler

call methodReadCall http.requestMethod
arg methodReadCall request request
run methodReadCall
bind requestMethod CNullTerminatedByteString methodReadCall

call methodEchoResponseCall writeTextResponse
arg methodEchoResponseCall response response
arg methodEchoResponseCall status okStatus
arg methodEchoResponseCall body requestMethod
run methodEchoResponseCall
bind methodEchoResponseStatus CSignedInt32 methodEchoResponseCall
returnValue methodEchoResponseStatus

