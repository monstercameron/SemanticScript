input pathEchoHandler request HttpRequest
input pathEchoHandler response HttpResponse
output pathEchoHandler CSignedInt32
effect pathEchoHandler read http.request.path
effect pathEchoHandler write http.response
memory pathEchoHandler arena request
async pathEchoHandler no
useCapability pathEchoHandler httpRequestReader
useCapability pathEchoHandler httpResponseWriter
purpose pathEchoHandler "Return the runtime-provided request path after query stripping"
invariant pathEchoHandler "Query strings are not included in the echoed path"

label startPathEchoHandler

call pathReadCall http.requestPath
arg pathReadCall request request
run pathReadCall
bind requestPath CNullTerminatedByteString pathReadCall

call pathEchoResponseCall writeTextResponse
arg pathEchoResponseCall response response
arg pathEchoResponseCall status okStatus
arg pathEchoResponseCall body requestPath
run pathEchoResponseCall
bind pathEchoResponseStatus CSignedInt32 pathEchoResponseCall
returnValue pathEchoResponseStatus

operation headerEchoHandler
input headerEchoHandler request HttpRequest
input headerEchoHandler response HttpResponse
output headerEchoHandler CSignedInt32
effect headerEchoHandler read http.request.header
effect headerEchoHandler write http.response
memory headerEchoHandler arena request
async headerEchoHandler no
useCapability headerEchoHandler httpRequestReader
useCapability headerEchoHandler httpResponseWriter
purpose headerEchoHandler "Return the X-Sem-Test request header value"
invariant headerEchoHandler "Missing X-Sem-Test returns 400 instead of forwarding a nullable header pointer into the response writer"

label startHeaderEchoHandler

const headerEchoName CNullTerminatedByteString "x-sem-test"
const headerMissingBody CNullTerminatedByteString "missing header: x-sem-test\n"
call headerReadCall http.requestHeader
arg headerReadCall request request
arg headerReadCall name headerEchoName
run headerReadCall
bind requestHeaderValue CNullTerminatedByteString headerReadCall

call headerMissingCheckCall pointer.isNull
arg headerMissingCheckCall pointer requestHeaderValue
run headerMissingCheckCall
bind headerMissing Bool headerMissingCheckCall
branchIf headerMissing headerEchoMissing

call headerEchoResponseCall writeTextResponse
arg headerEchoResponseCall response response
arg headerEchoResponseCall status okStatus
arg headerEchoResponseCall body requestHeaderValue
run headerEchoResponseCall
bind headerEchoResponseStatus CSignedInt32 headerEchoResponseCall
returnValue headerEchoResponseStatus

label headerEchoMissing
call headerMissingResponseCall writeTextResponse
arg headerMissingResponseCall response response
arg headerMissingResponseCall status badRequestStatus
arg headerMissingResponseCall body headerMissingBody
run headerMissingResponseCall
bind headerMissingResponseStatus CSignedInt32 headerMissingResponseCall
returnValue headerMissingResponseStatus

