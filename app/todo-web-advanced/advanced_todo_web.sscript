const queryEchoName CNullTerminatedByteString "name"
const queryMissingBody CNullTerminatedByteString "missing query parameter: name\n"
call queryReadCall http.requestQueryParam
arg queryReadCall request request
arg queryReadCall name queryEchoName
run queryReadCall
bind requestQueryValue CNullTerminatedByteString queryReadCall

call queryMissingCheckCall pointer.isNull
arg queryMissingCheckCall pointer requestQueryValue
run queryMissingCheckCall
bind queryMissing Bool queryMissingCheckCall
branchIf queryMissing queryEchoMissing

call queryEchoResponseCall writeTextResponse
arg queryEchoResponseCall response response
arg queryEchoResponseCall status okStatus
arg queryEchoResponseCall body requestQueryValue
run queryEchoResponseCall
bind queryEchoResponseStatus CSignedInt32 queryEchoResponseCall
returnValue queryEchoResponseStatus

label queryEchoMissing
call queryMissingResponseCall writeTextResponse
arg queryMissingResponseCall response response
arg queryMissingResponseCall status badRequestStatus
arg queryMissingResponseCall body queryMissingBody
run queryMissingResponseCall
bind queryMissingResponseStatus CSignedInt32 queryMissingResponseCall
returnValue queryMissingResponseStatus

