# Kilo SemanticScript port build tape.
buildProject kiloPort
project KiloPort
modulePath kiloPort github.com/monstercameron/SemanticScript/app/Kilo_port
languageVersion kiloPort "1.0"
projectVersion kiloPort "0.1.0"
projectLicense kiloPort BSD-2-Clause

sourceRoot kiloPort "."
registerModule kiloPort app.kiloport "."
mainFile kiloPort "main.sem"
mainOperation kiloPort main
testPattern kiloPort "*.test.sem"
testRoot kiloPort "."

target console
runtime native 1
entry console main

version "0.1.0.0"
publisher "Earl Cameron"
description "SemanticScript port of antirez/kilo."
copyright "Kilo upstream copyright (c) 2016 Salvatore Sanfilippo. Port code licensed under the repository license."
productName "Kilo SemanticScript Port"
internalName "kilo_port"
originalFilename "kilo_port.exe"
comments "Built from app/Kilo_port/main.sem by the SemanticScript reference compiler."
metadata "UpstreamRepository" "https://github.com/antirez/kilo"
metadata "UpstreamClone" "app/Kilo_port/upstream-kilo"

targetRuntime kiloPort nativeExe
buildProfile kiloPort dev
optLevel kiloPort 2
runtimeChecks kiloPort panic
persistLlvmIr kiloPort yes
emitLlvmIr kiloPort auto
emitOptimizedLlvmIr kiloPort no
buildFolderName kiloPort build
cpuBaseline kiloPort generic
cpuTune kiloPort generic
cpuFeatureCheck kiloPort auto
nativeOutput kiloPort "kilo_port.exe"
formatterSetting kiloPort lineWidth 100
linterSetting kiloPort maxTier T4

importModule app.kiloport
