storage local immutable keywordTrue Bool true
call keywordEndCall math.addI64
argument keywordEndCall left I64 sourceIndex
argument keywordEndCall right I64 keywordLength
run keywordEndCall
bind value keywordEnd CSignedInt64 keywordEndCall
call fitsCall math.lessThanOrEqualI64
argument fitsCall left I64 keywordEnd
argument fitsCall right I64 rowLength
run fitsCall
bind value keywordFits Bool fitsCall
branch if condition keywordFits target checkPreviousBoundary
return value keywordFalse
label checkPreviousBoundary
call atStartCall math.equalI64
argument atStartCall left I64 sourceIndex
argument atStartCall right I64 zeroI64
run atStartCall
bind value sourceAtStart Bool atStartCall
branch if condition sourceAtStart target checkNextBoundary
call previousIndexCall math.subtractI64
argument previousIndexCall left I64 sourceIndex
argument previousIndexCall right I64 oneI64
run previousIndexCall
bind value previousIndex CSignedInt64 previousIndexCall
call previousByteCall pointer.loadByte
argument previousByteCall buffer COpaqueMemoryAddress rowPointer
argument previousByteCall offset CByteCount previousIndex
run previousByteCall
bind value previousByte CSignedInt32 previousByteCall
call previousIdentifierCall isJavaScriptIdentifierByte
argument previousIdentifierCall byteValue CSignedInt32 previousByte
run previousIdentifierCall
bind value previousIsIdentifier Bool previousIdentifierCall
branch if condition previousIsIdentifier target returnKeywordFalse
label checkNextBoundary
call atRowEndCall math.greaterThanOrEqualI64
argument atRowEndCall left I64 keywordEnd
argument atRowEndCall right I64 rowLength
run atRowEndCall
bind value keywordEndsRow Bool atRowEndCall
branch if condition keywordEndsRow target compareKeywordBytes
call nextByteCall pointer.loadByte
argument nextByteCall buffer COpaqueMemoryAddress rowPointer
argument nextByteCall offset CByteCount keywordEnd
run nextByteCall
bind value nextByte CSignedInt32 nextByteCall
call nextIdentifierCall isJavaScriptIdentifierByte
argument nextIdentifierCall byteValue CSignedInt32 nextByte
run nextIdentifierCall
bind value nextIsIdentifier Bool nextIdentifierCall
branch if condition nextIsIdentifier target returnKeywordFalse
label compareKeywordBytes
call rowSubstringCall pointer.offset
argument rowSubstringCall base COpaqueMemoryAddress rowPointer
argument rowSubstringCall offset CByteCount sourceIndex
run rowSubstringCall
bind value rowSubstring COpaqueMemoryAddress rowSubstringCall
call compareCall c.strncmp
argument compareCall left COpaqueMemoryAddress rowSubstring
argument compareCall right CNullTerminatedByteString keywordText
argument compareCall count CSignedInt64 keywordLength
run compareCall
bind value compareResult CSignedInt32 compareCall
call matchCall math.equalCSignedInt32
argument matchCall left CSignedInt32 compareResult
argument matchCall right CSignedInt32 zeroI32
run matchCall
bind value keywordMatches Bool matchCall
branch if condition keywordMatches target returnKeywordTrue
label returnKeywordFalse
return value keywordFalse
label returnKeywordTrue
return value keywordTrue

