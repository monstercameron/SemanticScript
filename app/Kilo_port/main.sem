operation getRowPointer
input operation getRowPointer rowsBuffer COpaqueMemoryAddress
input operation getRowPointer rowIndex CSignedInt64
input operation getRowPointer rowCapacity CSignedInt64
output operation getRowPointer COpaqueMemoryAddress
effect getRowPointer read memory.buffer
authority getRowPointer read memory.buffer
memory getRowPointer heap no
async getRowPointer no
purpose operation getRowPointer "Return the start pointer for one fixed-capacity row slot."
invariant operation getRowPointer "The returned pointer is rowIndex multiplied by the fixed row capacity from rowsBuffer."
label startGetRowPointer
call rowOffsetCall math.multiplyI64
argument rowOffsetCall left I64 rowIndex
argument rowOffsetCall right I64 rowCapacity
run rowOffsetCall
bind value rowOffset CSignedInt64 rowOffsetCall
call pointerCall pointer.offset
argument pointerCall base COpaqueMemoryAddress rowsBuffer
argument pointerCall offset CByteCount rowOffset
run pointerCall
bind value rowPointer COpaqueMemoryAddress pointerCall
return value rowPointer

operation isJavaScriptIdentifierByte
input operation isJavaScriptIdentifierByte byteValue CSignedInt32
output operation isJavaScriptIdentifierByte Bool
memory isJavaScriptIdentifierByte heap no
async isJavaScriptIdentifierByte no
purpose operation isJavaScriptIdentifierByte "Return true when a byte can continue a JavaScript identifier."
invariant operation isJavaScriptIdentifierByte "Identifier bytes are ASCII alphanumeric, underscore, or dollar sign."
label startIsJavaScriptIdentifierByte
call alnumCall c.isalnum
argument alnumCall character CSignedInt32 byteValue
run alnumCall
bind value alnumStatus CSignedInt32 alnumCall
call alnumBoolCall math.notEqualCSignedInt32
argument alnumBoolCall left CSignedInt32 alnumStatus
argument alnumBoolCall right CSignedInt32 zeroI32
run alnumBoolCall
bind value isAlnum Bool alnumBoolCall
branch if condition isAlnum target returnIdentifierTrue
call underscoreCall math.equalCSignedInt32
argument underscoreCall left CSignedInt32 byteValue
argument underscoreCall right CSignedInt32 underscoreByte
run underscoreCall
bind value isUnderscore Bool underscoreCall
branch if condition isUnderscore target returnIdentifierTrue
call dollarCall math.equalCSignedInt32
argument dollarCall left CSignedInt32 byteValue
argument dollarCall right CSignedInt32 dollarByte
run dollarCall
bind value isDollar Bool dollarCall
branch if condition isDollar target returnIdentifierTrue
storage local immutable identifierFalse Bool false
return value identifierFalse
label returnIdentifierTrue
storage local immutable identifierTrue Bool true
return value identifierTrue

operation tabRenderedWidth
input operation tabRenderedWidth renderedColumn CSignedInt64
output operation tabRenderedWidth CSignedInt64
memory tabRenderedWidth heap no
async tabRenderedWidth no
purpose operation tabRenderedWidth "Return how many spaces a tab renders at the current zero-based screen column."
invariant operation tabRenderedWidth "Uses Kilo's eight-column tab stop model."
label startTabRenderedWidth
call oneBasedColumnCall math.addI64
argument oneBasedColumnCall left I64 renderedColumn
argument oneBasedColumnCall right I64 oneI64
run oneBasedColumnCall
bind value oneBasedColumn CSignedInt64 oneBasedColumnCall
call remainderCall math.moduloI64
argument remainderCall left I64 oneBasedColumn
argument remainderCall right I64 kiloTabStop
run remainderCall
bind value tabRemainder CSignedInt64 remainderCall
call onStopCall math.equalI64
argument onStopCall left I64 tabRemainder
argument onStopCall right I64 zeroI64
run onStopCall
bind value startsOnTabStop Bool onStopCall
branch if condition startsOnTabStop target returnFullTabWidth
call widthCall math.subtractI64
argument widthCall left I64 kiloTabStop
argument widthCall right I64 tabRemainder
run widthCall
bind value partialTabWidth CSignedInt64 widthCall
return value partialTabWidth
label returnFullTabWidth
return value kiloTabStop

operation renderedColumnForFileColumn
input operation renderedColumnForFileColumn rowPointer COpaqueMemoryAddress
input operation renderedColumnForFileColumn rowLength CSignedInt64
input operation renderedColumnForFileColumn leftVisibleColumn CSignedInt64
input operation renderedColumnForFileColumn fileColumn CSignedInt64
output operation renderedColumnForFileColumn CSignedInt64
effect renderedColumnForFileColumn read memory.buffer
authority renderedColumnForFileColumn read memory.buffer
memory renderedColumnForFileColumn heap no
async renderedColumnForFileColumn no
purpose operation renderedColumnForFileColumn "Map a raw file byte column to its rendered terminal column."
invariant operation renderedColumnForFileColumn "Tabs expand using the same tab width operation as row rendering."
label startRenderedColumnForFileColumn
storage local mutable scanColumn CSignedInt64 leftVisibleColumn
storage local mutable renderedColumn CSignedInt64 zeroI64
label renderedColumnLoop
call reachedTargetCall math.greaterThanOrEqualI64
argument reachedTargetCall left I64 scanColumn
argument reachedTargetCall right I64 fileColumn
run reachedTargetCall
bind value reachedTarget Bool reachedTargetCall
branch if condition reachedTarget target returnRenderedColumn
call reachedRowEndCall math.greaterThanOrEqualI64
argument reachedRowEndCall left I64 scanColumn
argument reachedRowEndCall right I64 rowLength
run reachedRowEndCall
bind value reachedRowEnd Bool reachedRowEndCall
branch if condition reachedRowEnd target returnRenderedColumn
call loadColumnByteCall pointer.loadByte
argument loadColumnByteCall buffer COpaqueMemoryAddress rowPointer
argument loadColumnByteCall offset CByteCount scanColumn
run loadColumnByteCall
bind value columnByte CSignedInt32 loadColumnByteCall
call tabColumnCheckCall math.equalCSignedInt32
argument tabColumnCheckCall left CSignedInt32 columnByte
argument tabColumnCheckCall right CSignedInt32 tabByte
run tabColumnCheckCall
bind value columnIsTab Bool tabColumnCheckCall
branch if condition columnIsTab target advanceRenderedByTab
call renderedIncCall math.addI64
argument renderedIncCall left I64 renderedColumn
argument renderedIncCall right I64 oneI64
run renderedIncCall
bind value renderedAfterByte CSignedInt64 renderedIncCall
set memory renderedColumn renderedAfterByte
jump target advanceScannedColumn
label advanceRenderedByTab
call tabWidthCall tabRenderedWidth
argument tabWidthCall renderedColumn CSignedInt64 renderedColumn
run tabWidthCall
bind value tabWidth CSignedInt64 tabWidthCall
call addTabWidthCall math.addI64
argument addTabWidthCall left I64 renderedColumn
argument addTabWidthCall right I64 tabWidth
run addTabWidthCall
bind value renderedAfterTab CSignedInt64 addTabWidthCall
set memory renderedColumn renderedAfterTab
jump target advanceScannedColumn
label advanceScannedColumn
call scanIncCall math.addI64
argument scanIncCall left I64 scanColumn
argument scanIncCall right I64 oneI64
run scanIncCall
bind value nextScanColumn CSignedInt64 scanIncCall
set memory scanColumn nextScanColumn
jump target renderedColumnLoop
label returnRenderedColumn
return value renderedColumn

