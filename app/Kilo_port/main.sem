operation getRowPointer
input getRowPointer rowsBuffer COpaqueMemoryAddress
input getRowPointer rowIndex CSignedInt64
input getRowPointer rowCapacity CSignedInt64
output getRowPointer COpaqueMemoryAddress
effect getRowPointer read memory.buffer
authority getRowPointer memory.buffer read
memoryHeap getRowPointer no
async getRowPointer no
purpose getRowPointer "Return the start pointer for one fixed-capacity row slot."
invariant getRowPointer "The returned pointer is rowIndex multiplied by the fixed row capacity from rowsBuffer."
label startGetRowPointer
call rowOffsetCall math.multiplyI64
arg rowOffsetCall left rowIndex
arg rowOffsetCall right rowCapacity
run rowOffsetCall
bind rowOffset CSignedInt64 rowOffsetCall
call pointerCall pointer.offset
arg pointerCall base rowsBuffer
arg pointerCall offset rowOffset
run pointerCall
bind rowPointer COpaqueMemoryAddress pointerCall
returnValue rowPointer

operation isJavaScriptIdentifierByte
input isJavaScriptIdentifierByte byteValue CSignedInt32
output isJavaScriptIdentifierByte Bool
memoryHeap isJavaScriptIdentifierByte no
async isJavaScriptIdentifierByte no
purpose isJavaScriptIdentifierByte "Return true when a byte can continue a JavaScript identifier."
invariant isJavaScriptIdentifierByte "Identifier bytes are ASCII alphanumeric, underscore, or dollar sign."
label startIsJavaScriptIdentifierByte
call alnumCall c.isalnum
arg alnumCall character byteValue
run alnumCall
bind alnumStatus CSignedInt32 alnumCall
call alnumBoolCall math.notEqualCSignedInt32
arg alnumBoolCall left alnumStatus
arg alnumBoolCall right zeroI32
run alnumBoolCall
bind isAlnum Bool alnumBoolCall
branchIf isAlnum returnIdentifierTrue
call underscoreCall math.equalCSignedInt32
arg underscoreCall left byteValue
arg underscoreCall right underscoreByte
run underscoreCall
bind isUnderscore Bool underscoreCall
branchIf isUnderscore returnIdentifierTrue
call dollarCall math.equalCSignedInt32
arg dollarCall left byteValue
arg dollarCall right dollarByte
run dollarCall
bind isDollar Bool dollarCall
branchIf isDollar returnIdentifierTrue
storage local immutable identifierFalse Bool false
returnValue identifierFalse
label returnIdentifierTrue
storage local immutable identifierTrue Bool true
returnValue identifierTrue

operation tabRenderedWidth
input tabRenderedWidth renderedColumn CSignedInt64
output tabRenderedWidth CSignedInt64
memoryHeap tabRenderedWidth no
async tabRenderedWidth no
purpose tabRenderedWidth "Return how many spaces a tab renders at the current zero-based screen column."
invariant tabRenderedWidth "Uses Kilo's eight-column tab stop model."
label startTabRenderedWidth
call oneBasedColumnCall math.addI64
arg oneBasedColumnCall left renderedColumn
arg oneBasedColumnCall right oneI64
run oneBasedColumnCall
bind oneBasedColumn CSignedInt64 oneBasedColumnCall
call remainderCall math.moduloI64
arg remainderCall left oneBasedColumn
arg remainderCall right kiloTabStop
run remainderCall
bind tabRemainder CSignedInt64 remainderCall
call onStopCall math.equalI64
arg onStopCall left tabRemainder
arg onStopCall right zeroI64
run onStopCall
bind startsOnTabStop Bool onStopCall
branchIf startsOnTabStop returnFullTabWidth
call widthCall math.subtractI64
arg widthCall left kiloTabStop
arg widthCall right tabRemainder
run widthCall
bind partialTabWidth CSignedInt64 widthCall
returnValue partialTabWidth
label returnFullTabWidth
returnValue kiloTabStop

operation renderedColumnForFileColumn
input renderedColumnForFileColumn rowPointer COpaqueMemoryAddress
input renderedColumnForFileColumn rowLength CSignedInt64
input renderedColumnForFileColumn leftVisibleColumn CSignedInt64
input renderedColumnForFileColumn fileColumn CSignedInt64
output renderedColumnForFileColumn CSignedInt64
effect renderedColumnForFileColumn read memory.buffer
authority renderedColumnForFileColumn memory.buffer read
memoryHeap renderedColumnForFileColumn no
async renderedColumnForFileColumn no
purpose renderedColumnForFileColumn "Map a raw file byte column to its rendered terminal column."
invariant renderedColumnForFileColumn "Tabs expand using the same tab width operation as row rendering."
label startRenderedColumnForFileColumn
storage local mutable scanColumn CSignedInt64 leftVisibleColumn
storage local mutable renderedColumn CSignedInt64 zeroI64
label renderedColumnLoop
call reachedTargetCall math.greaterThanOrEqualI64
arg reachedTargetCall left scanColumn
arg reachedTargetCall right fileColumn
run reachedTargetCall
bind reachedTarget Bool reachedTargetCall
branchIf reachedTarget returnRenderedColumn
call reachedRowEndCall math.greaterThanOrEqualI64
arg reachedRowEndCall left scanColumn
arg reachedRowEndCall right rowLength
run reachedRowEndCall
bind reachedRowEnd Bool reachedRowEndCall
branchIf reachedRowEnd returnRenderedColumn
call loadColumnByteCall pointer.loadByte
arg loadColumnByteCall buffer rowPointer
arg loadColumnByteCall offset scanColumn
run loadColumnByteCall
bind columnByte CSignedInt32 loadColumnByteCall
call tabColumnCheckCall math.equalCSignedInt32
arg tabColumnCheckCall left columnByte
arg tabColumnCheckCall right tabByte
run tabColumnCheckCall
bind columnIsTab Bool tabColumnCheckCall
branchIf columnIsTab advanceRenderedByTab
call renderedIncCall math.addI64
arg renderedIncCall left renderedColumn
arg renderedIncCall right oneI64
run renderedIncCall
bind renderedAfterByte CSignedInt64 renderedIncCall
set local renderedColumn renderedAfterByte
branch advanceScannedColumn
label advanceRenderedByTab
call tabWidthCall tabRenderedWidth
arg tabWidthCall renderedColumn renderedColumn
run tabWidthCall
bind tabWidth CSignedInt64 tabWidthCall
call addTabWidthCall math.addI64
arg addTabWidthCall left renderedColumn
arg addTabWidthCall right tabWidth
run addTabWidthCall
bind renderedAfterTab CSignedInt64 addTabWidthCall
set local renderedColumn renderedAfterTab
branch advanceScannedColumn
label advanceScannedColumn
call scanIncCall math.addI64
arg scanIncCall left scanColumn
arg scanIncCall right oneI64
run scanIncCall
bind nextScanColumn CSignedInt64 scanIncCall
set local scanColumn nextScanColumn
branch renderedColumnLoop
label returnRenderedColumn
returnValue renderedColumn

operation keywordStartsAt
input keywordStartsAt rowPointer COpaqueMemoryAddress
input keywordStartsAt rowLength CSignedInt64
input keywordStartsAt sourceIndex CSignedInt64
input keywordStartsAt keywordText CNullTerminatedByteString
input keywordStartsAt keywordLength CSignedInt64
output keywordStartsAt Bool
effect keywordStartsAt read memory.buffer
authority keywordStartsAt memory.buffer read
memoryHeap keywordStartsAt no
async keywordStartsAt no
purpose keywordStartsAt "Return true when keywordText starts at sourceIndex with JavaScript identifier boundaries."
invariant keywordStartsAt "A match cannot be preceded or followed by an identifier byte."
label startKeywordStartsAt
storage local immutable keywordFalse Bool false
storage local immutable keywordTrue Bool true
call keywordEndCall math.addI64
arg keywordEndCall left sourceIndex
arg keywordEndCall right keywordLength
run keywordEndCall
bind keywordEnd CSignedInt64 keywordEndCall
call fitsCall math.lessThanOrEqualI64
arg fitsCall left keywordEnd
arg fitsCall right rowLength
run fitsCall
bind keywordFits Bool fitsCall
branchIf keywordFits checkPreviousBoundary
returnValue keywordFalse
label checkPreviousBoundary
call atStartCall math.equalI64
arg atStartCall left sourceIndex
arg atStartCall right zeroI64
run atStartCall
bind sourceAtStart Bool atStartCall
branchIf sourceAtStart checkNextBoundary
call previousIndexCall math.subtractI64
arg previousIndexCall left sourceIndex
arg previousIndexCall right oneI64
run previousIndexCall
bind previousIndex CSignedInt64 previousIndexCall
call previousByteCall pointer.loadByte
arg previousByteCall buffer rowPointer
arg previousByteCall offset previousIndex
run previousByteCall
bind previousByte CSignedInt32 previousByteCall
call previousIdentifierCall isJavaScriptIdentifierByte
arg previousIdentifierCall byteValue previousByte
run previousIdentifierCall
bind previousIsIdentifier Bool previousIdentifierCall
branchIf previousIsIdentifier returnKeywordFalse
label checkNextBoundary
call atRowEndCall math.greaterThanOrEqualI64
arg atRowEndCall left keywordEnd
arg atRowEndCall right rowLength
run atRowEndCall
bind keywordEndsRow Bool atRowEndCall
branchIf keywordEndsRow compareKeywordBytes
call nextByteCall pointer.loadByte
arg nextByteCall buffer rowPointer
arg nextByteCall offset keywordEnd
run nextByteCall
bind nextByte CSignedInt32 nextByteCall
call nextIdentifierCall isJavaScriptIdentifierByte
arg nextIdentifierCall byteValue nextByte
run nextIdentifierCall
bind nextIsIdentifier Bool nextIdentifierCall
branchIf nextIsIdentifier returnKeywordFalse
label compareKeywordBytes
call rowSubstringCall pointer.offset
arg rowSubstringCall base rowPointer
arg rowSubstringCall offset sourceIndex
run rowSubstringCall
bind rowSubstring COpaqueMemoryAddress rowSubstringCall
call compareCall c.strncmp
arg compareCall left rowSubstring
arg compareCall right keywordText
arg compareCall count keywordLength
run compareCall
bind compareResult CSignedInt32 compareCall
call matchCall math.equalCSignedInt32
arg matchCall left compareResult
arg matchCall right zeroI32
run matchCall
bind keywordMatches Bool matchCall
branchIf keywordMatches returnKeywordTrue
label returnKeywordFalse
returnValue keywordFalse
label returnKeywordTrue
returnValue keywordTrue

