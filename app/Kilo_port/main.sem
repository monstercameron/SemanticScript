operation emitEscCode
input emitEscCode code CNullTerminatedByteString
output emitEscCode CSignedInt32
effect emitEscCode write console.stdout
authority emitEscCode console.stdout write
memoryHeap emitEscCode no
async emitEscCode no
purpose emitEscCode "Emit one ANSI escape sequence body after ESC."
invariant emitEscCode "The ESC byte is always emitted before the supplied ANSI body."
label startEmitEscCode
call escapeCall c.putchar
arg escapeCall character escapeByte
run escapeCall
ignoreValue escapeCall CSignedInt32
call codeCall c.printf
arg codeCall format code
run codeCall
ignoreValue codeCall CSignedInt32
returnValue zeroI32

operation hideCursor
output hideCursor CSignedInt32
effect hideCursor write console.stdout
authority hideCursor console.stdout write
memoryHeap hideCursor no
async hideCursor no
purpose hideCursor "Hide the terminal cursor while drawing."
invariant hideCursor "Cursor visibility is changed only through ANSI SGR/control output."
label startHideCursor
storage local immutable code CNullTerminatedByteString "[?25l"
call emitCall emitEscCode
arg emitCall code code
run emitCall
ignoreValue emitCall CSignedInt32
returnValue zeroI32

operation showCursor
output showCursor CSignedInt32
effect showCursor write console.stdout
authority showCursor console.stdout write
memoryHeap showCursor no
async showCursor no
purpose showCursor "Show the terminal cursor before returning control."
invariant showCursor "Cursor visibility is restored with the ANSI show-cursor sequence."
label startShowCursor
storage local immutable code CNullTerminatedByteString "[?25h"
call emitCall emitEscCode
arg emitCall code code
run emitCall
ignoreValue emitCall CSignedInt32
returnValue zeroI32

