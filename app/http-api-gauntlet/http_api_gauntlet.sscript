project HttpApiGauntlet
target webServer
runtime native 1
module app.http_api_gauntlet

# rationale: This app deliberately challenges every native HTTP feature the
# reference compiler currently lowers (route dispatch, request reads,
# response writers, multipart parsing, one-shot SSE framing, path-scoped
# middleware). Routes that previously pinned the adapter's null-body 500
# failure path now explicitly guard with pointer.isNull and return 400;
# /reflect/required-header-or-fail is the one route that intentionally
# still pins the legacy 500 contract so the gauntlet keeps coverage of
# that runtime edge. The unguardedHttpInput linter rule is the contract
# enforcer for that split.

webServer httpApiGauntletServer
purpose httpApiGauntletServer "Challenge every currently implemented native HTTP request, response, routing, and middleware edge"
serverHost httpApiGauntletServer "127.0.0.1"
serverPort httpApiGauntletServer 18082
route httpApiGauntletServer GET "/" indexHandler
route httpApiGauntletServer GET "/health" healthHandler
route httpApiGauntletServer GET "/reflect/method" methodReflectHandler
route httpApiGauntletServer GET "/reflect/path" pathReflectHandler
route httpApiGauntletServer GET "/reflect/header" headerReflectHandler
route httpApiGauntletServer GET "/reflect/required-header-or-fail" requiredHeaderHandler
route httpApiGauntletServer GET "/reflect/query" queryReflectHandler
route httpApiGauntletServer GET "/reflect/query-empty" queryEmptyHandler
route httpApiGauntletServer GET "/reflect/query-repeat" queryRepeatHandler
route httpApiGauntletServer POST "/reflect/body" bodyReflectHandler
route httpApiGauntletServer POST "/reflect/body-bytes" bodyBytesReflectHandler
route httpApiGauntletServer POST "/reflect/body-size" bodySizeHandler
route httpApiGauntletServer PUT "/reflect/body-size" bodySizeHandler
route httpApiGauntletServer POST "/multipart/text" multipartTextHandler
route httpApiGauntletServer POST "/multipart/file-name" multipartFileNameHandler
route httpApiGauntletServer POST "/multipart/file-type" multipartFileTypeHandler
route httpApiGauntletServer POST "/multipart/file-bytes" multipartFileBytesHandler
route httpApiGauntletServer GET "/events/one" sseOneEventHandler
route httpApiGauntletServer OPTIONS "/capabilities" capabilitiesOptionsHandler
route httpApiGauntletServer GET "/content/custom" customContentHandler
route httpApiGauntletServer GET "/redirect" redirectHandler
route httpApiGauntletServer DELETE "/empty" emptyDeleteHandler
route httpApiGauntletServer PATCH "/patch" patchHandler

timeoutBudget requestTimeoutBudget DurationMilliseconds 2000
purpose requestTimeoutBudget "Document the desired per-route timeout budget; the blocking native adapter does not enforce it yet"
# invariant: routeTimeout is metadata-only in the current blocking adapter
# but every route path is still listed so a future preemptive runtime can
# inherit complete coverage without a follow-up sweep. The POST and PUT
# variants of /reflect/body-size share one path entry by adapter design.
routeTimeout httpApiGauntletServer "/" requestTimeoutBudget
routeTimeout httpApiGauntletServer "/health" requestTimeoutBudget
routeTimeout httpApiGauntletServer "/reflect/method" requestTimeoutBudget
routeTimeout httpApiGauntletServer "/reflect/path" requestTimeoutBudget
routeTimeout httpApiGauntletServer "/reflect/header" requestTimeoutBudget
routeTimeout httpApiGauntletServer "/reflect/required-header-or-fail" requestTimeoutBudget
routeTimeout httpApiGauntletServer "/reflect/query" requestTimeoutBudget
routeTimeout httpApiGauntletServer "/reflect/query-empty" requestTimeoutBudget
routeTimeout httpApiGauntletServer "/reflect/query-repeat" requestTimeoutBudget
routeTimeout httpApiGauntletServer "/reflect/body" requestTimeoutBudget
routeTimeout httpApiGauntletServer "/reflect/body-bytes" requestTimeoutBudget
routeTimeout httpApiGauntletServer "/reflect/body-size" requestTimeoutBudget
routeTimeout httpApiGauntletServer "/multipart/text" requestTimeoutBudget
routeTimeout httpApiGauntletServer "/multipart/file-name" requestTimeoutBudget
routeTimeout httpApiGauntletServer "/multipart/file-type" requestTimeoutBudget
routeTimeout httpApiGauntletServer "/multipart/file-bytes" requestTimeoutBudget
routeTimeout httpApiGauntletServer "/events/one" requestTimeoutBudget
routeTimeout httpApiGauntletServer "/capabilities" requestTimeoutBudget
routeTimeout httpApiGauntletServer "/content/custom" requestTimeoutBudget
routeTimeout httpApiGauntletServer "/redirect" requestTimeoutBudget
routeTimeout httpApiGauntletServer "/empty" requestTimeoutBudget
routeTimeout httpApiGauntletServer "/patch" requestTimeoutBudget
# invariant: routeMiddleware is path-scoped AND now actually executes —
# semsc.py wires the middleware function pointer into the dispatcher so
# gauntletMiddleware fires before each handler. The
# middlewareMissingResponseEffect lint rule enforces that any op bound
# here declares `write http.response*`.
routeMiddleware httpApiGauntletServer "/" gauntletMiddleware
routeMiddleware httpApiGauntletServer "/health" gauntletMiddleware
routeMiddleware httpApiGauntletServer "/reflect/method" gauntletMiddleware
routeMiddleware httpApiGauntletServer "/reflect/path" gauntletMiddleware
routeMiddleware httpApiGauntletServer "/reflect/header" gauntletMiddleware
routeMiddleware httpApiGauntletServer "/reflect/required-header-or-fail" gauntletMiddleware
routeMiddleware httpApiGauntletServer "/reflect/query" gauntletMiddleware
routeMiddleware httpApiGauntletServer "/reflect/query-empty" gauntletMiddleware
routeMiddleware httpApiGauntletServer "/reflect/query-repeat" gauntletMiddleware
routeMiddleware httpApiGauntletServer "/reflect/body" gauntletMiddleware
routeMiddleware httpApiGauntletServer "/reflect/body-bytes" gauntletMiddleware
routeMiddleware httpApiGauntletServer "/reflect/body-size" gauntletMiddleware
routeMiddleware httpApiGauntletServer "/multipart/text" gauntletMiddleware
routeMiddleware httpApiGauntletServer "/multipart/file-name" gauntletMiddleware
routeMiddleware httpApiGauntletServer "/multipart/file-type" gauntletMiddleware
routeMiddleware httpApiGauntletServer "/multipart/file-bytes" gauntletMiddleware
routeMiddleware httpApiGauntletServer "/events/one" gauntletMiddleware
routeMiddleware httpApiGauntletServer "/capabilities" gauntletMiddleware
routeMiddleware httpApiGauntletServer "/content/custom" gauntletMiddleware
routeMiddleware httpApiGauntletServer "/redirect" gauntletMiddleware
routeMiddleware httpApiGauntletServer "/empty" gauntletMiddleware
routeMiddleware httpApiGauntletServer "/patch" gauntletMiddleware

capability httpRequestReader http.request read
purpose httpRequestReader "Authority to inspect current request method, path, header, query, body, and multipart values"
# invariant: Capability paths are hierarchical: a single `http.request read`
# grant authorizes every narrower `http.request.method`,
# `http.request.path`, `http.request.header`, `http.request.query`,
# `http.request.body`, and `http.request.multipart` read declared by
# downstream handlers. semsc's _check_effect_authority_coverage walks this
# hierarchy via _effect_path_covers.
capability httpResponseWriter http.response write
purpose httpResponseWriter "Authority to write status, body, content type, and custom response headers"

# Module-scope status constants — hoisted via `storage module immutable`
# (the canonical replacement for `const NAME TYPE VALUE`). Each value is
# named after the HTTP status code's contract so reviewers see intent at
# the call site, not just a magic number.
storage module immutable okStatus CSignedInt32 200
storage module immutable createdStatus CSignedInt32 201
storage module immutable noContentStatus CSignedInt32 204
storage module immutable redirectStatus CSignedInt32 302
storage module immutable badRequestStatus CSignedInt32 400
# The body-size threshold is picked so the small test fixture "small"
# (5 bytes) reports as `small body` and the large fixture
# "0123456789abcdef" (16 bytes) reports as `large body`. CByteCount lowers
# as i64 for the math.greaterThanOrEqualI64 comparison below.
storage module immutable largeBodyThreshold CByteCount 12
purpose largeBodyThreshold "Split body-size tests between the small fixture `small` and the large fixture `0123456789abcdef`"

operation addGauntletHeaders
input addGauntletHeaders response HttpResponse
output addGauntletHeaders Void
effect addGauntletHeaders write http.response
memory addGauntletHeaders arena request
async addGauntletHeaders no
useCapability addGauntletHeaders httpResponseWriter
purpose addGauntletHeaders "Attach common response headers (X-Gauntlet-App, X-Gauntlet-Version) used by every gauntlet test for cross-route identification"
invariant addGauntletHeaders "All header names and values are static module-scope strings; the native http.responseHeader writer accepts them without copying or escaping. The op returns Void because there is no caller-actionable status — header write failure surfaces at the per-route test assertions, not at this call boundary."
warning addGauntletHeaders "Per-header write statuses (from http.responseHeader) are intentionally ignored — the ignoreValue lines below acknowledge the per-call discard semantically. The op's Void output is the matching caller-side contract: callers do not need an ignoreValue line because Void has no value to discard. If a future http.responseHeader contract grows a caller-actionable failure mode, both the per-call ignoreValue here AND the op output type must be widened together."

label startAddGauntletHeaders

storage local immutable appHeaderName CNullTerminatedByteString "X-Gauntlet-App"
storage local immutable appHeaderValue CNullTerminatedByteString "http-api-gauntlet"
call appHeaderCall http.responseHeader
arg appHeaderCall response response
arg appHeaderCall name appHeaderName
arg appHeaderCall value appHeaderValue
run appHeaderCall
ignoreValue appHeaderCall CSignedInt32

storage local immutable versionHeaderName CNullTerminatedByteString "X-Gauntlet-Version"
storage local immutable versionHeaderValue CNullTerminatedByteString "1"
call versionHeaderCall http.responseHeader
arg versionHeaderCall response response
arg versionHeaderCall name versionHeaderName
arg versionHeaderCall value versionHeaderValue
run versionHeaderCall
ignoreValue versionHeaderCall CSignedInt32

storage local immutable headersOkStatus CSignedInt32 0
returnValue headersOkStatus

operation writeTextResponse
input writeTextResponse response HttpResponse
input writeTextResponse status CSignedInt32
input writeTextResponse body CNullTerminatedByteString
output writeTextResponse CSignedInt32
effect writeTextResponse write http.response
memory writeTextResponse arena request
async writeTextResponse no
useCapability writeTextResponse httpResponseWriter
purpose writeTextResponse "Write a plain text response through the native HTTP adapter, with the gauntlet's common headers attached first"
invariant writeTextResponse "The body argument is forwarded unchanged to http.responseText; the caller is responsible for ensuring it is non-null. The responseBodyForwarder declaration below tells semlint2 SS3603 to treat callers of this helper the same as callers of http.responseText, so the null-guard contract is preserved across the wrapper layer rather than relying on a `body` arg-name string match."
responseBodyForwarder writeTextResponse body

label startWriteTextResponse

# rationale: common headers go first because the native adapter latches
# headers into the wire buffer at the first body write — adding them after
# http.responseText would silently lose them.
call commonHeaderCall addGauntletHeaders
arg commonHeaderCall response response
run commonHeaderCall

call writeTextResponseCall http.responseText
arg writeTextResponseCall response response
arg writeTextResponseCall status status
arg writeTextResponseCall body body
run writeTextResponseCall
bind writeTextResponseStatus CSignedInt32 writeTextResponseCall
returnValue writeTextResponseStatus

operation indexHandler
input indexHandler request HttpRequest
input indexHandler response HttpResponse
output indexHandler CSignedInt32
effect indexHandler write http.response
memory indexHandler arena request
async indexHandler no
useCapability indexHandler httpResponseWriter
purpose indexHandler "Return a compact route map for the HTTP API gauntlet so operators and tests can discover the surface without out-of-band docs"
invariant indexHandler "The route map lists every current API family covered by this demo. The trailing note distinguishes the 400-on-missing-input contract used by most reflect routes from the one route that still pins the legacy null-body 500 contract."

label startIndexHandler

storage local immutable indexBody CNullTerminatedByteString "http api gauntlet\nroutes: /health /reflect/method /reflect/path /reflect/header /reflect/required-header-or-fail /reflect/query /reflect/query-empty /reflect/query-repeat /reflect/body /reflect/body-bytes /reflect/body-size /multipart/text /multipart/file-name /multipart/file-type /multipart/file-bytes /events/one /capabilities /content/custom /redirect /empty /patch\nmissing-input routes respond 400; /reflect/required-header-or-fail intentionally still 500s on missing X-Gauntlet-Required to keep coverage of the null-body failure path\n"
call indexResponseCall writeTextResponse
arg indexResponseCall response response
arg indexResponseCall status okStatus
arg indexResponseCall body indexBody
run indexResponseCall
bind indexResponseStatus CSignedInt32 indexResponseCall
returnValue indexResponseStatus

operation healthHandler
input healthHandler request HttpRequest
input healthHandler response HttpResponse
output healthHandler CSignedInt32
effect healthHandler write http.response
memory healthHandler arena request
async healthHandler no
useCapability healthHandler httpResponseWriter
purpose healthHandler "Return a minimal readiness body so external probes (tests, orchestrators) can poll for server liveness"
invariant healthHandler "Readiness stays static and side-effect free; the probe loop in test_http_api_gauntlet.py polls this endpoint until status 200, body `ok\\n`, and X-Gauntlet-App appear together"

label startHealthHandler

storage local immutable healthBody CNullTerminatedByteString "ok\n"
call healthResponseCall writeTextResponse
arg healthResponseCall response response
arg healthResponseCall status okStatus
arg healthResponseCall body healthBody
run healthResponseCall
bind healthResponseStatus CSignedInt32 healthResponseCall
returnValue healthResponseStatus

operation methodReflectHandler
input methodReflectHandler request HttpRequest
input methodReflectHandler response HttpResponse
output methodReflectHandler CSignedInt32
effect methodReflectHandler read http.request.method
effect methodReflectHandler write http.response
memory methodReflectHandler arena request
async methodReflectHandler no
useCapability methodReflectHandler httpRequestReader
useCapability methodReflectHandler httpResponseWriter
purpose methodReflectHandler "Return the exact request method string seen by the adapter so tests can verify case-preservation and exotic-method handling"
invariant methodReflectHandler "The adapter method matcher is case-insensitive at dispatch time but http.requestMethod returns the original spelling. The function never returns a null pointer for a dispatched request, so this handler does not need a pointer.isNull guard — every request that reached the handler has a method string."

label startMethodReflectHandler

call methodReadCall http.requestMethod
arg methodReadCall request request
run methodReadCall
bind requestMethod CNullTerminatedByteString methodReadCall
call methodResponseCall writeTextResponse
arg methodResponseCall response response
arg methodResponseCall status okStatus
arg methodResponseCall body requestMethod
run methodResponseCall
bind methodResponseStatus CSignedInt32 methodResponseCall
returnValue methodResponseStatus

operation pathReflectHandler
input pathReflectHandler request HttpRequest
input pathReflectHandler response HttpResponse
output pathReflectHandler CSignedInt32
effect pathReflectHandler read http.request.path
effect pathReflectHandler write http.response
memory pathReflectHandler arena request
async pathReflectHandler no
useCapability pathReflectHandler httpRequestReader
useCapability pathReflectHandler httpResponseWriter
purpose pathReflectHandler "Return the route path after query stripping so tests can verify the adapter's path normalization"
invariant pathReflectHandler "The returned path excludes the query string; http.requestPath returns a non-null pointer for any dispatched request (mirror of http.requestMethod), so no null guard is needed here"

label startPathReflectHandler

call pathReadCall http.requestPath
arg pathReadCall request request
run pathReadCall
bind requestPath CNullTerminatedByteString pathReadCall
call pathResponseCall writeTextResponse
arg pathResponseCall response response
arg pathResponseCall status okStatus
arg pathResponseCall body requestPath
run pathResponseCall
bind pathResponseStatus CSignedInt32 pathResponseCall
returnValue pathResponseStatus

operation headerReflectHandler
input headerReflectHandler request HttpRequest
input headerReflectHandler response HttpResponse
output headerReflectHandler CSignedInt32
effect headerReflectHandler read http.request.header
effect headerReflectHandler write http.response
memory headerReflectHandler arena request
async headerReflectHandler no
useCapability headerReflectHandler httpRequestReader
useCapability headerReflectHandler httpResponseWriter
purpose headerReflectHandler "Return the case-insensitive X-Gauntlet-Token request header when present, or a 400 with a static reason body when absent"
invariant headerReflectHandler "X-Gauntlet-Token absent ⇒ http.requestHeader returns null ⇒ pointer.isNull guard branches to headerMissingPath ⇒ 400. Present ⇒ raw header value returned with status 200. This route does NOT pin the null-body 500 contract; that role belongs to requiredHeaderHandler."
warning headerReflectHandler "The 400-on-missing-token contract is part of the route's tested surface; tests/check_http_api_gauntlet.ps1 asserts the 400 response body matches `missing header: X-Gauntlet-Token\\n`. Do not silently switch this back to the null-body 500 path — requiredHeaderHandler exists specifically to keep that coverage."

label startHeaderReflectHandler

storage local immutable tokenHeaderName CNullTerminatedByteString "x-gauntlet-token"
storage local immutable tokenMissingBody CNullTerminatedByteString "missing header: X-Gauntlet-Token\n"
call headerReadCall http.requestHeader
arg headerReadCall request request
arg headerReadCall name tokenHeaderName
run headerReadCall
bind tokenHeaderValue CNullTerminatedByteString headerReadCall

rationale tokenMissingCheckCall "pointer.isNull is the only typed null detector — the default branchIfError convention (result < 0) cannot inspect a returned NULL pointer. semsc lowers this to a real `icmp_unsigned eq ptr, null` (semsc.py:3674) so the branchIf below has a real Bool to read. The rationale is attached to the call via SS3608 instead of a proximity `# rationale:` comment so a refactor that renames or removes the call also surfaces this context as orphaned."
call tokenMissingCheckCall pointer.isNull
arg tokenMissingCheckCall pointer tokenHeaderValue
run tokenMissingCheckCall
bind tokenMissing Bool tokenMissingCheckCall
branchIf tokenMissing headerMissingPath

call headerResponseCall writeTextResponse
arg headerResponseCall response response
arg headerResponseCall status okStatus
arg headerResponseCall body tokenHeaderValue
run headerResponseCall
bind headerResponseStatus CSignedInt32 headerResponseCall
returnValue headerResponseStatus

label headerMissingPath
call headerMissingResponseCall writeTextResponse
arg headerMissingResponseCall response response
arg headerMissingResponseCall status badRequestStatus
arg headerMissingResponseCall body tokenMissingBody
run headerMissingResponseCall
bind headerMissingResponseStatus CSignedInt32 headerMissingResponseCall
returnValue headerMissingResponseStatus

operation requiredHeaderHandler
input requiredHeaderHandler request HttpRequest
input requiredHeaderHandler response HttpResponse
output requiredHeaderHandler CSignedInt32
effect requiredHeaderHandler read http.request.header
effect requiredHeaderHandler write http.response
memory requiredHeaderHandler arena request
async requiredHeaderHandler no
useCapability requiredHeaderHandler httpRequestReader
useCapability requiredHeaderHandler httpResponseWriter
purpose requiredHeaderHandler "Negative-test route: returns the required header value with 200 when X-Gauntlet-Required is present, and intentionally exposes the adapter's null-body 500 failure path when absent"
invariant requiredHeaderHandler "This is the gauntlet's one route that intentionally omits a pointer.isNull guard. The absent-header case binds null to requiredHeaderValue, passes it to writeTextResponse → http.responseText, and the runtime rejects the null body with a 500. This pins the adapter's `handler failed` contract for regression detection."
pinsNullBodyFailurePath requiredHeaderHandler "The /reflect/required-header-or-fail route is the gauntlet's deliberate coverage of the adapter's null-body 500 path. semlint2 SS3603 treats the presence of this verb as the canonical opt-out; the rationale string here documents WHY the route is shaped this way so a future agent removing the verb has to first prove the runtime contract has changed and the coverage is no longer needed."
warning requiredHeaderHandler "Do not add a pointer.isNull guard to this handler. The 500-on-missing-X-Gauntlet-Required behavior is asserted at test_http_api_gauntlet.py:273-279 as the gauntlet's only check that the native adapter still returns `handler failed\\n` when a handler hands a null body to http.responseText. If the runtime contract for null bodies changes, update both the test and this op together — do not silence the assertion by adding a guard here."

label startRequiredHeaderHandler

storage local immutable requiredHeaderName CNullTerminatedByteString "x-gauntlet-required"
call requiredHeaderReadCall http.requestHeader
arg requiredHeaderReadCall request request
arg requiredHeaderReadCall name requiredHeaderName
run requiredHeaderReadCall
bind requiredHeaderValue CNullTerminatedByteString requiredHeaderReadCall
call requiredHeaderResponseCall writeTextResponse
arg requiredHeaderResponseCall response response
arg requiredHeaderResponseCall status okStatus
arg requiredHeaderResponseCall body requiredHeaderValue
run requiredHeaderResponseCall
bind requiredHeaderResponseStatus CSignedInt32 requiredHeaderResponseCall
returnValue requiredHeaderResponseStatus

operation queryReflectHandler
input queryReflectHandler request HttpRequest
input queryReflectHandler response HttpResponse
output queryReflectHandler CSignedInt32
effect queryReflectHandler read http.request.query
effect queryReflectHandler write http.response
memory queryReflectHandler arena request
async queryReflectHandler no
useCapability queryReflectHandler httpRequestReader
useCapability queryReflectHandler httpResponseWriter
purpose queryReflectHandler "Return the raw `name` query parameter when present, or a 400 with a static reason body when absent"
invariant queryReflectHandler "Query values are raw, undecoded splits — percent-decoding is intentionally future work. The guard distinguishes `?name=foo` (returned verbatim, 200) from `?other=foo` or no query string (null bind ⇒ 400) and from `?name=` (empty string bind, 200)."
warning queryReflectHandler "The 400-on-missing-name contract is tested externally; if the request omits `name` the response body is `missing query parameter: name\\n`. Refactors that switch this back to the null-body 500 path break the test."

label startQueryReflectHandler

storage local immutable nameQueryName CNullTerminatedByteString "name"
storage local immutable nameQueryMissingBody CNullTerminatedByteString "missing query parameter: name\n"
call queryReadCall http.requestQueryParam
arg queryReadCall request request
arg queryReadCall name nameQueryName
run queryReadCall
bind queryValue CNullTerminatedByteString queryReadCall

# rationale: same null-guard pattern as headerReflectHandler — keeps the
# 400 contract for absent keys distinct from the empty-value contract
# exercised by queryEmptyHandler.
call queryMissingCheckCall pointer.isNull
arg queryMissingCheckCall pointer queryValue
run queryMissingCheckCall
bind queryMissing Bool queryMissingCheckCall
branchIf queryMissing queryReflectMissingPath

call queryResponseCall writeTextResponse
arg queryResponseCall response response
arg queryResponseCall status okStatus
arg queryResponseCall body queryValue
run queryResponseCall
bind queryResponseStatus CSignedInt32 queryResponseCall
returnValue queryResponseStatus

label queryReflectMissingPath
call queryReflectMissingResponseCall writeTextResponse
arg queryReflectMissingResponseCall response response
arg queryReflectMissingResponseCall status badRequestStatus
arg queryReflectMissingResponseCall body nameQueryMissingBody
run queryReflectMissingResponseCall
bind queryReflectMissingResponseStatus CSignedInt32 queryReflectMissingResponseCall
returnValue queryReflectMissingResponseStatus

operation queryEmptyHandler
input queryEmptyHandler request HttpRequest
input queryEmptyHandler response HttpResponse
output queryEmptyHandler CSignedInt32
effect queryEmptyHandler read http.request.query
effect queryEmptyHandler write http.response
memory queryEmptyHandler arena request
async queryEmptyHandler no
useCapability queryEmptyHandler httpRequestReader
useCapability queryEmptyHandler httpResponseWriter
purpose queryEmptyHandler "Return the empty value for a query key that has no equals sign (?empty), or 400 when the key is absent entirely"
invariant queryEmptyHandler "Three distinct cases: `?empty` → empty string bind → 200 with empty body; `?empty=value` → `value` bind → 200; no `empty` at all → null bind → 400. The native query splitter treats a key without `=` as having an empty-string value, which is the case under test."
warning queryEmptyHandler "Do not collapse the absent-key and present-with-empty-value cases: tests rely on the 200/empty-body distinction to verify the native splitter's `key-without-equals` behavior. Tests also rely on the 400-on-absent-key contract for regression coverage of the guard pattern."

label startQueryEmptyHandler

storage local immutable emptyQueryName CNullTerminatedByteString "empty"
storage local immutable emptyQueryMissingBody CNullTerminatedByteString "missing query parameter: empty\n"
call emptyQueryReadCall http.requestQueryParam
arg emptyQueryReadCall request request
arg emptyQueryReadCall name emptyQueryName
run emptyQueryReadCall
bind emptyQueryValue CNullTerminatedByteString emptyQueryReadCall

call emptyQueryMissingCheckCall pointer.isNull
arg emptyQueryMissingCheckCall pointer emptyQueryValue
run emptyQueryMissingCheckCall
bind emptyQueryMissing Bool emptyQueryMissingCheckCall
branchIf emptyQueryMissing queryEmptyMissingPath

call emptyQueryResponseCall writeTextResponse
arg emptyQueryResponseCall response response
arg emptyQueryResponseCall status okStatus
arg emptyQueryResponseCall body emptyQueryValue
run emptyQueryResponseCall
bind emptyQueryResponseStatus CSignedInt32 emptyQueryResponseCall
returnValue emptyQueryResponseStatus

label queryEmptyMissingPath
call queryEmptyMissingResponseCall writeTextResponse
arg queryEmptyMissingResponseCall response response
arg queryEmptyMissingResponseCall status badRequestStatus
arg queryEmptyMissingResponseCall body emptyQueryMissingBody
run queryEmptyMissingResponseCall
bind queryEmptyMissingResponseStatus CSignedInt32 queryEmptyMissingResponseCall
returnValue queryEmptyMissingResponseStatus

operation queryRepeatHandler
input queryRepeatHandler request HttpRequest
input queryRepeatHandler response HttpResponse
output queryRepeatHandler CSignedInt32
effect queryRepeatHandler read http.request.query
effect queryRepeatHandler write http.response
memory queryRepeatHandler arena request
async queryRepeatHandler no
useCapability queryRepeatHandler httpRequestReader
useCapability queryRepeatHandler httpResponseWriter
purpose queryRepeatHandler "Return the first `name` query parameter when the request repeats the key (e.g. ?name=a&name=b), or 400 when absent"
invariant queryRepeatHandler "The native adapter's query lookup returns the FIRST matching key — this is adapter behavior, not a language-level duplicate-key policy. The test sends `?name=first&name=second` and asserts the response body is `first`."
warning queryRepeatHandler "If the native adapter's first-vs-last lookup policy ever changes, the assertion in test_http_api_gauntlet.py will need to update in lock-step. The 400 path also gives the test a way to detect a guard regression (the call would return 200 with body `first` instead of the missing-key 400)."

label startQueryRepeatHandler

storage local immutable repeatQueryName CNullTerminatedByteString "name"
storage local immutable repeatQueryMissingBody CNullTerminatedByteString "missing query parameter: name\n"
call repeatQueryReadCall http.requestQueryParam
arg repeatQueryReadCall request request
arg repeatQueryReadCall name repeatQueryName
run repeatQueryReadCall
bind repeatQueryValue CNullTerminatedByteString repeatQueryReadCall

call repeatQueryMissingCheckCall pointer.isNull
arg repeatQueryMissingCheckCall pointer repeatQueryValue
run repeatQueryMissingCheckCall
bind repeatQueryMissing Bool repeatQueryMissingCheckCall
branchIf repeatQueryMissing queryRepeatMissingPath

call repeatQueryResponseCall writeTextResponse
arg repeatQueryResponseCall response response
arg repeatQueryResponseCall status okStatus
arg repeatQueryResponseCall body repeatQueryValue
run repeatQueryResponseCall
bind repeatQueryResponseStatus CSignedInt32 repeatQueryResponseCall
returnValue repeatQueryResponseStatus

label queryRepeatMissingPath
call queryRepeatMissingResponseCall writeTextResponse
arg queryRepeatMissingResponseCall response response
arg queryRepeatMissingResponseCall status badRequestStatus
arg queryRepeatMissingResponseCall body repeatQueryMissingBody
run queryRepeatMissingResponseCall
bind queryRepeatMissingResponseStatus CSignedInt32 queryRepeatMissingResponseCall
returnValue queryRepeatMissingResponseStatus

operation bodyReflectHandler
input bodyReflectHandler request HttpRequest
input bodyReflectHandler response HttpResponse
output bodyReflectHandler CSignedInt32
effect bodyReflectHandler read http.request.body
effect bodyReflectHandler write http.response
memory bodyReflectHandler arena request
async bodyReflectHandler no
useCapability bodyReflectHandler httpRequestReader
useCapability bodyReflectHandler httpResponseWriter
purpose bodyReflectHandler "Echo the POST body back to the client with status 201 (Created), or 400 when the body is empty/absent"
invariant bodyReflectHandler "The demo treats the bounded body bytes as UTF-8 text and does not decode structured formats; http.requestBodyText returns null for a zero-length body, which the guard maps to a 400. Returning 201 on the success path matches REST semantics for `create from request body`."
warning bodyReflectHandler "Status 201 (createdStatus) is intentional: this route is shaped as a `create` endpoint for test coverage of non-200 success statuses. If you switch this to 200, update test_http_api_gauntlet.py's body-reflect assertion accordingly."

label startBodyReflectHandler

storage local immutable bodyMissingBody CNullTerminatedByteString "missing request body\n"
call bodyReadCall http.requestBodyText
arg bodyReadCall request request
run bodyReadCall
bind bodyText CNullTerminatedByteString bodyReadCall

call bodyMissingCheckCall pointer.isNull
arg bodyMissingCheckCall pointer bodyText
run bodyMissingCheckCall
bind bodyMissing Bool bodyMissingCheckCall
branchIf bodyMissing bodyReflectMissingPath

call bodyResponseCall writeTextResponse
arg bodyResponseCall response response
arg bodyResponseCall status createdStatus
arg bodyResponseCall body bodyText
run bodyResponseCall
bind bodyResponseStatus CSignedInt32 bodyResponseCall
returnValue bodyResponseStatus

label bodyReflectMissingPath
call bodyReflectMissingResponseCall writeTextResponse
arg bodyReflectMissingResponseCall response response
arg bodyReflectMissingResponseCall status badRequestStatus
arg bodyReflectMissingResponseCall body bodyMissingBody
run bodyReflectMissingResponseCall
bind bodyReflectMissingResponseStatus CSignedInt32 bodyReflectMissingResponseCall
returnValue bodyReflectMissingResponseStatus

operation bodyBytesReflectHandler
input bodyBytesReflectHandler request HttpRequest
input bodyBytesReflectHandler response HttpResponse
output bodyBytesReflectHandler CSignedInt32
effect bodyBytesReflectHandler read http.request.body
effect bodyBytesReflectHandler write http.response
memory bodyBytesReflectHandler arena request
async bodyBytesReflectHandler no
useCapability bodyBytesReflectHandler httpRequestReader
useCapability bodyBytesReflectHandler httpResponseWriter
purpose bodyBytesReflectHandler "Echo the raw request body bytes (application/octet-stream) with an explicit response length, or 400 when the body is absent"
invariant bodyBytesReflectHandler "The success-leg response length comes from http.requestBodyLength, NOT from strlen on bodyBytePointer — this preserves embedded NUL bytes round-trip, which is the entire reason to expose a bytes-vs-text distinction in the adapter. The 400 leg falls through to http.responseText so the error body remains plain text."
warning bodyBytesReflectHandler "Do not be tempted to consolidate the 400 leg into http.responseBytes — passing a static text string through the binary writer changes the response content type and breaks the test's `text/plain;` assertion on missing-body. The two writers are intentionally split here."

label startBodyBytesReflectHandler

