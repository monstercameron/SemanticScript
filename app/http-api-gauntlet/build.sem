# HttpApiGauntlet regular SemanticScript build plan.
# Build configuration is ordinary typed record data; semsc lowers BuildPlan internally.

module app.httpApiGauntlet.build
purpose module app.httpApiGauntlet.build "Describe the HttpApiGauntlet build as ordinary typed SemanticScript data."
moduleOwns app.httpApiGauntlet.build "Build project metadata, module registration, target options, version metadata, and build constants."
moduleDoesNotOwn app.httpApiGauntlet.build "Runtime application behavior; registered app modules own operations, routes, exports, and UI/domain logic."
invariant module app.httpApiGauntlet.build "Build configuration is data first: records hold settings, and configure operation returns the selected BuildPlan."

record BuildProject
field BuildProject id String
field BuildProject name String
field BuildProject modulePath String
field BuildProject languageVersion String
field BuildProject projectVersion String
field BuildProject license String
field BuildProject sourceRoot String
field BuildProject testPattern String
field BuildProject testRoot String

record BuildModule
field BuildModule moduleName String
field BuildModule sourcePath String
field BuildModule mainFile String

record BuildModules
field BuildModules main BuildModule

record BuildTarget
field BuildTarget runtime String
field BuildTarget nativeRuntime String
field BuildTarget nativeRuntimeVersion I64
field BuildTarget profile String
field BuildTarget optLevel I64
field BuildTarget runtimeChecks String
field BuildTarget persistLlvmIr String
field BuildTarget emitLlvmIr String
field BuildTarget emitOptimizedLlvmIr Bool
field BuildTarget buildFolderName String
field BuildTarget cpuBaseline String
field BuildTarget cpuTune String
field BuildTarget cpuFeatureCheck String
field BuildTarget nativeHttpHost String
field BuildTarget nativeHttpPort I64
field BuildTarget formatterLineWidth I64
field BuildTarget linterMaxTier String
field BuildTarget docsOutput String
field BuildTarget nativeOutput String
field BuildTarget comptimeOperation String

record BuildMetadata
field BuildMetadata buildSource String
field BuildMetadata runtimeContract String
field BuildMetadata conformanceScope String
field BuildMetadata dispatcherPort String

record BuildVersionInfo
field BuildVersionInfo version String
field BuildVersionInfo publisher String
field BuildVersionInfo description String
field BuildVersionInfo copyright String
field BuildVersionInfo productName String
field BuildVersionInfo internalName String
field BuildVersionInfo originalFilename String
field BuildVersionInfo comments String
field BuildVersionInfo metadata BuildMetadata

record BuildConstant
field BuildConstant type String
field BuildConstant value String

record BuildConstants

record BuildPlan
field BuildPlan project BuildProject
field BuildPlan modules BuildModules
field BuildPlan mainModule String
field BuildPlan target BuildTarget
field BuildPlan versionInfo BuildVersionInfo
field BuildPlan constants BuildConstants

storage module immutable httpApiGauntletBuildPlan BuildPlan
jsonBody httpApiGauntletBuildPlan
  {
      "project": {
          "name": "HttpApiGauntlet",
          "id": "httpApiGauntlet",
          "modulePath": "github.com/monstercameron/SemanticScript/app/http-api-gauntlet",
          "languageVersion": "1.0",
          "projectVersion": "1.0.0",
          "license": "MIT",
          "sourceRoot": ".",
          "testPattern": "*.test.sem",
          "testRoot": "."
      },
      "modules": {
          "main": {
              "moduleName": "app.http_api_gauntlet",
              "sourcePath": ".",
              "mainFile": "main.sem"
          }
      },
      "mainModule": "main",
      "target": {
          "runtime": "webServer",
          "nativeRuntime": "native",
          "nativeRuntimeVersion": 1,
          "profile": "dev",
          "optLevel": 2,
          "runtimeChecks": "panic",
          "persistLlvmIr": "yes",
          "emitLlvmIr": "auto",
          "emitOptimizedLlvmIr": false,
          "buildFolderName": "build",
          "cpuBaseline": "generic",
          "cpuTune": "generic",
          "cpuFeatureCheck": "auto",
          "nativeHttpHost": "127.0.0.1",
          "nativeHttpPort": 18082,
          "formatterLineWidth": 100,
          "linterMaxTier": "T4",
          "docsOutput": "docs",
          "nativeOutput": "http_api_gauntlet.exe",
          "comptimeOperation": "configureHttpApiGauntletBuild"
      },
      "versionInfo": {
          "version": "1.0.0.0",
          "publisher": "Earl Cameron",
          "description": "SemanticScript HTTP API gauntlet — native HTTP/1.1 adapter conformance harness exercising every routing, request-read, response-write, multipart, SSE, and middleware edge currently lowered by the reference compiler.",
          "copyright": "Copyright (c) 2026 Earl Cameron. Licensed under the project LICENSE.",
          "productName": "HTTP API Gauntlet",
          "internalName": "http_api_gauntlet",
          "originalFilename": "http_api_gauntlet.exe",
          "comments": "Built from app/http-api-gauntlet/main.sem by the SemanticScript reference compiler. Conformance scope: routing | requestReads | responseWrites | multipart | sse | middleware | MiddlewareControl | pinsNullBodyFailurePath.",
          "metadata": {
              "buildSource": "app/http-api-gauntlet/main.sem",
              "runtimeContract": "native 1",
              "conformanceScope": "routing|requestReads|responseWrites|multipart|sse|middleware|MiddlewareControl|pinsNullBodyFailurePath",
              "dispatcherPort": "18082"
          }
      },
      "constants": {}
  }

operation configureHttpApiGauntletBuild
output operation configureHttpApiGauntletBuild BuildPlan
memory configureHttpApiGauntletBuild heap no
async configureHttpApiGauntletBuild no
purpose operation configureHttpApiGauntletBuild "Return the typed build plan for HttpApiGauntlet."
return value httpApiGauntletBuildPlan
