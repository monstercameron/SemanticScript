# Todo Web Pro — project build tape.
# Production-grade web app: per-user authentication via bcrypt-cost-12
# hashed passwords + server-side sessions, todo CRUD, image upload
# (filesystem-backed at build/images/), and JSON REST API.
# Built on standard.http + standard.sqlite + standard.json + standard.bcrypt.

buildProject todoWebPro
project TodoWebPro
modulePath todoWebPro github.com/monstercameron/SemanticScript/app/todo-web-pro
languageVersion todoWebPro "1.0"
projectVersion todoWebPro "1.0.0"
projectLicense todoWebPro MIT

sourceRoot todoWebPro "."
registerModule todoWebPro app.todo_web_pro "."
registerModule todoWebPro app.todo_web_pro.pages "pages"
mainFile todoWebPro "main.sem"
testPattern todoWebPro "*.test.sem"
testRoot todoWebPro "."

target webServer
runtime native 1

version "1.0.0.0"
publisher "Earl Cameron"
description "SemanticScript Todo Web Pro — multi-user todo app with bcrypt auth, sqlite storage, image upload, and Tailwind HTML pages."
copyright "Copyright (c) 2026 Earl Cameron. Licensed under the project LICENSE."
productName "Todo Web Pro"
internalName "todo_web_pro"
originalFilename "todo_web_pro.exe"
comments "Built from app/todo-web-pro/main.sem by the SemanticScript reference compiler. Stack: standard.http + standard.sqlite + standard.json + standard.bcrypt + standard.html."
metadata "BuildSource" "app/todo-web-pro/main.sem"
metadata "RuntimeContract" "native 1"
metadata "DispatcherPort" "18090"
metadata "BcryptCost" "12"

targetRuntime todoWebPro webServer
buildProfile todoWebPro dev
optLevel todoWebPro 2
runtimeChecks todoWebPro panic
persistLlvmIr todoWebPro yes
emitLlvmIr todoWebPro auto
emitOptimizedLlvmIr todoWebPro no
buildFolderName todoWebPro build
cpuBaseline todoWebPro generic
cpuTune todoWebPro generic
cpuFeatureCheck todoWebPro auto
nativeHttpHost todoWebPro "127.0.0.1"
nativeHttpPort todoWebPro 18090
formatterSetting todoWebPro lineWidth 100
linterSetting todoWebPro maxTier T4
docsOutput todoWebPro "docs"
nativeOutput todoWebPro "todo_web_pro.exe"

importModule app.todo_web_pro
