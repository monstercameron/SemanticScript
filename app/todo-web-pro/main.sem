# Todo Web Pro — production web app.
#
# This module composes the standard.http + standard.sqlite + standard.json +
# standard.bcrypt runtimes into a multi-user todo web app. Auth uses bcrypt
# cost 12 password hashes + server-side sessions; data is per-user-scoped.

module app.todo_web_pro
modulePurpose app.todo_web_pro "Multi-user todo web app: bcrypt-cost-12 authenticated sessions over standard.http + standard.sqlite + standard.json, with per-user data isolation and a JSON REST API."
moduleOwns app.todo_web_pro "Route table for /health and /api/*, sqlite schema (users + sessions + todos + todo_images tables), session cookie lifecycle, JSON response shapes, per-handler authorization gating."
moduleDoesNotOwn app.todo_web_pro "HTTP dispatch (standard.http runtime), bcrypt algorithm (third_party/bcrypt via standard.bcrypt), sqlite engine (third_party/sqlite via standard.sqlite), JSON serialization (standard.json runtime), HTML templating (standard.html)."
moduleInvariant app.todo_web_pro "Every /api/* handler except /health, /api/version, /api/auth/register and /api/auth/login MUST call requireSessionUserId BEFORE running any SQL, and MUST scope every SELECT/UPDATE/DELETE with `WHERE user_id = ?` bound to the returned user id."
moduleSecurity app.todo_web_pro "Session cookies are HttpOnly + SameSite=Strict; the value is a 43-char base64url-encoded 32-byte sample from the platform CSPRNG via bcrypt.randomBytes. Login failures emit a generic message regardless of whether the username existed."
moduleWarning app.todo_web_pro "One shared sqlite handle opened lazily on first request and used by every handler. Safe under the current blocking HTTP/1.1 backend (one request at a time); migrating to an async backend needs a per-thread connection pool."

importModule standard.http
importModule standard.sqlite
importModule standard.json
importModule standard.bcrypt
importModule standard.html
importModule standard.log

# HomePageTemplate + homePageHandler live in their own folder module
# at modules/pages/main.sem. The import line is at the BOTTOM of this
# file (search for "importModule app.todo_web_pro.pages") so the
# template's last htmlBody / operation block doesn't leave a dangling
# current_op that subsequent purpose/input rows would mis-attribute.

# The webServer declaration verbs take string + int LITERALS today (the
# parser doesn't yet resolve identifiers in their tail args), so the
# host + port appear here AS literals — but the values MUST stay in
# sync with the serverHostText / serverPortNumber storage constants
# above AND with the `nativeHttpHost todoWebPro` / `nativeHttpPort
# todoWebPro` rows in build.sem. Drift between those three sites is
# the kind of bug the SS3612 lint rule will catch once it lands.
webServer todoWebProServer
purpose todoWebProServer "Host the Todo Web Pro JSON REST API on localhost:18090; every API route except /, /health, /api/version, and /api/auth/{register,login} requires a valid session cookie."
serverHost todoWebProServer "127.0.0.1"
serverPort todoWebProServer 18090

route todoWebProServer GET "/" homePageHandler
route todoWebProServer GET "/dashboard" dashboardPageHandler
route todoWebProServer GET "/assets/:filename" staticAssetHandler
route todoWebProServer GET "/health" healthHandler
route todoWebProServer GET "/api/version" versionHandler
route todoWebProServer POST "/api/auth/register" registerHandler
route todoWebProServer POST "/api/auth/login" loginHandler
route todoWebProServer POST "/api/auth/logout" logoutHandler
route todoWebProServer GET "/api/auth/me" meHandler
route todoWebProServer GET "/api/todos" listTodosHandler
route todoWebProServer POST "/api/todos" createTodoHandler
route todoWebProServer GET "/api/todos/:id" showTodoHandler
route todoWebProServer DELETE "/api/todos/:id" deleteTodoHandler
route todoWebProServer POST "/api/todos/:id/complete" completeTodoHandler
route todoWebProServer POST "/api/todos/:id/uncomplete" uncompleteTodoHandler
# Wildcard route — the runtime pulls this out of the route table at
# config-build time and uses it as the 404 fallback. NOT a real
# pattern match; the path string "*" is a registered convention.
# Method GET is also a placeholder (the dispatcher ignores the method
# when invoking the not-found handler).
route todoWebProServer GET "*" notFoundPageHandler

# ===== capabilities (locally declared; httpRequestReader / httpResponseWriter
# / sqliteDatabaseReader / sqliteDatabaseReadWriter come from imported stdlib
# modules) =====

capability bcryptHashCompute compute bcryptHash
purpose bcryptHashCompute "Authority to run the bcrypt password hashing key schedule at cost 12."

capability bcryptRandomCompute compute bcryptRandom
purpose bcryptRandomCompute "Authority to draw bytes from the platform CSPRNG via bcrypt.randomBytes — used to mint session tokens."

capability heapAllocCapability heap allocate
purpose heapAllocCapability "Authority to allocate per-request scratch buffers (JSON builder, base64url output, etc.)."

capability heapFreeCapability heap free
purpose heapFreeCapability "Authority to free the same buffers via defer c.free at handler exit."

capability filesystemCreateCapability filesystem create
purpose filesystemCreateCapability "Authority to create the build/images/ directory at startup."

capability filesystemReadCapability filesystem read
purpose filesystemReadCapability "Authority to read files from the app assets directory for static response serving."

# ===== module-scope constants =====

# ===== shared module-scope env (project-wide source of truth) =====
#
# These five constants are the only place in the app that names the
# host, port, database storage path, assets directory, and images
# directory. Sub-modules (currently just app.todo_web_pro.pages, but
# extensible) read them by referencing the same name — so an env
# change here propagates without per-module shifting. The webServer
# declaration below ALSO uses serverHostText / serverPortNumber, and
# build.sem's `nativeHttpHost` / `nativeHttpPort` rows are documented
# as needing to match (lint enforcement of that linkage is a v1.1
# follow-up — see SS3612 in the linter spec roadmap).
#
# DATABASE STORAGE MODE: flip databaseUsePersistentStorage between
#   - "yes" → durable file at databasePath (default; sessions + todos
#     survive restarts)
#   - "no"  → in-memory only via ":memory:" (zero on-disk footprint,
#     ideal for tests; every restart resets everything including the
#     seeded demo user)
# Currently the runtime uses databasePath unconditionally; the
# in-memory mode flag is read by the test harness to start with a
# clean slate per run.
storage module immutable serverHostText CNullTerminatedByteString "127.0.0.1"
storage module immutable serverPortNumber CSignedInt32 18090
storage module immutable apiBaseUrlText CNullTerminatedByteString "http://127.0.0.1:18090"

storage module immutable databaseUsePersistentStorage CNullTerminatedByteString "yes"
storage module immutable databasePath CNullTerminatedByteString "todo_web_pro.db"
storage module immutable databaseInMemoryPath CNullTerminatedByteString ":memory:"

storage module immutable imagesDirectoryPath CNullTerminatedByteString "images"
# Root directory for static assets — resolved relative to the exe's
# working directory at run time, so assets/ must live alongside the
# exe (the post-build step in scripts/test_todo_web_pro.py copies the
# source tree's app/todo-web-pro/assets/ into build/assets/).
storage module immutable assetsDirectoryPath CNullTerminatedByteString "assets"
storage module immutable assetFilenameParam CNullTerminatedByteString "filename"

storage module immutable httpStatusOk CSignedInt32 200
storage module immutable httpStatusCreated CSignedInt32 201
storage module immutable httpStatusNoContent CSignedInt32 204
storage module immutable httpStatusBadRequest CSignedInt32 400
storage module immutable httpStatusUnauthorized CSignedInt32 401
storage module immutable httpStatusNotFound CSignedInt32 404
storage module immutable httpStatusConflict CSignedInt32 409
storage module immutable httpStatusInternalServerError CSignedInt32 500

storage module immutable jsonResponseCapacity CSignedInt64 4096
storage module immutable usernameScratchCapacity CSignedInt64 64
storage module immutable passwordScratchCapacity CSignedInt64 256
storage module immutable displayNameScratchCapacity CSignedInt64 128
storage module immutable titleScratchCapacity CSignedInt64 512
storage module immutable bodyScratchCapacity CSignedInt64 10240
storage module immutable hashBufferCapacity CSignedInt64 64
storage module immutable hashCapacityArg CSignedInt32 61
storage module immutable randomBufferCapacity CSignedInt64 32
storage module immutable randomByteCountArg CSignedInt32 32
storage module immutable tokenBufferCapacity CSignedInt64 64
storage module immutable tokenCapacityArg CSignedInt32 64
storage module immutable cookieHeaderCapacity CSignedInt64 256

# Structured-log bootstrap constants. The web server writes one
# JSON-per-line audit file at `<cwd>/logs/log.log` — for a build/-launched
# exe that means `app/todo-web-pro/build/logs/log.log`. The directory is
# created lazily on first request; the log file is opened in append mode
# so re-running the server preserves history across restarts.
storage module immutable logsDirectoryPath  CNullTerminatedByteString "logs"
storage module immutable logFilePath        CNullTerminatedByteString "logs/log.log"
storage module immutable serverStartLogMessage CNullTerminatedByteString "server.started"
storage module immutable userRegisteredLogMessage CNullTerminatedByteString "user.registered"
storage module immutable userLoginSucceededLogMessage CNullTerminatedByteString "user.login.succeeded"
storage module immutable userLoginFailedLogMessage CNullTerminatedByteString "user.login.failed"
storage module immutable userLogoutLogMessage CNullTerminatedByteString "user.logout"
storage module immutable todoCreatedLogMessage CNullTerminatedByteString "todo.created"
storage module immutable todoCompletedLogMessage CNullTerminatedByteString "todo.completed"
storage module immutable todoUncompletedLogMessage CNullTerminatedByteString "todo.uncompleted"
storage module immutable todoDeletedLogMessage CNullTerminatedByteString "todo.deleted"

# Per-row scratch holds one serialized todo (id + title + done + priority).
# Title is capped at 280 chars by the schema; the JSON envelope adds ~80 chars,
# so 512 bytes is the comfortable upper bound for one row.
storage module immutable todoRowScratchCapacity CSignedInt64 512
# Accumulator for the full {"todos":[…],"count":N} response. With the SQL
# LIMIT of 100 rows × ~500 bytes per row, 64 KiB is the deliberately
# generous ceiling. The serializer also bounds the appended bytes per row
# via snprintf into a scratch — overflow there silently truncates the
# single row rather than corrupting the response.
storage module immutable todosListBufferCapacity CSignedInt64 65536

storage module immutable sessionLifetimeMs CSignedInt64 2592000000
storage module immutable jsonOk CSignedInt32 0
storage module immutable falseBit CSignedInt32 0
storage module immutable trueBit CSignedInt32 1

storage module immutable cookieNameSession CNullTerminatedByteString "session"
storage module immutable setCookieHeaderName CNullTerminatedByteString "Set-Cookie"

# Cookie attribute suffix appended after the token in Set-Cookie.
storage module immutable cookieAttributeSuffix CNullTerminatedByteString "; Path=/; HttpOnly; SameSite=Strict; Max-Age=2592000"
storage module immutable cookieClearSuffix CNullTerminatedByteString "session=; Path=/; HttpOnly; SameSite=Strict; Max-Age=0"
storage module immutable cookieNameEquals CNullTerminatedByteString "session="

# Field names for JSON parsing / building.
storage module immutable fieldUsername CNullTerminatedByteString "username"
storage module immutable fieldPassword CNullTerminatedByteString "password"
storage module immutable fieldDisplayName CNullTerminatedByteString "displayName"
storage module immutable fieldTitle CNullTerminatedByteString "title"
storage module immutable fieldBody CNullTerminatedByteString "body"
storage module immutable fieldPriority CNullTerminatedByteString "priority"
storage module immutable fieldUser CNullTerminatedByteString "user"
storage module immutable fieldTodo CNullTerminatedByteString "todo"
storage module immutable fieldTodos CNullTerminatedByteString "todos"
storage module immutable fieldCount CNullTerminatedByteString "count"
storage module immutable fieldId CNullTerminatedByteString "id"
storage module immutable fieldDone CNullTerminatedByteString "done"
storage module immutable fieldCreatedAtMs CNullTerminatedByteString "createdAtMs"
storage module immutable fieldUpdatedAtMs CNullTerminatedByteString "updatedAtMs"
storage module immutable fieldCompletedAtMs CNullTerminatedByteString "completedAtMs"

# ===== schema (literal-loaded at compile time) =====
# `literal NAME TYPE` declares the const slot; `literalSource NAME "path"`
# tells semsc to read the bytes from disk at compile time and replace the
# stub value. `literalBytes` and `literalTrust` document the size + trust
# class for tooling.

literal schemaSqlSource CNullTerminatedByteString
literalSource schemaSqlSource "sql/schema.sql"
literalBytes schemaSqlSource 4136
literalTrust schemaSqlSource trustedStaticAsset

# ===== shared database handle (lazy-opened on first request) =====

storage module mutable sharedDatabaseHandle SqliteDatabase 0
storage module mutable sharedDatabaseReady CSignedInt32 0

# ===== SQL statement constants =====

storage module immutable sqlInsertUser CNullTerminatedByteString "INSERT INTO users (username, password_hash, display_name, created_at_ms, last_login_ms) VALUES (?, ?, ?, ?, ?)"
storage module immutable sqlInsertSession CNullTerminatedByteString "INSERT INTO sessions (token, user_id, issued_at_ms, expires_at_ms, last_seen_ms) VALUES (?, ?, ?, ?, ?)"
storage module immutable sqlSelectUserByUsername CNullTerminatedByteString "SELECT id, username, password_hash, display_name FROM users WHERE username = ? COLLATE NOCASE LIMIT 1"
storage module immutable sqlSelectSessionByToken CNullTerminatedByteString "SELECT user_id, expires_at_ms FROM sessions WHERE token = ? LIMIT 1"
storage module immutable sqlSelectUserById CNullTerminatedByteString "SELECT id, username, display_name FROM users WHERE id = ? LIMIT 1"
storage module immutable sqlDeleteSessionByToken CNullTerminatedByteString "DELETE FROM sessions WHERE token = ?"
storage module immutable sqlUpdateLastLogin CNullTerminatedByteString "UPDATE users SET last_login_ms = ? WHERE id = ?"
storage module immutable sqlInsertTodo CNullTerminatedByteString "INSERT INTO todos (user_id, title, body, done, priority, created_at_ms, updated_at_ms) VALUES (?, ?, ?, 0, ?, ?, ?)"
storage module immutable sqlSelectTodosByUser CNullTerminatedByteString "SELECT id, title, body, done, priority, created_at_ms, updated_at_ms, completed_at_ms FROM todos WHERE user_id = ? ORDER BY created_at_ms DESC LIMIT 100"
storage module immutable sqlSelectTodoByIdAndUser CNullTerminatedByteString "SELECT id, title, body, done, priority, created_at_ms, updated_at_ms, completed_at_ms FROM todos WHERE id = ? AND user_id = ? LIMIT 1"
storage module immutable sqlDeleteTodoByIdAndUser CNullTerminatedByteString "DELETE FROM todos WHERE id = ? AND user_id = ?"
storage module immutable sqlCompleteTodoByIdAndUser CNullTerminatedByteString "UPDATE todos SET done = 1, completed_at_ms = ?, updated_at_ms = ? WHERE id = ? AND user_id = ?"
# Inverse of sqlCompleteTodoByIdAndUser: marks a todo open again. We
# clear completed_at_ms so the audit trail reflects the un-complete; the
# bind order matches completeTodoHandler (?1 = updated_at_ms, ?2 = id,
# ?3 = user_id) so callers can reuse the bindIndex1/2/3 constants.
storage module immutable sqlUncompleteTodoByIdAndUser CNullTerminatedByteString "UPDATE todos SET done = 0, completed_at_ms = NULL, updated_at_ms = ? WHERE id = ? AND user_id = ?"

# Bind parameter indices.
storage module immutable bindIndex1 CSignedInt32 1
storage module immutable bindIndex2 CSignedInt32 2
storage module immutable bindIndex3 CSignedInt32 3
storage module immutable bindIndex4 CSignedInt32 4
storage module immutable bindIndex5 CSignedInt32 5

# Column indices.
storage module immutable columnIndex0 CSignedInt32 0
storage module immutable columnIndex1 CSignedInt32 1
storage module immutable columnIndex2 CSignedInt32 2
storage module immutable columnIndex3 CSignedInt32 3
storage module immutable columnIndex4 CSignedInt32 4
storage module immutable columnIndex5 CSignedInt32 5
storage module immutable columnIndex6 CSignedInt32 6
storage module immutable columnIndex7 CSignedInt32 7

# Default todo priority used when the request body omits it.
storage module immutable defaultPriority CSignedInt64 2

# ===== lifecycle =====

operation openOrReuseDatabase
output openOrReuseDatabase Result SqliteDatabase CSignedInt32
effect openOrReuseDatabase readWrite database
effect openOrReuseDatabase filesystem create
authority openOrReuseDatabase create filesystem
useCapability openOrReuseDatabase sqliteDatabaseReadWriter
useCapability openOrReuseDatabase filesystemCreateCapability
memory openOrReuseDatabase heap auto
async openOrReuseDatabase no
purpose openOrReuseDatabase "Return the shared SqliteDatabase handle, lazily opening + applying the schema on first call. Idempotent: subsequent calls return the cached handle."
invariant openOrReuseDatabase "sharedDatabaseReady=1 implies sharedDatabaseHandle is a valid open SqliteDatabase. The first caller wins the open; concurrent opens are impossible under the blocking HTTP/1.1 backend."

label startOpenOrReuseDatabase

call readinessCheckCall math.equalCSignedInt32
arg readinessCheckCall left sharedDatabaseReady
arg readinessCheckCall right jsonOk
run readinessCheckCall
bind sharedDatabaseNotReady Bool readinessCheckCall
branchIf sharedDatabaseNotReady performInitialOpen

returnOk sharedDatabaseHandle

label performInitialOpen

call ensureImagesDirCall http.ensureDirectory
arg ensureImagesDirCall directoryPath imagesDirectoryPath
run ensureImagesDirCall
ignoreOk ensureImagesDirCall CSignedInt32

# Bootstrap the structured-log file alongside the images dir. Both
# need to happen exactly once at server start; co-locating them in
# the lazy-init path means a refine that adds another startup-once
# step has a single obvious home.
call ensureLogsDirCall http.ensureDirectory
arg ensureLogsDirCall directoryPath logsDirectoryPath
run ensureLogsDirCall
ignoreOk ensureLogsDirCall CSignedInt32

call openLogFileCall openLogFile
arg openLogFileCall filePath logFilePath
run openLogFileCall
ignoreOk openLogFileCall CSignedInt32

call serverStartLogCall logInfo
arg serverStartLogCall messageText serverStartLogMessage
run serverStartLogCall
ignoreOk serverStartLogCall CSignedInt32

call openCall sqlite.openDatabase
arg openCall path databasePath
arg openCall mode readWriteCreateSqliteOpenMode
run openCall
bindOk freshDatabase SqliteDatabase openCall
bindError databaseOpenError SqliteDatabaseOpenFailure openCall
branchIfError openCall databaseOpenFailed

call applySchemaCall sqlite.exec
arg applySchemaCall database freshDatabase
arg applySchemaCall sql schemaSqlSource
run applySchemaCall
ignoreOk applySchemaCall Void
bindError schemaApplyError SqliteDatabaseExecFailure applySchemaCall
branchIfError applySchemaCall schemaApplyFailed

set module sharedDatabaseHandle freshDatabase
storage local immutable readyMarker CSignedInt32 1
set module sharedDatabaseReady readyMarker

returnOk freshDatabase

label databaseOpenFailed
returnError databaseOpenError

label schemaApplyFailed
returnError schemaApplyError

# ===== JSON response helpers =====

operation writeJsonOkResponse
input writeJsonOkResponse response HttpResponse
input writeJsonOkResponse status HttpStatusCode
input writeJsonOkResponse jsonBody HttpTextBody
output writeJsonOkResponse CSignedInt32
effect writeJsonOkResponse write http.response
useCapability writeJsonOkResponse httpResponseWriter
memory writeJsonOkResponse arena request
async writeJsonOkResponse no
purpose writeJsonOkResponse "Write a JSON body with the application/json content-type header."
invariant writeJsonOkResponse "Always passes jsonContentType to http.responseText. Body forwarded verbatim — caller responsible for JSON validity."
responseBodyForwarder writeJsonOkResponse jsonBody

label startWriteJsonOkResponse
call writeResponseCall http.responseText
arg writeResponseCall response response
arg writeResponseCall status status
arg writeResponseCall body jsonBody
arg writeResponseCall contentType jsonContentType
run writeResponseCall
bind writeResponseStatus CSignedInt32 writeResponseCall
returnValue writeResponseStatus

operation writeErrorJsonResponse
input writeErrorJsonResponse response HttpResponse
input writeErrorJsonResponse status HttpStatusCode
input writeErrorJsonResponse messageBody HttpTextBody
output writeErrorJsonResponse CSignedInt32
effect writeErrorJsonResponse write http.response
useCapability writeErrorJsonResponse httpResponseWriter
memory writeErrorJsonResponse arena request
async writeErrorJsonResponse no
purpose writeErrorJsonResponse "Write a pre-built JSON error body with the matching status code."
invariant writeErrorJsonResponse "Status caller-chosen; content-type forced to application/json."
responseBodyForwarder writeErrorJsonResponse messageBody

label startWriteErrorJsonResponse
call writeErrorCall http.responseText
arg writeErrorCall response response
arg writeErrorCall status status
arg writeErrorCall body messageBody
arg writeErrorCall contentType jsonContentType
run writeErrorCall
bind writeErrorStatus CSignedInt32 writeErrorCall
returnValue writeErrorStatus

# ===== session: read cookie -> SELECT -> user_id, or return -1 =====

operation requireSessionUserId
input requireSessionUserId request HttpRequest
output requireSessionUserId CSignedInt64
effect requireSessionUserId read http.request.header
effect requireSessionUserId read database
useCapability requireSessionUserId httpRequestReader
useCapability requireSessionUserId sqliteDatabaseReader
memory requireSessionUserId arena request
async requireSessionUserId no
purpose requireSessionUserId "Resolve the request's session cookie to its owning user id. Returns -1 when the cookie is missing OR the session row is absent OR the session has expired — callers treat any negative value as 'no auth' and respond 401."
invariant requireSessionUserId "Never throws; returns -1 on every failure path so callers do not need branch-on-error plumbing. Side-effects: reads cookie + does one SELECT against sessions."

label startRequireSessionUserId

storage local immutable noSessionUserId CSignedInt64 -1

call cookieReadCall http.requestCookie
arg cookieReadCall request request
arg cookieReadCall cookieName cookieNameSession
run cookieReadCall
bind sessionTokenFromCookie CNullTerminatedByteString cookieReadCall

call tokenNullCheckCall pointer.isNull
arg tokenNullCheckCall pointer sessionTokenFromCookie
run tokenNullCheckCall
bind sessionTokenMissing Bool tokenNullCheckCall
branchIf sessionTokenMissing requireSessionAttachedNoCookie

call openDatabaseForSessionCall openOrReuseDatabase
run openDatabaseForSessionCall
bindOk sessionDatabase SqliteDatabase openDatabaseForSessionCall
bindError sessionDatabaseOpenErr CSignedInt32 openDatabaseForSessionCall
branchIfError openDatabaseForSessionCall requireSessionDatabaseUnavailable

call prepareSessionLookupCall sqlite.prepareStatement
arg prepareSessionLookupCall database sessionDatabase
arg prepareSessionLookupCall sql sqlSelectSessionByToken
run prepareSessionLookupCall
bindOk sessionLookupStatement SqliteStatement prepareSessionLookupCall
bindError sessionLookupPrepareErr SqliteStatementPrepareFailure prepareSessionLookupCall
branchIfError prepareSessionLookupCall requireSessionPrepareFailed

defer finalizeSessionLookupDefer sqlite.finalizeStatement sessionLookupStatement

call bindSessionTokenCall sqlite.bindText
arg bindSessionTokenCall statement sessionLookupStatement
arg bindSessionTokenCall parameterIndex bindIndex1
arg bindSessionTokenCall value sessionTokenFromCookie
run bindSessionTokenCall
ignoreOk bindSessionTokenCall Void
bindError sessionTokenBindErr SqliteStatementBindFailure bindSessionTokenCall
branchIfError bindSessionTokenCall requireSessionBindFailed

call stepSessionLookupCall sqlite.stepStatement
arg stepSessionLookupCall statement sessionLookupStatement
run stepSessionLookupCall
bindOk sessionStepResult SqliteStepResult stepSessionLookupCall
bindError sessionStepErr SqliteStatementStepFailure stepSessionLookupCall
branchIfError stepSessionLookupCall requireSessionStepFailed

# stepStatement returns rowSqliteStepResult (100) for a hit, doneSqliteStepResult (101) for empty.
call sessionFoundCheckCall math.equalCSignedInt32
arg sessionFoundCheckCall left sessionStepResult
arg sessionFoundCheckCall right rowSqliteStepResult
run sessionFoundCheckCall
bind sessionFound Bool sessionFoundCheckCall
branchIf sessionFound sessionFoundLabel
returnValue noSessionUserId

label sessionFoundLabel

call readSessionUserIdCall sqlite.columnInt64
arg readSessionUserIdCall statement sessionLookupStatement
arg readSessionUserIdCall columnIndex columnIndex0
run readSessionUserIdCall
bind sessionUserId CSignedInt64 readSessionUserIdCall

call readSessionExpiresCall sqlite.columnInt64
arg readSessionExpiresCall statement sessionLookupStatement
arg readSessionExpiresCall columnIndex columnIndex1
run readSessionExpiresCall
bind sessionExpiresAtMs CSignedInt64 readSessionExpiresCall

call nowMsForExpiryCall http.nowMillis
run nowMsForExpiryCall
bind nowMillisForExpiry CSignedInt64 nowMsForExpiryCall

call sessionExpiredCheckCall math.lessThanOrEqualI64
arg sessionExpiredCheckCall left sessionExpiresAtMs
arg sessionExpiredCheckCall right nowMillisForExpiry
run sessionExpiredCheckCall
bind sessionExpired Bool sessionExpiredCheckCall
branchIf sessionExpired sessionExpiredLabel

returnValue sessionUserId

label sessionExpiredLabel
returnValue noSessionUserId

label requireSessionAttachedNoCookie
returnValue noSessionUserId

label requireSessionDatabaseUnavailable
returnValue noSessionUserId

label requireSessionPrepareFailed
returnValue noSessionUserId

label requireSessionBindFailed
returnValue noSessionUserId

label requireSessionStepFailed
returnValue noSessionUserId

# ===== handlers =====

operation healthHandler
input healthHandler request HttpRequest
input healthHandler response HttpResponse
output healthHandler CSignedInt32
effect healthHandler write http.response
useCapability healthHandler httpResponseWriter
memory healthHandler arena request
async healthHandler no
purpose healthHandler "Return a JSON liveness body. Does not touch the database — usable by external probes before the DB is ready."
invariant healthHandler "Always 200; body is a static module-scope constant."

label startHealthHandler
storage local immutable healthBodyJson HttpTextBody "{\"status\":\"ok\",\"app\":\"todo-web-pro\"}\n"
call writeHealthCall writeJsonOkResponse
arg writeHealthCall response response
arg writeHealthCall status httpStatusOk
arg writeHealthCall jsonBody healthBodyJson
run writeHealthCall
bind writeHealthStatus CSignedInt32 writeHealthCall
returnValue writeHealthStatus

operation versionHandler
input versionHandler request HttpRequest
input versionHandler response HttpResponse
output versionHandler CSignedInt32
effect versionHandler write http.response
useCapability versionHandler httpResponseWriter
memory versionHandler arena request
async versionHandler no
purpose versionHandler "Return the app version + bcrypt cost factor so deploys can be inspected without a DB query."
invariant versionHandler "Static; the bcryptCost value reported here MUST match bcryptRecommendedCost used by registerHandler."

label startVersionHandler
storage local immutable versionBodyJson HttpTextBody "{\"name\":\"todo-web-pro\",\"version\":\"1.0.0\",\"bcryptCost\":12}\n"
call writeVersionCall writeJsonOkResponse
arg writeVersionCall response response
arg writeVersionCall status httpStatusOk
arg writeVersionCall jsonBody versionBodyJson
run writeVersionCall
bind writeVersionStatus CSignedInt32 writeVersionCall
returnValue writeVersionStatus

# ----- registerHandler -----

operation registerHandler
input registerHandler request HttpRequest
input registerHandler response HttpResponse
output registerHandler CSignedInt32
effect registerHandler read http.request.body
effect registerHandler write http.response
effect registerHandler readWrite database
effect registerHandler compute bcryptHash
effect registerHandler compute bcryptRandom
effect registerHandler allocate heap
effect registerHandler free heap
useCapability registerHandler httpRequestReader
useCapability registerHandler httpResponseWriter
useCapability registerHandler sqliteDatabaseReadWriter
useCapability registerHandler bcryptHashCompute
useCapability registerHandler bcryptRandomCompute
useCapability registerHandler heapAllocCapability
useCapability registerHandler heapFreeCapability
memory registerHandler heap auto
async registerHandler no
purpose registerHandler "POST /api/auth/register — create a user with bcrypt-cost-12 password, mint an initial session, set the session cookie, return 201 with the user record."
invariant registerHandler "On success, exactly one new row in users + one new row in sessions, and the Set-Cookie header carries the new session token. On any DB or hashing failure, no user row is committed (transaction failure is the natural rollback because we INSERT users and then sessions in two statements; the user row may persist if session insert fails — acceptable for v1)."
warning registerHandler "v1 does not enforce password strength rules other than non-empty; phase-7 will add a minimum length CHECK constraint AT the SQL layer."

label startRegisterHandler

call openDbForRegisterCall openOrReuseDatabase
run openDbForRegisterCall
bindOk registerDatabase SqliteDatabase openDbForRegisterCall
bindError registerDbErr CSignedInt32 openDbForRegisterCall
branchIfError openDbForRegisterCall registerDatabaseUnavailable

# Read the request body.
call readRegisterBodyCall http.requestBodyText
arg readRegisterBodyCall request request
run readRegisterBodyCall
bind registerBodyText CNullTerminatedByteString readRegisterBodyCall

call registerBodyNullCheckCall pointer.isNull
arg registerBodyNullCheckCall pointer registerBodyText
run registerBodyNullCheckCall
bind registerBodyMissing Bool registerBodyNullCheckCall
branchIf registerBodyMissing registerBadRequestBodyMissing

# Allocate scratch buffers for username + password + displayName.
call allocateUsernameScratchCall c.malloc
arg allocateUsernameScratchCall size usernameScratchCapacity
run allocateUsernameScratchCall
bind usernameScratch COpaqueMemoryAddress allocateUsernameScratchCall
defer releaseUsernameScratchDefer c.free usernameScratch

call allocatePasswordScratchCall c.malloc
arg allocatePasswordScratchCall size passwordScratchCapacity
run allocatePasswordScratchCall
bind passwordScratch COpaqueMemoryAddress allocatePasswordScratchCall
defer releasePasswordScratchDefer c.free passwordScratch

call allocateDisplayNameScratchCall c.malloc
arg allocateDisplayNameScratchCall size displayNameScratchCapacity
run allocateDisplayNameScratchCall
bind displayNameScratch COpaqueMemoryAddress allocateDisplayNameScratchCall
defer releaseDisplayNameScratchDefer c.free displayNameScratch

# json.findString — strict capacity arg passed as CSignedInt32, casted up to CSignedInt64 by the binding.
storage local immutable usernameScratchCapacityArg CSignedInt32 64
storage local immutable passwordScratchCapacityArg CSignedInt32 256
storage local immutable displayNameScratchCapacityArg CSignedInt32 128

call findUsernameCall json.findString
arg findUsernameCall jsonText registerBodyText
arg findUsernameCall fieldName fieldUsername
arg findUsernameCall scratch usernameScratch
