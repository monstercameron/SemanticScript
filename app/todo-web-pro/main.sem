returnValue writeUncompleteDbUnavailableStatus

label uncompleteFailed
storage local immutable uncompleteFailedBody CNullTerminatedByteString "{\"error\":{\"code\":\"uncompleteFailed\",\"message\":\"could not mark todo open\"}}\n"
