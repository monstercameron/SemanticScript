# We need a "field-array-open" — but the builder only has object_open/array_open
# at the top level. Workaround: emit field by writing a placeholder, then
# delete it... too complex. Just use snprintf for the response.

call allocateListResponseBufferCall c.malloc
arg allocateListResponseBufferCall size todosListBufferCapacity
run allocateListResponseBufferCall
bind listResponseBuffer COpaqueMemoryAddress allocateListResponseBufferCall
defer releaseListResponseBufferDefer c.free listResponseBuffer

# Per-row scratch — every iteration snprintfs one row's JSON object here,
# then c.strcat appends it to the accumulator buffer above.
call allocateRowScratchCall c.malloc
arg allocateRowScratchCall size todoRowScratchCapacity
run allocateRowScratchCall
bind listRowScratch COpaqueMemoryAddress allocateRowScratchCall
defer releaseRowScratchDefer c.free listRowScratch

# Open the accumulator with the array prefix. Subsequent rows append via
# strcat; the suffix `],"count":N}` is appended after the loop.
storage local immutable listResponsePrefix CNullTerminatedByteString "{\"todos\":["
call c_strcpy_listResponseCall c.snprintf
arg c_strcpy_listResponseCall buffer listResponseBuffer
arg c_strcpy_listResponseCall size todosListBufferCapacity
arg c_strcpy_listResponseCall format listResponsePrefix
run c_strcpy_listResponseCall
ignoreOk c_strcpy_listResponseCall CSignedInt32

# Streaming row serializer — step the statement once per loop, format one
# row's JSON object into the per-row scratch via snprintf, then c.strcat
# the scratch onto the accumulator. Comma separators are emitted BEFORE
# every row after the first (tracked by `listFirstRow`) so we never end
# with a trailing comma to strip. Note: integer arithmetic primitives
# only lower as i64 (math.addI64 / math.equalI64) — using i32 silently
# resolved math.addCSignedInt32 to a no-op that stored 0, so the loop
# "ran" but the count never advanced. Stay on i64 here.
storage local mutable listRowsEmitted CSignedInt64 0
storage local mutable listFirstRow CSignedInt32 1
storage local immutable listIncrementOne CSignedInt64 1
storage local immutable listFirstRowFalse CSignedInt32 0

# Inter-row separator and row template — title is %s (no JSON escaping in
# v1; the schema CHECK on length keeps it bounded, but a refine should
# escape `"` and `\\` before this can accept untrusted input).
storage local immutable listCommaSeparator CNullTerminatedByteString ","
storage local immutable listRowFormat CNullTerminatedByteString "{\"id\":%lld,\"title\":\"%s\",\"done\":%lld,\"priority\":%lld}"

label listIterationLoop
call stepListCall sqlite.stepStatement
arg stepListCall statement listStatement
run stepListCall
bindOk listStepResult SqliteStepResult stepListCall
bindError listStepErr SqliteStatementStepFailure stepListCall
branchIfError stepListCall listSelectFailed

call listRowAvailableCheckCall math.equalCSignedInt32
arg listRowAvailableCheckCall left listStepResult
arg listRowAvailableCheckCall right rowSqliteStepResult
run listRowAvailableCheckCall
bind listRowAvailable Bool listRowAvailableCheckCall
branchIf listRowAvailable listAppendRow
branch listLoopDone

label listAppendRow

call readListIdCall sqlite.columnInt64
arg readListIdCall statement listStatement
arg readListIdCall columnIndex columnIndex0
run readListIdCall
bind listRowId CSignedInt64 readListIdCall

call readListTitleCall sqlite.columnText
arg readListTitleCall statement listStatement
arg readListTitleCall columnIndex columnIndex1
run readListTitleCall
bind listRowTitle CNullTerminatedByteString readListTitleCall

call readListDoneCall sqlite.columnInt64
arg readListDoneCall statement listStatement
arg readListDoneCall columnIndex columnIndex3
run readListDoneCall
bind listRowDone CSignedInt64 readListDoneCall

call readListPriorityCall sqlite.columnInt64
arg readListPriorityCall statement listStatement
arg readListPriorityCall columnIndex columnIndex4
run readListPriorityCall
bind listRowPriority CSignedInt64 readListPriorityCall

# Comma BEFORE this row when it isn't the first emitted row.
call listFirstRowCheckCall math.equalCSignedInt32
arg listFirstRowCheckCall left listFirstRow
arg listFirstRowCheckCall right trueBit
run listFirstRowCheckCall
bind listIsFirstRow Bool listFirstRowCheckCall
branchIf listIsFirstRow listAfterCommaAppend

call appendCommaCall c.strcat
arg appendCommaCall destination listResponseBuffer
arg appendCommaCall source listCommaSeparator
run appendCommaCall
ignoreOk appendCommaCall CNullTerminatedByteString

label listAfterCommaAppend

# Build this row's JSON object in the scratch buffer.
call formatRowCall c.snprintf
arg formatRowCall buffer listRowScratch
arg formatRowCall size todoRowScratchCapacity
arg formatRowCall format listRowFormat
arg formatRowCall first listRowId
arg formatRowCall second listRowTitle
arg formatRowCall third listRowDone
arg formatRowCall fourth listRowPriority
run formatRowCall
ignoreOk formatRowCall CSignedInt32

# Append the scratch onto the accumulator.
call appendRowJsonCall c.strcat
arg appendRowJsonCall destination listResponseBuffer
arg appendRowJsonCall source listRowScratch
run appendRowJsonCall
ignoreOk appendRowJsonCall CNullTerminatedByteString

set local listFirstRow listFirstRowFalse

call listIncrementCall math.addI64
arg listIncrementCall left listRowsEmitted
arg listIncrementCall right listIncrementOne
run listIncrementCall
bind listIncrementResult CSignedInt64 listIncrementCall
set local listRowsEmitted listIncrementResult
branch listIterationLoop

label listLoopDone

# Suffix: close the array and emit the row count. snprintf into scratch,
# then strcat onto the accumulator so the final body reads
# `{"todos":[…rows…],"count":N}\n`.
storage local immutable listResponseSuffixFormat CNullTerminatedByteString "],\"count\":%lld}\n"
call formatSuffixCall c.snprintf
arg formatSuffixCall buffer listRowScratch
arg formatSuffixCall size todoRowScratchCapacity
arg formatSuffixCall format listResponseSuffixFormat
arg formatSuffixCall first listRowsEmitted
run formatSuffixCall
ignoreOk formatSuffixCall CSignedInt32

call appendSuffixCall c.strcat
arg appendSuffixCall destination listResponseBuffer
arg appendSuffixCall source listRowScratch
run appendSuffixCall
ignoreOk appendSuffixCall CNullTerminatedByteString

bind listResponseBodyText CNullTerminatedByteString allocateListResponseBufferCall

call writeListResponseCall writeJsonOkResponse
arg writeListResponseCall response response
arg writeListResponseCall status httpStatusOk
arg writeListResponseCall jsonBody listResponseBodyText
run writeListResponseCall
bind writeListStatus CSignedInt32 writeListResponseCall
returnValue writeListStatus

label listUnauthorizedHandler
storage local immutable listUnauthBody CNullTerminatedByteString "{\"error\":{\"code\":\"unauthorized\",\"message\":\"authentication required\"}}\n"
call writeListUnauthCall writeErrorJsonResponse
arg writeListUnauthCall response response
arg writeListUnauthCall status httpStatusUnauthorized
arg writeListUnauthCall messageBody listUnauthBody
run writeListUnauthCall
bind writeListUnauthStatus CSignedInt32 writeListUnauthCall
returnValue writeListUnauthStatus

label listDbUnavailable
storage local immutable listDbUnavailableBody CNullTerminatedByteString "{\"error\":{\"code\":\"databaseUnavailable\",\"message\":\"database not available\"}}\n"
call writeListDbUnavailableCall writeErrorJsonResponse
arg writeListDbUnavailableCall response response
arg writeListDbUnavailableCall status httpStatusInternalServerError
arg writeListDbUnavailableCall messageBody listDbUnavailableBody
run writeListDbUnavailableCall
bind writeListDbUnavailableStatus CSignedInt32 writeListDbUnavailableCall
returnValue writeListDbUnavailableStatus

label listSelectFailed
storage local immutable listSelectFailedBody CNullTerminatedByteString "{\"error\":{\"code\":\"selectFailed\",\"message\":\"failed to list todos\"}}\n"
call writeListSelectFailedCall writeErrorJsonResponse
arg writeListSelectFailedCall response response
arg writeListSelectFailedCall status httpStatusInternalServerError
arg writeListSelectFailedCall messageBody listSelectFailedBody
run writeListSelectFailedCall
bind writeListSelectFailedStatus CSignedInt32 writeListSelectFailedCall
returnValue writeListSelectFailedStatus

