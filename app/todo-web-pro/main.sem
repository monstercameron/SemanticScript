# ----- staticAssetHandler -----
#
# Serves files from the assets/ directory beside the exe. Wired to
# `GET /assets/:filename` in the route table at the top of this file.
# Uses http.responseFile which:
#   - sniffs the content-type from the extension (.js -> text/javascript,
#     .css -> text/css, .png -> image/png, etc.)
#   - refuses any path that contains `..` or starts with `/` / `\`
#   - refuses files larger than 16 MiB
#   - returns SS_HTTP_ERR_CONFIG / SS_HTTP_ERR_ENGINE on failure,
#     which the dispatcher 500s — we map to a 404 by branching on
#     the failure path.
#
# The runtime's :filename matcher is what gives us the value via
# http.requestPathParam; pointer.isNull guards against the (unreachable
# with our route shape) "param not present" path so SS3603 stays happy.

operation staticAssetHandler
input operation staticAssetHandler request HttpRequest
input operation staticAssetHandler response HttpResponse
output operation staticAssetHandler CSignedInt32
effect staticAssetHandler read http.request.header
effect staticAssetHandler read filesystem
effect staticAssetHandler write http.response
useCapability staticAssetHandler httpRequestReader
useCapability staticAssetHandler httpResponseWriter
useCapability staticAssetHandler filesystemReadCapability
memory staticAssetHandler arena request
async staticAssetHandler no
purpose operation staticAssetHandler "GET /assets/:filename — serve a single file from the assets/ directory beside the exe, with content-type sniffed by extension. Refuses path traversal at the runtime layer."
invariant operation staticAssetHandler "The runtime's path-traversal refusal + content-type sniffing are the load-bearing security checks. The :filename capture is a single segment (cannot contain `/`), so multi-component asset paths are not addressable — that's intentional v1 scope; nested asset dirs are a v1.1 follow-up."

label startStaticAssetHandler

storage local immutable staticAssetMissingBody HttpTextBody "{\"error\":{\"code\":\"assetNotFound\",\"message\":\"asset not found\"}}\n"

call readAssetFilenameCall http.requestPathParam
argument readAssetFilenameCall request HttpRequest request
argument readAssetFilenameCall name CNullTerminatedByteString assetFilenameParam
run readAssetFilenameCall
bind value assetFilename CNullTerminatedByteString readAssetFilenameCall

call assetFilenameNullCheckCall pointer.isNull
argument assetFilenameNullCheckCall pointer COpaqueMemoryAddress assetFilename
run assetFilenameNullCheckCall
bind value assetFilenameMissing Bool assetFilenameNullCheckCall
branch if condition assetFilenameMissing target staticAssetMissingHandler

call writeAssetFileCall http.responseFile
argument writeAssetFileCall response HttpResponse response
argument writeAssetFileCall status CSignedInt32 httpStatusOk
argument writeAssetFileCall rootDirectory CNullTerminatedByteString assetsDirectoryPath
argument writeAssetFileCall requestedPath CNullTerminatedByteString assetFilename
run writeAssetFileCall
bind value writeAssetFileStatus CSignedInt32 writeAssetFileCall

# http.responseFile returns SS_HTTP_OK (0) on success, non-zero on
# refusal / file-not-found / oversize. Treat anything non-zero as 404
# rather than the dispatcher's default 500 — a missing asset is a
# routine condition, not an application crash.
storage local immutable assetWriteOkSentinel CSignedInt32 0
call assetWriteOkCheckCall math.equalCSignedInt32
argument assetWriteOkCheckCall left CSignedInt32 writeAssetFileStatus
argument assetWriteOkCheckCall right CSignedInt32 assetWriteOkSentinel
run assetWriteOkCheckCall
bind value assetWriteOk Bool assetWriteOkCheckCall
branch if condition assetWriteOk target staticAssetServed
branch else target staticAssetMissingHandler

label staticAssetServed
return value writeAssetFileStatus

label staticAssetMissingHandler
call writeAssetMissingCall writeErrorJsonResponse
argument writeAssetMissingCall response HttpResponse response
argument writeAssetMissingCall status HttpStatusCode httpStatusNotFound
argument writeAssetMissingCall messageBody HttpTextBody staticAssetMissingBody
run writeAssetMissingCall
bind value writeAssetMissingStatus CSignedInt32 writeAssetMissingCall
return value writeAssetMissingStatus

# Pull in the pages module last — after every local operation closes
# — so the imported html template + handler don't leave dangling
# current_op state for any subsequent parent-file row. The route
# `GET / homePageHandler` and `GET /dashboard dashboardPageHandler`
# (see the route table near the top of this file) forward-reference
# handlers defined in the pages module.
import pages app.todo_web_pro.pages
