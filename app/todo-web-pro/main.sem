bind writeUncompleteUnauthStatus CSignedInt32 writeUncompleteUnauthCall
returnValue writeUncompleteUnauthStatus

label uncompleteBadRequestIdMissing
storage local immutable uncompleteIdMissingBody CNullTerminatedByteString "{\"error\":{\"code\":\"idMissing\",\"message\":\"id path parameter required and must be a positive integer\"}}\n"
call writeUncompleteIdMissingCall writeErrorJsonResponse
arg writeUncompleteIdMissingCall response response
arg writeUncompleteIdMissingCall status httpStatusBadRequest
arg writeUncompleteIdMissingCall messageBody uncompleteIdMissingBody
run writeUncompleteIdMissingCall
bind writeUncompleteIdMissingStatus CSignedInt32 writeUncompleteIdMissingCall
returnValue writeUncompleteIdMissingStatus

label uncompleteDbUnavailable
storage local immutable uncompleteDbUnavailableBody CNullTerminatedByteString "{\"error\":{\"code\":\"databaseUnavailable\",\"message\":\"database not available\"}}\n"
