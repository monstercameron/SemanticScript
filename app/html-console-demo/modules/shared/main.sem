module app.html_console_demo.shared
purpose module app.html_console_demo.shared "Shared presentation constants for the HTML console demo."
moduleOwns app.html_console_demo.shared "Static presentation copy and class names consumed by page and domain modules."
moduleDoesNotOwn app.html_console_demo.shared "Todo item data ownership or page/component rendering operations."
invariant module app.html_console_demo.shared "Every exported value is immutable module storage so downstream modules read stable demo copy."

exportConstant app.html_console_demo.shared todoDashboardPageTitleText
exportConstant app.html_console_demo.shared todoDashboardIntroText
exportConstant app.html_console_demo.shared shellClassName
exportConstant app.html_console_demo.shared panelClassName
exportConstant app.html_console_demo.shared openTodoClassName
exportConstant app.html_console_demo.shared doneTodoClassName

storage module immutable todoDashboardPageTitleText String "Todo TUI HTML Console Demo"
storage module immutable todoDashboardIntroText String "Server-rendered HTML generated from first-class SemanticScript templates."
storage module immutable shellClassName String "todo-shell"
storage module immutable panelClassName String "todo-panel"
storage module immutable openTodoClassName String "todo-row todo-row-open"
storage module immutable doneTodoClassName String "todo-row todo-row-done"
