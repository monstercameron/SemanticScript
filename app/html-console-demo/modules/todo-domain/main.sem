module app.html_console_demo.todo_domain
modulePurpose app.html_console_demo.todo_domain "Demo todo domain copy shaped after app.todo's active todo concepts."
moduleOwns app.html_console_demo.todo_domain "Static todo titles, status labels, and row classes used by page assembly as component inputs."
moduleDoesNotOwn app.html_console_demo.todo_domain "HTML tag structure, page layout, console output, or persistence."
moduleInvariant app.html_console_demo.todo_domain "Todo rows preserve the app.todo idea of title plus done/open state, but stay immutable for deterministic demo output."

importModule app.html_console_demo.shared

exportConstant app.html_console_demo.todo_domain firstTodoTitleText
exportConstant app.html_console_demo.todo_domain firstTodoStatusText
exportConstant app.html_console_demo.todo_domain firstTodoClassName
exportConstant app.html_console_demo.todo_domain secondTodoTitleText
exportConstant app.html_console_demo.todo_domain secondTodoStatusText
exportConstant app.html_console_demo.todo_domain secondTodoClassName
exportConstant app.html_console_demo.todo_domain thirdTodoTitleText
exportConstant app.html_console_demo.todo_domain thirdTodoStatusText
exportConstant app.html_console_demo.todo_domain thirdTodoClassName

storage module immutable firstTodoTitleText HtmlText "Wire native webserver"
storage module immutable firstTodoStatusText HtmlText "done"
storage module immutable firstTodoClassName HtmlClass doneTodoClassName

storage module immutable secondTodoTitleText HtmlText "Split HTML rendering into modules"
storage module immutable secondTodoStatusText HtmlText "open"
storage module immutable secondTodoClassName HtmlClass openTodoClassName

storage module immutable thirdTodoTitleText HtmlText "Keep template inputs explicit"
storage module immutable thirdTodoStatusText HtmlText "open"
storage module immutable thirdTodoClassName HtmlClass openTodoClassName
