module app.html_console_demo
purpose module app.html_console_demo "Console entrypoint for the first-class HTML/SSX demo."
moduleOwns app.html_console_demo "Executable orchestration: render the dashboard page and print the hydrated HTML to stdout."
moduleDoesNotOwn app.html_console_demo "Shared display constants, todo domain copy, reusable HTML components, or page template assembly."
invariant module app.html_console_demo "The entry operation attempts exactly one console.writeLine of one fully hydrated HtmlDocument; console.writeLine appends the trailing newline."

import todoPages app.html_console_demo.todo_pages

exportOperation app.html_console_demo main

storage module immutable successCode ExitCode 0
storage module immutable failureCode ExitCode 1

operation main
output operation main ExitCode
effect main write console.stdout
authority main write console.stdout
memory main heap no
async main no
purpose operation main "Render the enterprise-style todo dashboard HTML and print it to the console."
invariant operation main "The rendered HtmlDocument is bound through the C string ABI before console.writeLine, and write failure returns a non-zero exit code."

label startMain

call renderDashboardPageCall todoPages.renderTodoDashboardPage
run renderDashboardPageCall
bind value dashboardHtml CNullTerminatedByteString renderDashboardPageCall

call writeDashboardHtmlCall console.writeLine
argument writeDashboardHtmlCall text CNullTerminatedByteString dashboardHtml
run writeDashboardHtmlCall
ignore ok source writeDashboardHtmlCall type CSignedInt32
bind error writeDashboardHtmlError CSignedInt32 writeDashboardHtmlCall
branch error source writeDashboardHtmlCall target writeDashboardHtmlFailed

return value successCode

label writeDashboardHtmlFailed
storage local immutable writeDashboardExpectedFailure CSignedInt32 0
call observeWriteDashboardHtmlErrorCall math.equalCSignedInt32
argument observeWriteDashboardHtmlErrorCall left CSignedInt32 writeDashboardHtmlError
argument observeWriteDashboardHtmlErrorCall right CSignedInt32 writeDashboardExpectedFailure
run observeWriteDashboardHtmlErrorCall
ignore value source observeWriteDashboardHtmlErrorCall type Bool
return value failureCode
