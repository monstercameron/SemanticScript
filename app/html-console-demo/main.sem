module app.html_console_demo
modulePurpose app.html_console_demo "Console entrypoint for the first-class HTML/SSX demo."
moduleOwns app.html_console_demo "Executable orchestration: render the dashboard page and print the hydrated HTML to stdout."
moduleDoesNotOwn app.html_console_demo "Shared display constants, todo domain copy, reusable HTML components, or page template assembly."
moduleInvariant app.html_console_demo "The entry operation attempts exactly one console.writeLine of one fully hydrated HtmlDocument; console.writeLine appends the trailing newline."

importModule app.html_console_demo.todo_pages as todoPages

exportOperation app.html_console_demo main

storage module immutable successCode ExitCode 0

operation main
output main ExitCode
effect main write console.stdout
authority main console.stdout write
memoryHeap main no
async main no
purpose main "Render the enterprise-style todo dashboard HTML and print it to the console."

label startMain

call renderDashboardPageCall todoPages.renderTodoDashboardPage
run renderDashboardPageCall
bind dashboardHtml HtmlDocument renderDashboardPageCall

call writeDashboardHtmlCall console.writeLine
arg writeDashboardHtmlCall text dashboardHtml
run writeDashboardHtmlCall
ignoreValue writeDashboardHtmlCall CSignedInt32

returnValue successCode
