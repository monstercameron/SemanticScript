# HTML console demo project build tape.
# This mirrors the todo app's build.sem shape but splits the source into
# registered modules so importModule exercises an enterprise-style layout.

buildProject htmlConsoleDemo
project HtmlConsoleDemo
modulePath htmlConsoleDemo github.com/monstercameron/SemanticScript/app/html-console-demo
languageVersion htmlConsoleDemo "1.0"
projectVersion htmlConsoleDemo "0.1.0"
projectLicense htmlConsoleDemo MIT

sourceRoot htmlConsoleDemo "."
registerModule htmlConsoleDemo app.html_console_demo "."
registerModule htmlConsoleDemo app.html_console_demo.shared "modules/shared"
registerModule htmlConsoleDemo app.html_console_demo.todo_domain "modules/todo-domain"
registerModule htmlConsoleDemo app.html_console_demo.todo_components "modules/todo-components"
registerModule htmlConsoleDemo app.html_console_demo.todo_pages "modules/todo-pages"
mainFile htmlConsoleDemo "main.sem"
mainOperation htmlConsoleDemo main
testPattern htmlConsoleDemo "*.test.sem"
testRoot htmlConsoleDemo "."

target console
runtime native 1
entry console main

version "0.1.0.0"
publisher "Earl Cameron"
description "SemanticScript first-class HTML/SSX console demo."
productName "HTML Console Demo"
internalName "html-console-demo"
originalFilename "html-console-demo.exe"
comments "Built from app/html-console-demo using first-class htmlTemplate/htmlArg/htmlBody syntax."
metadata "BuildSource" "app/html-console-demo/build.sem"
metadata "RuntimeContract" "native 1"

targetRuntime htmlConsoleDemo nativeExe
buildProfile htmlConsoleDemo dev
optLevel htmlConsoleDemo 2
runtimeChecks htmlConsoleDemo panic
persistLlvmIr htmlConsoleDemo yes
emitLlvmIr htmlConsoleDemo auto
emitOptimizedLlvmIr htmlConsoleDemo no
buildFolderName htmlConsoleDemo build
cpuBaseline htmlConsoleDemo generic
cpuTune htmlConsoleDemo generic
cpuFeatureCheck htmlConsoleDemo auto
formatterSetting htmlConsoleDemo lineWidth 100
linterSetting htmlConsoleDemo maxTier T4
docsOutput htmlConsoleDemo "docs"
nativeOutput htmlConsoleDemo "html-console-demo.exe"

importModule app.html_console_demo
