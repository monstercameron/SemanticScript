module app.hello_gui
purpose module app.hello_gui "Minimal Windows GUI app built with standard SemanticScript function calls."
moduleOwns app.hello_gui "The app-level constants and main operation that compose one GUI window through standard.gui functions."
moduleDoesNotOwn app.hello_gui "The native Win32 message loop, handle lifetime, layout engine, or standard.gui runtime implementation."
invariant module app.hello_gui "GUI construction uses operation/call/arg/run syntax; app code does not declare GUI-specific top-level keywords."

import gui standard.gui

exportOperation app.hello_gui main

storage module immutable helloGuiTitle GuiText "Hello GUI"
storage module immutable titleText GuiText "SemanticScript native controls"
storage module immutable newTaskPlaceholder GuiText "New task"
storage module immutable addTaskText GuiText "Add task"
storage module immutable completeSelectedText GuiText "Complete selected"
storage module immutable clearCompletedText GuiText "Clear completed"
storage module immutable statusReadyText GuiText "Ready"
storage module immutable emptyGuiText GuiText ""
storage module immutable addedStatusText GuiText "Added task"
storage module immutable completedStatusText GuiText "Marked selected task"
storage module immutable clearedStatusText GuiText "Cleared tasks"
storage module immutable windowWidth GuiPixels 640
storage module immutable windowHeight GuiPixels 440
storage module immutable maxTaskTitleLength CSignedInt32 200
storage module immutable yesGuiFlag CSignedInt32 1
storage module immutable noGuiFlag CSignedInt32 0
storage module mutable taskInputHandle GuiTextBox 0
storage module mutable taskListHandle GuiListBox 0
storage module mutable statusLabelHandle GuiTextLabel 0

operation main
output operation main ExitCode
effect main allocate gui.application
effect main allocate gui.window
effect main allocate gui.control
effect main write gui.window
effect main write gui.control.event
authority main allocate gui.application
authority main allocate gui.window
authority main allocate gui.control
authority main write gui.window
authority main write gui.control.event
memory main heap yes
memoryAllocationSource main createApplicationCall
async main no
purpose operation main "Compose one native GUI window using standard.gui functions and return the GUI runtime exit status."
invariant operation main "GUI handles are created through standard.gui calls, attached to one main window, and event handlers are registered before applicationRun."

call createApplicationCall gui.applicationCreate
argument createApplicationCall title GuiText helloGuiTitle
run createApplicationCall
bind value application GuiApplication createApplicationCall

call createWindowCall gui.windowCreate
argument createWindowCall title GuiText helloGuiTitle
argument createWindowCall width GuiPixels windowWidth
argument createWindowCall height GuiPixels windowHeight
argument createWindowCall layout GuiWindowLayout verticalStackGuiWindowLayout
argument createWindowCall resizable CSignedInt32 yesGuiFlag
run createWindowCall
bind value mainWindow GuiWindow createWindowCall

call createTitleLabelCall gui.textLabelCreate
argument createTitleLabelCall text GuiText titleText
run createTitleLabelCall
bind value titleLabel GuiTextLabel createTitleLabelCall

call addTitleLabelCall gui.windowAddControl
argument addTitleLabelCall window GuiWindow mainWindow
argument addTitleLabelCall control GuiControl titleLabel
run addTitleLabelCall
ignore value source addTitleLabelCall type CSignedInt32

call createTaskInputCall gui.textBoxCreate
argument createTaskInputCall placeholder GuiText newTaskPlaceholder
argument createTaskInputCall maxLength CSignedInt32 maxTaskTitleLength
run createTaskInputCall
bind value taskInput GuiTextBox createTaskInputCall

call addTaskInputCall gui.windowAddControl
argument addTaskInputCall window GuiWindow mainWindow
argument addTaskInputCall control GuiControl taskInput
run addTaskInputCall
ignore value source addTaskInputCall type CSignedInt32
set storage taskInputHandle taskInput

call createAddButtonCall gui.buttonCreate
argument createAddButtonCall text GuiText addTaskText
argument createAddButtonCall isDefault CSignedInt32 yesGuiFlag
run createAddButtonCall
bind value addButton GuiButton createAddButtonCall

call addAddButtonCall gui.windowAddControl
argument addAddButtonCall window GuiWindow mainWindow
argument addAddButtonCall control GuiControl addButton
run addAddButtonCall
ignore value source addAddButtonCall type CSignedInt32

call createTaskListCall gui.listBoxCreate
argument createTaskListCall selectionMode GuiListBoxSelectionMode singleGuiListBoxSelectionMode
run createTaskListCall
bind value taskList GuiListBox createTaskListCall

call addTaskListCall gui.windowAddControl
argument addTaskListCall window GuiWindow mainWindow
argument addTaskListCall control GuiControl taskList
run addTaskListCall
ignore value source addTaskListCall type CSignedInt32
set storage taskListHandle taskList

call createCompleteButtonCall gui.buttonCreate
argument createCompleteButtonCall text GuiText completeSelectedText
argument createCompleteButtonCall isDefault CSignedInt32 noGuiFlag
run createCompleteButtonCall
bind value completeButton GuiButton createCompleteButtonCall

call addCompleteButtonCall gui.windowAddControl
argument addCompleteButtonCall window GuiWindow mainWindow
argument addCompleteButtonCall control GuiControl completeButton
run addCompleteButtonCall
ignore value source addCompleteButtonCall type CSignedInt32

call createClearButtonCall gui.buttonCreate
argument createClearButtonCall text GuiText clearCompletedText
argument createClearButtonCall isDefault CSignedInt32 noGuiFlag
run createClearButtonCall
bind value clearButton GuiButton createClearButtonCall

call addClearButtonCall gui.windowAddControl
argument addClearButtonCall window GuiWindow mainWindow
argument addClearButtonCall control GuiControl clearButton
run addClearButtonCall
ignore value source addClearButtonCall type CSignedInt32

call createStatusLabelCall gui.textLabelCreate
argument createStatusLabelCall text GuiText statusReadyText
run createStatusLabelCall
bind value statusLabel GuiTextLabel createStatusLabelCall

call addStatusLabelCall gui.windowAddControl
argument addStatusLabelCall window GuiWindow mainWindow
argument addStatusLabelCall control GuiControl statusLabel
run addStatusLabelCall
ignore value source addStatusLabelCall type CSignedInt32
set storage statusLabelHandle statusLabel

call registerAddButtonClickCall gui.controlOnEvent
argument registerAddButtonClickCall control GuiControl addButton
argument registerAddButtonClickCall eventKind GuiEventKind clickGuiEventKind
argument registerAddButtonClickCall handler GuiEventHandler addTaskFromInput
run registerAddButtonClickCall
ignore value source registerAddButtonClickCall type CSignedInt32

call registerTaskInputEnterCall gui.controlOnEvent
argument registerTaskInputEnterCall control GuiControl taskInput
argument registerTaskInputEnterCall eventKind GuiEventKind enterPressedGuiEventKind
argument registerTaskInputEnterCall handler GuiEventHandler addTaskFromInput
run registerTaskInputEnterCall
ignore value source registerTaskInputEnterCall type CSignedInt32

call registerCompleteButtonClickCall gui.controlOnEvent
argument registerCompleteButtonClickCall control GuiControl completeButton
argument registerCompleteButtonClickCall eventKind GuiEventKind clickGuiEventKind
argument registerCompleteButtonClickCall handler GuiEventHandler markSelectedTask
run registerCompleteButtonClickCall
ignore value source registerCompleteButtonClickCall type CSignedInt32

call registerClearButtonClickCall gui.controlOnEvent
argument registerClearButtonClickCall control GuiControl clearButton
argument registerClearButtonClickCall eventKind GuiEventKind clickGuiEventKind
argument registerClearButtonClickCall handler GuiEventHandler clearTasks
run registerClearButtonClickCall
ignore value source registerClearButtonClickCall type CSignedInt32

call setMainWindowCall gui.applicationSetMainWindow
argument setMainWindowCall application GuiApplication application
argument setMainWindowCall window GuiWindow mainWindow
run setMainWindowCall
ignore value source setMainWindowCall type CSignedInt32

call runApplicationCall gui.applicationRun
argument runApplicationCall application GuiApplication application
run runApplicationCall
bind value guiExitCode ExitCode runApplicationCall
return value guiExitCode

operation addTaskFromInput
input operation addTaskFromInput session GuiSession
input operation addTaskFromInput event GuiEvent
output operation addTaskFromInput CSignedInt32
effect addTaskFromInput read gui.control.textBox.text
effect addTaskFromInput write gui.control.textBox.text
effect addTaskFromInput write gui.control.listBox.items
effect addTaskFromInput write gui.control.textLabel.text
authority addTaskFromInput read gui.control.textBox.text
authority addTaskFromInput write gui.control.textBox.text
authority addTaskFromInput write gui.control.listBox.items
authority addTaskFromInput write gui.control.textLabel.text
memory addTaskFromInput heap no
async addTaskFromInput no
purpose operation addTaskFromInput "Append the current text box value to the visible task list and clear the input."
invariant operation addTaskFromInput "The handler reads the current input once, appends one list item, clears the input box, and reports the append status as the event result."

call readTitleCall gui.textBoxText
argument readTitleCall session GuiSession session
argument readTitleCall textBox GuiTextBox taskInputHandle
run readTitleCall
bind value taskTitle GuiText readTitleCall

call appendTaskCall gui.listBoxAppendItem
argument appendTaskCall session GuiSession session
argument appendTaskCall listBox GuiListBox taskListHandle
argument appendTaskCall text CNullTerminatedByteString taskTitle
run appendTaskCall
bind value appendTaskStatus CSignedInt32 appendTaskCall

call clearTaskInputCall gui.textBoxSetText
argument clearTaskInputCall session GuiSession session
argument clearTaskInputCall textBox GuiTextBox taskInputHandle
argument clearTaskInputCall text CNullTerminatedByteString emptyGuiText
run clearTaskInputCall
ignore value source clearTaskInputCall type CSignedInt32

call setAddedStatusCall gui.textLabelSetText
argument setAddedStatusCall session GuiSession session
argument setAddedStatusCall textLabel GuiTextLabel statusLabelHandle
argument setAddedStatusCall text GuiText addedStatusText
run setAddedStatusCall
ignore value source setAddedStatusCall type CSignedInt32

return value appendTaskStatus

operation markSelectedTask
input operation markSelectedTask session GuiSession
input operation markSelectedTask event GuiEvent
output operation markSelectedTask CSignedInt32
effect markSelectedTask read gui.control.listBox.selection
effect markSelectedTask write gui.control.textLabel.text
authority markSelectedTask read gui.control.listBox.selection
authority markSelectedTask write gui.control.textLabel.text
memory markSelectedTask heap no
async markSelectedTask no
purpose operation markSelectedTask "Confirm that the complete button click reached the GUI event handler without appending another list item."
invariant operation markSelectedTask "The handler observes the selected row and updates only the status label; it never mutates the list item collection."

call selectedIndexCall gui.listBoxSelectedIndex
argument selectedIndexCall session GuiSession session
argument selectedIndexCall listBox GuiListBox taskListHandle
run selectedIndexCall
bind value selectedTaskIndex CSignedInt32 selectedIndexCall

call observeSelectedTaskIndexCall math.greaterThanOrEqualCSignedInt32
argument observeSelectedTaskIndexCall left CSignedInt32 selectedTaskIndex
argument observeSelectedTaskIndexCall right CSignedInt32 noGuiFlag
run observeSelectedTaskIndexCall
ignore value source observeSelectedTaskIndexCall type Bool

call setCompletedStatusCall gui.textLabelSetText
argument setCompletedStatusCall session GuiSession session
argument setCompletedStatusCall textLabel GuiTextLabel statusLabelHandle
argument setCompletedStatusCall text GuiText completedStatusText
run setCompletedStatusCall
bind value completeStatusUpdate CSignedInt32 setCompletedStatusCall

return value completeStatusUpdate

operation clearTasks
input operation clearTasks session GuiSession
input operation clearTasks event GuiEvent
output operation clearTasks CSignedInt32
effect clearTasks write gui.control.listBox.items
effect clearTasks write gui.control.textLabel.text
authority clearTasks write gui.control.listBox.items
authority clearTasks write gui.control.textLabel.text
memory clearTasks heap no
async clearTasks no
purpose operation clearTasks "Clear visible tasks and update the status label."
invariant operation clearTasks "The handler clears the list once, updates the status label, and reports the list clear status as the event result."

call clearTaskListCall gui.listBoxClear
argument clearTaskListCall session GuiSession session
argument clearTaskListCall listBox GuiListBox taskListHandle
run clearTaskListCall
bind value clearTaskListStatus CSignedInt32 clearTaskListCall

call setClearedStatusCall gui.textLabelSetText
argument setClearedStatusCall session GuiSession session
argument setClearedStatusCall textLabel GuiTextLabel statusLabelHandle
argument setClearedStatusCall text GuiText clearedStatusText
run setClearedStatusCall
ignore value source setClearedStatusCall type CSignedInt32

return value clearTaskListStatus
