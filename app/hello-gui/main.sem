module app.hello_gui
modulePurpose app.hello_gui "Minimal Windows GUI app built with standard SemanticScript function calls."
moduleOwns app.hello_gui "The app-level constants and main operation that compose one GUI window through standard.gui functions."
moduleDoesNotOwn app.hello_gui "The native Win32 message loop, handle lifetime, layout engine, or standard.gui runtime implementation."
moduleInvariant app.hello_gui "GUI construction uses operation/call/arg/run syntax; app code does not declare GUI-specific top-level keywords."

importModule gui standard.gui

exportOperation app.hello_gui main

storage module immutable helloGuiTitle GuiText "Hello GUI"
storage module immutable titleText GuiText "SemanticScript native controls"
storage module immutable newTaskPlaceholder GuiText "New task"
storage module immutable addTaskText GuiText "Add task"
storage module immutable completeSelectedText GuiText "Complete selected"
storage module immutable clearCompletedText GuiText "Clear completed"
storage module immutable statusReadyText GuiText "Ready"
storage module immutable emptyGuiText GuiText ""
storage module immutable addedStatusText GuiText "Added task"
storage module immutable completedStatusText GuiText "Marked selected task"
storage module immutable clearedStatusText GuiText "Cleared tasks"
storage module immutable windowWidth GuiPixels 640
storage module immutable windowHeight GuiPixels 440
storage module immutable maxTaskTitleLength CSignedInt32 200
storage module immutable yesGuiFlag CSignedInt32 1
storage module immutable noGuiFlag CSignedInt32 0
storage module mutable taskInputHandle GuiTextBox 0
storage module mutable taskListHandle GuiListBox 0
storage module mutable statusLabelHandle GuiTextLabel 0

operation main
output main ExitCode
effect main allocate gui.application
effect main allocate gui.window
effect main allocate gui.control
effect main write gui.window
effect main write gui.control.event
authority main gui.application allocate
authority main gui.window allocate
authority main gui.control allocate
authority main gui.window write
authority main gui.control.event write
memoryHeap main yes
memoryAllocationSource main createApplicationCall
async main no
purpose main "Compose one native GUI window using standard.gui functions and return the GUI runtime exit status."
invariant main "GUI handles are created through standard.gui calls, attached to one main window, and event handlers are registered before applicationRun."

call createApplicationCall gui.applicationCreate
arg createApplicationCall title helloGuiTitle
run createApplicationCall
bind application GuiApplication createApplicationCall

call createWindowCall gui.windowCreate
arg createWindowCall title helloGuiTitle
arg createWindowCall width windowWidth
arg createWindowCall height windowHeight
arg createWindowCall layout verticalStackGuiWindowLayout
arg createWindowCall resizable yesGuiFlag
run createWindowCall
bind mainWindow GuiWindow createWindowCall

call createTitleLabelCall gui.textLabelCreate
arg createTitleLabelCall text titleText
run createTitleLabelCall
bind titleLabel GuiTextLabel createTitleLabelCall

call addTitleLabelCall gui.windowAddControl
arg addTitleLabelCall window mainWindow
arg addTitleLabelCall control titleLabel
run addTitleLabelCall
ignoreValue addTitleLabelCall CSignedInt32

call createTaskInputCall gui.textBoxCreate
arg createTaskInputCall placeholder newTaskPlaceholder
arg createTaskInputCall maxLength maxTaskTitleLength
run createTaskInputCall
bind taskInput GuiTextBox createTaskInputCall

call addTaskInputCall gui.windowAddControl
arg addTaskInputCall window mainWindow
arg addTaskInputCall control taskInput
run addTaskInputCall
ignoreValue addTaskInputCall CSignedInt32
set module taskInputHandle taskInput

call createAddButtonCall gui.buttonCreate
arg createAddButtonCall text addTaskText
arg createAddButtonCall isDefault yesGuiFlag
run createAddButtonCall
bind addButton GuiButton createAddButtonCall

call addAddButtonCall gui.windowAddControl
arg addAddButtonCall window mainWindow
arg addAddButtonCall control addButton
run addAddButtonCall
ignoreValue addAddButtonCall CSignedInt32

call createTaskListCall gui.listBoxCreate
arg createTaskListCall selectionMode singleGuiListBoxSelectionMode
run createTaskListCall
bind taskList GuiListBox createTaskListCall

call addTaskListCall gui.windowAddControl
arg addTaskListCall window mainWindow
arg addTaskListCall control taskList
run addTaskListCall
ignoreValue addTaskListCall CSignedInt32
set module taskListHandle taskList

call createCompleteButtonCall gui.buttonCreate
arg createCompleteButtonCall text completeSelectedText
arg createCompleteButtonCall isDefault noGuiFlag
run createCompleteButtonCall
bind completeButton GuiButton createCompleteButtonCall

call addCompleteButtonCall gui.windowAddControl
arg addCompleteButtonCall window mainWindow
arg addCompleteButtonCall control completeButton
run addCompleteButtonCall
ignoreValue addCompleteButtonCall CSignedInt32

call createClearButtonCall gui.buttonCreate
arg createClearButtonCall text clearCompletedText
arg createClearButtonCall isDefault noGuiFlag
run createClearButtonCall
bind clearButton GuiButton createClearButtonCall

call addClearButtonCall gui.windowAddControl
arg addClearButtonCall window mainWindow
arg addClearButtonCall control clearButton
run addClearButtonCall
ignoreValue addClearButtonCall CSignedInt32

call createStatusLabelCall gui.textLabelCreate
arg createStatusLabelCall text statusReadyText
run createStatusLabelCall
bind statusLabel GuiTextLabel createStatusLabelCall

call addStatusLabelCall gui.windowAddControl
arg addStatusLabelCall window mainWindow
arg addStatusLabelCall control statusLabel
run addStatusLabelCall
ignoreValue addStatusLabelCall CSignedInt32
set module statusLabelHandle statusLabel

call registerAddButtonClickCall gui.controlOnEvent
arg registerAddButtonClickCall control addButton
arg registerAddButtonClickCall eventKind clickGuiEventKind
arg registerAddButtonClickCall handler addTaskFromInput
run registerAddButtonClickCall
ignoreValue registerAddButtonClickCall CSignedInt32

call registerTaskInputEnterCall gui.controlOnEvent
arg registerTaskInputEnterCall control taskInput
arg registerTaskInputEnterCall eventKind enterPressedGuiEventKind
arg registerTaskInputEnterCall handler addTaskFromInput
run registerTaskInputEnterCall
ignoreValue registerTaskInputEnterCall CSignedInt32

call registerCompleteButtonClickCall gui.controlOnEvent
arg registerCompleteButtonClickCall control completeButton
arg registerCompleteButtonClickCall eventKind clickGuiEventKind
arg registerCompleteButtonClickCall handler markSelectedTask
run registerCompleteButtonClickCall
ignoreValue registerCompleteButtonClickCall CSignedInt32

call registerClearButtonClickCall gui.controlOnEvent
arg registerClearButtonClickCall control clearButton
arg registerClearButtonClickCall eventKind clickGuiEventKind
arg registerClearButtonClickCall handler clearTasks
run registerClearButtonClickCall
ignoreValue registerClearButtonClickCall CSignedInt32

call setMainWindowCall gui.applicationSetMainWindow
arg setMainWindowCall application application
arg setMainWindowCall window mainWindow
run setMainWindowCall
ignoreValue setMainWindowCall CSignedInt32

call runApplicationCall gui.applicationRun
arg runApplicationCall application application
run runApplicationCall
bind guiExitCode ExitCode runApplicationCall
returnValue guiExitCode

operation addTaskFromInput
input addTaskFromInput session GuiSession
input addTaskFromInput event GuiEvent
output addTaskFromInput CSignedInt32
effect addTaskFromInput read gui.control.textBox.text
effect addTaskFromInput write gui.control.textBox.text
effect addTaskFromInput write gui.control.listBox.items
effect addTaskFromInput write gui.control.textLabel.text
authority addTaskFromInput gui.control.textBox.text read
authority addTaskFromInput gui.control.textBox.text write
authority addTaskFromInput gui.control.listBox.items write
authority addTaskFromInput gui.control.textLabel.text write
memoryHeap addTaskFromInput no
async addTaskFromInput no
purpose addTaskFromInput "Append the current text box value to the visible task list and clear the input."

call readTitleCall gui.textBoxText
arg readTitleCall session session
arg readTitleCall textBox taskInputHandle
run readTitleCall
bind taskTitle GuiText readTitleCall

call appendTaskCall gui.listBoxAppendItem
arg appendTaskCall session session
arg appendTaskCall listBox taskListHandle
arg appendTaskCall text taskTitle
run appendTaskCall
bind appendTaskStatus CSignedInt32 appendTaskCall

call clearTaskInputCall gui.textBoxSetText
arg clearTaskInputCall session session
arg clearTaskInputCall textBox taskInputHandle
arg clearTaskInputCall text emptyGuiText
run clearTaskInputCall
ignoreValue clearTaskInputCall CSignedInt32

call setAddedStatusCall gui.textLabelSetText
arg setAddedStatusCall session session
arg setAddedStatusCall textLabel statusLabelHandle
arg setAddedStatusCall text addedStatusText
run setAddedStatusCall
ignoreValue setAddedStatusCall CSignedInt32

returnValue appendTaskStatus

operation markSelectedTask
input markSelectedTask session GuiSession
input markSelectedTask event GuiEvent
output markSelectedTask CSignedInt32
effect markSelectedTask read gui.control.listBox.selection
effect markSelectedTask write gui.control.listBox.items
effect markSelectedTask write gui.control.textLabel.text
authority markSelectedTask gui.control.listBox.selection read
authority markSelectedTask gui.control.listBox.items write
authority markSelectedTask gui.control.textLabel.text write
memoryHeap markSelectedTask no
async markSelectedTask no
purpose markSelectedTask "Confirm that the complete button click reached the GUI event handler."

call selectedIndexCall gui.listBoxSelectedIndex
arg selectedIndexCall session session
arg selectedIndexCall listBox taskListHandle
run selectedIndexCall
ignoreValue selectedIndexCall CSignedInt32

call appendCompletedMarkerCall gui.listBoxAppendItem
arg appendCompletedMarkerCall session session
arg appendCompletedMarkerCall listBox taskListHandle
arg appendCompletedMarkerCall text completedStatusText
run appendCompletedMarkerCall
bind appendCompletedMarkerStatus CSignedInt32 appendCompletedMarkerCall

call setCompletedStatusCall gui.textLabelSetText
arg setCompletedStatusCall session session
arg setCompletedStatusCall textLabel statusLabelHandle
arg setCompletedStatusCall text completedStatusText
run setCompletedStatusCall
ignoreValue setCompletedStatusCall CSignedInt32

returnValue appendCompletedMarkerStatus

operation clearTasks
input clearTasks session GuiSession
input clearTasks event GuiEvent
output clearTasks CSignedInt32
effect clearTasks write gui.control.listBox.items
effect clearTasks write gui.control.textLabel.text
authority clearTasks gui.control.listBox.items write
authority clearTasks gui.control.textLabel.text write
memoryHeap clearTasks no
async clearTasks no
purpose clearTasks "Clear visible tasks and update the status label."

call clearTaskListCall gui.listBoxClear
arg clearTaskListCall session session
arg clearTaskListCall listBox taskListHandle
run clearTaskListCall
bind clearTaskListStatus CSignedInt32 clearTaskListCall

call setClearedStatusCall gui.textLabelSetText
arg setClearedStatusCall session session
arg setClearedStatusCall textLabel statusLabelHandle
arg setClearedStatusCall text clearedStatusText
run setClearedStatusCall
ignoreValue setClearedStatusCall CSignedInt32

returnValue clearTaskListStatus
