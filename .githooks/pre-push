#!/bin/sh
# Reject pushing a branch whose name does not match the project convention
# (type/kebab-description). See CONTRIBUTING.md (Branch Naming). Enable with:
#   git config core.hooksPath .githooks
#
# git feeds pre-push one line per ref on stdin:
#   <local_ref> <local_sha> <remote_ref> <remote_sha>

regex='^(feat|fix|docs|chore|refactor|test|perf|build|ci)/[a-z0-9]+(-[a-z0-9]+)*$'
zero='0000000000000000000000000000000000000000'
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # Skip branch deletions (local sha is all zeros).
  [ "$local_sha" = "$zero" ] && continue
  case "$local_ref" in
    refs/heads/*) branch=${local_ref#refs/heads/} ;;
    *) continue ;;
  esac
  case "$branch" in
    main|master|release/*|dependabot/*) continue ;;
  esac
  if ! printf '%s' "$branch" | grep -Eq "$regex"; then
    echo "pre-push: branch '$branch' does not match 'type/kebab-description'." >&2
    echo "          Allowed types: feat, fix, docs, chore, refactor, test, perf, build, ci." >&2
    echo "          See CONTRIBUTING.md (Branch Naming)." >&2
    status=1
  fi
done

exit $status
