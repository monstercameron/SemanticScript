main is operation
main purpose "Run the case and print what it computes"
main invariant none
main typeParameter none
main input none
main output ExitCode
main outputOwnedBy none
main raises none
main effect write console.stdout
main uses stdoutWriter
main memoryHeap false
main async false
main maxRecursion none
main label begin loopKind none
main label begin within none
main label walk loopKind while
main label walk within none
main label walk maxIterations 16
main label moved loopKind none
main label moved within walk
main label finished loopKind none
main label finished within none
main label report loopKind none
main label report within none
main label before loopKind none
main label before within none
main label slices loopKind none
main label slices within none
main label splitStart loopKind none
main label splitStart within none
main label splitStartFailed loopKind none
main label splitStartFailed within none
main label splitEnd loopKind none
main label splitEnd within none
main label splitEndFailed loopKind none
main label splitEndFailed within none
main label punctuation loopKind none
main label punctuation within none
main label broken loopKind none
main label broken within none
main let source String "a\xc3\xa9\nb\xc3z" immutable
main let accented String "h\xc3\xa9llo" immutable
main let zero Int64 0 immutable
main let one Int64 1 immutable
main let two Int64 2 immutable
main let minusOne Int64 -1 immutable
main let paren Byte 40 immutable
main let letter Byte 97 immutable
main let tilde Byte 126 immutable
main let space Byte 32 immutable
main let delete Byte 127 immutable
main let position string.Position unset mutable
main let failCode ExitCode 1 immutable
main let okCode ExitCode 0 immutable
main at begin do makeStart
main at begin set position startPosition
main at begin goto walk
main at walk do readOffset
main at walk do printOffset
main at walk do stepIt
main at walk branch ifError stepIt goto finished else goto moved
main at moved set position nextPosition
main at moved goto walk
main at finished match stepError string.StringIndexError
main at finished case string.StringIndexError.outOfRange bind badOffset Int64 goto report
main at report do readLine
main at report do printLine
main at report do readColumn
main at report do printColumn
main at report do printBadOffset
main at report do makeBefore
main at report do stepBefore
main at report branch ifError stepBefore goto before else goto broken
main at before match beforeError string.StringIndexError
main at before case string.StringIndexError.outOfRange bind beforeOffset Int64 goto slices
main at slices do printBeforeOffset
main at slices do sliceWhole
main at slices branch ifError sliceWhole goto broken else goto splitStart
main at splitStart do measureWhole
main at splitStart do printWhole
main at splitStart do sliceSplitStart
main at splitStart branch ifError sliceSplitStart goto splitStartFailed else goto broken
main at splitStartFailed match splitStartError string.StringIndexError
main at splitStartFailed case string.StringIndexError.outOfRange bind splitStartAt Int64 goto splitEnd
main at splitEnd do printSplitStart
main at splitEnd do sliceSplitEnd
main at splitEnd branch ifError sliceSplitEnd goto splitEndFailed else goto broken
main at splitEndFailed match splitEndError string.StringIndexError
main at splitEndFailed case string.StringIndexError.outOfRange bind splitEndAt Int64 goto punctuation
main at punctuation do printSplitEnd
main at punctuation do parenCheck
main at punctuation do printParen
main at punctuation do letterCheck
main at punctuation do printLetter
main at punctuation do tildeCheck
main at punctuation do printTilde
main at punctuation do spaceCheck
main at punctuation do printSpace
main at punctuation do deleteCheck
main at punctuation do printDelete
main at punctuation return ok okCode
main at broken return ok failCode

