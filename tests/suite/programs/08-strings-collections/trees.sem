main at printValue do printTotal
main at printValue branch ifError printTotal goto failed else goto listNames
main at listNames branch ifNext symbolTable bind name String goto printName else goto finished
main at printName do printOneName
main at printName branch ifError printOneName goto failed else goto listNames
