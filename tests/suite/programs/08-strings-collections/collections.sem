# covers: 2 Maps / Dictionaries
# covers: 2 Sets
# covers: 8 Nested collections
# covers: 8 Multidimensional arrays
# covers: 14 Nested generics
# covers: 19 Collection utilities
# kind: positive
# expect: unsupported values of type `collections.Counts`

collections is module
collections purpose "Show maps, sets, and a list of lists"
collections path collections
collections imports standard.list
collections imports standard.map
collections imports standard.set
collections exports main

Counts is instance
Counts purpose "Whole-number counts keyed by whole numbers"
Counts instantiates map.Map Int64 Int64

Seen is instance
Seen purpose "A set of whole numbers already seen"
Seen instantiates set.Set Int64

Row is instance
Row purpose "One row of a grid"
Row instantiates list.List Int64

Grid is instance
Grid purpose "Rows of whole numbers"
Grid instantiates list.List Row

main is operation
main purpose "Run the case and print what it computes"
main invariant none
main typeParam none
main input none
main output ExitCode
main outputOwner none
main raises none
main effect none
main uses none
main memory heap true
main async false
main maxRecursion none
main label begin loopKind none
main label begin within none
main label sets loopKind none
main label sets within none
main label broken loopKind none
main label broken within none
main let one immutable Int64 1
main let two immutable Int64 2
main let failCode immutable ExitCode 1
main let okCode immutable ExitCode 0
main at begin do makeCounts
main at begin do putOne
main at begin do readOne
main at begin branch ifError readOne goto broken else goto sets
main at sets do makeSeen
main at sets do addOne
main at sets do hasOne
main at sets do removeOne
main at sets do makeRow
main at sets do appendCell
main at sets do makeGrid
main at sets do appendRow
main at sets return ok okCode
main at broken return ok failCode

store is region
store in main
store strategy arena
store capacity 65536
store released atReturn

makeCounts is call
makeCounts in main
makeCounts invokes Counts.new
makeCounts arg region Region store lend
makeCounts out counts Counts
makeCounts ownedBy store
makeCounts cleanedBy none
makeCounts borrows none
makeCounts catch none

putOne is call
putOne in main
putOne invokes Counts.put
putOne arg map Counts counts lendMutable
putOne arg key Int64 one copy
putOne arg value Int64 two copy
putOne out none
putOne ownedBy none
putOne cleanedBy none
putOne borrows none
putOne catch none

readOne is call
readOne in main
readOne invokes Counts.get
readOne arg map Counts counts lend
readOne arg key Int64 one copy
readOne out countOfOne Int64
readOne ownedBy none
readOne cleanedBy none
readOne borrows none
readOne catch missing map.KeyMissing

makeSeen is call
makeSeen in main
makeSeen invokes Seen.new
makeSeen arg region Region store lend
makeSeen out seen Seen
makeSeen ownedBy store
makeSeen cleanedBy none
makeSeen borrows none
makeSeen catch none

addOne is call
addOne in main
addOne invokes Seen.add
addOne arg set Seen seen lendMutable
addOne arg item Int64 one copy
addOne out none
addOne ownedBy none
addOne cleanedBy none
addOne borrows none
addOne catch none

hasOne is call
hasOne in main
hasOne invokes Seen.contains
hasOne arg set Seen seen lend
hasOne arg item Int64 one copy
hasOne out containsOne Bool
hasOne ownedBy none
hasOne cleanedBy none
hasOne borrows none
hasOne catch none

removeOne is call
removeOne in main
removeOne invokes Seen.remove
removeOne arg set Seen seen lendMutable
removeOne arg item Int64 one copy
removeOne out none
removeOne ownedBy none
removeOne cleanedBy none
removeOne borrows none
removeOne catch none

makeRow is call
makeRow in main
makeRow invokes Row.new
makeRow arg region Region store lend
makeRow out row Row
makeRow ownedBy store
makeRow cleanedBy none
makeRow borrows none
makeRow catch none

appendCell is call
appendCell in main
appendCell invokes Row.append
appendCell arg list Row row lendMutable
appendCell arg item Int64 one copy
appendCell out none
appendCell ownedBy none
appendCell cleanedBy none
appendCell borrows none
appendCell catch none

makeGrid is call
makeGrid in main
makeGrid invokes Grid.new
makeGrid arg region Region store lend
makeGrid out grid Grid
makeGrid ownedBy store
makeGrid cleanedBy none
makeGrid borrows none
makeGrid catch none

appendRow is call
appendRow in main
appendRow invokes Grid.append
appendRow arg list Grid grid lendMutable
appendRow arg item Row row give
appendRow out none
appendRow ownedBy none
appendRow cleanedBy none
appendRow borrows none
appendRow catch none
