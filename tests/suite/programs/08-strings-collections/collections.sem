# covers: 2 Maps / Dictionaries
# covers: 2 Sets
# covers: 8 Nested collections
# covers: 8 Multidimensional arrays
# covers: 14 Nested generics
# covers: 19 Collection utilities
# covers: 8 Collection removal
# covers: 8 Collection searching
# kind: positive
# expect: run
# exit: 0
# stdout: 2
# stdout: 1
# stdout: -1
# stdout: true
# stdout: false
# stdout: 0
# stdout: 1

collections is module
collections purpose "Show a map, a set, and a list of lists"
collections path collections
collections imports standard.console
collections imports standard.list
collections imports standard.map
collections imports standard.set
collections exports main

stdoutWriter is capability
stdoutWriter purpose "Authority to write lines to standard output"
stdoutWriter grants write console.stdout
stdoutWriter scope none

showInt is operation
showInt purpose "Print one whole number on its own line"
showInt invariant none
showInt typeParam none
showInt input value Int64 value
showInt output none
showInt outputOwner none
showInt raises none
showInt effect write console.stdout
showInt uses stdoutWriter
showInt memory heap false
showInt async false
showInt maxRecursion none
showInt label begin loopKind none
showInt label begin within none
showInt label done loopKind none
showInt label done within none
showInt at begin do writeValue
showInt at begin branch ifError writeValue goto done else goto done
showInt at done return ok none

writeValue is call
writeValue rationale "A test program has nowhere to report a failed write"
writeValue in showInt
writeValue invokes console.writeIntegerLine
writeValue arg value Int64 value copy
writeValue out none
writeValue ownedBy none
writeValue cleanedBy none
writeValue borrows none
writeValue catch writeError console.WriteError

showBool is operation
showBool purpose "Print true or false on its own line"
showBool invariant none
showBool typeParam none
showBool input flag Bool value
showBool output none
showBool outputOwner none
showBool raises none
showBool effect write console.stdout
showBool uses stdoutWriter
showBool memory heap false
showBool async false
showBool maxRecursion none
showBool label begin loopKind none
showBool label begin within none
showBool label sayTrue loopKind none
showBool label sayTrue within none
showBool label sayFalse loopKind none
showBool label sayFalse within none
showBool label done loopKind none
showBool label done within none
showBool let trueText immutable String "true"
showBool let falseText immutable String "false"
showBool at begin branch if flag goto sayTrue else goto sayFalse
showBool at sayTrue do writeTrue
showBool at sayTrue branch ifError writeTrue goto done else goto done
showBool at sayFalse do writeFalse
showBool at sayFalse branch ifError writeFalse goto done else goto done
showBool at done return ok none

writeTrue is call
writeTrue rationale "A test program has nowhere to report a failed write"
writeTrue in showBool
writeTrue invokes console.writeLine
writeTrue arg text String trueText lend
writeTrue out none
writeTrue ownedBy none
writeTrue cleanedBy none
writeTrue borrows none
writeTrue catch trueError console.WriteError

writeFalse is call
writeFalse rationale "A test program has nowhere to report a failed write"
writeFalse in showBool
writeFalse invokes console.writeLine
writeFalse arg text String falseText lend
writeFalse out none
writeFalse ownedBy none
writeFalse cleanedBy none
writeFalse borrows none
writeFalse catch falseError console.WriteError

Counts is instance
Counts purpose "Whole-number counts keyed by whole numbers"
Counts instantiates map.Map Int64 Int64

Seen is instance
Seen purpose "A set of whole numbers already seen"
Seen instantiates set.Set Int64

Row is instance
Row purpose "One row of a grid"
Row instantiates list.List Int64

Grid is instance
Grid purpose "Rows of whole numbers"
Grid instantiates list.List Row

main is operation
main purpose "Run the case and print what it computes"
main invariant none
main typeParam none
main input none
main output ExitCode
main outputOwner none
main raises none
main effect write console.stdout
main uses stdoutWriter
main memory heap true
main async false
main maxRecursion none
main label begin loopKind none
main label begin within none
main label showRead loopKind none
main label showRead within none
main label missingTwo loopKind none
main label missingTwo within none
main label sets loopKind none
main label sets within none
main label failed loopKind none
main label failed within none
main let one immutable Int64 1
main let two immutable Int64 2
main let minusOne immutable Int64 -1
main let okCode immutable ExitCode 0
main let failCode immutable ExitCode 1
main at begin do makeCounts
main at begin do putOne
main at begin do readOne
main at begin branch ifError readOne goto failed else goto showRead
main at showRead do printCount
main at showRead do countKeys
main at showRead do printKeys
main at showRead do readTwo
main at showRead branch ifError readTwo goto missingTwo else goto failed
main at missingTwo do printMissing
main at missingTwo goto sets
main at sets do makeSeen
main at sets do addOne
main at sets do hasOne
main at sets do printHas
main at sets do removeOne
main at sets do hasOneAgain
main at sets do printHasAgain
main at sets do countSeen
main at sets do printSeen
main at sets do makeRow
main at sets do appendCell
main at sets do makeGrid
main at sets do appendRow
main at sets do countRows
main at sets do printRows
main at sets return ok okCode
main at failed return ok failCode

store is region
store in main
store strategy arena
store capacity 65536
store released atReturn

makeCounts is call
makeCounts in main
makeCounts invokes Counts.new
makeCounts arg region Region store lend
makeCounts out counts Counts
makeCounts ownedBy store
makeCounts cleanedBy none
makeCounts borrows none
makeCounts catch none

