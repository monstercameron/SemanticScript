# covers: 8 String creation
# covers: 8 String concatenation
# covers: 8 String comparison
# covers: 8 String slicing
# covers: 8 Unicode support
# covers: 8 UTF-8 handling
# covers: 8 String escaping
# covers: 8 Empty strings
# covers: 8 Collection searching
# covers: 8 String interpolation
# covers: 2 Strings
# covers: 2 Characters
# covers: 2 Byte arrays
# covers: 19 String utilities
# covers: 17 Input validation
# covers: 22 Malformed input
# covers: 22 Invalid Unicode
# kind: positive
# expect: run
# exit: 0
# stdout: 0
# stdout: 6
# stdout: Hello, world
# stdout: true
# stdout: true
# stdout: world
# stdout: 7
# stdout: 7
# stdout: -1
# stdout: -42
# stdout: 123
# stdout: 1
# stdout: say "hi"	ok\
# stdout: 72
# stdout: 1

strings is module
strings purpose "Show building, comparing, slicing, searching, converting, and escaping strings"
strings path strings
strings imports standard.console
strings imports standard.string
strings imports standard.convert
strings exports main

stdoutWriter is capability
stdoutWriter purpose "Authority to write lines to standard output"
stdoutWriter grants write console.stdout
stdoutWriter scope none

showInt is operation
showInt purpose "Print one whole number on its own line"
showInt invariant none
showInt typeParam none
showInt input value Int64 value
showInt output none
showInt outputOwner none
showInt raises none
showInt effect write console.stdout
showInt uses stdoutWriter
showInt memory heap false
showInt async false
showInt maxRecursion none
showInt label begin loopKind none
showInt label begin within none
showInt label done loopKind none
showInt label done within none
showInt at begin do writeValue
showInt at begin branch ifError writeValue goto done else goto done
showInt at done return ok none

writeValue is call
writeValue rationale "A test program has nowhere to report a failed write"
writeValue in showInt
writeValue invokes console.writeIntegerLine
writeValue arg value Int64 value copy
writeValue out none
writeValue ownedBy none
writeValue cleanedBy none
writeValue borrows none
writeValue catch writeError console.WriteError

showBool is operation
showBool purpose "Print true or false on its own line"
showBool invariant none
showBool typeParam none
showBool input flag Bool value
showBool output none
showBool outputOwner none
showBool raises none
showBool effect write console.stdout
showBool uses stdoutWriter
showBool memory heap false
showBool async false
showBool maxRecursion none
showBool label begin loopKind none
showBool label begin within none
showBool label sayTrue loopKind none
showBool label sayTrue within none
showBool label sayFalse loopKind none
showBool label sayFalse within none
showBool label done loopKind none
showBool label done within none
showBool let trueText immutable String "true"
showBool let falseText immutable String "false"
showBool at begin branch if flag goto sayTrue else goto sayFalse
showBool at sayTrue do writeTrue
showBool at sayTrue branch ifError writeTrue goto done else goto done
showBool at sayFalse do writeFalse
showBool at sayFalse branch ifError writeFalse goto done else goto done
showBool at done return ok none

writeTrue is call
writeTrue rationale "A test program has nowhere to report a failed write"
writeTrue in showBool
writeTrue invokes console.writeLine
writeTrue arg text String trueText lend
writeTrue out none
writeTrue ownedBy none
writeTrue cleanedBy none
writeTrue borrows none
writeTrue catch trueError console.WriteError

writeFalse is call
writeFalse rationale "A test program has nowhere to report a failed write"
writeFalse in showBool
writeFalse invokes console.writeLine
writeFalse arg text String falseText lend
writeFalse out none
writeFalse ownedBy none
writeFalse cleanedBy none
writeFalse borrows none
writeFalse catch falseError console.WriteError

showText is operation
showText purpose "Print one line of text"
showText invariant none
showText typeParam none
showText input text String borrowed
showText output none
showText outputOwner none
showText raises none
showText effect write console.stdout
showText uses stdoutWriter
showText memory heap false
showText async false
showText maxRecursion none
showText label begin loopKind none
showText label begin within none
showText label done loopKind none
showText label done within none
showText at begin do writeValue
showText at begin branch ifError writeValue goto done else goto done
showText at done return ok none

writeValue is call
writeValue rationale "A test program has nowhere to report a failed write"
writeValue in showText
writeValue invokes console.writeLine
writeValue arg text String text lend
writeValue out none
writeValue ownedBy none
writeValue cleanedBy none
writeValue borrows none
writeValue catch writeError console.WriteError

main is operation
main purpose "Run the case and print what it computes"
main invariant none
main typeParam none
main input none
main output ExitCode
main outputOwner none
main raises none
main effect write console.stdout
main uses stdoutWriter
main memory heap true
main async false
main maxRecursion none
main label begin loopKind none
main label begin within none
main label showCut loopKind none
main label showCut within none
main label tooFar loopKind none
main label tooFar within none
main label showTooFar loopKind none
main label showTooFar within none
main label showFound loopKind none
main label showFound within none
main label notFound loopKind none
main label notFound within none
main label showParsed loopKind none
main label showParsed within none
main label badNumber loopKind none
main label badNumber within none
main label notNumber loopKind none
main label notNumber within none
main label showByte loopKind none
main label showByte within none
main label broken loopKind none
main label broken within none
main let empty immutable String ""
main let accented immutable String "héllo"
main let hello immutable String "Hello, "
main let world immutable String "world"
main let helloWorld immutable String "Hello, world"
main let seven immutable Int64 7
main let five immutable Int64 5
main let twenty immutable Int64 20
main let needle immutable String "wor"
main let absent immutable String "xyz"
main let minusFortyTwo immutable Int64 -42
main let goodNumber immutable String "123"
main let badNumberText immutable String "12a"
main let escaped immutable String "say \"hi\"\tok\\"
main let zero immutable Int64 0
main let one immutable Int64 1
main let minusOne immutable Int64 -1
main let rawByte immutable String "\xff"
main let failCode immutable ExitCode 1
main let okCode immutable ExitCode 0
main at begin do emptyLength
main at begin do showEmpty
main at begin do accentLength
main at begin do showAccent
main at begin do join
main at begin do showJoined
main at begin do sameText
main at begin do showSame
main at begin do hasPrefix
main at begin do showPrefix
main at begin do cut
main at begin branch ifError cut goto broken else goto showCut
main at showCut do printCut
main at showCut do cutTooFar
main at showCut branch ifError cutTooFar goto tooFar else goto broken
main at tooFar match cutError string.StringIndexError
main at tooFar case string.StringIndexError.outOfRange bind badStart Int64 goto showTooFar
main at showTooFar do printTooFar
main at showTooFar do search
main at showTooFar branch ifError search goto broken else goto showFound
main at showFound do printFound
main at showFound do searchMissing
main at showFound branch ifError searchMissing goto notFound else goto broken
main at notFound do printMissing
main at notFound do numberText
main at notFound do printNumber
main at notFound do parseGood
main at notFound branch ifError parseGood goto broken else goto showParsed
main at showParsed do printParsed
main at showParsed do parseBad
main at showParsed branch ifError parseBad goto badNumber else goto broken
main at badNumber match parseError string.ParseError
main at badNumber case string.ParseError.notANumber bind none none goto notNumber
main at badNumber case string.ParseError.outOfRange bind none none goto broken
main at notNumber do printOne
main at notNumber do printEscaped
main at notNumber do firstByte
main at notNumber branch ifError firstByte goto broken else goto showByte
main at showByte do widenByte
main at showByte do printByte
main at showByte do rawLength
main at showByte do printRaw
main at showByte return ok okCode
main at broken return ok failCode

