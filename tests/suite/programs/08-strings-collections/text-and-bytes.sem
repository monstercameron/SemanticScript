main is operation
main purpose "Run the case and print what it computes"
main invariant none
main typeParameter none
main input none
main output ExitCode
main outputOwnedBy none
main raises none
main effect write console.stdout
main uses stdoutWriter
main memoryHeap true
main async false
main maxRecursion none
main label begin loopKind none
main label begin within none
main label sayLess loopKind none
main label sayLess within none
main label showFound loopKind none
main label showFound within none
main label showLetter loopKind none
main label showLetter within none
main label refused loopKind none
main label refused within none
main label showParsed loopKind none
main label showParsed within none
main label showReal loopKind none
main label showReal within none
main label rejected loopKind none
main label rejected within none
main label showFirst loopKind none
main label showFirst within none
main label compareTail loopKind none
main label compareTail within none
main label finish loopKind none
main label finish within none
main label failed loopKind none
main label failed within none
main let apple String "apple" immutable
main let apricot String "apricot" immutable
main let fileName String "lexer.sem" immutable
main let suffix String ".sem" immutable
main let haystack String "a,b,c" immutable
main let comma String "," immutable
main let start Int64 2 immutable
main let letter Byte 65 immutable
main let high Byte 200 immutable
main let ten Byte 10 immutable
main let digits String "18446744073709551615" immutable
main let decimal String "3.25" immutable
main let broken String "1.5x" immutable
main let tenth Float64 0.1 immutable
main let zero Int64 0 immutable
main let five Int64 5 immutable
main let four Int64 4 immutable
main let lessWord String "less" immutable
main let notCharacter String "not a character" immutable
main let notNumber String "not a number" immutable
main let okCode ExitCode 0 immutable
main let failCode ExitCode 1 immutable
main at begin do step1
main at begin match order string.Ordering
main at begin case string.Ordering.less bind none none goto sayLess
main at begin case string.Ordering.equal bind none none goto failed
main at begin case string.Ordering.greater bind none none goto failed
main at sayLess do step2
main at sayLess do step3
main at sayLess do step4
main at sayLess do findComma
main at sayLess branch ifError findComma goto failed else goto showFound
main at showFound do step6
main at showFound do makeLetter
main at showFound branch ifError makeLetter goto failed else goto showLetter
main at showLetter do step8
main at showLetter do makeHigh
main at showLetter branch ifError makeHigh goto refused else goto failed
main at refused do step10
main at refused do step11
main at refused do step12
main at refused do parseDigits
main at refused branch ifError parseDigits goto failed else goto showParsed
main at showParsed do step14
main at showParsed do step15
main at showParsed do parseDecimal
main at showParsed branch ifError parseDecimal goto failed else goto showReal
main at showReal do step17
main at showReal do parseBroken
main at showReal branch ifError parseBroken goto rejected else goto failed
main at rejected do step19
main at rejected do step20
main at rejected do step21
main at rejected do viewName
main at rejected do step23
main at rejected do step24
main at rejected do readFirst
main at rejected branch ifError readFirst goto failed else goto showFirst
main at showFirst do step26
main at showFirst do step27
main at showFirst do cutTail
main at showFirst branch ifError cutTail goto failed else goto compareTail
main at compareTail do viewSuffix
main at compareTail do step30
main at compareTail do step31
main at compareTail do readThird
main at compareTail branch ifError readThird goto failed else goto finish
main at finish return ok okCode
main at failed return ok failCode

