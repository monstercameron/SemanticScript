# exit: 0
# stdout: less
# stdout: true
# stdout: 3
# stdout: A
# stdout: not a character
# stdout: 0a
# stdout: 18446744073709551615
# stdout: 3.25
# stdout: not a number
# stdout: 0.1
# stdout: 9
# stdout: 108
# stdout: true

textAndBytes is module
textAndBytes purpose "Order, search, build, and parse text, and read bytes, without the host"
textAndBytes path textAndBytes
textAndBytes imports standard.console
textAndBytes imports standard.string
textAndBytes imports standard.bytes
textAndBytes imports standard.convert
textAndBytes exports main

stdoutWriter is capability
stdoutWriter purpose "Authority to write lines to standard output"
stdoutWriter grants write console.stdout none

showInt is operation
