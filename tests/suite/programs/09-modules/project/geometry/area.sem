area is module
area purpose "Compute areas of the shared shapes"
area path geometry.area
area imports geometry.shapes
area imports standard.math
area imports standard.test
area exports rectangle

rectangle is operation
rectangle purpose "Return the area of a rectangle"
rectangle invariant widthTimesHeight "Returns width times height"
rectangle typeParam none
rectangle input shape shapes.Rectangle value
rectangle output Int64
rectangle outputOwner none
rectangle raises none
rectangle effect none
rectangle uses none
rectangle memory heap false
rectangle async false
rectangle maxRecursion none
rectangle label begin loopKind none
rectangle label begin within none
rectangle at begin do readWidth
rectangle at begin do readHeight
rectangle at begin do multiply
rectangle at begin return ok product

readWidth is call
readWidth in rectangle
readWidth invokes shapes.Rectangle.width
readWidth arg record shapes.Rectangle shape copy
readWidth out sideWidth Int64
readWidth ownedBy none
readWidth cleanedBy none
readWidth borrows none
readWidth catch none

readHeight is call
readHeight in rectangle
readHeight invokes shapes.Rectangle.height
readHeight arg record shapes.Rectangle shape copy
readHeight out sideHeight Int64
readHeight ownedBy none
readHeight cleanedBy none
readHeight borrows none
readHeight catch none

multiply is call
multiply in rectangle
multiply invokes math.multiplyInt64
multiply arg left Int64 sideWidth copy
multiply arg right Int64 sideHeight copy
multiply out product Int64
multiply ownedBy none
multiply cleanedBy none
multiply borrows none
multiply catch none
