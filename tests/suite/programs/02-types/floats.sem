# covers: 2 Floating-point numbers
# covers: 3 Floating-point precision
# covers: 3 NaN / Infinity handling
# covers: 22 Floating-point extremes
# kind: edge
# expect: run
# exit: 0
# stdout: 0.30000000000000004
# stdout: inf
# stdout: false
# stdout: true
# stdout: 1.7976931348623157e+308

floats is module
floats purpose "Show floating-point arithmetic, precision, and infinity"
floats path floats
floats imports standard.console
floats imports standard.math
floats imports standard.compare
floats exports main

stdoutWriter is capability
stdoutWriter purpose "Authority to write lines to standard output"
stdoutWriter grants write console.stdout none

showFloat is operation
showFloat purpose "Print one floating-point number on its own line"
showFloat invariant none
showFloat typeParameter none
showFloat input value Float64 copied
showFloat output none
showFloat outputOwnedBy none
showFloat raises none
showFloat effect write console.stdout
showFloat uses stdoutWriter
showFloat memoryHeap false
showFloat async false
showFloat maxRecursion none
showFloat label begin loopKind none
showFloat label begin within none
showFloat label done loopKind none
showFloat label done within none
showFloat let none
showFloat at begin do writeValue
showFloat at begin branch ifError writeValue goto done else goto done
showFloat at done return ok none

writeValue is call
writeValue rationale "A test program has nowhere to report a failed write"
writeValue in showFloat
writeValue invokes console.writeFloatLine
writeValue argument value Float64 value copy
writeValue result none
writeValue ownedBy none
writeValue cleanedBy none
writeValue borrows none
writeValue catch writeError console.WriteError
writeValue suppresses console.WriteError.failed

showBool is operation
showBool purpose "Print true or false on its own line"
showBool invariant none
showBool typeParameter none
showBool input flag Bool copied
showBool output none
showBool outputOwnedBy none
showBool raises none
showBool effect write console.stdout
showBool uses stdoutWriter
showBool memoryHeap false
showBool async false
showBool maxRecursion none
showBool label begin loopKind none
showBool label begin within none
showBool label sayTrue loopKind none
showBool label sayTrue within none
showBool label sayFalse loopKind none
showBool label sayFalse within none
showBool label done loopKind none
showBool label done within none
showBool let trueText String "true" immutable
showBool let falseText String "false" immutable
showBool at begin branch if flag goto sayTrue else goto sayFalse
showBool at sayTrue do writeTrue
showBool at sayTrue branch ifError writeTrue goto done else goto done
showBool at sayFalse do writeFalse
showBool at sayFalse branch ifError writeFalse goto done else goto done
showBool at done return ok none

writeTrue is call
writeTrue rationale "A test program has nowhere to report a failed write"
writeTrue in showBool
writeTrue invokes console.writeLine
writeTrue argument text String trueText lend
writeTrue result none
writeTrue ownedBy none
writeTrue cleanedBy none
writeTrue borrows none
writeTrue catch trueError console.WriteError
writeTrue suppresses console.WriteError.failed

writeFalse is call
writeFalse rationale "A test program has nowhere to report a failed write"
writeFalse in showBool
writeFalse invokes console.writeLine
writeFalse argument text String falseText lend
writeFalse result none
writeFalse ownedBy none
writeFalse cleanedBy none
writeFalse borrows none
writeFalse catch falseError console.WriteError
writeFalse suppresses console.WriteError.failed

main is operation
main purpose "Run the case and print what it computes"
main invariant none
main typeParameter none
main input none
main output ExitCode
main outputOwnedBy none
main raises none
main effect write console.stdout
main uses stdoutWriter
main memoryHeap false
main async false
main maxRecursion none
main label begin loopKind none
main label begin within none
main let tenth Float64 0.1 immutable
main let twoTenths Float64 0.2 immutable
main let largest Float64 .0 immutable
main let ten Float64 10.0 immutable
main let zero Float64 0.0 immutable
main let okCode ExitCode 0 immutable
main at begin do addTenths
main at begin do showSum
main at begin do overflow
main at begin do showInfinity
main at begin do makeNan
main at begin do nanSelf
main at begin do showNanEqual
main at begin do infinityBig
main at begin do showInfinityBig
main at begin do showLargest
main at begin return ok okCode

addTenths is call
addTenths in main
addTenths invokes math.addFloat64
addTenths argument left Float64 tenth copy
addTenths argument right Float64 twoTenths copy
addTenths result tenthsSum Float64
addTenths ownedBy none
addTenths cleanedBy none
addTenths borrows none
addTenths catch none
addTenths suppresses none

showSum is call
showSum in main
showSum invokes showFloat
showSum argument value Float64 tenthsSum copy
showSum result none
showSum ownedBy none
showSum cleanedBy none
showSum borrows none
showSum catch none
showSum suppresses none

overflow is call
overflow in main
overflow invokes math.multiplyFloat64
overflow argument left Float64 largest copy
overflow argument right Float64 ten copy
overflow result infinity Float64
overflow ownedBy none
overflow cleanedBy none
overflow borrows none
overflow catch none
overflow suppresses none

showInfinity is call
showInfinity in main
showInfinity invokes showFloat
showInfinity argument value Float64 infinity copy
showInfinity result none
showInfinity ownedBy none
showInfinity cleanedBy none
showInfinity borrows none
showInfinity catch none
showInfinity suppresses none

makeNan is call
makeNan in main
makeNan invokes math.divideFloat64
makeNan argument left Float64 zero copy
makeNan argument right Float64 zero copy
makeNan result notANumber Float64
makeNan ownedBy none
makeNan cleanedBy none
makeNan borrows none
makeNan catch none
makeNan suppresses none

nanSelf is call
nanSelf in main
nanSelf invokes compare.equalFloat64
nanSelf argument left Float64 notANumber copy
nanSelf argument right Float64 notANumber copy
nanSelf result nanEqual Bool
nanSelf ownedBy none
nanSelf cleanedBy none
nanSelf borrows none
nanSelf catch none
nanSelf suppresses none

showNanEqual is call
showNanEqual in main
showNanEqual invokes showBool
showNanEqual argument flag Bool nanEqual copy
showNanEqual result none
showNanEqual ownedBy none
showNanEqual cleanedBy none
showNanEqual borrows none
showNanEqual catch none
showNanEqual suppresses none

infinityBig is call
infinityBig in main
infinityBig invokes compare.greaterThanFloat64
infinityBig argument left Float64 infinity copy
infinityBig argument right Float64 largest copy
infinityBig result infinityIsBigger Bool
infinityBig ownedBy none
infinityBig cleanedBy none
infinityBig borrows none
infinityBig catch none
infinityBig suppresses none

showInfinityBig is call
showInfinityBig in main
showInfinityBig invokes showBool
showInfinityBig argument flag Bool infinityIsBigger copy
showInfinityBig result none
showInfinityBig ownedBy none
showInfinityBig cleanedBy none
showInfinityBig borrows none
showInfinityBig catch none
showInfinityBig suppresses none

showLargest is call
showLargest in main
showLargest invokes showFloat
showLargest argument value Float64 largest copy
showLargest result none
showLargest ownedBy none
showLargest cleanedBy none
showLargest borrows none
showLargest catch none
showLargest suppresses none
