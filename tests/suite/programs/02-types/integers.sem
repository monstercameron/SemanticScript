# covers: 2 Signed integers (8/16/32/64-bit)
# covers: 2 Unsigned integers
# covers: 2 Type conversions
# covers: 22 Maximum integer values
# covers: 22 Minimum integer values
# covers: 14 Explicit conversions
# covers: 2 Characters
# kind: edge
# expect: run
# exit: 0
# stdout: 9223372036854775807
# stdout: -9223372036854775808
# stdout: 2147483647
# stdout: 255
# stdout: 65
# stdout: -128

integers is module
integers purpose "Show the integer widths, their limits, and checked conversions"
integers path integers
integers imports standard.console
integers imports standard.convert
integers exports main

stdoutWriter is capability
stdoutWriter purpose "Authority to write lines to standard output"
stdoutWriter grants write console.stdout
stdoutWriter scope none

showInt is operation
showInt purpose "Print one whole number on its own line"
showInt invariant none
showInt typeParam none
showInt input value Int64 value
showInt output none
showInt outputOwner none
showInt raises none
showInt effect write console.stdout
showInt uses stdoutWriter
showInt memory heap false
showInt async false
showInt maxRecursion none
showInt label begin loopKind none
showInt label begin within none
showInt label done loopKind none
showInt label done within none
showInt at begin do writeValue
showInt at begin branch ifError writeValue goto done else goto done
showInt at done return ok none

writeValue is call
writeValue rationale "A test program has nowhere to report a failed write"
writeValue in showInt
writeValue invokes console.writeIntegerLine
writeValue arg value Int64 value copy
writeValue out none
writeValue ownedBy none
writeValue cleanedBy none
writeValue borrows none
writeValue catch writeError console.WriteError

main is operation
main purpose "Run the case and print what it computes"
main invariant none
main typeParam none
main input none
main output ExitCode
main outputOwner none
main raises none
main effect write console.stdout
main uses stdoutWriter
main memory heap false
main async false
main maxRecursion none
main label begin loopKind none
main label begin within none
main let maxValue immutable Int64 9223372036854775807
main let minValue immutable Int64 -9223372036854775808
main let max32 immutable Int32 2147483647
main let maxByte immutable Byte 255
main let letterA immutable Byte 65
main let small immutable Int64 -128
main let max8 immutable Int8 127
main let maxU8 immutable UInt8 255
main let maxU16 immutable UInt16 65535
main let maxU32 immutable UInt32 4294967295
main let maxU64 immutable UInt64 18446744073709551615
main let min16 immutable Int16 -32768
main let okCode immutable ExitCode 0
main at begin do showMax
main at begin do showMin
main at begin do widen32
main at begin do show32
main at begin do widenByte
main at begin do showByte
main at begin do widenLetter
main at begin do showLetter
main at begin do narrow
main at begin do widenNarrowed
main at begin do showNarrowed
main at begin return ok okCode

showMax is call
showMax in main
showMax invokes showInt
showMax arg value Int64 maxValue copy
showMax out none
showMax ownedBy none
showMax cleanedBy none
showMax borrows none
showMax catch none

showMin is call
showMin in main
showMin invokes showInt
showMin arg value Int64 minValue copy
showMin out none
showMin ownedBy none
showMin cleanedBy none
showMin borrows none
showMin catch none

widen32 is call
widen32 in main
widen32 invokes convert.int32ToInt64
widen32 arg value Int32 max32 copy
widen32 out wide32 Int64
widen32 ownedBy none
widen32 cleanedBy none
widen32 borrows none
widen32 catch none

show32 is call
show32 in main
show32 invokes showInt
show32 arg value Int64 wide32 copy
show32 out none
show32 ownedBy none
show32 cleanedBy none
show32 borrows none
show32 catch none

widenByte is call
widenByte in main
widenByte invokes convert.byteToInt64
widenByte arg value Byte maxByte copy
widenByte out wideByte Int64
widenByte ownedBy none
widenByte cleanedBy none
widenByte borrows none
widenByte catch none

showByte is call
