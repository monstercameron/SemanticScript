# covers: 13 Pure operation enforcement
# covers: 13 Effect inference
# covers: 13 Capability restriction
# covers: 13 Capability revocation
# covers: 13 Effect polymorphism
# covers: 13 Capability escalation prevention
# covers: 5 Pure functions
# covers: 5 Impure functions
# covers: 17 Capability isolation
# covers: 17 Sandboxing
# covers: 21 Declared effects match actual effects
# covers: 21 Required capabilities are present
# covers: 21 Unnecessary capabilities are rejected or reported
# kind: positive
# expect: run
# exit: 0
# stdout: 49

effects is module
effects purpose "Show that a pure helper needs nothing and a caller of an effectful helper declares its effect"
effects path effects
effects imports standard.console
effects imports standard.math
effects exports main

stdoutWriter is capability
stdoutWriter purpose "Authority to write lines to standard output"
stdoutWriter grants write console.stdout
stdoutWriter scope none

showInt is operation
showInt purpose "Print one whole number on its own line"
showInt invariant none
showInt typeParam none
showInt input value Int64 value
showInt output none
showInt outputOwner none
showInt raises none
showInt effect write console.stdout
showInt uses stdoutWriter
showInt memory heap false
showInt async false
showInt maxRecursion none
showInt label begin loopKind none
showInt label begin within none
showInt label done loopKind none
showInt label done within none
showInt at begin do writeValue
showInt at begin branch ifError writeValue goto done else goto done
showInt at done return ok none

writeValue is call
writeValue rationale "A test program has nowhere to report a failed write"
writeValue in showInt
writeValue invokes console.writeIntegerLine
writeValue arg value Int64 value copy
writeValue out none
writeValue ownedBy none
writeValue cleanedBy none
writeValue borrows none
writeValue catch writeError console.WriteError

square is operation
square purpose "Return a number times itself; touches nothing outside"
square invariant none
square typeParam none
square input value Int64 value
square output Int64
square outputOwner none
square raises none
square effect none
square uses none
square memory heap false
square async false
square maxRecursion none
square label begin loopKind none
square label begin within none
square at begin do multiply
square at begin return ok squared

multiply is call
multiply in square
multiply invokes math.multiplyInt64
multiply arg left Int64 value copy
multiply arg right Int64 value copy
multiply out squared Int64
multiply ownedBy none
multiply cleanedBy none
multiply borrows none
multiply catch none

report is operation
report purpose "Print the square of a number; inherits the write effect from showInt"
report invariant none
report typeParam none
report input value Int64 value
report output none
report outputOwner none
report raises none
report effect write console.stdout
report uses stdoutWriter
report memory heap false
report async false
report maxRecursion none
report label begin loopKind none
report label begin within none
report at begin do squareIt
report at begin do showIt
report at begin return ok none

squareIt is call
squareIt in report
squareIt invokes square
squareIt arg value Int64 value copy
squareIt out squaredValue Int64
squareIt ownedBy none
squareIt cleanedBy none
squareIt borrows none
squareIt catch none

showIt is call
showIt in report
showIt invokes showInt
showIt arg value Int64 squaredValue copy
showIt out none
showIt ownedBy none
showIt cleanedBy none
showIt borrows none
showIt catch none

main is operation
main purpose "Run the case and print what it computes"
main invariant none
main typeParam none
main input none
main output ExitCode
main outputOwner none
main raises none
main effect write console.stdout
main uses stdoutWriter
main memory heap false
main async false
main maxRecursion none
main label begin loopKind none
main label begin within none
main let seven immutable Int64 7
main let okCode immutable ExitCode 0
main at begin do reportSeven
main at begin return ok okCode

reportSeven is call
reportSeven in main
reportSeven invokes report
reportSeven arg value Int64 seven copy
reportSeven out none
reportSeven ownedBy none
reportSeven cleanedBy none
reportSeven borrows none
reportSeven catch none
