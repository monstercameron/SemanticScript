# covers: 7 Ownership
# covers: 7 Ownership transfer
# covers: 7 Resource cleanup
# covers: 7 Double-free prevention
# covers: 7 Use-after-free prevention
# covers: 7 Memory leak detection
# covers: 7 Deterministic destruction
# covers: 10 Cleanup after errors
# covers: 10 Errors during resource cleanup
# covers: 13 File-system capability enforcement
# covers: 13 Capability scoping
# covers: 21 Ownership constraints are enforced
# covers: 21 Cleanup obligations are enforced
# covers: 12 File-not-found handling
# kind: positive
# expect: run
# exit: 0
# stdout: true
# stdout: notFound

resources is module
resources purpose "Write two files, release one by a deferred cleanup and give the other away, then read a missing file"
resources path resources
resources imports standard.console
resources imports standard.fs
resources imports standard.string
resources imports standard.time
resources exports main

stdoutWriter is capability
stdoutWriter purpose "Authority to write lines to standard output"
stdoutWriter grants write console.stdout none

showBool is operation
showBool purpose "Print true or false on its own line"
showBool invariant none
showBool typeParameter none
showBool input flag Bool copied
showBool output none
showBool outputOwnedBy none
showBool raises none
showBool effect write console.stdout
showBool uses stdoutWriter
showBool memoryHeap false
showBool async false
showBool maxRecursion none
showBool label begin loopKind none
showBool label begin within none
showBool label sayTrue loopKind none
showBool label sayTrue within none
showBool label sayFalse loopKind none
showBool label sayFalse within none
showBool label done loopKind none
showBool label done within none
showBool let trueText String "true" immutable
showBool let falseText String "false" immutable
showBool at begin branch if flag goto sayTrue else goto sayFalse
showBool at sayTrue do writeTrue
showBool at sayTrue branch ifError writeTrue goto done else goto done
showBool at sayFalse do writeFalse
showBool at sayFalse branch ifError writeFalse goto done else goto done
showBool at done return ok none

writeTrue is call
writeTrue rationale "A test program has nowhere to report a failed write"
writeTrue in showBool
writeTrue invokes console.writeLine
writeTrue argument text String trueText lend
writeTrue result none
writeTrue ownedBy none
writeTrue cleanedBy none
writeTrue borrows none
writeTrue catch trueError console.WriteError

writeFalse is call
writeFalse rationale "A test program has nowhere to report a failed write"
writeFalse in showBool
writeFalse invokes console.writeLine
writeFalse argument text String falseText lend
writeFalse result none
writeFalse ownedBy none
writeFalse cleanedBy none
writeFalse borrows none
writeFalse catch falseError console.WriteError

showText is operation
showText purpose "Print one line of text"
showText invariant none
showText typeParameter none
showText input text String borrowed
showText output none
showText outputOwnedBy none
showText raises none
showText effect write console.stdout
showText uses stdoutWriter
showText memoryHeap false
showText async false
showText maxRecursion none
showText label begin loopKind none
showText label begin within none
showText label done loopKind none
showText label done within none
showText let none
showText at begin do writeValue
showText at begin branch ifError writeValue goto done else goto done
showText at done return ok none

writeValue is call
writeValue rationale "A test program has nowhere to report a failed write"
writeValue in showText
writeValue invokes console.writeLine
writeValue argument text String text lend
writeValue result none
writeValue ownedBy none
writeValue cleanedBy none
writeValue borrows none
writeValue catch writeError console.WriteError

fileAccess is capability
fileAccess purpose "Authority to read and write files whose names start with suite-"
fileAccess grants read fs.files "suite-*"
fileAccess grants write fs.files "suite-*"

closeFor is operation
closeFor purpose "Take ownership of an open file and close it, reporting whether closing worked"
closeFor invariant none
closeFor typeParameter none
closeFor input file fs.FileHandle owned
closeFor output Bool
closeFor outputOwnedBy none
closeFor raises none
closeFor effect none
closeFor uses none
closeFor memoryHeap false
closeFor async false
closeFor maxRecursion none
closeFor label begin loopKind none
closeFor label begin within none
closeFor label closed loopKind none
closeFor label closed within none
closeFor label failed loopKind none
closeFor label failed within none
closeFor let closedFlag Bool true immutable
closeFor let failedFlag Bool false immutable
closeFor at begin do closeIt
closeFor at begin branch ifError closeIt goto failed else goto closed
closeFor at closed return ok closedFlag
closeFor at failed return ok failedFlag

closeIt is call
closeIt in closeFor
closeIt invokes fs.close
closeIt argument file fs.FileHandle file give
closeIt result none
closeIt ownedBy none
closeIt cleanedBy none
closeIt borrows none
closeIt catch closeError fs.FileError

main is operation
main purpose "Run the case and print what it computes"
main invariant none
main typeParameter none
main input none
main output ExitCode
main outputOwnedBy none
main raises none
main effect read fs.files
main effect write console.stdout
main effect write fs.files
main uses fileAccess
main uses stdoutWriter
main memoryHeap true
main async true
main maxRecursion none
main label begin loopKind none
main label begin within none
main label writeTwo loopKind none
main label writeTwo within none
main label openOne loopKind none
main label openOne within none
main label opened loopKind none
main label opened within none
main label handOff loopKind none
main label handOff within none
main label missing loopKind none
main label missing within none
main label reportMissing loopKind none
main label reportMissing within none
main label failed loopKind none
main label failed within none
main let firstPath String "suite-first.txt" immutable
main let secondPath String "suite-second.txt" immutable
main let missingPath String "suite-missing.txt" immutable
main let content String "data" immutable
main let notFoundText String "notFound" immutable
main let waitMs Int64 5000 immutable
main let limit Int64 64 immutable
main let okCode ExitCode 0 immutable
main let failCode ExitCode 1 immutable
main at begin do makeDeadline
main at begin do toBytes
main at begin start writeFirst into none
main at begin join writeFirst
main at begin branch ifError writeFirst goto failed else goto writeTwo
main at writeTwo start writeSecond into none
main at writeTwo join writeSecond
main at writeTwo branch ifError writeSecond goto failed else goto openOne
main at openOne do openFirst
main at openOne branch ifError openFirst goto failed else goto opened
main at opened defer closeFirstCleanup
main at opened do openSecond
main at opened branch ifError openSecond goto failed else goto handOff
main at handOff do giveSecond
main at handOff do showClosed
main at handOff start readMissing into none
main at handOff join readMissing
main at handOff branch ifError readMissing goto missing else goto failed
main at missing match missingError fs.FileError
main at missing case fs.FileError.notFound bind none none goto reportMissing
main at missing case fs.FileError.denied bind none none goto failed
main at missing case fs.FileError.exists bind none none goto failed
main at missing case fs.FileError.tooLarge bind none none goto failed
main at missing case fs.FileError.timedOut bind none none goto failed
main at missing case fs.FileError.cancelled bind none none goto failed
main at missing case fs.FileError.failed bind code Int32 goto failed
main at reportMissing do showNotFound
main at reportMissing return ok okCode
main at failed return ok failCode

scratch is region
scratch in main
scratch strategy arena
scratch maxBytes 65536
scratch released atReturn

makeDeadline is call
makeDeadline in main
makeDeadline invokes time.Deadline.after
makeDeadline argument milliseconds Int64 waitMs copy
makeDeadline result deadline time.Deadline
makeDeadline ownedBy none
makeDeadline cleanedBy none
makeDeadline borrows none
makeDeadline catch none

toBytes is call
toBytes in main
toBytes invokes string.toBytes
toBytes argument text String content lend
toBytes result contentBytes Bytes
toBytes ownedBy none
toBytes cleanedBy none
toBytes borrows content
toBytes catch none

writeFirst is task
writeFirst in main
writeFirst invokes fs.writeAll
writeFirst argument path String firstPath lend
writeFirst argument bytes Bytes contentBytes lend
writeFirst argument deadline time.Deadline deadline copy
writeFirst result none
writeFirst ownedBy none
writeFirst cleanedBy none
writeFirst borrows none
writeFirst catch writeFirstError fs.FileError

writeSecond is task
writeSecond in main
writeSecond invokes fs.writeAll
writeSecond argument path String secondPath lend
writeSecond argument bytes Bytes contentBytes lend
writeSecond argument deadline time.Deadline deadline copy
writeSecond result none
writeSecond ownedBy none
writeSecond cleanedBy none
writeSecond borrows none
writeSecond catch writeSecondError fs.FileError

openFirst is call
openFirst in main
openFirst invokes fs.openRead
openFirst argument path String firstPath lend
openFirst result first fs.FileHandle
openFirst ownedBy main
openFirst cleanedBy closeFirstCleanup
openFirst borrows none
openFirst catch firstError fs.FileError

closeFirstCleanup is cleanup
closeFirstCleanup rationale "A failed close at exit has nobody to report to"
closeFirstCleanup in main
closeFirstCleanup runs closeFirst
closeFirstCleanup cleans first
closeFirstCleanup onError suppress

closeFirst is call
closeFirst in main
closeFirst invokes fs.close
closeFirst argument file fs.FileHandle first give
closeFirst result none
closeFirst ownedBy none
closeFirst cleanedBy none
closeFirst borrows none
closeFirst catch closeFirstError fs.FileError

openSecond is call
openSecond in main
openSecond invokes fs.openRead
openSecond argument path String secondPath lend
openSecond result second fs.FileHandle
openSecond ownedBy main
openSecond cleanedBy none
openSecond borrows none
openSecond catch secondError fs.FileError

giveSecond is call
giveSecond in main
giveSecond invokes closeFor
giveSecond argument file fs.FileHandle second give
giveSecond result closedWell Bool
giveSecond ownedBy none
giveSecond cleanedBy none
giveSecond borrows none
giveSecond catch none

showClosed is call
showClosed in main
showClosed invokes showBool
showClosed argument flag Bool closedWell copy
showClosed result none
showClosed ownedBy none
showClosed cleanedBy none
showClosed borrows none
showClosed catch none

readMissing is task
readMissing in main
readMissing invokes fs.readAll
readMissing argument path String missingPath lend
readMissing argument region Region scratch lend
readMissing argument maxBytes Int64 limit copy
readMissing argument deadline time.Deadline deadline copy
readMissing result missingBytes Bytes
readMissing ownedBy scratch
readMissing cleanedBy none
readMissing borrows none
readMissing catch missingError fs.FileError

showNotFound is call
showNotFound in main
showNotFound invokes showText
showNotFound argument text String notFoundText lend
showNotFound result none
showNotFound ownedBy none
showNotFound cleanedBy none
showNotFound borrows none
showNotFound catch none
