# covers: 10 Stack traces
# covers: 20 Stack inspection
# covers: 16 Runtime error handling
# kind: edge
# expect: trap in stackTrace.middle (stackTrace.sem:

stackTrace is module
stackTrace purpose "Trap three calls deep so the trap prints the operations it passed through"
stackTrace path stackTrace
stackTrace imports standard.math
stackTrace exports main

inner is operation
inner purpose "Divide by zero"
inner invariant none
inner typeParameter none
inner input none
inner output Int64
inner outputOwnedBy none
inner raises none
inner effect none
inner uses none
inner memoryHeap false
inner async false
inner maxRecursion none
inner label begin loopKind none
inner label begin within none
inner let one Int64 1 immutable
inner let zero Int64 0 immutable
inner at begin do divide
inner at begin return ok quotient

divide is call
divide in inner
divide invokes math.divideInt64
divide argument left Int64 one copy
divide argument right Int64 zero copy
divide result quotient Int64
divide ownedBy none
divide cleanedBy none
divide borrows none
divide catch none
divide suppresses none

middle is operation
middle purpose "Call inner"
middle invariant none
middle typeParameter none
middle input none
middle output Int64
middle outputOwnedBy none
middle raises none
middle effect none
middle uses none
middle memoryHeap false
middle async false
middle maxRecursion none
middle label begin loopKind none
middle label begin within none
middle let none
middle at begin do callInner
middle at begin return ok value

callInner is call
callInner in middle
callInner invokes inner
callInner argument none
callInner result value Int64
callInner ownedBy none
callInner cleanedBy none
callInner borrows none
callInner catch none
callInner suppresses none

outer is operation
outer purpose "Call middle"
outer invariant none
outer typeParameter none
outer input none
outer output Int64
outer outputOwnedBy none
outer raises none
outer effect none
outer uses none
outer memoryHeap false
outer async false
outer maxRecursion none
outer label begin loopKind none
outer label begin within none
outer let none
outer at begin do callMiddle
outer at begin return ok value

callMiddle is call
callMiddle in outer
callMiddle invokes middle
callMiddle argument none
callMiddle result value Int64
callMiddle ownedBy none
callMiddle cleanedBy none
callMiddle borrows none
callMiddle catch none
callMiddle suppresses none

main is operation
main purpose "Run the case and print what it computes"
main invariant none
main typeParameter none
main input none
main output ExitCode
main outputOwnedBy none
main raises none
main effect none
main uses none
main memoryHeap false
main async false
main maxRecursion none
main label begin loopKind none
main label begin within none
main let okCode ExitCode 0 immutable
main let failCode ExitCode 1 immutable
main at begin do callOuter
main at begin return ok okCode

callOuter is call
callOuter in main
callOuter invokes outer
callOuter argument none
callOuter result result Int64
callOuter ownedBy none
callOuter cleanedBy none
callOuter borrows none
callOuter catch none
callOuter suppresses none
