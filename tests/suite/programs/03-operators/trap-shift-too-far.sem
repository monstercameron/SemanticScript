# covers: 3 Bit shifting
# kind: edge
# expect: trap shift amount outside

shiftTooFar is module
shiftTooFar purpose "Trap: shift too far"
shiftTooFar path shiftTooFar
shiftTooFar imports standard.bits
shiftTooFar exports main

main is operation
main purpose "Run the case and print what it computes"
main invariant none
main typeParameter none
main input none
main output ExitCode
main outputOwnedBy none
main raises none
main effect none
main uses none
main memoryHeap false
main async false
main maxRecursion none
main label begin loopKind none
main label begin within none
main let one Int64 1 immutable
main let sixtyFour Int64 64 immutable
main let okCode ExitCode 0 immutable
main at begin do compute
main at begin return ok okCode

compute is call
compute in main
compute invokes bits.shiftLeftInt64
compute argument value Int64 one copy
compute argument amount Int64 sixtyFour copy
compute result result Int64
compute ownedBy none
compute cleanedBy none
compute borrows none
compute catch none
compute suppresses none
