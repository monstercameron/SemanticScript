# covers: 3 Division by zero
# kind: edge
# expect: trap divided by zero

divideByZero is module
divideByZero purpose "Trap: divide by zero"
divideByZero path divideByZero
divideByZero imports standard.math
divideByZero exports main

main is operation
main purpose "Run the case and print what it computes"
main invariant none
main typeParameter none
main input none
main output ExitCode
main outputOwnedBy none
main raises none
main effect none
main uses none
main memoryHeap false
main async false
main maxRecursion none
main label begin loopKind none
main label begin within none
main let one Int64 1 immutable
main let zero Int64 0 immutable
main let okCode ExitCode 0 immutable
main at begin do compute
main at begin return ok okCode

compute is call
compute in main
compute invokes math.divideInt64
compute argument left Int64 one copy
compute argument right Int64 zero copy
compute result result Int64
compute ownedBy none
compute cleanedBy none
compute borrows none
compute catch none
