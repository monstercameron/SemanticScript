# covers: 3 Integer overflow
# covers: 17 Integer overflow protection
# kind: edge
# expect: trap overflowed `Int64`

addOverflow is module
addOverflow purpose "Trap: add overflow"
addOverflow path addOverflow
addOverflow imports standard.math
addOverflow exports main

main is operation
main purpose "Run the case and print what it computes"
main invariant none
main typeParam none
main input none
main output ExitCode
main outputOwner none
main raises none
main effect none
main uses none
main memory heap false
main async false
main maxRecursion none
main label begin loopKind none
main label begin within none
main let one immutable Int64 1
main let big immutable Int64 9223372036854775807
main let okCode immutable ExitCode 0
main at begin do compute
main at begin return ok okCode

compute is call
compute in main
compute invokes math.addInt64
compute arg left Int64 big copy
compute arg right Int64 one copy
compute out result Int64
compute ownedBy none
compute cleanedBy none
compute borrows none
