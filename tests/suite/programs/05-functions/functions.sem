functions is module
functions purpose "Show parameters, results, operation references, and passing by value and by loan"
functions path functions
functions imports standard.console
functions imports standard.math
functions imports standard.list
functions exports main

stdoutWriter is capability
stdoutWriter purpose "Authority to write lines to standard output"
stdoutWriter grants write console.stdout none

showInt is operation
showInt purpose "Print one whole number on its own line"
showInt invariant none
showInt typeParameter none
showInt input value Int64 copied
showInt output none
showInt outputOwnedBy none
showInt raises none
showInt effect write console.stdout
showInt uses stdoutWriter
showInt memoryHeap false
showInt async false
showInt maxRecursion none
showInt label begin loopKind none
showInt label begin within none
showInt label done loopKind none
showInt label done within none
showInt let none
showInt at begin do writeValue
showInt at begin branch ifError writeValue goto done else goto done
showInt at done return ok none

writeValue is call
writeValue rationale "A test program has nowhere to report a failed write"
writeValue in showInt
writeValue invokes console.writeIntegerLine
writeValue argument value Int64 value copy
writeValue result none
writeValue ownedBy none
writeValue cleanedBy none
writeValue borrows none
writeValue catch writeError console.WriteError

IntStep is operationType
IntStep purpose "One step that turns a whole number into another"
IntStep typeParameter none
IntStep input value Int64 copied
IntStep output Int64
IntStep outputOwnedBy none
IntStep raises none
IntStep effect none
IntStep async false

Numbers is typeInstance
Numbers purpose "A growable list of whole numbers"
Numbers instantiates list.List Int64

double is operation
double purpose "Multiply by two"
double invariant none
double typeParameter none
double input value Int64 copied
double output Int64
double outputOwnedBy none
double raises none
double effect none
double uses none
double memoryHeap false
double async false
double maxRecursion none
double label begin loopKind none
double label begin within none
double let two Int64 2 immutable
double at begin do scale
double at begin return ok scaled

scale is call
scale in double
scale invokes math.multiplyInt64
scale argument left Int64 value copy
scale argument right Int64 two copy
scale result scaled Int64
scale ownedBy none
scale cleanedBy none
scale borrows none
scale catch none

triple is operation
triple purpose "Multiply by three"
triple invariant none
triple typeParameter none
triple input value Int64 copied
triple output Int64
triple outputOwnedBy none
triple raises none
triple effect none
triple uses none
triple memoryHeap false
triple async false
triple maxRecursion none
triple label begin loopKind none
triple label begin within none
triple let three Int64 3 immutable
triple at begin do scale
triple at begin return ok scaled

scale is call
scale in triple
scale invokes math.multiplyInt64
scale argument left Int64 value copy
scale argument right Int64 three copy
scale result scaled Int64
scale ownedBy none
scale cleanedBy none
scale borrows none
scale catch none

applyTwice is operation
applyTwice purpose "Apply a step to a value, then apply it again to the result"
applyTwice invariant none
applyTwice typeParameter none
applyTwice input step IntStep copied
applyTwice input value Int64 copied
applyTwice output Int64
applyTwice outputOwnedBy none
applyTwice raises none
applyTwice effect none
applyTwice uses none
applyTwice memoryHeap false
applyTwice async false
applyTwice maxRecursion none
applyTwice label begin loopKind none
applyTwice label begin within none
applyTwice let none
applyTwice at begin do first
applyTwice at begin do second
applyTwice at begin return ok twice

first is call
first in applyTwice
first invokesReference step
first argument value Int64 value copy
first result once Int64
first ownedBy none
first cleanedBy none
first borrows none
first catch none

second is call
second in applyTwice
second invokesReference step
second argument value Int64 once copy
second result twice Int64
second ownedBy none
second cleanedBy none
second borrows none
second catch none

appendThree is operation
appendThree purpose "Change a list the caller lends exclusively by appending three numbers"
appendThree invariant none
appendThree typeParameter none
appendThree input numbers Numbers borrowedMutable
appendThree output none
appendThree outputOwnedBy none
appendThree raises none
appendThree effect none
appendThree uses none
appendThree memoryHeap false
appendThree async false
appendThree maxRecursion none
appendThree label begin loopKind none
appendThree label begin within none
appendThree let one Int64 1 immutable
appendThree let two Int64 2 immutable
appendThree let three Int64 3 immutable
appendThree at begin do appendOne
appendThree at begin do appendTwo
appendThree at begin do appendLast
appendThree at begin return ok none

appendOne is call
appendOne in appendThree
appendOne invokes Numbers.append
appendOne argument list Numbers numbers lendMutable
appendOne argument item Int64 one copy
appendOne result none
appendOne ownedBy none
appendOne cleanedBy none
appendOne borrows none
appendOne catch none

appendTwo is call
appendTwo in appendThree
appendTwo invokes Numbers.append
appendTwo argument list Numbers numbers lendMutable
appendTwo argument item Int64 two copy
appendTwo result none
appendTwo ownedBy none
appendTwo cleanedBy none
appendTwo borrows none
appendTwo catch none

appendLast is call
appendLast in appendThree
appendLast invokes Numbers.append
appendLast argument list Numbers numbers lendMutable
appendLast argument item Int64 three copy
appendLast result none
appendLast ownedBy none
appendLast cleanedBy none
appendLast borrows none
appendLast catch none

main is operation
main purpose "Run the case and print what it computes"
main invariant none
main typeParameter none
main input none
main output ExitCode
main outputOwnedBy none
main raises none
main effect write console.stdout
main uses stdoutWriter
main memoryHeap true
main async false
main maxRecursion none
main label begin loopKind none
main label begin within none
main let three Int64 3 immutable
main let doubleStep IntStep double immutable
main let tripleStep IntStep triple immutable
main let one Int64 1 immutable
main let okCode ExitCode 0 immutable
main at begin do twiceDoubled
main at begin do showDoubled
main at begin do twiceTripled
main at begin do showTripled
main at begin do makeNumbers
main at begin do fill
main at begin do countNumbers
main at begin do showCount
main at begin do doubleThenTriple
main at begin do showComposed
main at begin return ok okCode

scratch is region
scratch in main
scratch strategy arena
scratch maxBytes 4096
scratch released atReturn

twiceDoubled is call
twiceDoubled in main
twiceDoubled invokes applyTwice
twiceDoubled argument step IntStep doubleStep copy
twiceDoubled argument value Int64 three copy
twiceDoubled result doubled Int64
twiceDoubled ownedBy none
twiceDoubled cleanedBy none
twiceDoubled borrows none
twiceDoubled catch none

