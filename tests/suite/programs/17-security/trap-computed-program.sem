# covers: 13 Capability escalation prevention
# covers: 17 Privilege separation
# covers: 13 Resource access permissions
# kind: negative
# expect: trap which no capability this operation uses allows

programEscape is module
programEscape purpose "Trap: a program name built at run time that no capability allows"
programEscape path programEscape
programEscape imports standard.process
programEscape imports standard.string
programEscape imports standard.time
programEscape exports main

gitRunner is capability
gitRunner purpose "Authority to run git and nothing else"
gitRunner grants spawn process.programs
gitRunner scope "git"

main is operation
main purpose "Run the case and print what it computes"
main invariant none
main typeParam none
main input none
main output ExitCode
main outputOwner none
main raises none
main effect spawn process.programs
main uses gitRunner
main memory heap true
main async true
main maxRecursion none
main label begin loopKind none
main label begin within none
main label done loopKind none
main label done within none
main label failed loopKind none
main label failed within none
main let firstPart immutable String "gi"
main let secondPart immutable String "tk"
main let waitMs immutable Int64 5000
main let okCode immutable ExitCode 0
main let failCode immutable ExitCode 1
main at begin do makeDeadline
main at begin do joinName
main at begin do newArguments
main at begin start runIt
main at begin join runIt
main at begin branch ifError runIt goto failed else goto done
main at done return ok okCode
main at failed return ok failCode

text is region
text in main
text strategy arena
text capacity 4096
text released atReturn

makeDeadline is call
makeDeadline in main
makeDeadline invokes time.Deadline.after
makeDeadline arg milliseconds Int64 waitMs copy
makeDeadline out deadline time.Deadline
makeDeadline ownedBy none
makeDeadline cleanedBy none
makeDeadline borrows none
makeDeadline catch none

joinName is call
joinName in main
joinName invokes string.concat
joinName arg left String firstPart lend
joinName arg right String secondPart lend
joinName arg region Region text lend
joinName out program String
joinName ownedBy text
joinName cleanedBy none
joinName borrows none
joinName catch none

newArguments is call
newArguments in main
newArguments invokes process.newArguments
newArguments arg region Region text lend
newArguments out arguments process.Arguments
newArguments ownedBy text
newArguments cleanedBy none
newArguments borrows none
newArguments catch none

runIt is task
runIt in main
runIt invokes process.run
runIt arg program String program lend
runIt arg arguments process.Arguments arguments lend
runIt arg deadline time.Deadline deadline copy
runIt out status ExitCode
runIt ownedBy none
runIt cleanedBy none
runIt borrows none
runIt catch runError process.RunError
