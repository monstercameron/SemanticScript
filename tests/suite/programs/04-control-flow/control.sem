# covers: 4 If / Else
# covers: 4 Else-if chains
# covers: 4 Nested conditionals
# covers: 4 While loops
# covers: 4 For loops
# covers: 4 Do-while loops
# covers: 4 Infinite loops
# covers: 4 Nested loops
# covers: 4 Break
# covers: 4 Continue
# covers: 4 Early return
# covers: 4 Labels
# covers: 4 Goto / Branching
# covers: 4 Loop termination
# covers: 21 Branch targets exist
# covers: 21 Every label exists
# kind: positive
# expect: run
# exit: 0
# stdout: 2
# stdout: 15
# stdout: 9
# stdout: 1
# stdout: 25
# stdout: 12
# stdout: 4
# stdout: 64

control is module
control purpose "Show conditionals, every loop kind, and leaving or skipping inside loops"
control path control
control imports standard.console
control imports standard.math
control imports standard.compare
control exports main

stdoutWriter is capability
stdoutWriter purpose "Authority to write lines to standard output"
stdoutWriter grants write console.stdout none

showInt is operation
showInt purpose "Print one whole number on its own line"
showInt invariant none
showInt typeParameter none
showInt input value Int64 copied
showInt output none
showInt outputOwnedBy none
showInt raises none
showInt effect write console.stdout
showInt uses stdoutWriter
showInt memoryHeap false
showInt async false
showInt maxRecursion none
showInt label begin loopKind none
showInt label begin within none
showInt label done loopKind none
showInt label done within none
showInt let none
showInt at begin do writeValue
showInt at begin branch ifError writeValue goto done else goto done
showInt at done return ok none

writeValue is call
writeValue rationale "A test program has nowhere to report a failed write"
writeValue in showInt
writeValue invokes console.writeIntegerLine
writeValue argument value Int64 value copy
writeValue result none
writeValue ownedBy none
writeValue cleanedBy none
writeValue borrows none
writeValue catch writeError console.WriteError

grade is operation
grade purpose "Return 1 below 10, 2 below 20, and 3 otherwise"
grade invariant none
grade typeParameter none
grade input score Int64 copied
grade output Int64
grade outputOwnedBy none
grade raises none
grade effect none
grade uses none
grade memoryHeap false
grade async false
grade maxRecursion none
grade label begin loopKind none
grade label begin within none
grade label low loopKind none
grade label low within none
grade label notLow loopKind none
grade label notLow within none
grade label middle loopKind none
grade label middle within none
grade label high loopKind none
grade label high within none
grade let one Int64 1 immutable
grade let two Int64 2 immutable
grade let three Int64 3 immutable
grade let ten Int64 10 immutable
grade let twenty Int64 20 immutable
grade at begin do belowTen
grade at begin branch if isBelowTen goto low else goto notLow
grade at low return ok one
grade at notLow do belowTwenty
grade at notLow branch if isBelowTwenty goto middle else goto high
grade at middle return ok two
grade at high return ok three

