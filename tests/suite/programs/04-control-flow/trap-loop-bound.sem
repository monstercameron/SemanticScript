# covers: 4 Loop termination
# covers: 16 Execution time limits
# covers: 21 Invalid operation graphs are rejected
# covers: 22 Infinite loops
# kind: edge
# expect: trap more than maxIterations 3 times

runawayLoop is module
runawayLoop purpose "Trap: a while loop that would pass its stated bound"
runawayLoop path runawayLoop
runawayLoop imports standard.compare
runawayLoop imports standard.math
runawayLoop exports main

main is operation
main purpose "Run the case and print what it computes"
main invariant none
main typeParameter none
main input none
main output ExitCode
main outputOwnedBy none
main raises none
main effect none
main uses none
main memoryHeap false
main async false
main maxRecursion none
main label begin loopKind none
main label begin within none
main label spin loopKind while
main label spin within none
main label spin maxIterations 3
main label step loopKind none
main label step within spin
main label done loopKind none
main label done within none
main let one Int64 1 immutable
main let limit Int64 100 immutable
main let count Int64 0 mutable
main let okCode ExitCode 0 immutable
main at begin goto spin
main at spin do below
main at spin branch if isBelow goto step else goto done
main at step do addOne
main at step set count nextCount
main at step goto spin
main at done return ok okCode

below is call
below in main
below invokes compare.lessThanInt64
below argument left Int64 count copy
below argument right Int64 limit copy
below result isBelow Bool
below ownedBy none
below cleanedBy none
below borrows none
below catch none
below suppresses none

addOne is call
addOne in main
addOne invokes math.addInt64
addOne argument left Int64 count copy
addOne argument right Int64 one copy
addOne result nextCount Int64
addOne ownedBy none
addOne cleanedBy none
addOne borrows none
addOne catch none
addOne suppresses none
