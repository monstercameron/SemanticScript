# covers: 12 File writing
# covers: 12 File permissions
# covers: 13 Capability scoping
# kind: positive
# expect: run
# exit: 0
# stdout: exists
# stdout: true
# stdout: false

fileWriteCase is module
fileWriteCase purpose "Create a file, write through its handle, refuse to create it twice, then remove it"
fileWriteCase path fileWriteCase
fileWriteCase imports standard.console
fileWriteCase imports standard.fs
fileWriteCase imports standard.string
fileWriteCase imports standard.time
fileWriteCase exports main

stdoutWriter is capability
stdoutWriter purpose "Authority to write lines to standard output"
stdoutWriter grants write console.stdout none

showBool is operation
showBool purpose "Print true or false on its own line"
showBool invariant none
showBool typeParameter none
showBool input flag Bool copied
showBool output none
showBool outputOwnedBy none
showBool raises none
showBool effect write console.stdout
showBool uses stdoutWriter
showBool memoryHeap false
showBool async false
showBool maxRecursion none
showBool label begin loopKind none
showBool label begin within none
showBool label sayTrue loopKind none
showBool label sayTrue within none
showBool label sayFalse loopKind none
showBool label sayFalse within none
showBool label done loopKind none
showBool label done within none
showBool let trueText String "true" immutable
showBool let falseText String "false" immutable
showBool at begin branch if flag goto sayTrue else goto sayFalse
showBool at sayTrue do writeTrue
showBool at sayTrue branch ifError writeTrue goto done else goto done
showBool at sayFalse do writeFalse
showBool at sayFalse branch ifError writeFalse goto done else goto done
showBool at done return ok none

writeTrue is call
writeTrue rationale "A test program has nowhere to report a failed write"
writeTrue in showBool
writeTrue invokes console.writeLine
writeTrue argument text String trueText lend
writeTrue result none
writeTrue ownedBy none
writeTrue cleanedBy none
writeTrue borrows none
writeTrue catch trueError console.WriteError

writeFalse is call
writeFalse rationale "A test program has nowhere to report a failed write"
writeFalse in showBool
writeFalse invokes console.writeLine
writeFalse argument text String falseText lend
writeFalse result none
writeFalse ownedBy none
writeFalse cleanedBy none
writeFalse borrows none
writeFalse catch falseError console.WriteError

showText is operation
showText purpose "Print one line of text"
showText invariant none
showText typeParameter none
showText input text String borrowed
showText output none
showText outputOwnedBy none
showText raises none
showText effect write console.stdout
showText uses stdoutWriter
showText memoryHeap false
showText async false
showText maxRecursion none
showText label begin loopKind none
showText label begin within none
showText label done loopKind none
showText label done within none
showText let none
showText at begin do writeValue
showText at begin branch ifError writeValue goto done else goto done
showText at done return ok none

writeValue is call
writeValue rationale "A test program has nowhere to report a failed write"
writeValue in showText
writeValue invokes console.writeLine
writeValue argument text String text lend
writeValue result none
writeValue ownedBy none
writeValue cleanedBy none
writeValue borrows none
writeValue catch writeError console.WriteError

fileAccess is capability
fileAccess purpose "Authority to read and write files whose names start with suite-"
fileAccess grants read fs.files "suite-*"
fileAccess grants write fs.files "suite-*"

main is operation
main purpose "Run the case and print what it computes"
main invariant none
main typeParameter none
main input none
main output ExitCode
main outputOwnedBy none
main raises none
main effect read fs.files
main effect write console.stdout
main effect write fs.files
main uses fileAccess
main uses stdoutWriter
main memoryHeap false
main async true
main maxRecursion none
main label begin loopKind none
main label begin within none
main label created loopKind none
main label created within none
main label closeIt loopKind none
main label closeIt within none
main label closeAfterFailure loopKind none
main label closeAfterFailure within none
main label again loopKind none
main label again within none
main label closeSecond loopKind none
main label closeSecond within none
main label refused loopKind none
main label refused within none
main label reportExists loopKind none
main label reportExists within none
main label gone loopKind none
main label gone within none
main label failed loopKind none
main label failed within none
main let path String "suite-output.txt" immutable
main let content String "written" immutable
main let existsText String "exists" immutable
main let waitMs Int64 5000 immutable
main let okCode ExitCode 0 immutable
main let failCode ExitCode 1 immutable
main at begin do makeDeadline
main at begin do toBytes
main at begin do createIt
main at begin branch ifError createIt goto failed else goto created
main at created start writeIt into none
main at created join writeIt
main at created branch ifError writeIt goto closeAfterFailure else goto closeIt
main at closeIt do closeFile
main at closeIt branch ifError closeFile goto failed else goto again
main at closeAfterFailure do closeFailed
main at closeAfterFailure branch ifError closeFailed goto failed else goto failed
main at again do createAgain
main at again branch ifError createAgain goto refused else goto closeSecond
main at closeSecond do closeExtra
main at closeSecond branch ifError closeExtra goto failed else goto failed
main at refused match againError fs.FileError
main at refused case fs.FileError.notFound bind none none goto failed
main at refused case fs.FileError.denied bind none none goto failed
main at refused case fs.FileError.exists bind none none goto reportExists
main at refused case fs.FileError.tooLarge bind none none goto failed
main at refused case fs.FileError.timedOut bind none none goto failed
main at refused case fs.FileError.cancelled bind none none goto failed
main at refused case fs.FileError.failed bind code Int32 goto failed
main at reportExists do printExists
main at reportExists do checkThere
main at reportExists do printThere
main at reportExists do removeIt
main at reportExists branch ifError removeIt goto failed else goto gone
main at gone do checkGone
main at gone do printGone
main at gone return ok okCode
main at failed return ok failCode

makeDeadline is call
makeDeadline in main
makeDeadline invokes time.Deadline.after
makeDeadline argument milliseconds Int64 waitMs copy
makeDeadline result deadline time.Deadline
makeDeadline ownedBy none
makeDeadline cleanedBy none
makeDeadline borrows none
makeDeadline catch none

toBytes is call
toBytes in main
toBytes invokes string.toBytes
toBytes argument text String content lend
toBytes result contentBytes Bytes
toBytes ownedBy none
toBytes cleanedBy none
toBytes borrows content
toBytes catch none

createIt is call
createIt in main
createIt invokes fs.create
createIt argument path String path lend
createIt result file fs.FileHandle
createIt ownedBy main
createIt cleanedBy none
createIt borrows none
createIt catch createError fs.FileError

writeIt is task
writeIt in main
writeIt invokes fs.write
writeIt argument file fs.FileHandle file lendMutable
writeIt argument bytes Bytes contentBytes lend
writeIt argument deadline time.Deadline deadline copy
writeIt result none
writeIt ownedBy none
writeIt cleanedBy none
writeIt borrows none
writeIt catch writeError fs.FileError

closeFile is call
closeFile in main
closeFile invokes fs.close
closeFile argument file fs.FileHandle file give
closeFile result none
closeFile ownedBy none
closeFile cleanedBy none
closeFile borrows none
closeFile catch closeError fs.FileError

closeFailed is call
closeFailed rationale "The write already failed; the case fails either way"
closeFailed in main
closeFailed invokes fs.close
closeFailed argument file fs.FileHandle file give
closeFailed result none
closeFailed ownedBy none
closeFailed cleanedBy none
closeFailed borrows none
closeFailed catch closeFailedError fs.FileError

createAgain is call
createAgain in main
createAgain invokes fs.create
createAgain argument path String path lend
createAgain result extra fs.FileHandle
createAgain ownedBy main
createAgain cleanedBy none
createAgain borrows none
createAgain catch againError fs.FileError

closeExtra is call
closeExtra rationale "Creating the file twice should have failed; the case fails either way"
closeExtra in main
closeExtra invokes fs.close
closeExtra argument file fs.FileHandle extra give
closeExtra result none
closeExtra ownedBy none
closeExtra cleanedBy none
closeExtra borrows none
closeExtra catch closeExtraError fs.FileError

printExists is call
printExists in main
printExists invokes showText
printExists argument text String existsText lend
printExists result none
printExists ownedBy none
printExists cleanedBy none
printExists borrows none
printExists catch none

checkThere is call
checkThere in main
checkThere invokes fs.exists
checkThere argument path String path lend
checkThere result there Bool
checkThere ownedBy none
checkThere cleanedBy none
checkThere borrows none
checkThere catch none

printThere is call
printThere in main
printThere invokes showBool
printThere argument flag Bool there copy
printThere result none
printThere ownedBy none
printThere cleanedBy none
printThere borrows none
printThere catch none

removeIt is call
removeIt in main
removeIt invokes fs.remove
removeIt argument path String path lend
removeIt result none
removeIt ownedBy none
removeIt cleanedBy none
removeIt borrows none
removeIt catch removeError fs.FileError

checkGone is call
checkGone in main
checkGone invokes fs.exists
checkGone argument path String path lend
checkGone result stillThere Bool
checkGone ownedBy none
checkGone cleanedBy none
checkGone borrows none
checkGone catch none

printGone is call
printGone in main
printGone invokes showBool
printGone argument flag Bool stillThere copy
printGone result none
printGone ownedBy none
printGone cleanedBy none
printGone borrows none
printGone catch none
