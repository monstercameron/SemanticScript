# covers: 12 Command-line arguments
# covers: 13 Capability scoping
# kind: positive
# expect: run
# exit: 0
# stdout: 2
# stdout: alpha
# stdout: 5
# args: alpha beta

argumentsCase is module
argumentsCase purpose "Read the program's command-line arguments"
argumentsCase path argumentsCase
argumentsCase imports standard.console
argumentsCase imports standard.process
argumentsCase exports main

stdoutWriter is capability
stdoutWriter purpose "Authority to write lines to standard output"
stdoutWriter grants write console.stdout
stdoutWriter scope none

showInt is operation
showInt purpose "Print one whole number on its own line"
showInt invariant none
showInt typeParam none
showInt input value Int64 value
showInt output none
showInt outputOwner none
showInt raises none
showInt effect write console.stdout
showInt uses stdoutWriter
showInt memory heap false
showInt async false
showInt maxRecursion none
showInt label begin loopKind none
showInt label begin within none
showInt label done loopKind none
showInt label done within none
showInt at begin do writeValue
showInt at begin branch ifError writeValue goto done else goto done
showInt at done return ok none

writeValue is call
writeValue rationale "A test program has nowhere to report a failed write"
writeValue in showInt
writeValue invokes console.writeIntegerLine
writeValue arg value Int64 value copy
writeValue out none
writeValue ownedBy none
writeValue cleanedBy none
writeValue borrows none
writeValue catch writeError console.WriteError

showText is operation
showText purpose "Print one line of text"
showText invariant none
showText typeParam none
showText input text String borrowed
showText output none
showText outputOwner none
showText raises none
showText effect write console.stdout
showText uses stdoutWriter
showText memory heap false
showText async false
showText maxRecursion none
showText label begin loopKind none
showText label begin within none
showText label done loopKind none
showText label done within none
showText at begin do writeValue
showText at begin branch ifError writeValue goto done else goto done
showText at done return ok none

writeValue is call
writeValue rationale "A test program has nowhere to report a failed write"
writeValue in showText
writeValue invokes console.writeLine
writeValue arg text String text lend
writeValue out none
writeValue ownedBy none
writeValue cleanedBy none
writeValue borrows none
writeValue catch writeError console.WriteError

argumentReader is capability
argumentReader purpose "Authority to read the command-line arguments"
argumentReader grants read process.arguments
argumentReader scope none

main is operation
main purpose "Run the case and print what it computes"
main invariant none
main typeParam none
main input none
main output ExitCode
main outputOwner none
main raises none
main effect read process.arguments
main effect write console.stdout
main uses argumentReader
main uses stdoutWriter
main memory heap true
main async false
main maxRecursion none
main label begin loopKind none
main label begin within none
main label showFirstStep loopKind none
main label showFirstStep within none
main label outOfRange loopKind none
main label outOfRange within none
main label showBad loopKind none
main label showBad within none
main label failed loopKind none
main label failed within none
main let first immutable Int64 0
main let sixth immutable Int64 5
main let okCode immutable ExitCode 0
main let failCode immutable ExitCode 1
main at begin do countArguments
main at begin do showCount
main at begin do readFirst
main at begin branch ifError readFirst goto failed else goto showFirstStep
main at showFirstStep do showFirst
main at showFirstStep do readSixth
main at showFirstStep branch ifError readSixth goto outOfRange else goto failed
main at outOfRange match sixthError process.ArgumentError
main at outOfRange case process.ArgumentError.outOfRange bind badIndex Int64 goto showBad
main at showBad do printBad
main at showBad return ok okCode
main at failed return ok failCode

text is region
text in main
text strategy arena
text capacity 4096
text released atReturn

countArguments is call
countArguments in main
countArguments invokes process.argumentCount
countArguments arg none
countArguments out count Int64
countArguments ownedBy none
countArguments cleanedBy none
countArguments borrows none
countArguments catch none

showCount is call
showCount in main
showCount invokes showInt
showCount arg value Int64 count copy
showCount out none
showCount ownedBy none
showCount cleanedBy none
showCount borrows none
showCount catch none

readFirst is call
readFirst in main
readFirst invokes process.argument
readFirst arg index Int64 first copy
readFirst arg region Region text lend
readFirst out firstArgument String
readFirst ownedBy text
readFirst cleanedBy none
readFirst borrows none
readFirst catch firstError process.ArgumentError

showFirst is call
showFirst in main
showFirst invokes showText
showFirst arg text String firstArgument lend
showFirst out none
showFirst ownedBy none
showFirst cleanedBy none
showFirst borrows none
showFirst catch none

readSixth is call
readSixth in main
readSixth invokes process.argument
readSixth arg index Int64 sixth copy
readSixth arg region Region text lend
readSixth out sixthArgument String
readSixth ownedBy text
readSixth cleanedBy none
readSixth borrows none
readSixth catch sixthError process.ArgumentError

printBad is call
printBad in main
printBad invokes showInt
printBad arg value Int64 badIndex copy
printBad out none
printBad ownedBy none
printBad cleanedBy none
printBad borrows none
printBad catch none
