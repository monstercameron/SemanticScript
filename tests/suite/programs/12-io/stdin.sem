# covers: 12 Standard input
# covers: 12 Stream operations
# covers: 22 Interrupted I/O operations
# covers: 13 Capability scoping
# kind: positive
# expect: unsupported async operations such as `main`

stdinCase is module
stdinCase purpose "Use console.readLine under a capability"
stdinCase path stdinCase
stdinCase imports standard.console
stdinCase imports standard.time
stdinCase exports main

hostAccess is capability
hostAccess purpose "Authority for exactly this case's host access"
hostAccess grants read console.stdin
hostAccess scope none

main is operation
main purpose "Use console.readLine once"
main invariant none
main typeParam none
main input none
main output ExitCode
main outputOwner none
main raises none
main effect read console.stdin
main uses hostAccess
main memory heap true
main async true
main maxRecursion none
main label begin loopKind none
main label begin within none
main label done loopKind none
main label done within none
main label failed loopKind none
main label failed within none
main let limit immutable Int64 1024
main let okCode immutable ExitCode 0
main let failCode immutable ExitCode 1
main let waitMs immutable Int64 1000
main at begin do makeDeadline
main at begin start access
main at begin join access
main at begin branch ifError access goto failed else goto done
main at done return ok okCode
main at failed return ok failCode

io is region
io in main
io strategy arena
io capacity 65536
io released atReturn

makeDeadline is call
makeDeadline in main
makeDeadline invokes time.Deadline.after
makeDeadline arg milliseconds Int64 waitMs copy
makeDeadline out deadline time.Deadline
makeDeadline ownedBy none
makeDeadline cleanedBy none
makeDeadline borrows none
makeDeadline catch none

access is task
access in main
access invokes console.readLine
access arg region Region io lend
access arg maxBytes Int64 limit copy
access arg deadline time.Deadline deadline copy
access out line String
access ownedBy io
access cleanedBy none
access borrows none
access catch accessError console.ReadError
