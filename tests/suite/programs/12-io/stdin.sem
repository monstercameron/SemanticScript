# covers: 12 Standard input
# covers: 12 Stream operations
# covers: 22 Interrupted I/O operations
# kind: positive
# expect: run
# exit: 0
# stdout: hello world
# stdout: end
# stdin: hello world

stdinCase is module
stdinCase purpose "Read a line from standard input, then reach the end of input"
stdinCase path stdinCase
stdinCase imports standard.console
stdinCase imports standard.time
stdinCase exports main

stdoutWriter is capability
stdoutWriter purpose "Authority to write lines to standard output"
stdoutWriter grants write console.stdout none

showText is operation
showText purpose "Print one line of text"
showText invariant none
showText typeParameter none
showText input text String borrowed
showText output none
showText outputOwnedBy none
showText raises none
showText effect write console.stdout
showText uses stdoutWriter
showText memoryHeap false
showText async false
showText maxRecursion none
showText label begin loopKind none
showText label begin within none
showText label done loopKind none
showText label done within none
showText let none
showText at begin do writeValue
showText at begin branch ifError writeValue goto done else goto done
showText at done return ok none

writeValue is call
writeValue rationale "A test program has nowhere to report a failed write"
writeValue in showText
writeValue invokes console.writeLine
writeValue argument text String text lend
writeValue result none
writeValue ownedBy none
writeValue cleanedBy none
writeValue borrows none
writeValue catch writeError console.WriteError
writeValue suppresses console.WriteError.failed

stdinReader is capability
stdinReader purpose "Authority to read standard input"
stdinReader grants read console.stdin none

main is operation
main purpose "Run the case and print what it computes"
main invariant none
main typeParameter none
main input none
main output ExitCode
main outputOwnedBy none
main raises none
main effect read console.stdin
main effect write console.stdout
main uses stdinReader
main uses stdoutWriter
main memoryHeap true
main async true
main maxRecursion none
main label begin loopKind none
main label begin within none
main label showFirst loopKind none
main label showFirst within none
main label ended loopKind none
main label ended within none
main label reportEnd loopKind none
main label reportEnd within none
main label failed loopKind none
main label failed within none
main let limit Int64 1024 immutable
main let waitMs Int64 5000 immutable
main let endText String "end" immutable
main let okCode ExitCode 0 immutable
main let failCode ExitCode 1 immutable
main at begin do makeDeadline
main at begin start readFirst into none
main at begin join readFirst
main at begin branch ifError readFirst goto failed else goto showFirst
main at showFirst do printFirst
main at showFirst start readSecond into none
main at showFirst join readSecond
main at showFirst branch ifError readSecond goto ended else goto failed
main at ended match secondError console.ReadError
main at ended case console.ReadError.endOfInput bind none none goto reportEnd
main at ended case console.ReadError.tooLong bind none none goto failed
main at ended case console.ReadError.timedOut bind none none goto failed
main at ended case console.ReadError.cancelled bind none none goto failed
main at ended case console.ReadError.failed bind code Int32 goto failed
main at reportEnd do printEnd
main at reportEnd return ok okCode
main at failed return ok failCode

text is region
text in main
text strategy arena
text maxBytes 4096
text released atReturn

makeDeadline is call
makeDeadline in main
makeDeadline invokes time.Deadline.after
makeDeadline argument milliseconds Int64 waitMs copy
makeDeadline result deadline time.Deadline
makeDeadline ownedBy none
makeDeadline cleanedBy none
makeDeadline borrows none
makeDeadline catch none
makeDeadline suppresses none

readFirst is task
readFirst in main
readFirst invokes console.readLine
readFirst argument region Region text lend
readFirst argument maxBytes Int64 limit copy
readFirst argument deadline time.Deadline deadline copy
readFirst result firstLine String
readFirst ownedBy text
readFirst cleanedBy none
readFirst borrows none
readFirst catch firstError console.ReadError
readFirst suppresses none

readSecond is task
readSecond in main
readSecond invokes console.readLine
readSecond argument region Region text lend
readSecond argument maxBytes Int64 limit copy
readSecond argument deadline time.Deadline deadline copy
readSecond result secondLine String
readSecond ownedBy text
readSecond cleanedBy none
readSecond borrows none
readSecond catch secondError console.ReadError
readSecond suppresses none

printFirst is call
printFirst in main
printFirst invokes showText
printFirst argument text String firstLine lend
printFirst result none
printFirst ownedBy none
printFirst cleanedBy none
printFirst borrows none
printFirst catch none
printFirst suppresses none

printEnd is call
printEnd in main
printEnd invokes showText
printEnd argument text String endText lend
printEnd result none
printEnd ownedBy none
printEnd cleanedBy none
printEnd borrows none
printEnd catch none
printEnd suppresses none
