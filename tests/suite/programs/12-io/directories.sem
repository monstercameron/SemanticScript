directories is module
directories purpose "Make a directory, append to a file in it twice, list it, and remove everything"
directories path directories
directories imports standard.console
directories imports standard.fs
directories imports standard.string
directories imports standard.time
directories exports main

stdoutWriter is capability
stdoutWriter purpose "Authority to write lines to standard output"
stdoutWriter grants write console.stdout none

