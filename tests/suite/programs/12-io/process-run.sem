# covers: 12 Process execution
# covers: 19 Process management
# covers: 22 Rapid process creation
# covers: 17 Privilege separation
# covers: 13 Capability scoping
# kind: positive
# expect: run
# exit: 0
# requires: git
# stdout-any: git prints its own version line, which differs between machines

processCase is module
processCase purpose "Run git to print its version, then try a program that does not exist"
processCase path processCase
processCase imports standard.console
processCase imports standard.process
processCase imports standard.convert
processCase imports standard.time
processCase exports main

stdoutWriter is capability
stdoutWriter purpose "Authority to write lines to standard output"
stdoutWriter grants write console.stdout none

showInt is operation
showInt purpose "Print one whole number on its own line"
showInt invariant none
showInt typeParameter none
showInt input value Int64 copied
showInt output none
showInt outputOwnedBy none
showInt raises none
showInt effect write console.stdout
showInt uses stdoutWriter
showInt memoryHeap false
showInt async false
showInt maxRecursion none
showInt label begin loopKind none
showInt label begin within none
showInt label done loopKind none
showInt label done within none
showInt let none
showInt at begin do writeValue
showInt at begin branch ifError writeValue goto done else goto done
showInt at done return ok none

writeValue is call
writeValue rationale "A test program has nowhere to report a failed write"
writeValue in showInt
writeValue invokes console.writeIntegerLine
writeValue argument value Int64 value copy
writeValue result none
writeValue ownedBy none
writeValue cleanedBy none
writeValue borrows none
writeValue catch writeError console.WriteError
writeValue suppresses console.WriteError.failed

showText is operation
showText purpose "Print one line of text"
showText invariant none
showText typeParameter none
showText input text String borrowed
showText output none
showText outputOwnedBy none
showText raises none
showText effect write console.stdout
showText uses stdoutWriter
showText memoryHeap false
showText async false
showText maxRecursion none
showText label begin loopKind none
showText label begin within none
showText label done loopKind none
showText label done within none
showText let none
showText at begin do writeValue
showText at begin branch ifError writeValue goto done else goto done
showText at done return ok none

writeValue is call
writeValue rationale "A test program has nowhere to report a failed write"
writeValue in showText
writeValue invokes console.writeLine
writeValue argument text String text lend
writeValue result none
writeValue ownedBy none
writeValue cleanedBy none
writeValue borrows none
writeValue catch writeError console.WriteError
writeValue suppresses console.WriteError.failed

gitRunner is capability
gitRunner purpose "Authority to run git and nothing else"
gitRunner grants spawn process.programs "git"

missingRunner is capability
missingRunner purpose "Authority to run a program that is not installed"
missingRunner grants spawn process.programs "semanticscript-no-such-program"

main is operation
main purpose "Run the case and print what it computes"
main invariant none
main typeParameter none
main input none
main output ExitCode
main outputOwnedBy none
main raises none
main effect spawn process.programs
main effect write console.stdout
main uses gitRunner
main uses missingRunner
main uses stdoutWriter
main memoryHeap true
main async true
main maxRecursion none
main label begin loopKind none
main label begin within none
main label ran loopKind none
main label ran within none
main label missing loopKind none
main label missing within none
main label reportMissing loopKind none
main label reportMissing within none
main label failed loopKind none
main label failed within none
main let git String "git" immutable
main let missingProgram String "semanticscript-no-such-program" immutable
main let versionFlag String "--version" immutable
main let notFoundText String "notFound" immutable
main let waitMs Int64 30000 immutable
main let okCode ExitCode 0 immutable
main let failCode ExitCode 1 immutable
main at begin do makeDeadline
main at begin do newArguments
main at begin do addVersion
main at begin start runGit into none
main at begin join runGit
main at begin branch ifError runGit goto failed else goto ran
main at ran do widenStatus
main at ran do showStatus
main at ran start runMissing into none
main at ran join runMissing
main at ran branch ifError runMissing goto missing else goto failed
main at missing match missingError process.RunError
main at missing case process.RunError.notFound bind none none goto reportMissing
main at missing case process.RunError.timedOut bind none none goto failed
main at missing case process.RunError.cancelled bind none none goto failed
main at missing case process.RunError.tooLarge bind none none goto failed
main at missing case process.RunError.failed bind code Int32 goto failed
main at reportMissing do printNotFound
main at reportMissing return ok okCode
main at failed return ok failCode

args is region
args in main
args strategy arena
args maxBytes 4096
args released atReturn

makeDeadline is call
makeDeadline in main
makeDeadline invokes time.Deadline.after
makeDeadline argument milliseconds Int64 waitMs copy
makeDeadline result deadline time.Deadline
makeDeadline ownedBy none
makeDeadline cleanedBy none
makeDeadline borrows none
makeDeadline catch none
makeDeadline suppresses none

newArguments is call
newArguments in main
newArguments invokes process.newArguments
newArguments argument region Region args lend
newArguments result arguments process.Arguments
newArguments ownedBy args
newArguments cleanedBy none
newArguments borrows none
newArguments catch none
newArguments suppresses none

addVersion is call
addVersion in main
addVersion invokes process.addArgument
addVersion argument arguments process.Arguments arguments lendMutable
addVersion argument text String versionFlag lend
addVersion result none
addVersion ownedBy none
addVersion cleanedBy none
addVersion borrows none
addVersion catch none
addVersion suppresses none

runGit is task
runGit in main
runGit invokes process.run
runGit argument program String git lend
runGit argument arguments process.Arguments arguments lend
runGit argument deadline time.Deadline deadline copy
runGit result status ExitCode
runGit ownedBy none
runGit cleanedBy none
runGit borrows none
runGit catch runError process.RunError
runGit suppresses none

widenStatus is call
widenStatus in main
widenStatus invokes convert.exitCodeToInt64
widenStatus argument value ExitCode status copy
widenStatus result statusNumber Int64
widenStatus ownedBy none
widenStatus cleanedBy none
widenStatus borrows none
widenStatus catch none
widenStatus suppresses none

showStatus is call
showStatus in main
showStatus invokes showInt
showStatus argument value Int64 statusNumber copy
showStatus result none
showStatus ownedBy none
showStatus cleanedBy none
showStatus borrows none
showStatus catch none
showStatus suppresses none

runMissing is task
runMissing in main
runMissing invokes process.run
runMissing argument program String missingProgram lend
runMissing argument arguments process.Arguments arguments lend
runMissing argument deadline time.Deadline deadline copy
runMissing result missingStatus ExitCode
runMissing ownedBy none
runMissing cleanedBy none
runMissing borrows none
runMissing catch missingError process.RunError
runMissing suppresses none

printNotFound is call
printNotFound in main
printNotFound invokes showText
printNotFound argument text String notFoundText lend
printNotFound result none
printNotFound ownedBy none
printNotFound cleanedBy none
printNotFound borrows none
printNotFound catch none
printNotFound suppresses none
