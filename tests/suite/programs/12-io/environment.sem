# covers: 12 Environment variables
# covers: 19 Environment utilities
# kind: positive
# expect: run
# exit: 0
# stdout: found
# stdout: missing

environmentCase is module
environmentCase purpose "Read one environment variable that exists and one that does not"
environmentCase path environmentCase
environmentCase imports standard.console
environmentCase imports standard.environment
environmentCase exports main

stdoutWriter is capability
stdoutWriter purpose "Authority to write lines to standard output"
stdoutWriter grants write console.stdout none

showText is operation
showText purpose "Print one line of text"
showText invariant none
showText typeParameter none
showText input text String borrowed
showText output none
showText outputOwnedBy none
showText raises none
showText effect write console.stdout
showText uses stdoutWriter
showText memoryHeap false
showText async false
showText maxRecursion none
showText label begin loopKind none
showText label begin within none
showText label done loopKind none
showText label done within none
showText let none
showText at begin do writeValue
showText at begin branch ifError writeValue goto done else goto done
showText at done return ok none

writeValue is call
writeValue rationale "A test program has nowhere to report a failed write"
writeValue in showText
writeValue invokes console.writeLine
writeValue argument text String text lend
writeValue result none
writeValue ownedBy none
writeValue cleanedBy none
writeValue borrows none
writeValue catch writeError console.WriteError
writeValue suppresses console.WriteError.failed

environmentReader is capability
environmentReader purpose "Authority to read environment variables"
environmentReader grants read environment.variables none

main is operation
main purpose "Run the case and print what it computes"
main invariant none
main typeParameter none
main input none
main output ExitCode
main outputOwnedBy none
main raises none
main effect read environment.variables
main effect write console.stdout
main uses environmentReader
main uses stdoutWriter
main memoryHeap true
main async false
main maxRecursion none
main label begin loopKind none
main label begin within none
main label found loopKind none
main label found within none
main label missing loopKind none
main label missing within none
main label failed loopKind none
main label failed within none
main let pathName String "PATH" immutable
main let unsetName String "SEMANTICSCRIPT_SUITE_UNSET" immutable
main let foundText String "found" immutable
main let missingText String "missing" immutable
main let okCode ExitCode 0 immutable
main let failCode ExitCode 1 immutable
main at begin do readPath
main at begin branch ifError readPath goto failed else goto found
main at found do showFound
main at found do readUnset
main at found branch ifError readUnset goto missing else goto failed
main at missing do showMissing
main at missing return ok okCode
main at failed return ok failCode

text is region
text in main
text strategy arena
text maxBytes 65536
text released atReturn

readPath is call
readPath in main
readPath invokes environment.get
readPath argument name String pathName lend
readPath argument region Region text lend
readPath result pathValue String
readPath ownedBy text
readPath cleanedBy none
readPath borrows none
readPath catch pathError environment.MissingError
readPath suppresses none

showFound is call
showFound in main
showFound invokes showText
showFound argument text String foundText lend
showFound result none
showFound ownedBy none
showFound cleanedBy none
showFound borrows none
showFound catch none
showFound suppresses none

readUnset is call
readUnset in main
readUnset invokes environment.get
readUnset argument name String unsetName lend
readUnset argument region Region text lend
readUnset result unsetValue String
readUnset ownedBy text
readUnset cleanedBy none
readUnset borrows none
readUnset catch unsetError environment.MissingError
readUnset suppresses none

showMissing is call
showMissing in main
showMissing invokes showText
showMissing argument text String missingText lend
showMissing result none
showMissing ownedBy none
showMissing cleanedBy none
showMissing borrows none
showMissing catch none
showMissing suppresses none
