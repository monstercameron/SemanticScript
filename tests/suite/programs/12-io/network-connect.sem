# covers: 12 Network I/O
# covers: 12 Socket operations
# covers: 13 Network capability enforcement
# covers: 19 Networking
# covers: 13 Capability scoping
# covers: 12 Stream operations
# kind: positive
# expect: run
# exit: 0
# stdout: ping

networkCase is module
networkCase purpose "Listen on loopback, connect to it, send a message, and read it on the other side"
networkCase path networkCase
networkCase imports standard.console
networkCase imports standard.net
networkCase imports standard.string
networkCase imports standard.time
networkCase exports main

stdoutWriter is capability
stdoutWriter purpose "Authority to write lines to standard output"
stdoutWriter grants write console.stdout none

showText is operation
showText purpose "Print one line of text"
showText invariant none
showText typeParameter none
showText input text String borrowed
showText output none
showText outputOwnedBy none
showText raises none
showText effect write console.stdout
showText uses stdoutWriter
showText memoryHeap false
showText async false
showText maxRecursion none
showText label begin loopKind none
showText label begin within none
showText label done loopKind none
showText label done within none
showText let none
showText at begin do writeValue
showText at begin branch ifError writeValue goto done else goto done
showText at done return ok none

writeValue is call
writeValue rationale "A test program has nowhere to report a failed write"
writeValue in showText
writeValue invokes console.writeLine
writeValue argument text String text lend
writeValue result none
writeValue ownedBy none
writeValue cleanedBy none
writeValue borrows none
writeValue catch writeError console.WriteError

listenAuthority is capability
listenAuthority purpose "Authority to accept connections on loopback port 47811"
listenAuthority grants listen net.tcp "127.0.0.1:47811"

connectAuthority is capability
connectAuthority purpose "Authority to connect to loopback port 47811"
connectAuthority grants connect net.outbound "127.0.0.1:47811"

connectionIo is capability
connectionIo purpose "Authority to use the connections this case opens"
connectionIo grants readWrite net.connection none

main is operation
main purpose "Run the case and print what it computes"
main invariant none
main typeParameter none
main input none
main output ExitCode
main outputOwnedBy none
main raises none
main effect connect net.outbound
main effect listen net.tcp
main effect readWrite net.connection
main effect write console.stdout
main uses connectAuthority
main uses connectionIo
main uses listenAuthority
main uses stdoutWriter
main memoryHeap true
main async true
main maxRecursion none
main label begin loopKind none
main label begin within none
main label listening loopKind none
main label listening within none
main label connected loopKind none
main label connected within none
main label accepted loopKind none
main label accepted within none
main label receive loopKind none
main label receive within none
main label decode loopKind none
main label decode within none
main label show loopKind none
main label show within none
main label failed loopKind none
main label failed within none
main let port Int32 47811 immutable
main let address String "127.0.0.1:47811" immutable
main let message String "ping" immutable
main let waitMs Int64 5000 immutable
main let limit Int64 64 immutable
main let okCode ExitCode 0 immutable
main let failCode ExitCode 1 immutable
main at begin do makeDeadline
main at begin do openListener
main at begin branch ifError openListener goto failed else goto listening
main at listening defer closeListenerCleanup
main at listening start connectClient into none
main at listening join connectClient
main at listening branch ifError connectClient goto failed else goto connected
main at connected defer closeClientCleanup
main at connected start acceptServer into none
main at connected join acceptServer
main at connected branch ifError acceptServer goto failed else goto accepted
main at accepted defer closeServerCleanup
main at accepted do toBytes
main at accepted start sendPing into none
main at accepted join sendPing
main at accepted branch ifError sendPing goto failed else goto receive
main at receive start readPing into none
main at receive join readPing
main at receive branch ifError readPing goto failed else goto decode
main at decode do toText
main at decode branch ifError toText goto failed else goto show
main at show do printPing
main at show return ok okCode
main at failed return ok failCode

io is region
io in main
io strategy arena
io maxBytes 65536
io released atReturn

makeDeadline is call
makeDeadline in main
makeDeadline invokes time.Deadline.after
makeDeadline argument milliseconds Int64 waitMs copy
makeDeadline result deadline time.Deadline
makeDeadline ownedBy none
makeDeadline cleanedBy none
makeDeadline borrows none
makeDeadline catch none

openListener is call
openListener in main
openListener invokes net.listen
openListener argument port Int32 port copy
openListener result listener net.TcpListener
openListener ownedBy main
openListener cleanedBy closeListenerCleanup
openListener borrows none
openListener catch listenError net.NetError

closeListenerCleanup is cleanup
closeListenerCleanup rationale "Nothing can be done if closing fails at exit"
closeListenerCleanup in main
closeListenerCleanup runs closeListener
closeListenerCleanup cleans listener
closeListenerCleanup onError suppress

closeListener is call
closeListener in main
closeListener invokes net.closeListener
closeListener argument listener net.TcpListener listener give
closeListener result none
closeListener ownedBy none
closeListener cleanedBy none
closeListener borrows none
closeListener catch closeListenerError net.NetError

connectClient is task
connectClient in main
connectClient invokes net.connect
connectClient argument address String address lend
connectClient argument deadline time.Deadline deadline copy
connectClient result client net.TcpConnection
connectClient ownedBy main
connectClient cleanedBy closeClientCleanup
connectClient borrows none
connectClient catch connectError net.NetError

closeClientCleanup is cleanup
closeClientCleanup rationale "Nothing can be done if closing fails at exit"
closeClientCleanup in main
closeClientCleanup runs closeClient
closeClientCleanup cleans client
closeClientCleanup onError suppress

closeClient is call
closeClient in main
closeClient invokes net.close
closeClient argument connection net.TcpConnection client give
closeClient result none
closeClient ownedBy none
closeClient cleanedBy none
closeClient borrows none
closeClient catch closeClientError net.NetError

acceptServer is task
acceptServer in main
acceptServer invokes net.accept
acceptServer argument listener net.TcpListener listener lendMutable
acceptServer argument deadline time.Deadline deadline copy
acceptServer result server net.TcpConnection
acceptServer ownedBy main
acceptServer cleanedBy closeServerCleanup
acceptServer borrows none
acceptServer catch acceptError net.NetError

closeServerCleanup is cleanup
closeServerCleanup rationale "Nothing can be done if closing fails at exit"
closeServerCleanup in main
closeServerCleanup runs closeServer
closeServerCleanup cleans server
closeServerCleanup onError suppress

closeServer is call
closeServer in main
closeServer invokes net.close
closeServer argument connection net.TcpConnection server give
closeServer result none
closeServer ownedBy none
closeServer cleanedBy none
closeServer borrows none
closeServer catch closeServerError net.NetError

toBytes is call
toBytes in main
toBytes invokes string.toBytes
toBytes argument text String message lend
toBytes result messageBytes Bytes
toBytes ownedBy none
toBytes cleanedBy none
toBytes borrows message
toBytes catch none

sendPing is task
sendPing in main
sendPing invokes net.write
sendPing argument connection net.TcpConnection client lendMutable
sendPing argument bytes Bytes messageBytes lend
sendPing argument deadline time.Deadline deadline copy
sendPing result none
sendPing ownedBy none
sendPing cleanedBy none
sendPing borrows none
sendPing catch sendError net.NetError

readPing is task
readPing in main
readPing invokes net.read
readPing argument connection net.TcpConnection server lendMutable
readPing argument region Region io lend
readPing argument maxBytes Int64 limit copy
readPing argument deadline time.Deadline deadline copy
readPing result received Bytes
readPing ownedBy io
readPing cleanedBy none
readPing borrows none
readPing catch readError net.NetError

toText is call
toText in main
toText invokes string.fromBytes
toText argument bytes Bytes received lend
toText argument region Region io lend
toText result receivedText String
toText ownedBy io
toText cleanedBy none
toText borrows none
toText catch decodeError string.Utf8Error

printPing is call
printPing in main
printPing invokes showText
printPing argument text String receivedText lend
printPing result none
printPing ownedBy none
printPing cleanedBy none
printPing borrows none
printPing catch none
