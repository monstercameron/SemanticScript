# covers: 12 Network I/O
# covers: 12 Socket operations
# covers: 13 Network capability enforcement
# covers: 19 Networking
# covers: 13 Capability scoping
# kind: positive
# expect: unsupported async operations such as `main`

networkConnectCase is module
networkConnectCase purpose "Use net.connect under a capability"
networkConnectCase path networkConnectCase
networkConnectCase imports standard.net
networkConnectCase imports standard.time
networkConnectCase exports main

hostAccess is capability
hostAccess purpose "Authority for exactly this case's host access"
hostAccess grants connect net.outbound
hostAccess scope "example.test:80"

connectionIo is capability
connectionIo purpose "Authority to use the opened connection"
connectionIo grants readWrite net.connection
connectionIo scope none

main is operation
main purpose "Use net.connect once"
main invariant none
main typeParam none
main input none
main output ExitCode
main outputOwner none
main raises none
main effect connect net.outbound
main effect readWrite net.connection
main uses connectionIo
main uses hostAccess
main memory heap false
main async true
main maxRecursion none
main label begin loopKind none
main label begin within none
main label done loopKind none
main label done within none
main label closed loopKind none
main label closed within none
main label closeFailed loopKind none
main label closeFailed within none
main label failed loopKind none
main label failed within none
main let address immutable String "example.test:80"
main let okCode immutable ExitCode 0
main let failCode immutable ExitCode 1
main let waitMs immutable Int64 1000
main at begin do makeDeadline
main at begin start access
main at begin join access
main at begin branch ifError access goto failed else goto done
main at done do closeConnection
main at done branch ifError closeConnection goto closeFailed else goto closed
main at closed return ok okCode
main at closeFailed return ok failCode
main at failed return ok failCode

makeDeadline is call
makeDeadline in main
makeDeadline invokes time.Deadline.after
makeDeadline arg milliseconds Int64 waitMs copy
makeDeadline out deadline time.Deadline
makeDeadline ownedBy none
makeDeadline cleanedBy none
makeDeadline borrows none
makeDeadline catch none

access is task
access in main
access invokes net.connect
access arg address String address lend
access arg deadline time.Deadline deadline copy
access out connection net.TcpConnection
access ownedBy main
access cleanedBy none
access borrows none
access catch accessError net.NetError

closeConnection is call
closeConnection in main
closeConnection invokes net.close
closeConnection arg connection net.TcpConnection connection give
closeConnection out none
closeConnection ownedBy none
closeConnection cleanedBy none
closeConnection borrows none
closeConnection catch closeError net.NetError
