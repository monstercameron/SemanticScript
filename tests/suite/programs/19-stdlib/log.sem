# covers: 19 Logging
# kind: positive
# expect: run
# exit: 0
# stderr: [info] logged once

logCase is module
logCase purpose "Use the log targets"
logCase path logCase
logCase imports standard.log
logCase exports main

stderrWriter is capability
stderrWriter purpose "Authority to write log lines to standard error"
stderrWriter grants write console.stderr none

main is operation
main purpose "Run the case and print what it computes"
main invariant none
main typeParameter none
main input none
main output ExitCode
main outputOwnedBy none
main raises none
main effect write console.stderr
main uses stderrWriter
main memoryHeap true
main async false
main maxRecursion none
main label begin loopKind none
main label begin within none
main label step1 loopKind none
main label step1 within none
main label failed loopKind none
main label failed within none
main let logText String "logged once" immutable
main let okCode ExitCode 0 immutable
main let failCode ExitCode 1 immutable
main at begin do logOnce
main at begin branch ifError logOnce goto failed else goto step1
main at step1 return ok okCode
main at failed return ok failCode

store is region
store in main
store strategy arena
store maxBytes 65536
store released atReturn

logOnce is call
logOnce in main
logOnce invokes log.info
logOnce argument text String logText lend
logOnce result none
logOnce ownedBy none
logOnce cleanedBy none
logOnce borrows none
logOnce catch logError log.LogError
