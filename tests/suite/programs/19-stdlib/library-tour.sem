libraryTour is module
libraryTour purpose "Call every standard-library target the other cases leave out, and print each result"
libraryTour path libraryTour
libraryTour imports standard.console
libraryTour imports standard.bits
libraryTour imports standard.buffer
libraryTour imports standard.byte
libraryTour imports standard.compare
libraryTour imports standard.convert
libraryTour imports standard.fs
libraryTour imports standard.http
libraryTour imports standard.logic
libraryTour imports standard.math
libraryTour imports standard.string
libraryTour imports standard.time
libraryTour exports main

stdoutWriter is capability
stdoutWriter purpose "Authority to write lines to standard output"
stdoutWriter grants write console.stdout none

showInt is operation
showInt purpose "Print one whole number on its own line"
