# covers: 12 File locking
# kind: positive
# expect: run
# exit: 0
# stdout: locked

fileLockCase is module
fileLockCase purpose "Use the file lock targets"
fileLockCase path fileLockCase
fileLockCase imports standard.console
fileLockCase imports standard.fs
fileLockCase imports standard.string
fileLockCase imports standard.time
fileLockCase exports main

stdoutWriter is capability
stdoutWriter purpose "Authority to write lines to standard output"
stdoutWriter grants write console.stdout none

showText is operation
showText purpose "Print one line of text"
showText invariant none
showText typeParameter none
showText input text String borrowed
showText output none
showText outputOwnedBy none
showText raises none
showText effect write console.stdout
showText uses stdoutWriter
showText memoryHeap false
showText async false
showText maxRecursion none
showText label begin loopKind none
showText label begin within none
showText label done loopKind none
showText label done within none
showText let none
showText at begin do writeValue
showText at begin branch ifError writeValue goto done else goto done
showText at done return ok none

writeValue is call
writeValue rationale "A test program has nowhere to report a failed write"
writeValue in showText
writeValue invokes console.writeLine
writeValue argument text String text lend
writeValue result none
writeValue ownedBy none
writeValue cleanedBy none
writeValue borrows none
writeValue catch writeError console.WriteError

fileAccess is capability
fileAccess purpose "Authority over files whose names start with suite-"
fileAccess grants read fs.files "suite-*"
fileAccess grants write fs.files "suite-*"

main is operation
main purpose "Run the case and print what it computes"
main invariant none
main typeParameter none
main input none
main output ExitCode
main outputOwnedBy none
main raises none
main effect write console.stdout
main effect write fs.files
main uses fileAccess
main uses stdoutWriter
main memoryHeap true
main async true
main maxRecursion none
main label begin loopKind none
main label begin within none
main label step1 loopKind none
main label step1 within none
main label step2 loopKind none
main label step2 within none
main label step3 loopKind none
main label step3 within none
main label step4 loopKind none
main label step4 within none
main label failed loopKind none
main label failed within none
main let waitMs Int64 30000 immutable
main let abc String "abc" immutable
main let lockPath String "suite-lock.txt" immutable
main let lockedText String "locked" immutable
main let okCode ExitCode 0 immutable
main let failCode ExitCode 1 immutable
main at begin do makeDeadline
main at begin do lockedBytes
main at begin start writeLockFile into none
main at begin join writeLockFile
main at begin branch ifError writeLockFile goto failed else goto step1
main at step1 do openLockFile
main at step1 branch ifError openLockFile goto failed else goto step2
main at step2 defer closeLockCleanup
main at step2 start takeLock into none
main at step2 join takeLock
main at step2 branch ifError takeLock goto failed else goto step3
main at step3 do printLocked
main at step3 do releaseLock
main at step3 branch ifError releaseLock goto failed else goto step4
main at step4 return ok okCode
main at failed return ok failCode

store is region
store in main
store strategy arena
store maxBytes 65536
store released atReturn

makeDeadline is call
makeDeadline in main
makeDeadline invokes time.Deadline.after
makeDeadline argument milliseconds Int64 waitMs copy
makeDeadline result deadline time.Deadline
makeDeadline ownedBy none
makeDeadline cleanedBy none
makeDeadline borrows none
makeDeadline catch none

lockedBytes is call
lockedBytes in main
lockedBytes invokes string.toBytes
lockedBytes argument text String abc lend
lockedBytes result lockedData Bytes
lockedBytes ownedBy none
lockedBytes cleanedBy none
lockedBytes borrows abc
lockedBytes catch none

writeLockFile is task
writeLockFile in main
writeLockFile invokes fs.writeAll
writeLockFile argument path String lockPath lend
writeLockFile argument bytes Bytes lockedData lend
writeLockFile argument deadline time.Deadline deadline copy
writeLockFile result none
writeLockFile ownedBy none
writeLockFile cleanedBy none
writeLockFile borrows none
writeLockFile catch writeLockError fs.FileError

openLockFile is call
openLockFile in main
openLockFile invokes fs.openAppend
openLockFile argument path String lockPath lend
openLockFile result lockFile fs.FileHandle
openLockFile ownedBy main
openLockFile cleanedBy closeLockCleanup
openLockFile borrows none
openLockFile catch openLockError fs.FileError

closeLockCleanup is cleanup
closeLockCleanup rationale "A failed close at exit has nobody to report to"
closeLockCleanup in main
closeLockCleanup runs closeLock
closeLockCleanup cleans lockFile
closeLockCleanup onError suppress

closeLock is call
closeLock in main
closeLock invokes fs.close
closeLock argument file fs.FileHandle lockFile give
closeLock result none
closeLock ownedBy none
closeLock cleanedBy none
closeLock borrows none
closeLock catch closeLockError fs.FileError

takeLock is task
takeLock in main
takeLock invokes fs.lock
takeLock argument file fs.FileHandle lockFile lendMutable
takeLock argument deadline time.Deadline deadline copy
takeLock result none
takeLock ownedBy none
takeLock cleanedBy none
takeLock borrows none
takeLock catch lockError fs.FileError

printLocked is call
printLocked in main
printLocked invokes showText
printLocked argument text String lockedText lend
printLocked result none
printLocked ownedBy none
printLocked cleanedBy none
printLocked borrows none
printLocked catch none

releaseLock is call
releaseLock in main
releaseLock invokes fs.unlock
releaseLock argument file fs.FileHandle lockFile lendMutable
releaseLock result none
releaseLock ownedBy none
releaseLock cleanedBy none
releaseLock borrows none
releaseLock catch unlockError fs.FileError
