modules is module
modules purpose "Use the random, crypto, log, json, secret, signal, file-lock, and pipe targets"
modules path modules
modules imports standard.console
modules imports standard.random
modules imports standard.crypto
modules imports standard.log
modules imports standard.json
modules imports standard.secret
modules imports standard.signal
modules imports standard.fs
modules imports standard.process
modules imports standard.string
modules imports standard.time
modules imports standard.compare
modules exports main

stdoutWriter is capability
stdoutWriter purpose "Authority to write lines to standard output"
stdoutWriter grants write console.stdout
stdoutWriter scope none

