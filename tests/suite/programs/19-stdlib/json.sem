main label showBadAt within none
main label step12 loopKind none
main label step12 within none
main label step13 loopKind none
main label step13 within none
main label failed loopKind none
main label failed within none
main let one Int64 1 immutable
main let five Int64 5 immutable
main let document String "{\"name\":\"Ada\",\"tags\":[1,2,3],\"ok\":true}" immutable
main let badDocument String "{\"a\": tru}" immutable
main let nameKey String "name" immutable
main let tagsKey String "tags" immutable
main let okKey String "ok" immutable
main let absentKey String "absent" immutable
main let missingText String "missing" immutable
main let aKey String "a" immutable
main let nKey String "n" immutable
main let xText String "x" immutable
main let okCode ExitCode 0 immutable
main let failCode ExitCode 1 immutable
main at begin do parseDocument
main at begin branch ifError parseDocument goto failed else goto step1
main at step1 do nameField
main at step1 branch ifError nameField goto failed else goto step2
main at step2 do nameText
main at step2 branch ifError nameText goto failed else goto step3
main at step3 do printName
main at step3 do tagsField
main at step3 branch ifError tagsField goto failed else goto step4
main at step4 do tagCount
main at step4 branch ifError tagCount goto failed else goto step5
main at step5 do printTagCount
main at step5 do secondTag
main at step5 branch ifError secondTag goto failed else goto step6
main at step6 do tagNumber
main at step6 branch ifError tagNumber goto failed else goto step7
main at step7 do printTag
main at step7 do okField
main at step7 branch ifError okField goto failed else goto step8
main at step8 do okFlag
main at step8 branch ifError okFlag goto failed else goto step9
main at step9 do printFlag
main at step9 do absentField
main at step9 branch ifError absentField goto step10 else goto failed
main at step10 do printMissing
main at step10 do parseBad
main at step10 branch ifError parseBad goto step11 else goto failed
main at step11 match badError json.ParseError
main at step11 case json.ParseError.invalidAt bind badAt Int64 goto showBadAt
main at step11 case json.ParseError.tooDeep bind none none goto failed
main at showBadAt do printBadAt
main at showBadAt do newObject
main at showBadAt do setA
main at showBadAt branch ifError setA goto failed else goto step12
main at step12 do setN
main at step12 branch ifError setN goto failed else goto step13
main at step13 do serialize
main at step13 do printSerialized
main at step13 return ok okCode
main at failed return ok failCode

store is region
store in main
store strategy arena
store maxBytes 65536
store released atReturn

