# covers: 6 Recursive resource cleanup
# covers: 7 Resource cleanup
# covers: 7 Deterministic destruction
# kind: positive
# expect: run
# exit: 0
# stdout: 4
# stdout: removed

nestedFiles is module
nestedFiles purpose "Open the same file at every level of a recursion, release each by a deferred cleanup, then prove every handle was released by removing the file"
nestedFiles path nestedFiles
nestedFiles imports standard.console
nestedFiles imports standard.fs
nestedFiles imports standard.math
nestedFiles imports standard.compare
nestedFiles imports standard.string
nestedFiles imports standard.time
nestedFiles exports main

stdoutWriter is capability
stdoutWriter purpose "Authority to write lines to standard output"
stdoutWriter grants write console.stdout none

showInt is operation
showInt purpose "Print one whole number on its own line"
showInt invariant none
showInt typeParameter none
showInt input value Int64 copied
showInt output none
showInt outputOwnedBy none
showInt raises none
showInt effect write console.stdout
showInt uses stdoutWriter
showInt memoryHeap false
showInt async false
showInt maxRecursion none
showInt label begin loopKind none
showInt label begin within none
showInt label done loopKind none
showInt label done within none
showInt let none
showInt at begin do writeValue
showInt at begin branch ifError writeValue goto done else goto done
showInt at done return ok none

writeValue is call
writeValue rationale "A test program has nowhere to report a failed write"
writeValue in showInt
writeValue invokes console.writeIntegerLine
writeValue argument value Int64 value copy
writeValue result none
writeValue ownedBy none
writeValue cleanedBy none
writeValue borrows none
writeValue catch writeError console.WriteError

showText is operation
showText purpose "Print one line of text"
showText invariant none
showText typeParameter none
showText input text String borrowed
showText output none
showText outputOwnedBy none
showText raises none
showText effect write console.stdout
showText uses stdoutWriter
showText memoryHeap false
showText async false
showText maxRecursion none
showText label begin loopKind none
showText label begin within none
showText label done loopKind none
showText label done within none
showText let none
showText at begin do writeValue
showText at begin branch ifError writeValue goto done else goto done
showText at done return ok none

writeValue is call
writeValue rationale "A test program has nowhere to report a failed write"
writeValue in showText
writeValue invokes console.writeLine
writeValue argument text String text lend
writeValue result none
writeValue ownedBy none
writeValue cleanedBy none
writeValue borrows none
writeValue catch writeError console.WriteError

fileAccess is capability
fileAccess purpose "Authority over files whose names start with suite-"
fileAccess grants read fs.files "suite-*"
fileAccess grants write fs.files "suite-*"

nest is operation
nest purpose "Open the file, recurse until depth reaches zero, and count the levels that held it open"
nest invariant none
nest typeParameter none
nest input depth Int64 copied
nest output Int64
nest outputOwnedBy none
nest raises none
nest effect read fs.files
nest uses fileAccess
nest memoryHeap false
nest async false
nest maxRecursion 10
nest label begin loopKind none
nest label begin within none
nest label opened loopKind none
nest label opened within none
nest label last loopKind none
nest label last within none
nest label deeper loopKind none
nest label deeper within none
nest label failed loopKind none
nest label failed within none
nest let path String "suite-nested.txt" immutable
nest let zero Int64 0 immutable
nest let one Int64 1 immutable
nest at begin do openIt
nest at begin branch ifError openIt goto failed else goto opened
nest at opened defer closeItCleanup
nest at opened do atBottom
nest at opened branch if bottom goto last else goto deeper
nest at last return ok one
nest at deeper do less
nest at deeper do recurse
nest at deeper do addOne
nest at deeper return ok levels
nest at failed return ok zero

openIt is call
openIt in nest
openIt invokes fs.openRead
openIt argument path String path lend
openIt result file fs.FileHandle
openIt ownedBy nest
openIt cleanedBy closeItCleanup
openIt borrows none
openIt catch openError fs.FileError

closeItCleanup is cleanup
closeItCleanup rationale "A failed close has nobody to report to"
closeItCleanup in nest
closeItCleanup runs closeIt
closeItCleanup cleans file
closeItCleanup onError suppress

closeIt is call
closeIt in nest
closeIt invokes fs.close
closeIt argument file fs.FileHandle file give
closeIt result none
closeIt ownedBy none
closeIt cleanedBy none
closeIt borrows none
closeIt catch closeError fs.FileError

atBottom is call
atBottom in nest
atBottom invokes compare.equalInt64
atBottom argument left Int64 depth copy
atBottom argument right Int64 zero copy
atBottom result bottom Bool
atBottom ownedBy none
atBottom cleanedBy none
atBottom borrows none
atBottom catch none

