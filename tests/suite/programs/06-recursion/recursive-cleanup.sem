main let three Int64 3 immutable
main let waitMs Int64 5000 immutable
main let removedText String "removed" immutable
main let okCode ExitCode 0 immutable
main let failCode ExitCode 1 immutable
main at begin do makeDeadline
main at begin do toBytes
main at begin start writeIt into none
main at begin join writeIt
main at begin branch ifError writeIt goto failed else goto descend
main at descend do runNest
main at descend do showLevels
main at descend do removeIt
main at descend branch ifError removeIt goto failed else goto removed
main at removed do showRemoved
main at removed return ok okCode
main at failed return ok failCode

