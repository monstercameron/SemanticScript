# covers: 6 Direct recursion
# covers: 6 Indirect recursion
# covers: 6 Mutual recursion
# covers: 6 Tail recursion
# covers: 6 Nested recursion
# covers: 6 Base-case termination
# covers: 6 Recursion with local variables
# covers: 6 Recursion with error propagation
# covers: 6 Recursive function reentrancy
# covers: 10 Error handling during recursion
# covers: 21 Recursion limits are enforced
# kind: positive
# expect: run
# exit: 0
# stdout: 120
# stdout: 1
# stdout: 0
# stdout: 7
# stdout: 55
# stdout: -1

recursion is module
recursion purpose "Show direct, mutual, nested, and accumulating recursion, and errors raised through it"
recursion path recursion
recursion imports standard.console
recursion imports standard.math
recursion imports standard.compare
recursion exports main

stdoutWriter is capability
stdoutWriter purpose "Authority to write lines to standard output"
stdoutWriter grants write console.stdout
stdoutWriter scope none

showInt is operation
showInt purpose "Print one whole number on its own line"
showInt invariant none
showInt typeParam none
showInt input value Int64 value
showInt output none
showInt outputOwner none
showInt raises none
