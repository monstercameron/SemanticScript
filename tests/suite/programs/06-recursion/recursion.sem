recursion is module
recursion purpose "Show direct, mutual, nested, and accumulating recursion, and errors raised through it"
recursion path recursion
recursion imports standard.console
recursion imports standard.math
recursion imports standard.compare
recursion exports main

stdoutWriter is capability
stdoutWriter purpose "Authority to write lines to standard output"
stdoutWriter grants write console.stdout none

