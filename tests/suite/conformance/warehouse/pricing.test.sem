# Tests for pricing.sem: one test per invariant, each calling the operation it
# verifies and asserting on what it returns.

fullPriceTest is test
fullPriceTest purpose "fullPrice charges 1234 cents as 1234 cents"
fullPriceTest verifies fullPrice unchanged
fullPriceTest typeParameter none
fullPriceTest input none
fullPriceTest output none
fullPriceTest outputOwnedBy none
fullPriceTest raises none
fullPriceTest effect none
fullPriceTest uses none
fullPriceTest memoryHeap false
fullPriceTest async false
fullPriceTest maxRecursion none
fullPriceTest label begin loopKind none
fullPriceTest label begin within none
fullPriceTest let amount Int64 1234 immutable
fullPriceTest at begin do runFull
fullPriceTest at begin do expectSame
fullPriceTest at begin return ok none

runFull is call
runFull in fullPriceTest
runFull invokes fullPrice
runFull argument cents Int64 amount copy
runFull result charged Int64
runFull ownedBy none
runFull cleanedBy none
runFull borrows none
runFull catch none

expectSame is call
expectSame in fullPriceTest
expectSame invokes test.assertEqualInt64
expectSame argument expected Int64 amount copy
expectSame argument actual Int64 charged copy
expectSame result none
expectSame ownedBy none
expectSame cleanedBy none
expectSame borrows none
expectSame catch none

