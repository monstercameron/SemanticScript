# HtmlTemplateLab regular SemanticScript build plan.
# Build configuration is ordinary typed record data; semsc lowers BuildPlan internally.

module app.htmlTemplateLab.build
purpose module app.htmlTemplateLab.build "Describe the HtmlTemplateLab build as ordinary typed SemanticScript data."
moduleOwns app.htmlTemplateLab.build "Build project metadata, module registration, target options, version metadata, and build constants."
moduleDoesNotOwn app.htmlTemplateLab.build "Runtime application behavior; registered app modules own operations, routes, exports, and UI/domain logic."
invariant module app.htmlTemplateLab.build "Build configuration is data first: records hold settings, and configure operation returns the selected BuildPlan."

record BuildProject
field BuildProject id String
field BuildProject name String
field BuildProject modulePath String
field BuildProject languageVersion String
field BuildProject projectVersion String
field BuildProject license String
field BuildProject sourceRoot String
field BuildProject testPattern String
field BuildProject testRoot String

record BuildModule
field BuildModule moduleName String
field BuildModule sourcePath String
field BuildModule mainFile String

record BuildModules
field BuildModules main BuildModule
field BuildModules shared BuildModule
field BuildModules todo_domain BuildModule
field BuildModules todo_components BuildModule
field BuildModules todo_pages BuildModule

record BuildTarget
field BuildTarget runtime String
field BuildTarget nativeRuntime String
field BuildTarget nativeRuntimeVersion Int64
field BuildTarget profile String
field BuildTarget optLevel Int64
field BuildTarget runtimeChecks String
field BuildTarget persistLlvmIr String
field BuildTarget emitLlvmIr String
field BuildTarget emitOptimizedLlvmIr Bool
field BuildTarget buildFolderName String
field BuildTarget cpuBaseline String
field BuildTarget cpuTune String
field BuildTarget cpuFeatureCheck String
field BuildTarget formatterLineWidth Int64
field BuildTarget linterMaxTier String
field BuildTarget docsOutput String
field BuildTarget nativeOutput String

record BuildMetadata
field BuildMetadata buildSource String
field BuildMetadata runtimeContract String

record BuildVersionInfo
field BuildVersionInfo version String
field BuildVersionInfo publisher String
field BuildVersionInfo description String
field BuildVersionInfo productName String
field BuildVersionInfo internalName String
field BuildVersionInfo originalFilename String
field BuildVersionInfo comments String
field BuildVersionInfo metadata BuildMetadata

record BuildConstant
field BuildConstant type String
field BuildConstant value String

record BuildConstants

record BuildPlatform
field BuildPlatform os String
field BuildPlatform arch String
field BuildPlatform cpuBaseline String
field BuildPlatform cpuTune String
field BuildPlatform nativeOutput String

record BuildPlan
field BuildPlan project BuildProject
field BuildPlan modules BuildModules
field BuildPlan mainModule String
field BuildPlan mainOperation String
field BuildPlan target BuildTarget
field BuildPlan versionInfo BuildVersionInfo
field BuildPlan constants BuildConstants

storage module immutable htmlTemplateLabBuildPlan BuildPlan
jsonBody htmlTemplateLabBuildPlan
  {
      "project": {
          "name": "HtmlTemplateLab",
          "id": "htmlTemplateLab",
          "modulePath": "github.com/monstercameron/SemanticScript/apps/html-template-lab",
          "languageVersion": "1.0",
          "projectVersion": "0.1.0",
          "license": "MIT",
          "sourceRoot": ".",
          "testPattern": "*.test.sem",
          "testRoot": "."
      },
      "modules": {
          "main": {
              "moduleName": "app.html_template_lab",
              "sourcePath": ".",
              "mainFile": "main.sem"
          },
          "shared": {
              "moduleName": "app.html_template_lab.shared",
              "sourcePath": "modules/shared",
              "mainFile": "main.sem"
          },
          "todo_domain": {
              "moduleName": "app.html_template_lab.todo_domain",
              "sourcePath": "modules/todo-domain",
              "mainFile": "main.sem"
          },
          "todo_components": {
              "moduleName": "app.html_template_lab.todo_components",
              "sourcePath": "modules/todo-components",
              "mainFile": "main.sem"
          },
          "todo_pages": {
              "moduleName": "app.html_template_lab.todo_pages",
              "sourcePath": "modules/todo-pages",
              "mainFile": "main.sem"
          }
      },
      "mainModule": "main",
      "target": {
          "runtime": "nativeExe",
          "nativeRuntime": "native",
          "nativeRuntimeVersion": 1,
          "profile": "dev",
          "optLevel": 2,
          "runtimeChecks": "panic",
          "persistLlvmIr": "yes",
          "emitLlvmIr": "auto",
          "emitOptimizedLlvmIr": false,
          "buildFolderName": "build",
          "cpuBaseline": "native",
          "cpuTune": "generic",
          "cpuFeatureCheck": "auto",
          "formatterLineWidth": 100,
          "linterMaxTier": "T4",
          "docsOutput": "docs",
          "nativeOutput": "html-template-lab",
          "platforms": [
              { "os": "macos",   "arch": "arm64",  "cpuBaseline": "native",    "cpuTune": "generic", "nativeOutput": "html-template-lab" },
              { "os": "macos",   "arch": "x86_64", "cpuBaseline": "x86_64_v2", "cpuTune": "generic", "nativeOutput": "html-template-lab-x86_64" },
              { "os": "linux",   "arch": "x86_64", "cpuBaseline": "x86_64_v2", "cpuTune": "generic", "nativeOutput": "html-template-lab-linux" },
              { "os": "linux",   "arch": "riscv64","cpuBaseline": "generic",   "cpuTune": "generic", "nativeOutput": "html-template-lab-riscv64" },
              { "os": "windows", "arch": "x86_64", "cpuBaseline": "x86_64_v2", "cpuTune": "generic", "nativeOutput": "html-template-lab.exe" }
          ]
      },
      "versionInfo": {
          "version": "0.1.0.0",
          "publisher": "Earl Cameron",
          "description": "SemanticScript first-class HTML/SSX console demo.",
          "productName": "HTML Template Lab",
          "internalName": "html-template-lab",
          "originalFilename": "html-template-lab.exe",
          "comments": "Built from apps/html-template-lab using root-specific html template/html body syntax with bare holes.",
          "metadata": {
              "buildSource": "apps/html-template-lab/build.sem",
              "runtimeContract": "native 1"
          }
      },
      "constants": {},
      "mainOperation": "main"
  }

operation configureHtmlTemplateLabBuild
output operation configureHtmlTemplateLabBuild BuildPlan
memory configureHtmlTemplateLabBuild heap no
async configureHtmlTemplateLabBuild no
purpose operation configureHtmlTemplateLabBuild "Return the typed build plan for HtmlTemplateLab."
return value htmlTemplateLabBuildPlan
