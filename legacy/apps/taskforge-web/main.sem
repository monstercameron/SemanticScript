# TaskForge Web - production web app.
#
# This module composes the standard.http + standard.sqlite + standard.json +
# standard.bcrypt runtimes into a multi-user todo web app. Auth uses bcrypt
# cost 12 password hashes + server-side sessions; data is per-user-scoped.

module app.taskforge_web
purpose module app.taskforge_web "Multi-user todo web app: bcrypt-cost-12 authenticated sessions over standard.http + standard.sqlite + standard.json, with per-user data isolation and a JSON REST API."
moduleOwns app.taskforge_web "Route table for /health and /api/*, sqlite schema (users + sessions + todos + todo_images tables), session cookie lifecycle, JSON response shapes, per-handler authorization gating."
moduleDoesNotOwn app.taskforge_web "HTTP dispatch (standard.http runtime), bcrypt algorithm (third_party/bcrypt via standard.bcrypt), sqlite engine (third_party/sqlite via standard.sqlite), JSON serialization (standard.json runtime), HTML templating (standard.html)."
invariant module app.taskforge_web "Every /api/* handler except /health, /api/version, /api/auth/register and /api/auth/login MUST call requireSessionUserId BEFORE running any SQL, and MUST scope every SELECT/UPDATE/DELETE with `WHERE user_id = ?` bound to the returned user id."
moduleSecurity app.taskforge_web "Session cookies are HttpOnly + SameSite=Strict; the value is a 43-char base64url-encoded 32-byte sample from the platform CSPRNG via bcrypt.randomBytes. Login failures emit a generic message regardless of whether the username existed."
moduleWarning app.taskforge_web "One shared sqlite handle opened lazily on first request and used by every handler. Safe under the current blocking HTTP/1.1 backend (one request at a time); migrating to an async backend needs a per-thread connection pool."

import http standard.http
import sqlite standard.sqlite
import json standard.json
import bcrypt standard.bcrypt
import html standard.html
import log standard.log

typeLiteralEncoding SqlText utf8

# HomePageTemplate + homePageHandler live in their own folder module
# at modules/pages/main.sem. The import line is at the BOTTOM of this
# file (search for "importModule app.taskforge_web.pages") so the
# template's last html body / operation block doesn't leave a dangling
# current_op that subsequent purpose/input rows would mis-attribute.

# The webServer declaration verbs take string + int LITERALS today (the
# parser doesn't yet resolve identifiers in their tail args), so the
# host + port appear here AS literals - but the values MUST stay in
# sync with the serverHostText / serverPortNumber storage constants
# above AND with the `nativeHttpHost taskForgeWeb` / `nativeHttpPort
# taskForgeWeb` rows in build.sem. Drift between those three sites is
# the kind of bug the SS3612 lint rule will catch once it lands.
webServer taskForgeWebServer
purpose operation taskForgeWebServer "Host the TaskForge Web JSON REST API on localhost:18090; every API route except /, /health, /api/version, and /api/auth/{register,login} requires a valid session cookie."
serverHost taskForgeWebServer "127.0.0.1"
serverPort taskForgeWebServer 18090

route taskForgeWebServer GET "/" homePageHandler
route taskForgeWebServer GET "/dashboard" dashboardPageHandler
route taskForgeWebServer GET "/assets/:filename" staticAssetHandler
route taskForgeWebServer GET "/health" healthHandler
route taskForgeWebServer GET "/api/version" versionHandler
route taskForgeWebServer POST "/api/auth/register" registerHandler
route taskForgeWebServer POST "/api/auth/login" loginHandler
route taskForgeWebServer POST "/api/auth/logout" logoutHandler
route taskForgeWebServer GET "/api/auth/me" meHandler
route taskForgeWebServer GET "/api/todos" listTodosHandler
route taskForgeWebServer POST "/api/todos" createTodoHandler
route taskForgeWebServer GET "/api/todos/:id" showTodoHandler
route taskForgeWebServer DELETE "/api/todos/:id" deleteTodoHandler
route taskForgeWebServer POST "/api/todos/:id/complete" completeTodoHandler
route taskForgeWebServer POST "/api/todos/:id/uncomplete" uncompleteTodoHandler
# Wildcard route - the runtime pulls this out of the route table at
# config-build time and uses it as the 404 fallback. NOT a real
# pattern match; the path string "*" is a registered convention.
# Method GET is also a placeholder (the dispatcher ignores the method
# when invoking the not-found handler).
route taskForgeWebServer GET "*" notFoundPageHandler
routeTimeoutOptOut taskForgeWebServer "*" "The current blocking native HTTP adapter does not enforce source route deadlines; the process supervisor owns request timeouts for this app."
routeMiddlewareOptOut taskForgeWebServer "*" "TaskForge routes dispatch directly; session and authorization gates are explicit inside the handlers that require them."

# ===== capabilities =====

# capability NAME EFFECT_PATH ACCESS - EFFECT first, ACCESS second, matching
# the lint's `_check_effect_authority_coverage` lookup shape (the operation
# effect row is `effect OP ACTION TARGET`, and lint checks
# `_access_covers(cap.access, action) AND _effect_path_covers(cap.effect, target)`).
capability bcryptHashCompute bcryptHash compute
purpose operation bcryptHashCompute "Authority to run the bcrypt password hashing key schedule at cost 12."

capability bcryptRandomCompute bcryptRandom compute
purpose operation bcryptRandomCompute "Authority to draw bytes from the platform CSPRNG via bcrypt.randomBytes - used to mint session tokens."

capability heapAllocCapability heap allocate
purpose operation heapAllocCapability "Authority to allocate per-request scratch buffers (JSON builder, base64url output, etc.)."

capability heapFreeCapability heap free
purpose operation heapFreeCapability "Authority to free the same buffers via defer c.free at handler exit."

capability jsonDocumentReadCapability json.document.tree read
purpose operation jsonDocumentReadCapability "Authority to parse and read request JSON through the standard.json document cursor API."

capability jsonDocumentWriteCapability json.document.tree write
purpose operation jsonDocumentWriteCapability "Authority to build response JSON through the standard.json document mutator API."

capability filesystemCreateCapability filesystem create
purpose operation filesystemCreateCapability "Authority to create the build/images/ directory at startup."

capability filesystemReadCapability filesystem read
purpose operation filesystemReadCapability "Authority to read files from the app assets directory for static response serving."

capability filesystemReadWriteCapability filesystem readWrite
purpose operation filesystemReadWriteCapability "Authority to append structured log records through standard.log."

capability memoryBufferReadWriteCapability memory.buffer readWrite
purpose operation memoryBufferReadWriteCapability "Authority to read and write the in-op scratch buffers - register/login zero the password scratch via c.memset before c.free; the JSON document and snprintf paths also touch buffer memory."

capability httpRequestReader http.request read
purpose operation httpRequestReader "Authority to read request path, headers, cookies, and body text from the incoming HttpRequest."

capability httpResponseWriter http.response write
purpose operation httpResponseWriter "Authority to write status, headers, files, and response bodies to the HttpResponse."

capability sqliteDatabaseReader database read
purpose operation sqliteDatabaseReader "Authority to execute read-only SQLite statements against the shared database handle."

capability sqliteDatabaseReadWriter database readWrite
purpose operation sqliteDatabaseReadWriter "Authority to execute schema, read, and write SQLite statements against the shared database handle."

# ===== module-scope constants =====

# ===== shared module-scope env (project-wide source of truth) =====
#
# These five constants are the only place in the app that names the
# host, port, database storage path, assets directory, and images
# directory. Sub-modules (currently just app.taskforge_web.pages, but
# extensible) read them by referencing the same name - so an env
# change here propagates without per-module shifting. The webServer
# declaration below ALSO uses serverHostText / serverPortNumber, and
# build.sem's `nativeHttpHost` / `nativeHttpPort` rows are documented
# as needing to match (lint enforcement of that linkage is a v1.1
# follow-up - see SS3612 in the linter spec roadmap).
#
# DATABASE STORAGE MODE: flip databaseUsePersistentStorage between
#   - "yes" -> durable file at databasePath (default; sessions + todos
#     survive restarts)
#   - "no"  -> in-memory only via ":memory:" (zero on-disk footprint,
#     ideal for tests; every restart resets everything including the
#     seeded demo user)
# Currently the runtime uses databasePath unconditionally; the
# in-memory mode flag is read by the test harness to start with a
# clean slate per run.
storage module immutable serverHostText String "127.0.0.1"
storage module immutable serverPortNumber Int32 18090
storage module immutable apiBaseUrlText String "http://127.0.0.1:18090"

storage module immutable databaseUsePersistentStorage String "yes"
storage module immutable databasePath String "taskforge_web.db"
storage module immutable databaseInMemoryPath String ":memory:"

storage module immutable imagesDirectoryPath String "images"
# Root directory for static assets. Native webServer entrypoints switch the
# process working directory to the executable directory at startup, so assets/
# must live alongside the exe (the post-build step in scripts/test_taskforge_web.py
# copies the source tree's apps/taskforge-web/assets/ into build/assets/).
storage module immutable assetsDirectoryPath String "assets"
storage module immutable assetFilenameParam String "filename"

storage module immutable httpStatusOk HttpStatusCode 200
storage module immutable httpStatusCreated HttpStatusCode 201
storage module immutable httpStatusNoContent HttpStatusCode 204
storage module immutable httpStatusBadRequest HttpStatusCode 400
storage module immutable httpStatusUnauthorized HttpStatusCode 401
storage module immutable httpStatusNotFound HttpStatusCode 404
storage module immutable httpStatusConflict HttpStatusCode 409
storage module immutable httpStatusInternalServerError HttpStatusCode 500
storage module immutable jsonContentType HttpContentType "application/json; charset=utf-8"
storage module immutable bcryptRecommendedCost Int32 12

storage module immutable jsonResponseCapacity Int64 4096
storage module immutable jsonDocumentCapacity JsonCapacityBytes 65536
storage module immutable jsonObjectRootKind JsonValueKind 0
storage module immutable jsonArrayRootKind JsonValueKind 1
storage module immutable usernameScratchCapacity Int64 64
storage module immutable passwordScratchCapacity Int64 256
storage module immutable displayNameScratchCapacity Int64 128
storage module immutable titleScratchCapacity Int64 512
storage module immutable bodyScratchCapacity Int64 10240
storage module immutable hashBufferCapacity Int64 64
storage module immutable hashCapacityArg Int32 61
storage module immutable randomBufferCapacity Int64 32
storage module immutable randomByteCountArg Int32 32
storage module immutable tokenBufferCapacity Int64 64
storage module immutable tokenCapacityArg Int32 64
storage module immutable lengthOutBufferByteCount ByteCount 8
# Set-Cookie buffer capacity. Actual content is "session=" (8) + 43-char
# base64url token + "; Path=/; HttpOnly; SameSite=Strict; Max-Age=2592000"
# (51) = 102 chars + NUL. 128 leaves 25-byte headroom while staying in the
# small malloc size class. Old value was 256, more than double what's
# needed - pulled the alloc into a larger slab tier on every register/login.
storage module immutable cookieHeaderCapacity Int64 128

# Structured-log bootstrap constants. The web server writes one
# JSON-per-line audit file at `<cwd>/logs/log.log` - for a build/-launched
# exe that means `apps/taskforge-web/build/logs/log.log`. The directory is
# created lazily on first request; the log file is opened in append mode
# so re-running the server preserves history across restarts.
storage module immutable logsDirectoryPath String "logs"
storage module immutable logFilePath String "logs/log.log"
storage module immutable serverStartLogMessage String "server.started"
storage module immutable userRegisteredLogMessage String "user.registered"
storage module immutable userLoginSucceededLogMessage String "user.login.succeeded"
storage module immutable userLoginFailedLogMessage String "user.login.failed"
storage module immutable userLogoutLogMessage String "user.logout"
storage module immutable todoCreatedLogMessage String "todo.created"
storage module immutable todoCompletedLogMessage String "todo.completed"
storage module immutable todoUncompletedLogMessage String "todo.uncompleted"
storage module immutable todoDeletedLogMessage String "todo.deleted"

# Accumulator for the full {"todos":[...],"count":N} response. Sized at 32 KiB
# (down from 64 KiB): the SQL LIMIT caps the body at 100 rows x ~200 bytes/row
# (~20 KiB typical) and the schema CHECK on title length keeps the per-row
# upper bound bounded. 32 KiB is ~60% headroom over typical and ~1.5x the
# realistic worst case, while staying in the smaller malloc size class -
# most allocators step 16->32->64 KiB, so 64 KiB pulled a fresh page span on
# every request where 32 KiB fits in an existing slab. snprintf into the
# cursor still clamps at remaining capacity, so a degenerate oversized row
# truncates its tail rather than overflowing the accumulator.
storage module immutable todosListBufferCapacity Int64 32768

storage module immutable sessionLifetimeMs Int64 2592000000
storage module immutable jsonOk Int32 0
# Idiomatic Bool literals. The earlier `trueBit/falseBit` i32 pair was a
# C-ism left over from when this module used i32 0/1 to model booleans.
# Use these where a Bool-typed value is required (json.setObjectFieldBool,
# branchIf operands, etc).
storage module immutable boolFalse Bool false
storage module immutable boolTrue Bool true

storage module immutable cookieNameSession String "session"
storage module immutable setCookieHeaderName String "Set-Cookie"

# Cookie attribute suffix appended after the token in Set-Cookie.
storage module immutable cookieAttributeSuffix String "; Path=/; HttpOnly; SameSite=Strict; Max-Age=2592000"
storage module immutable cookieClearSuffix String "session=; Path=/; HttpOnly; SameSite=Strict; Max-Age=0"

# Timing-equalization dummy hash used by loginHandler when the requested
# username does not exist. Running bcrypt.verifyPassword against this
# bogus 60-char $2b$12$ hash forces the same ~250 ms work the real-user
# path performs, so an attacker cannot distinguish "no such user" from
# "user exists, wrong password" via response latency. The value below
# is a real bcrypt hash of a long random string the server does not
# know - it cannot collide with any real password by construction.
storage module immutable loginTimingEqualizationDummyHash String "$2b$12$ZzZzZzZzZzZzZzZzZzZzZuQpkkqYZL.YxR5gG3yq2cTQyL3KkLjmS"

# Length of a base64url-encoded 32-byte session token. The schema's
# `sessions.token CHECK(length = 43)` enforces this at INSERT time;
# requireSessionUserId also enforces it on cookie read so an attacker
# cannot ship an unbounded cookie value into a SQL bind.
storage module immutable sessionTokenExactLength Int64 43

# Password length bounds. bcrypt silently truncates input at 72 bytes,
# so we reject anything beyond that to make the user's full password
# meaningful for hashing. The lower bound is a soft password-policy
# floor; the schema does not enforce it, so we check it at the handler.
storage module immutable passwordMinimumLength Int64 8
storage module immutable passwordMaximumLength Int64 72
storage module immutable cookieNameEquals String "session="

# Single format string for the Set-Cookie header. The three %s slots fold in
# `cookieNameEquals` (cookie prefix), the runtime session token, and
# `cookieAttributeSuffix` (cookie attribute tail) - all already at module
# scope. Composing from existing constants eliminates the duplicated
# "session=...; Path=...; Max-Age=..." literal the register/login handlers
# used to each carry as a local immutable string, saving ~75 bytes of
# .rodata per handler and keeping the cookie content auditable from a
# single source.
storage module immutable cookieHeaderTripleFormat String "%s%s%s"

# Field names for JSON parsing / building.
storage module immutable fieldUsername String "username"
storage module immutable fieldPassword String "password"
storage module immutable fieldDisplayName String "displayName"
storage module immutable fieldTitle String "title"
storage module immutable fieldBody String "body"
storage module immutable fieldPriority String "priority"
storage module immutable fieldUser String "user"
storage module immutable fieldTodo String "todo"
storage module immutable fieldTodos String "todos"
storage module immutable fieldCount String "count"
storage module immutable fieldId String "id"
storage module immutable fieldDone String "done"
storage module immutable fieldCreatedAtMs String "createdAtMs"
storage module immutable fieldUpdatedAtMs String "updatedAtMs"
storage module immutable fieldCompletedAtMs String "completedAtMs"

# Static JSON success response bodies. `jsonBody` validates and canonicalizes
# these constants at compile time.
storage module immutable healthBodyJson JsonText
jsonBody healthBodyJson
  {"status":"ok","app":"taskforge-web"}

storage module immutable versionBodyJson JsonText
jsonBody versionBodyJson
  {"name":"taskforge-web","version":"1.0.0","bcryptCost":12}

storage module immutable logoutResponseBody JsonText
jsonBody logoutResponseBody
  {"ok":true}

storage module immutable deleteOkBody JsonText
jsonBody deleteOkBody
  {"ok":true}

storage module immutable completeOkBody JsonText
jsonBody completeOkBody
  {"ok":true,"done":true}

storage module immutable uncompleteOkBody JsonText
jsonBody uncompleteOkBody
  {"ok":true,"done":false}

# ===== schema (literal-loaded at compile time) =====
# `literal NAME TYPE` declares the const slot; `literalSource NAME "path"`
# tells semsc to read the bytes from disk at compile time and replace the
# stub value. `literalBytes`, `literalDigest`, and `literalTrust` pin the
# size, integrity, and trust class for tooling.

literal schemaSqlSource SqlText
literalSource schemaSqlSource "sql/schema.sql"
literalBytes schemaSqlSource 2818
literalDigest schemaSqlSource sha256 7be6b231400defe17895a69ecad2aec2aad4c31cd6025805848819464dabf725
literalTrust schemaSqlSource trustedStaticAsset

# Dev-only seed data (demo user + sample todos). Loaded into the schema
# load path BUT only executed when the build constant `applyDevSeed`
# is "yes". Production deployments set applyDevSeed to "no" via
# build.sem so the publicly-known demo credentials are never installed.
literal devSeedSqlSource SqlText
literalSource devSeedSqlSource "sql/dev-seed.sql"
literalBytes devSeedSqlSource 1869
literalDigest devSeedSqlSource sha256 d8a462c8ae355891b0453883ec8a034c3689f0fe6ff81f514455d5e7b9bc6d72
literalTrust devSeedSqlSource trustedStaticAsset

# Sentinel string the build constant `applyDevSeed` is compared against
# at runtime. Dev builds set the constant to "yes"; production builds
# set it to "no".
storage module immutable applyDevSeedEnabledSentinel String "yes"

# Fallback declaration of `applyDevSeed` for the case where main.sem is
# parsed standalone (without a build.sem providing the project-wide
# buildConstant). The build.sem row overrides this at project build
# time. Default is "no" - fail-safe for direct invocation.
storage module immutable applyDevSeed String "no"

# ===== shared database handle (lazy-opened on first request) =====

storage module mutable sharedDatabaseHandle SqliteDatabase 0
storage module mutable sharedDatabaseReady Int32 0

# ===== SQL statement constants =====

storage module immutable sqlInsertUser SqlText
sql body sqlInsertUser
  INSERT INTO users (username, password_hash, display_name, created_at_ms, last_login_ms) VALUES (?, ?, ?, ?, ?) RETURNING id
storage module immutable sqlInsertSession SqlText
sql body sqlInsertSession
  INSERT INTO sessions (token, user_id, issued_at_ms, expires_at_ms, last_seen_ms) VALUES (?, ?, ?, ?, ?)
storage module immutable sqlSelectUserByUsername SqlText
sql body sqlSelectUserByUsername
  SELECT id, username, password_hash, display_name FROM users WHERE username = ? COLLATE NOCASE LIMIT 1
storage module immutable sqlSelectSessionByToken SqlText
sql body sqlSelectSessionByToken
  SELECT user_id, expires_at_ms FROM sessions WHERE token = ? LIMIT 1
storage module immutable sqlSelectUserById SqlText
sql body sqlSelectUserById
  SELECT id, username, display_name FROM users WHERE id = ? LIMIT 1
storage module immutable sqlDeleteSessionByToken SqlText
sql body sqlDeleteSessionByToken
  DELETE FROM sessions WHERE token = ?
storage module immutable sqlDeleteExpiredSessions SqlText
sql body sqlDeleteExpiredSessions
  DELETE FROM sessions WHERE expires_at_ms <= ?
storage module immutable sqlUpdateLastLogin SqlText
sql body sqlUpdateLastLogin
  UPDATE users SET last_login_ms = ? WHERE id = ?
storage module immutable sqlInsertTodo SqlText
sql body sqlInsertTodo
  INSERT INTO todos (user_id, title, body, done, priority, created_at_ms, updated_at_ms) VALUES (?, ?, ?, 0, ?, ?, ?) RETURNING id
storage module immutable sqlSelectTodosByUser SqlText
sql body sqlSelectTodosByUser
  SELECT id, title, body, done, priority, created_at_ms, updated_at_ms, completed_at_ms FROM todos WHERE user_id = ? ORDER BY created_at_ms DESC LIMIT 100
# sqlSelectTodoByIdAndUser was previously declared here for the
# showTodoHandler stub that returns 501; SS3415 flagged it as dead
# code. Re-add when showTodoHandler is implemented.
storage module immutable sqlDeleteTodoByIdAndUser SqlText
sql body sqlDeleteTodoByIdAndUser
  DELETE FROM todos WHERE id = ? AND user_id = ?
storage module immutable sqlCompleteTodoByIdAndUser SqlText
sql body sqlCompleteTodoByIdAndUser
  UPDATE todos SET done = 1, completed_at_ms = ?, updated_at_ms = ? WHERE id = ? AND user_id = ?
# Inverse of sqlCompleteTodoByIdAndUser: marks a todo open again. We
# clear completed_at_ms so the audit trail reflects the un-complete; the
# bind order matches completeTodoHandler (?1 = updated_at_ms, ?2 = id,
# ?3 = user_id) so callers can reuse the bindIndex1/2/3 constants.
storage module immutable sqlUncompleteTodoByIdAndUser SqlText
sql body sqlUncompleteTodoByIdAndUser
  UPDATE todos SET done = 0, completed_at_ms = NULL, updated_at_ms = ? WHERE id = ? AND user_id = ?

# Transaction control statements used by registerHandler so the user
# INSERT and session INSERT either both commit or both roll back; the
# old `invariant` admitted "user row may persist if session insert
# fails - acceptable for v1", which is the race this closes.
# `BEGIN IMMEDIATE` acquires the write lock upfront so a second writer
# in the same process cannot race the pair under WAL mode.
storage module immutable sqlBeginTransaction SqlText
sql body sqlBeginTransaction
  BEGIN IMMEDIATE
storage module immutable sqlCommitTransaction SqlText
sql body sqlCommitTransaction
  COMMIT
storage module immutable sqlRollbackTransaction SqlText
sql body sqlRollbackTransaction
  ROLLBACK

# Bind parameter indices.
storage module immutable bindIndex1 Int32 1
storage module immutable bindIndex2 Int32 2
storage module immutable bindIndex3 Int32 3
storage module immutable bindIndex4 Int32 4
storage module immutable bindIndex5 Int32 5

# Column indices.
storage module immutable columnIndex0 Int32 0
storage module immutable columnIndex1 Int32 1
storage module immutable columnIndex2 Int32 2
storage module immutable columnIndex3 Int32 3
storage module immutable columnIndex4 Int32 4
storage module immutable columnIndex5 Int32 5
storage module immutable columnIndex6 Int32 6
storage module immutable columnIndex7 Int32 7

# Default todo priority used when the request body omits it.
storage module immutable defaultPriority Int64 2

# ===== lifecycle =====

operation openOrReuseDatabase
output operation openOrReuseDatabase Result SqliteDatabase Int32
effect openOrReuseDatabase readWrite database
effect openOrReuseDatabase create filesystem
effect openOrReuseDatabase read filesystem
effect openOrReuseDatabase write filesystem
effect openOrReuseDatabase readWrite filesystem
effect openOrReuseDatabase open filesystem
effect openOrReuseDatabase open file
effect openOrReuseDatabase close file
effect openOrReuseDatabase readWrite memory.buffer
effect openOrReuseDatabase allocate heap
effect openOrReuseDatabase free heap
authority openOrReuseDatabase create filesystem
authority openOrReuseDatabase read filesystem
authority openOrReuseDatabase write filesystem
authority openOrReuseDatabase open filesystem
authority openOrReuseDatabase open file
authority openOrReuseDatabase close file
useCapability openOrReuseDatabase sqliteDatabaseReadWriter
useCapability openOrReuseDatabase filesystemCreateCapability
useCapability openOrReuseDatabase filesystemReadWriteCapability
useCapability openOrReuseDatabase memoryBufferReadWriteCapability
useCapability openOrReuseDatabase heapAllocCapability
useCapability openOrReuseDatabase heapFreeCapability
memory openOrReuseDatabase heap auto
async openOrReuseDatabase no
purpose operation openOrReuseDatabase "Return the shared SqliteDatabase handle, lazily opening + applying the schema on first call. Idempotent: subsequent calls return the cached handle."
invariant operation openOrReuseDatabase "sharedDatabaseReady=1 implies sharedDatabaseHandle is a valid open SqliteDatabase. The first caller wins the open; concurrent opens are impossible under the blocking HTTP/1.1 backend."

label startOpenOrReuseDatabase

call readinessCheckCall math.equalInt32
argument readinessCheckCall left Int32 sharedDatabaseReady
argument readinessCheckCall right Int32 jsonOk
run readinessCheckCall
bind value sharedDatabaseNotReady Bool readinessCheckCall
branch if condition sharedDatabaseNotReady target performInitialOpen

return ok sharedDatabaseHandle

label performInitialOpen

call ensureImagesDirCall http.ensureDirectory
argument ensureImagesDirCall directoryPath String imagesDirectoryPath
run ensureImagesDirCall
ignore ok source ensureImagesDirCall type Int32

# Bootstrap the structured-log file alongside the images dir. Both
# need to happen exactly once at server start; co-locating them in
# the lazy-init path means a refine that adds another startup-once
# step has a single obvious home.
call ensureLogsDirCall http.ensureDirectory
argument ensureLogsDirCall directoryPath String logsDirectoryPath
run ensureLogsDirCall
ignore ok source ensureLogsDirCall type Int32

call openLogFileCall log.openLogFile
argument openLogFileCall filePath String logFilePath
run openLogFileCall
ignore ok source openLogFileCall type Int32

call serverStartLogCall log.logInfo
argument serverStartLogCall messageText String serverStartLogMessage
run serverStartLogCall
ignore ok source serverStartLogCall type Int32

call openCall sqlite.openDatabase
argument openCall path String databasePath
argument openCall mode SqliteOpenMode readWriteCreateSqliteOpenMode
run openCall
bind ok freshDatabase SqliteDatabase openCall
bind error databaseOpenError SqliteDatabaseOpenFailure openCall
branch error source openCall target databaseOpenFailed

call applySchemaCall sqlite.exec
argument applySchemaCall database SqliteDatabase freshDatabase
argument applySchemaCall sql SqlText schemaSqlSource
run applySchemaCall
ignore void source applySchemaCall
bind error schemaApplyError SqliteDatabaseExecFailure applySchemaCall
branch error source applySchemaCall target schemaApplyFailed

# Dev seed: only apply when the build constant `applyDevSeed` equals
# "yes". Production builds (set via build.sem) skip the demo user +
# sample todos entirely. c.strcmp returns 0 on equal strings.
call applyDevSeedCompareCall c.strcmp
argument applyDevSeedCompareCall left String applyDevSeed
argument applyDevSeedCompareCall right String applyDevSeedEnabledSentinel
run applyDevSeedCompareCall
bind value applyDevSeedCompareResult Int32 applyDevSeedCompareCall

storage local immutable applyDevSeedEqualSentinel Int32 0
call applyDevSeedShouldRunCheckCall math.equalInt32
argument applyDevSeedShouldRunCheckCall left Int32 applyDevSeedCompareResult
argument applyDevSeedShouldRunCheckCall right Int32 applyDevSeedEqualSentinel
run applyDevSeedShouldRunCheckCall
bind value applyDevSeedShouldRun Bool applyDevSeedShouldRunCheckCall
branch if condition applyDevSeedShouldRun target applyDevSeedRunStep
branch else target devSeedSkippedLabel

label applyDevSeedRunStep
call applyDevSeedCall sqlite.exec
argument applyDevSeedCall database SqliteDatabase freshDatabase
argument applyDevSeedCall sql SqlText devSeedSqlSource
run applyDevSeedCall
ignore void source applyDevSeedCall
bind error applyDevSeedError SqliteDatabaseExecFailure applyDevSeedCall
branch error source applyDevSeedCall target schemaApplyFailed

label devSeedSkippedLabel

set storage sharedDatabaseHandle freshDatabase
storage local immutable readyMarker Int32 1
set storage sharedDatabaseReady readyMarker

return ok freshDatabase

label databaseOpenFailed
return error databaseOpenError

label schemaApplyFailed
# Best-effort cleanup: we already have a fatal schema error to return,
# so a secondary close failure is uninteresting. We still wire the
# strict checked-call shape (bindError + branchIfError to the same
# return label) so SS3201 sees a real failure disposition rather than
# a silent drop, even though the dispositions both reach the same exit.
call closeFreshDatabaseAfterSchemaFailureCall sqlite.closeDatabase
argument closeFreshDatabaseAfterSchemaFailureCall database SqliteDatabase freshDatabase
run closeFreshDatabaseAfterSchemaFailureCall
ignore void source closeFreshDatabaseAfterSchemaFailureCall
bind error closeFreshAfterSchemaFailureCloseError SqliteDatabaseCloseFailure closeFreshDatabaseAfterSchemaFailureCall
branch error source closeFreshDatabaseAfterSchemaFailureCall target schemaInitialErrorReported

label schemaInitialErrorReported
return error schemaApplyError

# ===== JSON response helpers =====

operation writeJsonOkResponse
input operation writeJsonOkResponse response HttpResponse
input operation writeJsonOkResponse status HttpStatusCode
input operation writeJsonOkResponse jsonBody String
output operation writeJsonOkResponse Int32
effect writeJsonOkResponse write http.response
useCapability writeJsonOkResponse httpResponseWriter
memory writeJsonOkResponse arena request
async writeJsonOkResponse no
purpose operation writeJsonOkResponse "Write a JSON body with the application/json content-type header."
invariant operation writeJsonOkResponse "Always passes jsonContentType to http.responseText. Body forwarded verbatim - caller responsible for JSON validity."
responseBodyForwarder writeJsonOkResponse jsonBody

label startWriteJsonOkResponse
call writeResponseCall http.responseText
