# ============================================================
# SEMANTICSCRIPT STANDARD LIBRARY: native HTTP server namespace
# ============================================================
#
# Import this module with:
#
#   import http standard.http
#
# The legacy `http.response*` and `http.request*` call targets are
# compiler/runtime-owned intrinsics. Streaming SSE is exposed as ordinary
# standard-library operations that delegate to generic native runtimeBinding
# symbols, so the compiler does not need SSE-specific lowering.

# rationale: import as `import http standard.http` for native HTTP route
#   handlers, response writing, SSE streams, graceful-shutdown checks,
#   blocking outbound HTTP calls, and HTML escaping.
# invariant: exported wrappers such as openSseStream,
#   writeSseEventWithId, clientDisconnected, serverIsShuttingDown,
#   clientGet, clientPost, and escapeHtml are the public API. Direct
#   *Native runtimeBinding operations are internal hooks.
# memory: clientGet and clientPost return heap-owned HttpClientResponseBody values; free non-null bodies with c.free on every ownership path.
# failure: SSE and response wrappers return native Int32 status codes; clientGet/clientPost return null on transport failure or non-2xx until a typed Result API exists.
# security: headerLine, body, and escapeHtml scratch buffers are caller-provided trust boundaries; validate header syntax and buffer capacity before calling.

module standard.http
nativeRuntimeSource standard.http "SemanticScript/runtime/native_http/sem_http_runtime.c"
nativeRuntimeLinkArg standard.http windows "-lws2_32"
purpose module standard.http "Standard-library namespace and contracts for native HTTP server request and response intrinsics."
moduleOwns standard.http "The official import path `standard.http`, semantic HTTP type aliases, reusable HTTP capabilities, SSE stream operation wrappers, handler-visible server drain-state wrappers, and the compiler-owned legacy `http.*` intrinsic namespace contract."
moduleDoesNotOwn standard.http "Application routes, handler implementations, middleware order, native HTTP runtime implementation, or generated route dispatch."
invariant module standard.http "The standard module entry is this file; new modules may import it as alias `http`; SSE operation bodies delegate through runtimeBinding rows rather than compiler target branches."
moduleSecurity standard.http "Set-Cookie headers that carry authentication/session tokens SHOULD include HttpOnly and SameSite, and include Secure only when the request is known to have arrived over HTTPS. The native HTTP/1.1 adapter does not terminate TLS; behind a trusted TLS proxy, read X-Forwarded-Proto only after the ingress strips and sets that header."

type HttpStatusCode Int32
type HttpHeaderName String
type HttpHeaderValue String
type HttpContentType String
type HttpTextBody String
type HttpByteBody OpaquePointer
type HttpBodyLength ByteCount
type HttpRequestValue String
type SessionTtlMillis Int64
type SessionExpiresAtMillis Int64
type SseEventName String
type SseEventId Int64
type SseEventData String
type SseHeartbeatComment String
type HttpClientResponseBody String

