typeInvariant HttpStatusCode "HTTP response status code passed to native response writers."
typeInvariant HttpHeaderName "Header name passed to native response header writers."
typeInvariant HttpHeaderValue "Header value passed to native response header writers. For Set-Cookie, prefer the exported HttpOnly/SameSite suffix constants and add Secure only after trusted TLS detection (direct HTTPS in a future TLS backend, or trusted-proxy X-Forwarded-Proto = https today)."
typeInvariant HttpContentType "Content-Type value passed to native response body writers."
typeInvariant HttpTextBody "Null-terminated text body passed to native text response writers."
typeInvariant HttpByteBody "Opaque byte buffer passed to native byte response writers with an explicit length."
typeInvariant HttpBodyLength "Byte count paired with HttpByteBody."
typeInvariant HttpRequestValue "Request-derived string value returned by native request readers; nullable readers must be guarded before response-body use."
typeInvariant SessionTtlMillis "Session time-to-live in milliseconds. Prefer immutable Int64 constants passed through SessionTtlMillis argument rows; default policy is sessionDefaultTtlMillis."
typeInvariant SessionExpiresAtMillis "Absolute Unix epoch millisecond timestamp when a session expires. Produce with http.sessionExpiresAt and test with http.sessionIsExpired."
typeInvariant SseEventName "Server-Sent Event name without CR, LF, or colon."
typeInvariant SseEventId "Server-Sent Event id emitted as a decimal cursor value; negative ids are rejected by the native stream writer."
typeInvariant SseEventData "Server-Sent Event data payload; native framing splits embedded newlines into data lines."
typeInvariant SseHeartbeatComment "Server-Sent Event heartbeat comment without CR or LF."
typeInvariant HttpClientResponseBody "Null-terminated outbound-HTTP response body; heap-owned by the caller (free via c.free). Null on transport error or non-2xx."

capability httpRequestReader http.request read
purpose operation httpRequestReader "Authority to read fields off the incoming HttpRequest (method, path, headers, cookies, query params, body, multipart parts)."

capability httpResponseWriter http.response write
purpose operation httpResponseWriter "Authority to write headers and a body to the HttpResponse handed to the route handler (http.responseHtml/Text/Bytes/SseEvent/File and http.responseHeader)."

capability httpResponseReader http.response read
purpose operation httpResponseReader "Authority to inspect native response stream state such as SSE disconnect status."

capability httpClientCaller http.client read
purpose operation httpClientCaller "Authority to make outbound blocking HTTP/1.1 client requests to other services."
capability httpEscapeBufferWriter memory.buffer readWrite
purpose operation httpEscapeBufferWriter "Authority to write escaped HTML into a caller-provided scratch buffer."
capability httpServerStateReader http.server read
purpose operation httpServerStateReader "Authority to inspect native HTTP server process state such as graceful-shutdown drain mode."

storage module immutable httpModuleVersionText HttpTextBody "standard.http 0.1"
storage module immutable plainTextContentType HttpContentType "text/plain; charset=utf-8"
storage module immutable htmlContentType HttpContentType "text/html; charset=utf-8"
storage module immutable jsonContentType HttpContentType "application/json; charset=utf-8"
storage module immutable sseContentType HttpContentType "text/event-stream; charset=utf-8"
storage module immutable setCookieHeaderName HttpHeaderName "Set-Cookie"
storage module immutable cookieSecureHttpOnlySameSiteLaxSuffix HttpHeaderValue "; Secure; HttpOnly; SameSite=Lax"
storage module immutable cookieHttpOnlySameSiteLaxSuffix HttpHeaderValue "; HttpOnly; SameSite=Lax"
storage module immutable forwardedProtoHeaderName HttpHeaderName "x-forwarded-proto"
storage module immutable forwardedProtoHttpsValue HttpHeaderValue "https"
storage module immutable sessionDefaultTtlMillis Int64 86400000
storage module immutable cacheControlHeaderName HttpHeaderName "Cache-Control"
storage module immutable etagHeaderName HttpHeaderName "ETag"
storage module immutable lastModifiedHeaderName HttpHeaderName "Last-Modified"
storage module immutable ifNoneMatchHeaderName HttpHeaderName "If-None-Match"
storage module immutable ifModifiedSinceHeaderName HttpHeaderName "If-Modified-Since"
storage module immutable staticAssetCacheControlHeaderValue HttpHeaderValue "public, max-age=60"
storage module immutable sseCacheControlHeaderName HttpHeaderName "Cache-Control"
storage module immutable sseCacheControlHeaderValue HttpHeaderValue "no-cache, no-transform"
storage module immutable sseAccelBufferingHeaderName HttpHeaderName "X-Accel-Buffering"
storage module immutable sseAccelBufferingHeaderValue HttpHeaderValue "no"
storage module immutable sseDefaultHeartbeatComment SseHeartbeatComment "heartbeat"
storage module immutable disconnectedCode Int32 1
storage module immutable shuttingDownCode Int32 1
storage module immutable httpClientMethodGet String "GET"
storage module immutable httpClientMethodPost String "POST"
storage module immutable httpClientEmptyBody String ""

# rationale: Session expiry should be source-visible policy, not ad hoc
#   timestamp arithmetic hidden in every handler. Apps read now with
#   http.nowMillis, add a TTL when creating a session, and compare the
#   stored expires-at value on each authenticated request.
# invariant: expiresAtMillis = nowMillis + ttlMillis. The helper is pure
#   integer arithmetic; persistence and clock reads stay in the caller.
operation sessionExpiresAt
input operation sessionExpiresAt nowMillis Int64
input operation sessionExpiresAt ttlMillis SessionTtlMillis
output operation sessionExpiresAt SessionExpiresAtMillis
memory sessionExpiresAt heap no
async sessionExpiresAt no
operationBody sessionExpiresAt runtimeBinding
purpose operation sessionExpiresAt "Add a session TTL to a current Unix epoch millisecond timestamp."
invariant operation sessionExpiresAt "Return value is nowMillis + ttlMillis; caller chooses the TTL policy and persists the result."
runtimeBindingPrecondition sessionExpiresAt "nowMillis is a Unix epoch millisecond timestamp and ttlMillis is the caller's session lifetime policy."
runtimeBinding sessionExpiresAt native.ss_http_session_expires_at

# rationale: Auth gates should branch on a named expiry helper instead of
#   repeating timestamp comparisons. The caller reads now with http.nowMillis,
#   loads the persisted expires-at timestamp, and rejects when this returns
#   true.
# invariant: A session is expired when nowMillis is strictly greater than
#   expiresAtMillis; equality remains valid until the next millisecond tick.
operation sessionIsExpired
input operation sessionIsExpired nowMillis Int64
input operation sessionIsExpired expiresAtMillis SessionExpiresAtMillis
output operation sessionIsExpired Bool
memory sessionIsExpired heap no
async sessionIsExpired no
operationBody sessionIsExpired runtimeBinding
purpose operation sessionIsExpired "Return true when the current Unix epoch millisecond timestamp is past the persisted session expiry."
invariant operation sessionIsExpired "Expired means nowMillis > expiresAtMillis; equality is still accepted."
runtimeBindingPrecondition sessionIsExpired "nowMillis and expiresAtMillis are Unix epoch millisecond timestamps from the same clock domain."
runtimeBinding sessionIsExpired native.ss_http_session_is_expired

# rationale: SSE handlers openSseStream first, then loop while not
#   clientDisconnected and not serverIsShuttingDown, then write events or
#   heartbeats, and closeSseStream when complete.
# failure: non-zero native status values are propagated as Int32; handlers decide whether that becomes route failure, retry, or silent disconnect handling.
# invariant: Application code owns replay/fanout semantics; this wrapper only sets generic SSE transport headers and delegates to the native stream primitive.
operation openSseStream
input operation openSseStream response HttpResponse
input operation openSseStream status HttpStatusCode
output operation openSseStream Int32
effect openSseStream write http.response
memory openSseStream arena request
async openSseStream no
useCapability openSseStream httpResponseWriter
purpose operation openSseStream "Open a streaming text/event-stream response with standard cache/proxy headers."
invariant operation openSseStream "Application code owns replay/fanout semantics; this wrapper only sets generic SSE transport headers and delegates to the native stream primitive."
label startOpenSseStream
call cacheHeaderCall http.responseHeader
argument cacheHeaderCall response HttpResponse response
argument cacheHeaderCall name HttpHeaderName sseCacheControlHeaderName
argument cacheHeaderCall value HttpHeaderValue sseCacheControlHeaderValue
run cacheHeaderCall
ignore value source cacheHeaderCall type Int32
call accelHeaderCall http.responseHeader
argument accelHeaderCall response HttpResponse response
argument accelHeaderCall name HttpHeaderName sseAccelBufferingHeaderName
argument accelHeaderCall value HttpHeaderValue sseAccelBufferingHeaderValue
run accelHeaderCall
ignore value source accelHeaderCall type Int32
call openCall openSseStreamNative
argument openCall response HttpResponse response
argument openCall status HttpStatusCode status
run openCall
bind value openStatus Int32 openCall
return value openStatus

# rationale: Low-level runtimeBinding hook used by standard.http openSseStream after semantic header setup.
operation openSseStreamNative
input operation openSseStreamNative response HttpResponse
input operation openSseStreamNative status HttpStatusCode
output operation openSseStreamNative Int32
effect openSseStreamNative write http.response
memory openSseStreamNative arena request
async openSseStreamNative no
useCapability openSseStreamNative httpResponseWriter
operationBody openSseStreamNative runtimeBinding
purpose operation openSseStreamNative "Low-level runtimeBinding hook used by standard.http openSseStream after semantic header setup."
runtimeBindingPrecondition openSseStreamNative "response is the active route response and status is a valid HTTP status code."
runtimeBinding openSseStreamNative native.ss_http_sse_open

