project StdHttpMetadataTest
target console
runtime AgentRuntime 0.1
entry console main

import http standard.http
importConstant importedPlainTextContentType http plainTextContentType
importCapability importedHttpResponseWriter http httpResponseWriter
importCapability importedHttpServerStateReader http httpServerStateReader

storage module immutable okText String "OK"
storage module immutable successCode ExitCode 0

operation main
output operation main ExitCode
effect main write console.stdout
authority main write console.stdout
memory main heap no
async main no
purpose operation main "Smoke-test the canonical standard.http import path, response capability, and shutdown drain-state capability from its module folder."

storage module immutable sessionNowMillis Int64 1000
storage module immutable sessionTtlMillis SessionTtlMillis 500
storage module immutable expectedExpiresAtMillis SessionExpiresAtMillis 1500
storage module immutable sessionExpiryFailureCode ExitCode 1

call sessionExpiresAtCall http.sessionExpiresAt
argument sessionExpiresAtCall nowMillis Int64 sessionNowMillis
argument sessionExpiresAtCall ttlMillis SessionTtlMillis sessionTtlMillis
run sessionExpiresAtCall
bind value actualExpiresAtMillis SessionExpiresAtMillis sessionExpiresAtCall
call sessionExpiresAtOkCall math.equalInt64
argument sessionExpiresAtOkCall left Int64 actualExpiresAtMillis
argument sessionExpiresAtOkCall right Int64 expectedExpiresAtMillis
run sessionExpiresAtOkCall
bind value sessionExpiresAtOk Bool sessionExpiresAtOkCall
branch if condition sessionExpiresAtOk target sessionExpiresAtHolds
branch else target sessionExpiryFailed
label sessionExpiresAtHolds

call writeCall console.writeLine
argument writeCall text String okText
run writeCall
ignore void source writeCall
bind error writeCallError Int32 writeCall
branch error source writeCall target writeFailed

return value successCode
label sessionExpiryFailed
return value sessionExpiryFailureCode
label writeFailed
return value writeCallError
