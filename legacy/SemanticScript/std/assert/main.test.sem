# ============================================================
# SEMANTICSCRIPT STDLIB TESTS: assert
# ============================================================
#
# Companion smoke + extended unit tests for std/assert/main.sem.
# Imports the assert module and asserts every require* operation
# (Equal / NotEqual / Greater / Less / WithinRange / NotNull /
# ConditionTrue). The diagnostic writers
# (emitAssertionFailureBanner / writeAssertionByteToStandardOutput)
# are NOT exercised â€” they would corrupt the expected "OK\n" stdout.
#
# Pattern: std/main.sem ships pure-module operations only;
# std/main.test.sem carries every smoke / unit test for it.

project StdAssertTest
target console
runtime AgentRuntime 0.1
entry console main

import assert standard.assert
error MainError
errorCase MainError AssertSmokeFailed
errorCase MainError ConsoleWriteFailed

# section capability
# rationale: smoke-test main writes a single OK line to stdout.
capability stdoutWriteCapability console.stdout write

# ============================================================
# Smoke test
# ============================================================

operation main
input operation main console Console
output operation main Result ExitCode MainError
useCapability main stdoutWriteCapability
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Smoke-test the typed-error assertion ports."
invariant operation main "Every assertion that should hold returns Ok; final exit is 0."

label startMain

# requireSignedInt64ValuesEqual(2 + 2, 4)
storage module immutable twoInt Int64 2
storage module immutable fourInt Int64 4
call addTwoPlusTwoCall math.addInt64
argument addTwoPlusTwoCall left Int64 twoInt
argument addTwoPlusTwoCall right Int64 twoInt
run addTwoPlusTwoCall
bind value twoPlusTwo Int64 addTwoPlusTwoCall
call assertEqualCall requireSignedInt64ValuesEqual
argument assertEqualCall leftValue Int64 twoPlusTwo
argument assertEqualCall rightValue Int64 fourInt
run assertEqualCall
branch error source assertEqualCall target smokeAssertionFailed

# requireSignedInt64ValuesNotEqual(1, 2)
storage module immutable oneInt Int64 1
call assertNotEqualCall requireSignedInt64ValuesNotEqual
argument assertNotEqualCall leftValue Int64 oneInt
argument assertNotEqualCall rightValue Int64 twoInt
run assertNotEqualCall
branch error source assertNotEqualCall target smokeAssertionFailed

# ============================================================
# Extended unit tests: covers the 5 require* ops the smoke
# previously omitted (requireConditionTrue,
# requireSignedInt64LeftGreaterThanRight,
# requireSignedInt64LeftLessThanRight,
# requireSignedInt64ValueWithinInclusiveRange,
# requireOpaquePointerNotNull). The diagnostic writers
# (emitAssertionFailureBanner / writeAssertionByteToStandardOutput)
# are NOT exercised in this smoke because they would corrupt the
# expected "OK\n" stdout â€” they're indirectly verified by the
# requireX failure paths.
# ============================================================

storage module immutable trueBoolForAssert Bool true
storage module immutable tenIntForAssert Int64 10
storage module immutable fiveIntForAssert Int64 5
storage module immutable zeroIntForAssert Int64 0
storage module immutable helloPtrLiteral String "hello"

# requireConditionTrue(true) â€” should succeed
call assertConditionTrueCall requireConditionTrue
argument assertConditionTrueCall conditionValue Bool trueBoolForAssert
run assertConditionTrueCall
branch error source assertConditionTrueCall target smokeAssertionFailed

# requireSignedInt64LeftGreaterThanRight(10, 5) â€” should succeed
call assertLeftGreaterCall requireSignedInt64LeftGreaterThanRight
argument assertLeftGreaterCall leftValue Int64 tenIntForAssert
argument assertLeftGreaterCall rightValue Int64 fiveIntForAssert
run assertLeftGreaterCall
branch error source assertLeftGreaterCall target smokeAssertionFailed

# requireSignedInt64LeftLessThanRight(5, 10) â€” should succeed
call assertLeftLessCall requireSignedInt64LeftLessThanRight
argument assertLeftLessCall leftValue Int64 fiveIntForAssert
argument assertLeftLessCall rightValue Int64 tenIntForAssert
run assertLeftLessCall
branch error source assertLeftLessCall target smokeAssertionFailed

# requireSignedInt64ValueWithinInclusiveRange(5, 0, 10) â€” should succeed
call assertWithinRangeCall requireSignedInt64ValueWithinInclusiveRange
argument assertWithinRangeCall inputValue Int64 fiveIntForAssert
argument assertWithinRangeCall lowerBound Int64 zeroIntForAssert
argument assertWithinRangeCall upperBound Int64 tenIntForAssert
run assertWithinRangeCall
branch error source assertWithinRangeCall target smokeAssertionFailed

# requireSignedInt64ValueWithinInclusiveRange boundary: lowerBound itself ok
call assertBoundaryLowerCall requireSignedInt64ValueWithinInclusiveRange
argument assertBoundaryLowerCall inputValue Int64 zeroIntForAssert
argument assertBoundaryLowerCall lowerBound Int64 zeroIntForAssert
argument assertBoundaryLowerCall upperBound Int64 tenIntForAssert
run assertBoundaryLowerCall
branch error source assertBoundaryLowerCall target smokeAssertionFailed

# requireSignedInt64ValueWithinInclusiveRange boundary: upperBound itself ok
call assertBoundaryUpperCall requireSignedInt64ValueWithinInclusiveRange
argument assertBoundaryUpperCall inputValue Int64 tenIntForAssert
argument assertBoundaryUpperCall lowerBound Int64 zeroIntForAssert
argument assertBoundaryUpperCall upperBound Int64 tenIntForAssert
run assertBoundaryUpperCall
branch error source assertBoundaryUpperCall target smokeAssertionFailed

# requireOpaquePointerNotNull on a literal string pointer â€” should succeed
call assertNotNullCall requireOpaquePointerNotNull
argument assertNotNullCall pointerValue OpaquePointer helloPtrLiteral
run assertNotNullCall
branch error source assertNotNullCall target smokeAssertionFailed

storage module immutable successMessageText String "OK"
call writeSuccessLineCall console.writeLine
argument writeSuccessLineCall text String successMessageText
run writeSuccessLineCall
ignore void source writeSuccessLineCall
bind error consoleWriteResultError Int32 writeSuccessLineCall
branch error source writeSuccessLineCall target consoleWriteFailedHandler
storage module immutable exitOkCode ExitCode 0
return ok exitOkCode

# Failure leg: surface the raw negative Int32 from
# console.writeLine as the cause attached to the typed
# MainError.ConsoleWriteFailed variant.
label consoleWriteFailedHandler
makeError consoleWriteFailedFailure MainError.ConsoleWriteFailed consoleWriteResultError
return error consoleWriteFailedFailure
label smokeAssertionFailed
makeError assertSmokeFailure MainError.AssertSmokeFailed
return error assertSmokeFailure
