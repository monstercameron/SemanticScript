# SemanticScript standard-library canonical module: standard.stddef.

# rationale: Canonical standard-library module for stddef constants and helpers.
# invariant: The standard module entry is this file; tests live beside it as `main.test.sem`.
module standard.stddef
purpose module standard.stddef "Canonical standard-library module for stddef constants and helpers."
moduleOwns standard.stddef "The official import path `standard.stddef` and this module's implementation body."
moduleDoesNotOwn standard.stddef "App-specific wrappers, compatibility aliases, or generated build artifacts."
invariant module standard.stddef "The standard module entry is this file; tests live beside it as `main.test.sem`."

exportConstant standard.stddef stddefModuleVersionText
exportConstant standard.stddef byteSizeOfOpaquePointer
exportConstant standard.stddef byteSizeOfSignedInt32
exportConstant standard.stddef byteSizeOfFloat64
storage module immutable stddefModuleVersionText String "standard.stddef 0.1"

# Canonical standard-library implementation body.
# ============================================================
# SEMANTICSCRIPT STANDARD LIBRARY: <stddef.h>-style type sizing
# ============================================================
#
# rationale: C's <stddef.h> is mostly typedefs (size_t, ptrdiff_t)
#   plus the NULL macro. SemanticScript has those types natively
#   (ByteCount, OpaquePointer, etc.) so this module only
#   exposes the few callable surfaces - sizeof-style accessors for
#   the common ABI types - as module-scope domainLiteral constants
#   per the refined-syntax pattern (docs/ast.md section 2.12.5). The previous
#   shape (zero-arg operations returning `Result Int64 Void`)
#   is removed because constants belong in domainLiteral, not in
#   operation bodies.
#
# invariant: every byte-size constant matches the SemanticScript
#   target ABI (x86-64 Windows MSVC under the current bootstrap
#   triple). Width-specific aliases (Int32 / Int64 /
#   Float64) carry their byte count directly in the name; the
#   module-scope literals are convenience accessors for
#   serialization / FFI code that needs to compute buffer sizes
#   from type categories.
#
# security: pure constants. No effects. No allocation.
#
# timing: zero - the LLVM optimizer inlines every reference.
#
# observability: nothing to observe; consumers see only the
#   raw Int64 value.

# This is a pure-module (library) file: it exports operations and
# domainLiterals consumed by other programs (notably
# std/stddef/main.test.sem which importModules it and runs the
# smoke). The project / target / runtime / entry block is retained
# so the module can still be linted standalone - the entry just
# points at the first exported operation rather than a `main` smoke.

# section stddef.byteSizes
# rationale: byte-size constants per the target ABI (x86-64 Windows).

domainLiteral byteSizeOfOpaquePointer Int64 8
domainLiteralSource byteSizeOfOpaquePointer abi.x86_64.windows.pointerSize
domainLiteralTrust byteSizeOfOpaquePointer trustedStaticLiteral
domainLiteralValidation byteSizeOfOpaquePointer trustedAbiConstant

domainLiteral byteSizeOfSignedInt32 Int64 4
domainLiteralSource byteSizeOfSignedInt32 abi.fixedWidth.int32
domainLiteralTrust byteSizeOfSignedInt32 trustedStaticLiteral
domainLiteralValidation byteSizeOfSignedInt32 trustedAbiConstant

domainLiteral byteSizeOfSignedInt64 Int64 8
domainLiteralSource byteSizeOfSignedInt64 abi.fixedWidth.int64
domainLiteralTrust byteSizeOfSignedInt64 trustedStaticLiteral
domainLiteralValidation byteSizeOfSignedInt64 trustedAbiConstant

domainLiteral byteSizeOfFloat64 Int64 8
domainLiteralSource byteSizeOfFloat64 abi.ieee754.binary64
domainLiteralTrust byteSizeOfFloat64 trustedStaticLiteral
domainLiteralValidation byteSizeOfFloat64 trustedAbiConstant

domainLiteral byteSizeOfFloat32 Int64 4
domainLiteralSource byteSizeOfFloat32 abi.ieee754.binary32
domainLiteralTrust byteSizeOfFloat32 trustedStaticLiteral
domainLiteralValidation byteSizeOfFloat32 trustedAbiConstant

domainLiteral byteSizeOfSignedByte Int64 1
domainLiteralSource byteSizeOfSignedByte abi.fixedWidth.int8
domainLiteralTrust byteSizeOfSignedByte trustedStaticLiteral
domainLiteralValidation byteSizeOfSignedByte trustedAbiConstant

# section stddef.opaquePointers
# rationale: NULL pointer accessor; resolved at runtime via libc.

# invariant: Result compares equal to any other NULL produced by libc.
# rationale: Returns the canonical NULL pointer (i8* 0).
operation acquireNullOpaquePointer
output operation acquireNullOpaquePointer OpaquePointer
memory acquireNullOpaquePointer heap no
async acquireNullOpaquePointer no
purpose operation acquireNullOpaquePointer "Returns the canonical NULL pointer (i8* 0)."
invariant operation acquireNullOpaquePointer "Result compares equal to any other NULL produced by libc."
# rationale: SemanticScript lacks an explicit null pointer literal in the
#   type system, so we route through c.getenv with a deliberately
#   absent environment variable name. Every reasonable host returns
#   NULL; if a hostile host pre-sets this variable the caller will
#   observe a non-null pointer and the smoke test will fail visibly.
guarantee acquireNullOpaquePointer "Total under normal host environments."
label startAcquireNullOpaquePointer
storage module immutable deliberatelyAbsentEnvName String "SEMANTICSCRIPT_DEFINITELY_NOT_SET_4D7F00"
call probeEnvironmentForNullCall c.getenv
argument probeEnvironmentForNullCall name String deliberatelyAbsentEnvName
run probeEnvironmentForNullCall
bind value nullPointerValue OpaquePointer probeEnvironmentForNullCall
return value nullPointerValue
