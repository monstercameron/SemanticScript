# ============================================================
# SEMANTICSCRIPT STANDARD LIBRARY TESTS: process lifecycle terminators
# ============================================================
#
# rationale: companion test file for std/process/main.sem. Imports
#   the process module and verifies that compilation succeeds and
#   the OK banner reaches stdout. The terminators
#   (exitProcessWithStatusCode, abortCurrentProcess) are deliberately
#   NOT invoked â€” calling either would kill the test runner.
#
# invariant: success prints "OK\n" and exits 0; only the typed
#   ConsoleWriteFailed variant is surfaced if the OK write itself
#   returns an error.
#
# # pattern: this is the canonical main.test.sem form â€” same
#   directory as main.sem, import foo standard.foo, project block local
#   to the test, entry console main. The implementation file
#   std/process/main.sem carries no smoke main itself.

project StdProcessTest
target console
runtime AgentRuntime 0.1
entry console main

import process standard.process
error MainError
errorCase MainError ConsoleWriteFailed

# Smoke-test main writes one OK line to stdout â€” declare the
# capability once at module scope so the operation header can
# reference it.
capability stdoutWriteCapability console.stdout write

# ============================================================
# Smoke test
# ============================================================
#
# We deliberately do NOT invoke either terminator â€” calling them
# would kill the test runner. Instead, the smoke verifies that
# this file compiles, that its metadata parses, and that the OK
# banner reaches stdout. The bindError + branchIfError pair on
# console.writeLine surfaces a typed ConsoleWriteFailed variant
# if the write itself fails (e.g. broken pipe).

operation main
input operation main console Console
output operation main Result ExitCode MainError
useCapability main stdoutWriteCapability
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Verify process.sscript compiles and metadata parses; emit OK on stdout. The terminators are NOT invoked."
invariant operation main "Exit 0 on success; ConsoleWriteFailed only if the OK write itself returns an error."

label startMain
storage module immutable successMessageText String "OK"
call writeSuccessLineCall console.writeLine
argument writeSuccessLineCall text String successMessageText
run writeSuccessLineCall
ignore void source writeSuccessLineCall
bind error consoleWriteResultError Int32 writeSuccessLineCall
branch error source writeSuccessLineCall target consoleWriteFailedHandler
storage module immutable exitOkCode ExitCode 0
return ok exitOkCode

# Failure leg: console.writeLine returned a negative Int32.
# We surface that raw return as the cause attached to the typed
# MainError.ConsoleWriteFailed variant we return to the caller â€”
# the typed variant is what callers branch on, the raw int is
# preserved for diagnostic correlation.
label consoleWriteFailedHandler
makeError consoleWriteFailedFailure MainError.ConsoleWriteFailed consoleWriteResultError
return error consoleWriteFailedFailure
