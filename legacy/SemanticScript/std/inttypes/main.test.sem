# ============================================================
# SEMANTICSCRIPT STDLIB TESTS: inttypes
# ============================================================
#
# Companion smoke + extended unit tests for std/inttypes/main.sem.
# Imports the inttypes module and asserts each helper (abs / div
# quotient / div remainder / parse binary / parse octal) plus the
# Euclidean property qÂ·d + r == n.
#
# Pattern: std/main.sem ships pure-module operations only;
# std/main.test.sem carries every smoke / unit test for it.

project StdInttypesTest
target console
runtime AgentRuntime 0.1
entry console main

import inttypes standard.inttypes
error MainError
errorCase MainError InttypesSmokeAssertionFailed
errorCase MainError ConsoleWriteFailed

# section capability
# rationale: smoke-test main writes a single OK line to stdout.
capability stdoutWriteCapability console.stdout write

# ============================================================
# Smoke test
# ============================================================

operation main
input operation main console Console
output operation main Result ExitCode MainError
useCapability main stdoutWriteCapability
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Smoke-test the inttypes helpers end-to-end."
invariant operation main "All assertions hold or the failure path runs."

label startMain

# absoluteMaxWidthSignedInt(-7) == 7
storage module immutable negativeSevenValue Int64 -7
call assertAbsCall absoluteMaxWidthSignedInt
argument assertAbsCall inputValue Int64 negativeSevenValue
run assertAbsCall
bind value absResult Int64 assertAbsCall
storage module immutable sevenValue Int64 7
call checkAbsCall math.equalInt64
argument checkAbsCall left Int64 absResult
argument checkAbsCall right Int64 sevenValue
run checkAbsCall
bind value absOk Bool checkAbsCall
branch if condition absOk target absHolds
branch else target smokeAssertionFailed
label absHolds

# parsePositiveBinaryCStringToSignedInt64("1101") == 13
storage module immutable binaryThirteenText String "1101"
call assertParseBinaryCall parsePositiveBinaryCStringToSignedInt64
argument assertParseBinaryCall inputText String binaryThirteenText
run assertParseBinaryCall
bind value parseBinaryResult Int64 assertParseBinaryCall
storage module immutable thirteenValue Int64 13
call checkParseBinaryCall math.equalInt64
argument checkParseBinaryCall left Int64 parseBinaryResult
argument checkParseBinaryCall right Int64 thirteenValue
run checkParseBinaryCall
bind value parseBinaryOk Bool checkParseBinaryCall
branch if condition parseBinaryOk target parseBinaryHolds
branch else target smokeAssertionFailed
label parseBinaryHolds

# parsePositiveOctalCStringToSignedInt64("755") == 493
storage module immutable octal755Text String "755"
call assertParseOctalCall parsePositiveOctalCStringToSignedInt64
argument assertParseOctalCall inputText String octal755Text
run assertParseOctalCall
bind value parseOctalResult Int64 assertParseOctalCall
storage module immutable fourNinetyThreeValue Int64 493
call checkParseOctalCall math.equalInt64
argument checkParseOctalCall left Int64 parseOctalResult
argument checkParseOctalCall right Int64 fourNinetyThreeValue
run checkParseOctalCall
bind value parseOctalOk Bool checkParseOctalCall
branch if condition parseOctalOk target parseOctalHolds
branch else target smokeAssertionFailed
label parseOctalHolds

# ============================================================
# Extended unit tests: covers the 2 ops the smoke previously
# omitted (divideMaxWidthSignedIntQuotient + Remainder).
# ============================================================

storage module immutable numeratorTwentyThree Int64 23
storage module immutable denominatorFour Int64 4
storage module immutable expectedQuotientFive Int64 5
storage module immutable expectedRemainderThree Int64 3

# divideMaxWidthSignedIntQuotient(23, 4) == 5
call divQuotientCall divideMaxWidthSignedIntQuotient
argument divQuotientCall numeratorValue Int64 numeratorTwentyThree
argument divQuotientCall denominatorValue Int64 denominatorFour
run divQuotientCall
bind ok divQuotientResult Int64 divQuotientCall
call checkDivQuotientCall math.equalInt64
argument checkDivQuotientCall left Int64 divQuotientResult
argument checkDivQuotientCall right Int64 expectedQuotientFive
run checkDivQuotientCall
bind value divQuotientOk Bool checkDivQuotientCall
branch if condition divQuotientOk target divQuotientHolds
branch else target smokeAssertionFailed
label divQuotientHolds

# divideMaxWidthSignedIntRemainder(23, 4) == 3
call divRemainderCall divideMaxWidthSignedIntRemainder
argument divRemainderCall numeratorValue Int64 numeratorTwentyThree
argument divRemainderCall denominatorValue Int64 denominatorFour
run divRemainderCall
bind ok divRemainderResult Int64 divRemainderCall
call checkDivRemainderCall math.equalInt64
argument checkDivRemainderCall left Int64 divRemainderResult
argument checkDivRemainderCall right Int64 expectedRemainderThree
run checkDivRemainderCall
bind value divRemainderOk Bool checkDivRemainderCall
branch if condition divRemainderOk target divRemainderHolds
branch else target smokeAssertionFailed
label divRemainderHolds

# Property: quotient * denominator + remainder == numerator
# (5 * 4 + 3 == 23)
call propMulCall math.multiplyInt64
argument propMulCall left Int64 divQuotientResult
argument propMulCall right Int64 denominatorFour
run propMulCall
bind value propMulResult Int64 propMulCall
call propAddCall math.addInt64
argument propAddCall left Int64 propMulResult
argument propAddCall right Int64 divRemainderResult
run propAddCall
bind value propAddResult Int64 propAddCall
call propCheckCall math.equalInt64
argument propCheckCall left Int64 propAddResult
argument propCheckCall right Int64 numeratorTwentyThree
run propCheckCall
bind value propCheckOk Bool propCheckCall
branch if condition propCheckOk target propCheckHolds
branch else target smokeAssertionFailed
label propCheckHolds

# divideMaxWidthSignedIntQuotient(0, 5) == 0 (zero dividend)
storage module immutable zeroNumerator Int64 0
storage module immutable fiveDenominator Int64 5
call divZeroQuotientCall divideMaxWidthSignedIntQuotient
argument divZeroQuotientCall numeratorValue Int64 zeroNumerator
argument divZeroQuotientCall denominatorValue Int64 fiveDenominator
run divZeroQuotientCall
bind ok divZeroQuotientResult Int64 divZeroQuotientCall
call checkDivZeroQuotientCall math.equalInt64
argument checkDivZeroQuotientCall left Int64 divZeroQuotientResult
argument checkDivZeroQuotientCall right Int64 zeroNumerator
run checkDivZeroQuotientCall
bind value divZeroQuotientOk Bool checkDivZeroQuotientCall
branch if condition divZeroQuotientOk target divZeroQuotientHolds
branch else target smokeAssertionFailed
label divZeroQuotientHolds

# parsePositiveBinaryCStringToSignedInt64("0") == 0 (boundary)
storage module immutable binaryZeroText String "0"
call parseZeroBinaryCall parsePositiveBinaryCStringToSignedInt64
argument parseZeroBinaryCall inputText String binaryZeroText
run parseZeroBinaryCall
bind value parseZeroBinaryResult Int64 parseZeroBinaryCall
call checkParseZeroBinaryCall math.equalInt64
argument checkParseZeroBinaryCall left Int64 parseZeroBinaryResult
argument checkParseZeroBinaryCall right Int64 zeroNumerator
run checkParseZeroBinaryCall
bind value parseZeroBinaryOk Bool checkParseZeroBinaryCall
branch if condition parseZeroBinaryOk target parseZeroBinaryHolds
branch else target smokeAssertionFailed
label parseZeroBinaryHolds

# absoluteMaxWidthSignedInt(0) == 0 (boundary)
call absZeroCall absoluteMaxWidthSignedInt
argument absZeroCall inputValue Int64 zeroNumerator
run absZeroCall
bind value absZeroResult Int64 absZeroCall
call checkAbsZeroCall math.equalInt64
argument checkAbsZeroCall left Int64 absZeroResult
argument checkAbsZeroCall right Int64 zeroNumerator
run checkAbsZeroCall
bind value absZeroOk Bool checkAbsZeroCall
branch if condition absZeroOk target absZeroHolds
branch else target smokeAssertionFailed
label absZeroHolds

storage module immutable successMessageText String "OK"
call writeSuccessLineCall console.writeLine
argument writeSuccessLineCall text String successMessageText
run writeSuccessLineCall
ignore void source writeSuccessLineCall
bind error consoleWriteResultError Int32 writeSuccessLineCall
branch error source writeSuccessLineCall target consoleWriteFailedHandler
storage module immutable exitOkCode ExitCode 0
return ok exitOkCode

# Failure leg: surface the raw negative Int32 from
# console.writeLine as the cause attached to the typed
# MainError.ConsoleWriteFailed variant.
label consoleWriteFailedHandler
makeError consoleWriteFailedFailure MainError.ConsoleWriteFailed consoleWriteResultError
return error consoleWriteFailedFailure
label smokeAssertionFailed
makeError inttypesSmokeFailure MainError.InttypesSmokeAssertionFailed
return error inttypesSmokeFailure
