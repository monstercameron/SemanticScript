# ============================================================
# SEMANTICSCRIPT STDLIB TESTS: random
# ============================================================
#
# Companion smoke + extended unit tests for std/random/main.sem.
# Seeds the MINSTD LCG and verifies the canonical Park-Miller
# sequence (1 -> 48271 -> 182605794), then exercises the byte
# helper and verifies determinism across a fresh state instance.
#
# Pattern: std/main.sem ships pure-module operations only;
# std/main.test.sem carries every smoke / unit test for it.

project StdRandomTest
target console
runtime AgentRuntime 0.1
entry console main

import random standard.random
error MainError
errorCase MainError RandomSmokeAssertionFailed
errorCase MainError ConsoleWriteFailed

# section capability
# rationale: smoke-test main writes a single OK line to stdout and
#   allocates / releases LCG state slots via the random module's
#   create / release operations, so it needs the stdout + heap
#   capabilities those operations require at the call site.
capability stdoutWriteCapability console.stdout write
capability heapAllocationCapability heap allocate
capability heapFreeCapability heap free

# ============================================================
# Smoke test: well-known MINSTD sequence from seed 1.
# ============================================================

operation main
input operation main console Console
output operation main Result ExitCode MainError
useCapability main stdoutWriteCapability
useCapability main heapAllocationCapability
useCapability main heapFreeCapability
effect main write console.stdout
effect main allocate heap
effect main free heap
memory main heap yes
memoryAllocationSource main createStateCall
async main no
purpose operation main "Seed the LCG with 1; draw two values and verify the MINSTD canonical sequence: 1 -> 48271 -> 182605794."
invariant operation main "The MINSTD multiplier produces a deterministic sequence â€” any deviation indicates encoder/decoder drift."

label startMain
storage module immutable seedOneInteger Int64 1
call createStateCall createDeterministicRandomState
argument createStateCall randomSeed Int64 seedOneInteger
run createStateCall
bind ok randomStateSlot OpaquePointer createStateCall

# Draw 1: 1 * 48271 mod (2^31-1) = 48271
call drawFirstRandomCall nextDeterministicRandomSignedInt64
argument drawFirstRandomCall randomState OpaquePointer randomStateSlot
run drawFirstRandomCall
bind value firstRandomValue Int64 drawFirstRandomCall
storage module immutable expectedFirstRandom Int64 48271
call checkFirstDrawCall math.equalInt64
argument checkFirstDrawCall left Int64 firstRandomValue
argument checkFirstDrawCall right Int64 expectedFirstRandom
run checkFirstDrawCall
bind value firstDrawOk Bool checkFirstDrawCall
branch if condition firstDrawOk target firstDrawHolds
branch else target smokeAssertionFailed
label firstDrawHolds

# Draw 2: 48271^2 mod (2^31-1) = 182605794
call drawSecondRandomCall nextDeterministicRandomSignedInt64
argument drawSecondRandomCall randomState OpaquePointer randomStateSlot
run drawSecondRandomCall
bind value secondRandomValue Int64 drawSecondRandomCall
storage module immutable expectedSecondRandom Int64 182605794
call checkSecondDrawCall math.equalInt64
argument checkSecondDrawCall left Int64 secondRandomValue
argument checkSecondDrawCall right Int64 expectedSecondRandom
run checkSecondDrawCall
bind value secondDrawOk Bool checkSecondDrawCall
branch if condition secondDrawOk target secondDrawHolds
branch else target smokeAssertionFailed
label secondDrawHolds

# Read the LCG state mid-sequence and verify it equals the last draw.
# After two draws the state should equal the second draw value (the
# LCG stores state[k] = x_k where the most recently produced value is
# the current state).
call readStateCall readDeterministicRandomState
argument readStateCall randomState OpaquePointer randomStateSlot
run readStateCall
bind value readStateResult Int64 readStateCall
call checkReadStateCall math.equalInt64
argument checkReadStateCall left Int64 readStateResult
argument checkReadStateCall right Int64 expectedSecondRandom
run checkReadStateCall
bind value readStateOk Bool checkReadStateCall
branch if condition readStateOk target readStateHolds
branch else target smokeAssertionFailed
label readStateHolds

# Draw 3: continue the sequence â€” verify it doesn't repeat the first.
call drawThirdRandomCall nextDeterministicRandomSignedInt64
argument drawThirdRandomCall randomState OpaquePointer randomStateSlot
run drawThirdRandomCall
bind value thirdRandomValue Int64 drawThirdRandomCall
call checkThirdDistinctCall math.notEqualInt64
argument checkThirdDistinctCall left Int64 thirdRandomValue
argument checkThirdDistinctCall right Int64 firstRandomValue
run checkThirdDistinctCall
bind value thirdDistinctOk Bool checkThirdDistinctCall
branch if condition thirdDistinctOk target thirdDistinctHolds
branch else target smokeAssertionFailed
label thirdDistinctHolds

# loadUnsignedByteFromBufferOffset: 'h' is byte 104 at offset 0 of "hello".
storage module immutable helloForRandom String "hello"
storage module immutable offsetZeroForRandom Int64 0
storage module immutable expectedHByte Int64 104
call loadByteCall loadUnsignedByteFromBufferOffset
argument loadByteCall byteBuffer OpaquePointer helloForRandom
argument loadByteCall byteOffset ByteCount offsetZeroForRandom
run loadByteCall
bind value loadedByteResult Int64 loadByteCall
call checkLoadByteCall math.equalInt64
argument checkLoadByteCall left Int64 loadedByteResult
argument checkLoadByteCall right Int64 expectedHByte
run checkLoadByteCall
bind value loadByteOk Bool checkLoadByteCall
branch if condition loadByteOk target loadByteHolds
branch else target smokeAssertionFailed
label loadByteHolds

# loadUnsignedByteFromBufferOffset at non-zero offset: byte at offset 4 of "hello" = 'o' = 111
storage module immutable offsetFourForRandom Int64 4
storage module immutable expectedOByte Int64 111
call loadByteOffCall loadUnsignedByteFromBufferOffset
argument loadByteOffCall byteBuffer OpaquePointer helloForRandom
argument loadByteOffCall byteOffset ByteCount offsetFourForRandom
run loadByteOffCall
bind value loadedByteOffResult Int64 loadByteOffCall
call checkLoadByteOffCall math.equalInt64
argument checkLoadByteOffCall left Int64 loadedByteOffResult
argument checkLoadByteOffCall right Int64 expectedOByte
run checkLoadByteOffCall
bind value loadByteOffOk Bool checkLoadByteOffCall
branch if condition loadByteOffOk target loadByteOffHolds
branch else target smokeAssertionFailed
label loadByteOffHolds

call releaseStateCall releaseDeterministicRandomState
argument releaseStateCall randomState OpaquePointer randomStateSlot
run releaseStateCall
ignore value source releaseStateCall type Int32

# Property: a fresh seed-1 LCG produces the same first value (48271).
# This verifies determinism across state instances.
call createStateAgainCall createDeterministicRandomState
argument createStateAgainCall randomSeed Int64 seedOneInteger
run createStateAgainCall
bind ok randomStateAgainSlot OpaquePointer createStateAgainCall
call drawAgainCall nextDeterministicRandomSignedInt64
argument drawAgainCall randomState OpaquePointer randomStateAgainSlot
run drawAgainCall
bind value firstRandomAgainValue Int64 drawAgainCall
call checkDeterministicCall math.equalInt64
argument checkDeterministicCall left Int64 firstRandomAgainValue
argument checkDeterministicCall right Int64 expectedFirstRandom
run checkDeterministicCall
bind value deterministicOk Bool checkDeterministicCall
branch if condition deterministicOk target deterministicHolds
branch else target smokeAssertionFailed
label deterministicHolds
call releaseStateAgainCall releaseDeterministicRandomState
argument releaseStateAgainCall randomState OpaquePointer randomStateAgainSlot
run releaseStateAgainCall
ignore value source releaseStateAgainCall type Int32

storage module immutable successMessageText String "OK"
call writeSuccessLineCall console.writeLine
argument writeSuccessLineCall text String successMessageText
run writeSuccessLineCall
ignore void source writeSuccessLineCall
bind error consoleWriteResultError Int32 writeSuccessLineCall
branch error source writeSuccessLineCall target consoleWriteFailedHandler
storage module immutable exitOkCode ExitCode 0
return ok exitOkCode

# Failure leg: surface the raw negative Int32 from
# console.writeLine as the cause attached to the typed
# MainError.ConsoleWriteFailed variant.
label consoleWriteFailedHandler
makeError consoleWriteFailedFailure MainError.ConsoleWriteFailed consoleWriteResultError
return error consoleWriteFailedFailure
label smokeAssertionFailed
makeError randomSmokeFailure MainError.RandomSmokeAssertionFailed
return error randomSmokeFailure
