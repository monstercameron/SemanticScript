argument normalizeFindByteCall left Int64 shiftedFindByte
argument normalizeFindByteCall right Int64 byteRoleAdjustmentValue
run normalizeFindByteCall
bind value normalizedFindByte Int64 normalizeFindByteCall
call detectFindByteMatchCall math.equalInt64
argument detectFindByteMatchCall left Int64 normalizedFindByte
argument detectFindByteMatchCall right Int64 targetValue
run detectFindByteMatchCall
bind value findByteMatch Bool detectFindByteMatchCall
branch if condition findByteMatch target findByteFoundAtCursor
call advanceFindByteCursorCall math.addInt64
argument advanceFindByteCursorCall left Int64 findByteCursor
argument advanceFindByteCursorCall right Int64 integerOneStepValue
run advanceFindByteCursorCall
bind value nextFindByteCursor Int64 advanceFindByteCursorCall
set memory findByteCursor nextFindByteCursor
jump target findByteLoop
label findByteFoundAtCursor
