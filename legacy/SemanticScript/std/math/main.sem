argument oldExpFloatCall inputValue Int64 oldExpI
run oldExpFloatCall
bind value oldExpF Float64 oldExpFloatCall
call newExpFloatCall math.convertInt64ToFloat64
argument newExpFloatCall inputValue Int64 newExpI
run newExpFloatCall
