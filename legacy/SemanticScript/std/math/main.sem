# rationale: Returns the population count of inputValue (number of 1-bits in its full 64-bit two's-complement representation). Correct for negative inputs: countSetBitsInSignedInt64(-1) == 64.
# invariant: For inputValue >= 0, inspects each bit via modulo-2 on a halving working value. For inputValue < 0, applies popcount(n) == 64 - popcount(-n - 1) so the sign-extension bits are counted (arithmetic divide-by-two toward zero would otherwise drop them).
operation countSetBitsInSignedInt64
input operation countSetBitsInSignedInt64 inputValue Int64
output operation countSetBitsInSignedInt64 Int64
memory countSetBitsInSignedInt64 heap no
async countSetBitsInSignedInt64 no
purpose operation countSetBitsInSignedInt64 "Returns the population count of inputValue (number of 1-bits in its full 64-bit two's-complement representation). Correct for negative inputs: countSetBitsInSignedInt64(-1) == 64."
invariant operation countSetBitsInSignedInt64 "For inputValue >= 0, inspects each bit via modulo-2 on a halving working value. For inputValue < 0, applies popcount(n) == 64 - popcount(-n - 1) so the sign-extension bits are counted (arithmetic divide-by-two toward zero would otherwise drop them)."
guarantee countSetBitsInSignedInt64 "Total - in [0, 64]."
label startCountSetBitsInSignedInt64
storage module immutable zeroPc Int64 0
storage module immutable onePc Int64 1
storage module immutable twoPc Int64 2
storage module immutable limitPc Int64 64
storage module immutable negOnePc Int64 -1
memory countSetBitsInSignedInt64 mutable pcVal Int64 0
set memory pcVal inputValue
memory countSetBitsInSignedInt64 mutable pcWasNegativeFlag Int64 0
memory countSetBitsInSignedInt64 mutable pcCount Int64 0
memory countSetBitsInSignedInt64 mutable pcIter Int64 0
# Negative inputs: arithmetic divide-by-two (toward zero) collapses a
# negative value's sign-extension bits, so the raw loop would undercount.
# Use popcount(n) == 64 - popcount(-n - 1) for n < 0: `-n - 1` is
# non-negative for every negative n (and wraps to INT64_MAX for INT64_MIN,
# which is still correct), so the unsigned loop below counts it exactly.
call pcDetectNegativeCall math.lessThanInt64
argument pcDetectNegativeCall left Int64 inputValue
argument pcDetectNegativeCall right Int64 zeroPc
run pcDetectNegativeCall
bind value pcInputIsNegative Bool pcDetectNegativeCall
branch if condition pcInputIsNegative target pcPrepareNegative
branch else target pcLoop
label pcPrepareNegative
set memory pcWasNegativeFlag onePc
call pcNegateInputCall math.multiplyInt64
argument pcNegateInputCall left Int64 inputValue
argument pcNegateInputCall right Int64 negOnePc
run pcNegateInputCall
bind value pcNegatedInput Int64 pcNegateInputCall
call pcComplementSourceCall math.subtractInt64
argument pcComplementSourceCall left Int64 pcNegatedInput
argument pcComplementSourceCall right Int64 onePc
run pcComplementSourceCall
bind value pcComplementSource Int64 pcComplementSourceCall
set memory pcVal pcComplementSource
jump target pcLoop
label pcLoop
call popcountDoneCall math.greaterThanOrEqualInt64
argument popcountDoneCall left Int64 pcIter
argument popcountDoneCall right Int64 limitPc
run popcountDoneCall
bind value popcountDoneCallB Bool popcountDoneCall
branch if condition popcountDoneCallB target pcReturn
call popcountModCall math.moduloInt64
argument popcountModCall left Int64 pcVal
argument popcountModCall right Int64 twoPc
run popcountModCall
bind value pcBit Int64 popcountModCall
call popcountBitNonzeroCall math.notEqualInt64
argument popcountBitNonzeroCall left Int64 pcBit
argument popcountBitNonzeroCall right Int64 zeroPc
run popcountBitNonzeroCall
bind value pcSet Bool popcountBitNonzeroCall
branch if condition pcSet target popcountIncrementBranch
branch else target pcAdvance
label popcountIncrementBranch
call popcountIncrementCall math.addInt64
argument popcountIncrementCall left Int64 pcCount
argument popcountIncrementCall right Int64 onePc
run popcountIncrementCall
bind value pcNext Int64 popcountIncrementCall
set memory pcCount pcNext
jump target pcAdvance
label pcAdvance
call popcountDivideCall math.divideInt64
argument popcountDivideCall left Int64 pcVal
argument popcountDivideCall right Int64 twoPc
run popcountDivideCall
bind value pcHalved Int64 popcountDivideCall
set memory pcVal pcHalved
call popcountIterIncrementCall math.addInt64
argument popcountIterIncrementCall left Int64 pcIter
argument popcountIterIncrementCall right Int64 onePc
run popcountIterIncrementCall
bind value pcIterNext Int64 popcountIterIncrementCall
set memory pcIter pcIterNext
jump target pcLoop
label pcReturn
call pcWasNegativeCheckCall math.equalInt64
argument pcWasNegativeCheckCall left Int64 pcWasNegativeFlag
argument pcWasNegativeCheckCall right Int64 onePc
run pcWasNegativeCheckCall
bind value pcWasNegativeResult Bool pcWasNegativeCheckCall
branch if condition pcWasNegativeResult target pcReturnComplement
return value pcCount
label pcReturnComplement
call pcFinalComplementCall math.subtractInt64
argument pcFinalComplementCall left Int64 limitPc
argument pcFinalComplementCall right Int64 pcCount
run pcFinalComplementCall
bind value pcComplementedCount Int64 pcFinalComplementCall
return value pcComplementedCount

# rationale: Returns the count of trailing zero bits in inputValue's 64-bit representation. Returns 64 for inputValue == 0 (matching GCC __builtin_ctzll).
# invariant: Halves the value while the low bit is zero, counting iterations. Zero input short-circuits to 64.
operation countTrailingZeroBitsInSignedInt64
input operation countTrailingZeroBitsInSignedInt64 inputValue Int64
output operation countTrailingZeroBitsInSignedInt64 Int64
memory countTrailingZeroBitsInSignedInt64 heap no
async countTrailingZeroBitsInSignedInt64 no
purpose operation countTrailingZeroBitsInSignedInt64 "Returns the count of trailing zero bits in inputValue's 64-bit representation. Returns 64 for inputValue == 0 (matching GCC __builtin_ctzll)."
invariant operation countTrailingZeroBitsInSignedInt64 "Halves the value while the low bit is zero, counting iterations. Zero input short-circuits to 64."
guarantee countTrailingZeroBitsInSignedInt64 "Total."
label startCountTrailingZeroBitsInSignedInt64
storage module immutable zeroTz Int64 0
storage module immutable oneTz Int64 1
storage module immutable twoTz Int64 2
storage module immutable sixtyFourTz Int64 64
# Special case n == 0
call ctzEqualZeroCall math.equalInt64
argument ctzEqualZeroCall left Int64 inputValue
argument ctzEqualZeroCall right Int64 zeroTz
run ctzEqualZeroCall
bind value nIsZero Bool ctzEqualZeroCall
branch if condition nIsZero target tzReturn64
memory countTrailingZeroBitsInSignedInt64 mutable tzVal Int64 0
set memory tzVal inputValue
memory countTrailingZeroBitsInSignedInt64 mutable tzCount Int64 0
label tzLoop
call tzModCall math.moduloInt64
argument tzModCall left Int64 tzVal
argument tzModCall right Int64 twoTz
run tzModCall
bind value tzMod Int64 tzModCall
call ctzBitSetCall math.notEqualInt64
argument ctzBitSetCall left Int64 tzMod
argument ctzBitSetCall right Int64 zeroTz
run ctzBitSetCall
bind value tzSet Bool ctzBitSetCall
branch if condition tzSet target tzReturn
call tzDivCall math.divideInt64
argument tzDivCall left Int64 tzVal
argument tzDivCall right Int64 twoTz
run tzDivCall
bind value tzNext Int64 tzDivCall
set memory tzVal tzNext
call tzIncCall math.addInt64
argument tzIncCall left Int64 tzCount
argument tzIncCall right Int64 oneTz
run tzIncCall
bind value tzCountNext Int64 tzIncCall
set memory tzCount tzCountNext
jump target tzLoop
label tzReturn
return value tzCount
label tzReturn64
return value sixtyFourTz

