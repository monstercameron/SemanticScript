# Canonical standard-library implementation body.
# ============================================================
# SEMANTICSCRIPT STANDARD LIBRARY: integer and floating-point math helpers
# ============================================================
#
# rationale: pure-SemanticScript integer math - sqrt, factorial, primality,
#   power-of-two tests, bit counts. Every operation lowers to math.*
#   primitives plus branching; no libc math.h dependency.
#
# invariant: every operation is total over its declared Int64
#   domain. Predicates (isSignedInt64Prime / IsPowerOfTwo / IsEven /
#   IsOdd / IsWithinInclusiveRange) return Bool directly - no more
#   round-trips through "0 or 1 in a Int32".
#
# security: pure value-level computation. No I/O. No allocation.
#
# timing: integerSquareRoot is O(log n) (Newton iterations);
#   factorial is O(n); isSignedInt64Prime is O(sqrt(n)); bit counts
#   are O(64) - acceptable for tooling, not for hot loops.
#
# observability: no logs; consumers wrap when needed.

# Pure-module file: smoke + extended tests live in
# std/math/main.test.sem.

# rationale: Returns floor(sqrt(inputValue)) for inputValue >= 0 via Newton iteration; returns 0 for inputValue <= 0.
# invariant: For n >= 0, result*result <= n < (result+1)*(result+1).
operation integerSquareRootSignedInt64
input operation integerSquareRootSignedInt64 inputValue Int64
output operation integerSquareRootSignedInt64 Int64
memory integerSquareRootSignedInt64 heap no
memory integerSquareRootSignedInt64 stack max 1024
async integerSquareRootSignedInt64 no
purpose operation integerSquareRootSignedInt64 "Returns floor(sqrt(inputValue)) for inputValue >= 0 via Newton iteration; returns 0 for inputValue <= 0."
invariant operation integerSquareRootSignedInt64 "For n >= 0, result*result <= n < (result+1)*(result+1)."
guarantee integerSquareRootSignedInt64 "Total."

label startIntegerSquareRootSignedInt64
storage module immutable zeroInt64 Int64 0
storage module immutable twoInt64 Int64 2

# n <= 0 -> 0
call leZeroCall math.lessThanOrEqualInt64
argument leZeroCall left Int64 inputValue
argument leZeroCall right Int64 zeroInt64
run leZeroCall
bind value leZero Bool leZeroCall
branch if condition leZero target intSqrtZero

# Initial guess: n itself.
memory integerSquareRootSignedInt64 mutable guess Int64 0
set memory guess inputValue

label sqrtLoop
# next = (guess + n/guess) / 2
call divCall math.divideInt64
argument divCall left Int64 inputValue
argument divCall right Int64 guess
run divCall
bind value quot Int64 divCall

call sumCall math.addInt64
argument sumCall left Int64 guess
argument sumCall right Int64 quot
run sumCall
bind value sumGuess Int64 sumCall

call halveCall math.divideInt64
argument halveCall left Int64 sumGuess
argument halveCall right Int64 twoInt64
run halveCall
bind value nextGuess Int64 halveCall

# Stop when next >= guess (no further improvement).
call notImprovingCall math.greaterThanOrEqualInt64
argument notImprovingCall left Int64 nextGuess
argument notImprovingCall right Int64 guess
run notImprovingCall
bind value notImproving Bool notImprovingCall
branch if condition notImproving target intSqrtDone

set memory guess nextGuess
jump target sqrtLoop

label intSqrtDone
return value guess

label intSqrtZero
return value zeroInt64

# rationale: Returns inputValue! by repeated multiplication. Defined for inputValue in [0, 20]; n > 20 overflows Int64 silently.
# invariant: factorialSignedInt64(0) == 1 (convention).
# warning: Wraps silently above 20! - no overflow error surfaced.
operation factorialSignedInt64
input operation factorialSignedInt64 inputValue Int64
output operation factorialSignedInt64 Int64
memory factorialSignedInt64 heap no
memory factorialSignedInt64 stack max 1024
async factorialSignedInt64 no
purpose operation factorialSignedInt64 "Returns inputValue! by repeated multiplication. Defined for inputValue in [0, 20]; n > 20 overflows Int64 silently."
invariant operation factorialSignedInt64 "factorialSignedInt64(0) == 1 (convention)."
warning factorialSignedInt64 "Wraps silently above 20! - no overflow error surfaced."
guarantee factorialSignedInt64 "Total over the Int64 domain (with overflow wrap)."

label startFactorialSignedInt64
storage module immutable zeroFac Int64 0
storage module immutable oneFac Int64 1

call nLeZeroCall math.lessThanOrEqualInt64
argument nLeZeroCall left Int64 inputValue
argument nLeZeroCall right Int64 zeroFac
run nLeZeroCall
bind value nLeZero Bool nLeZeroCall
branch if condition nLeZero target factorialOne

memory factorialSignedInt64 mutable product Int64 1
memory factorialSignedInt64 mutable i Int64 1
label factorialLoop
call doneCall math.greaterThanInt64
argument doneCall left Int64 i
argument doneCall right Int64 inputValue
run doneCall
bind value done Bool doneCall
branch if condition done target factorialReturn
call mulCall math.multiplyInt64
argument mulCall left Int64 product
argument mulCall right Int64 i
run mulCall
bind value nextProd Int64 mulCall
set memory product nextProd
call incCall math.addInt64
argument incCall left Int64 i
argument incCall right Int64 oneFac
run incCall
bind value nextI Int64 incCall
set memory i nextI
jump target factorialLoop
label factorialReturn
return value product
label factorialOne
return value oneFac

# rationale: Returns true when inputValue is prime; n <= 1 returns false. Tests divisibility by 2 then odd numbers up to floor(sqrt(n)).
# invariant: Exact for inputValue in [2, INT64_MAX/2]; uses integerSquareRootSignedInt64 to bound the trial-division loop.
operation isSignedInt64Prime
input operation isSignedInt64Prime inputValue Int64
output operation isSignedInt64Prime Bool
memory isSignedInt64Prime heap no
memory isSignedInt64Prime stack max 1024
async isSignedInt64Prime no
purpose operation isSignedInt64Prime "Returns true when inputValue is prime; n <= 1 returns false. Tests divisibility by 2 then odd numbers up to floor(sqrt(n))."
invariant operation isSignedInt64Prime "Exact for inputValue in [2, INT64_MAX/2]; uses integerSquareRootSignedInt64 to bound the trial-division loop."
guarantee isSignedInt64Prime "Total."

label startIsSignedInt64Prime
storage module immutable zeroP Int64 0
storage module immutable oneP Int64 1
storage module immutable twoP Int64 2
storage module immutable truePr Bool true
storage module immutable falsePr Bool false

call leOneCall math.lessThanOrEqualInt64
argument leOneCall left Int64 inputValue
argument leOneCall right Int64 oneP
run leOneCall
bind value leOne Bool leOneCall
branch if condition leOne target isPrimeFalse

call eqTwoCall math.equalInt64
argument eqTwoCall left Int64 inputValue
argument eqTwoCall right Int64 twoP
run eqTwoCall
bind value eqTwo Bool eqTwoCall
branch if condition eqTwo target isPrimeTrue

# Even (other than 2) -> composite.
call modTwoCall math.moduloInt64
argument modTwoCall left Int64 inputValue
argument modTwoCall right Int64 twoP
run modTwoCall
bind value nMod2 Int64 modTwoCall
call isEvenCall math.equalInt64
argument isEvenCall left Int64 nMod2
argument isEvenCall right Int64 zeroP
run isEvenCall
bind value isSignedInt64Even Bool isEvenCall
branch if condition isSignedInt64Even target isPrimeFalse

# Trial divide by odd i from 3 up to floor(sqrt(n)).
call limitCall integerSquareRootSignedInt64
argument limitCall inputValue Int64 inputValue
run limitCall
bind value limit Int64 limitCall

memory isSignedInt64Prime mutable i Int64 3
label trialLoop
call beyondCall math.greaterThanInt64
argument beyondCall left Int64 i
argument beyondCall right Int64 limit
run beyondCall
bind value beyond Bool beyondCall
branch if condition beyond target isPrimeTrue
call primeRemainderCall math.moduloInt64
argument primeRemainderCall left Int64 inputValue
argument primeRemainderCall right Int64 i
run primeRemainderCall
bind value trialDivisionRemainder Int64 primeRemainderCall
call divCheckCall math.equalInt64
argument divCheckCall left Int64 trialDivisionRemainder
argument divCheckCall right Int64 zeroP
run divCheckCall
bind value divides Bool divCheckCall
branch if condition divides target isPrimeFalse
call iIncCall math.addInt64
argument iIncCall left Int64 i
argument iIncCall right Int64 twoP
run iIncCall
bind value nextI Int64 iIncCall
set memory i nextI
jump target trialLoop

label isPrimeFalse
return value falsePr
label isPrimeTrue
return value truePr

# rationale: Returns true when inputValue is a positive power of 2 (1, 2, 4, 8, ...), computed in O(1) as inputValue > 0 AND (inputValue AND (inputValue - 1)) == 0.
# invariant: A positive power of two has exactly one set bit, so clearing the lowest set bit via (n & (n-1)) yields 0. Zero / negative inputs return false.
operation isSignedInt64PowerOfTwo
input operation isSignedInt64PowerOfTwo inputValue Int64
output operation isSignedInt64PowerOfTwo Bool
memory isSignedInt64PowerOfTwo heap no
async isSignedInt64PowerOfTwo no
purpose operation isSignedInt64PowerOfTwo "Returns true when inputValue is a positive power of 2 (1, 2, 4, 8, ...), computed in O(1) as inputValue > 0 AND (inputValue AND (inputValue - 1)) == 0."
invariant operation isSignedInt64PowerOfTwo "A positive power of two has exactly one set bit, so clearing the lowest set bit via (n & (n-1)) yields 0. Zero / negative inputs return false."
guarantee isSignedInt64PowerOfTwo "Total. O(1) - one subtract, one and, two compares."

label startIsSignedInt64PowerOfTwo
storage module immutable zeroPt Int64 0
storage module immutable oneCount Int64 1
storage module immutable truePt Bool true
storage module immutable falsePt Bool false

call leZeroPtCall math.lessThanOrEqualInt64
argument leZeroPtCall left Int64 inputValue
argument leZeroPtCall right Int64 zeroPt
run leZeroPtCall
bind value leZeroPt Bool leZeroPtCall
branch if condition leZeroPt target isPowerOfTwoFalse

# Clear the lowest set bit: for a power of two (exactly one set bit) the
# result is 0; for anything else at least one other bit survives.
call decrementForMaskCall math.subtractInt64
argument decrementForMaskCall left Int64 inputValue
argument decrementForMaskCall right Int64 oneCount
run decrementForMaskCall
bind value inputMinusOne Int64 decrementForMaskCall
call clearLowestSetBitCall math.bitwiseAndInt64
argument clearLowestSetBitCall left Int64 inputValue
argument clearLowestSetBitCall right Int64 inputMinusOne
run clearLowestSetBitCall
bind value lowestSetBitCleared Int64 clearLowestSetBitCall
call detectNoRemainingBitsCall math.equalInt64
argument detectNoRemainingBitsCall left Int64 lowestSetBitCleared
argument detectNoRemainingBitsCall right Int64 zeroPt
run detectNoRemainingBitsCall
bind value noRemainingBits Bool detectNoRemainingBitsCall
branch if condition noRemainingBits target isPowerOfTwoTrue
branch else target isPowerOfTwoFalse

label isPowerOfTwoFalse
return value falsePt
label isPowerOfTwoTrue
return value truePt

# rationale: Returns the smallest power of 2 >= inputValue (1 for inputValue <= 1).
# invariant: Doubles a 1-seeded accumulator until it reaches or exceeds inputValue; inputs <= 1 short-circuit to 1.
operation nextPowerOfTwoForSignedInt64
input operation nextPowerOfTwoForSignedInt64 inputValue Int64
output operation nextPowerOfTwoForSignedInt64 Int64
memory nextPowerOfTwoForSignedInt64 heap no
async nextPowerOfTwoForSignedInt64 no
purpose operation nextPowerOfTwoForSignedInt64 "Returns the smallest power of 2 >= inputValue (1 for inputValue <= 1)."
invariant operation nextPowerOfTwoForSignedInt64 "Doubles a 1-seeded accumulator until it reaches or exceeds inputValue; inputs <= 1 short-circuit to 1."
guarantee nextPowerOfTwoForSignedInt64 "Total."

label startNextPowerOfTwoForSignedInt64
storage module immutable oneNp Int64 1
storage module immutable twoNp Int64 2

call leOneNpCall math.lessThanOrEqualInt64
argument leOneNpCall left Int64 inputValue
argument leOneNpCall right Int64 oneNp
run leOneNpCall
bind value leOneNp Bool leOneNpCall
branch if condition leOneNp target nextPowOne

memory nextPowerOfTwoForSignedInt64 mutable p Int64 1
label doubleLoop
call gePCall math.greaterThanOrEqualInt64
argument gePCall left Int64 p
argument gePCall right Int64 inputValue
run gePCall
bind value gep Bool gePCall
branch if condition gep target nextPowDone
call doubleCall math.multiplyInt64
argument doubleCall left Int64 p
argument doubleCall right Int64 twoNp
run doubleCall
bind value nextP Int64 doubleCall
set memory p nextP
jump target doubleLoop

label nextPowDone
return value p
label nextPowOne
return value oneNp

# rationale: Returns the count of decimal digits in |inputValue|. Returns 1 for inputValue == 0.
# invariant: Divides the absolute value by 10 until the quotient is zero, counting iterations. Negative inputs are absolute-valued via multiplication by -1 first.
operation countDecimalDigitsInSignedInt64
input operation countDecimalDigitsInSignedInt64 inputValue Int64
output operation countDecimalDigitsInSignedInt64 Int64
memory countDecimalDigitsInSignedInt64 heap no
async countDecimalDigitsInSignedInt64 no
purpose operation countDecimalDigitsInSignedInt64 "Returns the count of decimal digits in |inputValue|. Returns 1 for inputValue == 0."
invariant operation countDecimalDigitsInSignedInt64 "Divides the absolute value by 10 until the quotient is zero, counting iterations. Negative inputs are absolute-valued via multiplication by -1 first."
guarantee countDecimalDigitsInSignedInt64 "Total."

label startCountDecimalDigitsInSignedInt64
storage module immutable zeroCd Int64 0
storage module immutable oneCd Int64 1
storage module immutable tenCd Int64 10
storage module immutable negOneCd Int64 -1

call eqZeroCdCall math.equalInt64
argument eqZeroCdCall left Int64 inputValue
argument eqZeroCdCall right Int64 zeroCd
run eqZeroCdCall
bind value eqZeroCd Bool eqZeroCdCall
branch if condition eqZeroCd target countDigitsOne

memory countDecimalDigitsInSignedInt64 mutable v Int64 0
set memory v inputValue
call negCdCall math.lessThanInt64
argument negCdCall left Int64 v
argument negCdCall right Int64 zeroCd
run negCdCall
bind value isNegCd Bool negCdCall
branch if condition isNegCd target flipCd
branch else target countDigitsLoop

label flipCd
call flipCdCall math.multiplyInt64
argument flipCdCall left Int64 v
argument flipCdCall right Int64 negOneCd
run flipCdCall
bind value vFlipped Int64 flipCdCall
set memory v vFlipped
jump target countDigitsLoop

label countDigitsLoop
memory countDecimalDigitsInSignedInt64 mutable count Int64 0
label cdStep
call doneCdCall math.equalInt64
argument doneCdCall left Int64 v
argument doneCdCall right Int64 zeroCd
run doneCdCall
bind value doneCd Bool doneCdCall
branch if condition doneCd target countDigitsReturn
call cdDivCall math.divideInt64
argument cdDivCall left Int64 v
argument cdDivCall right Int64 tenCd
run cdDivCall
bind value vNext Int64 cdDivCall
set memory v vNext
call cdIncCall math.addInt64
argument cdIncCall left Int64 count
argument cdIncCall right Int64 oneCd
run cdIncCall
bind value nextCount Int64 cdIncCall
set memory count nextCount
jump target cdStep

label countDigitsReturn
return value count

label countDigitsOne
return value oneCd

