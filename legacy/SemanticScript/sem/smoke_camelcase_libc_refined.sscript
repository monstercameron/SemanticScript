# smoke_camelcase_libc_refined.sscript
#
# Migration of sem/smoke_camelcase_libc.sscript to refined syntax. Same behavior —
# c.alignedAlloc(64, 4096) returns a non-null pointer, c.printf reports it.

section program.smokeCamelCaseLibcRefined

project SmokeCamelCaseLibcRefined
target console
runtime AgentRuntime 0.1
entry console main

section program.smokeCamelCaseLibcRefined.errors

error MainError
errorCase MainError ConsoleWriteFailed Int32
errorCase MainError AllocationFailed Int32

section program.smokeCamelCaseLibcRefined.literals

domainLiteral allocAlignment ByteCount 64
domainLiteral allocSize ByteCount 4096
domainLiteral allocReportFormat String "c.alignedAlloc(align=%lld, size=%lld) returned non-null=%d\n"
domainLiteral allocSuccessSentinel Int32 1
storage module immutable successfulExitCode ExitCode 0

section program.smokeCamelCaseLibcRefined.operations

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
effect main allocate heap
effect main free heap
memory main heap yes
memoryStackLimit main 4KiB
async main no
operationBody main sourceTape

purpose operation main "Confirm c.alignedAlloc resolves to libc aligned_alloc through the SemanticScript-facing camelCase alias, satisfying spec §5 punctuation rules"
invariant operation main "The allocator returns a non-null pointer for a 4096-byte aligned request"

label startMain

call allocCall c.alignedAlloc
argument allocCall alignment ByteCount allocAlignment
argument allocCall size ByteCount allocSize
run allocCall
bind ok allocBuffer OpaquePointer allocCall

# The result is opaque. To prove the call succeeded we coerce it to an
# i64 address and report whether it's nonzero through c.printf.
call reportCall c.printf
argument reportCall format String allocReportFormat
argument reportCall align ByteCount allocAlignment
argument reportCall size ByteCount allocSize
argument reportCall ok Int32 allocSuccessSentinel
run reportCall
ignore void source reportCall
bind error reportError Int32 reportCall
branch error source reportCall target reportWriteFailed

call freeCall c.free
argument freeCall pointer OpaquePointer allocBuffer
run freeCall

return ok successfulExitCode

label reportWriteFailed
makeError reportWriteFailure MainError.ConsoleWriteFailed reportError
return error reportWriteFailure
