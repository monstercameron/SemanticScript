# expect.stdout: 3628800\n
# expect.exit: 0
project DeeperRecursion
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32

operation factorialOf
input operation factorialOf n Int64
output operation factorialOf Result Int64 Void
memory factorialOf heap no
async factorialOf no
purpose operation factorialOf "Recursive factorial — deep call stack at n=10."
invariant operation factorialOf "Tail-style recursion through up to 10 frames."
label startFactorialOf
storage module immutable oneLit Int64 1
call atBaseCall math.lessThanOrEqualInt64
argument atBaseCall left Int64 n
argument atBaseCall right Int64 oneLit
run atBaseCall
bind value atBase Bool atBaseCall
branch if condition atBase target baseCase
branch else target recursiveCase
label baseCase
return ok oneLit
label recursiveCase
call decCall math.subtractInt64
argument decCall left Int64 n
argument decCall right Int64 oneLit
run decCall
bind value decremented Int64 decCall
call recCall factorialOf
argument recCall n Int64 decremented
run recCall
bind ok recResult Int64 recCall
call mulCall math.multiplyInt64
argument mulCall left Int64 n
argument mulCall right Int64 recResult
run mulCall
bind value multiplied Int64 mulCall
return ok multiplied

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Compute factorialOf(10) = 3628800."
invariant operation main "Deeper recursion than test 39."
label startMain
storage module immutable tenInitial Int64 10
memory main mutable input Int64 tenInitial
call factCall factorialOf
argument factCall n Int64 input
run factCall
bind ok factResult Int64 factCall
memory main mutable outputVar Int64 tenInitial
set memory outputVar factResult
call writeCall console.writeIntegerLine
argument writeCall console Console console
argument writeCall value Int64 outputVar
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
