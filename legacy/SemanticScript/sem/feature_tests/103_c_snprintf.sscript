# expect.stdout: val=42\n
# expect.exit: 0
project CSnprintfTest
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main read memory.buffer
effect main write memory.buffer
effect main write console.stdout
memory main heap auto
async main no
purpose operation main "Format an integer into a heap buffer via c.snprintf, then print the buffer via c.puts. Exercises 4-arg snprintf with all const args."
invariant operation main "Output is 'val=42\\n'."
label startMain
storage module immutable bufferCap ByteCount 32
storage module immutable fmtString String "val=%lld"
storage module immutable fortyTwo Int64 42
call mallocCall c.malloc
argument mallocCall size ByteCount bufferCap
run mallocCall
bind value targetBuffer OpaquePointer mallocCall

call snprCall c.snprintf
argument snprCall buffer OpaquePointer targetBuffer
argument snprCall size ByteCount bufferCap
argument snprCall format String fmtString
argument snprCall value Int64 fortyTwo
run snprCall
ignore ok source snprCall type Int32

call putsCall c.puts
argument putsCall text OpaquePointer targetBuffer
run putsCall
ignore ok source putsCall type Int32

call freeCall c.free
argument freeCall ptr OpaquePointer targetBuffer
run freeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
