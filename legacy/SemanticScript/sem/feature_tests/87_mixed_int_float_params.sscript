# expect.stdout: 6.500000\n
# expect.exit: 0
project MixedIntFloatParams
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32

operation scaleByInt
input operation scaleByInt baseValue Float64
input operation scaleByInt multiplier Int64
output operation scaleByInt Result Float64 Void
memory scaleByInt heap no
async scaleByInt no
purpose operation scaleByInt "Convert the i64 multiplier to a Float64 and multiply baseValue by it. Exercises a user op whose first param is float, second is int, and which mixes math.convertInt64ToFloat64 with math.multiplyFloat64."
invariant operation scaleByInt "Returns baseValue * (Float64) multiplier."
label startScaleByInt
call multiplierAsFloatCall math.convertInt64ToFloat64
argument multiplierAsFloatCall value Int64 multiplier
run multiplierAsFloatCall
bind value multiplierAsFloat Float64 multiplierAsFloatCall
call productCall math.multiplyFloat64
argument productCall left Float64 baseValue
argument productCall right Float64 multiplierAsFloat
run productCall
bind value scaledResult Float64 productCall
return ok scaledResult

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "scaleByInt(3.25, 2) == 6.5. Mixed-typed user-op signature."
invariant operation main "Output is 6.500000."
label startMain
storage module immutable baseValue Float64 3.25
storage module immutable multiplierValue Int64 2
call scaleCall scaleByInt
argument scaleCall baseValue Float64 baseValue
argument scaleCall multiplier Int64 multiplierValue
run scaleCall
bind ok scaledOutcome Float64 scaleCall
call writeCall console.writeFloatLine
argument writeCall console Console console
argument writeCall value Float64 scaledOutcome
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
