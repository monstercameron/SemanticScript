# expect.stdout: parsed json\n{"count":2}\n
# expect.exit: 0
languageMode permissiveExecutable
project JsonDocumentParseRoundTrip
target console
runtime AgentRuntime 0.1
module jsonDocumentParseRoundTrip

import json standard.json
dependency standard.json version 0.1 source standard

entry console main

error MainError
errorCase MainError JsonAccessFailed Int32
errorCase MainError ConsoleWriteFailed Int32

capability jsonParseStdout console.stdout write
purpose operation jsonParseStdout "Authority to print the parsed JSON document results."

capability jsonParseHeapAllocate heap allocate
purpose operation jsonParseHeapAllocate "Authority to allocate JSON serialization scratch space."

capability jsonParseHeapFree heap free
purpose operation jsonParseHeapFree "Authority to release JSON serialization scratch space."

storage module immutable successExit ExitCode 0
storage module immutable jsonAccessFailedCode Int32 1
storage module immutable consoleFailedCode Int32 2

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
effect main allocate heap
effect main free heap
effect main read json.document.tree
effect main write json.document.tree
memory main heap auto
async main no
useCapability main jsonParseStdout
useCapability main jsonParseHeapAllocate
useCapability main jsonParseHeapFree
purpose operation main "Parse an existing JSON object, read a field through a cursor, mutate the tree, remove a field, serialize the final document, and print both observable results."
invariant operation main "A no-op document parser cannot pass because stdout depends on cursorString reading parsed input and serializeDocument reflecting update/delete mutations."

label startMain

storage module immutable documentCapacity JsonCapacityBytes 2048
storage module immutable scratchCapacity JsonCapacityBytes 512
storage module immutable sourceJson JsonText "{\"title\":\"parsed json\",\"count\":1}"

call allocateScratchCall c.malloc
argument allocateScratchCall size JsonCapacityBytes scratchCapacity
run allocateScratchCall
bind value serializationScratch OpaquePointer allocateScratchCall
defer releaseScratchDefer c.free serializationScratch

call parseDocumentCall json.createDocument
argument parseDocumentCall jsonText JsonText sourceJson
argument parseDocumentCall capacityBytes JsonCapacityBytes documentCapacity
run parseDocumentCall
bind ok parsedDocument JsonDocument parseDocumentCall
bind error parseDocumentError JsonAccessError parseDocumentCall
branch error source parseDocumentCall target jsonAccessFailed

defer releaseDocumentDefer json.destroyDocument parsedDocument

call rootCursorCall json.documentRoot
argument rootCursorCall document JsonDocument parsedDocument
run rootCursorCall
bind value rootCursor JsonCursor rootCursorCall

storage module immutable titlePath String ".title"
call findTitleCursorCall json.cursorAtPath
argument findTitleCursorCall document JsonDocument parsedDocument
argument findTitleCursorCall path String titlePath
run findTitleCursorCall
bind ok titleCursor JsonCursor findTitleCursorCall
bind error findTitleCursorError JsonAccessError findTitleCursorCall
branch error source findTitleCursorCall target jsonAccessFailed

call readTitleCall json.cursorString
argument readTitleCall document JsonDocument parsedDocument
argument readTitleCall cursor JsonCursor titleCursor
argument readTitleCall scratch OpaquePointer serializationScratch
argument readTitleCall scratchCapacity JsonCapacityBytes scratchCapacity
run readTitleCall
bind ok recoveredTitle JsonText readTitleCall
bind error readTitleError JsonAccessError readTitleCall
branch error source readTitleCall target jsonAccessFailed

call writeTitleCall console.writeLine
argument writeTitleCall console Console console
argument writeTitleCall text JsonText recoveredTitle
run writeTitleCall
ignore void source writeTitleCall
bind error writeTitleError ConsoleWriteError writeTitleCall
branch error source writeTitleCall target consoleWriteFailed

storage module immutable countField String "count"
storage module immutable updatedCount Int64 2
call updateCountCall json.setObjectFieldInt64
argument updateCountCall document JsonDocument parsedDocument
argument updateCountCall cursor JsonCursor rootCursor
argument updateCountCall fieldName String countField
argument updateCountCall value Int64 updatedCount
run updateCountCall
ignore ok source updateCountCall type Int32
bind error updateCountError Int32 updateCountCall
branch error source updateCountCall target jsonAccessFailed

storage module immutable titleField String "title"
call removeTitleCall json.removeObjectField
argument removeTitleCall document JsonDocument parsedDocument
argument removeTitleCall cursor JsonCursor rootCursor
argument removeTitleCall fieldName String titleField
run removeTitleCall
ignore ok source removeTitleCall type Int32
bind error removeTitleError Int32 removeTitleCall
branch error source removeTitleCall target jsonAccessFailed

call serializeDocumentCall json.serializeDocument
argument serializeDocumentCall document JsonDocument parsedDocument
argument serializeDocumentCall scratch OpaquePointer serializationScratch
argument serializeDocumentCall scratchCapacity JsonCapacityBytes scratchCapacity
run serializeDocumentCall
bind ok serializedDocument JsonText serializeDocumentCall
bind error serializeDocumentError JsonAccessError serializeDocumentCall
branch error source serializeDocumentCall target jsonAccessFailed

call writeSerializedCall console.writeLine
argument writeSerializedCall console Console console
argument writeSerializedCall text JsonText serializedDocument
run writeSerializedCall
ignore void source writeSerializedCall
bind error writeSerializedError ConsoleWriteError writeSerializedCall
branch error source writeSerializedCall target consoleWriteFailed

return ok successExit

label jsonAccessFailed
makeError jsonAccessFailure MainError.JsonAccessFailed jsonAccessFailedCode
return error jsonAccessFailure

label consoleWriteFailed
makeError consoleFailure MainError.ConsoleWriteFailed consoleFailedCode
return error consoleFailure
