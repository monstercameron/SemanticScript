argument sumCall b Int64 valTwo
argument sumCall c Int64 valThree
argument sumCall d Int64 valFour
argument sumCall e Int64 valFive
run sumCall
bind ok total Int64 sumCall
memory main mutable totalStorage Int64 0
set memory totalStorage total
call writeCall console.writeIntegerLine
argument writeCall console Console console
argument writeCall value Int64 totalStorage
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
