# expect.stdout: 12\n
# expect.exit: 0
project FiveArgUserOp
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32

operation sumFive
input operation sumFive a Int64
input operation sumFive b Int64
input operation sumFive c Int64
input operation sumFive d Int64
input operation sumFive e Int64
output operation sumFive Result Int64 Void
memory sumFive heap no
async sumFive no
purpose operation sumFive "Add five Int64 inputs. Exercises the 5-arg user-op call site emission."
invariant operation sumFive "All five params are i64."
label startSumFive
call sumAbCall math.addInt64
argument sumAbCall left Int64 a
argument sumAbCall right Int64 b
run sumAbCall
bind value sumAb Int64 sumAbCall
call sumAbcCall math.addInt64
argument sumAbcCall left Int64 sumAb
argument sumAbcCall right Int64 c
run sumAbcCall
bind value sumAbc Int64 sumAbcCall
call sumAbcdCall math.addInt64
argument sumAbcdCall left Int64 sumAbc
argument sumAbcdCall right Int64 d
run sumAbcdCall
bind value sumAbcd Int64 sumAbcdCall
call sumAbcdeCall math.addInt64
argument sumAbcdeCall left Int64 sumAbcd
argument sumAbcdeCall right Int64 e
run sumAbcdeCall
bind value total Int64 sumAbcdeCall
return ok total

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "sumFive(1,2,3,2,4) == 12."
invariant operation main "Exercises 5-arg user-op call from main."
label startMain
storage module immutable valOne Int64 1
storage module immutable valTwo Int64 2
storage module immutable valThree Int64 3
storage module immutable valFour Int64 2
storage module immutable valFive Int64 4
call sumCall sumFive
