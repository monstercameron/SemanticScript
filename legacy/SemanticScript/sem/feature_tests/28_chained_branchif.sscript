# expect.stdout: between\n
# expect.exit: 0
project ChainedBranchIf
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Two-tier branching: x>0 AND x<10."
invariant operation main "5 falls into the between range."
label startMain
storage module immutable fiveInitial Int64 5
storage module immutable zeroCompare Int64 0
storage module immutable tenCompare Int64 10
memory main mutable value Int64 fiveInitial
call posCheckCall math.greaterThanInt64
argument posCheckCall left Int64 value
argument posCheckCall right Int64 zeroCompare
run posCheckCall
bind value isPositive Bool posCheckCall
branch if condition isPositive target checkUpperBound
branch else target outOfRangeLabel
label checkUpperBound
call upperCheckCall math.lessThanInt64
argument upperCheckCall left Int64 value
argument upperCheckCall right Int64 tenCompare
run upperCheckCall
bind value isUnderTen Bool upperCheckCall
branch if condition isUnderTen target betweenLabel
branch else target outOfRangeLabel
label betweenLabel
storage module immutable betweenText String "between"
call writeBetweenCall console.writeLine
argument writeBetweenCall console Console console
argument writeBetweenCall text String betweenText
run writeBetweenCall
ignore void source writeBetweenCall
jump target endLabel
label outOfRangeLabel
storage module immutable oorText String "out-of-range"
call writeOorCall console.writeLine
argument writeOorCall console Console console
argument writeOorCall text String oorText
run writeOorCall
ignore void source writeOorCall
jump target endLabel
label endLabel
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
