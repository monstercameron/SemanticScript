# expect.stdout: hello via helper\n
# expect.exit: 0
project UserOpWrapper
target console
runtime AgentRuntime 0.1
mode capturedOutputReplay
entry console main
error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

operation writeStandardOutputLine
input operation writeStandardOutputLine text String
output operation writeStandardOutputLine Result Void ConsoleWriteError
effect writeStandardOutputLine write console.stdout
memory writeStandardOutputLine heap no
async writeStandardOutputLine no
purpose operation writeStandardOutputLine "Helper that delegates to console.writeLine."
invariant operation writeStandardOutputLine "Passes through the text argument."
label startWriteStandardOutputLine
call innerWriteCall console.writeLine
argument innerWriteCall console Console console
argument innerWriteCall text String text
run innerWriteCall
ignore void source innerWriteCall
bind error innerWriteError ConsoleWriteError innerWriteCall
branch error source innerWriteCall target innerWriteFailed
storage module immutable innerSuccessfulExitCode ExitCode 0
return ok innerSuccessfulExitCode
label innerWriteFailed
return error innerWriteError

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Call user-defined helper; expect string emitted exactly once."
invariant operation main "Output is the helper's argument."
label startMain
storage module immutable helloText String "hello via helper"
call writeMainCall writeStandardOutputLine
argument writeMainCall text String helloText
run writeMainCall
ignore void source writeMainCall
bind error writeMainError ConsoleWriteError writeMainCall
branch error source writeMainCall target mainWriteFailed
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
label mainWriteFailed
makeError consoleWriteFailure MainError.ConsoleWriteFailed writeMainError
return error consoleWriteFailure
