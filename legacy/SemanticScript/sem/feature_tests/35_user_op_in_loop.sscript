# expect.stdout: 2\n4\n6\n8\n10\n
# expect.exit: 0
project UserOpInLoop
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32

operation doubleIt
input operation doubleIt x Int64
output operation doubleIt Result Int64 Void
memory doubleIt heap no
async doubleIt no
purpose operation doubleIt "Return 2x."
invariant operation doubleIt "Doubles input."
label startDoubleIt
storage module immutable twoLit Int64 2
call mulCall math.multiplyInt64
argument mulCall left Int64 x
argument mulCall right Int64 twoLit
run mulCall
bind value productResult Int64 mulCall
return ok productResult

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "Loop counter 1..5 and print doubleIt(counter) each iteration."
invariant operation main "Outputs 2,4,6,8,10."
label startMain
storage module immutable oneInitial Int64 1
storage module immutable fiveBound Int64 5
storage module immutable oneStep Int64 1
memory main mutable counter Int64 oneInitial
label loopHead
call checkCall math.lessThanOrEqualInt64
argument checkCall left Int64 counter
argument checkCall right Int64 fiveBound
run checkCall
bind value shouldContinue Bool checkCall
branch if condition shouldContinue target loopBody
branch else target loopExit
label loopBody
call dblCall doubleIt
argument dblCall x Int64 counter
run dblCall
bind ok doubledValue Int64 dblCall
memory main mutable doubledVar Int64 oneInitial
set memory doubledVar doubledValue
call printCall console.writeIntegerLine
argument printCall console Console console
argument printCall value Int64 doubledVar
run printCall
ignore void source printCall
call incCall math.addInt64
argument incCall left Int64 counter
argument incCall right Int64 oneStep
run incCall
bind value nextCounter Int64 incCall
set memory counter nextCounter
jump target loopHead
label loopExit
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
