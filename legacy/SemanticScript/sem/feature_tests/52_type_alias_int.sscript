# expect.stdout: 17\n
# expect.exit: 0
project TypeAliasInt
target console
runtime AgentRuntime 0.1
type SmallInt Int64
type SmallStep Int64
entry console main
error MainError
errorCase MainError Placeholder Int32
operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "var x SmallInt + const SmallStep should print 17."
invariant operation main "Type aliases resolving to Int64 work transparently."
label startMain
storage module immutable tenInitial SmallInt 10
storage module immutable sevenStep SmallStep 7
memory main mutable x SmallInt tenInitial
call addCall math.addInt64
argument addCall left Int64 x
argument addCall right Int64 sevenStep
run addCall
bind value sumValue Int64 addCall
memory main mutable resultVar SmallInt tenInitial
set memory resultVar sumValue
call writeCall console.writeIntegerLine
argument writeCall console Console console
argument writeCall value SmallInt resultVar
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
