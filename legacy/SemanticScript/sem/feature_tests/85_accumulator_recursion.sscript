# expect.stdout: 55\n
# expect.exit: 0
project AccumulatorRecursion
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32

operation sumTo
input operation sumTo accumulator Int64
input operation sumTo remaining Int64
output operation sumTo Result Int64 Void
memory sumTo heap no
async sumTo no
purpose operation sumTo "Tail-recursive accumulator: when `remaining` reaches 0, return `accumulator`; otherwise sumTo(accumulator + remaining, remaining - 1)."
invariant operation sumTo "Computes sum(1..n) in O(n) recursion depth."
label startSumTo
storage module immutable zeroBase Int64 0
storage module immutable oneStep Int64 1
call doneCheckCall math.equalInt64
argument doneCheckCall left Int64 remaining
argument doneCheckCall right Int64 zeroBase
run doneCheckCall
bind value isDone Bool doneCheckCall
branch if condition isDone target baseCaseSumTo
call newAccumCall math.addInt64
argument newAccumCall left Int64 accumulator
argument newAccumCall right Int64 remaining
run newAccumCall
bind value newAccumulator Int64 newAccumCall
call decRemainingCall math.subtractInt64
argument decRemainingCall left Int64 remaining
argument decRemainingCall right Int64 oneStep
run decRemainingCall
bind value nextRemaining Int64 decRemainingCall
call recurseCall sumTo
argument recurseCall accumulator Int64 newAccumulator
argument recurseCall remaining Int64 nextRemaining
run recurseCall
bind ok recursiveResult Int64 recurseCall
return ok recursiveResult
label baseCaseSumTo
return ok accumulator

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "sumTo(0, 10) == 0+10+9+...+1 == 55."
invariant operation main "Verifies a 2-arg recursive accumulator can reach a base case 10 levels deep."
label startMain
storage module immutable zeroAccum Int64 0
storage module immutable tenInitial Int64 10
call computeCall sumTo
argument computeCall accumulator Int64 zeroAccum
argument computeCall remaining Int64 tenInitial
run computeCall
bind ok computedSum Int64 computeCall
memory main mutable sumStorage Int64 0
set memory sumStorage computedSum
call writeCall console.writeIntegerLine
argument writeCall console Console console
argument writeCall value Int64 sumStorage
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
