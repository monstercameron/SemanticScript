# expect.stdout: 14\n
# expect.exit: 0
project FourArgUserOp
target console
runtime AgentRuntime 0.1
entry console main
error MainError
errorCase MainError Placeholder Int32

operation fmaInt
input operation fmaInt a Int64
input operation fmaInt b Int64
input operation fmaInt c Int64
input operation fmaInt d Int64
output operation fmaInt Result Int64 Void
memory fmaInt heap no
async fmaInt no
purpose operation fmaInt "Compute a*b + c*d using four Int64 inputs. Exercises a 4-arg user-op call site emission path."
invariant operation fmaInt "All four inputs are i64."
label startFmaInt
call mulAbCall math.multiplyInt64
argument mulAbCall left Int64 a
argument mulAbCall right Int64 b
run mulAbCall
bind value ab Int64 mulAbCall
call mulCdCall math.multiplyInt64
argument mulCdCall left Int64 c
argument mulCdCall right Int64 d
run mulCdCall
bind value cd Int64 mulCdCall
call sumCall math.addInt64
argument sumCall left Int64 ab
argument sumCall right Int64 cd
run sumCall
bind value total Int64 sumCall
return ok total

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
async main no
purpose operation main "fmaInt(2,3,4,2) == 2*3 + 4*2 == 14."
invariant operation main "Exercises a 4-arg user-op call from main."
label startMain
storage module immutable twoVal Int64 2
storage module immutable threeVal Int64 3
storage module immutable fourVal Int64 4
storage module immutable anotherTwo Int64 2
call computeCall fmaInt
argument computeCall a Int64 twoVal
argument computeCall b Int64 threeVal
argument computeCall c Int64 fourVal
argument computeCall d Int64 anotherTwo
run computeCall
bind ok computedTotal Int64 computeCall
memory main mutable totalStorage Int64 0
set memory totalStorage computedTotal
call writeCall console.writeIntegerLine
argument writeCall console Console console
argument writeCall value Int64 totalStorage
run writeCall
ignore void source writeCall
storage module immutable successfulExitCode ExitCode 0
return ok successfulExitCode
