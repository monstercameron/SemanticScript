# fizzbuzz_refined.sscript
#
# Migration of sem/fizzbuzz.sscript to refined syntax. Same behavior — print
# the FizzBuzz sequence for 1..15, one entry per line.

section program.fizzBuzzRefined

project FizzBuzzRefined
target console
runtime AgentRuntime 0.1
entry console main

section program.fizzBuzzRefined.types

type FizzBuzzCounter Int64
type FizzBuzzDivisor Int64
type PositiveFizzBuzzStep Int64
type FizzBuzzRemainder Int64

section program.fizzBuzzRefined.errors

error MainError
errorCase MainError ConsoleWriteFailed ConsoleWriteError

section program.fizzBuzzRefined.literals

domainLiteral fizzBuzzLowerLimit FizzBuzzCounter 1
domainLiteral fizzBuzzUpperLimit FizzBuzzCounter 15
storage module immutable fizzBuzzStepValue PositiveFizzBuzzStep 1
domainLiteral fizzDivisorValue FizzBuzzDivisor 3
domainLiteral buzzDivisorValue FizzBuzzDivisor 5
domainLiteral fizzBuzzDivisorValue FizzBuzzDivisor 15
domainLiteral remainderZeroValue FizzBuzzRemainder 0
domainLiteral fizzWordText String "Fizz"
domainLiteral buzzWordText String "Buzz"
domainLiteral fizzBuzzWordText String "FizzBuzz"
storage module immutable successfulExitCode ExitCode 0

section program.fizzBuzzRefined.operations

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
memoryStackLimit main 16KiB
async main no
operationBody main sourceTape

purpose operation main "Print the FizzBuzz sequence for values from fizzBuzzLowerLimit through fizzBuzzUpperLimit, one entry per output line"
invariant operation main "currentFizzBuzzCounter is monotonically increasing and bounded above by fizzBuzzUpperLimit"
invariant operation main "Each iteration of the loop body produces exactly one line of output"
invariant operation main "fizzBuzzStepValue is strictly greater than zero"

label startMain

memory main mutable currentFizzBuzzCounter FizzBuzzCounter fizzBuzzLowerLimit

label fizzBuzzLoopHead

# rationale: Continue while currentFizzBuzzCounter is less than or equal to fizzBuzzUpperLimit.
call fizzBuzzRangeCheckCall FizzBuzzCounter.lessThanOrEqual
argument fizzBuzzRangeCheckCall left FizzBuzzCounter currentFizzBuzzCounter
argument fizzBuzzRangeCheckCall right FizzBuzzCounter fizzBuzzUpperLimit
run fizzBuzzRangeCheckCall
bind value fizzBuzzShouldContinue Bool fizzBuzzRangeCheckCall

branch if condition fizzBuzzShouldContinue target fizzBuzzLoopBody
branch else target fizzBuzzFinished

label fizzBuzzLoopBody

# rationale: Compute the remainder of the counter divided by fifteen.
call moduloByFifteenCall FizzBuzzCounter.moduloBy
argument moduloByFifteenCall counter FizzBuzzCounter currentFizzBuzzCounter
argument moduloByFifteenCall divisor FizzBuzzDivisor fizzBuzzDivisorValue
run moduloByFifteenCall
bind value moduloByFifteenValue FizzBuzzRemainder moduloByFifteenCall

# rationale: A zero remainder against fifteen means the value is divisible by fifteen.
call isDivisibleByFifteenCheckCall FizzBuzzRemainder.equal
argument isDivisibleByFifteenCheckCall left FizzBuzzRemainder moduloByFifteenValue
argument isDivisibleByFifteenCheckCall right FizzBuzzRemainder remainderZeroValue
run isDivisibleByFifteenCheckCall
bind value currentValueIsDivisibleByFifteen Bool isDivisibleByFifteenCheckCall

branch if condition currentValueIsDivisibleByFifteen target printFizzBuzzWord
branch else target checkDivisibleByThree

label printFizzBuzzWord
call writeFizzBuzzWordCall console.writeLine
argument writeFizzBuzzWordCall console Console console
argument writeFizzBuzzWordCall text String fizzBuzzWordText
run writeFizzBuzzWordCall
ignore void source writeFizzBuzzWordCall
bind error writeFizzBuzzWordError ConsoleWriteError writeFizzBuzzWordCall
branch error source writeFizzBuzzWordCall target fizzBuzzWordWriteFailed
branch else target fizzBuzzLoopStep

label checkDivisibleByThree
call moduloByThreeCall FizzBuzzCounter.moduloBy
argument moduloByThreeCall counter FizzBuzzCounter currentFizzBuzzCounter
argument moduloByThreeCall divisor FizzBuzzDivisor fizzDivisorValue
run moduloByThreeCall
bind value moduloByThreeValue FizzBuzzRemainder moduloByThreeCall

call isDivisibleByThreeCheckCall FizzBuzzRemainder.equal
argument isDivisibleByThreeCheckCall left FizzBuzzRemainder moduloByThreeValue
argument isDivisibleByThreeCheckCall right FizzBuzzRemainder remainderZeroValue
run isDivisibleByThreeCheckCall
bind value currentValueIsDivisibleByThree Bool isDivisibleByThreeCheckCall

branch if condition currentValueIsDivisibleByThree target printFizzWord
branch else target checkDivisibleByFive

label printFizzWord
call writeFizzWordCall console.writeLine
argument writeFizzWordCall console Console console
argument writeFizzWordCall text String fizzWordText
run writeFizzWordCall
ignore void source writeFizzWordCall
bind error writeFizzWordError ConsoleWriteError writeFizzWordCall
branch error source writeFizzWordCall target fizzWordWriteFailed
branch else target fizzBuzzLoopStep

label checkDivisibleByFive
call moduloByFiveCall FizzBuzzCounter.moduloBy
argument moduloByFiveCall counter FizzBuzzCounter currentFizzBuzzCounter
argument moduloByFiveCall divisor FizzBuzzDivisor buzzDivisorValue
run moduloByFiveCall
bind value moduloByFiveValue FizzBuzzRemainder moduloByFiveCall

call isDivisibleByFiveCheckCall FizzBuzzRemainder.equal
argument isDivisibleByFiveCheckCall left FizzBuzzRemainder moduloByFiveValue
argument isDivisibleByFiveCheckCall right FizzBuzzRemainder remainderZeroValue
run isDivisibleByFiveCheckCall
bind value currentValueIsDivisibleByFive Bool isDivisibleByFiveCheckCall

branch if condition currentValueIsDivisibleByFive target printBuzzWord
branch else target printCurrentFizzBuzzCounter

label printBuzzWord
call writeBuzzWordCall console.writeLine
argument writeBuzzWordCall console Console console
argument writeBuzzWordCall text String buzzWordText
run writeBuzzWordCall
ignore void source writeBuzzWordCall
bind error writeBuzzWordError ConsoleWriteError writeBuzzWordCall
branch error source writeBuzzWordCall target buzzWordWriteFailed
branch else target fizzBuzzLoopStep

label printCurrentFizzBuzzCounter
call writeCurrentFizzBuzzCounterCall console.writeIntegerLine
argument writeCurrentFizzBuzzCounterCall console Console console
argument writeCurrentFizzBuzzCounterCall value FizzBuzzCounter currentFizzBuzzCounter
run writeCurrentFizzBuzzCounterCall
ignore void source writeCurrentFizzBuzzCounterCall
bind error writeCurrentFizzBuzzCounterError ConsoleWriteError writeCurrentFizzBuzzCounterCall
branch error source writeCurrentFizzBuzzCounterCall target currentFizzBuzzCounterWriteFailed
branch else target fizzBuzzLoopStep

label fizzBuzzLoopStep
call fizzBuzzCounterIncrementCall FizzBuzzCounter.add
argument fizzBuzzCounterIncrementCall counter FizzBuzzCounter currentFizzBuzzCounter
argument fizzBuzzCounterIncrementCall step PositiveFizzBuzzStep fizzBuzzStepValue
run fizzBuzzCounterIncrementCall
bind value nextFizzBuzzCounter FizzBuzzCounter fizzBuzzCounterIncrementCall
set memory currentFizzBuzzCounter nextFizzBuzzCounter
jump target fizzBuzzLoopHead

label fizzBuzzFinished
return ok successfulExitCode

# rationale: Each fallible write has its own labeled failure handler so that the
# MainError.ConsoleWriteFailed value built with `makeError` honestly references
# the specific raw ConsoleWriteError that was bound on that path (§12).

label fizzBuzzWordWriteFailed
makeError fizzBuzzWordWriteFailure MainError.ConsoleWriteFailed writeFizzBuzzWordError
return error fizzBuzzWordWriteFailure

label fizzWordWriteFailed
makeError fizzWordWriteFailure MainError.ConsoleWriteFailed writeFizzWordError
return error fizzWordWriteFailure

label buzzWordWriteFailed
makeError buzzWordWriteFailure MainError.ConsoleWriteFailed writeBuzzWordError
return error buzzWordWriteFailure

label currentFizzBuzzCounterWriteFailed
makeError currentFizzBuzzCounterWriteFailure MainError.ConsoleWriteFailed writeCurrentFizzBuzzCounterError
return error currentFizzBuzzCounterWriteFailure
