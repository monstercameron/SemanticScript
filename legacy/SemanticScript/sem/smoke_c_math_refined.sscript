# smoke_c_math_refined.sscript
#
# Migration of sem/smoke_c_math.sscript to refined syntax. Same behavior —
# exercise c.sqrt, c.pow, c.sin, c.cos against c.printf to confirm the
# Float64 ABI round-trip.

section program.smokeCMathRefined

project SmokeCMathRefined
target console
runtime AgentRuntime 0.1
entry console main

section program.smokeCMathRefined.errors

error MainError
errorCase MainError ConsoleWriteFailed Int32

section program.smokeCMathRefined.literals

domainLiteral formatSquareRootText String "sqrt(%g) = %g\n"
domainLiteral formatPowText String "pow(%g, %g) = %g\n"
domainLiteral formatSinCosText String "sin(%g) = %g; cos(%g) = %g\n"
domainLiteral inputSquareRootValue Float64 2.0
domainLiteral inputPowBase Float64 2.0
domainLiteral inputPowExponent Float64 10.0
domainLiteral inputAngleRadians Float64 1.5707963267948966
storage module immutable successfulExitCode ExitCode 0

section program.smokeCMathRefined.operations

operation main
input operation main console Console
output operation main Result ExitCode MainError
effect main write console.stdout
memory main heap no
memoryStackLimit main 4KiB
async main no
operationBody main sourceTape

purpose operation main "Exercise c.sqrt, c.pow, c.sin, c.cos against printf so the Float64 ABI round-trip is observable"
invariant operation main "Each c.* math call lowers to a direct extern call with no SemanticScript-side wrapping"

label startMain

call sqrtCall c.sqrt
argument sqrtCall x Float64 inputSquareRootValue
run sqrtCall
bind value sqrtResult Float64 sqrtCall

call printSqrtCall c.printf
argument printSqrtCall format String formatSquareRootText
argument printSqrtCall input Float64 inputSquareRootValue
argument printSqrtCall result Float64 sqrtResult
run printSqrtCall
ignore void source printSqrtCall
bind error printSqrtError Int32 printSqrtCall
branch error source printSqrtCall target sqrtWriteFailed

call powCall c.pow
argument powCall base Float64 inputPowBase
argument powCall exponent Float64 inputPowExponent
run powCall
bind value powResult Float64 powCall

call printPowCall c.printf
argument printPowCall format String formatPowText
argument printPowCall base Float64 inputPowBase
argument printPowCall exponent Float64 inputPowExponent
argument printPowCall result Float64 powResult
run printPowCall
ignore void source printPowCall
bind error printPowError Int32 printPowCall
branch error source printPowCall target powWriteFailed

call sinCall c.sin
argument sinCall x Float64 inputAngleRadians
run sinCall
bind value sinResult Float64 sinCall

call cosCall c.cos
argument cosCall x Float64 inputAngleRadians
run cosCall
bind value cosResult Float64 cosCall

call printSinCosCall c.printf
argument printSinCosCall format String formatSinCosText
argument printSinCosCall angleSin Float64 inputAngleRadians
argument printSinCosCall valueSin Float64 sinResult
argument printSinCosCall angleCos Float64 inputAngleRadians
argument printSinCosCall valueCos Float64 cosResult
run printSinCosCall
ignore void source printSinCosCall
bind error printSinCosError Int32 printSinCosCall
branch error source printSinCosCall target sinCosWriteFailed

return ok successfulExitCode

label sqrtWriteFailed
makeError sqrtWriteFailure MainError.ConsoleWriteFailed printSqrtError
return error sqrtWriteFailure

label powWriteFailed
makeError powWriteFailure MainError.ConsoleWriteFailed printPowError
return error powWriteFailure

label sinCosWriteFailed
makeError sinCosWriteFailure MainError.ConsoleWriteFailed printSinCosError
return error sinCosWriteFailure
