{
  "schema": 2,
  "comment": "Native runtime libraries linked into JIT/native builds. semanticscript reads this data \u2014 it carries no per-library knowledge in the compiler. A library is built (cached) and loaded only when a program references a runtimeBinding symbol matching one of its `provides` prefixes. R-018: link inputs are platform-scoped. Top-level `sources`/`include`/`defines`/`libs` are the cross-platform base; `platforms.<name>` (windows|linux|macos|wasi) adds host-specific entries, and `compiler.<driver>` (gnu|clang|msvc|zig) adds driver-specific overlays. The resolver `_resolve_runtime_links(library, platform)` merges base + platform + compiler WITHOUT compiling, so non-Windows builds never see Windows-only libs like ws2_32 (R-013).",
  "libraries": [
    {
      "name": "ss_runtime",
      "provides": [
        "ss_sqlite_"
      ],
      "exports": [
        "ss_sqlite_exec",
        "ss_sqlite_library_version"
      ],
      "sources": [
        "ss_sqlite.c",
        "../legacy/SemanticScript/runtime/native_sqlite/sem_sqlite_runtime.c",
        "../third_party/sqlite/sqlite3.c"
      ],
      "include": [
        "../legacy/SemanticScript/runtime/native_sqlite",
        "../third_party/sqlite"
      ],
      "defines": [
        "SQLITE_THREADSAFE=0",
        "SQLITE_OMIT_LOAD_EXTENSION"
      ],
      "platforms": {
        "linux": {
          "comment": "R-018: SQLite on Unix links pthread/dl/math; expressed here so the resolver can surface Unix-only link inputs that a Windows build must never see.",
          "libs": [
            "pthread",
            "dl",
            "m"
          ]
        },
        "macos": {
          "comment": "R-018: macOS SQLite links the math + dynamic-loader libs; pthread is provided by libSystem but kept explicit for parity with the Linux profile.",
          "libs": [
            "pthread",
            "dl",
            "m"
          ]
        }
      }
    },
    {
      "name": "ss_http",
      "provides": [
        "ss_http_"
      ],
      "exports": [
        "ss_http_now_millis",
        "ss_http_request_path",
        "ss_http_session_expires_at",
        "ss_http_session_is_expired"
      ],
      "sources": [
        "ss_http.c",
        "../legacy/SemanticScript/runtime/native_http/sem_http_runtime.c"
      ],
      "include": [
        "../legacy/SemanticScript/runtime/native_http"
      ],
      "defines": [
        "_CRT_SECURE_NO_WARNINGS"
      ],
      "platforms": {
        "windows": {
          "comment": "R-013: Winsock (ws2_32) is required for sockets on Windows only; POSIX hosts must NOT receive -lws2_32 or the link fails.",
          "libs": [
            "ws2_32"
          ]
        }
      }
    },
    {
