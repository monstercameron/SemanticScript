argument abovePrintableCheckCall left Int32 keyCode
argument abovePrintableCheckCall right Int32 maxPrintableKey
run abovePrintableCheckCall
bind value abovePrintable Bool abovePrintableCheckCall
branch if condition abovePrintable target skipAppendPrintableKey
call maxWritableIndexCall math.subtractInt64
argument maxWritableIndexCall left Int64 bufferCapacity
argument maxWritableIndexCall right Int64 oneStep
run maxWritableIndexCall
bind value maxWritableIndex Int64 maxWritableIndexCall
call capacityCheckCall math.greaterThanOrEqualInt64
argument capacityCheckCall left Int64 currentLength
argument capacityCheckCall right Int64 maxWritableIndex
run capacityCheckCall
bind value bufferFull Bool capacityCheckCall
branch if condition bufferFull target skipAppendPrintableKey
call storeKeyCall pointer.storeByte
argument storeKeyCall buffer OpaquePointer targetBuffer
argument storeKeyCall offset ByteCount currentLength
argument storeKeyCall value Int64 keyCode
run storeKeyCall
call incrementLengthCall math.addInt64
argument incrementLengthCall left Int64 currentLength
argument incrementLengthCall right Int64 oneStep
run incrementLengthCall
bind value nextLength Int64 incrementLengthCall
call terminateBufferCall pointer.storeByte
argument terminateBufferCall buffer OpaquePointer targetBuffer
argument terminateBufferCall offset ByteCount nextLength
argument terminateBufferCall value Int64 nulByte
run terminateBufferCall
return value nextLength
label skipAppendPrintableKey
return value currentLength

