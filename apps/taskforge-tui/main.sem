label closeAfterWriteFailed
call closeAfterWriteFailedCall c.fclose
argument closeAfterWriteFailedCall stream CFileHandle fileHandle
run closeAfterWriteFailedCall
ignore value source closeAfterWriteFailedCall type CSignedInt32
return value SaveWriteFailed
label returnSaveCloseFailed
