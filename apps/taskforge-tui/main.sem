authority saveTodosToJson write filesystem
authority saveTodosToJson open file
authority saveTodosToJson close file
memory saveTodosToJson heap no
async saveTodosToJson no
purpose operation saveTodosToJson "Persist the active todo array as a JSON array."
invariant operation saveTodosToJson "The save loop writes each active todo index once from zero up to todoCount, title bytes pass through JSON escaping, and write failure takes precedence if close also fails."
label startSaveTodosToJson
storage local immutable zeroValue Int64 0
storage local immutable oneValue Int64 1
storage local immutable dataFilePath String "todos.json"
storage local immutable writeMode String "w"
storage local immutable openArrayText String "[\n"
storage local immutable closeArrayText String "]\n"
storage local immutable itemPrefixFormatText String "{\"active\":1,\"done\":%d,\"title\":\""
storage local immutable itemSuffixText String "\"}\n"
storage local immutable itemCommaSuffixText String "\"},\n"
storage local mutable saveIndex Int64 zeroValue
call openCall c.fopen
argument openCall filename String dataFilePath
argument openCall mode String writeMode
run openCall
bind value fileHandle FileHandle openCall
call fileNullCheckCall pointer.isNull
argument fileNullCheckCall pointer OpaquePointer fileHandle
run fileNullCheckCall
bind value fileIsNull Bool fileNullCheckCall
branch if condition fileIsNull target saveSkipped
call openArrayCall c.fprintf
argument openArrayCall stream FileHandle fileHandle
argument openArrayCall format String openArrayText
run openArrayCall
bind value openArrayResult Int32 openArrayCall
call openArrayFailedCall isNegativeStatus
argument openArrayFailedCall statusCode Int32 openArrayResult
run openArrayFailedCall
bind value openArrayFailed Bool openArrayFailedCall
branch if condition openArrayFailed target closeAfterWriteFailed
label saveLoop
call saveDoneCheckCall math.greaterThanOrEqualInt64
argument saveDoneCheckCall left Int64 saveIndex
argument saveDoneCheckCall right Int64 todoCount
run saveDoneCheckCall
bind value saveDone Bool saveDoneCheckCall
branch if condition saveDone target finishSave
call doneLoadCall pointer.loadByte
argument doneLoadCall buffer OpaquePointer doneArray
argument doneLoadCall offset ByteCount saveIndex
run doneLoadCall
bind value doneValue Int32 doneLoadCall
call titlePointerCall getTitlePointerAt
argument titlePointerCall titlesBuffer OpaquePointer titlesBuffer
argument titlePointerCall todoIndex Int64 saveIndex
argument titlePointerCall titleCapacity Int64 titleCapacity
run titlePointerCall
bind value titlePointer OpaquePointer titlePointerCall
call nextIndexCall math.addInt64
argument nextIndexCall left Int64 saveIndex
argument nextIndexCall right Int64 oneValue
run nextIndexCall
bind value nextSaveIndex Int64 nextIndexCall
call lastItemCheckCall math.equalInt64
argument lastItemCheckCall left Int64 nextSaveIndex
argument lastItemCheckCall right Int64 todoCount
run lastItemCheckCall
bind value isLastItem Bool lastItemCheckCall
call writeItemPrefixCall c.fprintf
argument writeItemPrefixCall stream FileHandle fileHandle
argument writeItemPrefixCall format String itemPrefixFormatText
argument writeItemPrefixCall done Int32 doneValue
run writeItemPrefixCall
bind value itemPrefixWriteResult Int32 writeItemPrefixCall
call itemPrefixWriteFailedCall isNegativeStatus
argument itemPrefixWriteFailedCall statusCode Int32 itemPrefixWriteResult
run itemPrefixWriteFailedCall
bind value itemPrefixWriteFailed Bool itemPrefixWriteFailedCall
branch if condition itemPrefixWriteFailed target closeAfterWriteFailed
call writeTitleCall writeJsonEscapedStringBuffer
argument writeTitleCall fileHandle FileHandle fileHandle
argument writeTitleCall titleBuffer OpaquePointer titlePointer
run writeTitleCall
bind value titleWriteStatus SaveTodosStatus writeTitleCall
call titleWriteSuccessCall SaveTodosStatus.equal
argument titleWriteSuccessCall left SaveTodosStatus titleWriteStatus
argument titleWriteSuccessCall right SaveTodosStatus SaveSucceeded
run titleWriteSuccessCall
bind value titleWriteSucceeded Bool titleWriteSuccessCall
branch if condition titleWriteSucceeded target continueAfterTitleWrite
branch else target closeAfterWriteFailed
label continueAfterTitleWrite
branch if condition isLastItem target writeLastItemSuffix
call writeItemCommaSuffixCall c.fprintf
argument writeItemCommaSuffixCall stream FileHandle fileHandle
argument writeItemCommaSuffixCall format String itemCommaSuffixText
run writeItemCommaSuffixCall
bind value commaSuffixWriteResult Int32 writeItemCommaSuffixCall
call commaSuffixWriteFailedCall isNegativeStatus
argument commaSuffixWriteFailedCall statusCode Int32 commaSuffixWriteResult
run commaSuffixWriteFailedCall
bind value commaSuffixWriteFailed Bool commaSuffixWriteFailedCall
branch if condition commaSuffixWriteFailed target closeAfterWriteFailed
set memory saveIndex nextSaveIndex
jump target saveLoop
label writeLastItemSuffix
call writeItemSuffixCall c.fprintf
argument writeItemSuffixCall stream FileHandle fileHandle
argument writeItemSuffixCall format String itemSuffixText
run writeItemSuffixCall
bind value itemSuffixWriteResult Int32 writeItemSuffixCall
call itemSuffixWriteFailedCall isNegativeStatus
argument itemSuffixWriteFailedCall statusCode Int32 itemSuffixWriteResult
run itemSuffixWriteFailedCall
bind value itemSuffixWriteFailed Bool itemSuffixWriteFailedCall
branch if condition itemSuffixWriteFailed target closeAfterWriteFailed
set memory saveIndex nextSaveIndex
jump target saveLoop
label finishSave
call closeArrayCall c.fprintf
argument closeArrayCall stream FileHandle fileHandle
argument closeArrayCall format String closeArrayText
run closeArrayCall
bind value closeArrayWriteResult Int32 closeArrayCall
call closeArrayWriteFailedCall isNegativeStatus
argument closeArrayWriteFailedCall statusCode Int32 closeArrayWriteResult
run closeArrayWriteFailedCall
bind value closeArrayWriteFailed Bool closeArrayWriteFailedCall
branch if condition closeArrayWriteFailed target closeAfterWriteFailed
call closeCall c.fclose
argument closeCall stream FileHandle fileHandle
run closeCall
bind value closeResult Int32 closeCall
call closeFailedCall isNegativeStatus
argument closeFailedCall statusCode Int32 closeResult
run closeFailedCall
bind value closeFailed Bool closeFailedCall
branch if condition closeFailed target returnSaveCloseFailed
return value SaveSucceeded
label closeAfterWriteFailed
call closeAfterWriteFailedCall c.fclose
argument closeAfterWriteFailedCall stream FileHandle fileHandle
run closeAfterWriteFailedCall
ignore value source closeAfterWriteFailedCall type Int32
return value SaveWriteFailed
label returnSaveCloseFailed
return value SaveCloseFailed
label saveSkipped
return value SaveOpenFailed

operation loadTodosFromJson
input operation loadTodosFromJson doneArray OpaquePointer
input operation loadTodosFromJson titlesBuffer OpaquePointer
input operation loadTodosFromJson todoCapacity Int64
input operation loadTodosFromJson titleCapacity Int64
input operation loadTodosFromJson lineBuffer OpaquePointer
input operation loadTodosFromJson lineBufferCapacity Int32
output operation loadTodosFromJson Int64
effect loadTodosFromJson read filesystem
effect loadTodosFromJson open file
effect loadTodosFromJson close file
effect loadTodosFromJson read memory.buffer
effect loadTodosFromJson write memory.buffer
authority loadTodosFromJson read filesystem
authority loadTodosFromJson open file
authority loadTodosFromJson close file
authority loadTodosFromJson read memory.buffer
authority loadTodosFromJson write memory.buffer
memory loadTodosFromJson heap no
async loadTodosFromJson no
purpose operation loadTodosFromJson "Load active todo objects from todos.json into the heap-backed arrays."
invariant operation loadTodosFromJson "The load loop never appends more than todoCapacity active todos and accepts only the exact object key order emitted by saveTodosToJson."
invariant operation loadTodosFromJson "activeValueOffset, doneValueOffset, and titleValueOffset are coupled to saveTodosToJson's itemPrefixFormatText. Any edit to that format string must update all three offsets in lockstep or this loader will silently parse the wrong byte positions."
warning loadTodosFromJson "Malformed lines are skipped or truncated by fixed-offset parsing; this is not a general JSON decoder."
label startLoadTodosFromJson
storage local immutable zeroValue Int64 0
storage local immutable oneValue Int64 1
storage local immutable oneFlag Int32 1
storage local immutable dataFilePath String "todos.json"
storage local immutable readMode String "r"
# rationale: Offsets count bytes into the line written by saveTodosToJson's
# itemPrefixFormatText `{"active":1,"done":%d,"title":"`.
#   {"active":   = 10 bytes → activeValueOffset points at the active digit
#   ,"done":     = 9 bytes  → doneValueOffset = 10 + 9 = 19
#   ,"title":"   = 11 bytes → titleValueOffset = 19 + 11 = 30
# Any edit to itemPrefixFormatText must update these three offsets in lockstep.
storage local immutable activeValueOffset Int64 10
storage local immutable doneValueOffset Int64 19
storage local immutable titleValueOffset Int64 30
storage local mutable loadedCount Int64 zeroValue
call openCall c.fopen
argument openCall filename String dataFilePath
argument openCall mode String readMode
run openCall
bind value fileHandle FileHandle openCall
call fileNullCheckCall pointer.isNull
argument fileNullCheckCall pointer OpaquePointer fileHandle
run fileNullCheckCall
bind value fileIsNull Bool fileNullCheckCall
branch if condition fileIsNull target loadSkipped
# rationale: Consume and discard the opening `[\n` line emitted by
# saveTodosToJson's openArrayText. The result is intentionally ignored:
# an empty or malformed file makes the next c.fgets in loadLoop return
# NULL, which the readReturnedNull check below detects and branches to
# finishLoad. There is no separate diagnostic for a missing `[` because
# the loader is best-effort by design (see warning on loadTodosFromJson).
call readOpenArrayCall c.fgets
argument readOpenArrayCall string OpaquePointer lineBuffer
argument readOpenArrayCall count Int32 lineBufferCapacity
argument readOpenArrayCall stream FileHandle fileHandle
run readOpenArrayCall
ignore value source readOpenArrayCall type String
label loadLoop
call capacityCheckCall math.greaterThanOrEqualInt64
argument capacityCheckCall left Int64 loadedCount
argument capacityCheckCall right Int64 todoCapacity
run capacityCheckCall
bind value capacityReached Bool capacityCheckCall
branch if condition capacityReached target finishLoad
call readLineCall c.fgets
argument readLineCall string OpaquePointer lineBuffer
argument readLineCall count Int32 lineBufferCapacity
argument readLineCall stream FileHandle fileHandle
run readLineCall
bind value lineReadResult String readLineCall
call readNullCheckCall pointer.isNull
argument readNullCheckCall pointer OpaquePointer lineReadResult
run readNullCheckCall
bind value readReturnedNull Bool readNullCheckCall
branch if condition readReturnedNull target finishLoad
call firstByteCall pointer.loadByte
argument firstByteCall buffer OpaquePointer lineBuffer
argument firstByteCall offset ByteCount zeroValue
run firstByteCall
bind value firstByte Int32 firstByteCall
call closeBracketCheckCall math.equalInt32
argument closeBracketCheckCall left Int32 firstByte
argument closeBracketCheckCall right Int32 closeBracketByte
run closeBracketCheckCall
bind value lineIsCloseBracket Bool closeBracketCheckCall
branch if condition lineIsCloseBracket target finishLoad
call activeParseCall parseJsonFlagAtOffset
argument activeParseCall sourceLine OpaquePointer lineBuffer
argument activeParseCall valueOffset Int64 activeValueOffset
run activeParseCall
bind value activeValue Int32 activeParseCall
call activeCheckCall math.equalInt32
argument activeCheckCall left Int32 activeValue
argument activeCheckCall right Int32 oneFlag
run activeCheckCall
bind value lineIsActive Bool activeCheckCall
branch if condition lineIsActive target appendLoadedTodo
branch else target loadLoop
label appendLoadedTodo
call doneParseCall parseJsonFlagAtOffset
argument doneParseCall sourceLine OpaquePointer lineBuffer
argument doneParseCall valueOffset Int64 doneValueOffset
run doneParseCall
bind value doneValue Int32 doneParseCall
call storeDoneCall pointer.storeByte
argument storeDoneCall buffer OpaquePointer doneArray
argument storeDoneCall offset ByteCount loadedCount
argument storeDoneCall value Int64 doneValue
run storeDoneCall
call titlePointerCall getTitlePointerAt
argument titlePointerCall titlesBuffer OpaquePointer titlesBuffer
argument titlePointerCall todoIndex Int64 loadedCount
argument titlePointerCall titleCapacity Int64 titleCapacity
run titlePointerCall
bind value titlePointer OpaquePointer titlePointerCall
call copyTitleCall copyFixedTodoJsonTitleAtOffset
argument copyTitleCall sourceLine OpaquePointer lineBuffer
argument copyTitleCall titleBuffer OpaquePointer titlePointer
argument copyTitleCall valueOffset Int64 titleValueOffset
argument copyTitleCall titleBufferCapacity Int64 titleCapacity
run copyTitleCall
ignore value source copyTitleCall type Int64
call incrementLoadedCall math.addInt64
argument incrementLoadedCall left Int64 loadedCount
argument incrementLoadedCall right Int64 oneValue
run incrementLoadedCall
bind value nextLoadedCount Int64 incrementLoadedCall
set memory loadedCount nextLoadedCount
jump target loadLoop
label finishLoad
call closeCall c.fclose
argument closeCall stream FileHandle fileHandle
run closeCall
ignore value source closeCall type Int32
return value loadedCount
label loadSkipped
return value zeroValue

