# Heap-array terminal todo app for the current SemanticScript compiler.
# build.sem owns project identity, runtime target, executable metadata, and
# the module registry. This file owns the app module contract, imports,
# exports, and executable source. Run from apps/taskforge-tui/build so todos.json lives
# beside taskforge_tui.exe.
module app.taskforge_tui
purpose module app.taskforge_tui "Keyboard-driven console todo app with heap-backed todo storage and JSON persistence."
moduleOwns app.taskforge_tui "Terminal TUI lifecycle, keyboard handling, in-memory todo arrays, todos.json load/save, and process-local app state."
moduleDoesNotOwn app.taskforge_tui "Reusable standard library abstractions, native console primitive implementation, or cross-project package management."
moduleWarning app.taskforge_tui "This module is intentionally monolithic while the project-layout model is being prototyped; future refactors can split TUI, persistence, and domain operations into folder modules."
invariant module app.taskforge_tui "main.sem is the default executable entry selected by build.sem, and taskforge_tui.exe must be run from apps/taskforge-tui/build so todos.json resolves beside the executable."

# Explicit public surface carried from the module contract. Exports are not
# inferred; every symbol below is declared in this module source.
exportType app.taskforge_tui CAllocationError
exportType app.taskforge_tui TuiKeyCode
exportType app.taskforge_tui SaveTodosStatus
exportType app.taskforge_tui ScreenMode
exportError app.taskforge_tui MainError

exportOperation app.taskforge_tui main
exportOperation app.taskforge_tui readTuiKey
exportOperation app.taskforge_tui renderScreen
exportOperation app.taskforge_tui loadTodosFromJson
exportOperation app.taskforge_tui saveTodosToJson

exportConstant app.taskforge_tui tuiKeyArrowUp
exportConstant app.taskforge_tui tuiKeyArrowDown
exportConstant app.taskforge_tui tuiKeyArrowLeft
exportConstant app.taskforge_tui tuiKeyArrowRight

type CAllocationError CSignedInt32
type TuiKeyCode CSignedInt32
typeInvariant TuiKeyCode "Raw console bytes returned by c.consoleGetch occupy values 0..255; readTuiKey-normalized SemanticScript TUI keys (arrow keys, future special keys) occupy values strictly greater than 255 so the two domains never collide. See tuiKeyArrow{Up,Down,Left,Right} for the current normalized assignments."

enum SaveTodosStatus repr CSignedInt32
enumCase SaveTodosStatus SaveSucceeded 0
enumCase SaveTodosStatus SaveOpenFailed 1
enumCase SaveTodosStatus SaveWriteFailed 2
enumCase SaveTodosStatus SaveCloseFailed 3

enum ScreenMode repr CSignedInt64
enumCase ScreenMode ListMode 0
enumCase ScreenMode EditMode 1

# rationale: Operation bodies compare these enum values via the compiler's
# built-in `EnumName.equal` domain method (e.g. `SaveTodosStatus.equal`,
# `ScreenMode.equal`). The compiler resolves each call to the matching
# math.equal* primitive based on the enum's declared `repr`, so the source
# expresses the enum identity, not the underlying integer width. Changing
# an enum's `repr` only requires re-running the compiler — no call site
# rewrite needed.

error MainError
errorCase MainError StartupAllocationFailed CAllocationError

# rationale: TUI key codes live above 0xFF (256) so a normalized key never
# collides with a raw byte returned by c.consoleGetch. readTuiKey produces
# these codes; main consumes them. Declaring them once here removes the
# producer/consumer drift hazard that two parallel local declarations carry.
storage module immutable tuiKeyArrowUp TuiKeyCode 1001
storage module immutable tuiKeyArrowDown TuiKeyCode 1002
storage module immutable tuiKeyArrowLeft TuiKeyCode 1003
storage module immutable tuiKeyArrowRight TuiKeyCode 1004

# rationale: ASCII byte sentinels used by the bounded JSON tokenizer
# (copyFixedTodoJsonTitleAtOffset, parseJsonFlagAtOffset, writeJsonEscapedStringBuffer)
# and by the C-string buffer helpers. Codepoints map to characters as:
#   0  = NUL (C-string terminator)
#   27 = ESC (ANSI control sequence introducer used by clearScreen/hideCursor/showCursor)
#   34 = double-quote (JSON string delimiter)
#   49 = digit '1' (parseJsonFlagAtOffset uses this as the truthy flag)
#   92 = backslash (JSON escape lead)
#   93 = `]` (closing bracket of the JSON array, end-of-data sentinel)
#   10 = LF (newline; line-terminator in todos.json and reader stop byte)
#   13 = CR (carriage return; reader stop byte on CRLF line endings)
storage module immutable nulByte CSignedInt32 0
storage module immutable escapeByte CSignedInt32 27
storage module immutable quoteByte CSignedInt32 34
storage module immutable oneAsciiByte CSignedInt32 49
storage module immutable backslashByte CSignedInt32 92
storage module immutable closeBracketByte CSignedInt32 93
storage module immutable newlineByte CSignedInt32 10
storage module immutable carriageReturnByte CSignedInt32 13

# rationale: Console-op scalar conventions shared by clearScreen, hideCursor,
# showCursor, renderTodoRow, and renderScreen. successCode 0 is the
# documented "handler returned cleanly" status (see optimization-guide
# Return Contracts). flushAllStreams 0 is the libc `c.fflush(NULL)` sentinel
# that flushes every open stream; passed as CSignedInt64 because c.fflush's
# stream argument lowers as a pointer-width integer.
storage module immutable successCode CSignedInt32 0
storage module immutable flushAllStreams CSignedInt64 0

operation readTuiKey
output operation readTuiKey TuiKeyCode
effect readTuiKey read console.stdin
authority readTuiKey read console.stdin
memory readTuiKey heap no
async readTuiKey no
purpose operation readTuiKey "Read one no-echo console key through the shared terminal adapter and normalize arrow keys to this app's local key codes."
invariant operation readTuiKey "Arrow keys return stable app-local key codes; ordinary keys return their raw byte. Unhandled terminal soft keys return zero so the caller treats them as ignored input."
label startReadTuiKey
# rationale: c.terminalReadKey wraps the old Windows _getch path and also
# honors SEM_TERMINAL_TEST_KEYS, which lets app smoke tests drive the TUI
# without a visible interactive console. The adapter has its own soft-key
# codes, so this operation maps only the arrows this app understands.
storage local immutable terminalKeyLeft CSignedInt32 1000
storage local immutable terminalKeyRight CSignedInt32 1001
storage local immutable terminalKeyUp CSignedInt32 1002
storage local immutable terminalKeyDown CSignedInt32 1003
storage local immutable terminalKeyDelete CSignedInt32 1004
storage local immutable ignoredSoftKey TuiKeyCode 0
call keyCall c.terminalReadKey
run keyCall
bind value keyCode CSignedInt32 keyCall
call upArrowCheckCall math.equalCSignedInt32
argument upArrowCheckCall left CSignedInt32 keyCode
argument upArrowCheckCall right CSignedInt32 terminalKeyUp
run upArrowCheckCall
bind value isUpArrow Bool upArrowCheckCall
branch if condition isUpArrow target returnArrowUpKey
call downArrowCheckCall math.equalCSignedInt32
argument downArrowCheckCall left CSignedInt32 keyCode
argument downArrowCheckCall right CSignedInt32 terminalKeyDown
run downArrowCheckCall
bind value isDownArrow Bool downArrowCheckCall
branch if condition isDownArrow target returnArrowDownKey
call leftArrowCheckCall math.equalCSignedInt32
argument leftArrowCheckCall left CSignedInt32 keyCode
argument leftArrowCheckCall right CSignedInt32 terminalKeyLeft
run leftArrowCheckCall
bind value isLeftArrow Bool leftArrowCheckCall
branch if condition isLeftArrow target returnArrowLeftKey
call rightArrowCheckCall math.equalCSignedInt32
argument rightArrowCheckCall left CSignedInt32 keyCode
argument rightArrowCheckCall right CSignedInt32 terminalKeyRight
run rightArrowCheckCall
bind value isRightArrow Bool rightArrowCheckCall
branch if condition isRightArrow target returnArrowRightKey
call deleteSoftKeyCheckCall math.equalCSignedInt32
argument deleteSoftKeyCheckCall left CSignedInt32 keyCode
argument deleteSoftKeyCheckCall right CSignedInt32 terminalKeyDelete
run deleteSoftKeyCheckCall
bind value isDeleteSoftKey Bool deleteSoftKeyCheckCall
branch if condition isDeleteSoftKey target returnIgnoredSoftKey
return value keyCode
label returnArrowUpKey
return value tuiKeyArrowUp
label returnArrowDownKey
return value tuiKeyArrowDown
label returnArrowLeftKey
return value tuiKeyArrowLeft
label returnArrowRightKey
return value tuiKeyArrowRight
label returnIgnoredSoftKey
return value ignoredSoftKey

