authority saveTodosToJson close file
memory saveTodosToJson heap no
async saveTodosToJson no
purpose operation saveTodosToJson "Persist the active todo array as a JSON array."
invariant operation saveTodosToJson "The save loop writes each active todo index once from zero up to todoCount, title bytes pass through JSON escaping, and write failure takes precedence if close also fails."
label startSaveTodosToJson
storage local immutable zeroValue CSignedInt64 0
storage local immutable oneValue CSignedInt64 1
storage local immutable dataFilePath CNullTerminatedByteString "todos.json"
storage local immutable writeMode CNullTerminatedByteString "w"
storage local immutable openArrayText CNullTerminatedByteString "[\n"
storage local immutable closeArrayText CNullTerminatedByteString "]\n"
storage local immutable itemPrefixFormatText CNullTerminatedByteString "{\"active\":1,\"done\":%d,\"title\":\""
storage local immutable itemSuffixText CNullTerminatedByteString "\"}\n"
storage local immutable itemCommaSuffixText CNullTerminatedByteString "\"},\n"
storage local mutable saveIndex CSignedInt64 zeroValue
call openCall c.fopen
argument openCall filename CNullTerminatedByteString dataFilePath
argument openCall mode CNullTerminatedByteString writeMode
run openCall
bind value fileHandle CFileHandle openCall
call fileNullCheckCall pointer.isNull
argument fileNullCheckCall pointer COpaqueMemoryAddress fileHandle
run fileNullCheckCall
bind value fileIsNull Bool fileNullCheckCall
branch if condition fileIsNull target saveSkipped
call openArrayCall c.fprintf
argument openArrayCall stream CFileHandle fileHandle
argument openArrayCall format CNullTerminatedByteString openArrayText
run openArrayCall
bind value openArrayResult CSignedInt32 openArrayCall
call openArrayFailedCall isNegativeStatus
argument openArrayFailedCall statusCode CSignedInt32 openArrayResult
run openArrayFailedCall
bind value openArrayFailed Bool openArrayFailedCall
branch if condition openArrayFailed target closeAfterWriteFailed
label saveLoop
call saveDoneCheckCall math.greaterThanOrEqualI64
argument saveDoneCheckCall left I64 saveIndex
argument saveDoneCheckCall right I64 todoCount
run saveDoneCheckCall
bind value saveDone Bool saveDoneCheckCall
branch if condition saveDone target finishSave
call doneLoadCall pointer.loadByte
argument doneLoadCall buffer COpaqueMemoryAddress doneArray
argument doneLoadCall offset CByteCount saveIndex
run doneLoadCall
bind value doneValue CSignedInt32 doneLoadCall
call titlePointerCall getTitlePointerAt
argument titlePointerCall titlesBuffer COpaqueMemoryAddress titlesBuffer
argument titlePointerCall todoIndex CSignedInt64 saveIndex
argument titlePointerCall titleCapacity CSignedInt64 titleCapacity
run titlePointerCall
bind value titlePointer COpaqueMemoryAddress titlePointerCall
call nextIndexCall math.addI64
argument nextIndexCall left I64 saveIndex
argument nextIndexCall right I64 oneValue
run nextIndexCall
bind value nextSaveIndex CSignedInt64 nextIndexCall
call lastItemCheckCall math.equalI64
argument lastItemCheckCall left I64 nextSaveIndex
argument lastItemCheckCall right I64 todoCount
run lastItemCheckCall
bind value isLastItem Bool lastItemCheckCall
call writeItemPrefixCall c.fprintf
argument writeItemPrefixCall stream CFileHandle fileHandle
argument writeItemPrefixCall format CNullTerminatedByteString itemPrefixFormatText
argument writeItemPrefixCall done CSignedInt32 doneValue
run writeItemPrefixCall
bind value itemPrefixWriteResult CSignedInt32 writeItemPrefixCall
call itemPrefixWriteFailedCall isNegativeStatus
argument itemPrefixWriteFailedCall statusCode CSignedInt32 itemPrefixWriteResult
run itemPrefixWriteFailedCall
bind value itemPrefixWriteFailed Bool itemPrefixWriteFailedCall
branch if condition itemPrefixWriteFailed target closeAfterWriteFailed
call writeTitleCall writeJsonEscapedStringBuffer
argument writeTitleCall fileHandle CFileHandle fileHandle
argument writeTitleCall titleBuffer COpaqueMemoryAddress titlePointer
run writeTitleCall
bind value titleWriteStatus SaveTodosStatus writeTitleCall
call titleWriteSuccessCall SaveTodosStatus.equal
argument titleWriteSuccessCall left SaveTodosStatus titleWriteStatus
argument titleWriteSuccessCall right SaveTodosStatus SaveSucceeded
run titleWriteSuccessCall
bind value titleWriteSucceeded Bool titleWriteSuccessCall
branch if condition titleWriteSucceeded target continueAfterTitleWrite
branch else target closeAfterWriteFailed
label continueAfterTitleWrite
branch if condition isLastItem target writeLastItemSuffix
call writeItemCommaSuffixCall c.fprintf
argument writeItemCommaSuffixCall stream CFileHandle fileHandle
argument writeItemCommaSuffixCall format CNullTerminatedByteString itemCommaSuffixText
run writeItemCommaSuffixCall
bind value commaSuffixWriteResult CSignedInt32 writeItemCommaSuffixCall
call commaSuffixWriteFailedCall isNegativeStatus
argument commaSuffixWriteFailedCall statusCode CSignedInt32 commaSuffixWriteResult
run commaSuffixWriteFailedCall
bind value commaSuffixWriteFailed Bool commaSuffixWriteFailedCall
branch if condition commaSuffixWriteFailed target closeAfterWriteFailed
set memory saveIndex nextSaveIndex
jump target saveLoop
label writeLastItemSuffix
call writeItemSuffixCall c.fprintf
argument writeItemSuffixCall stream CFileHandle fileHandle
argument writeItemSuffixCall format CNullTerminatedByteString itemSuffixText
run writeItemSuffixCall
bind value itemSuffixWriteResult CSignedInt32 writeItemSuffixCall
call itemSuffixWriteFailedCall isNegativeStatus
argument itemSuffixWriteFailedCall statusCode CSignedInt32 itemSuffixWriteResult
run itemSuffixWriteFailedCall
bind value itemSuffixWriteFailed Bool itemSuffixWriteFailedCall
branch if condition itemSuffixWriteFailed target closeAfterWriteFailed
set memory saveIndex nextSaveIndex
jump target saveLoop
label finishSave
call closeArrayCall c.fprintf
argument closeArrayCall stream CFileHandle fileHandle
argument closeArrayCall format CNullTerminatedByteString closeArrayText
run closeArrayCall
bind value closeArrayWriteResult CSignedInt32 closeArrayCall
call closeArrayWriteFailedCall isNegativeStatus
argument closeArrayWriteFailedCall statusCode CSignedInt32 closeArrayWriteResult
run closeArrayWriteFailedCall
bind value closeArrayWriteFailed Bool closeArrayWriteFailedCall
branch if condition closeArrayWriteFailed target closeAfterWriteFailed
call closeCall c.fclose
argument closeCall stream CFileHandle fileHandle
run closeCall
bind value closeResult CSignedInt32 closeCall
call closeFailedCall isNegativeStatus
argument closeFailedCall statusCode CSignedInt32 closeResult
run closeFailedCall
bind value closeFailed Bool closeFailedCall
branch if condition closeFailed target returnSaveCloseFailed
