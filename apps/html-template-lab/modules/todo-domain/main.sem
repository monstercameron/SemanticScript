module app.html_template_lab.todo_domain
purpose module app.html_template_lab.todo_domain "Demo todo domain copy shaped after app.todo's active todo concepts."
moduleOwns app.html_template_lab.todo_domain "Static todo titles, status labels, and row classes used by page assembly as component inputs."
moduleDoesNotOwn app.html_template_lab.todo_domain "HTML tag structure, page layout, console output, or persistence."
invariant module app.html_template_lab.todo_domain "Todo rows preserve the app.todo idea of title plus done/open state, but stay immutable for deterministic demo output."

import shared app.html_template_lab.shared

exportConstant app.html_template_lab.todo_domain firstTodoTitleText
exportConstant app.html_template_lab.todo_domain firstTodoStatusText
exportConstant app.html_template_lab.todo_domain firstTodoClassName
exportConstant app.html_template_lab.todo_domain secondTodoTitleText
exportConstant app.html_template_lab.todo_domain secondTodoStatusText
exportConstant app.html_template_lab.todo_domain secondTodoClassName
exportConstant app.html_template_lab.todo_domain thirdTodoTitleText
exportConstant app.html_template_lab.todo_domain thirdTodoStatusText
exportConstant app.html_template_lab.todo_domain thirdTodoClassName

storage module immutable firstTodoTitleText String "Wire native webserver"
storage module immutable firstTodoStatusText String "done"
storage module immutable firstTodoClassName String doneTodoClassName

storage module immutable secondTodoTitleText String "Split HTML rendering into modules"
storage module immutable secondTodoStatusText String "open"
storage module immutable secondTodoClassName String openTodoClassName

storage module immutable thirdTodoTitleText String "Keep template inputs explicit"
storage module immutable thirdTodoStatusText String "open"
storage module immutable thirdTodoClassName String openTodoClassName
