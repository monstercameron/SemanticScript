module app.desktop_window_smoke
purpose module app.desktop_window_smoke "Minimal Windows GUI app built with standard SemanticScript function calls."
moduleOwns app.desktop_window_smoke "The app-level constants and main operation that compose one GUI window through standard.gui functions."
moduleDoesNotOwn app.desktop_window_smoke "The native Win32 message loop, handle lifetime, layout engine, or standard.gui runtime implementation."
invariant module app.desktop_window_smoke "GUI construction uses operation/call/arg/run syntax; app code does not declare GUI-specific top-level keywords."

import gui standard.gui

entry console main
exportOperation app.desktop_window_smoke main

storage module immutable helloGuiTitle GuiText "Hello GUI"
storage module immutable headingText GuiText "Hello from SemanticScript"
storage module immutable greetingPlaceholder GuiText "Type a greeting"
storage module immutable sayHelloText GuiText "Say hello"
storage module immutable inspectSelectedText GuiText "Inspect selected"
storage module immutable clearGreetingsText GuiText "Clear greetings"
storage module immutable statusReadyText GuiText "Ready"
storage module immutable emptyGuiText GuiText ""
storage module immutable greetingAddedStatusText GuiText "Greeting added"
storage module immutable selectedGreetingStatusText GuiText "Selected greeting inspected"
storage module immutable greetingsClearedStatusText GuiText "Greeting list cleared"
storage module immutable windowWidth GuiPixels 640
storage module immutable windowHeight GuiPixels 400
storage module immutable maxGreetingLength Int32 200
storage module immutable yesGuiFlag Int32 1
storage module immutable noGuiFlag Int32 0
storage module mutable greetingInputHandle GuiTextBox 0
storage module mutable greetingListHandle GuiListBox 0
storage module mutable statusLabelHandle GuiTextLabel 0

operation main
output operation main ExitCode
effect main allocate gui.application
effect main allocate gui.window
effect main allocate gui.control
effect main write gui.window
effect main write gui.control.event
authority main allocate gui.application
authority main allocate gui.window
authority main allocate gui.control
authority main write gui.window
authority main write gui.control.event
memory main heap yes
memoryAllocationSource main createApplicationCall
async main no
purpose operation main "Compose one native GUI window using standard.gui functions and return the GUI runtime exit status."
invariant operation main "GUI handles are created through standard.gui calls, attached to one main window, and event handlers are registered before applicationRun."

call createApplicationCall gui.applicationCreate
argument createApplicationCall title GuiText helloGuiTitle
run createApplicationCall
bind value application GuiApplication createApplicationCall

call createWindowCall gui.windowCreate
argument createWindowCall title GuiText helloGuiTitle
argument createWindowCall width GuiPixels windowWidth
argument createWindowCall height GuiPixels windowHeight
argument createWindowCall layout GuiWindowLayout verticalStackGuiWindowLayout
argument createWindowCall resizable Int32 yesGuiFlag
run createWindowCall
bind value mainWindow GuiWindow createWindowCall

call createTitleLabelCall gui.textLabelCreate
argument createTitleLabelCall text GuiText headingText
run createTitleLabelCall
bind value titleLabel GuiTextLabel createTitleLabelCall

call addTitleLabelCall gui.windowAddControl
argument addTitleLabelCall window GuiWindow mainWindow
argument addTitleLabelCall control GuiControl titleLabel
run addTitleLabelCall
ignore value source addTitleLabelCall type Int32

call createTaskInputCall gui.textBoxCreate
argument createTaskInputCall placeholder GuiText greetingPlaceholder
argument createTaskInputCall maxLength Int32 maxGreetingLength
run createTaskInputCall
bind value taskInput GuiTextBox createTaskInputCall

call addTaskInputCall gui.windowAddControl
argument addTaskInputCall window GuiWindow mainWindow
argument addTaskInputCall control GuiControl taskInput
run addTaskInputCall
ignore value source addTaskInputCall type Int32
set storage greetingInputHandle taskInput

call createAddButtonCall gui.buttonCreate
argument createAddButtonCall text GuiText sayHelloText
argument createAddButtonCall isDefault Int32 yesGuiFlag
run createAddButtonCall
bind value addButton GuiButton createAddButtonCall

call addAddButtonCall gui.windowAddControl
argument addAddButtonCall window GuiWindow mainWindow
argument addAddButtonCall control GuiControl addButton
run addAddButtonCall
ignore value source addAddButtonCall type Int32

call createTaskListCall gui.listBoxCreate
argument createTaskListCall selectionMode GuiListBoxSelectionMode singleGuiListBoxSelectionMode
run createTaskListCall
bind value taskList GuiListBox createTaskListCall

call addTaskListCall gui.windowAddControl
argument addTaskListCall window GuiWindow mainWindow
argument addTaskListCall control GuiControl taskList
run addTaskListCall
ignore value source addTaskListCall type Int32
set storage greetingListHandle taskList

call createCompleteButtonCall gui.buttonCreate
argument createCompleteButtonCall text GuiText inspectSelectedText
argument createCompleteButtonCall isDefault Int32 noGuiFlag
run createCompleteButtonCall
bind value completeButton GuiButton createCompleteButtonCall

call addCompleteButtonCall gui.windowAddControl
argument addCompleteButtonCall window GuiWindow mainWindow
argument addCompleteButtonCall control GuiControl completeButton
run addCompleteButtonCall
ignore value source addCompleteButtonCall type Int32

call createClearButtonCall gui.buttonCreate
argument createClearButtonCall text GuiText clearGreetingsText
argument createClearButtonCall isDefault Int32 noGuiFlag
run createClearButtonCall
bind value clearButton GuiButton createClearButtonCall

call addClearButtonCall gui.windowAddControl
argument addClearButtonCall window GuiWindow mainWindow
argument addClearButtonCall control GuiControl clearButton
run addClearButtonCall
ignore value source addClearButtonCall type Int32

call createStatusLabelCall gui.textLabelCreate
argument createStatusLabelCall text GuiText statusReadyText
run createStatusLabelCall
bind value statusLabel GuiTextLabel createStatusLabelCall

call addStatusLabelCall gui.windowAddControl
argument addStatusLabelCall window GuiWindow mainWindow
argument addStatusLabelCall control GuiControl statusLabel
run addStatusLabelCall
ignore value source addStatusLabelCall type Int32
set storage statusLabelHandle statusLabel

call registerAddButtonClickCall gui.controlOnEvent
argument registerAddButtonClickCall control GuiControl addButton
argument registerAddButtonClickCall eventKind GuiEventKind clickGuiEventKind
argument registerAddButtonClickCall handler GuiEventHandler appendGreetingFromInput
run registerAddButtonClickCall
ignore value source registerAddButtonClickCall type Int32

call registerTaskInputEnterCall gui.controlOnEvent
argument registerTaskInputEnterCall control GuiControl taskInput
argument registerTaskInputEnterCall eventKind GuiEventKind enterPressedGuiEventKind
argument registerTaskInputEnterCall handler GuiEventHandler appendGreetingFromInput
run registerTaskInputEnterCall
ignore value source registerTaskInputEnterCall type Int32

call registerCompleteButtonClickCall gui.controlOnEvent
argument registerCompleteButtonClickCall control GuiControl completeButton
argument registerCompleteButtonClickCall eventKind GuiEventKind clickGuiEventKind
argument registerCompleteButtonClickCall handler GuiEventHandler inspectSelectedGreeting
run registerCompleteButtonClickCall
ignore value source registerCompleteButtonClickCall type Int32

call registerClearButtonClickCall gui.controlOnEvent
argument registerClearButtonClickCall control GuiControl clearButton
argument registerClearButtonClickCall eventKind GuiEventKind clickGuiEventKind
argument registerClearButtonClickCall handler GuiEventHandler clearGreetings
run registerClearButtonClickCall
ignore value source registerClearButtonClickCall type Int32

call setMainWindowCall gui.applicationSetMainWindow
argument setMainWindowCall application GuiApplication application
argument setMainWindowCall window GuiWindow mainWindow
run setMainWindowCall
ignore value source setMainWindowCall type Int32

call runApplicationCall gui.applicationRun
argument runApplicationCall application GuiApplication application
run runApplicationCall
bind value guiExitCode ExitCode runApplicationCall
return value guiExitCode

operation appendGreetingFromInput
input operation appendGreetingFromInput session GuiSession
input operation appendGreetingFromInput event GuiEvent
output operation appendGreetingFromInput Int32
effect appendGreetingFromInput read gui.control.textBox.text
effect appendGreetingFromInput write gui.control.textBox.text
effect appendGreetingFromInput write gui.control.listBox.items
effect appendGreetingFromInput write gui.control.textLabel.text
authority appendGreetingFromInput read gui.control.textBox.text
authority appendGreetingFromInput write gui.control.textBox.text
authority appendGreetingFromInput write gui.control.listBox.items
authority appendGreetingFromInput write gui.control.textLabel.text
memory appendGreetingFromInput heap no
async appendGreetingFromInput no
purpose operation appendGreetingFromInput "Append the current greeting text to the visible greeting list and clear the input."
invariant operation appendGreetingFromInput "The handler reads the current input once, appends one list item, clears the input box, and reports the append status as the event result."

call readTitleCall gui.textBoxText
argument readTitleCall session GuiSession session
argument readTitleCall textBox GuiTextBox greetingInputHandle
run readTitleCall
bind value greetingText GuiText readTitleCall

call appendTaskCall gui.listBoxAppendItem
argument appendTaskCall session GuiSession session
argument appendTaskCall listBox GuiListBox greetingListHandle
argument appendTaskCall text String greetingText
run appendTaskCall
bind value appendTaskStatus Int32 appendTaskCall

call clearTaskInputCall gui.textBoxSetText
argument clearTaskInputCall session GuiSession session
argument clearTaskInputCall textBox GuiTextBox greetingInputHandle
argument clearTaskInputCall text String emptyGuiText
run clearTaskInputCall
ignore value source clearTaskInputCall type Int32

call setAddedStatusCall gui.textLabelSetText
argument setAddedStatusCall session GuiSession session
argument setAddedStatusCall textLabel GuiTextLabel statusLabelHandle
argument setAddedStatusCall text GuiText greetingAddedStatusText
run setAddedStatusCall
ignore value source setAddedStatusCall type Int32

return value appendTaskStatus

operation inspectSelectedGreeting
input operation inspectSelectedGreeting session GuiSession
input operation inspectSelectedGreeting event GuiEvent
output operation inspectSelectedGreeting Int32
effect inspectSelectedGreeting read gui.control.listBox.selection
effect inspectSelectedGreeting write gui.control.textLabel.text
authority inspectSelectedGreeting read gui.control.listBox.selection
authority inspectSelectedGreeting write gui.control.textLabel.text
memory inspectSelectedGreeting heap no
async inspectSelectedGreeting no
purpose operation inspectSelectedGreeting "Confirm that the inspect button click reached the GUI event handler without appending another list item."
invariant operation inspectSelectedGreeting "The handler observes the selected row and updates only the status label; it never mutates the list item collection."

call selectedIndexCall gui.listBoxSelectedIndex
argument selectedIndexCall session GuiSession session
argument selectedIndexCall listBox GuiListBox greetingListHandle
run selectedIndexCall
bind value selectedTaskIndex Int32 selectedIndexCall

call observeSelectedTaskIndexCall math.greaterThanOrEqualInt32
argument observeSelectedTaskIndexCall left Int32 selectedTaskIndex
argument observeSelectedTaskIndexCall right Int32 noGuiFlag
run observeSelectedTaskIndexCall
ignore value source observeSelectedTaskIndexCall type Bool

call setCompletedStatusCall gui.textLabelSetText
argument setCompletedStatusCall session GuiSession session
argument setCompletedStatusCall textLabel GuiTextLabel statusLabelHandle
argument setCompletedStatusCall text GuiText selectedGreetingStatusText
run setCompletedStatusCall
bind value completeStatusUpdate Int32 setCompletedStatusCall

return value completeStatusUpdate

operation clearGreetings
input operation clearGreetings session GuiSession
input operation clearGreetings event GuiEvent
output operation clearGreetings Int32
effect clearGreetings write gui.control.listBox.items
effect clearGreetings write gui.control.textLabel.text
authority clearGreetings write gui.control.listBox.items
authority clearGreetings write gui.control.textLabel.text
memory clearGreetings heap no
async clearGreetings no
purpose operation clearGreetings "Clear visible greetings and update the status label."
invariant operation clearGreetings "The handler clears the list once, updates the status label, and reports the list clear status as the event result."

call clearTaskListCall gui.listBoxClear
argument clearTaskListCall session GuiSession session
argument clearTaskListCall listBox GuiListBox greetingListHandle
run clearTaskListCall
bind value clearTaskListStatus Int32 clearTaskListCall

call setClearedStatusCall gui.textLabelSetText
argument setClearedStatusCall session GuiSession session
argument setClearedStatusCall textLabel GuiTextLabel statusLabelHandle
argument setClearedStatusCall text GuiText greetingsClearedStatusText
run setClearedStatusCall
ignore value source setClearedStatusCall type Int32

return value clearTaskListStatus
