# TaskForgeApiClient regular SemanticScript build plan.
# Build configuration is ordinary typed record data; semsc lowers BuildPlan internally.

module app.taskForgeApiClient.build
purpose module app.taskForgeApiClient.build "Describe the TaskForge API client build as ordinary typed SemanticScript data."
moduleOwns app.taskForgeApiClient.build "Build project metadata, module registration, target options, version metadata, and build constants."
moduleDoesNotOwn app.taskForgeApiClient.build "Runtime application behavior; main.sem owns the async outbound HTTP calls."
invariant module app.taskForgeApiClient.build "The app is a console client: it calls the separately running taskforge-web server to exercise outbound async fetch syntax."

record BuildProject
field BuildProject id String
field BuildProject name String
field BuildProject modulePath String
field BuildProject languageVersion String
field BuildProject projectVersion String
field BuildProject license String
field BuildProject sourceRoot String
field BuildProject testPattern String
field BuildProject testRoot String

record BuildModule
field BuildModule moduleName String
field BuildModule sourcePath String
field BuildModule mainFile String

record BuildModules
field BuildModules main BuildModule

record BuildTarget
field BuildTarget runtime String
field BuildTarget nativeRuntime String
field BuildTarget nativeRuntimeVersion Int64
field BuildTarget profile String
field BuildTarget optLevel Int64
field BuildTarget runtimeChecks String
field BuildTarget persistLlvmIr String
field BuildTarget emitLlvmIr String
field BuildTarget emitOptimizedLlvmIr Bool
field BuildTarget buildFolderName String
field BuildTarget cpuBaseline String
field BuildTarget cpuTune String
field BuildTarget cpuFeatureCheck String
field BuildTarget asyncRuntime String
field BuildTarget formatterLineWidth Int64
field BuildTarget linterMaxTier String
field BuildTarget docsOutput String
field BuildTarget nativeOutput String

record BuildMetadata
field BuildMetadata buildSource String
field BuildMetadata runtimeContract String
field BuildMetadata apiOrigin String
field BuildMetadata asyncSurface String

record BuildVersionInfo
field BuildVersionInfo version String
field BuildVersionInfo publisher String
field BuildVersionInfo description String
field BuildVersionInfo productName String
field BuildVersionInfo internalName String
field BuildVersionInfo originalFilename String
field BuildVersionInfo comments String
field BuildVersionInfo metadata BuildMetadata

record BuildConstant
field BuildConstant type String
field BuildConstant value String

record BuildConstants

record BuildPlan
field BuildPlan project BuildProject
field BuildPlan modules BuildModules
field BuildPlan mainModule String
field BuildPlan mainOperation String
field BuildPlan target BuildTarget
field BuildPlan versionInfo BuildVersionInfo
field BuildPlan constants BuildConstants

storage module immutable taskForgeApiClientBuildPlan BuildPlan
jsonBody taskForgeApiClientBuildPlan
  {
      "project": {
          "name": "TaskForgeApiClient",
          "id": "taskForgeApiClient",
          "modulePath": "github.com/monstercameron/SemanticScript/apps/taskforge-api-client",
          "languageVersion": "1.0",
          "projectVersion": "0.2.0",
          "license": "MIT",
          "sourceRoot": ".",
          "testPattern": "*.test.sem",
          "testRoot": "."
      },
      "modules": {
          "main": {
              "moduleName": "app.taskforge_api_client",
              "sourcePath": ".",
              "mainFile": "main.sem"
          }
      },
      "mainModule": "main",
      "target": {
          "runtime": "nativeExe",
          "nativeRuntime": "native",
          "nativeRuntimeVersion": 1,
          "profile": "dev",
          "optLevel": 2,
          "runtimeChecks": "panic",
          "persistLlvmIr": "yes",
          "emitLlvmIr": "auto",
          "emitOptimizedLlvmIr": false,
          "buildFolderName": "build",
          "cpuBaseline": "generic",
          "cpuTune": "generic",
          "cpuFeatureCheck": "auto",
          "asyncRuntime": "libuv",
          "formatterLineWidth": 100,
          "linterMaxTier": "T4",
          "docsOutput": "docs",
          "nativeOutput": "taskforge-api-client.exe"
      },
      "versionInfo": {
          "version": "0.2.0.0",
          "publisher": "Earl Cameron",
          "description": "SemanticScript async HTTP client demo that calls the TaskForge Web server.",
          "productName": "TaskForge API Client",
          "internalName": "taskforge-api-client",
          "originalFilename": "taskforge-api-client.exe",
          "comments": "Built from apps/taskforge-api-client/main.sem. Exercises standard.net start/await against apps/taskforge-web.",
          "metadata": {
              "buildSource": "apps/taskforge-api-client/build.sem",
              "runtimeContract": "native 1",
              "apiOrigin": "http://127.0.0.1:18090",
              "asyncSurface": "standard.net net.fetchText plus user-operation start/await/case/done"
          }
      },
      "constants": {},
      "mainOperation": "main"
  }

operation configureTaskForgeApiClientBuild
output operation configureTaskForgeApiClientBuild BuildPlan
memory configureTaskForgeApiClientBuild heap no
async configureTaskForgeApiClientBuild no
purpose operation configureTaskForgeApiClientBuild "Return the typed build plan for the TaskForge API client."
return value taskForgeApiClientBuildPlan
