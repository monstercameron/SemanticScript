      "mainModule": "main",
      "target": {
          "runtime": "nativeExe",
          "nativeRuntime": "native",
          "nativeRuntimeVersion": 1,
          "profile": "dev",
          "optLevel": 2,
          "runtimeChecks": "panic",
          "persistLlvmIr": "yes",
