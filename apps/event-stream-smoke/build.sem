          "modulePath": "github.com/monstercameron/SemanticScript/apps/event-stream-smoke",
          "languageVersion": "1.0",
          "projectVersion": "0.1.0",
          "license": "MIT",
          "sourceRoot": ".",
          "testPattern": "*.test.sem",
          "testRoot": "."
      },
      "modules": {
          "main": {
              "moduleName": "app.event_stream_smoke",
              "sourcePath": ".",
              "mainFile": "main.sem"
          }
