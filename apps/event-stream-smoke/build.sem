          "cpuBaseline": "generic",
          "cpuTune": "generic",
          "cpuFeatureCheck": "auto",
          "asyncRuntime": "libuv",
          "formatterLineWidth": 100,
          "linterMaxTier": "T4",
          "docsOutput": "docs",
          "nativeOutput": "event-stream-smoke.exe"
      },
      "versionInfo": {
          "version": "0.1.0.0",
          "publisher": "Earl Cameron",
          "description": "SemanticScript standard.event async fanout smoke app.",
          "productName": "Event Stream Smoke",
          "internalName": "event-stream-smoke",
          "originalFilename": "event-stream-smoke.exe",
