          "metadata": {
              "buildSource": "apps/event-stream-smoke/build.sem",
              "runtimeContract": "native 1",
              "asyncSurface": "standard.event event calls plus user-operation start/await"
          }
      },
      "constants": {},
      "mainOperation": "main"
