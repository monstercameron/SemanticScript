writeAssetFileCall invokes http.responseFile
writeAssetFileCall arg response HttpResponse response
writeAssetFileCall arg status HttpStatusCode httpStatusOk
writeAssetFileCall arg rootDirectory String assetsDirectoryPath
writeAssetFileCall arg requestedPath String assetFilename
writeAssetFileCall out writeAssetFileStatus Int32

assetWriteOkCheckCall is call
assetWriteOkCheckCall in staticAssetHandler
assetWriteOkCheckCall invokes math.equalInt32
assetWriteOkCheckCall arg left Int32 writeAssetFileStatus
assetWriteOkCheckCall arg right Int32 assetWriteOkSentinel
assetWriteOkCheckCall out assetWriteOk Bool

writeAssetMissingCall is call
writeAssetMissingCall in staticAssetHandler
writeAssetMissingCall invokes writeErrorJsonResponse
writeAssetMissingCall arg response HttpResponse response
writeAssetMissingCall arg status HttpStatusCode httpStatusNotFound
writeAssetMissingCall arg messageBody HttpTextBody staticAssetMissingBody
writeAssetMissingCall out writeAssetMissingStatus Int32

# ---- authority capabilities (synthesized from semsc `authority` rows) ----
# EAV has no `authority`; these name the op-local file/filesystem grants the
# database-open path needs so transitive effect coverage (README ss8) is clean.

fileCloseAuthority is capability
fileCloseAuthority grants close file
fileCloseAuthority purpose "Authorize `close file` on the SQLite database-open path"

fileOpenAuthority is capability
fileOpenAuthority grants open file
fileOpenAuthority purpose "Authorize `open file` on the SQLite database-open path"

filesystemCreateAuthority is capability
filesystemCreateAuthority grants create filesystem
filesystemCreateAuthority purpose "Authorize `create filesystem` on the SQLite database-open path"

filesystemOpenAuthority is capability
filesystemOpenAuthority grants open filesystem
filesystemOpenAuthority purpose "Authorize `open filesystem` on the SQLite database-open path"

filesystemReadAuthority is capability
filesystemReadAuthority grants read filesystem
filesystemReadAuthority purpose "Authorize `read filesystem` on the SQLite database-open path"

filesystemWriteAuthority is capability
filesystemWriteAuthority grants write filesystem
filesystemWriteAuthority purpose "Authorize `write filesystem` on the SQLite database-open path"

