staticAssetHandler is operation
staticAssetHandler in request HttpRequest
staticAssetHandler in response HttpResponse
staticAssetHandler out Int32
staticAssetHandler effect read http.request.header
staticAssetHandler effect read filesystem
staticAssetHandler effect write http.response
staticAssetHandler uses httpRequestReader
staticAssetHandler uses httpResponseWriter
staticAssetHandler uses filesystemReadCapability
staticAssetHandler memory arena request
staticAssetHandler async no
staticAssetHandler purpose "GET /assets/:filename - serve a single file from the assets/ directory beside the exe, with content-type sniffed by extension. Refuses path traversal at the runtime layer."
staticAssetHandler invariant "The runtime's path-traversal refusal + content-type sniffing are the load-bearing security checks. The :filename capture is a single segment (cannot contain `/`), so multi-component asset paths are not addressable - that's intentional v1 scope; nested asset dirs are a v1.1 follow-up."
staticAssetHandler let staticAssetMissingBody immutable HttpTextBody "{\"error\":{\"code\":\"assetNotFound\",\"message\":\"asset not found\"}}\n"
staticAssetHandler let assetWriteOkSentinel immutable Int32 0
staticAssetHandler do readAssetFilenameCall
staticAssetHandler do assetFilenameNullCheckCall
staticAssetHandler branch if assetFilenameMissing goto staticAssetMissingHandler
staticAssetHandler do writeAssetFileCall
staticAssetHandler do assetWriteOkCheckCall
staticAssetHandler branch if assetWriteOk goto staticAssetServed
staticAssetHandler goto staticAssetMissingHandler
staticAssetHandler at staticAssetServed return writeAssetFileStatus
staticAssetHandler at staticAssetMissingHandler do writeAssetMissingCall
staticAssetHandler return writeAssetMissingStatus

readAssetFilenameCall is call
readAssetFilenameCall in staticAssetHandler
readAssetFilenameCall invokes http.requestPathParam
readAssetFilenameCall arg request HttpRequest request
readAssetFilenameCall arg name String assetFilenameParam
readAssetFilenameCall out assetFilename String

