loginHandler let loginVerifyWipeByte immutable Int32 0
loginHandler let loginMatchSentinel immutable Int32 1
loginHandler let loginDbUnavailableBody immutable String "{\"error\":{\"code\":\"databaseUnavailable\",\"message\":\"database not available\"}}\n"
loginHandler let loginSelectFailedBody immutable String "{\"error\":{\"code\":\"databaseError\",\"message\":\"could not look up user\"}}\n"
loginHandler let loginInvalidCredentialsBody immutable String "{\"error\":{\"code\":\"invalidCredentials\",\"message\":\"invalid username or password\"}}\n"
loginHandler let loginInsertSessionFailedBody immutable String "{\"error\":{\"code\":\"sessionInsertFailed\",\"message\":\"could not establish session\"}}\n"
loginHandler let loginInternalFailureBody immutable String "{\"error\":{\"code\":\"internalError\",\"message\":\"could not complete login\"}}\n"
