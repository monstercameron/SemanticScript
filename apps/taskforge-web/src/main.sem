sqlInsertTodo is storage module immutable SqlText
sqlInsertTodo body sql
  INSERT INTO todos (user_id, title, body, done, priority, created_at_ms, updated_at_ms) VALUES (?, ?, ?, 0, ?, ?, ?) RETURNING id

sqlSelectTodosByUser is storage module immutable SqlText
sqlSelectTodosByUser body sql
  SELECT id, title, body, done, priority, created_at_ms, updated_at_ms, completed_at_ms FROM todos WHERE user_id = ? ORDER BY created_at_ms DESC LIMIT 100

