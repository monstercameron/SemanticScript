# TaskForge Web — pages module.
#
# Owns every HTML response page served by the app. The parent module's
# route table binds homePageHandler, dashboardPageHandler, and
# notFoundPageHandler (all exported here) to GET /, GET /dashboard, and
# the `*` wildcard respectively. Each page composes its body from the
# components module's render operations — page templates here are thin
# shells that wire together typed HtmlFragment slots.

module app.taskforge_web.pages
purpose module app.taskforge_web.pages "Server-rendered HTML pages for TaskForge Web: landing page, dashboard, and 404. Each page hydrates from a standard.html template and writes back via http.responseText with text/html content-type."
moduleOwns app.taskforge_web.pages "HomePageTemplate, DashboardPageTemplate, and NotFoundPageTemplate html templates plus the three page handlers (homePageHandler / dashboardPageHandler / notFoundPageHandler). Each page handler is responsible for picking the component props and stitching component fragments into the shell."
moduleDoesNotOwn app.taskforge_web.pages "API route declarations (parent module), session lookup, sqlite interaction, or any of the per-component markup — that lives in app.taskforge_web.components. Tailwind config + design tokens live in the shared PageShellHeadComponent."
invariant module app.taskforge_web.pages "Every dynamic hole in every page template is a bare HTML hole reference. Static body chrome (gradient backdrop, brand row) is composed from typed HtmlFragment slots so each page can shuffle components without re-writing the visual chrome."
moduleSecurity app.taskforge_web.pages "Tailwind + Inter font load from public CDNs (cdn.tailwindcss.com, rsms.me). A vNext refine vendors both under static/ so the app is fully self-contained and immune to CDN drift or supply-chain compromise."

import http standard.http
import html standard.html
import components app.taskforge_web.components

exportOperation app.taskforge_web.pages homePageHandler
exportOperation app.taskforge_web.pages dashboardPageHandler
exportOperation app.taskforge_web.pages notFoundPageHandler

storage module immutable httpStatusOkLocal Int32 200

# ===== HomePageTemplate + homePageHandler =====
# Landing page = split layout. Left column: marketing hero (headline +
# lead + feature pills). Right column: glassmorphic auth card with
# login + register tabs. Below the fold: feature grid + status card +
# footer. The whole page sits over a fixed mesh-gradient backdrop.

html template HomePageTemplate
html body template HomePageTemplate
  <!doctype html>
  <html lang="en" class="h-full antialiased">
  <head>
  {headFragment}
  </head>
  <body class="min-h-full text-ink-900">
  {heroBackgroundFragment}
  <main class="mx-auto max-w-7xl px-6 py-8 sm:py-10">
  {brandHeaderFragment}
  <section class="mt-6 grid items-start gap-10 lg:mt-10 lg:grid-cols-[1.1fr_minmax(0,420px)] lg:gap-16">
  {landingHeroFragment}
  {authCardFragment}
  </section>
  {featureGridFragment}
  <section class="mt-12 grid gap-5 lg:grid-cols-[1fr_360px]">
  <div class="glass rounded-2xl p-6 shadow-glow-soft">
  <h3 class="text-sm font-semibold uppercase tracking-wider text-ink-500">What you get</h3>
  <ol class="mt-4 space-y-3 text-sm text-ink-700">
  <li class="flex gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-100 text-xs font-bold text-brand-700">1</span><span><strong class="text-ink-900">Sign in</strong> with the seeded demo account or create your own — bcrypt cost-12 hashing, fresh session per login.</span></li>
  <li class="flex gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-100 text-xs font-bold text-brand-700">2</span><span><strong class="text-ink-900">Land on your dashboard</strong> — a server-rendered shell that the bundled JS hydrates with your todos from the JSON API.</span></li>
  <li class="flex gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-100 text-xs font-bold text-brand-700">3</span><span><strong class="text-ink-900">Add, complete, delete</strong> — every change persists to SQLite immediately, scoped to your <code class="font-mono text-xs">user_id</code> via foreign-key constraint.</span></li>
  </ol>
  </div>
  {statusCardFragment}
  </section>
  {appFooterFragment}
  </main>
  <script src="/assets/home.js" defer></script>
  </body>
  </html>

operation homePageHandler
input operation homePageHandler request HttpRequest
input operation homePageHandler response HttpResponse
output operation homePageHandler Int32
effect homePageHandler write http.response
useCapability homePageHandler httpResponseWriter
memory homePageHandler arena request
async homePageHandler no
purpose operation homePageHandler "GET / — hydrate HomePageTemplate into a full HTML document and write it back with text/html content type."
invariant operation homePageHandler "All dynamic holes flow through scoped bare HTML holes; static copy comes from operation-local storage. The handler is read-only — no SQL, no auth, no cookies — so it can be served before any user has registered."

label startHomePageHandler

storage local immutable homePageTitleText String "TaskForge Web — Modern multi-user todos"
storage local immutable homeProductNameText String "TaskForge Web"
storage local immutable homeTaglineText String "Multi-user todos, server-rendered, securely stored."
storage local immutable homeHeadlineText String "Production-grade todos, built end-to-end in SemanticScript."
storage local immutable homeLeadText String "A full-stack web app — bcrypt-hashed auth, SQLite-backed state, typed server-rendered HTML, vanilla-JS interactivity. No client framework, no ORM, no surprises."
storage local immutable homeVersionText String "1.1.0"
storage local immutable homeBcryptCostText String "12"
storage local immutable homeApiBaseUrlText String "http://127.0.0.1:18090"
storage local immutable homeDemoUsernameText String "demo"
storage local immutable homeDemoPasswordText String "demo1234"

call renderHomeHeadCall renderPageShellHead
argument renderHomeHeadCall pageTitleText String homePageTitleText
run renderHomeHeadCall
bind value homeHeadFragment HtmlFragment renderHomeHeadCall

call renderHomeBackgroundCall renderHeroBackground
run renderHomeBackgroundCall
bind value homeHeroBackgroundFragment HtmlFragment renderHomeBackgroundCall

call renderHomeBrandCall renderBrandHeader
argument renderHomeBrandCall productNameText String homeProductNameText
argument renderHomeBrandCall taglineText String homeTaglineText
run renderHomeBrandCall
bind value homeBrandHeaderFragment HtmlFragment renderHomeBrandCall

call renderHomeHeroCall renderLandingHero
argument renderHomeHeroCall productNameText String homeProductNameText
argument renderHomeHeroCall headlineText String homeHeadlineText
argument renderHomeHeroCall leadText String homeLeadText
run renderHomeHeroCall
bind value homeLandingHeroFragment HtmlFragment renderHomeHeroCall

call renderHomeLoginPanelCall renderLoginPanel
argument renderHomeLoginPanelCall demoUsernameText String homeDemoUsernameText
argument renderHomeLoginPanelCall demoPasswordText String homeDemoPasswordText
run renderHomeLoginPanelCall
bind value homeLoginPanelFragment HtmlFragment renderHomeLoginPanelCall

call renderHomeRegisterPanelCall renderRegisterPanel
run renderHomeRegisterPanelCall
bind value homeRegisterPanelFragment HtmlFragment renderHomeRegisterPanelCall

call renderHomeAuthCardCall renderAuthCard
argument renderHomeAuthCardCall loginPanelFragment HtmlFragment homeLoginPanelFragment
argument renderHomeAuthCardCall registerPanelFragment HtmlFragment homeRegisterPanelFragment
run renderHomeAuthCardCall
bind value homeAuthCardFragment HtmlFragment renderHomeAuthCardCall

call renderHomeFeatureGridCall renderFeatureGrid
run renderHomeFeatureGridCall
bind value homeFeatureGridFragment HtmlFragment renderHomeFeatureGridCall

call renderHomeStatusCardCall renderStatusCard
argument renderHomeStatusCardCall versionText String homeVersionText
argument renderHomeStatusCardCall bcryptCostText String homeBcryptCostText
argument renderHomeStatusCardCall apiBaseUrlText String homeApiBaseUrlText
run renderHomeStatusCardCall
bind value homeStatusCardFragment HtmlFragment renderHomeStatusCardCall

call renderHomeFooterCall renderAppFooter
run renderHomeFooterCall
bind value homeAppFooterFragment HtmlFragment renderHomeFooterCall

call hydrateHomePageCall html.hydrate.HomePageTemplate
argument hydrateHomePageCall headFragment HtmlFragment homeHeadFragment
argument hydrateHomePageCall heroBackgroundFragment HtmlFragment homeHeroBackgroundFragment
argument hydrateHomePageCall brandHeaderFragment HtmlFragment homeBrandHeaderFragment
argument hydrateHomePageCall landingHeroFragment HtmlFragment homeLandingHeroFragment
argument hydrateHomePageCall authCardFragment HtmlFragment homeAuthCardFragment
argument hydrateHomePageCall featureGridFragment HtmlFragment homeFeatureGridFragment
argument hydrateHomePageCall statusCardFragment HtmlFragment homeStatusCardFragment
argument hydrateHomePageCall appFooterFragment HtmlFragment homeAppFooterFragment
run hydrateHomePageCall
bind value homePageHtml HtmlDocument hydrateHomePageCall

call writeHomePageCall http.responseText
argument writeHomePageCall response HttpResponse response
argument writeHomePageCall status Int32 httpStatusOkLocal
argument writeHomePageCall body HtmlDocument homePageHtml
argument writeHomePageCall contentType HttpContentType htmlContentType
run writeHomePageCall
bind value writeHomePageStatus Int32 writeHomePageCall
return value writeHomePageStatus

# ===== DashboardPageTemplate + dashboardPageHandler =====
# Modern dashboard: top brand row, hero with progress stats, sticky
# new-todo composer, animated todo cards with priority chips + check
# circles, friendly empty state. /assets/dashboard.js hydrates the
# user-specific data from /api/auth/me + /api/todos.

html template DashboardPageTemplate
html body template DashboardPageTemplate
  <!doctype html>
  <html lang="en" class="h-full antialiased">
  <head>
  {headFragment}
  </head>
  <body class="min-h-full text-ink-900">
  {heroBackgroundFragment}
  <main class="mx-auto max-w-5xl px-6 py-8 sm:py-10">
  <header class="flex flex-wrap items-center justify-between gap-3">
  <a href="/" class="group flex items-center gap-3">
  <div class="flex h-11 w-11 items-center justify-center rounded-2xl grad-btn text-xl font-bold text-white shadow-glow-brand transition group-hover:scale-105">T</div>
  <div>
  <div class="text-base font-semibold tracking-tight text-ink-900">{productNameText}</div>
  <div class="text-xs text-ink-500">Your personal todo workspace</div>
  </div>
  </a>
  <div class="flex items-center gap-3">
  <div id="userPill" class="hidden items-center gap-2 rounded-full border border-ink-200 bg-white/80 px-3 py-1.5 text-xs font-medium text-ink-700 shadow-sm sm:flex">
  <div id="userAvatar" class="flex h-6 w-6 items-center justify-center rounded-full grad-btn text-[10px] font-bold text-white">?</div>
  <span id="userPillLabel">Loading...</span>
  </div>
  <button id="logoutButton" type="button" class="inline-flex items-center gap-1.5 rounded-xl border border-ink-200 bg-white px-3 py-1.5 text-xs font-semibold text-ink-700 shadow-sm transition hover:bg-ink-50 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-brand-200">
  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
  Sign out
  </button>
  </div>
  </header>

  <section class="fade-up mt-8 grid gap-5 sm:grid-cols-[1.4fr_1fr_1fr]">
  <div class="glass rounded-2xl p-6 shadow-glow-soft sm:col-span-3 sm:row-start-1 lg:col-span-1">
  <div class="text-xs font-semibold uppercase tracking-wider text-ink-500">Welcome back</div>
  <h1 id="welcomeLine" class="mt-2 text-2xl font-semibold tracking-tight text-ink-900">Loading...</h1>
  <p class="mt-2 text-sm text-ink-600">Your todos sync to SQLite on every change. Sessions cookie-backed, HttpOnly + SameSite=Strict.</p>
  </div>
  <div class="glass rounded-2xl p-6 shadow-glow-soft">
  <div class="flex items-center justify-between">
  <span class="text-xs font-semibold uppercase tracking-wider text-ink-500">Open</span>
  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-brand-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/></svg>
  </div>
  <div id="statOpen" class="mt-2 text-3xl font-semibold tracking-tight text-ink-900">—</div>
  <div class="mt-1 text-xs text-ink-500">awaiting your attention</div>
  </div>
  <div class="glass rounded-2xl p-6 shadow-glow-soft">
  <div class="flex items-center justify-between">
  <span class="text-xs font-semibold uppercase tracking-wider text-ink-500">Completed</span>
  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
  </div>
  <div id="statDone" class="mt-2 text-3xl font-semibold tracking-tight text-ink-900">—</div>
  <div class="mt-1 text-xs text-ink-500">already done</div>
  </div>
  </section>

  <section class="fade-up mt-6 glass rounded-3xl p-6 shadow-glow-soft sm:p-8">
  <div class="flex flex-wrap items-end justify-between gap-3">
  <div>
  <h2 class="text-lg font-semibold tracking-tight text-ink-900">Your todos</h2>
  <p id="todoCountLine" class="mt-0.5 text-sm text-ink-500">Loading...</p>
  </div>
  <button id="newTodoButton" type="button" class="grad-btn inline-flex items-center gap-1.5 rounded-xl px-4 py-2 text-sm font-semibold text-white shadow-glow-brand transition hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-brand-300">
  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
  New todo
  </button>
  </div>

  <form id="newTodoForm" class="mt-5 hidden space-y-3 rounded-2xl border border-brand-200/60 bg-gradient-to-br from-brand-50/70 to-fuchsia-50/40 p-5 shadow-sm">
  <div>
  <label class="text-xs font-semibold uppercase tracking-wide text-ink-500" for="newTodoTitle">Title</label>
  <input id="newTodoTitle" name="title" type="text" required maxlength="500" placeholder="What needs doing?" class="mt-1.5 block w-full rounded-xl border border-ink-200 bg-white px-3 py-2.5 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200" />
  </div>
  <div>
  <label class="text-xs font-semibold uppercase tracking-wide text-ink-500" for="newTodoBody">Notes <span class="font-normal normal-case text-ink-400">(optional)</span></label>
  <textarea id="newTodoBody" name="body" rows="2" maxlength="10000" placeholder="Extra context, links, sub-tasks..." class="mt-1.5 block w-full rounded-xl border border-ink-200 bg-white px-3 py-2.5 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200"></textarea>
  </div>
  <div class="flex flex-wrap items-center gap-3">
  <label class="text-xs font-semibold uppercase tracking-wide text-ink-500" for="newTodoPriority">Priority</label>
  <select id="newTodoPriority" name="priority" class="rounded-xl border border-ink-200 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200">
  <option value="1">High</option>
  <option value="2" selected>Medium</option>
  <option value="3">Low</option>
  </select>
  <button id="cancelNewTodoButton" type="button" class="ml-auto rounded-xl px-3 py-2 text-sm font-medium text-ink-500 transition hover:text-ink-700">Cancel</button>
  <button type="submit" class="grad-btn rounded-xl px-4 py-2 text-sm font-semibold text-white shadow-glow-brand transition hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-brand-300">Save todo</button>
  </div>
  <p id="newTodoResult" class="min-h-[1.25rem] text-sm"></p>
  </form>

  <ul id="todoList" class="mt-5 space-y-2.5 scroll-thin">
  <li class="rounded-2xl bg-ink-50/70 px-4 py-6 text-center text-sm text-ink-500">Loading your todos...</li>
  </ul>
  </section>

  {appFooterFragment}
  </main>
  <script src="/assets/dashboard.js" defer></script>
  </body>
  </html>

operation dashboardPageHandler
input operation dashboardPageHandler request HttpRequest
input operation dashboardPageHandler response HttpResponse
output operation dashboardPageHandler Int32
effect dashboardPageHandler write http.response
useCapability dashboardPageHandler httpResponseWriter
memory dashboardPageHandler arena request
async dashboardPageHandler no
purpose operation dashboardPageHandler "GET /dashboard — render the logged-in dashboard shell. /assets/dashboard.js fetches /api/auth/me + /api/todos and populates the user-specific content."
invariant operation dashboardPageHandler "Server-side auth check is intentionally deferred to the API calls the page makes; an unauthenticated visit returns the shell + a JS-driven redirect to / when /api/auth/me 401s."

label startDashboardPageHandler

storage local immutable dashboardTitleText String "TaskForge Web — Dashboard"
storage local immutable dashboardProductNameText String "TaskForge Web"

call renderDashHeadCall renderPageShellHead
argument renderDashHeadCall pageTitleText String dashboardTitleText
run renderDashHeadCall
bind value dashHeadFragment HtmlFragment renderDashHeadCall

call renderDashBackgroundCall renderHeroBackground
run renderDashBackgroundCall
bind value dashHeroBackgroundFragment HtmlFragment renderDashBackgroundCall

call renderDashFooterCall renderAppFooter
run renderDashFooterCall
bind value dashAppFooterFragment HtmlFragment renderDashFooterCall

call hydrateDashboardCall html.hydrate.DashboardPageTemplate
argument hydrateDashboardCall headFragment HtmlFragment dashHeadFragment
argument hydrateDashboardCall heroBackgroundFragment HtmlFragment dashHeroBackgroundFragment
argument hydrateDashboardCall productNameText String dashboardProductNameText
argument hydrateDashboardCall appFooterFragment HtmlFragment dashAppFooterFragment
run hydrateDashboardCall
bind value dashboardPageHtml HtmlDocument hydrateDashboardCall

call writeDashboardCall http.responseText
argument writeDashboardCall response HttpResponse response
argument writeDashboardCall status Int32 httpStatusOkLocal
argument writeDashboardCall body HtmlDocument dashboardPageHtml
argument writeDashboardCall contentType HttpContentType htmlContentType
run writeDashboardCall
bind value writeDashboardStatus Int32 writeDashboardCall
return value writeDashboardStatus

# ===== NotFoundPageTemplate + notFoundPageHandler =====
# Friendly 404: centered hero card with a 404 mark, headline, helper
# copy, and two CTAs back into the app.

html template NotFoundPageTemplate
html body template NotFoundPageTemplate
  <!doctype html>
  <html lang="en" class="h-full antialiased">
  <head>
  {headFragment}
  </head>
  <body class="min-h-full text-ink-900">
  {heroBackgroundFragment}
  <main class="mx-auto flex max-w-xl flex-col items-center px-6 py-24 text-center">
  <div class="fade-up glass rounded-3xl p-10 shadow-glow-soft">
  <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-3xl grad-btn text-2xl font-bold text-white shadow-glow-brand">404</div>
  <h1 class="mt-6 text-3xl font-semibold tracking-tight text-ink-900">Page not found</h1>
  <p class="mt-3 max-w-md text-sm leading-relaxed text-ink-600">The URL you requested isn't part of TaskForge Web's route table. Head back to the home page or jump into your dashboard.</p>
  <div class="mt-7 flex flex-wrap justify-center gap-3">
  <a href="/" class="grad-btn inline-flex items-center gap-1.5 rounded-xl px-5 py-2.5 text-sm font-semibold text-white shadow-glow-brand transition hover:shadow-lg">
  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
  Home
  </a>
  <a href="/dashboard" class="inline-flex items-center gap-1.5 rounded-xl border border-ink-200 bg-white px-5 py-2.5 text-sm font-semibold text-ink-700 shadow-sm transition hover:bg-ink-50 hover:shadow-md">
  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg>
  Dashboard
  </a>
  </div>
  </div>
  </main>
  </body>
  </html>

operation notFoundPageHandler
input operation notFoundPageHandler request HttpRequest
input operation notFoundPageHandler response HttpResponse
output operation notFoundPageHandler Int32
effect notFoundPageHandler write http.response
useCapability notFoundPageHandler httpResponseWriter
memory notFoundPageHandler arena request
async notFoundPageHandler no
purpose operation notFoundPageHandler "Dispatched by the HTTP runtime's not-found hook (route at path '*' in main.sem's route table)."
invariant operation notFoundPageHandler "Always returns 404 + an HTML body; the body links back to / and /dashboard so a typo in a URL is one click away from recovery."

label startNotFoundPageHandler

storage local immutable notFoundTitleText String "404 — TaskForge Web"
storage local immutable notFoundStatusCode Int32 404

call renderNotFoundHeadCall renderPageShellHead
argument renderNotFoundHeadCall pageTitleText String notFoundTitleText
run renderNotFoundHeadCall
bind value notFoundHeadFragment HtmlFragment renderNotFoundHeadCall

call renderNotFoundBackgroundCall renderHeroBackground
run renderNotFoundBackgroundCall
bind value notFoundHeroBackgroundFragment HtmlFragment renderNotFoundBackgroundCall

call hydrateNotFoundCall html.hydrate.NotFoundPageTemplate
argument hydrateNotFoundCall headFragment HtmlFragment notFoundHeadFragment
argument hydrateNotFoundCall heroBackgroundFragment HtmlFragment notFoundHeroBackgroundFragment
run hydrateNotFoundCall
bind value notFoundPageHtml HtmlDocument hydrateNotFoundCall

call writeNotFoundCall http.responseText
argument writeNotFoundCall response HttpResponse response
argument writeNotFoundCall status Int32 notFoundStatusCode
argument writeNotFoundCall body HtmlDocument notFoundPageHtml
argument writeNotFoundCall contentType HttpContentType htmlContentType
run writeNotFoundCall
bind value writeNotFoundStatus Int32 writeNotFoundCall
return value writeNotFoundStatus
